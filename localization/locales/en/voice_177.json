      "status": "imported"
    },
    "voice_177:r_2a00f1044ad5cbaa": {
      "text": "Enemy unit lost.",
      "status": "imported"
    },
    "voice_177:r_3dbeead1bd3164ef": {
      "text": "Energy reserves nearly depleted.",
      "status": "imported"
    },
    "voice_177:r_98d15b8cc09bc915": {
