    "voice_177:r_dad38ee29af2df3a": {
      "text": "It seems you're all show.",
      "status": "imported"
    },
    "voice_177:r_3d32e86f8dc80909": {
      "text": "Damage sustained.",
      "status": "imported"
    },
    "voice_177:r_70451ffbabe2f876": {
      "text": "Direct hit sustained.",
      "status": "imported"
    },
    "voice_177:r_69dfa1659715e2fa": {
      "text": "Moderate damage. Combat possible.",
      "status": "imported"
    },
    "voice_177:r_d996fd6d4ef5b329": {
      "text": "Armor breached. Internal damage.",
      "status": "imported"
    },
    "voice_177:r_8ab47a28f99ef565": {
      "text": "Enemy attack cannot be analyzed.",
      "status": "imported"
    },
    "voice_177:r_546de3fb6db156ea": {
      "text": "Operational capability affected.",
      "status": "imported"
    },
    "voice_177:r_ca85f87cee5e31f7": {
      "text": "Reevaluating evasion pattern.",
      "status": "imported"
    },
    "voice_177:r_9072ea7bc71df136": {
      "text": "Reanalyzing enemy attack pattern.",
      "status": "imported"
    },
    "voice_177:r_04e815a8d425827d": {
      "text": "Requesting tactical pattern review.",
      "status": "imported"
    },
    "voice_177:r_d89011fe3e5d082a": {
      "text": "Tetsujin No. 28 is formidable!",
      "status": "imported"
    },
    "voice_177:r_3c5b0c2ac812d5de": {
      "text": "Warning! Black Ox is dangerous!",
      "status": "imported"
    },
    "voice_177:r_5b9e8897190892eb": {
      "text": "Mars's psychic power is unknown!",
      "status": "imported"
    },
    "voice_177:r_7bea3023abbf8a94": {
      "text": "Can't analyze Earth robots' power!",
      "status": "imported"
    },
    "voice_177:r_c958860b0676b1f5": {
      "text": "Critical damage! Critical damage!",
      "status": "imported"
    },
    "voice_177:r_5e2669b82ef75ce3": {
      "text": "Reactor hit! Reactor hit!",
      "status": "imported"
    },
    "voice_177:r_7847e0ed7dc9282d": {
      "text": "Severe damage! Requesting new plan!",
      "status": "imported"
    },
    "voice_177:r_e42b52c7a987b906": {
      "text": "Requesting new plan! Order retreat!",
      "status": "imported"
    },
    "voice_177:r_6825fd1ff907bd22": {
      "text": "Widespread damage! At this rate...!",
      "status": "imported"
    },
    "voice_177:r_607f666f1563bc0d": {
      "text": "Output down! Operations impaired!",
      "status": "imported"
    },
    "voice_177:r_97b7431eeb81e6b6": {
      "text": "Damage at critical levels!",
      "status": "imported"
    },
    "voice_177:r_132f605d02975e71": {
      "text": "We'll be shot down in no time!",
      "status": "imported"
    },
    "voice_177:r_9b9726b1872759d6": {
      "text": "Replan!\\nSelf-destruct if required!",
      "status": "imported"
    },
    "voice_177:r_1252db29683fefe0": {
      "text": "Combat disabled! Combat disabled!",
      "status": "imported"
    },
    "voice_177:r_ad3d538f1e909184": {
      "text": "Retreat...! Retreat...! Aaaagh!",
      "status": "imported"
    },
    "voice_177:r_8c61c59a1c0aebbf": {
      "text": "Operations impossible! Retreat now!",
      "status": "imported"
    },
    "voice_177:r_aba6a7662129d8ce": {
      "text": "No control! This unit will explode!",
      "status": "imported"
    },
    "voice_177:r_b84afafb8a33ec60": {
      "text": "Damage over limit! Control lost!",
      "status": "imported"
    },
    "voice_177:r_c8c59db85bf875e6": {
      "text": "Reactor runaway! Abandoning unit!",
      "status": "imported"
    },
    "voice_177:r_391aa56435d9dd6e": {
      "text": "Concentrating our attack.",
      "status": "imported"
    },
    "voice_177:r_7c796ba53bd7ea03": {
      "text": "We'll hold the enemy here.",
      "status": "imported"
    },
    "voice_177:r_fa944da4b6519006": {
      "text": "We'll make the first move.",
      "status": "imported"
    },
    "voice_177:r_95d047bcc17fccc6": {
      "text": "Providing attack support.",
      "status": "imported"
    },
    "voice_177:r_640327a12a559b31": {
      "text": "Target acknowledged.",
      "status": "imported"
    },
    "voice_177:r_bdd38c584fa313d0": {
      "text": "Target confirmed.",
      "status": "imported"
    },
    "voice_177:r_3fd86c1027f317c8": {
      "text": "Destroy the enemies one by one.",
      "status": "imported"
    },
    "voice_177:r_d0372a183d2007ad": {
      "text": "We'll hold the line as well.",
      "status": "imported"
    }
  }
