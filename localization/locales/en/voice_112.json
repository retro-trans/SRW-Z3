{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_112:r_479b340ccc6c572b": {
      "text": "Please hit!",
      "status": "imported"
    },
    "voice_112:r_ca4acbac57a2a35e": {
      "text": "Now!",
      "status": "imported"
    },
    "voice_112:r_77949221bf58f862": {
      "text": "There!",
      "status": "imported"
    },
    "voice_112:r_70b9c4b9f1f37eff": {
      "text": "If I aim properly, it should hit!",
      "status": "imported"
    },
    "voice_112:r_9fcb3754cb1773c7": {
      "text": "I-is this how...?!",
      "status": "imported"
    },
    "voice_112:r_3559d2fad32c2435": {
      "text": "Just like I was taught...!",
      "status": "imported"
    },
    "voice_112:r_f7570547e9f80a64": {
      "text": "I have to stay calm...!",
      "status": "imported"
    },
    "voice_112:r_cbab0f4720e1fcf1": {
      "text": "I can do this too!",
      "status": "imported"
    },
    "voice_112:r_0bbe0b4f5364e732": {
      "text": "I can handle this...!",
      "status": "imported"
    },
    "voice_112:r_5dda5198137cb02a": {
      "text": "Teletha Testarossa, launching!",
      "status": "imported"
    },
    "voice_112:r_83ec59afbecdec14": {
      "text": "After all that training...!",
      "status": "imported"
    },
    "voice_112:r_e20bfd42ad95a3c9": {
      "text": "Don't hold back on my account!",
      "status": "imported"
    },
    "voice_112:r_0f58a8822381e57f": {
      "text": "You plan to beat me easily, but...!",
      "status": "imported"
    },
    "voice_112:r_6dbcc507fb61b51d": {
      "text": "Even I\\nknow the ABCs of combat!",
      "status": "imported"
    },
    "voice_112:r_b42ab697149a7c8a": {
      "text": "Don't fall...! Don't fall...!",
      "status": "imported"
    },
    "voice_112:r_4de4fcf3b440baf4": {
      "text": "Watch me, Coach...!\\nNo, Sagara!",
      "status": "imported"
    },
    "voice_112:r_0121a166c715cdff": {
      "text": "I'll shock everyone\\njust watch...!",
      "status": "imported"
    },
    "voice_112:r_30fad37a42bd3ad3": {
      "text": "I can't afford an easy loss...!",
      "status": "imported"
    },
    "voice_112:r_80a0b2a84e05d81a": {
      "text": "I can't let this chance slip by!",
      "status": "imported"
    },
    "voice_112:r_4a9ac1dff86506d9": {
      "text": "This is my chance!",
      "status": "imported"
    },
    "voice_112:r_bc8538e6af3d2577": {
      "text": "I'll correct\\nyour overconfidence!",
      "status": "imported"
    },
    "voice_112:r_924516c8de2b5342": {
      "text": "If I lose, it's a naked base lap!",
      "status": "imported"
    },
    "voice_112:r_da1174533722333f": {
      "text": "Melissa, I absolutely HATE you!!",
      "status": "imported"
    },
    "voice_112:r_fdeb8162976e72c1": {
      "text": "Let's settle this, Melissa!",
      "status": "imported"
    },
    "voice_112:r_0fadb5c26df92b42": {
      "text": "Even if Weber's my opponent!",
      "status": "imported"
    },
    "voice_112:r_6b15af9a0057cdc8": {
      "text": "If I'm sniped, it's all over...!",
      "status": "imported"
    },
    "voice_112:r_15b4a90140e8a33a": {
      "text": "I absolutely will not get naked!",
      "status": "imported"
    },
    "voice_112:r_5213c17e13b23de0": {
      "text": "I'll cover you!",
      "status": "imported"
    },
    "voice_112:r_38fdff9483e9245c": {
      "text": "Sagara gave me this opening!",
      "status": "imported"
    },
    "voice_112:r_620fedec67706d7d": {
      "text": "Get back!",
      "status": "imported"
    },
    "voice_112:r_9680dcd0fddcfcc7": {
      "text": "Look out, Coach! No, Sagara!",
      "status": "imported"
    },
    "voice_112:r_2a00f1044ad5cbaa": {
      "text": "This makes me a sitting duck...!",
      "status": "imported"
    },
    "voice_112:r_3dbeead1bd3164ef": {
      "text": "Huh? Why? How did this happen?!",
      "status": "imported"
    },
    "voice_112:r_98d15b8cc09bc915": {
      "text": "No...! I can't attack!",
      "status": "imported"
    },
    "voice_112:r_46e86d000250e137": {
      "text": "Of course! I trained hard for this!",
      "status": "imported"
    },
    "voice_112:r_ac341e7976e88f0b": {
      "text": "I did it, Coach!\\nNo, Sagara!",
      "status": "imported"
    },
    "voice_112:r_cdbd128a5b4127cc": {
      "text": "See? I can do it when I try!",
      "status": "imported"
    },
    "voice_112:r_cfccaa1fbeda124c": {
      "text": "Oh? What's wrong, Melissa?",
      "status": "imported"
    },
    "voice_112:r_b1f8ec192b9c083a": {
      "text": "That's what blind instinct gets you!",
      "status": "imported"
    },
    "voice_112:r_a007f9ab9cf048b3": {
      "text": "Ugh! Your attacks really are savage!",
      "status": "imported"
    },
    "voice_112:r_ddafde4b065ced49": {
      "text": "Is that all your vaunted aim can do?",
      "status": "imported"
    },
    "voice_112:r_de1213040856c089": {
      "text": "Your dirty thoughts\\ncaused this!",
      "status": "imported"
    },
    "voice_112:r_d692f1d420460a47": {
      "text": "That won't work on me!",
      "status": "imported"
    },
    "voice_112:r_68f2dfab20a4a30e": {
      "text": "I have a barrier!",
      "status": "imported"
    },
    "voice_112:r_9cedad8237480563": {
      "text": "No way! They hit me!",
      "status": "imported"
    },
    "voice_112:r_a03fabecba1508ca": {
      "text": "I-I'm still okay, aren't I...?",
      "status": "imported"
    },
    "voice_112:r_5391b24a71eb10ae": {
      "text": "This much is nothing to me!",
      "status": "imported"
    },
    "voice_112:r_a554ceef5c87b972": {
      "text": "Grit and guts will get me through!",
      "status": "imported"
    },
    "voice_112:r_546c3d5937fbb7ee": {
      "text": "Without my command, is that all?",
      "status": "imported"
    },
    "voice_112:r_1568ff6298b12b96": {
      "text": "Eek! I can't dodge!",
      "status": "imported"
    },
    "voice_112:r_2c9d94ba13c5fc50": {
      "text": "I absolutely must not fall...!",
      "status": "imported"
    },
    "voice_112:r_a77f4913375098d2": {
      "text": "No, I have to stay calm...!",
      "status": "imported"
    },
    "voice_112:r_428c2116ac3071b1": {
      "text": "I'm not giving up yet...!",
      "status": "imported"
    },
    "voice_112:r_84c116267b79f540": {
      "text": "This is no time for complaints...!",
      "status": "imported"
    },
    "voice_112:r_dad38ee29af2df3a": {
      "text": "I-I really\\ncan't beat Melissa...?!",
      "status": "imported"
    },
    "voice_112:r_3d32e86f8dc80909": {
      "text": "You think I'll cry? Wrong!\\nMelissa!",
      "status": "imported"
    },
    "voice_112:r_70451ffbabe2f876": {
      "text": "That desperate to see me naked?!",
      "status": "imported"
    },
    "voice_112:r_69dfa1659715e2fa": {
      "text": "I see!\\nNow I know the real you!",
      "status": "imported"
    },
    "voice_112:r_9072ea7bc71df136": {
      "text": "Aaaah! At this rate...!",
      "status": "imported"
    },
    "voice_112:r_04e815a8d425827d": {
      "text": "So this is... an AS battlefield...!",
      "status": "imported"
    },
    "voice_112:r_d89011fe3e5d082a": {
      "text": "Melissa's team\\nlives with this...!",
      "status": "imported"
    },
    "voice_112:r_3c5b0c2ac812d5de": {
      "text": "I may be outmatched...! But still!",
      "status": "imported"
    },
    "voice_112:r_5b9e8897190892eb": {
      "text": "I-I don't intend to complain!",
      "status": "imported"
    },
    "voice_112:r_7bea3023abbf8a94": {
      "text": "I'm sorry, Melissa...",
      "status": "imported"
    },
    "voice_112:r_dd01a4c0d1b36a8d": {
      "text": "No... I can't be finished here...!",
      "status": "imported"
    },
    "voice_112:r_20920ad2eb3542db": {
      "text": "N-no...!\\nI don't want to get naked!",
      "status": "imported"
    },
    "voice_112:r_0ab7914877fd48ed": {
      "text": "Ejecting!\\nAll units, keep fighting!",
      "status": "imported"
    }
  }
}
