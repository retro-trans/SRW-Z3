{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_050:r_479b340ccc6c572b": {
      "text": "I won't let you get away!",
      "status": "imported"
    },
    "voice_050:r_ca4acbac57a2a35e": {
      "text": "One more time!",
      "status": "imported"
    },
    "voice_050:r_77949221bf58f862": {
      "text": "Funnel!",
      "status": "imported"
    },
    "voice_050:r_70b9c4b9f1f37eff": {
      "text": "Goooo!",
      "status": "imported"
    },
    "voice_050:r_9fcb3754cb1773c7": {
      "text": "Funnel! Go!",
      "status": "imported"
    },
    "voice_050:r_3559d2fad32c2435": {
      "text": "This ends now!",
      "status": "imported"
    },
    "voice_050:r_f7570547e9f80a64": {
      "text": "I won't let you!",
      "status": "imported"
    },
    "voice_050:r_cbab0f4720e1fcf1": {
      "text": "Fin Funnel!!",
      "status": "imported"
    },
    "voice_050:r_0bbe0b4f5364e732": {
      "text": "Move!",
      "status": "imported"
    },
    "voice_050:r_5dda5198137cb02a": {
      "text": "There you are!",
      "status": "imported"
    },
    "voice_050:r_83ec59afbecdec14": {
      "text": "Go! Fin Funnel!",
      "status": "imported"
    },
    "voice_050:r_0f58a8822381e57f": {
      "text": "You won't break through here!",
      "status": "imported"
    },
    "voice_050:r_6dbcc507fb61b51d": {
      "text": "Counterattack...! Fight back!",
      "status": "imported"
    },
    "voice_050:r_b42ab697149a7c8a": {
      "text": "Stop resisting!",
      "status": "imported"
    },
    "voice_050:r_4de4fcf3b440baf4": {
      "text": "If I can time this right!",
      "status": "imported"
    },
    "voice_050:r_0121a166c715cdff": {
      "text": "You're not getting away!",
      "status": "imported"
    },
    "voice_050:r_30fad37a42bd3ad3": {
      "text": "This is Katz! Providing support!",
      "status": "imported"
    },
    "voice_050:r_80a0b2a84e05d81a": {
      "text": "I'll prove I can help!",
      "status": "imported"
    },
    "voice_050:r_4a9ac1dff86506d9": {
      "text": "I won't let that happen!",
      "status": "imported"
    },
    "voice_050:r_bc8538e6af3d2577": {
      "text": "I'll buy us some time!",
      "status": "imported"
    },
    "voice_050:r_924516c8de2b5342": {
      "text": "I'm going in!",
      "status": "imported"
    },
    "voice_050:r_da1174533722333f": {
      "text": "Engaging!",
      "status": "imported"
    },
    "voice_050:r_fdeb8162976e72c1": {
      "text": "I'll keep them pinned!",
      "status": "imported"
    },
    "voice_050:r_0fadb5c26df92b42": {
      "text": "I'll at least slow them down!",
      "status": "imported"
    },
    "voice_050:r_6b15af9a0057cdc8": {
      "text": "Th-this is bad!",
      "status": "imported"
    },
    "voice_050:r_15b4a90140e8a33a": {
      "text": "Damn! I've got no weapons left!",
      "status": "imported"
    },
    "voice_050:r_af884a6b11dff121": {
      "text": "Where'd they go!?",
      "status": "imported"
    },
    "voice_050:r_ac6fe7838e95647b": {
      "text": "Damn! I lost them!",
      "status": "imported"
    },
    "voice_050:r_77ca87eacd17ad52": {
      "text": "Don't underestimate me!",
      "status": "imported"
    },
    "voice_050:r_bf3244994760e535": {
      "text": "It's okay! They missed me!",
      "status": "imported"
    },
    "voice_050:r_aabfb21c9d069ce7": {
      "text": "I can't let them see me mess up!",
      "status": "imported"
    },
    "voice_050:r_02479dc8fe989560": {
      "text": "All right, I dodged it!",
      "status": "imported"
    },
    "voice_050:r_a2df00f91a9b0a9e": {
      "text": "I can still handle this!",
      "status": "imported"
    },
    "voice_050:r_48b60d6c48b9b142": {
      "text": "If I keep this up...!",
      "status": "imported"
    },
    "voice_050:r_8927e6fb681aa809": {
      "text": "Th-that was close...!",
      "status": "imported"
    },
    "voice_050:r_665f01666859013b": {
      "text": "That's nothing!",
      "status": "imported"
    },
    "voice_050:r_a571eec59b258d11": {
      "text": "I've got to prove I can help,\\ntoo!",
      "status": "imported"
    },
    "voice_050:r_ddbe581c5ea9183d": {
      "text": "It's no use!",
      "status": "imported"
    },
    "voice_050:r_faae935cca0edc72": {
      "text": "That's nothing!",
      "status": "imported"
    },
    "voice_050:r_d4430bf362340b32": {
      "text": "Th-that saved me...!",
      "status": "imported"
    },
    "voice_050:r_6ff1323b355593e0": {
      "text": "Ugh... I couldn't get away...!",
      "status": "imported"
    },
    "voice_050:r_b7b5625d7cd4282f": {
      "text": "That impact was huge...! But...!",
      "status": "imported"
    },
    "voice_050:r_36133ad73a73ef98": {
      "text": "Ugh! I won't let them beat me!",
      "status": "imported"
    },
    "voice_050:r_920740a0219c5085": {
      "text": "I was ready for this much!",
      "status": "imported"
    },
    "voice_050:r_a8451712c57c1a72": {
      "text": "If I back down, they'll laugh!",
      "status": "imported"
    },
    "voice_050:r_3633df5b7b8f47fa": {
      "text": "Damn! You won't have your way!",
      "status": "imported"
    },
    "voice_050:r_52dfc56b14b93551": {
      "text": "Whoa! Where was I hit!?",
      "status": "imported"
    },
    "voice_050:r_1b9b2aab5cb104da": {
      "text": "Ugh! I can't follow their moves!",
      "status": "imported"
    },
    "voice_050:r_342044c706a2340f": {
      "text": "Stay calm! I've got to respond!",
      "status": "imported"
    },
    "voice_050:r_cf41e8828a90cbdb": {
      "text": "Aaargh! Y-you bastard!",
      "status": "imported"
    },
    "voice_050:r_719e897304ec42d4": {
      "text": "Can't I handle this machine!?",
      "status": "imported"
    },
    "voice_050:r_d5e0a2317c40d322": {
      "text": "Ugh!\\nI knew I was being targeted!",
      "status": "imported"
    },
    "voice_050:r_ec2ea17765052401": {
      "text": "W-why is this happening!?",
      "status": "imported"
    },
    "voice_050:r_f2d4255f1c2f7542": {
      "text": "I've got my pride too!",
      "status": "imported"
    },
    "voice_050:r_5d08ad19e2da125b": {
      "text": "No! They're overpowering me!",
      "status": "imported"
    },
    "voice_050:r_a7246b52782a877e": {
      "text": "Damn! Can't I beat them!?",
      "status": "imported"
    },
    "voice_050:r_dc8701f6bcb9904f": {
      "text": "Th-this is completely one-sided!",
      "status": "imported"
    },
    "voice_050:r_d6bdd730f24f66eb": {
      "text": "I can't make everyone worry,\\nbut...!",
      "status": "imported"
    },
    "voice_050:r_41997412868c48c4": {
      "text": "They got me!",
      "status": "imported"
    },
    "voice_050:r_9e6cf4f389dae55c": {
      "text": "Is this as far as I go!?",
      "status": "imported"
    },
    "voice_050:r_9e0c80ac7e33b459": {
      "text": "Am I really not good enough...!?",
      "status": "imported"
    },
    "voice_050:r_065443f6ddfcf0d7": {
      "text": "Fall!",
      "status": "imported"
    },
    "voice_050:r_47d52a2839c71715": {
      "text": "This'll do it!",
      "status": "imported"
    },
    "voice_050:r_847f82e7f3eef651": {
      "text": "I can do it too!",
      "status": "imported"
    },
    "voice_050:r_eb7ae28b53dc033c": {
      "text": "That's a bad place to be!",
      "status": "imported"
    },
    "voice_050:r_857c4a52ce8df0fd": {
      "text": "We won't know unless we try!",
      "status": "imported"
    },
    "voice_050:r_8fdf5910927c9591": {
      "text": "You were careless!",
      "status": "imported"
    },
    "voice_050:r_7d724dbcc4451e10": {
      "text": "I'll land a direct hit!",
      "status": "imported"
    },
    "voice_050:r_93e25418a203cb8f": {
      "text": "I've come too far to turn back!",
      "status": "imported"
    },
    "voice_050:r_adeb0a29274d3d9b": {
      "text": "I won't let it end here!",
      "status": "imported"
    },
    "voice_050:r_24cf161287ef9d5c": {
      "text": "You have no place in this world!",
      "status": "imported"
    },
    "voice_050:r_8f60f6fc86db3107": {
      "text": "I know who I have to defeat,\\ntoo!",
      "status": "imported"
    },
    "voice_050:r_b1de76a75a253c13": {
      "text": "You're the last! This ends now!",
      "status": "imported"
    },
    "voice_050:r_128c35bf3e0e394c": {
      "text": "Captain Quattro!\\nWhy do this?!",
      "status": "imported"
    },
    "voice_050:r_5213c17e13b23de0": {
      "text": "That's Char Aznable...\\nOur enemy!",
      "status": "imported"
    },
    "voice_050:r_38fdff9483e9245c": {
      "text": "I won't be dead weight forever!",
      "status": "imported"
    },
    "voice_050:r_620fedec67706d7d": {
      "text": "Hi-Mega Launcher!\\nHit them!!",
      "status": "imported"
    },
    "voice_050:r_9680dcd0fddcfcc7": {
      "text": "I'm not a rookie anymore!",
      "status": "imported"
    },
    "voice_050:r_3dbeead1bd3164ef": {
      "text": "Beam Confuse!",
      "status": "imported"
    },
    "voice_050:r_98d15b8cc09bc915": {
      "text": "Kamille, I'll take it from here!",
      "status": "imported"
    },
    "voice_050:r_46e86d000250e137": {
      "text": "Emma, I'll follow up!",
      "status": "imported"
    },
    "voice_050:r_ac341e7976e88f0b": {
      "text": "Captain Quattro, I'll cover you!",
      "status": "imported"
    },
    "voice_050:r_cdbd128a5b4127cc": {
      "text": "Amuro! Leave the rest to me!",
      "status": "imported"
    },
    "voice_050:r_cfccaa1fbeda124c": {
      "text": "Captain Bright! I'll cover you!",
      "status": "imported"
    },
    "voice_050:r_b1f8ec192b9c083a": {
      "text": "Kamille, fall back!",
      "status": "imported"
    },
    "voice_050:r_a007f9ab9cf048b3": {
      "text": "Emma, look out!",
      "status": "imported"
    },
    "voice_050:r_ddafde4b065ced49": {
      "text": "Captain Quattro, please fall back!",
      "status": "imported"
    },
    "voice_050:r_de1213040856c089": {
      "text": "Amuro, now's your chance!",
      "status": "imported"
    },
    "voice_050:r_3304412ac41f47a6": {
      "text": "Captain Bright, please fall back!",
      "status": "imported"
    },
    "voice_050:r_0c0775e051211840": {
      "text": "There must be something I can do!",
      "status": "imported"
    },
    "voice_050:r_42ba1ecb310b4bd7": {
      "text": "Dad's museum never had this...",
      "status": "imported"
    },
    "voice_050:r_d692f1d420460a47": {
      "text": "I'll make this hit!",
      "status": "imported"
    },
    "voice_050:r_a5643cec86b18bd2": {
      "text": "Make it a direct hit!",
      "status": "imported"
    },
    "voice_050:r_68f2dfab20a4a30e": {
      "text": "Focus my breathing, like karate!",
      "status": "imported"
    },
    "voice_050:r_9cedad8237480563": {
      "text": "I can fight up close too...!",
      "status": "imported"
    },
    "voice_050:r_d89011fe3e5d082a": {
      "text": "Hah!",
      "status": "imported"
    },
    "voice_050:r_7bea3023abbf8a94": {
      "text": "Go!",
      "status": "imported"
    },
    "voice_050:r_dd01a4c0d1b36a8d": {
      "text": "I'll power through!",
      "status": "imported"
    },
    "voice_050:r_0ab7914877fd48ed": {
      "text": "There!",
      "status": "imported"
    },
    "voice_050:r_5e2669b82ef75ce3": {
      "text": "Not yet!",
      "status": "imported"
    },
    "voice_050:r_97b7431eeb81e6b6": {
      "text": "Sara, lend me your strength...!",
      "status": "imported"
    },
    "voice_050:r_132f605d02975e71": {
      "text": "To keep this war from spreading...!",
      "status": "imported"
    },
    "voice_050:r_9b9726b1872759d6": {
      "text": "Raaaaaagh!!",
      "status": "imported"
    },
    "voice_050:r_1252db29683fefe0": {
      "text": "You're still going to keep this up!?",
      "status": "imported"
    },
    "voice_050:r_ad3d538f1e909184": {
      "text": "Do you really want war that badly!?",
      "status": "imported"
    },
    "voice_050:r_8c61c59a1c0aebbf": {
      "text": "Letz and Kikka are on Earth too!",
      "status": "imported"
    },
    "voice_050:r_aba6a7662129d8ce": {
      "text": "We've got grudges of our own!",
      "status": "imported"
    },
    "voice_050:r_b84afafb8a33ec60": {
      "text": "Go back to Hathaway!",
      "status": "imported"
    },
    "voice_050:r_c8c59db85bf875e6": {
      "text": "What is this feeling...!?",
      "status": "imported"
    },
    "voice_050:r_7c796ba53bd7ea03": {
      "text": "A Cyber-Newtype won't scare me...!",
      "status": "imported"
    },
    "voice_050:r_fa944da4b6519006": {
      "text": "You're nothing like Captain Quattro!",
      "status": "imported"
    },
    "voice_050:r_95d047bcc17fccc6": {
      "text": "The Royal Guard...!",
      "status": "imported"
    },
    "voice_050:r_640327a12a559b31": {
      "text": "Haman! I won't forgive you!",
      "status": "imported"
    },
    "voice_050:r_bdd38c584fa313d0": {
      "text": "That monster won't have its way!",
      "status": "imported"
    },
    "voice_050:r_3fd86c1027f317c8": {
      "text": "I refuse to be destroyed by that!",
      "status": "imported"
    },
    "voice_050:r_217aa5e1d545b44d": {
      "text": "Sara, I'll make this the end...!",
      "status": "imported"
    },
    "voice_050:r_381992c5d8224937": {
      "text": "To live true...!\\nThat age must come!",
      "status": "imported"
    },
    "voice_050:r_fd910d714be70870": {
      "text": "I can't let Fa outdo me!",
      "status": "imported"
    },
    "voice_050:r_9736f29b11344ec3": {
      "text": "Not bad, Hathaway!",
      "status": "imported"
    },
    "voice_050:r_fcd05582aa5c6068": {
      "text": "Ensign Riddhe, I'll cover you!",
      "status": "imported"
    },
    "voice_050:r_bece29562818acba": {
      "text": "I'll cover the Nahel Argama!",
      "status": "imported"
    },
    "voice_050:r_494b5da92ed24ecb": {
      "text": "I'm following the Ra Cailum!",
      "status": "imported"
    },
    "voice_050:r_a4a5a96f4bd58920": {
      "text": "I won't let them hurt Fa!",
      "status": "imported"
    },
    "voice_050:r_b57d2d74233f889a": {
      "text": "Fall back, Hathaway!",
      "status": "imported"
    },
    "voice_050:r_cd06d0820d82524b": {
      "text": "Please regroup, Ensign Riddhe!",
      "status": "imported"
    },
    "voice_050:r_c94c6d04be583774": {
      "text": "I won't let the Nahel Argama sink!",
      "status": "imported"
    },
    "voice_050:r_e54e2c99ef8297af": {
      "text": "Sara! Get away from Scirocco!!",
      "status": "imported"
    },
    "voice_050:r_f16a3eb0bcaac082": {
      "text": "Why overthink? You'll just burn out.",
      "status": "imported"
    },
    "voice_050:r_10a408809e512df1": {
      "text": "I'll take point!",
      "status": "imported"
    },
    "voice_050:r_bc7b9e308b879dd4": {
      "text": "I'll draw their attention!",
      "status": "imported"
    },
    "voice_050:r_98902fd3143c393e": {
      "text": "I'll keep them occupied!",
      "status": "imported"
    },
    "voice_050:r_d907fbd7bc1c4298": {
      "text": "I can handle one!",
      "status": "imported"
    },
    "voice_050:r_96b21e3a028dd074": {
      "text": "Draw that one away!",
      "status": "imported"
    },
    "voice_050:r_ce140b5d8e6b7310": {
      "text": "They left it to me, so I must!",
      "status": "imported"
    }
  }
}
