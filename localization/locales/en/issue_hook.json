    "issue_hook:r_0bbe0b4f5364e732": {
      "text": "Beasts' blood, mingling waters, the wind's path,",
      "status": "imported"
    },
    "issue_hook:r_5dda5198137cb02a": {
      "text": "civilization's fire, and the radiance of the sun...",
      "status": "imported"
    },
    "issue_hook:r_83ec59afbecdec14": {
      "text": "May the stillness of the final heaven be yours...",
      "status": "imported"
    },
    "issue_hook:r_e20bfd42ad95a3c9": {
      "text": "The $$時空震動$$ that struck just after $$ＺＥＵＴＨ$$'s return",
      "status": "imported"
    },
    "issue_hook:r_0f58a8822381e57f": {
      "text": "created a new world.",
      "status": "imported"
    },
    "issue_hook:r_6dbcc507fb61b51d": {
      "text": "Known as the $$新世時空震動$$, this event",
      "status": "imported"
    },
    "issue_hook:r_b42ab697149a7c8a": {
      "text": "merged two worlds on different planes, $$ＵＣＷ$$ and $$ＡＤＷ$$...",
      "status": "imported"
    },
    "issue_hook:r_4de4fcf3b440baf4": {
      "text": "and several other worlds into one.",
      "status": "imported"
    },
    "issue_hook:r_0121a166c715cdff": {
      "text": "But humanity did not yield...",
      "status": "imported"
    },
    "issue_hook:r_30fad37a42bd3ad3": {
      "text": "Humanity accepted this vast spacetime catastrophe,",
      "status": "imported"
    },
    "issue_hook:r_80a0b2a84e05d81a": {
      "text": "and a new order arose in the new world. Earth and the",
      "status": "imported"
    },
    "issue_hook:r_4a9ac1dff86506d9": {
      "text": "displaced colonies united under the Earth Federation.",
      "status": "imported"
    },
    "issue_hook:r_bc8538e6af3d2577": {
      "text": "In just a few months, people's lives returned to the",
      "status": "imported"
    },
    "issue_hook:r_924516c8de2b5342": {
      "text": "peace they had known before the $$新世時空震動$$.",
      "status": "imported"
    },
    "issue_hook:r_da1174533722333f": {
      "text": "Three months after the $$新世時空震動$$...",
      "status": "imported"
    },
    "issue_hook:r_fdeb8162976e72c1": {
      "text": "As plots and truths hidden in the new world's",
      "status": "imported"
    },
    "issue_hook:r_0fadb5c26df92b42": {
      "text": "chaos began to stir, the prelude to a battle that",
      "status": "imported"
    },
    "issue_hook:r_6b15af9a0057cdc8": {
      "text": "would shake spacetime was about to begin...",
      "status": "imported"
    },
