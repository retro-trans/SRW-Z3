{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_011:r_479b340ccc6c572b": {
      "text": "Now this'll work!",
      "status": "imported"
    },
    "voice_011:r_77949221bf58f862": {
      "text": "I can do this!",
      "status": "imported"
    },
    "voice_011:r_70b9c4b9f1f37eff": {
      "text": "I'll knock you out of the sky!",
      "status": "imported"
    },
    "voice_011:r_9fcb3754cb1773c7": {
      "text": "I won't let you resist!",
      "status": "imported"
    },
    "voice_011:r_3559d2fad32c2435": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_011:r_f7570547e9f80a64": {
      "text": "I've got you now!",
      "status": "imported"
    },
    "voice_011:r_cbab0f4720e1fcf1": {
      "text": "There!",
      "status": "imported"
    },
    "voice_011:r_0bbe0b4f5364e732": {
      "text": "At this range!",
      "status": "imported"
    },
    "voice_011:r_5dda5198137cb02a": {
      "text": "I won't let you do as you please!",
      "status": "imported"
    },
    "voice_011:r_83ec59afbecdec14": {
      "text": "I'll stop you here!",
      "status": "imported"
    },
    "voice_011:r_e20bfd42ad95a3c9": {
      "text": "It's not over yet!",
      "status": "imported"
    },
    "voice_011:r_0f58a8822381e57f": {
      "text": "Here I come, Gundam!",
      "status": "imported"
    },
    "voice_011:r_6dbcc507fb61b51d": {
      "text": "I'll shoot Gundam down myself!",
      "status": "imported"
    },
    "voice_011:r_b42ab697149a7c8a": {
      "text": "Even if I'm facing a Gundam!",
      "status": "imported"
    },
    "voice_011:r_4de4fcf3b440baf4": {
      "text": "Fall, horned one!",
      "status": "imported"
    },
    "voice_011:r_30fad37a42bd3ad3": {
      "text": "I'll take down the flashy one first!",
      "status": "imported"
    },
    "voice_011:r_bc8538e6af3d2577": {
      "text": "A private company has no place here!",
      "status": "imported"
    },
    "voice_011:r_da1174533722333f": {
      "text": "No matter how thick your armor is!",
      "status": "imported"
    },
    "voice_011:r_0fadb5c26df92b42": {
      "text": "I won't let you transform!",
      "status": "imported"
    },
    "voice_011:r_6b15af9a0057cdc8": {
      "text": "I'll tear you limb from limb!",
      "status": "imported"
    },
    "voice_011:r_15b4a90140e8a33a": {
      "text": "I'll aim for the joints!",
      "status": "imported"
    },
    "voice_011:r_af884a6b11dff121": {
      "text": "I'll crush your weak points!",
      "status": "imported"
    },
    "voice_011:r_77ca87eacd17ad52": {
      "text": "Even you can't pierce this!\\nKnow it!",
      "status": "imported"
    },
    "voice_011:r_bf3244994760e535": {
      "text": "In the end, it's just a big machine!",
      "status": "imported"
    },
    "voice_011:r_aabfb21c9d069ce7": {
      "text": "Size alone won't\\nsettle this battle!",
      "status": "imported"
    },
    "voice_011:r_02479dc8fe989560": {
      "text": "Just big! I'll get around you!",
      "status": "imported"
    },
    "voice_011:r_a2df00f91a9b0a9e": {
      "text": "Once I sink your mothership...!",
      "status": "imported"
    },
    "voice_011:r_48b60d6c48b9b142": {
      "text": "Hmph, you're one big target!",
      "status": "imported"
    },
    "voice_011:r_8927e6fb681aa809": {
      "text": "What can that tiny machine even do?!",
      "status": "imported"
    },
    "voice_011:r_a571eec59b258d11": {
      "text": "Such a flimsy machine!",
      "status": "imported"
    },
    "voice_011:r_faae935cca0edc72": {
      "text": "Damn, they're fast!",
      "status": "imported"
    },
    "voice_011:r_b7b5625d7cd4282f": {
      "text": "I'll wipe you out, monster!",
      "status": "imported"
    },
    "voice_011:r_36133ad73a73ef98": {
      "text": "You won't have your way with Earth!",
      "status": "imported"
    },
    "voice_011:r_cdbd128a5b4127cc": {
      "text": "Fall!",
      "status": "imported"
    },
    "voice_011:r_cfccaa1fbeda124c": {
      "text": "I'll shoot right through you!",
      "status": "imported"
    },
    "voice_011:r_b1f8ec192b9c083a": {
      "text": "I'll make this shot count!",
      "status": "imported"
    },
    "voice_011:r_e42b52c7a987b906": {
      "text": "We'll finish them together!",
      "status": "imported"
    },
    "voice_011:r_6825fd1ff907bd22": {
      "text": "Keep it going!",
      "status": "imported"
    },
    "voice_011:r_607f666f1563bc0d": {
      "text": "I'll cover you!",
      "status": "imported"
    },
    "voice_011:r_97b7431eeb81e6b6": {
      "text": "I'm here too!",
      "status": "imported"
    },
    "voice_011:r_132f605d02975e71": {
      "text": "Take this one too!",
      "status": "imported"
    },
    "voice_011:r_9b9726b1872759d6": {
      "text": "I'll be the shield!",
      "status": "imported"
    },
    "voice_011:r_1252db29683fefe0": {
      "text": "Fall back, now!",
      "status": "imported"
    },
    "voice_011:r_ad3d538f1e909184": {
      "text": "I'll take the hit!",
      "status": "imported"
    },
    "voice_011:r_8c61c59a1c0aebbf": {
      "text": "I'll step in!",
      "status": "imported"
    },
    "voice_011:r_aba6a7662129d8ce": {
      "text": "I'm your opponent!",
      "status": "imported"
    },
    "voice_011:r_b84afafb8a33ec60": {
      "text": "I can't counterattack?!",
      "status": "imported"
    },
    "voice_011:r_c8c59db85bf875e6": {
      "text": "Damn, this is a bad position!",
      "status": "imported"
    },
    "voice_011:r_391aa56435d9dd6e": {
      "text": "I can't attack?!",
      "status": "imported"
    },
    "voice_011:r_7c796ba53bd7ea03": {
      "text": "I can't counterattack?! Damn it!",
      "status": "imported"
    },
    "voice_011:r_fa944da4b6519006": {
      "text": "I've got no choice but to pull back!",
      "status": "imported"
    },
    "voice_011:r_95d047bcc17fccc6": {
      "text": "Do I have to let them go?!",
      "status": "imported"
    },
    "voice_011:r_640327a12a559b31": {
      "text": "If I don't pull back, I'm done for!",
      "status": "imported"
    },
    "voice_011:r_bdd38c584fa313d0": {
      "text": "Where the hell are you aiming?!",
      "status": "imported"
    },
    "voice_011:r_3fd86c1027f317c8": {
      "text": "Just as I predicted!",
      "status": "imported"
    },
    "voice_011:r_d0372a183d2007ad": {
      "text": "Too bad for you!",
      "status": "imported"
    },
    "voice_011:r_217aa5e1d545b44d": {
      "text": "You're too naive!",
      "status": "imported"
    },
    "voice_011:r_381992c5d8224937": {
      "text": "That was nothing!",
      "status": "imported"
    },
    "voice_011:r_f1e7ed9e5874aba5": {
      "text": "Your attacks are sloppy, Gundam!",
      "status": "imported"
    },
    "voice_011:r_fc25e66a86fc2c85": {
      "text": "I can do this! I can match Gundam!",
      "status": "imported"
    },
    "voice_011:r_5aeeb4917340c42d": {
      "text": "That Gundam's nothing special!",
      "status": "imported"
    },
    "voice_011:r_b765659981b6516d": {
      "text": "If it misses, any attack is useless!",
      "status": "imported"
    },
    "voice_011:r_0c427458bc00eb95": {
      "text": "Just as I thought, all show!",
      "status": "imported"
    },
    "voice_011:r_774a9ab4d8fd5351": {
      "text": "That won't work!",
      "status": "imported"
    },
    "voice_011:r_d3f01de714c015bd": {
      "text": "It's useless!",
      "status": "imported"
    },
    "voice_011:r_862ef7385bf2abd4": {
      "text": "With the shield!",
      "status": "imported"
    },
    "voice_011:r_001cbec4d9a4283f": {
      "text": "I've got a shield!",
      "status": "imported"
    },
    "voice_011:r_8ad40afecd02b41e": {
      "text": "Damn, I let my guard down!",
      "status": "imported"
    },
    "voice_011:r_26e5efec03c03d78": {
      "text": "Hmph, is that all? Pathetic!",
      "status": "imported"
    },
    "voice_011:r_4ad81e88c7557a8b": {
      "text": "That'll never be enough to stop us!",
      "status": "imported"
    },
    "voice_011:r_1f65a7af190e4674": {
      "text": "They're holding back?!",
      "status": "imported"
    },
    "voice_011:r_40c5a9358ed5bf29": {
      "text": "Hmph, they underestimated me.",
      "status": "imported"
    },
    "voice_011:r_f2e18dfdfe0c89ea": {
      "text": "Gundam! You're not worth the hype!",
      "status": "imported"
    },
    "voice_011:r_cf7dbf49e96a5755": {
      "text": "Is that all, Gundam?!",
      "status": "imported"
    },
    "voice_011:r_fa96676cc65bb509": {
      "text": "You shame the Gundam name!",
      "status": "imported"
    },
    "voice_011:r_4e37f92e7d2fc62e": {
      "text": "Damn! They aim right where it hurts!",
      "status": "imported"
    },
    "voice_011:r_66ab4cfe1557909d": {
      "text": "Ghah! They pierced my armor!",
      "status": "imported"
    },
    "voice_011:r_0bad405ee6ca63ba": {
      "text": "They read my movements?!",
      "status": "imported"
    },
    "voice_011:r_2072eaf71a260ae7": {
      "text": "Guh! I can't follow their movements!",
      "status": "imported"
    },
    "voice_011:r_6c13bbfd27a7799e": {
      "text": "This is bad! My sensors are down!",
      "status": "imported"
    },
    "voice_011:r_06f88dcbd3c9e738": {
      "text": "W-What?! What was that attack?!",
      "status": "imported"
    },
    "voice_011:r_b28faf9f71bc3598": {
      "text": "We can fight Gundam on equal terms!",
      "status": "imported"
    },
    "voice_011:r_8a29278549f8e07a": {
      "text": "Gundam! You won't have your way!",
      "status": "imported"
    },
    "voice_011:r_7e6c573c26177f98": {
      "text": "Th-The controls!!",
      "status": "imported"
    },
    "voice_011:r_45abf84f7757d6eb": {
      "text": "I won't let it end like this!",
      "status": "imported"
    },
    "voice_011:r_edd7a13ab8f06a14": {
      "text": "Guh! I'll hold out at any cost!",
      "status": "imported"
    },
    "voice_011:r_8165e5b41f0124c4": {
      "text": "W-What did you say?!",
      "status": "imported"
    },
    "voice_011:r_4e05581b7432cce8": {
      "text": "I won't crawl away in shame!!",
      "status": "imported"
    },
    "voice_011:r_a60b107ea3c36a86": {
      "text": "What?! My output is dropping!!",
      "status": "imported"
    },
    "voice_011:r_e33693e5ba4665b0": {
      "text": "As long as it moves, I'll manage!!",
      "status": "imported"
    },
    "voice_011:r_72a21a1a489af001": {
      "text": "S-So this is Gundam's power...!",
      "status": "imported"
    },
    "voice_011:r_eb643f8bf737a0ca": {
      "text": "Don't think this is over, Gundam!",
      "status": "imported"
    },
    "voice_011:r_0a3fccb71ec6cf2a": {
      "text": "E-Eject!",
      "status": "imported"
    },
    "voice_011:r_9b63cf1f3e0207ef": {
      "text": "Aaaaaaagh!!",
      "status": "imported"
    },
    "voice_011:r_8356f4e3dcdff938": {
      "text": "D-Damn yoooou!!",
      "status": "imported"
    },
    "voice_011:r_1d6d784036ae0bd7": {
      "text": "I can't hold on! Uwoaagh!!",
      "status": "imported"
    },
    "voice_011:r_625664af02183c17": {
      "text": "I-I'm at my limit! Aaaagh!!",
      "status": "imported"
    },
    "voice_011:r_3701cba361f80ea5": {
      "text": "This can't be happening!!",
      "status": "imported"
    },
    "voice_011:r_63f429c5c68c0863": {
      "text": "Hah! Is that all?!",
      "status": "imported"
    },
    "voice_011:r_38e4a434c91d8ef0": {
      "text": "Tch, I couldn't dodge it!",
      "status": "imported"
    },
    "voice_011:r_98ed411352a3a6ac": {
      "text": "A scratch or two won't stop me!",
      "status": "imported"
    },
    "voice_011:r_4824bea6bab3af67": {
      "text": "Like that'll hit me!",
      "status": "imported"
    },
    "voice_011:r_862b92e63adb9734": {
      "text": "Not so easily!",
      "status": "imported"
    },
    "voice_011:r_cb306ef55e49d107": {
      "text": "I knew you'd try that!",
      "status": "imported"
    },
    "voice_011:r_57b2bd2de8a1408d": {
      "text": "It won't be that easy!",
      "status": "imported"
    },
    "voice_011:r_76f080a4881e8ab5": {
      "text": "So what?!",
      "status": "imported"
    },
    "voice_011:r_288133bc5b573dae": {
      "text": "That won't do a thing!",
      "status": "imported"
    },
    "voice_011:r_6f95653e548f8fcf": {
      "text": "What the hell is that?!",
      "status": "imported"
    },
    "voice_011:r_6026da5acbda7c69": {
      "text": "I can't do a thing!",
      "status": "imported"
    },
    "voice_011:r_981f8fedd5414fe5": {
      "text": "At this rate, I'm a sitting duck!",
      "status": "imported"
    },
    "voice_011:r_96bb0dcde0c8c44a": {
      "text": "I'll wait for my next chance...!",
      "status": "imported"
    },
    "voice_011:r_641550a2f54cb456": {
      "text": "Looks won't fool me!",
      "status": "imported"
    },
    "voice_011:r_d9cd2e4ded064396": {
      "text": "I-Is this as far as I go?!",
      "status": "imported"
    },
    "voice_011:r_99e6349431aaf23b": {
      "text": "With this shield!",
      "status": "imported"
    },
    "voice_011:r_ec1081caf845f56a": {
      "text": "I'll block it!",
      "status": "imported"
    },
    "voice_011:r_2c5b7ee872c1ed7f": {
      "text": "I'll throw you off with my speed!",
      "status": "imported"
    }
  }
}
