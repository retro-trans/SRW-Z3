{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_091:r_479b340ccc6c572b": {
      "text": "I can hit you even over there!",
      "status": "imported"
    },
    "voice_091:r_ca4acbac57a2a35e": {
      "text": "If I have to fight, then I will!",
      "status": "imported"
    },
    "voice_091:r_77949221bf58f862": {
      "text": "I won't give you time to counter!",
      "status": "imported"
    },
    "voice_091:r_70b9c4b9f1f37eff": {
      "text": "You're wide open!",
      "status": "imported"
    },
    "voice_091:r_9fcb3754cb1773c7": {
      "text": "You...!",
      "status": "imported"
    },
    "voice_091:r_3559d2fad32c2435": {
      "text": "Raaah!",
      "status": "imported"
    },
    "voice_091:r_f7570547e9f80a64": {
      "text": "Distance won't stop me!",
      "status": "imported"
    },
    "voice_091:r_cbab0f4720e1fcf1": {
      "text": "I'll hit you dead-on!",
      "status": "imported"
    },
    "voice_091:r_0bbe0b4f5364e732": {
      "text": "Target locked... All right!",
      "status": "imported"
    },
    "voice_091:r_5dda5198137cb02a": {
      "text": "I'll end all war! This time!",
      "status": "imported"
    },
    "voice_091:r_83ec59afbecdec14": {
      "text": "I'll forge destiny, no matter what!",
      "status": "imported"
    },
    "voice_091:r_e20bfd42ad95a3c9": {
      "text": "I won't let you destroy our future!",
      "status": "imported"
    },
    "voice_091:r_0f58a8822381e57f": {
      "text": "I'll cut you down!",
      "status": "imported"
    },
    "voice_091:r_6dbcc507fb61b51d": {
      "text": "Haaaaah!",
      "status": "imported"
    },
    "voice_091:r_b42ab697149a7c8a": {
      "text": "This ends it!!",
      "status": "imported"
    },
    "voice_091:r_4de4fcf3b440baf4": {
      "text": "With this, I can take on anyone!",
      "status": "imported"
    },
    "voice_091:r_0121a166c715cdff": {
      "text": "I won't let you get away!!",
      "status": "imported"
    },
    "voice_091:r_80a0b2a84e05d81a": {
      "text": "With this kind of power!",
      "status": "imported"
    },
    "voice_091:r_4a9ac1dff86506d9": {
      "text": "There! Goooo!!",
      "status": "imported"
    },
    "voice_091:r_bc8538e6af3d2577": {
      "text": "Target locked! Here I go!",
      "status": "imported"
    },
    "voice_091:r_924516c8de2b5342": {
      "text": "There!",
      "status": "imported"
    },
    "voice_091:r_da1174533722333f": {
      "text": "Not yet! You won't get away!",
      "status": "imported"
    },
    "voice_091:r_fdeb8162976e72c1": {
      "text": "This is the finishing blow!!",
      "status": "imported"
    },
    "voice_091:r_0fadb5c26df92b42": {
      "text": "Destiny can fight\\nthis way too!",
      "status": "imported"
    },
    "voice_091:r_6b15af9a0057cdc8": {
      "text": "Now take this one!",
      "status": "imported"
    },
    "voice_091:r_15b4a90140e8a33a": {
      "text": "This'll do it!",
      "status": "imported"
    },
    "voice_091:r_af884a6b11dff121": {
      "text": "Go flying!!",
      "status": "imported"
    },
    "voice_091:r_ac6fe7838e95647b": {
      "text": "I won't let this chance slip away!",
      "status": "imported"
    },
    "voice_091:r_77ca87eacd17ad52": {
      "text": "I can still go!",
      "status": "imported"
    },
    "voice_091:r_bf3244994760e535": {
      "text": "I'll follow Freedom!",
      "status": "imported"
    },
    "voice_091:r_aabfb21c9d069ce7": {
      "text": "I'll back you up, Captain Quattro!",
      "status": "imported"
    },
    "voice_091:r_02479dc8fe989560": {
      "text": "Kamille! I'll take it from here!",
      "status": "imported"
    },
    "voice_091:r_a2df00f91a9b0a9e": {
      "text": "Captain Amuro, right behind you!",
      "status": "imported"
    },
    "voice_091:r_48b60d6c48b9b142": {
      "text": "I won't let you!",
      "status": "imported"
    },
    "voice_091:r_8927e6fb681aa809": {
      "text": "You're too far out front!",
      "status": "imported"
    },
    "voice_091:r_665f01666859013b": {
      "text": "Freedom, fall back!",
      "status": "imported"
    },
    "voice_091:r_a571eec59b258d11": {
      "text": "Captain Amuro, fall back!",
      "status": "imported"
    },
    "voice_091:r_ddbe581c5ea9183d": {
      "text": "Captain Quattro! Pull out now!",
      "status": "imported"
    },
    "voice_091:r_faae935cca0edc72": {
      "text": "Fall back, Kamille! Hurry!",
      "status": "imported"
    },
    "voice_091:r_d4430bf362340b32": {
      "text": "I won't lose one-on-one!",
      "status": "imported"
    },
    "voice_091:r_6ff1323b355593e0": {
      "text": "Focus your attacks!",
      "status": "imported"
    },
    "voice_091:r_b7b5625d7cd4282f": {
      "text": "If I can't act, why am I here...!",
      "status": "imported"
    },
    "voice_091:r_36133ad73a73ef98": {
      "text": "Where are you!? Where'd you go!?",
      "status": "imported"
    },
    "voice_091:r_920740a0219c5085": {
      "text": "Too slow!",
      "status": "imported"
    },
    "voice_091:r_a8451712c57c1a72": {
      "text": "I won't let you do as you please!",
      "status": "imported"
    },
    "voice_091:r_3633df5b7b8f47fa": {
      "text": "You're not even that good!",
      "status": "imported"
    },
    "voice_091:r_52dfc56b14b93551": {
      "text": "Like I'd let that hit me!",
      "status": "imported"
    },
    "voice_091:r_1b9b2aab5cb104da": {
      "text": "You call that an attack?!",
      "status": "imported"
    },
    "voice_091:r_342044c706a2340f": {
      "text": "You're too naive!",
      "status": "imported"
    },
    "voice_091:r_cf41e8828a90cbdb": {
      "text": "Looks like you can't keep up.",
      "status": "imported"
    },
    "voice_091:r_719e897304ec42d4": {
      "text": "You'll never keep up with Destiny!",
      "status": "imported"
    },
    "voice_091:r_d5e0a2317c40d322": {
      "text": "That's nothing!",
      "status": "imported"
    },
    "voice_091:r_ec2ea17765052401": {
      "text": "That won't work!",
      "status": "imported"
    },
    "voice_091:r_f2d4255f1c2f7542": {
      "text": "Don't underestimate Destiny!",
      "status": "imported"
    },
    "voice_091:r_5d08ad19e2da125b": {
      "text": "So you'll resist to the very end?!",
      "status": "imported"
    },
    "voice_091:r_a7246b52782a877e": {
      "text": "That attack won't take me down!",
      "status": "imported"
    },
    "voice_091:r_dc8701f6bcb9904f": {
      "text": "This is nothing!",
      "status": "imported"
    },
    "voice_091:r_d6bdd730f24f66eb": {
      "text": "One hit won't stop me!",
      "status": "imported"
    },
    "voice_091:r_41997412868c48c4": {
      "text": "Don't think you can stop me!",
      "status": "imported"
    },
    "voice_091:r_9e6cf4f389dae55c": {
      "text": "Guh! I can still fight!",
      "status": "imported"
    },
    "voice_091:r_9e0c80ac7e33b459": {
      "text": "You hit me! Damn you!",
      "status": "imported"
    },
    "voice_091:r_7432ef43ed3471dc": {
      "text": "Damn it! Don't think this is over!",
      "status": "imported"
    },
    "voice_091:r_065443f6ddfcf0d7": {
      "text": "What is that thing...? It's fast!",
      "status": "imported"
    },
    "voice_091:r_47d52a2839c71715": {
      "text": "It caught up to me...!",
      "status": "imported"
    },
    "voice_091:r_847f82e7f3eef651": {
      "text": "Not yet! I'm not beaten yet!",
      "status": "imported"
    },
    "voice_091:r_eb7ae28b53dc033c": {
      "text": "Damn it! I won't give up!!",
      "status": "imported"
    },
    "voice_091:r_857c4a52ce8df0fd": {
      "text": "I won't be beaten here!",
      "status": "imported"
    },
    "voice_091:r_55417493fce1d347": {
      "text": "You...! How dare you!!",
      "status": "imported"
    },
    "voice_091:r_8fdf5910927c9591": {
      "text": "Damn it! I can't take any more...!",
      "status": "imported"
    },
    "voice_091:r_7d724dbcc4451e10": {
      "text": "Destiny...\\npushed this far...!",
      "status": "imported"
    },
    "voice_091:r_93e25418a203cb8f": {
      "text": "No! Uwaaaaaah!!",
      "status": "imported"
    },
    "voice_091:r_adeb0a29274d3d9b": {
      "text": "Damn it! I protected nothing!!",
      "status": "imported"
    },
    "voice_091:r_24cf161287ef9d5c": {
      "text": "I'll beat you, end\\nthis battle!!",
      "status": "imported"
    },
    "voice_091:r_b1de76a75a253c13": {
      "text": "It's because people like you exist!",
      "status": "imported"
    },
    "voice_091:r_38fdff9483e9245c": {
      "text": "There you are!",
      "status": "imported"
    },
    "voice_091:r_620fedec67706d7d": {
      "text": "Damn you!",
      "status": "imported"
    },
    "voice_091:r_9680dcd0fddcfcc7": {
      "text": "I won't allow it!",
      "status": "imported"
    },
    "voice_091:r_46e86d000250e137": {
      "text": "Shinn here. I'm moving ahead!",
      "status": "imported"
    },
    "voice_091:r_ac341e7976e88f0b": {
      "text": "I'm moving out front!",
      "status": "imported"
    },
    "voice_091:r_cdbd128a5b4127cc": {
      "text": "I'll make the first move!",
      "status": "imported"
    },
    "voice_091:r_cfccaa1fbeda124c": {
      "text": "Don't think you can beat me!!",
      "status": "imported"
    },
    "voice_091:r_546c3d5937fbb7ee": {
      "text": "You dare, in a machine like that?!",
      "status": "imported"
    },
    "voice_091:r_1568ff6298b12b96": {
      "text": "Never again will the world burn!",
      "status": "imported"
    },
    "voice_091:r_a77f4913375098d2": {
      "text": "Chest Flyer!\\nForce Silhouette!",
      "status": "imported"
    },
    "voice_091:r_428c2116ac3071b1": {
      "text": "Shinn Asuka. Destiny, launching!",
      "status": "imported"
    },
    "voice_091:r_84c116267b79f540": {
      "text": "Got you!",
      "status": "imported"
    },
    "voice_091:r_70451ffbabe2f876": {
      "text": "No good! I'm ejecting!",
      "status": "imported"
    },
    "voice_091:r_69dfa1659715e2fa": {
      "text": "You can't handle this!",
      "status": "imported"
    },
    "voice_091:r_d996fd6d4ef5b329": {
      "text": "I won't take a direct hit!",
      "status": "imported"
    },
    "voice_091:r_8ab47a28f99ef565": {
      "text": "I'm charging straight through!",
      "status": "imported"
    },
    "voice_091:r_546de3fb6db156ea": {
      "text": "I don't care what your ideals are!",
      "status": "imported"
    },
    "voice_091:r_ca85f87cee5e31f7": {
      "text": "If you're right,\\nthen beat me!",
      "status": "imported"
    },
    "voice_091:r_9072ea7bc71df136": {
      "text": "Can your ideals\\nreally stop war!?",
      "status": "imported"
    },
    "voice_091:r_04e815a8d425827d": {
      "text": "No matter who I face, I...!",
      "status": "imported"
    },
    "voice_091:r_d89011fe3e5d082a": {
      "text": "For Orb...\\nEarth won't burn again!",
      "status": "imported"
    },
    "voice_091:r_3c5b0c2ac812d5de": {
      "text": "Humans are already fighting...!",
      "status": "imported"
    },
    "voice_091:r_5b9e8897190892eb": {
      "text": "If words won't get through to you!",
      "status": "imported"
    },
    "voice_091:r_7bea3023abbf8a94": {
      "text": "There's so many of them...!",
      "status": "imported"
    },
    "voice_091:r_dd01a4c0d1b36a8d": {
      "text": "You breed war!\\nYou ruin the world!",
      "status": "imported"
    },
    "voice_091:r_20920ad2eb3542db": {
      "text": "Your selfish whims! Enough!!",
      "status": "imported"
    },
    "voice_091:r_0ab7914877fd48ed": {
      "text": "You spread war...\\nNo forgiveness!",
      "status": "imported"
    },
    "voice_091:r_cb846feec748c2e3": {
      "text": "Why do you crave killing?!\\nWhy?!",
      "status": "imported"
    },
    "voice_091:r_c958860b0676b1f5": {
      "text": "God or not,\\nI'll guard our future!",
      "status": "imported"
    },
    "voice_091:r_5e2669b82ef75ce3": {
      "text": "Take them down...\\nand it all ends!",
      "status": "imported"
    },
    "voice_091:r_7847e0ed7dc9282d": {
      "text": "Any foe...\\nNever quit. End war!",
      "status": "imported"
    },
    "voice_091:r_95d047bcc17fccc6": {
      "text": "Kira, what are you doing?!",
      "status": "imported"
    },
    "voice_091:r_640327a12a559b31": {
      "text": "Freedom really is strong...!",
      "status": "imported"
    },
    "voice_091:r_bdd38c584fa313d0": {
      "text": "Setsuna, I'll take it from here!",
      "status": "imported"
    },
    "voice_091:r_3fd86c1027f317c8": {
      "text": "Such skill!\\nThey strike and block!",
      "status": "imported"
    },
    "voice_091:r_d0372a183d2007ad": {
      "text": "I won't lag behind that speed...!",
      "status": "imported"
    },
    "voice_091:r_217aa5e1d545b44d": {
      "text": "I'm used to taciturn partners!",
      "status": "imported"
    },
    "voice_091:r_381992c5d8224937": {
      "text": "From here, it's my turn as planned!",
      "status": "imported"
    },
    "voice_091:r_f1e7ed9e5874aba5": {
      "text": "Virgo combo...\\nWe're doing it?!",
      "status": "imported"
    },
    "voice_091:r_fc25e66a86fc2c85": {
      "text": "I'm no guardian, but...!",
      "status": "imported"
    },
    "voice_091:r_5aeeb4917340c42d": {
      "text": "They flanked Kira?! This is bad!",
      "status": "imported"
    },
    "voice_091:r_b765659981b6516d": {
      "text": "Freedom's armor can't take that!",
      "status": "imported"
    },
    "voice_091:r_0c427458bc00eb95": {
      "text": "Setsuna, I'm still holding up!",
      "status": "imported"
    },
    "voice_091:r_774a9ab4d8fd5351": {
      "text": "Those bits...!?\\nI'll shield them!",
      "status": "imported"
    },
    "voice_091:r_d3f01de714c015bd": {
      "text": "Protect her, right?! Then focus!",
      "status": "imported"
    },
    "voice_091:r_7d2617c809fead70": {
      "text": "Bio-unit or not,\\nvalue your life!",
      "status": "imported"
    },
    "voice_091:r_ceb935ccbf830724": {
      "text": "They're targeting Ptolemy...!",
      "status": "imported"
    },
    "voice_091:r_862ef7385bf2abd4": {
      "text": "Wake up!\\nSpace out and you'll die!",
      "status": "imported"
    },
    "voice_091:r_b28faf9f71bc3598": {
      "text": "Target acquired...! I can do this!",
      "status": "imported"
    },
    "voice_091:r_8a29278549f8e07a": {
      "text": "At this range, I can do it...!",
      "status": "imported"
    },
    "voice_091:r_7e6c573c26177f98": {
      "text": "Destiny and I can do this...!",
      "status": "imported"
    },
    "voice_091:r_45abf84f7757d6eb": {
      "text": "I'll break through head-on...!",
      "status": "imported"
    },
    "voice_091:r_edd7a13ab8f06a14": {
      "text": "I'll finish this right here...!",
      "status": "imported"
    },
    "voice_091:r_8165e5b41f0124c4": {
      "text": "I fight!\\nTo guard all I hold dear!",
      "status": "imported"
    },
    "voice_091:r_4e05581b7432cce8": {
      "text": "That's what you get for dawdling!",
      "status": "imported"
    },
    "voice_091:r_a60b107ea3c36a86": {
      "text": "This time, I'll shoot you down!",
      "status": "imported"
    },
    "voice_091:r_e33693e5ba4665b0": {
      "text": "Careless? Then take one more!",
      "status": "imported"
    },
    "voice_091:r_72a21a1a489af001": {
      "text": "Quattro!\\nYou chose this path?!",
      "status": "imported"
    },
    "voice_091:r_eb643f8bf737a0ca": {
      "text": "I swore...\\nI'll keep it, Quattro!",
      "status": "imported"
    },
    "voice_091:r_0a3fccb71ec6cf2a": {
      "text": "Haman!\\nYou call this battle just?!",
      "status": "imported"
    },
    "voice_091:r_9b63cf1f3e0207ef": {
      "text": "I'll defeat you and end this war!",
      "status": "imported"
    },
    "voice_091:r_8356f4e3dcdff938": {
      "text": "I'll stop you, Full Frontal!",
      "status": "imported"
    },
    "voice_091:r_1d6d784036ae0bd7": {
      "text": "A Gundam foe...\\nI can't lose now!",
      "status": "imported"
    },
    "voice_091:r_625664af02183c17": {
      "text": "Can you really handle a Gundam?!",
      "status": "imported"
    },
    "voice_091:r_3701cba361f80ea5": {
      "text": "What are you doing?! Wake up!",
      "status": "imported"
    },
    "voice_091:r_63f429c5c68c0863": {
      "text": "Will you let a machine beat you?!",
      "status": "imported"
    },
    "voice_091:r_38e4a434c91d8ef0": {
      "text": "Your side alone\\nis right?!",
      "status": "imported"
    },
    "voice_091:r_98ed411352a3a6ac": {
      "text": "You just spread war!\\nAll of you!",
      "status": "imported"
    },
    "voice_091:r_4824bea6bab3af67": {
      "text": "Whatever the reason,\\nI reject war!",
      "status": "imported"
    },
    "voice_091:r_862b92e63adb9734": {
      "text": "Do you want war that badly?!",
      "status": "imported"
    },
    "voice_091:r_57b2bd2de8a1408d": {
      "text": "War solves nothing!\\nGet it?!",
      "status": "imported"
    },
    "voice_091:r_288133bc5b573dae": {
      "text": "This thing\\ncan't fall on Earth!",
      "status": "imported"
    },
    "voice_091:r_6f95653e548f8fcf": {
      "text": "You'll repeat Stella's tragedy...!?",
      "status": "imported"
    },
    "voice_091:r_d249d68bada91ab9": {
      "text": "Find yourself!\\nReclaim your will!",
      "status": "imported"
    },
    "voice_091:r_e9b3307e9eb69f11": {
      "text": "You're being used\\nas a weapon!",
      "status": "imported"
    },
    "voice_091:r_981f8fedd5414fe5": {
      "text": "Unknown unit! You've been warned!",
      "status": "imported"
    },
    "voice_091:r_96bb0dcde0c8c44a": {
      "text": "What are you people after?!",
      "status": "imported"
    },
    "voice_091:r_641550a2f54cb456": {
      "text": "I won't let your kind run wild!",
      "status": "imported"
    },
    "voice_091:r_a0f2074af8debbfa": {
      "text": "You...! Striking at everything!",
      "status": "imported"
    },
    "voice_091:r_b5f5a97ed82acb0b": {
      "text": "I'm used to fighting monsters!",
      "status": "imported"
    },
    "voice_091:r_d9cd2e4ded064396": {
      "text": "We won't sit back and be destroyed!",
      "status": "imported"
    },
    "voice_091:r_ec1081caf845f56a": {
      "text": "Space monster! You go no farther!",
      "status": "imported"
    },
    "voice_091:r_2c5b7ee872c1ed7f": {
      "text": "You gave up,\\nthen cowered in fear!",
      "status": "imported"
    },
    "voice_091:r_76d1e51c8b494a60": {
      "text": "You chose despair\\nand lost hope!",
      "status": "imported"
    },
    "voice_091:r_eb5f687fcd372ae7": {
      "text": "No past...\\nYou call it happiness?!",
      "status": "imported"
    },
    "voice_091:r_2329428a6871d9fa": {
      "text": "I won't let the world end\\nhere!",
      "status": "imported"
    },
    "voice_091:r_0e7466971bec4cc4": {
      "text": "Mere kidnappers won't beat me...!",
      "status": "imported"
    },
    "voice_091:r_efa71f7a4cc33ff3": {
      "text": "Damn you!\\nNo god could be so evil!",
      "status": "imported"
    },
    "voice_091:r_3fc2e1186557e7a0": {
      "text": "You're no gods! You're my enemies!",
      "status": "imported"
    },
    "voice_091:r_fa6930340a545054": {
      "text": "Conquer Earth?!\\nI won't allow it!",
      "status": "imported"
    },
    "voice_091:r_2332b9d56461d7ab": {
      "text": "I won't accept rule by force!",
      "status": "imported"
    },
    "voice_091:r_854aa0a91a3c80d1": {
      "text": "I'll crush that pathetic ambition!",
      "status": "imported"
    },
    "voice_091:r_0bc8ae32a406ceab": {
      "text": "You made this war.\\nNo forgiveness!",
      "status": "imported"
    },
    "voice_091:r_82c09f011d703b2c": {
      "text": "I'll defeat you and stop this war!",
      "status": "imported"
    },
    "voice_091:r_686df329b50f195b": {
      "text": "Before you can withdraw...!",
      "status": "imported"
    },
    "voice_091:r_25f0ab0fa3cf690c": {
      "text": "Now it's our turn!",
      "status": "imported"
    },
    "voice_091:r_b708a1d959013dbf": {
      "text": "That's what carelessness gets you!",
      "status": "imported"
    },
    "voice_091:r_59fca03e929366c1": {
      "text": "Like I'd let that slip by!",
      "status": "imported"
    },
    "voice_091:r_0d65eb631dcb7514": {
      "text": "Time for my counterattack!",
      "status": "imported"
    },
    "voice_091:r_d03018a31e23f1e9": {
      "text": "You came out on your own!",
      "status": "imported"
    },
    "voice_091:r_279da5f732aa8847": {
      "text": "You're the ones who started this!",
      "status": "imported"
    },
    "voice_091:r_97f82e3cb6f70110": {
      "text": "We'll turn this into a chance!",
      "status": "imported"
    },
    "voice_091:r_c5611d8dd6def96b": {
      "text": "I can handle teamwork too...!",
      "status": "imported"
    },
    "voice_091:r_6f12cc8ed2732eb5": {
      "text": "Not yet! I'm here too!",
      "status": "imported"
    },
    "voice_091:r_7abfc55f8fb62ba7": {
      "text": "Captain Amuro created an opening!",
      "status": "imported"
    },
    "voice_091:r_99e7a66c650b5892": {
      "text": "I've got this, Captain Quattro!",
      "status": "imported"
    },
    "voice_091:r_5b2247b5cfbcd7b2": {
      "text": "Kamille! I'll handle this one!",
      "status": "imported"
    },
    "voice_091:r_2d7a9c06347582d9": {
      "text": "Unicorn created an opening!",
      "status": "imported"
    },
    "voice_091:r_bf953d64c3c7d9b7": {
      "text": "Captain! Leave the attack to us!",
      "status": "imported"
    },
    "voice_091:r_e09b933e3e706779": {
      "text": "Time to switch, Gyunei!",
      "status": "imported"
    },
    "voice_091:r_66236eb99b676e5b": {
      "text": "You always rush too far ahead...!",
      "status": "imported"
    },
    "voice_091:r_9639a2dbcd2f58ed": {
      "text": "Destiny should be able to take it!",
      "status": "imported"
    },
    "voice_091:r_aeea0893acb93d35": {
      "text": "Captain Amuro! I'll hold them here!",
      "status": "imported"
    },
    "voice_091:r_b31568654e53487b": {
      "text": "I won't let them get Quattro!",
      "status": "imported"
    },
    "voice_091:r_2502132569141ea3": {
      "text": "Where are you looking, Kamille?!",
      "status": "imported"
    },
    "voice_091:r_1ff312798a52c8eb": {
      "text": "I'll be Unicorn's shield!",
      "status": "imported"
    },
    "voice_091:r_fa07d90fca62f593": {
      "text": "Pull the ship back, quickly!",
      "status": "imported"
    },
    "voice_091:r_a25bf2676ecf9d83": {
      "text": "You pressed too far, Gyunei!",
      "status": "imported"
    },
    "voice_091:r_237a0288b42dce20": {
      "text": "We can defend...\\nbut not forever!",
      "status": "imported"
    },
    "voice_091:r_0556e8a22779ea8e": {
      "text": "Damn it! We're just taking hits!",
      "status": "imported"
    },
    "voice_091:r_09d377101a48d92a": {
      "text": "I can't counterattack like this...!",
      "status": "imported"
    },
    "voice_091:r_11517cc7b0494dbf": {
      "text": "Bad! I've got no weapons left!",
      "status": "imported"
    },
    "voice_091:r_b5864501463db244": {
      "text": "No...! This range puts me at risk!",
      "status": "imported"
    },
    "voice_091:r_a88939ea84b4474d": {
      "text": "If I stay,\\nthey'll tear me up...!",
      "status": "imported"
    },
    "voice_091:r_a870d0cf7cc11ec6": {
      "text": "Stopping? Guess I'll rest too.",
      "status": "imported"
    },
    "voice_091:r_03f6158ef83964f3": {
      "text": "Fight, rest, and always come back.",
      "status": "imported"
    },
    "voice_091:r_2970a83693cdcc25": {
      "text": "Together is our only way to peace.",
      "status": "imported"
    },
    "voice_091:r_be661448b85d0009": {
      "text": "Then I'll be waiting!",
      "status": "imported"
    },
    "voice_091:r_958a56c1151cab9e": {
      "text": "You and I go way back now.",
      "status": "imported"
    },
    "voice_091:r_8b18aa4cc69547df": {
      "text": "Quit bringing up the old days!",
      "status": "imported"
    },
    "voice_091:r_3e87f6fc3ea65aef": {
      "text": "Too soon. The fight isn't over yet.",
      "status": "imported"
    },
    "voice_091:r_5508a7bfa9074eb9": {
      "text": "Don't force\\nyour selfish ideals!",
      "status": "imported"
    },
    "voice_091:r_09a003e91f0d5dc7": {
      "text": "Nothing but pretty words...!",
      "status": "imported"
    },
    "voice_091:r_192447448ebd7bb5": {
      "text": "A world crushing\\nhopes and dreams!",
      "status": "imported"
    },
    "voice_091:r_25f9b1e39dd8d366": {
      "text": "Concentrate our firepower!",
      "status": "imported"
    },
    "voice_091:r_307477bedd148060": {
      "text": "I'll disrupt their front line!",
      "status": "imported"
    },
    "voice_091:r_09a780acca0eb4b0": {
      "text": "I'll draw the enemy in...!",
      "status": "imported"
    },
    "voice_091:r_af62f2ee466b5c8c": {
      "text": "If I can help even a little...!",
      "status": "imported"
    },
    "voice_091:r_20cfb719db02fafd": {
      "text": "Good! Just as planned!",
      "status": "imported"
    },
    "voice_091:r_570c1fdf72edb283": {
      "text": "Shinn here. Attacking the front!",
      "status": "imported"
    },
    "voice_091:r_23f0d87a5a6cfca1": {
      "text": "Spread out! Engage one by one!",
      "status": "imported"
    },
    "voice_091:r_60c94ea4eb7f7404": {
      "text": "I'll split the enemy up!",
      "status": "imported"
    }
  }
}
