{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_137:r_479b340ccc6c572b": {
      "text": "Go down!",
      "status": "imported"
    },
    "voice_137:r_ca4acbac57a2a35e": {
      "text": "I won't let you!",
      "status": "imported"
    },
    "voice_137:r_77949221bf58f862": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_137:r_70b9c4b9f1f37eff": {
      "text": "Hit!",
      "status": "imported"
    },
    "voice_137:r_9fcb3754cb1773c7": {
      "text": "Now's my chance!",
      "status": "imported"
    },
    "voice_137:r_3559d2fad32c2435": {
      "text": "I'm a pilot too!",
      "status": "imported"
    },
    "voice_137:r_f7570547e9f80a64": {
      "text": "I'll show you I can do this!",
      "status": "imported"
    },
    "voice_137:r_cbab0f4720e1fcf1": {
      "text": "I have no choice but to fight now!",
      "status": "imported"
    },
    "voice_137:r_0bbe0b4f5364e732": {
      "text": "I've got no choice but to do this!",
      "status": "imported"
    },
    "voice_137:r_5dda5198137cb02a": {
      "text": "There's an opening! Now!",
      "status": "imported"
    },
    "voice_137:r_83ec59afbecdec14": {
      "text": "Funnel! Go!!",
      "status": "imported"
    },
    "voice_137:r_e20bfd42ad95a3c9": {
      "text": "Hyaaah!",
      "status": "imported"
    },
    "voice_137:r_0f58a8822381e57f": {
      "text": "Funnel! I'm counting on you!",
      "status": "imported"
    },
    "voice_137:r_6dbcc507fb61b51d": {
      "text": "Go!!",
      "status": "imported"
    },
    "voice_137:r_4de4fcf3b440baf4": {
      "text": "There! Fin Funnel!",
      "status": "imported"
    },
    "voice_137:r_30fad37a42bd3ad3": {
      "text": "I've got you in my sights!",
      "status": "imported"
    },
    "voice_137:r_80a0b2a84e05d81a": {
      "text": "Please, let this hit!",
      "status": "imported"
    },
    "voice_137:r_4a9ac1dff86506d9": {
      "text": "I can't afford to miss this!",
      "status": "imported"
    },
    "voice_137:r_924516c8de2b5342": {
      "text": "I'll attack too!",
      "status": "imported"
    },
    "voice_137:r_da1174533722333f": {
      "text": "I have to move up!",
      "status": "imported"
    },
    "voice_137:r_fdeb8162976e72c1": {
      "text": "Kamille, you go on ahead!",
      "status": "imported"
    },
    "voice_137:r_0fadb5c26df92b42": {
      "text": "Captain Quattro, I'll cover you!",
      "status": "imported"
    },
    "voice_137:r_6b15af9a0057cdc8": {
      "text": "No! I won't let you!",
      "status": "imported"
    },
    "voice_137:r_15b4a90140e8a33a": {
      "text": "I'll block it!",
      "status": "imported"
    },
    "voice_137:r_af884a6b11dff121": {
      "text": "I won't let you hurt Kamille!",
      "status": "imported"
    },
    "voice_137:r_ac6fe7838e95647b": {
      "text": "Captain! Leave this to me!",
      "status": "imported"
    },
    "voice_137:r_77ca87eacd17ad52": {
      "text": "Kamille! Get out of here, now!",
      "status": "imported"
    },
    "voice_137:r_bf3244994760e535": {
      "text": "I've got to do my part!",
      "status": "imported"
    },
    "voice_137:r_aabfb21c9d069ce7": {
      "text": "I just have to move with everyone!",
      "status": "imported"
    },
    "voice_137:r_02479dc8fe989560": {
      "text": "I-I have to withdraw, fast!",
      "status": "imported"
    },
    "voice_137:r_a2df00f91a9b0a9e": {
      "text": "This way, I'll be a sitting duck!",
      "status": "imported"
    },
    "voice_137:r_48b60d6c48b9b142": {
      "text": "I-I lost sight of them!",
      "status": "imported"
    },
    "voice_137:r_8927e6fb681aa809": {
      "text": "W-Where did they go!?",
      "status": "imported"
    },
    "voice_137:r_665f01666859013b": {
      "text": "I've trained for this too!",
      "status": "imported"
    },
    "voice_137:r_a571eec59b258d11": {
      "text": "I dodged it!",
      "status": "imported"
    },
    "voice_137:r_ddbe581c5ea9183d": {
      "text": "I won't be your target!",
      "status": "imported"
    },
    "voice_137:r_faae935cca0edc72": {
      "text": "I can't let Kamille worry.\\nI won't!",
      "status": "imported"
    },
    "voice_137:r_d4430bf362340b32": {
      "text": "I missed!",
      "status": "imported"
    },
    "voice_137:r_6ff1323b355593e0": {
      "text": "At this rate, I can handle this!",
      "status": "imported"
    },
    "voice_137:r_b7b5625d7cd4282f": {
      "text": "I owe that to the Methuss!",
      "status": "imported"
    },
    "voice_137:r_36133ad73a73ef98": {
      "text": "I can handle the Methuss too!",
      "status": "imported"
    },
    "voice_137:r_920740a0219c5085": {
      "text": "The I-Field worked!",
      "status": "imported"
    },
    "voice_137:r_a8451712c57c1a72": {
      "text": "The frame isn't damaged!",
      "status": "imported"
    },
    "voice_137:r_3633df5b7b8f47fa": {
      "text": "I-It's shaking!?",
      "status": "imported"
    },
    "voice_137:r_52dfc56b14b93551": {
      "text": "T-The armor stopped it!?",
      "status": "imported"
    },
    "voice_137:r_1b9b2aab5cb104da": {
      "text": "They'll read any simple move!",
      "status": "imported"
    },
    "voice_137:r_342044c706a2340f": {
      "text": "S-So that's a Gundam for you!?",
      "status": "imported"
    },
    "voice_137:r_cf41e8828a90cbdb": {
      "text": "I-I have to stabilize the unit!",
      "status": "imported"
    },
    "voice_137:r_719e897304ec42d4": {
      "text": "This is war!\\nI was ready for this!",
      "status": "imported"
    },
    "voice_137:r_d5e0a2317c40d322": {
      "text": "Stay calm.\\nWatch the enemy closely!",
      "status": "imported"
    },
    "voice_137:r_ec2ea17765052401": {
      "text": "If the thrusters work, I can fight!",
      "status": "imported"
    },
    "voice_137:r_f2d4255f1c2f7542": {
      "text": "Aaaah!",
      "status": "imported"
    },
    "voice_137:r_5d08ad19e2da125b": {
      "text": "Damn! Am I no match for a Gundam!?",
      "status": "imported"
    },
    "voice_137:r_a7246b52782a877e": {
      "text": "W-What is with that Gundam!?",
      "status": "imported"
    },
    "voice_137:r_41997412868c48c4": {
      "text": "S-So strong! At this rate...!",
      "status": "imported"
    },
    "voice_137:r_9e6cf4f389dae55c": {
      "text": "I couldn't track the enemy's path!",
      "status": "imported"
    },
    "voice_137:r_9e0c80ac7e33b459": {
      "text": "It's nothing but warning messages!",
      "status": "imported"
    },
    "voice_137:r_7432ef43ed3471dc": {
      "text": "I won't be a burden to Kamille!",
      "status": "imported"
    },
    "voice_137:r_065443f6ddfcf0d7": {
      "text": "Kyaaaah!",
      "status": "imported"
    },
    "voice_137:r_47d52a2839c71715": {
      "text": "D-Direct hit!? No way!",
      "status": "imported"
    },
    "voice_137:r_847f82e7f3eef651": {
      "text": "I-I'm ejecting!",
      "status": "imported"
    },
    "voice_137:r_eb7ae28b53dc033c": {
      "text": "S-So this is as far as I go!",
      "status": "imported"
    },
    "voice_137:r_24cf161287ef9d5c": {
      "text": "I won't let you have this world!",
      "status": "imported"
    },
    "voice_137:r_8f60f6fc86db3107": {
      "text": "I can't lose here!\\nNo matter what!",
      "status": "imported"
    },
    "voice_137:r_a007f9ab9cf048b3": {
      "text": "My attack was deflected!?",
      "status": "imported"
    },
    "voice_137:r_a554ceef5c87b972": {
      "text": "That enemy's strong! But...!",
      "status": "imported"
    },
    "voice_137:r_2c9d94ba13c5fc50": {
      "text": "Methuss here! Beginning attack!",
      "status": "imported"
    },
    "voice_137:r_428c2116ac3071b1": {
      "text": "Reccoa!\\nI'll stop you myself!",
      "status": "imported"
    },
    "voice_137:r_7bea3023abbf8a94": {
      "text": "I can't win alone,\\nbut I can stall!",
      "status": "imported"
    },
    "voice_137:r_cb846feec748c2e3": {
      "text": "I can still fight!",
      "status": "imported"
    },
    "voice_137:r_c958860b0676b1f5": {
      "text": "I can do it one more time!",
      "status": "imported"
    },
    "voice_137:r_5e2669b82ef75ce3": {
      "text": "Kyaaah!! Kamille!",
      "status": "imported"
    },
    "voice_137:r_7847e0ed7dc9282d": {
      "text": "N-Not here... All alone...!",
      "status": "imported"
    },
    "voice_137:r_e42b52c7a987b906": {
      "text": "W-Where was I hit!?",
      "status": "imported"
    },
    "voice_137:r_6825fd1ff907bd22": {
      "text": "I-I didn't make it in time!",
      "status": "imported"
    },
    "voice_137:r_607f666f1563bc0d": {
      "text": "I can't let myself flinch!",
      "status": "imported"
    },
    "voice_137:r_97b7431eeb81e6b6": {
      "text": "You won't hit me!",
      "status": "imported"
    },
    "voice_137:r_132f605d02975e71": {
      "text": "I have to dodge the next one too!",
      "status": "imported"
    },
    "voice_137:r_9b9726b1872759d6": {
      "text": "You can't reach me here!",
      "status": "imported"
    },
    "voice_137:r_1252db29683fefe0": {
      "text": "I can handle this much!",
      "status": "imported"
    },
    "voice_137:r_c8c59db85bf875e6": {
      "text": "Roger! I'll give it a try!",
      "status": "imported"
    },
    "voice_137:r_391aa56435d9dd6e": {
      "text": "Understood!",
      "status": "imported"
    },
    "voice_137:r_7c796ba53bd7ea03": {
      "text": "I'll keep them pinned!",
      "status": "imported"
    }
  }
}
