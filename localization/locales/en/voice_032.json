{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_032:r_479b340ccc6c572b": {
      "text": "This'll do!",
      "status": "imported"
    },
    "voice_032:r_ca4acbac57a2a35e": {
      "text": "I've got you!",
      "status": "imported"
    },
    "voice_032:r_77949221bf58f862": {
      "text": "There!",
      "status": "imported"
    },
    "voice_032:r_70b9c4b9f1f37eff": {
      "text": "I'll take you down!",
      "status": "imported"
    },
    "voice_032:r_9fcb3754cb1773c7": {
      "text": "I won't miss that opening!",
      "status": "imported"
    },
    "voice_032:r_3559d2fad32c2435": {
      "text": "I'll make the first move!",
      "status": "imported"
    },
    "voice_032:r_f7570547e9f80a64": {
      "text": "To protect the civilians!",
      "status": "imported"
    },
    "voice_032:r_cbab0f4720e1fcf1": {
      "text": "For the sake of peace!",
      "status": "imported"
    },
    "voice_032:r_0bbe0b4f5364e732": {
      "text": "I fight as a soldier, nothing more!",
      "status": "imported"
    },
    "voice_032:r_5dda5198137cb02a": {
      "text": "You're within range!",
      "status": "imported"
    },
    "voice_032:r_83ec59afbecdec14": {
      "text": "Locked on! You won't get away!",
      "status": "imported"
    },
    "voice_032:r_e20bfd42ad95a3c9": {
      "text": "Why, you...!",
      "status": "imported"
    },
    "voice_032:r_0f58a8822381e57f": {
      "text": "Hraah!",
      "status": "imported"
    },
    "voice_032:r_6dbcc507fb61b51d": {
      "text": "Haaaaah!",
      "status": "imported"
    },
    "voice_032:r_b42ab697149a7c8a": {
      "text": "You monster!\\nWhatever your plot is!",
      "status": "imported"
    },
    "voice_032:r_4de4fcf3b440baf4": {
      "text": "Any foe,\\nI'll protect civilians!",
      "status": "imported"
    },
    "voice_032:r_af884a6b11dff121": {
      "text": "You should've kept your distance!",
      "status": "imported"
    },
    "voice_032:r_ac6fe7838e95647b": {
      "text": "Keep me company a little longer!",
      "status": "imported"
    },
    "voice_032:r_d4430bf362340b32": {
      "text": "I'll provide support!",
      "status": "imported"
    },
    "voice_032:r_6ff1323b355593e0": {
      "text": "Don't give up!",
      "status": "imported"
    },
    "voice_032:r_b7b5625d7cd4282f": {
      "text": "Gundam, if you're with us, I'll aid!",
      "status": "imported"
    },
    "voice_032:r_36133ad73a73ef98": {
      "text": "I'm moving to support Gundam!",
      "status": "imported"
    },
    "voice_032:r_920740a0219c5085": {
      "text": "Celestial Being, leave this to me!",
      "status": "imported"
    },
    "voice_032:r_a8451712c57c1a72": {
      "text": "Major, I'll take it from here!",
      "status": "imported"
    },
    "voice_032:r_3633df5b7b8f47fa": {
      "text": "Witness Earth Federation teamwork!",
      "status": "imported"
    },
    "voice_032:r_52dfc56b14b93551": {
      "text": "I'll handle this!",
      "status": "imported"
    },
    "voice_032:r_1b9b2aab5cb104da": {
      "text": "I won't abandon a single life!",
      "status": "imported"
    },
    "voice_032:r_342044c706a2340f": {
      "text": "We can't afford to lose Gundam!",
      "status": "imported"
    },
    "voice_032:r_cf41e8828a90cbdb": {
      "text": "I'll protect Gundam!",
      "status": "imported"
    },
    "voice_032:r_719e897304ec42d4": {
      "text": "Fall back, Celestial Being!",
      "status": "imported"
    },
    "voice_032:r_d5e0a2317c40d322": {
      "text": "Major, please fall back!",
      "status": "imported"
    },
    "voice_032:r_ec2ea17765052401": {
      "text": "I need you to stay immortal!",
      "status": "imported"
    },
    "voice_032:r_f2d4255f1c2f7542": {
      "text": "I can't even follow the manual...!",
      "status": "imported"
    },
    "voice_032:r_5d08ad19e2da125b": {
      "text": "Damn... Such a rookie mistake...!",
      "status": "imported"
    },
    "voice_032:r_a7246b52782a877e": {
      "text": "GN particle reserves...!?",
      "status": "imported"
    },
    "voice_032:r_dc8701f6bcb9904f": {
      "text": "Our equipment can't handle this!",
      "status": "imported"
    },
    "voice_032:r_d6bdd730f24f66eb": {
      "text": "We can't even fight back!?",
      "status": "imported"
    },
    "voice_032:r_41997412868c48c4": {
      "text": "I can manage this much!",
      "status": "imported"
    },
    "voice_032:r_9e6cf4f389dae55c": {
      "text": "Just stay calm and handle it!",
      "status": "imported"
    },
    "voice_032:r_9e0c80ac7e33b459": {
      "text": "I can't let that hit me!",
      "status": "imported"
    },
    "voice_032:r_7432ef43ed3471dc": {
      "text": "You misjudged this unit's agility!",
      "status": "imported"
    },
    "voice_032:r_065443f6ddfcf0d7": {
      "text": "Divert GN particles to thrust!",
      "status": "imported"
    },
    "voice_032:r_47d52a2839c71715": {
      "text": "I've built up combat experience!",
      "status": "imported"
    },
    "voice_032:r_847f82e7f3eef651": {
      "text": "I've prepared for this much!",
      "status": "imported"
    },
    "voice_032:r_eb7ae28b53dc033c": {
      "text": "The system seems to work just fine.",
      "status": "imported"
    },
    "voice_032:r_857c4a52ce8df0fd": {
      "text": "The equipment saved me...!",
      "status": "imported"
    },
    "voice_032:r_8fdf5910927c9591": {
      "text": "I couldn't dodge it all...!",
      "status": "imported"
    },
    "voice_032:r_7d724dbcc4451e10": {
      "text": "This damage is nothing serious.",
      "status": "imported"
    },
    "voice_032:r_93e25418a203cb8f": {
      "text": "Damn...! They got around me...!",
      "status": "imported"
    },
    "voice_032:r_adeb0a29274d3d9b": {
      "text": "So they're trying to pin me down...!",
      "status": "imported"
    },
    "voice_032:r_24cf161287ef9d5c": {
      "text": "Tch, don't get in my way!",
      "status": "imported"
    },
    "voice_032:r_8f60f6fc86db3107": {
      "text": "What incredible performance...!",
      "status": "imported"
    },
    "voice_032:r_b1de76a75a253c13": {
      "text": "They're more skilled than I am...!",
      "status": "imported"
    },
    "voice_032:r_128c35bf3e0e394c": {
      "text": "Ghh! They're tough!",
      "status": "imported"
    },
    "voice_032:r_5213c17e13b23de0": {
      "text": "Damn, to struggle this badly...!",
      "status": "imported"
    },
    "voice_032:r_38fdff9483e9245c": {
      "text": "I underestimated their strength...!",
      "status": "imported"
    },
    "voice_032:r_620fedec67706d7d": {
      "text": "Can't let them dictate the pace...!",
      "status": "imported"
    },
    "voice_032:r_9680dcd0fddcfcc7": {
      "text": "It's dire...!\\nBut I won't give in!",
      "status": "imported"
    },
    "voice_032:r_2a00f1044ad5cbaa": {
      "text": "Such a vast gap in strength...!",
      "status": "imported"
    },
    "voice_032:r_3dbeead1bd3164ef": {
      "text": "Gnnn! I won't flee to save myself!",
      "status": "imported"
    },
    "voice_032:r_98d15b8cc09bc915": {
      "text": "Ghh! I can't die here with regrets!",
      "status": "imported"
    },
    "voice_032:r_46e86d000250e137": {
      "text": "I'll fight while this machine moves!",
      "status": "imported"
    },
    "voice_032:r_ac341e7976e88f0b": {
      "text": "Ugh! Such strength...!",
      "status": "imported"
    },
    "voice_032:r_cdbd128a5b4127cc": {
      "text": "They're overpowering me!?",
      "status": "imported"
    },
    "voice_032:r_cfccaa1fbeda124c": {
      "text": "Not yet!\\nUntil peace is safe again!",
      "status": "imported"
    },
    "voice_032:r_b1f8ec192b9c083a": {
      "text": "So I still have much to learn...!",
      "status": "imported"
    },
    "voice_032:r_a007f9ab9cf048b3": {
      "text": "I-I'm ejecting!",
      "status": "imported"
    },
    "voice_032:r_ddafde4b065ced49": {
      "text": "Is this as far as I go...!",
      "status": "imported"
    },
    "voice_032:r_de1213040856c089": {
      "text": "You'll face me as well!",
      "status": "imported"
    },
    "voice_032:r_3304412ac41f47a6": {
      "text": "Concentrate your fire!",
      "status": "imported"
    },
    "voice_032:r_0c0775e051211840": {
      "text": "I'm the one you're fighting!",
      "status": "imported"
    },
    "voice_032:r_a2afffe1c396f0b3": {
      "text": "I've been tasked to take them on!",
      "status": "imported"
    }
  }
}
