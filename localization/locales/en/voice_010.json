{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_010:r_479b340ccc6c572b": {
      "text": "My name is MIXY...!",
      "status": "imported"
    },
    "voice_010:r_ca4acbac57a2a35e": {
      "text": "Altair's future lies with Izumo!",
      "status": "imported"
    },
    "voice_010:r_77949221bf58f862": {
      "text": "Do you mean to defy Izumo too?!",
      "status": "imported"
    },
    "voice_010:r_70b9c4b9f1f37eff": {
      "text": "For this planet's future!",
      "status": "imported"
    },
    "voice_010:r_9fcb3754cb1773c7": {
      "text": "Fight me, warriors of Vega!",
      "status": "imported"
    },
    "voice_010:r_3559d2fad32c2435": {
      "text": "I won't let you leave here alive!",
      "status": "imported"
    },
    "voice_010:r_f7570547e9f80a64": {
      "text": "I'll destroy all who defy Altair!",
      "status": "imported"
    },
    "voice_010:r_cbab0f4720e1fcf1": {
      "text": "Before Iron-C collapses,\\nI must...!",
      "status": "imported"
    },
    "voice_010:r_0bbe0b4f5364e732": {
      "text": "This isn't over yet!",
      "status": "imported"
    },
    "voice_010:r_5dda5198137cb02a": {
      "text": "I'll press the attack all at once!",
      "status": "imported"
    },
    "voice_010:r_83ec59afbecdec14": {
      "text": "Curse you, Angel...!",
      "status": "imported"
    },
    "voice_010:r_e20bfd42ad95a3c9": {
      "text": "Ngh...! Your words disgust me!",
      "status": "imported"
    },
    "voice_010:r_0f58a8822381e57f": {
      "text": "I hate holes...!\\nAnd I hate you!!",
      "status": "imported"
    },
    "voice_010:r_6dbcc507fb61b51d": {
      "text": "I'll beat the Angel, Altair's foe!",
      "status": "imported"
    },
    "voice_010:r_b42ab697149a7c8a": {
      "text": "I've got you!",
      "status": "imported"
    },
    "voice_010:r_4de4fcf3b440baf4": {
      "text": "I'll hit you!",
      "status": "imported"
    },
    "voice_010:r_0121a166c715cdff": {
      "text": "Vanish!",
      "status": "imported"
    },
    "voice_010:r_30fad37a42bd3ad3": {
      "text": "I won't miss!",
      "status": "imported"
    },
    "voice_010:r_80a0b2a84e05d81a": {
      "text": "Target locked... Go!",
      "status": "imported"
    },
    "voice_010:r_4a9ac1dff86506d9": {
      "text": "You won't get away!",
      "status": "imported"
    },
    "voice_010:r_02479dc8fe989560": {
      "text": "I let you counterattack?!",
      "status": "imported"
    },
    "voice_010:r_a2df00f91a9b0a9e": {
      "text": "You'll pay dearly for that!",
      "status": "imported"
    },
    "voice_010:r_48b60d6c48b9b142": {
      "text": "Don't think you can escape!",
      "status": "imported"
    },
    "voice_010:r_8927e6fb681aa809": {
      "text": "Now it's my turn!",
      "status": "imported"
    },
    "voice_010:r_665f01666859013b": {
      "text": "I'm not so soft as to let you flee!",
      "status": "imported"
    },
    "voice_010:r_a571eec59b258d11": {
      "text": "I'll pay you back more than double!",
      "status": "imported"
    },
    "voice_010:r_ddbe581c5ea9183d": {
      "text": "I'll follow my comrades!",
      "status": "imported"
    },
    "voice_010:r_faae935cca0edc72": {
      "text": "Witness our unity!",
      "status": "imported"
    },
    "voice_010:r_d4430bf362340b32": {
      "text": "Izumo, I'll cover you!",
      "status": "imported"
    },
    "voice_010:r_6ff1323b355593e0": {
      "text": "Anything for Altair!",
      "status": "imported"
    },
    "voice_010:r_b7b5625d7cd4282f": {
      "text": "I won't let you hurt my comrade!",
      "status": "imported"
    },
    "voice_010:r_36133ad73a73ef98": {
      "text": "Izumo embodies Altair's future!",
      "status": "imported"
    },
    "voice_010:r_920740a0219c5085": {
      "text": "I can't counterattack...!?",
      "status": "imported"
    },
    "voice_010:r_a8451712c57c1a72": {
      "text": "Such shame at a crucial moment...!",
      "status": "imported"
    },
    "voice_010:r_3633df5b7b8f47fa": {
      "text": "We'll be at the enemy's mercy!",
      "status": "imported"
    },
    "voice_010:r_52dfc56b14b93551": {
      "text": "I have to do something...!",
      "status": "imported"
    },
    "voice_010:r_1b9b2aab5cb104da": {
      "text": "I lost the enemy... What a failure!",
      "status": "imported"
    },
    "voice_010:r_342044c706a2340f": {
      "text": "Are Gnis's weapons useless...?!",
      "status": "imported"
    },
    "voice_010:r_cf41e8828a90cbdb": {
      "text": "Like you'll ever hit me!",
      "status": "imported"
    },
    "voice_010:r_719e897304ec42d4": {
      "text": "Try all you want, same result!",
      "status": "imported"
    },
    "voice_010:r_d5e0a2317c40d322": {
      "text": "Naive to the bitter end!",
      "status": "imported"
    },
    "voice_010:r_ec2ea17765052401": {
      "text": "So this is Vega's true strength...",
      "status": "imported"
    },
    "voice_010:r_f2d4255f1c2f7542": {
      "text": "Hahaha! What are you trying to do?!",
      "status": "imported"
    },
    "voice_010:r_5d08ad19e2da125b": {
      "text": "Too slow! I'm right here!",
      "status": "imported"
    },
    "voice_010:r_a7246b52782a877e": {
      "text": "What's wrong, Angel?! Is that all?!",
      "status": "imported"
    },
    "voice_010:r_dc8701f6bcb9904f": {
      "text": "Who is this?!\\nFar too friendly...!",
      "status": "imported"
    },
    "voice_010:r_d6bdd730f24f66eb": {
      "text": "Why? This vain loop\\nfeels familiar!",
      "status": "imported"
    },
    "voice_010:r_7432ef43ed3471dc": {
      "text": "That won't work!",
      "status": "imported"
    },
    "voice_010:r_065443f6ddfcf0d7": {
      "text": "You're wasting your time!",
      "status": "imported"
    },
    "voice_010:r_47d52a2839c71715": {
      "text": "This is Altair's technology!",
      "status": "imported"
    },
    "voice_010:r_55417493fce1d347": {
      "text": "Ngh...!",
      "status": "imported"
    },
    "voice_010:r_8fdf5910927c9591": {
      "text": "Tch...! You took the bait!",
      "status": "imported"
    },
    "voice_010:r_7d724dbcc4451e10": {
      "text": "So that's all you're capable of...!",
      "status": "imported"
    },
    "voice_010:r_93e25418a203cb8f": {
      "text": "Don't touch me!",
      "status": "imported"
    },
    "voice_010:r_adeb0a29274d3d9b": {
      "text": "What a dull opponent...!",
      "status": "imported"
    },
    "voice_010:r_24cf161287ef9d5c": {
      "text": "You actually caught my Gnis...!",
      "status": "imported"
    },
    "voice_010:r_8f60f6fc86db3107": {
      "text": "Ngh...! So that's how you play it!",
      "status": "imported"
    },
    "voice_010:r_b1de76a75a253c13": {
      "text": "For this planet, I cannot lose...!",
      "status": "imported"
    },
    "voice_010:r_128c35bf3e0e394c": {
      "text": "To think they had such power...!",
      "status": "imported"
    },
    "voice_010:r_5213c17e13b23de0": {
      "text": "How dare a lowly Vega native...!",
      "status": "imported"
    },
    "voice_010:r_38fdff9483e9245c": {
      "text": "What...?! My head... My head hurts!",
      "status": "imported"
    },
    "voice_010:r_620fedec67706d7d": {
      "text": "I know this attack...?",
      "status": "imported"
    },
    "voice_010:r_9680dcd0fddcfcc7": {
      "text": "As expected, Angel! Altair's foe!",
      "status": "imported"
    },
    "voice_010:r_2a00f1044ad5cbaa": {
      "text": "Damn! You're utterly relentless!",
      "status": "imported"
    },
    "voice_010:r_3dbeead1bd3164ef": {
      "text": "You...!\\nWhy go so far for me...?!",
      "status": "imported"
    },
    "voice_010:r_cdbd128a5b4127cc": {
      "text": "Aaaaaaagh...!",
      "status": "imported"
    },
    "voice_010:r_cfccaa1fbeda124c": {
      "text": "Damn! That's no ordinary strength!",
      "status": "imported"
    },
    "voice_010:r_b1f8ec192b9c083a": {
      "text": "I won't lose!\\nI'm Altair's warrior!",
      "status": "imported"
    },
    "voice_010:r_a007f9ab9cf048b3": {
      "text": "No...! My name is MIXY...!",
      "status": "imported"
    },
    "voice_010:r_ddafde4b065ced49": {
      "text": "I'm not MIX...! I'm MIXY!",
      "status": "imported"
    },
    "voice_010:r_de1213040856c089": {
      "text": "Yet Altair's future\\nis at stake...!",
      "status": "imported"
    },
    "voice_010:r_3304412ac41f47a6": {
      "text": "Aah...! Aaaaaaagh...!",
      "status": "imported"
    },
    "voice_010:r_0c0775e051211840": {
      "text": "Izumo! Aaaaaaagh...!",
      "status": "imported"
    },
    "voice_010:r_13c25fbdfddc8a24": {
      "text": "Fill!",
      "status": "imported"
    },
    "voice_010:r_d692f1d420460a47": {
      "text": "Fill! Haaah!",
      "status": "imported"
    }
  }
}
