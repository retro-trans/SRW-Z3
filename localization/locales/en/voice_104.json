{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_104:r_479b340ccc6c572b": {
      "text": "Drop dead!",
      "status": "imported"
    },
    "voice_104:r_ca4acbac57a2a35e": {
      "text": "Bye-bye!",
      "status": "imported"
    },
    "voice_104:r_77949221bf58f862": {
      "text": "Outta my way!",
      "status": "imported"
    },
    "voice_104:r_70b9c4b9f1f37eff": {
      "text": "You're so annoying!",
      "status": "imported"
    },
    "voice_104:r_9fcb3754cb1773c7": {
      "text": "You're an eyesore!",
      "status": "imported"
    },
    "voice_104:r_3559d2fad32c2435": {
      "text": "Quit scurrying around!",
      "status": "imported"
    },
    "voice_104:r_f7570547e9f80a64": {
      "text": "Now, let's put it to the test!",
      "status": "imported"
    },
    "voice_104:r_cbab0f4720e1fcf1": {
      "text": "Watch me, Sis...!",
      "status": "imported"
    },
    "voice_104:r_0bbe0b4f5364e732": {
      "text": "I'm the chosen warrior!",
      "status": "imported"
    },
    "voice_104:r_5dda5198137cb02a": {
      "text": "I'll break so much, kill so much...!",
      "status": "imported"
    },
    "voice_104:r_83ec59afbecdec14": {
      "text": "It's too late to beg for your life!",
      "status": "imported"
    },
    "voice_104:r_e20bfd42ad95a3c9": {
      "text": "I don't care what happens later!",
      "status": "imported"
    },
    "voice_104:r_0f58a8822381e57f": {
      "text": "No one can escape me!",
      "status": "imported"
    },
    "voice_104:r_6dbcc507fb61b51d": {
      "text": "No one can stop me!",
      "status": "imported"
    },
    "voice_104:r_b42ab697149a7c8a": {
      "text": "Everything should just fall apart!",
      "status": "imported"
    },
    "voice_104:r_4de4fcf3b440baf4": {
      "text": "I'll riddle you with holes!",
      "status": "imported"
    },
    "voice_104:r_0121a166c715cdff": {
      "text": "It won't matter where you hide!",
      "status": "imported"
    },
    "voice_104:r_30fad37a42bd3ad3": {
      "text": "This way's a sure thing!",
      "status": "imported"
    },
    "voice_104:r_80a0b2a84e05d81a": {
      "text": "I'll smash you to pieces!",
      "status": "imported"
    },
    "voice_104:r_4a9ac1dff86506d9": {
      "text": "One graze and you're dead!",
      "status": "imported"
    },
    "voice_104:r_bc8538e6af3d2577": {
      "text": "I'll crush you flat!",
      "status": "imported"
    },
    "voice_104:r_924516c8de2b5342": {
      "text": "It's not over yet!",
      "status": "imported"
    },
    "voice_104:r_da1174533722333f": {
      "text": "The nightmare goes on! Forever!",
      "status": "imported"
    },
    "voice_104:r_fdeb8162976e72c1": {
      "text": "Sousuke Sagara... That bastard...!",
      "status": "imported"
    },
    "voice_104:r_0fadb5c26df92b42": {
      "text": "I'll never forgive you!",
      "status": "imported"
    },
    "voice_104:r_6b15af9a0057cdc8": {
      "text": "That machine\\ncan't stop Behemoth!",
      "status": "imported"
    },
    "voice_104:r_15b4a90140e8a33a": {
      "text": "A company robot from Odaiba!",
      "status": "imported"
    },
    "voice_104:r_af884a6b11dff121": {
      "text": "Stay back, you carefree salaryman!",
      "status": "imported"
    },
    "voice_104:r_ac6fe7838e95647b": {
      "text": "Good always wins? It's just a myth!",
      "status": "imported"
    },
    "voice_104:r_77ca87eacd17ad52": {
      "text": "Let's see whose toy is stronger!",
      "status": "imported"
    },
    "voice_104:r_bf3244994760e535": {
      "text": "In a piece of trash like that...!",
      "status": "imported"
    },
    "voice_104:r_aabfb21c9d069ce7": {
      "text": "Buzzing around just like a fly",
      "status": "imported"
    },
    "voice_104:r_02479dc8fe989560": {
      "text": "So what if it's a Gundam!",
      "status": "imported"
    },
    "voice_104:r_a2df00f91a9b0a9e": {
      "text": "Black Knights, Federation lackeys!",
      "status": "imported"
    },
    "voice_104:r_48b60d6c48b9b142": {
      "text": "I hate loudmouthed women!",
      "status": "imported"
    },
    "voice_104:r_8927e6fb681aa809": {
      "text": "You tried changing the world too...!",
      "status": "imported"
    },
    "voice_104:r_665f01666859013b": {
      "text": "How are you any different from me?!",
      "status": "imported"
    },
    "voice_104:r_13c25fbdfddc8a24": {
      "text": "You'll regret picking this fight!",
      "status": "imported"
    },
    "voice_104:r_42ba1ecb310b4bd7": {
      "text": "You came here asking to die!",
      "status": "imported"
    },
    "voice_104:r_d692f1d420460a47": {
      "text": "That's what you get for facing me!",
      "status": "imported"
    },
    "voice_104:r_a5643cec86b18bd2": {
      "text": "Now then, it's my turn!",
      "status": "imported"
    },
    "voice_104:r_68f2dfab20a4a30e": {
      "text": "It's too late to run now!",
      "status": "imported"
    },
    "voice_104:r_9cedad8237480563": {
      "text": "You can't escape Behemoth!",
      "status": "imported"
    },
    "voice_104:r_a03fabecba1508ca": {
      "text": "So you resort to dirty tricks.",
      "status": "imported"
    },
    "voice_104:r_5391b24a71eb10ae": {
      "text": "You dare toy with my feelings...!",
      "status": "imported"
    },
    "voice_104:r_a554ceef5c87b972": {
      "text": "All this does is buy you time...!",
      "status": "imported"
    },
    "voice_104:r_546c3d5937fbb7ee": {
      "text": "You coward...!\\nScared of Behemoth?!",
      "status": "imported"
    },
    "voice_104:r_1568ff6298b12b96": {
      "text": "I don't have time to play with you.",
      "status": "imported"
    },
    "voice_104:r_2c9d94ba13c5fc50": {
      "text": "A pointless ego trip,\\nthat's all.",
      "status": "imported"
    },
    "voice_104:r_a77f4913375098d2": {
      "text": "And I'm such a huge target, too.",
      "status": "imported"
    },
    "voice_104:r_428c2116ac3071b1": {
      "text": "Huh? Weren't you going to stop me?",
      "status": "imported"
    },
    "voice_104:r_84c116267b79f540": {
      "text": "Too bad, you missed.",
      "status": "imported"
    },
    "voice_104:r_dad38ee29af2df3a": {
      "text": "All that desperation is hilarious!",
      "status": "imported"
    },
    "voice_104:r_3d32e86f8dc80909": {
      "text": "All that big talk, and that's it?!",
      "status": "imported"
    },
    "voice_104:r_70451ffbabe2f876": {
      "text": "Ha ha ha ha! A helpless knight!",
      "status": "imported"
    },
    "voice_104:r_69dfa1659715e2fa": {
      "text": "Even a cutting-edge AS can't win!",
      "status": "imported"
    },
    "voice_104:r_ca85f87cee5e31f7": {
      "text": "Bring it on!",
      "status": "imported"
    },
    "voice_104:r_9072ea7bc71df136": {
      "text": "I need to focus...!",
      "status": "imported"
    },
    "voice_104:r_04e815a8d425827d": {
      "text": "You pushed Behemoth this far?!",
      "status": "imported"
    },
    "voice_104:r_d89011fe3e5d082a": {
      "text": "And I've got nothing left now...!",
      "status": "imported"
    },
    "voice_104:r_3c5b0c2ac812d5de": {
      "text": "Me, the chosen warrior?!",
      "status": "imported"
    },
    "voice_104:r_5b9e8897190892eb": {
      "text": "Ugh... I feel sick...!",
      "status": "imported"
    },
    "voice_104:r_7bea3023abbf8a94": {
      "text": "I told you, I'm invincible!",
      "status": "imported"
    },
    "voice_104:r_dd01a4c0d1b36a8d": {
      "text": "Like a mosquito bite, I'd say.",
      "status": "imported"
    },
    "voice_104:r_20920ad2eb3542db": {
      "text": "Ha ha ha! I almost pity you.",
      "status": "imported"
    },
    "voice_104:r_0ab7914877fd48ed": {
      "text": "Hmm, so that's the best you can do.",
      "status": "imported"
    },
    "voice_104:r_cb846feec748c2e3": {
      "text": "My toy's the best!",
      "status": "imported"
    },
    "voice_104:r_c958860b0676b1f5": {
      "text": "That won't work! Fwa ha ha ha ha!",
      "status": "imported"
    },
    "voice_104:r_5e2669b82ef75ce3": {
      "text": "Sousuke Sagara...! How dare you!",
      "status": "imported"
    },
    "voice_104:r_7847e0ed7dc9282d": {
      "text": "You!\\nHow long will you annoy me?!",
      "status": "imported"
    },
    "voice_104:r_e42b52c7a987b906": {
      "text": "What an annoying small-fry AS!",
      "status": "imported"
    },
    "voice_104:r_6825fd1ff907bd22": {
      "text": "I won't lose to some salaryman!",
      "status": "imported"
    },
    "voice_104:r_607f666f1563bc0d": {
      "text": "I...! I'll make Odaiba an inferno!",
      "status": "imported"
    },
    "voice_104:r_97b7431eeb81e6b6": {
      "text": "Damn her!\\nHow much more meddling?!",
      "status": "imported"
    },
    "voice_104:r_b84afafb8a33ec60": {
      "text": "It hurts...! It hurts, Sis...!",
      "status": "imported"
    },
    "voice_104:r_c8c59db85bf875e6": {
      "text": "No...! No, I don't want this, Sis!",
      "status": "imported"
    },
    "voice_104:r_391aa56435d9dd6e": {
      "text": "Don't leave me all alone, Sis!",
      "status": "imported"
    },
    "voice_104:r_7c796ba53bd7ea03": {
      "text": "M-my Behemoth...! How dare you!",
      "status": "imported"
    },
    "voice_104:r_fa944da4b6519006": {
      "text": "Haa... Haa... Haa...! Ngh...!",
      "status": "imported"
    },
    "voice_104:r_95d047bcc17fccc6": {
      "text": "What?\\nI should be invincible!?",
      "status": "imported"
    },
    "voice_104:r_640327a12a559b31": {
      "text": "Can't focus... My image is warping!",
      "status": "imported"
    },
    "voice_104:r_bdd38c584fa313d0": {
      "text": "What's wrong, Behemoth?! Move!",
      "status": "imported"
    },
    "voice_104:r_3fd86c1027f317c8": {
      "text": "M-my...! My Behemoth...!",
      "status": "imported"
    },
    "voice_104:r_d0372a183d2007ad": {
      "text": "I'm sorry, Sis... I...",
      "status": "imported"
    },
    "voice_104:r_381992c5d8224937": {
      "text": "Better to be certain!",
      "status": "imported"
    },
    "voice_104:r_f1e7ed9e5874aba5": {
      "text": "Move aside! I'll do it!",
      "status": "imported"
    },
    "voice_104:r_fc25e66a86fc2c85": {
      "text": "I'll handle this!",
      "status": "imported"
    },
    "voice_104:r_5aeeb4917340c42d": {
      "text": "Behemoth can handle this much!",
      "status": "imported"
    },
    "voice_104:r_b765659981b6516d": {
      "text": "Ha ha ha ha ha! It's useless!",
      "status": "imported"
    },
    "voice_104:r_0c427458bc00eb95": {
      "text": "A shield... Yes, a shield.",
      "status": "imported"
    },
    "voice_104:r_774a9ab4d8fd5351": {
      "text": "A shield none can pierce...\\nImagine!",
      "status": "imported"
    }
  }
}
