{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_162:r_479b340ccc6c572b": {
      "text": "Out of my way.",
      "status": "imported"
    },
    "voice_162:r_77949221bf58f862": {
      "text": "You're an eyesore.",
      "status": "imported"
    },
    "voice_162:r_70b9c4b9f1f37eff": {
      "text": "Die.",
      "status": "imported"
    },
    "voice_162:r_9fcb3754cb1773c7": {
      "text": "Disappear.",
      "status": "imported"
    },
    "voice_162:r_3559d2fad32c2435": {
      "text": "Move.",
      "status": "imported"
    },
    "voice_162:r_f7570547e9f80a64": {
      "text": "Here I come.",
      "status": "imported"
    },
    "voice_162:r_cbab0f4720e1fcf1": {
      "text": "This too is for Sensei.",
      "status": "imported"
    },
    "voice_162:r_0bbe0b4f5364e732": {
      "text": "It's time to begin.",
      "status": "imported"
    },
    "voice_162:r_5dda5198137cb02a": {
      "text": "It's time to say goodbye.",
      "status": "imported"
    },
    "voice_162:r_83ec59afbecdec14": {
      "text": "I'll do as I please.",
      "status": "imported"
    },
    "voice_162:r_e20bfd42ad95a3c9": {
      "text": "Don't waste my time.",
      "status": "imported"
    },
    "voice_162:r_0f58a8822381e57f": {
      "text": "I'll eliminate all obstacles.",
      "status": "imported"
    },
    "voice_162:r_6dbcc507fb61b51d": {
      "text": "At long range, I'll use this.",
      "status": "imported"
    },
    "voice_162:r_b42ab697149a7c8a": {
      "text": "I won't miss.",
      "status": "imported"
    },
    "voice_162:r_4de4fcf3b440baf4": {
      "text": "Target acquired.",
      "status": "imported"
    },
    "voice_162:r_0121a166c715cdff": {
      "text": "Perfect range.",
      "status": "imported"
    },
    "voice_162:r_30fad37a42bd3ad3": {
      "text": "Not yet.",
      "status": "imported"
    },
    "voice_162:r_80a0b2a84e05d81a": {
      "text": "I'll hit you head-on.",
      "status": "imported"
    },
    "voice_162:r_4a9ac1dff86506d9": {
      "text": "The finishing blow.",
      "status": "imported"
    },
    "voice_162:r_bc8538e6af3d2577": {
      "text": "I'll take the surest option.",
      "status": "imported"
    },
    "voice_162:r_924516c8de2b5342": {
      "text": "Looks like it's over.",
      "status": "imported"
    },
    "voice_162:r_da1174533722333f": {
      "text": "No time to look away.",
      "status": "imported"
    },
    "voice_162:r_fdeb8162976e72c1": {
      "text": "Launching another attack.",
      "status": "imported"
    },
    "voice_162:r_0fadb5c26df92b42": {
      "text": "So that's Sousuke Sagara.",
      "status": "imported"
    },
    "voice_162:r_6b15af9a0057cdc8": {
      "text": "You seem fairly capable, but...",
      "status": "imported"
    },
    "voice_162:r_15b4a90140e8a33a": {
      "text": "Against a sniper, I'll close in.",
      "status": "imported"
    },
    "voice_162:r_af884a6b11dff121": {
      "text": "You're unlike the others...!",
      "status": "imported"
    },
    "voice_162:r_ac6fe7838e95647b": {
      "text": "Mithril, is it?",
      "status": "imported"
    },
    "voice_162:r_adeb0a29274d3d9b": {
      "text": "I'll counterattack.",
      "status": "imported"
    },
    "voice_162:r_24cf161287ef9d5c": {
      "text": "You started this.",
      "status": "imported"
    },
    "voice_162:r_8f60f6fc86db3107": {
      "text": "You won't escape.",
      "status": "imported"
    },
    "voice_162:r_b1de76a75a253c13": {
      "text": "I'll turn the tide.",
      "status": "imported"
    },
    "voice_162:r_128c35bf3e0e394c": {
      "text": "I won't just let you leave.",
      "status": "imported"
    },
    "voice_162:r_5213c17e13b23de0": {
      "text": "I won't let you withdraw.",
      "status": "imported"
    },
    "voice_162:r_38fdff9483e9245c": {
      "text": "I'll follow up with an attack.",
      "status": "imported"
    },
    "voice_162:r_620fedec67706d7d": {
      "text": "We'll attack in tandem.",
      "status": "imported"
    },
    "voice_162:r_9680dcd0fddcfcc7": {
      "text": "Sensei, leave the rest to me.",
      "status": "imported"
    },
    "voice_162:r_2a00f1044ad5cbaa": {
      "text": "Yu Lan, leave the rest to me.",
      "status": "imported"
    },
    "voice_162:r_3dbeead1bd3164ef": {
      "text": "Fall back, quickly.",
      "status": "imported"
    },
    "voice_162:r_98d15b8cc09bc915": {
      "text": "I'll handle this.",
      "status": "imported"
    },
    "voice_162:r_46e86d000250e137": {
      "text": "I'll handle it, Sensei.",
      "status": "imported"
    },
    "voice_162:r_ac341e7976e88f0b": {
      "text": "It's part of the job...",
      "status": "imported"
    },
    "voice_162:r_cdbd128a5b4127cc": {
      "text": "I won't let you hurt Yu Lan...",
      "status": "imported"
    },
    "voice_162:r_cfccaa1fbeda124c": {
      "text": "I see... So that's how it is.",
      "status": "imported"
    },
    "voice_162:r_b1f8ec192b9c083a": {
      "text": "I'm accustomed to enduring.",
      "status": "imported"
    },
    "voice_162:r_a007f9ab9cf048b3": {
      "text": "I'll let you go for now.",
      "status": "imported"
    },
    "voice_162:r_ddafde4b065ced49": {
      "text": "No damage.",
      "status": "imported"
    },
    "voice_162:r_de1213040856c089": {
      "text": "Evasion successful.",
      "status": "imported"
    },
    "voice_162:r_3304412ac41f47a6": {
      "text": "Don't make me laugh.",
      "status": "imported"
    },
    "voice_162:r_0c0775e051211840": {
      "text": "That didn't even register.",
      "status": "imported"
    },
    "voice_162:r_a2afffe1c396f0b3": {
      "text": "What a dull attack.",
      "status": "imported"
    },
    "voice_162:r_13c25fbdfddc8a24": {
      "text": "No problem if I follow Sensei.",
      "status": "imported"
    },
    "voice_162:r_42ba1ecb310b4bd7": {
      "text": "Why does Sensei care about him...?",
      "status": "imported"
    },
    "voice_162:r_d692f1d420460a47": {
      "text": "Mithril... You're nothing special.",
      "status": "imported"
    },
    "voice_162:r_9cedad8237480563": {
      "text": "Futile.",
      "status": "imported"
    },
    "voice_162:r_a03fabecba1508ca": {
      "text": "It won't work.",
      "status": "imported"
    },
    "voice_162:r_546c3d5937fbb7ee": {
      "text": "I have equipment like this too.",
      "status": "imported"
    },
    "voice_162:r_1568ff6298b12b96": {
      "text": "All I need is the Lambda Driver.",
      "status": "imported"
    },
    "voice_162:r_2c9d94ba13c5fc50": {
      "text": "It grazed me...",
      "status": "imported"
    },
    "voice_162:r_a77f4913375098d2": {
      "text": "I mishandled the controls.",
      "status": "imported"
    },
    "voice_162:r_428c2116ac3071b1": {
      "text": "Your aim is good, but...",
      "status": "imported"
    },
    "voice_162:r_84c116267b79f540": {
      "text": "I thought I'd dodged that...",
      "status": "imported"
    },
    "voice_162:r_dad38ee29af2df3a": {
      "text": "You lack a decisive edge.",
      "status": "imported"
    },
    "voice_162:r_3d32e86f8dc80909": {
      "text": "That won't defeat me.",
      "status": "imported"
    },
    "voice_162:r_70451ffbabe2f876": {
      "text": "Ugh...!",
      "status": "imported"
    },
    "voice_162:r_69dfa1659715e2fa": {
      "text": "This is nothing.",
      "status": "imported"
    },
    "voice_162:r_d996fd6d4ef5b329": {
      "text": "I can still fight.",
      "status": "imported"
    },
    "voice_162:r_8ab47a28f99ef565": {
      "text": "Looks like you failed to finish me.",
      "status": "imported"
    },
    "voice_162:r_546de3fb6db156ea": {
      "text": "I was prepared for this much.",
      "status": "imported"
    },
    "voice_162:r_ca85f87cee5e31f7": {
      "text": "If my weapons still work, I'm fine.",
      "status": "imported"
    },
    "voice_162:r_9072ea7bc71df136": {
      "text": "Sousuke Sagara... Far tougher.",
      "status": "imported"
    },
    "voice_162:r_04e815a8d425827d": {
      "text": "As expected of Mithril.",
      "status": "imported"
    },
    "voice_162:r_5b9e8897190892eb": {
      "text": "Ngh...!",
      "status": "imported"
    },
    "voice_162:r_7bea3023abbf8a94": {
      "text": "They're stronger than I am.",
      "status": "imported"
    },
    "voice_162:r_dd01a4c0d1b36a8d": {
      "text": "My tactics aren't working.",
      "status": "imported"
    },
    "voice_162:r_20920ad2eb3542db": {
      "text": "For Sensei, I can't fall yet...!",
      "status": "imported"
    },
    "voice_162:r_0ab7914877fd48ed": {
      "text": "I can't be defeated here...!",
      "status": "imported"
    },
    "voice_162:r_cb846feec748c2e3": {
      "text": "Our fight isn't over yet...!",
      "status": "imported"
    },
    "voice_162:r_c958860b0676b1f5": {
      "text": "Mission failed...",
      "status": "imported"
    },
    "voice_162:r_5e2669b82ef75ce3": {
      "text": "Sensei, I'm sorry...",
      "status": "imported"
    },
    "voice_162:r_7847e0ed7dc9282d": {
      "text": "Yu Lan...",
      "status": "imported"
    },
    "voice_162:r_e42b52c7a987b906": {
      "text": "I'll hold them back.",
      "status": "imported"
    },
    "voice_162:r_6825fd1ff907bd22": {
      "text": "I'll keep them in check.",
      "status": "imported"
    },
    "voice_162:r_607f666f1563bc0d": {
      "text": "Attack target confirmed.",
      "status": "imported"
    },
    "voice_162:r_97b7431eeb81e6b6": {
      "text": "I'll destroy them one by one.",
      "status": "imported"
    },
    "voice_162:r_132f605d02975e71": {
      "text": "Lambda Driver, activate.",
      "status": "imported"
    },
    "voice_162:r_1252db29683fefe0": {
      "text": "I'll use the Lambda Driver.",
      "status": "imported"
    }
  }
}
