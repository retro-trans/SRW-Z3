{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_159:r_479b340ccc6c572b": {
      "text": "I'll do it too!",
      "status": "imported"
    },
    "voice_159:r_ca4acbac57a2a35e": {
      "text": "I'll do what I can...!",
      "status": "imported"
    },
    "voice_159:r_77949221bf58f862": {
      "text": "I'm an Element too...!",
      "status": "imported"
    },
    "voice_159:r_70b9c4b9f1f37eff": {
      "text": "Before I give up, I'll try...!",
      "status": "imported"
    },
    "voice_159:r_9fcb3754cb1773c7": {
      "text": "Amata and everyone are fighting!",
      "status": "imported"
    },
    "voice_159:r_3559d2fad32c2435": {
      "text": "I won't lose, not even in spirit!",
      "status": "imported"
    },
    "voice_159:r_f7570547e9f80a64": {
      "text": "No more...\\nI won't say I can't!",
      "status": "imported"
    },
    "voice_159:r_cbab0f4720e1fcf1": {
      "text": "I'll unite everyone's hearts!",
      "status": "imported"
    },
    "voice_159:r_0bbe0b4f5364e732": {
      "text": "I feel it...! Everyone's hopes!",
      "status": "imported"
    },
    "voice_159:r_5dda5198137cb02a": {
      "text": "Amata, can I borrow your strength?",
      "status": "imported"
    },
    "voice_159:r_83ec59afbecdec14": {
      "text": "Of course, Mikono!",
      "status": "imported"
    },
    "voice_159:r_e20bfd42ad95a3c9": {
      "text": "Let's go, Mikono!",
      "status": "imported"
    },
    "voice_159:r_0f58a8822381e57f": {
      "text": "Yes! I'll fight alongside everyone!",
      "status": "imported"
    },
    "voice_159:r_6dbcc507fb61b51d": {
      "text": "Mikono! We'll always be together!",
      "status": "imported"
    },
    "voice_159:r_b42ab697149a7c8a": {
      "text": "Amata, with you here, I'm fearless!",
      "status": "imported"
    },
    "voice_159:r_4de4fcf3b440baf4": {
      "text": "Mikono! Don't hold back!",
      "status": "imported"
    },
    "voice_159:r_0121a166c715cdff": {
      "text": "Yes! I'll give it everything!",
      "status": "imported"
    },
    "voice_159:r_30fad37a42bd3ad3": {
      "text": "All our feelings...!",
      "status": "imported"
    },
    "voice_159:r_80a0b2a84e05d81a": {
      "text": "We'll unite them!",
      "status": "imported"
    },
    "voice_159:r_4a9ac1dff86506d9": {
      "text": "I'll fight alongside everyone too!",
      "status": "imported"
    },
    "voice_159:r_bc8538e6af3d2577": {
      "text": "A lovely sound. I feel its melody.",
      "status": "imported"
    },
    "voice_159:r_924516c8de2b5342": {
      "text": "MIX! Lend me your strength!",
      "status": "imported"
    },
    "voice_159:r_da1174533722333f": {
      "text": "Women get more fired up together!",
      "status": "imported"
    },
    "voice_159:r_fdeb8162976e72c1": {
      "text": "Yunoha! Let's fight together!",
      "status": "imported"
    },
    "voice_159:r_0fadb5c26df92b42": {
      "text": "Yes!\\nI'll do my best with Mikono!",
      "status": "imported"
    },
    "voice_159:r_6b15af9a0057cdc8": {
      "text": "Sazanka!\\nLet's unite our strength!",
      "status": "imported"
    },
    "voice_159:r_15b4a90140e8a33a": {
      "text": "Ah!\\nI might join the love triangle!",
      "status": "imported"
    },
    "voice_159:r_af884a6b11dff121": {
      "text": "Director Crea, I'm counting on you!",
      "status": "imported"
    },
    "voice_159:r_ac6fe7838e95647b": {
      "text": "You grew strong, Mikono Suzushiro.",
      "status": "imported"
    },
    "voice_159:r_77ca87eacd17ad52": {
      "text": "Amata! Lend me your strength!",
      "status": "imported"
    },
    "voice_159:r_bf3244994760e535": {
      "text": "Mikono! Use my strength!",
      "status": "imported"
    },
    "voice_159:r_aabfb21c9d069ce7": {
      "text": "Aw... No room for me whatsoever...",
      "status": "imported"
    },
    "voice_159:r_02479dc8fe989560": {
      "text": "If I can attack one more time...!",
      "status": "imported"
    },
    "voice_159:r_a2df00f91a9b0a9e": {
      "text": "I'm going in one more time!",
      "status": "imported"
    },
    "voice_159:r_48b60d6c48b9b142": {
      "text": "I don't want to face you... Yet...!",
      "status": "imported"
    },
    "voice_159:r_8927e6fb681aa809": {
      "text": "Facing you,\\nI don't know myself...",
      "status": "imported"
    },
    "voice_159:r_665f01666859013b": {
      "text": "If you attack us,\\nI'll fight you!",
      "status": "imported"
    },
    "voice_159:r_a571eec59b258d11": {
      "text": "Why do the Abductors target women?",
      "status": "imported"
    },
    "voice_159:r_ddbe581c5ea9183d": {
      "text": "That's Altair's supreme leader...!",
      "status": "imported"
    },
    "voice_159:r_faae935cca0edc72": {
      "text": "I'll free you from your sorrow...!",
      "status": "imported"
    },
    "voice_159:r_d4430bf362340b32": {
      "text": "I'll face my sins,\\nand stop you!",
      "status": "imported"
    },
    "voice_159:r_6ff1323b355593e0": {
      "text": "Stop, MIX!\\nDon't you recognize us!?",
      "status": "imported"
    },
    "voice_159:r_b7b5625d7cd4282f": {
      "text": "I'll stop the unit and save MIX...!",
      "status": "imported"
    },
    "voice_159:r_36133ad73a73ef98": {
      "text": "We're both Gepards.\\nI won't lose!",
      "status": "imported"
    },
    "voice_159:r_920740a0219c5085": {
      "text": "Same range...\\nI must be careful!",
      "status": "imported"
    },
    "voice_159:r_a8451712c57c1a72": {
      "text": "So fast...! That's Spada for you!",
      "status": "imported"
    },
    "voice_159:r_3633df5b7b8f47fa": {
      "text": "I can't win in close combat...!",
      "status": "imported"
    },
    "voice_159:r_52dfc56b14b93551": {
      "text": "It's small and hard to target...!",
      "status": "imported"
    },
    "voice_159:r_1b9b2aab5cb104da": {
      "text": "A Gundam...! I have to be careful!",
      "status": "imported"
    },
    "voice_159:r_342044c706a2340f": {
      "text": "I'll stop your machine...!",
      "status": "imported"
    },
    "voice_159:r_cf41e8828a90cbdb": {
      "text": "Just a machine.\\nNo holding back...!",
      "status": "imported"
    },
    "voice_159:r_719e897304ec42d4": {
      "text": "Even against a monster...!",
      "status": "imported"
    },
    "voice_159:r_d5e0a2317c40d322": {
      "text": "What in the world is that!?",
      "status": "imported"
    },
    "voice_159:r_ec2ea17765052401": {
      "text": "Space Monster... Mankind's nemesis!",
      "status": "imported"
    },
    "voice_159:r_f2d4255f1c2f7542": {
      "text": "I'm sorry! I'll stop that machine!",
      "status": "imported"
    },
    "voice_159:r_5d08ad19e2da125b": {
      "text": "I'll stop the machine and save you!",
      "status": "imported"
    },
    "voice_159:r_a7246b52782a877e": {
      "text": "Your ambition brings no one joy!",
      "status": "imported"
    },
    "voice_159:r_dc8701f6bcb9904f": {
      "text": "You'll drown\\nthe world in sorrow!",
      "status": "imported"
    },
    "voice_159:r_7432ef43ed3471dc": {
      "text": "We won't fall for your schemes...!",
      "status": "imported"
    },
    "voice_159:r_065443f6ddfcf0d7": {
      "text": "I won't forgive such dirty tactics!",
      "status": "imported"
    },
    "voice_159:r_47d52a2839c71715": {
      "text": "Mikono, they're coming!",
      "status": "imported"
    },
    "voice_159:r_847f82e7f3eef651": {
      "text": "They're our enemy... But...",
      "status": "imported"
    },
    "voice_159:r_eb7ae28b53dc033c": {
      "text": "Mikono! They're the enemy!\\nFight!",
      "status": "imported"
    },
    "voice_159:r_857c4a52ce8df0fd": {
      "text": "I... I...! I'm sorry!",
      "status": "imported"
    },
    "voice_159:r_55417493fce1d347": {
      "text": "Amata's feelings surround me...",
      "status": "imported"
    },
    "voice_159:r_8fdf5910927c9591": {
      "text": "Let's go, Mikono!\\nWe'll end this!",
      "status": "imported"
    },
    "voice_159:r_7d724dbcc4451e10": {
      "text": "My...\\nTake our hearts and power!",
      "status": "imported"
    },
    "voice_159:r_93e25418a203cb8f": {
      "text": "No doubts!\\nI fight for this world!",
      "status": "imported"
    },
    "voice_159:r_adeb0a29274d3d9b": {
      "text": "Please! Hit!",
      "status": "imported"
    },
    "voice_159:r_24cf161287ef9d5c": {
      "text": "I have to fire somehow...!",
      "status": "imported"
    },
    "voice_159:r_8f60f6fc86db3107": {
      "text": "Target locked! Firing!",
      "status": "imported"
    },
    "voice_159:r_b1de76a75a253c13": {
      "text": "Missile set! Launch!",
      "status": "imported"
    },
    "voice_159:r_128c35bf3e0e394c": {
      "text": "My Missile won't let you escape!",
      "status": "imported"
    },
    "voice_159:r_5213c17e13b23de0": {
      "text": "At least one Missile should hit...!",
      "status": "imported"
    },
    "voice_159:r_38fdff9483e9245c": {
      "text": "This should do it...!",
      "status": "imported"
    },
    "voice_159:r_620fedec67706d7d": {
      "text": "Missile, full barrage!",
      "status": "imported"
    },
    "voice_159:r_9680dcd0fddcfcc7": {
      "text": "This is goodbye!",
      "status": "imported"
    },
    "voice_159:r_2a00f1044ad5cbaa": {
      "text": "Bye-bye Missile!",
      "status": "imported"
    },
    "voice_159:r_3dbeead1bd3164ef": {
      "text": "Double! Then double again!",
      "status": "imported"
    },
    "voice_159:r_98d15b8cc09bc915": {
      "text": "Take this! Bye-bye Missile!",
      "status": "imported"
    },
    "voice_159:r_46e86d000250e137": {
      "text": "Gepard, returning fire!",
      "status": "imported"
    },
    "voice_159:r_ac341e7976e88f0b": {
      "text": "I have to counter, quick...!",
      "status": "imported"
    },
    "voice_159:r_cdbd128a5b4127cc": {
      "text": "I'll shoot back too!",
      "status": "imported"
    },
    "voice_159:r_cfccaa1fbeda124c": {
      "text": "Now it's my turn to attack!",
      "status": "imported"
    },
    "voice_159:r_b1f8ec192b9c083a": {
      "text": "If that's how you want it...!",
      "status": "imported"
    },
    "voice_159:r_a007f9ab9cf048b3": {
      "text": "I can't let myself flinch!",
      "status": "imported"
    },
    "voice_159:r_ddafde4b065ced49": {
      "text": "I'll provide support from here!",
      "status": "imported"
    },
    "voice_159:r_de1213040856c089": {
      "text": "Leave the rest to me!",
      "status": "imported"
    },
    "voice_159:r_3304412ac41f47a6": {
      "text": "I'll protect you!",
      "status": "imported"
    },
    "voice_159:r_0c0775e051211840": {
      "text": "I'll take the hit!",
      "status": "imported"
    },
    "voice_159:r_a2afffe1c396f0b3": {
      "text": "Fall back behind Gepard!",
      "status": "imported"
    },
    "voice_159:r_13c25fbdfddc8a24": {
      "text": "N-no! I can't counterattack!",
      "status": "imported"
    },
    "voice_159:r_42ba1ecb310b4bd7": {
      "text": "No...!\\nI'll be a sitting duck!",
      "status": "imported"
    },
    "voice_159:r_d692f1d420460a47": {
      "text": "No! I pushed the machine too hard!",
      "status": "imported"
    },
    "voice_159:r_a5643cec86b18bd2": {
      "text": "I can't counter from here...!",
      "status": "imported"
    },
    "voice_159:r_68f2dfab20a4a30e": {
      "text": "It's outside my range...!",
      "status": "imported"
    },
    "voice_159:r_9cedad8237480563": {
      "text": "Ah, that was close...",
      "status": "imported"
    },
    "voice_159:r_a03fabecba1508ca": {
      "text": "They dodged it...!",
      "status": "imported"
    },
    "voice_159:r_5391b24a71eb10ae": {
      "text": "I-I missed...!",
      "status": "imported"
    },
    "voice_159:r_a554ceef5c87b972": {
      "text": "I can do this too...!",
      "status": "imported"
    },
    "voice_159:r_546c3d5937fbb7ee": {
      "text": "Stay calm and watch their moves...!",
      "status": "imported"
    },
    "voice_159:r_1568ff6298b12b96": {
      "text": "Like I trained, I can fight...!",
      "status": "imported"
    },
    "voice_159:r_2c9d94ba13c5fc50": {
      "text": "I'm scared... They're terrifying...",
      "status": "imported"
    },
    "voice_159:r_a77f4913375098d2": {
      "text": "Please! Don't come any closer!",
      "status": "imported"
    },
    "voice_159:r_428c2116ac3071b1": {
      "text": "I somehow managed to dodge...",
      "status": "imported"
    },
    "voice_159:r_84c116267b79f540": {
      "text": "Nice one, Mikono!",
      "status": "imported"
    },
    "voice_159:r_dad38ee29af2df3a": {
      "text": "That's the way, Mikono!",
      "status": "imported"
    },
    "voice_159:r_3d32e86f8dc80909": {
      "text": "Thanks, Amata!",
      "status": "imported"
    },
    "voice_159:r_70451ffbabe2f876": {
      "text": "Not bad, Mikono!",
      "status": "imported"
    },
    "voice_159:r_69dfa1659715e2fa": {
      "text": "It's all thanks to everyone.",
      "status": "imported"
    },
    "voice_159:r_d996fd6d4ef5b329": {
      "text": "Largo to Allegro... Nice moves.",
      "status": "imported"
    },
    "voice_159:r_8ab47a28f99ef565": {
      "text": "Oh, thank you very much.",
      "status": "imported"
    },
    "voice_159:r_546de3fb6db156ea": {
      "text": "An attack like that won't...!",
      "status": "imported"
    },
    "voice_159:r_ca85f87cee5e31f7": {
      "text": "Mikono! Your training paid off!",
      "status": "imported"
    },
    "voice_159:r_9072ea7bc71df136": {
      "text": "Mikono, that was amazing!",
      "status": "imported"
    },
    "voice_159:r_04e815a8d425827d": {
      "text": "No,\\nIt's because Yunoha helped me.",
      "status": "imported"
    },
    "voice_159:r_d89011fe3e5d082a": {
      "text": "Wow, Mikono! You've improved!?",
      "status": "imported"
    },
    "voice_159:r_3c5b0c2ac812d5de": {
      "text": "I've been training every day.",
      "status": "imported"
    },
    "voice_159:r_5b9e8897190892eb": {
      "text": "I have to protect everyone...!",
      "status": "imported"
    },
    "voice_159:r_7bea3023abbf8a94": {
      "text": "Good resolve, Mikono Suzushiro.",
      "status": "imported"
    },
    "voice_159:r_0ab7914877fd48ed": {
      "text": "Oh, there was a barrier...",
      "status": "imported"
    },
    "voice_159:r_cb846feec748c2e3": {
      "text": "We've got a barrier!",
      "status": "imported"
    },
    "voice_159:r_5e2669b82ef75ce3": {
      "text": "Eek! They hit me!",
      "status": "imported"
    },
    "voice_159:r_7847e0ed7dc9282d": {
      "text": "I thought I'd dodged that...!",
      "status": "imported"
    },
    "voice_159:r_e42b52c7a987b906": {
      "text": "I have to move faster...!",
      "status": "imported"
    },
    "voice_159:r_6825fd1ff907bd22": {
      "text": "This... doesn't hurt...!",
      "status": "imported"
    },
    "voice_159:r_607f666f1563bc0d": {
      "text": "I'm not afraid of this damage...!",
      "status": "imported"
    },
    "voice_159:r_97b7431eeb81e6b6": {
      "text": "Aquarion and I are both fine...!",
      "status": "imported"
    },
    "voice_159:r_132f605d02975e71": {
      "text": "If that's all the damage...!",
      "status": "imported"
    },
    "voice_159:r_9b9726b1872759d6": {
      "text": "That's the spirit, Mikono!",
      "status": "imported"
    },
    "voice_159:r_1252db29683fefe0": {
      "text": "Calm down, Mikono!",
      "status": "imported"
    },
    "voice_159:r_ad3d538f1e909184": {
      "text": "I know! I'll dodge the next one!",
      "status": "imported"
    },
    "voice_159:r_8c61c59a1c0aebbf": {
      "text": "Mikono! You hit them!",
      "status": "imported"
    },
    "voice_159:r_aba6a7662129d8ce": {
      "text": "Sorry! I'll dodge it next time!",
      "status": "imported"
    },
    "voice_159:r_b84afafb8a33ec60": {
      "text": "They're reading our moves!?",
      "status": "imported"
    },
    "voice_159:r_c8c59db85bf875e6": {
      "text": "Tempo giusto.\\nKeep the right tempo.",
      "status": "imported"
    },
    "voice_159:r_391aa56435d9dd6e": {
      "text": "MIX, are you all right!?",
      "status": "imported"
    },
    "voice_159:r_7c796ba53bd7ea03": {
      "text": "Don't worry about me!",
      "status": "imported"
    },
    "voice_159:r_fa944da4b6519006": {
      "text": "Mikono, are you okay!?",
      "status": "imported"
    },
    "voice_159:r_95d047bcc17fccc6": {
      "text": "I'm fine!\\nYunoha fights hard too!",
      "status": "imported"
    },
    "voice_159:r_640327a12a559b31": {
      "text": "I-I'm hit! It got me dead-on!",
      "status": "imported"
    },
    "voice_159:r_bdd38c584fa313d0": {
      "text": "I'm fine, Sazanka!\\nJust a graze!",
      "status": "imported"
    },
    "voice_159:r_3fd86c1027f317c8": {
      "text": "Aquarion can still fight like this!",
      "status": "imported"
    },
    "voice_159:r_d0372a183d2007ad": {
      "text": "Correct, Mikono Suzushiro.",
      "status": "imported"
    },
    "voice_159:r_217aa5e1d545b44d": {
      "text": "Aah! At this rate...!",
      "status": "imported"
    },
    "voice_159:r_381992c5d8224937": {
      "text": "No...! I can't dodge!",
      "status": "imported"
    },
    "voice_159:r_f1e7ed9e5874aba5": {
      "text": "They're driving us into a corner!?",
      "status": "imported"
    },
    "voice_159:r_fc25e66a86fc2c85": {
      "text": "If they hit the same spot again...!",
      "status": "imported"
    },
    "voice_159:r_5aeeb4917340c42d": {
      "text": "Th-their moves\\nare beyond us...!",
      "status": "imported"
    },
    "voice_159:r_b765659981b6516d": {
      "text": "Won't lose!\\nI'm no helpless girl!",
      "status": "imported"
    },
    "voice_159:r_0c427458bc00eb95": {
      "text": "There's no escape... from them...",
      "status": "imported"
    },
    "voice_159:r_774a9ab4d8fd5351": {
      "text": "I'm falling... into darkness...",
      "status": "imported"
    },
    "voice_159:r_d3f01de714c015bd": {
      "text": "Aah!",
      "status": "imported"
    },
    "voice_159:r_7d2617c809fead70": {
      "text": "Mikono, pull yourself together!",
      "status": "imported"
    },
    "voice_159:r_ceb935ccbf830724": {
      "text": "Mikono! Switch with me!",
      "status": "imported"
    },
    "voice_159:r_862ef7385bf2abd4": {
      "text": "Thank you, Amata!\\nBut I'm okay!",
      "status": "imported"
    },
    "voice_159:r_001cbec4d9a4283f": {
      "text": "Can you, Mikono!? This is bad!",
      "status": "imported"
    },
    "voice_159:r_8ad40afecd02b41e": {
      "text": "I can...! No, I will do it!",
      "status": "imported"
    },
    "voice_159:r_26e5efec03c03d78": {
      "text": "Mikono...! Fear disrupts your tone!",
      "status": "imported"
    },
    "voice_159:r_4ad81e88c7557a8b": {
      "text": "Y-yes, Shrade!",
      "status": "imported"
    },
    "voice_159:r_1f65a7af190e4674": {
      "text": "Mikono! Get farther from the enemy!",
      "status": "imported"
    },
    "voice_159:r_40c5a9358ed5bf29": {
      "text": "Got it, MIX!",
      "status": "imported"
    },
    "voice_159:r_f2e18dfdfe0c89ea": {
      "text": "Aah! Mikono!",
      "status": "imported"
    },
    "voice_159:r_cf7dbf49e96a5755": {
      "text": "I'm fine, Yunoha! I can go on!",
      "status": "imported"
    },
    "voice_159:r_fa96676cc65bb509": {
      "text": "H-hey, Mikono!\\nThis is bad!",
      "status": "imported"
    },
    "voice_159:r_4e37f92e7d2fc62e": {
      "text": "I must do something, anything...!",
      "status": "imported"
    },
    "voice_159:r_66ab4cfe1557909d": {
      "text": "Mikono Suzushiro! Focus!",
      "status": "imported"
    },
    "voice_159:r_0bad405ee6ca63ba": {
      "text": "Y-yes, Director Crea!",
      "status": "imported"
    },
    "voice_159:r_2072eaf71a260ae7": {
      "text": "Aaaah! Amata!",
      "status": "imported"
    },
    "voice_159:r_6c13bbfd27a7799e": {
      "text": "No...! One more hit and...!",
      "status": "imported"
    },
    "voice_159:r_06f88dcbd3c9e738": {
      "text": "Me too!\\nI'll fight to the end!",
      "status": "imported"
    },
    "voice_159:r_b28faf9f71bc3598": {
      "text": "No power!\\nWas the engine hit!?",
      "status": "imported"
    },
    "voice_159:r_8a29278549f8e07a": {
      "text": "Aquarion! Hold on a little longer!",
      "status": "imported"
    },
    "voice_159:r_edd7a13ab8f06a14": {
      "text": "A-Amata...! At this rate...",
      "status": "imported"
    },
    "voice_159:r_8165e5b41f0124c4": {
      "text": "Don't quit!\\nFight to the end!",
      "status": "imported"
    },
    "voice_159:r_4e05581b7432cce8": {
      "text": "Mikono! Mikono!!",
      "status": "imported"
    },
    "voice_159:r_a60b107ea3c36a86": {
      "text": "Amata, lend me... your strength!",
      "status": "imported"
    },
    "voice_159:r_e33693e5ba4665b0": {
      "text": "Mikono,\\nYou must make your choice!",
      "status": "imported"
    },
    "voice_159:r_72a21a1a489af001": {
      "text": "I know!\\nCome with me, Zessica!",
      "status": "imported"
    },
    "voice_159:r_eb643f8bf737a0ca": {
      "text": "Ngh! The melody... is wavering...",
      "status": "imported"
    },
    "voice_159:r_0a3fccb71ec6cf2a": {
      "text": "Shrade, pull yourself together!",
      "status": "imported"
    },
    "voice_159:r_9b63cf1f3e0207ef": {
      "text": "Mikono, that's enough! Fall back!",
      "status": "imported"
    },
    "voice_159:r_8356f4e3dcdff938": {
      "text": "No, MIX!\\nYou have to stay strong!",
      "status": "imported"
    },
    "voice_159:r_1d6d784036ae0bd7": {
      "text": "Sorry, Yunoha, for scaring you...",
      "status": "imported"
    },
    "voice_159:r_625664af02183c17": {
      "text": "I'm okay!\\nLet's fight to the end!",
      "status": "imported"
    },
    "voice_159:r_3701cba361f80ea5": {
      "text": "Aaaaah! It's all over!!",
      "status": "imported"
    },
    "voice_159:r_63f429c5c68c0863": {
      "text": "Don't give up, Sazanka!",
      "status": "imported"
    },
    "voice_159:r_38e4a434c91d8ef0": {
      "text": "Mikono Suzushiro!\\nAquarion rallies!",
      "status": "imported"
    },
    "voice_159:r_98ed411352a3a6ac": {
      "text": "I understand, Director Crea!",
      "status": "imported"
    },
    "voice_159:r_4824bea6bab3af67": {
      "text": "No! Everyone, eject now!",
      "status": "imported"
    },
    "voice_159:r_862b92e63adb9734": {
      "text": "I'm sorry, Amata, everyone...",
      "status": "imported"
    },
    "voice_159:r_cb306ef55e49d107": {
      "text": "Aaaaaaaaah!!",
      "status": "imported"
    },
    "voice_159:r_57b2bd2de8a1408d": {
      "text": "M-Mikono! Eject, now!",
      "status": "imported"
    },
    "voice_159:r_76f080a4881e8ab5": {
      "text": "Rest well, players. See you again!",
      "status": "imported"
    },
    "voice_159:r_288133bc5b573dae": {
      "text": "I-if you'll have me...",
      "status": "imported"
    },
    "voice_159:r_6f95653e548f8fcf": {
      "text": "...I'm tired, so I'll sit this out.",
      "status": "imported"
    },
    "voice_159:r_d249d68bada91ab9": {
      "text": "Amata...",
      "status": "imported"
    },
    "voice_159:r_f5658c702d91db7a": {
      "text": "I'll dig a hole with all I've got!",
      "status": "imported"
    },
    "voice_159:r_686df329b50f195b": {
      "text": "Let's do it, Gepard!",
      "status": "imported"
    },
    "voice_159:r_25f0ab0fa3cf690c": {
      "text": "Raaaaaagh!!",
      "status": "imported"
    },
    "voice_159:r_b708a1d959013dbf": {
      "text": "Punch through!!",
      "status": "imported"
    },
    "voice_159:r_59fca03e929366c1": {
      "text": "I'll... dig a hole!",
      "status": "imported"
    },
    "voice_159:r_0d65eb631dcb7514": {
      "text": "Everyone, lend me your strength!",
      "status": "imported"
    },
    "voice_159:r_d03018a31e23f1e9": {
      "text": "Dimension Tunnel Shell!",
      "status": "imported"
    },
    "voice_159:r_279da5f732aa8847": {
      "text": "Gooooooo!!",
      "status": "imported"
    },
    "voice_159:r_97f82e3cb6f70110": {
      "text": "Huh...? 'Sorry,' Amata...?",
      "status": "imported"
    },
    "voice_159:r_c5611d8dd6def96b": {
      "text": "Huh...!?",
      "status": "imported"
    },
    "voice_159:r_6f12cc8ed2732eb5": {
      "text": "The true name...?",
      "status": "imported"
    },
    "voice_159:r_7abfc55f8fb62ba7": {
      "text": "What...?",
      "status": "imported"
    },
    "voice_159:r_99e7a66c650b5892": {
      "text": "Amata!!",
      "status": "imported"
    },
    "voice_159:r_5b2247b5cfbcd7b2": {
      "text": "I'll await you for 12,000 years...",
      "status": "imported"
    },
    "voice_159:r_2d7a9c06347582d9": {
      "text": "I'll make the first move!",
      "status": "imported"
    },
    "voice_159:r_bf953d64c3c7d9b7": {
      "text": "I'll go first!",
      "status": "imported"
    },
    "voice_159:r_e09b933e3e706779": {
      "text": "I must at least hold them off...!",
      "status": "imported"
    },
    "voice_159:r_66236eb99b676e5b": {
      "text": "Let's focus our attacks!",
      "status": "imported"
    },
    "voice_159:r_9639a2dbcd2f58ed": {
      "text": "I have to fulfill my role...!",
      "status": "imported"
    },
    "voice_159:r_aeea0893acb93d35": {
      "text": "Leave the enemies here to me!",
      "status": "imported"
    },
    "voice_159:r_b31568654e53487b": {
      "text": "That's my opponent...!",
      "status": "imported"
    },
    "voice_159:r_2502132569141ea3": {
      "text": "I have to fight that enemy...!",
      "status": "imported"
    }
  }
}
