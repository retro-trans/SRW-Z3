{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_195:r_479b340ccc6c572b": {
      "text": "There you are!",
      "status": "imported"
    },
    "voice_195:r_ca4acbac57a2a35e": {
      "text": "Drop dead!",
      "status": "imported"
    },
    "voice_195:r_77949221bf58f862": {
      "text": "I'll knock you out of the sky!",
      "status": "imported"
    },
    "voice_195:r_70b9c4b9f1f37eff": {
      "text": "I won't fall to the likes of you!",
      "status": "imported"
    },
    "voice_195:r_9fcb3754cb1773c7": {
      "text": "You're going to die!",
      "status": "imported"
    },
    "voice_195:r_3559d2fad32c2435": {
      "text": "This is where you die!",
      "status": "imported"
    },
    "voice_195:r_f7570547e9f80a64": {
      "text": "Fool! You left yourself wide open!",
      "status": "imported"
    },
    "voice_195:r_cbab0f4720e1fcf1": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_195:r_0bbe0b4f5364e732": {
      "text": "My psychic power will destroy you!",
      "status": "imported"
    },
    "voice_195:r_5dda5198137cb02a": {
      "text": "I can feel your mind!",
      "status": "imported"
    },
    "voice_195:r_83ec59afbecdec14": {
      "text": "Behold my psychic power!",
      "status": "imported"
    },
    "voice_195:r_e20bfd42ad95a3c9": {
      "text": "Learn the terror of a psychic!",
      "status": "imported"
    },
    "voice_195:r_0f58a8822381e57f": {
      "text": "This time, I'll finish you!",
      "status": "imported"
    },
    "voice_195:r_6dbcc507fb61b51d": {
      "text": "Prepare yourself, Mars!",
      "status": "imported"
    },
    "voice_195:r_b42ab697149a7c8a": {
      "text": "Once Mars falls, Earth is finished!",
      "status": "imported"
    },
    "voice_195:r_4de4fcf3b440baf4": {
      "text": "Mars! You are destined to die!",
      "status": "imported"
    },
    "voice_195:r_0121a166c715cdff": {
      "text": "If Godmars falls, victory is ours!",
      "status": "imported"
    },
    "voice_195:r_30fad37a42bd3ad3": {
      "text": "I'll kill Mars's allies first!",
      "status": "imported"
    },
    "voice_195:r_80a0b2a84e05d81a": {
      "text": "Roze! You traitor!",
      "status": "imported"
    },
    "voice_195:r_4a9ac1dff86506d9": {
      "text": "Face me, Gundam!",
      "status": "imported"
    },
    "voice_195:r_bc8538e6af3d2577": {
      "text": "I'll crush those puny mechs!",
      "status": "imported"
    },
    "voice_195:r_924516c8de2b5342": {
      "text": "Enough! Stop buzzing around!",
      "status": "imported"
    },
    "voice_195:r_da1174533722333f": {
      "text": "Another combiner like Godmars?!",
      "status": "imported"
    },
    "voice_195:r_fdeb8162976e72c1": {
      "text": "If you hit me, I'll hit back!",
      "status": "imported"
    },
    "voice_195:r_0fadb5c26df92b42": {
      "text": "Payback for earlier!",
      "status": "imported"
    },
    "voice_195:r_6b15af9a0057cdc8": {
      "text": "You're still over there?!",
      "status": "imported"
    },
    "voice_195:r_15b4a90140e8a33a": {
      "text": "This will finish you!",
      "status": "imported"
    },
    "voice_195:r_af884a6b11dff121": {
      "text": "Don't expect to make it home alive!",
      "status": "imported"
    },
    "voice_195:r_ac6fe7838e95647b": {
      "text": "I'll cover you!",
      "status": "imported"
    },
    "voice_195:r_77ca87eacd17ad52": {
      "text": "Coordinated attack!",
      "status": "imported"
    },
    "voice_195:r_bf3244994760e535": {
      "text": "Here's one from me too!",
      "status": "imported"
    },
    "voice_195:r_aabfb21c9d069ce7": {
      "text": "Leave this to me!",
      "status": "imported"
    },
    "voice_195:r_02479dc8fe989560": {
      "text": "Withdraw while you still can!",
      "status": "imported"
    },
    "voice_195:r_a2df00f91a9b0a9e": {
      "text": "I'll stop that attack!",
      "status": "imported"
    },
    "voice_195:r_48b60d6c48b9b142": {
      "text": "Damn! I can't counter?!",
      "status": "imported"
    },
    "voice_195:r_8927e6fb681aa809": {
      "text": "I can't do anything like this!",
      "status": "imported"
    },
    "voice_195:r_665f01666859013b": {
      "text": "I'll be slaughtered at this rate!",
      "status": "imported"
    },
    "voice_195:r_a571eec59b258d11": {
      "text": "Damn! My energy!",
      "status": "imported"
    },
    "voice_195:r_ddbe581c5ea9183d": {
      "text": "I can't counter from this position!",
      "status": "imported"
    },
    "voice_195:r_faae935cca0edc72": {
      "text": "This range works against me!",
      "status": "imported"
    },
    "voice_195:r_d4430bf362340b32": {
      "text": "Too bad for you!",
      "status": "imported"
    },
    "voice_195:r_6ff1323b355593e0": {
      "text": "Like that'll hit me!",
      "status": "imported"
    },
    "voice_195:r_b7b5625d7cd4282f": {
      "text": "What are you aiming at?!",
      "status": "imported"
    },
    "voice_195:r_36133ad73a73ef98": {
      "text": "You imbecile!",
      "status": "imported"
    },
    "voice_195:r_920740a0219c5085": {
      "text": "I see right through your plans!",
      "status": "imported"
    },
    "voice_195:r_a8451712c57c1a72": {
      "text": "This too is my psychic power!",
      "status": "imported"
    },
    "voice_195:r_3633df5b7b8f47fa": {
      "text": "Hmph. I can sense your panic.",
      "status": "imported"
    },
    "voice_195:r_52dfc56b14b93551": {
      "text": "You're too naive, Mars!",
      "status": "imported"
    },
    "voice_195:r_1b9b2aab5cb104da": {
      "text": "A traitor's attack won't touch me!",
      "status": "imported"
    },
    "voice_195:r_342044c706a2340f": {
      "text": "It's useless!",
      "status": "imported"
    },
    "voice_195:r_719e897304ec42d4": {
      "text": "What's wrong? Is that all?",
      "status": "imported"
    },
    "voice_195:r_d5e0a2317c40d322": {
      "text": "That doesn't even count as a wound!",
      "status": "imported"
    },
    "voice_195:r_ec2ea17765052401": {
      "text": "Damn! It grazed me!",
      "status": "imported"
    },
    "voice_195:r_f2d4255f1c2f7542": {
      "text": "That was nothing!",
      "status": "imported"
    },
    "voice_195:r_5d08ad19e2da125b": {
      "text": "That won't hurt my battle mech!",
      "status": "imported"
    },
    "voice_195:r_a7246b52782a877e": {
      "text": "Hmph. Don't scorn a battle mech.",
      "status": "imported"
    },
    "voice_195:r_dc8701f6bcb9904f": {
      "text": "Is that all you've got, Mars?!",
      "status": "imported"
    },
    "voice_195:r_d6bdd730f24f66eb": {
      "text": "Mars! Is that your psychic power?!",
      "status": "imported"
    },
    "voice_195:r_41997412868c48c4": {
      "text": "Damn you! You loathsome wretch!",
      "status": "imported"
    },
    "voice_195:r_9e6cf4f389dae55c": {
      "text": "Damn! Where did that hit me?!",
      "status": "imported"
    },
    "voice_195:r_9e0c80ac7e33b459": {
      "text": "Grr! This is taking a bad turn!",
      "status": "imported"
    },
    "voice_195:r_7432ef43ed3471dc": {
      "text": "Gah! You'll pay for that!",
      "status": "imported"
    },
    "voice_195:r_065443f6ddfcf0d7": {
      "text": "You dare attack my battle mech?!",
      "status": "imported"
    },
    "voice_195:r_47d52a2839c71715": {
      "text": "Gah! Don't take this mech lightly!",
      "status": "imported"
    },
    "voice_195:r_847f82e7f3eef651": {
      "text": "Curse you, Mars!",
      "status": "imported"
    },
    "voice_195:r_eb7ae28b53dc033c": {
      "text": "Mars! You alone are unforgivable!",
      "status": "imported"
    },
    "voice_195:r_857c4a52ce8df0fd": {
      "text": "Tch! You're formidable, Mars!",
      "status": "imported"
    },
    "voice_195:r_55417493fce1d347": {
      "text": "I can't retreat yet!",
      "status": "imported"
    },
    "voice_195:r_8fdf5910927c9591": {
      "text": "No! This can't go on!",
      "status": "imported"
    },
    "voice_195:r_7d724dbcc4451e10": {
      "text": "Urgh! Is this wound fatal?!",
      "status": "imported"
    },
    "voice_195:r_93e25418a203cb8f": {
      "text": "So strong! Such incredible power!",
      "status": "imported"
    },
    "voice_195:r_adeb0a29274d3d9b": {
      "text": "I won't be defeated here!",
      "status": "imported"
    },
    "voice_195:r_24cf161287ef9d5c": {
      "text": "Damn! Don't get carried away!!",
      "status": "imported"
    },
    "voice_195:r_8f60f6fc86db3107": {
      "text": "Gah!\\nMy battle mech is cornered?!",
      "status": "imported"
    },
    "voice_195:r_b1de76a75a253c13": {
      "text": "Impossible! My battle mech!",
      "status": "imported"
    },
    "voice_195:r_128c35bf3e0e394c": {
      "text": "Mars! Not before I've beaten you!",
      "status": "imported"
    },
    "voice_195:r_5213c17e13b23de0": {
      "text": "I-Is this a Super ESP's power?!",
      "status": "imported"
    },
    "voice_195:r_38fdff9483e9245c": {
      "text": "I-Impossible!!",
      "status": "imported"
    },
    "voice_195:r_620fedec67706d7d": {
      "text": "Uwaaaaaah!!",
      "status": "imported"
    },
    "voice_195:r_9680dcd0fddcfcc7": {
      "text": "C-Curse youuu!!",
      "status": "imported"
    },
    "voice_195:r_2a00f1044ad5cbaa": {
      "text": "I-I've been beaten!!",
      "status": "imported"
    },
    "voice_195:r_3dbeead1bd3164ef": {
      "text": "No! Uwaaaaaah!!",
      "status": "imported"
    },
    "voice_195:r_98d15b8cc09bc915": {
      "text": "Taste the power of death's realm!",
      "status": "imported"
    },
    "voice_195:r_46e86d000250e137": {
      "text": "Go to the world of darkness!",
      "status": "imported"
    },
    "voice_195:r_ac341e7976e88f0b": {
      "text": "I'll show you what despair means!",
      "status": "imported"
    },
    "voice_195:r_cdbd128a5b4127cc": {
      "text": "Bid farewell to this world!",
      "status": "imported"
    },
    "voice_195:r_cfccaa1fbeda124c": {
      "text": "This is Daedalos's dark power!",
      "status": "imported"
    },
    "voice_195:r_b1f8ec192b9c083a": {
      "text": "Buffle sends you to death's realm!",
      "status": "imported"
    },
    "voice_195:r_a007f9ab9cf048b3": {
      "text": "Zedfiner, bury them!",
      "status": "imported"
    },
    "voice_195:r_ddafde4b065ced49": {
      "text": "Begone to the dark world, Godmars!",
      "status": "imported"
    },
    "voice_195:r_3c5b0c2ac812d5de": {
      "text": "How do you like that?!",
      "status": "imported"
    },
    "voice_195:r_5b9e8897190892eb": {
      "text": "You're a blight upon the galaxy!",
      "status": "imported"
    },
    "voice_195:r_0ab7914877fd48ed": {
      "text": "I'll pay you back twice over!",
      "status": "imported"
    },
    "voice_195:r_cb846feec748c2e3": {
      "text": "You won't escape!",
      "status": "imported"
    },
    "voice_195:r_c958860b0676b1f5": {
      "text": "I can still fight!",
      "status": "imported"
    },
    "voice_195:r_5e2669b82ef75ce3": {
      "text": "One more strike!",
      "status": "imported"
    },
    "voice_195:r_7847e0ed7dc9282d": {
      "text": "Daaaaamn!!",
      "status": "imported"
    },
    "voice_195:r_e42b52c7a987b906": {
      "text": "Gwaaah! I-I'm done for!",
      "status": "imported"
    },
    "voice_195:r_6825fd1ff907bd22": {
      "text": "That hit me dead-on?!",
      "status": "imported"
    },
    "voice_195:r_607f666f1563bc0d": {
      "text": "Hmph. How feeble.",
      "status": "imported"
    },
    "voice_195:r_97b7431eeb81e6b6": {
      "text": "Don't celebrate landing a hit!",
      "status": "imported"
    },
    "voice_195:r_132f605d02975e71": {
      "text": "You missed!",
      "status": "imported"
    },
    "voice_195:r_9b9726b1872759d6": {
      "text": "I'm right here!",
      "status": "imported"
    },
    "voice_195:r_1252db29683fefe0": {
      "text": "That won't work!",
      "status": "imported"
    },
    "voice_195:r_ad3d538f1e909184": {
      "text": "As if that could hurt me!",
      "status": "imported"
    },
    "voice_195:r_b84afafb8a33ec60": {
      "text": "Your life is mine!",
      "status": "imported"
    },
    "voice_195:r_391aa56435d9dd6e": {
      "text": "Let's do this! Counterattack!",
      "status": "imported"
    },
    "voice_195:r_7c796ba53bd7ea03": {
      "text": "I'll draw them away!",
      "status": "imported"
    },
    "voice_195:r_fa944da4b6519006": {
      "text": "Leave it to me!",
      "status": "imported"
    },
    "voice_195:r_95d047bcc17fccc6": {
      "text": "Roger! I'm going all out!",
      "status": "imported"
    },
    "voice_195:r_640327a12a559b31": {
      "text": "Roger! Commence attack!",
      "status": "imported"
    },
    "voice_195:r_bdd38c584fa313d0": {
      "text": "All right, let's go!",
      "status": "imported"
    }
  }
}
