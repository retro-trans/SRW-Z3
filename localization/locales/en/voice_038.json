{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_038:r_479b340ccc6c572b": {
      "text": "I will never retreat!",
      "status": "imported"
    },
    "voice_038:r_ca4acbac57a2a35e": {
      "text": "I refuse to accept your methods!",
      "status": "imported"
    },
    "voice_038:r_77949221bf58f862": {
      "text": "Whatever my state,\\nI fight head-on!",
      "status": "imported"
    },
    "voice_038:r_70b9c4b9f1f37eff": {
      "text": "Enkidudu can still fight!",
      "status": "imported"
    },
    "voice_038:r_9fcb3754cb1773c7": {
      "text": "Stay with me a bit more,\\nEnkidudu!",
      "status": "imported"
    },
    "voice_038:r_3559d2fad32c2435": {
      "text": "Even if I have to push it...!",
      "status": "imported"
    },
    "voice_038:r_f7570547e9f80a64": {
      "text": "It's risky, but one more time!",
      "status": "imported"
    },
    "voice_038:r_cbab0f4720e1fcf1": {
      "text": "Gurren Lagann! Today's the day!",
      "status": "imported"
    },
    "voice_038:r_0bbe0b4f5364e732": {
      "text": "Simon! Not until I defeat you...!",
      "status": "imported"
    },
    "voice_038:r_5dda5198137cb02a": {
      "text": "I can't waste time on supplies...!",
      "status": "imported"
    },
    "voice_038:r_83ec59afbecdec14": {
      "text": "I'm at a disadvantage up close...!",
      "status": "imported"
    },
    "voice_038:r_e20bfd42ad95a3c9": {
      "text": "Enkidudu's blade\\nisn't dead yet!",
      "status": "imported"
    },
    "voice_038:r_0f58a8822381e57f": {
      "text": "Enki Sword's edge!\\nSharp as ever!",
      "status": "imported"
    },
    "voice_038:r_6dbcc507fb61b51d": {
      "text": "A long fight favors you...! Then!",
      "status": "imported"
    },
    "voice_038:r_b42ab697149a7c8a": {
      "text": "I'll end this with a Combo Attack!",
      "status": "imported"
    },
    "voice_038:r_4de4fcf3b440baf4": {
      "text": "This is the end!!",
      "status": "imported"
    },
    "voice_038:r_0121a166c715cdff": {
      "text": "It's the moment of truth, Enkidudu!",
      "status": "imported"
    },
    "voice_038:r_30fad37a42bd3ad3": {
      "text": "Our combined resolve, against them!",
      "status": "imported"
    },
    "voice_038:r_80a0b2a84e05d81a": {
      "text": "Drive it into them!!",
      "status": "imported"
    },
    "voice_038:r_15b4a90140e8a33a": {
      "text": "Like hell I'll back down now!",
      "status": "imported"
    },
    "voice_038:r_af884a6b11dff121": {
      "text": "I'll repay this debt! Count on it!",
      "status": "imported"
    },
    "voice_038:r_ac6fe7838e95647b": {
      "text": "I can't stay on the defensive...!",
      "status": "imported"
    },
    "voice_038:r_77ca87eacd17ad52": {
      "text": "Think this Enkidudu\\nis easy prey?!",
      "status": "imported"
    },
    "voice_038:r_bf3244994760e535": {
      "text": "Even now, I can handle this much!",
      "status": "imported"
    },
    "voice_038:r_aabfb21c9d069ce7": {
      "text": "Hold together, Enkidudu!",
      "status": "imported"
    },
    "voice_038:r_02479dc8fe989560": {
      "text": "I can't even counterattack...!",
      "status": "imported"
    },
    "voice_038:r_a2df00f91a9b0a9e": {
      "text": "No upkeep,\\nthis was inevitable...!",
      "status": "imported"
    },
    "voice_038:r_48b60d6c48b9b142": {
      "text": "So you'll only fire from safety...!",
      "status": "imported"
    },
    "voice_038:r_8927e6fb681aa809": {
      "text": "I haven't sunk low enough for that!",
      "status": "imported"
    },
    "voice_038:r_665f01666859013b": {
      "text": "How's that!\\nEnkidudu still lives!",
      "status": "imported"
    },
    "voice_038:r_a571eec59b258d11": {
      "text": "You really underestimated me!",
      "status": "imported"
    },
    "voice_038:r_ddbe581c5ea9183d": {
      "text": "Never mock a wounded Beastman!",
      "status": "imported"
    },
    "voice_038:r_faae935cca0edc72": {
      "text": "Don't hold back! Give it your all!!",
      "status": "imported"
    },
    "voice_038:r_d4430bf362340b32": {
      "text": "What's wrong, Simon? Get serious!",
      "status": "imported"
    },
    "voice_038:r_36133ad73a73ef98": {
      "text": "That won't work on me!",
      "status": "imported"
    },
    "voice_038:r_3633df5b7b8f47fa": {
      "text": "You're still holding up, Enkidudu!",
      "status": "imported"
    },
    "voice_038:r_52dfc56b14b93551": {
      "text": "At my best, I'd have dodged...!",
      "status": "imported"
    },
    "voice_038:r_1b9b2aab5cb104da": {
      "text": "Ngh!\\nEven a scratch is fatal now!",
      "status": "imported"
    },
    "voice_038:r_342044c706a2340f": {
      "text": "The shield can still hold...!",
      "status": "imported"
    },
    "voice_038:r_cf41e8828a90cbdb": {
      "text": "So you're going all-out at once...!",
      "status": "imported"
    },
    "voice_038:r_719e897304ec42d4": {
      "text": "Damn...! The legs are at the limit!",
      "status": "imported"
    },
    "voice_038:r_d5e0a2317c40d322": {
      "text": "You cry out!\\nSorry, Enkidudu!",
      "status": "imported"
    },
    "voice_038:r_ec2ea17765052401": {
      "text": "I'll hold out...! No matter what!",
      "status": "imported"
    },
    "voice_038:r_f2d4255f1c2f7542": {
      "text": "Yes!\\nIt takes your all to beat me!!",
      "status": "imported"
    },
    "voice_038:r_5d08ad19e2da125b": {
      "text": "Bravo, Simon!\\nI've got pride too!!",
      "status": "imported"
    },
    "voice_038:r_d6bdd730f24f66eb": {
      "text": "Seems\\nyou're my final opponent...!",
      "status": "imported"
    },
    "voice_038:r_41997412868c48c4": {
      "text": "By my remaining\\nwarrior's pride...!",
      "status": "imported"
    },
    "voice_038:r_9e6cf4f389dae55c": {
      "text": "Enkidudu!\\nHold out a bit more...!",
      "status": "imported"
    },
    "voice_038:r_9e0c80ac7e33b459": {
      "text": "Enkidudu.\\nYou bore my every whim...",
      "status": "imported"
    },
    "voice_038:r_7432ef43ed3471dc": {
      "text": "That's it... Sorry for pushing you.",
      "status": "imported"
    },
    "voice_038:r_065443f6ddfcf0d7": {
      "text": "Hmph... So I've lost again...",
      "status": "imported"
    },
    "voice_038:r_47d52a2839c71715": {
      "text": "This Enkidudu!\\nWe won't trail you!",
      "status": "imported"
    },
    "voice_038:r_847f82e7f3eef651": {
      "text": "Even if today is my last day...!!",
      "status": "imported"
    },
    "voice_038:r_857c4a52ce8df0fd": {
      "text": "Ngh! The shield can't hold...!?",
      "status": "imported"
    },
    "voice_038:r_55417493fce1d347": {
      "text": "Even with the legs giving out!",
      "status": "imported"
    },
    "voice_038:r_8fdf5910927c9591": {
      "text": "The barrier will keep me going!",
      "status": "imported"
    },
    "voice_038:r_7d724dbcc4451e10": {
      "text": "Won't withdraw!?\\nWhat a farce...!",
      "status": "imported"
    },
    "voice_038:r_93e25418a203cb8f": {
      "text": "You cut flesh - I'll break bone!",
      "status": "imported"
    }
  }
}
