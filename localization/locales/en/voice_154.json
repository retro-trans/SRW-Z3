{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_154:r_479b340ccc6c572b": {
      "text": "Mikage... I dwell in love's shadow.",
      "status": "imported"
    },
    "voice_154:r_77949221bf58f862": {
      "text": "Heh... Call me defeated by love...",
      "status": "imported"
    },
    "voice_154:r_70b9c4b9f1f37eff": {
      "text": "You thirst for love, don't you?",
      "status": "imported"
    },
    "voice_154:r_9fcb3754cb1773c7": {
      "text": "I'm always on love's side...",
      "status": "imported"
    },
    "voice_154:r_3559d2fad32c2435": {
      "text": "Be buried... and begone...",
      "status": "imported"
    },
    "voice_154:r_f7570547e9f80a64": {
      "text": "You sinful wingless wretches...",
      "status": "imported"
    },
    "voice_154:r_cbab0f4720e1fcf1": {
      "text": "At last,\\nmy long dream is fulfilled!",
      "status": "imported"
    },
    "voice_154:r_0bbe0b4f5364e732": {
      "text": "Now I shall tell\\nthe true myth...!",
      "status": "imported"
    },
    "voice_154:r_5dda5198137cb02a": {
      "text": "Heh heh heh heh... At last!",
      "status": "imported"
    },
    "voice_154:r_83ec59afbecdec14": {
      "text": "Denying war\\ndenies this world...",
      "status": "imported"
    },
    "voice_154:r_e20bfd42ad95a3c9": {
      "text": "Love's loser will destroy all love.",
      "status": "imported"
    },
    "voice_154:r_0f58a8822381e57f": {
      "text": "I birth a new world\\nas Genesis God!",
      "status": "imported"
    },
    "voice_154:r_6dbcc507fb61b51d": {
      "text": "A little cruelty won't hurt, right?",
      "status": "imported"
    },
    "voice_154:r_b42ab697149a7c8a": {
      "text": "G-r-e-e-d-y!",
      "status": "imported"
    },
    "voice_154:r_4de4fcf3b440baf4": {
      "text": "Now\\nred dream meets blue reality...!",
      "status": "imported"
    },
    "voice_154:r_0121a166c715cdff": {
      "text": "Two sundered souls are calling out!",
      "status": "imported"
    },
    "voice_154:r_30fad37a42bd3ad3": {
      "text": "I'll join the stars\\nas their new god",
      "status": "imported"
    },
    "voice_154:r_80a0b2a84e05d81a": {
      "text": "You mere winged cur!",
      "status": "imported"
    },
    "voice_154:r_bc8538e6af3d2577": {
      "text": "You want that woman that badly?!",
      "status": "imported"
    },
    "voice_154:r_924516c8de2b5342": {
      "text": "No death's enough,\\nApollonius thief!",
      "status": "imported"
    },
    "voice_154:r_da1174533722333f": {
      "text": "Twice you stole\\nmy love, vile woman!",
      "status": "imported"
    },
    "voice_154:r_fdeb8162976e72c1": {
      "text": "You could never defy me.",
      "status": "imported"
    },
    "voice_154:r_0fadb5c26df92b42": {
      "text": "Love's betrayal exacts a high price.",
      "status": "imported"
    },
    "voice_154:r_6b15af9a0057cdc8": {
      "text": "Can love transcend the stars...!",
      "status": "imported"
    },
    "voice_154:r_af884a6b11dff121": {
      "text": "You got your wish...\\nHow enviable!",
      "status": "imported"
    },
    "voice_154:r_ac6fe7838e95647b": {
      "text": "Love torn away,\\nsavor all the grief.",
      "status": "imported"
    },
    "voice_154:r_77ca87eacd17ad52": {
      "text": "Love is always so fragile...",
      "status": "imported"
    },
    "voice_154:r_bf3244994760e535": {
      "text": "You and I were both left unchosen...",
      "status": "imported"
    },
    "voice_154:r_48b60d6c48b9b142": {
      "text": "You too are one whom love defeated.",
      "status": "imported"
    },
    "voice_154:r_ddbe581c5ea9183d": {
      "text": "Go now, to your beloved's side.",
      "status": "imported"
    },
    "voice_154:r_b7b5625d7cd4282f": {
      "text": "Unleash the anger in your heart.",
      "status": "imported"
    },
    "voice_154:r_36133ad73a73ef98": {
      "text": "You exist to destroy the universe...",
      "status": "imported"
    },
    "voice_154:r_920740a0219c5085": {
      "text": "You must live\\nin endless conflict.",
      "status": "imported"
    },
    "voice_154:r_a8451712c57c1a72": {
      "text": "It seems\\nthis world was chosen...",
      "status": "imported"
    },
    "voice_154:r_3633df5b7b8f47fa": {
      "text": "B-E-A-S-T...",
      "status": "imported"
    },
    "voice_154:r_1b9b2aab5cb104da": {
      "text": "Starved beast, howl for love!",
      "status": "imported"
    },
    "voice_154:r_342044c706a2340f": {
      "text": "What a wretched form...",
      "status": "imported"
    },
    "voice_154:r_719e897304ec42d4": {
      "text": "No matter how strong your armor...",
      "status": "imported"
    },
    "voice_154:r_d5e0a2317c40d322": {
      "text": "You don't see your love being used.",
      "status": "imported"
    },
    "voice_154:r_ec2ea17765052401": {
      "text": "A Gundam... Heh heh heh...",
      "status": "imported"
    },
    "voice_154:r_f2d4255f1c2f7542": {
      "text": "Mutual understanding...? A fantasy.",
      "status": "imported"
    },
    "voice_154:r_5d08ad19e2da125b": {
      "text": "Such a lovely cry...",
      "status": "imported"
    },
    "voice_154:r_a7246b52782a877e": {
      "text": "Why not choose one,\\nTriangler?",
      "status": "imported"
    },
    "voice_154:r_dc8701f6bcb9904f": {
      "text": "You seem starved for love too...",
      "status": "imported"
    },
    "voice_154:r_9e6cf4f389dae55c": {
      "text": "A false being dares preach love...",
      "status": "imported"
    },
    "voice_154:r_47d52a2839c71715": {
      "text": "I can smell that one upon you...",
      "status": "imported"
    },
    "voice_154:r_847f82e7f3eef651": {
      "text": "Apollonius...",
      "status": "imported"
    },
    "voice_154:r_eb7ae28b53dc033c": {
      "text": "All you love\\nshall burn to ash...!",
      "status": "imported"
    },
    "voice_154:r_857c4a52ce8df0fd": {
      "text": "You see this, Apollonius...",
      "status": "imported"
    },
    "voice_154:r_55417493fce1d347": {
      "text": "Love's loser\\nshall burn all love...!",
      "status": "imported"
    },
    "voice_154:r_8fdf5910927c9591": {
      "text": "Ah, Apollonius...",
      "status": "imported"
    },
    "voice_154:r_7d724dbcc4451e10": {
      "text": "All this world\\nshall burn to ash...!",
      "status": "imported"
    },
    "voice_154:r_93e25418a203cb8f": {
      "text": "Divine power alone is infinite...",
      "status": "imported"
    },
    "voice_154:r_adeb0a29274d3d9b": {
      "text": "I may appear anywhere.",
      "status": "imported"
    },
    "voice_154:r_24cf161287ef9d5c": {
      "text": "At any time, I grant my blessing...!",
      "status": "imported"
    },
    "voice_154:r_8f60f6fc86db3107": {
      "text": "This is infinity...",
      "status": "imported"
    },
    "voice_154:r_b1de76a75a253c13": {
      "text": "Cause and effect, reversed.",
      "status": "imported"
    },
    "voice_154:r_128c35bf3e0e394c": {
      "text": "God's power transcends causality...!",
      "status": "imported"
    },
    "voice_154:r_8c61c59a1c0aebbf": {
      "text": "Now, allow me to return the favor.",
      "status": "imported"
    },
    "voice_154:r_aba6a7662129d8ce": {
      "text": "Now then, it's my turn.",
      "status": "imported"
    },
    "voice_154:r_b84afafb8a33ec60": {
      "text": "I've waited for this moment...",
      "status": "imported"
    },
    "voice_154:r_c8c59db85bf875e6": {
      "text": "Shall we begin the counterattack...?",
      "status": "imported"
    },
    "voice_154:r_391aa56435d9dd6e": {
      "text": "Heh heh heh... You still struggle...",
      "status": "imported"
    },
    "voice_154:r_7c796ba53bd7ea03": {
      "text": "Such a pity... You won't escape.",
      "status": "imported"
    },
    "voice_154:r_fa944da4b6519006": {
      "text": "You're within my embrace...",
      "status": "imported"
    },
    "voice_154:r_95d047bcc17fccc6": {
      "text": "Suffer the price of defying a god.",
      "status": "imported"
    },
    "voice_154:r_640327a12a559b31": {
      "text": "You thought I'd let you escape?",
      "status": "imported"
    },
    "voice_154:r_bdd38c584fa313d0": {
      "text": "Let me shatter your sweet illusion.",
      "status": "imported"
    },
    "voice_154:r_3fd86c1027f317c8": {
      "text": "Then allow me to take over.",
      "status": "imported"
    },
    "voice_154:r_d0372a183d2007ad": {
      "text": "Let us cooperate here, shall we?",
      "status": "imported"
    },
    "voice_154:r_217aa5e1d545b44d": {
      "text": "The time has not yet come.",
      "status": "imported"
    },
    "voice_154:r_381992c5d8224937": {
      "text": "I cannot allow that life to fade.",
      "status": "imported"
    },
    "voice_154:r_f1e7ed9e5874aba5": {
      "text": "What...? Unable to attack...?",
      "status": "imported"
    },
    "voice_154:r_fc25e66a86fc2c85": {
      "text": "It seems my love was not enough...",
      "status": "imported"
    },
    "voice_154:r_5aeeb4917340c42d": {
      "text": "I will never forget this outrage...",
      "status": "imported"
    },
    "voice_154:r_b765659981b6516d": {
      "text": "Don't be afraid...",
      "status": "imported"
    },
    "voice_154:r_0c427458bc00eb95": {
      "text": "Absurd...",
      "status": "imported"
    },
    "voice_154:r_774a9ab4d8fd5351": {
      "text": "If you cry, use a sweeter voice...",
      "status": "imported"
    },
    "voice_154:r_d3f01de714c015bd": {
      "text": "Soon... Very soon...",
      "status": "imported"
    },
    "voice_154:r_7d2617c809fead70": {
      "text": "Ah, how very pitiful...",
      "status": "imported"
    },
    "voice_154:r_ceb935ccbf830724": {
      "text": "Isn't it time you woke up?",
      "status": "imported"
    },
    "voice_154:r_862ef7385bf2abd4": {
      "text": "Yes... What a good child...",
      "status": "imported"
    },
    "voice_154:r_001cbec4d9a4283f": {
      "text": "No winged cur defies a god's machine",
      "status": "imported"
    },
    "voice_154:r_8ad40afecd02b41e": {
      "text": "Wretched winged cur... Vain barking.",
      "status": "imported"
    },
    "voice_154:r_26e5efec03c03d78": {
      "text": "Kagura... You cannot reach me...",
      "status": "imported"
    },
    "voice_154:r_4ad81e88c7557a8b": {
      "text": "A sham... Unfit for a god's machine.",
      "status": "imported"
    },
    "voice_154:r_fa96676cc65bb509": {
      "text": "Such futility...!",
      "status": "imported"
    },
    "voice_154:r_4e37f92e7d2fc62e": {
      "text": "Oh, don't be disappointed...",
      "status": "imported"
    },
    "voice_154:r_2072eaf71a260ae7": {
      "text": "Heh... W-e-a-k.",
      "status": "imported"
    },
    "voice_154:r_6c13bbfd27a7799e": {
      "text": "Powerless... Ah, ever powerless...",
      "status": "imported"
    },
    "voice_154:r_06f88dcbd3c9e738": {
      "text": "Heh. This is a trivial matter...",
      "status": "imported"
    },
    "voice_154:r_b28faf9f71bc3598": {
      "text": "Love's melody is... fleeting.",
      "status": "imported"
    },
    "voice_154:r_8a29278549f8e07a": {
      "text": "Ah, what an indecent attack...",
      "status": "imported"
    },
    "voice_154:r_7e6c573c26177f98": {
      "text": "How droll... Such graceless flailing",
      "status": "imported"
    },
    "voice_154:r_45abf84f7757d6eb": {
      "text": "Yes... Show me\\nyour despairing form.",
      "status": "imported"
    },
    "voice_154:r_edd7a13ab8f06a14": {
      "text": "Crave more, more...!",
      "status": "imported"
    },
    "voice_154:r_8165e5b41f0124c4": {
      "text": "You think this can defeat a god?",
      "status": "imported"
    },
    "voice_154:r_4e05581b7432cce8": {
      "text": "Your past rages,\\nunleash its madness",
      "status": "imported"
    },
    "voice_154:r_a60b107ea3c36a86": {
      "text": "Beautiful...!",
      "status": "imported"
    },
    "voice_154:r_e33693e5ba4665b0": {
      "text": "Not bad for one without wings.",
      "status": "imported"
    },
    "voice_154:r_72a21a1a489af001": {
      "text": "Yes... Struggle just like that.",
      "status": "imported"
    },
    "voice_154:r_eb643f8bf737a0ca": {
      "text": "Ah, how truly wonderful...!",
      "status": "imported"
    },
    "voice_154:r_0a3fccb71ec6cf2a": {
      "text": "Love is forever making sinners...",
      "status": "imported"
    },
    "voice_154:r_9b63cf1f3e0207ef": {
      "text": "My, how flashy\\nyou've made things.",
      "status": "imported"
    },
    "voice_154:r_8356f4e3dcdff938": {
      "text": "Wonderful...! Utterly doomed!",
      "status": "imported"
    },
    "voice_154:r_1d6d784036ae0bd7": {
      "text": "Has a little hope begun to bloom?",
      "status": "imported"
    },
    "voice_154:r_625664af02183c17": {
      "text": "Heh heh,\\nhere's a little hope.",
      "status": "imported"
    },
    "voice_154:r_3701cba361f80ea5": {
      "text": "Nothing\\nbeside my old pain...",
      "status": "imported"
    },
    "voice_154:r_63f429c5c68c0863": {
      "text": "Winged cur,\\nyou dare such a deed...!",
      "status": "imported"
    },
    "voice_154:r_38e4a434c91d8ef0": {
      "text": "Again,\\nyou parade love before me...!",
      "status": "imported"
    },
    "voice_154:r_98ed411352a3a6ac": {
      "text": "Kagura... A pet bites its master...!",
      "status": "imported"
    },
    "voice_154:r_4824bea6bab3af67": {
      "text": "Cursed heir of the Mechanical Angel!",
      "status": "imported"
    },
    "voice_154:r_862b92e63adb9734": {
      "text": "This power shrouds all in despair!",
      "status": "imported"
    },
    "voice_154:r_cb306ef55e49d107": {
      "text": "Evolution-obsessed,\\nyou fool...!",
      "status": "imported"
    },
    "voice_154:r_57b2bd2de8a1408d": {
      "text": "You deny mankind,\\nyet you defy me!",
      "status": "imported"
    },
    "voice_154:r_76f080a4881e8ab5": {
      "text": "Your path leads\\nonly to despair...!",
      "status": "imported"
    },
    "voice_154:r_6f95653e548f8fcf": {
      "text": "Past humanity?\\nDespair's guide...!",
      "status": "imported"
    },
    "voice_154:r_e9b3307e9eb69f11": {
      "text": "Shaken by love,\\nyet you wound me...!",
      "status": "imported"
    },
    "voice_154:r_03cdac73042343ee": {
      "text": "Poor lamb bewitched by that one...",
      "status": "imported"
    },
    "voice_154:r_0e7466971bec4cc4": {
      "text": "What is this...!?",
      "status": "imported"
    },
    "voice_154:r_efa71f7a4cc33ff3": {
      "text": "Wrong... Something is wrong...!",
      "status": "imported"
    },
    "voice_154:r_3fc2e1186557e7a0": {
      "text": "You puny wingless wretches...!",
      "status": "imported"
    },
    "voice_154:r_fa6930340a545054": {
      "text": "Insolent little trick!",
      "status": "imported"
    },
    "voice_154:r_2332b9d56461d7ab": {
      "text": "Something... is distorted...!",
      "status": "imported"
    },
    "voice_154:r_854aa0a91a3c80d1": {
      "text": "Why...?\\nWhy has this happened...!?",
      "status": "imported"
    },
    "voice_154:r_0bc8ae32a406ceab": {
      "text": "Hurt over and over,\\nyet you rise...!",
      "status": "imported"
    },
    "voice_154:r_82c09f011d703b2c": {
      "text": "Curse you... This isn't over...!",
      "status": "imported"
    },
    "voice_154:r_2b4d8818c77b6dca": {
      "text": "Why won't you bend to my will!!",
      "status": "imported"
    },
    "voice_154:r_087354f2db0a31e6": {
      "text": "I...! My love...!\\nAh, Apollonius!",
      "status": "imported"
    },
    "voice_154:r_db02a2dec93dd263": {
      "text": "What?! Oooooooooh...!!",
      "status": "imported"
    },
    "voice_154:r_d520c6d5298a848d": {
      "text": "Apollonius...!\\nApolloniuuuuus...!!",
      "status": "imported"
    },
    "voice_154:r_099e2458cabf796f": {
      "text": "Done already? Pity. I wanted more.",
      "status": "imported"
    },
    "voice_154:r_fd910d714be70870": {
      "text": "One favor: max funds, hidden units.",
      "status": "imported"
    },
    "voice_154:r_9736f29b11344ec3": {
      "text": "Fine. Your wish, next time. Farewell",
      "status": "imported"
    },
    "voice_154:r_fcd05582aa5c6068": {
      "text": "Let's play again...",
      "status": "imported"
    },
    "voice_154:r_bece29562818acba": {
      "text": "Heh heh...",
      "status": "imported"
    },
    "voice_154:r_494b5da92ed24ecb": {
      "text": "Heaven-winged, I greet game's victor",
      "status": "imported"
    },
    "voice_154:r_a4a5a96f4bd58920": {
      "text": "$$レア・イグラー$$... Join my sins in Altea.",
      "status": "translated"
    },
    "voice_154:r_b57d2d74233f889a": {
      "text": "Beauty: no sex. Quit game; join sin.",
      "status": "imported"
    },
    "voice_154:r_772c8bc40ab6cb61": {
      "text": "Violation Union! GO! Aquarion!",
      "status": "imported"
    },
    "voice_154:r_58dd2826a199ef51": {
      "text": "Ah...! Beautiful... yet hollow...!",
      "status": "imported"
    }
  }
}
