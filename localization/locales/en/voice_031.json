{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_031:r_479b340ccc6c572b": {
      "text": "Andy W. Hole, moving out!",
      "status": "imported"
    },
    "voice_031:r_ca4acbac57a2a35e": {
      "text": "All right! It's my turn!",
      "status": "imported"
    },
    "voice_031:r_77949221bf58f862": {
      "text": "Time to impress the girls!",
      "status": "imported"
    },
    "voice_031:r_70b9c4b9f1f37eff": {
      "text": "I'll dig the hole you fall into!",
      "status": "imported"
    },
    "voice_031:r_9fcb3754cb1773c7": {
      "text": "A man takes his foes head-on!",
      "status": "imported"
    },
    "voice_031:r_3559d2fad32c2435": {
      "text": "I'm fired up! Let's go!",
      "status": "imported"
    },
    "voice_031:r_f7570547e9f80a64": {
      "text": "I'll finish this in style!",
      "status": "imported"
    },
    "voice_031:r_cbab0f4720e1fcf1": {
      "text": "Here it is! My time to shine!",
      "status": "imported"
    },
    "voice_031:r_0bbe0b4f5364e732": {
      "text": "Andy! Enemy in range!",
      "status": "imported"
    },
    "voice_031:r_5dda5198137cb02a": {
      "text": "All right! Watch me in action!",
      "status": "imported"
    },
    "voice_031:r_83ec59afbecdec14": {
      "text": "Amata! Show our digger duo's might!",
      "status": "imported"
    },
    "voice_031:r_e20bfd42ad95a3c9": {
      "text": "Got it, Andy!",
      "status": "imported"
    },
    "voice_031:r_0f58a8822381e57f": {
      "text": "I'm counting on you, Andy!",
      "status": "imported"
    },
    "voice_031:r_6dbcc507fb61b51d": {
      "text": "Okay, Zessica! Leave it to me!",
      "status": "imported"
    },
    "voice_031:r_b42ab697149a7c8a": {
      "text": "Shrade! Lend me your strength!",
      "status": "imported"
    },
    "voice_031:r_4de4fcf3b440baf4": {
      "text": "With you,\\na fine appassionato.",
      "status": "imported"
    },
    "voice_031:r_0121a166c715cdff": {
      "text": "MIX!\\nShow them our strongest combo!",
      "status": "imported"
    },
    "voice_031:r_30fad37a42bd3ad3": {
      "text": "You and who are the strongest?!",
      "status": "imported"
    },
    "voice_031:r_80a0b2a84e05d81a": {
      "text": "MIX, let's go! Lend me your power!",
      "status": "imported"
    },
    "voice_031:r_4a9ac1dff86506d9": {
      "text": "Andy! I give you my everything!",
      "status": "imported"
    },
    "voice_031:r_bc8538e6af3d2577": {
      "text": "Yunoha! Let's give it our all!",
      "status": "imported"
    },
    "voice_031:r_924516c8de2b5342": {
      "text": "Y-yes! I'll do my very best!",
      "status": "imported"
    },
    "voice_031:r_da1174533722333f": {
      "text": "Sazanka! Watch me in action!",
      "status": "imported"
    },
    "voice_031:r_fdeb8162976e72c1": {
      "text": "Ew! Andy doesn't do it for me!",
      "status": "imported"
    },
    "voice_031:r_0fadb5c26df92b42": {
      "text": "Director! I'll show you my power!",
      "status": "imported"
    },
    "voice_031:r_6b15af9a0057cdc8": {
      "text": "Careful not to dig your own grave.",
      "status": "imported"
    },
    "voice_031:r_15b4a90140e8a33a": {
      "text": "Andy, I won't tolerate mistakes!",
      "status": "imported"
    },
    "voice_031:r_af884a6b11dff121": {
      "text": "MIX, you can fill in my hole!",
      "status": "imported"
    },
    "voice_031:r_ac6fe7838e95647b": {
      "text": "Too slow! Here comes another hit!",
      "status": "imported"
    },
    "voice_031:r_77ca87eacd17ad52": {
      "text": "One more for good measure!!",
      "status": "imported"
    },
    "voice_031:r_bf3244994760e535": {
      "text": "You animal! I'm your opponent!",
      "status": "imported"
    },
    "voice_031:r_aabfb21c9d069ce7": {
      "text": "The wolf hunting Red?\\nI'll slay it!",
      "status": "imported"
    },
    "voice_031:r_02479dc8fe989560": {
      "text": "Your pickup act's way too pushy!",
      "status": "imported"
    },
    "voice_031:r_a2df00f91a9b0a9e": {
      "text": "I won't let you hurt any girl!",
      "status": "imported"
    },
    "voice_031:r_48b60d6c48b9b142": {
      "text": "The boss himself?\\nI'll take you on!",
      "status": "imported"
    },
    "voice_031:r_665f01666859013b": {
      "text": "No more taking rejection\\nout on us!",
      "status": "imported"
    },
    "voice_031:r_a571eec59b258d11": {
      "text": "End the world over heartbreak?\\nMad!",
      "status": "imported"
    },
    "voice_031:r_ddbe581c5ea9183d": {
      "text": "MIX! Have you forgotten us?!",
      "status": "imported"
    },
    "voice_031:r_faae935cca0edc72": {
      "text": "Remember, MIX! It's me!\\nIt's Andy!",
      "status": "imported"
    },
    "voice_031:r_d4430bf362340b32": {
      "text": "MIX! I'll be the one to stop you!",
      "status": "imported"
    },
    "voice_031:r_6ff1323b355593e0": {
      "text": "Amata! Sorry, but I'm gonna win!",
      "status": "imported"
    },
    "voice_031:r_b7b5625d7cd4282f": {
      "text": "Big bro can't\\nlose to little bro!",
      "status": "imported"
    },
    "voice_031:r_36133ad73a73ef98": {
      "text": "A Gepard showdown! Victory is mine!",
      "status": "imported"
    },
    "voice_031:r_920740a0219c5085": {
      "text": "Swords and projectiles favor me!",
      "status": "imported"
    },
    "voice_031:r_a8451712c57c1a72": {
      "text": "Quit darting around so much!",
      "status": "imported"
    },
    "voice_031:r_3633df5b7b8f47fa": {
      "text": "Damn it!\\nYou move way too fast!",
      "status": "imported"
    },
    "voice_031:r_52dfc56b14b93551": {
      "text": "A Gundam foe?\\nNow I'm fired up!",
      "status": "imported"
    },
    "voice_031:r_1b9b2aab5cb104da": {
      "text": "You started it!\\nDon't blame me!",
      "status": "imported"
    },
    "voice_031:r_342044c706a2340f": {
      "text": "Like I'd lose to some junk machine!",
      "status": "imported"
    },
    "voice_031:r_cf41e8828a90cbdb": {
      "text": "I'll knock you clear off Earth!",
      "status": "imported"
    },
    "voice_031:r_719e897304ec42d4": {
      "text": "I show monsters no mercy!",
      "status": "imported"
    },
    "voice_031:r_d5e0a2317c40d322": {
      "text": "Who are you?\\nI'll knock you down!",
      "status": "imported"
    },
    "voice_031:r_ec2ea17765052401": {
      "text": "Beat us first,\\nor leave Earth alone!",
      "status": "imported"
    },
    "voice_031:r_5d08ad19e2da125b": {
      "text": "No drill,\\nbut I'll die for digging!",
      "status": "imported"
    },
    "voice_031:r_a7246b52782a877e": {
      "text": "No choice!\\nI'll stop that machine!",
      "status": "imported"
    },
    "voice_031:r_dc8701f6bcb9904f": {
      "text": "I'll stop that machine by force!",
      "status": "imported"
    },
    "voice_031:r_d6bdd730f24f66eb": {
      "text": "Girl or not, I won't go easy on you!",
      "status": "imported"
    },
    "voice_031:r_41997412868c48c4": {
      "text": "Leave the girl to me!",
      "status": "imported"
    },
    "voice_031:r_9e6cf4f389dae55c": {
      "text": "War? There's\\nmore fun than that...!",
      "status": "imported"
    },
    "voice_031:r_7432ef43ed3471dc": {
      "text": "Selfish jerks don't get the girls!",
      "status": "imported"
    },
    "voice_031:r_065443f6ddfcf0d7": {
      "text": "Stupid excuses?\\nI've heard enough!",
      "status": "imported"
    },
    "voice_031:r_47d52a2839c71715": {
      "text": "I'll beat you,\\nthen end this battle!",
      "status": "imported"
    },
    "voice_031:r_55417493fce1d347": {
      "text": "Don't think\\nyou'll get your way!",
      "status": "imported"
    },
    "voice_031:r_8fdf5910927c9591": {
      "text": "Sorry,\\nEarthlings aren't fools!",
      "status": "imported"
    },
    "voice_031:r_24cf161287ef9d5c": {
      "text": "I'll blast you full of holes!",
      "status": "imported"
    },
    "voice_031:r_8f60f6fc86db3107": {
      "text": "I'll blow a hole through you!",
      "status": "imported"
    },
    "voice_031:r_b1de76a75a253c13": {
      "text": "Take that! Take that! Take that!",
      "status": "imported"
    },
    "voice_031:r_128c35bf3e0e394c": {
      "text": "Direct hit! Got you!",
      "status": "imported"
    },
    "voice_031:r_5213c17e13b23de0": {
      "text": "Eat this Missile barrage!",
      "status": "imported"
    },
    "voice_031:r_38fdff9483e9245c": {
      "text": "Take every last round!",
      "status": "imported"
    },
    "voice_031:r_620fedec67706d7d": {
      "text": "Here comes a hail of Missile fire!",
      "status": "imported"
    },
    "voice_031:r_9680dcd0fddcfcc7": {
      "text": "This one means bye-bye...!",
      "status": "imported"
    },
    "voice_031:r_2a00f1044ad5cbaa": {
      "text": "Missile! Gooooo!!",
      "status": "imported"
    },
    "voice_031:r_3dbeead1bd3164ef": {
      "text": "Here's an extra-large helping!",
      "status": "imported"
    },
    "voice_031:r_98d15b8cc09bc915": {
      "text": "Eat this! Bye-Bye Missile!",
      "status": "imported"
    },
    "voice_031:r_46e86d000250e137": {
      "text": "Enough Missile fire, and one'll hit!",
      "status": "imported"
    },
    "voice_031:r_ac341e7976e88f0b": {
      "text": "This is... the eeeend!!",
      "status": "imported"
    },
    "voice_031:r_cdbd128a5b4127cc": {
      "text": "I'll give it all to dig this hole!",
      "status": "imported"
    },
    "voice_031:r_cfccaa1fbeda124c": {
      "text": "Let's do this, Gepard!",
      "status": "imported"
    },
    "voice_031:r_b1f8ec192b9c083a": {
      "text": "Raaaaagh!!",
      "status": "imported"
    },
    "voice_031:r_a007f9ab9cf048b3": {
      "text": "Punch straight throoooough!!",
      "status": "imported"
    },
    "voice_031:r_ddafde4b065ced49": {
      "text": "I... will dig a hole!",
      "status": "imported"
    },
    "voice_031:r_de1213040856c089": {
      "text": "Everyone, lend me your strength!",
      "status": "imported"
    },
    "voice_031:r_3304412ac41f47a6": {
      "text": "Dimension Tunnel Shell!",
      "status": "imported"
    },
    "voice_031:r_0c0775e051211840": {
      "text": "Goooooo!!",
      "status": "imported"
    },
    "voice_031:r_a2afffe1c396f0b3": {
      "text": "Hit me and I'll hit back!",
      "status": "imported"
    },
    "voice_031:r_13c25fbdfddc8a24": {
      "text": "Payback time! Don't move!",
      "status": "imported"
    },
    "voice_031:r_42ba1ecb310b4bd7": {
      "text": "A man never leaves a hit unanswered!",
      "status": "imported"
    },
    "voice_031:r_d692f1d420460a47": {
      "text": "This time, I'm coming at you!",
      "status": "imported"
    },
    "voice_031:r_a5643cec86b18bd2": {
      "text": "Here's your change! Keep it!",
      "status": "imported"
    },
    "voice_031:r_68f2dfab20a4a30e": {
      "text": "For payback, I'll dig your grave!",
      "status": "imported"
    },
    "voice_031:r_9cedad8237480563": {
      "text": "Let me have a turn!",
      "status": "imported"
    },
    "voice_031:r_a03fabecba1508ca": {
      "text": "Now the real star takes the stage!",
      "status": "imported"
    },
    "voice_031:r_5391b24a71eb10ae": {
      "text": "Let's go! Digger combo attack!",
      "status": "imported"
    },
    "voice_031:r_a554ceef5c87b972": {
      "text": "Let's dig a huge hole together!",
      "status": "imported"
    },
    "voice_031:r_546c3d5937fbb7ee": {
      "text": "I've got this! Back up, back up!",
      "status": "imported"
    },
    "voice_031:r_1568ff6298b12b96": {
      "text": "Nobody messes with my friends!",
      "status": "imported"
    },
    "voice_031:r_2c9d94ba13c5fc50": {
      "text": "Gentleman Andy takes the stage!",
      "status": "imported"
    },
    "voice_031:r_428c2116ac3071b1": {
      "text": "I'll protect my fellow diggers!",
      "status": "imported"
    },
    "voice_031:r_84c116267b79f540": {
      "text": "We diggers stake our lives on it!",
      "status": "imported"
    },
    "voice_031:r_dad38ee29af2df3a": {
      "text": "Seriously?! I can't counterattack!",
      "status": "imported"
    },
    "voice_031:r_3d32e86f8dc80909": {
      "text": "H-hey!\\nWe'll just get pummeled!",
      "status": "imported"
    },
    "voice_031:r_70451ffbabe2f876": {
      "text": "No way! Even Gepard can't reach?!",
      "status": "imported"
    },
    "voice_031:r_69dfa1659715e2fa": {
      "text": "Damn!\\nThey know our range!",
      "status": "imported"
    },
    "voice_031:r_d996fd6d4ef5b329": {
      "text": "Like that'll hit me!",
      "status": "imported"
    },
    "voice_031:r_8ab47a28f99ef565": {
      "text": "Whoa! Too bad!",
      "status": "imported"
    },
    "voice_031:r_546de3fb6db156ea": {
      "text": "Where the hell are you looking?!",
      "status": "imported"
    },
    "voice_031:r_ca85f87cee5e31f7": {
      "text": "That was nothing! Nothing!",
      "status": "imported"
    },
    "voice_031:r_9072ea7bc71df136": {
      "text": "A miss! Come back and try again!",
      "status": "imported"
    },
    "voice_031:r_04e815a8d425827d": {
      "text": "See that? That's my technique!",
      "status": "imported"
    },
    "voice_031:r_d89011fe3e5d082a": {
      "text": "What's wrong, beast? Is that all?!",
      "status": "imported"
    },
    "voice_031:r_3c5b0c2ac812d5de": {
      "text": "Force women to submit?\\nI won't lose!",
      "status": "imported"
    },
    "voice_031:r_5b9e8897190892eb": {
      "text": "Witness the great Andy's true skill!",
      "status": "imported"
    },
    "voice_031:r_7bea3023abbf8a94": {
      "text": "Show off and you'll get hurt.",
      "status": "imported"
    },
    "voice_031:r_dd01a4c0d1b36a8d": {
      "text": "Nice one, Andy!",
      "status": "imported"
    },
    "voice_031:r_20920ad2eb3542db": {
      "text": "I'm the proud eldest digger brother!",
      "status": "imported"
    },
    "voice_031:r_0ab7914877fd48ed": {
      "text": "Well, Zessica? Falling for me?",
      "status": "imported"
    },
    "voice_031:r_cb846feec748c2e3": {
      "text": "Your face is the only joke here.",
      "status": "imported"
    },
    "voice_031:r_c958860b0676b1f5": {
      "text": "That's a fine forte. Very you, Andy.",
      "status": "imported"
    },
    "voice_031:r_5e2669b82ef75ce3": {
      "text": "Thanks for the compliment!",
      "status": "imported"
    },
    "voice_031:r_7847e0ed7dc9282d": {
      "text": "Well, MIX? See what I can do?!",
      "status": "imported"
    },
    "voice_031:r_e42b52c7a987b906": {
      "text": "Don't celebrate every lucky hit!",
      "status": "imported"
    },
    "voice_031:r_6825fd1ff907bd22": {
      "text": "Not bad, Andy!",
      "status": "imported"
    },
    "voice_031:r_607f666f1563bc0d": {
      "text": "Heh-heh! Pure skill, pure skill!",
      "status": "imported"
    },
    "voice_031:r_97b7431eeb81e6b6": {
      "text": "Andy, evasion successful!",
      "status": "imported"
    },
    "voice_031:r_132f605d02975e71": {
      "text": "Well... naturally.",
      "status": "imported"
    },
    "voice_031:r_9b9726b1872759d6": {
      "text": "Sazanka! Behold my gallant figure!",
      "status": "imported"
    },
    "voice_031:r_1252db29683fefe0": {
      "text": "Andy just doesn't excite me...",
      "status": "imported"
    },
    "voice_031:r_ad3d538f1e909184": {
      "text": "Good moves, Andy W. Hole.",
      "status": "imported"
    },
    "voice_031:r_8c61c59a1c0aebbf": {
      "text": "That was a piece of cake!",
      "status": "imported"
    },
    "voice_031:r_c8c59db85bf875e6": {
      "text": "Useless, useless, useleeeess!",
      "status": "imported"
    },
    "voice_031:r_7c796ba53bd7ea03": {
      "text": "Too bad! I've got a barrier!",
      "status": "imported"
    },
    "voice_031:r_fa944da4b6519006": {
      "text": "Whoa! Thank goodness for barriers!",
      "status": "imported"
    },
    "voice_031:r_95d047bcc17fccc6": {
      "text": "Whoa! That actually hit me!",
      "status": "imported"
    },
    "voice_031:r_640327a12a559b31": {
      "text": "I blew it! I need a hole to hide in!",
      "status": "imported"
    },
    "voice_031:r_bdd38c584fa313d0": {
      "text": "Crap... I got too cocky!",
      "status": "imported"
    },
    "voice_031:r_3fd86c1027f317c8": {
      "text": "Don't take Gepard's armor lightly!",
      "status": "imported"
    },
    "voice_031:r_d0372a183d2007ad": {
      "text": "This scratch isn't even a hole!",
      "status": "imported"
    },
    "voice_031:r_217aa5e1d545b44d": {
      "text": "Hey, hey! Take this more seriously!",
      "status": "imported"
    },
    "voice_031:r_381992c5d8224937": {
      "text": "You got hit, Andy!",
      "status": "imported"
    },
    "voice_031:r_f1e7ed9e5874aba5": {
      "text": "Don't sweat it! It's just a massage!",
      "status": "imported"
    },
    "voice_031:r_fc25e66a86fc2c85": {
      "text": "Oops, the brakes didn't work!",
      "status": "imported"
    },
    "voice_031:r_5aeeb4917340c42d": {
      "text": "I told you not to drop your guard!",
      "status": "imported"
    },
    "voice_031:r_b765659981b6516d": {
      "text": "Take this seriously, Andy!",
      "status": "imported"
    },
    "voice_031:r_0c427458bc00eb95": {
      "text": "Sorry! I fooled around too much!",
      "status": "imported"
    },
    "voice_031:r_774a9ab4d8fd5351": {
      "text": "Your moves are utterly capriccioso.",
      "status": "imported"
    },
    "voice_031:r_d3f01de714c015bd": {
      "text": "Don't get it, but I'll be careful!",
      "status": "imported"
    },
    "voice_031:r_7d2617c809fead70": {
      "text": "Sorry, MIX! Fill in the hole!",
      "status": "imported"
    },
    "voice_031:r_ceb935ccbf830724": {
      "text": "Why should I clean up your mess...!",
      "status": "imported"
    },
    "voice_031:r_862ef7385bf2abd4": {
      "text": "Hey!\\nGet a grip, Andy!",
      "status": "imported"
    },
    "voice_031:r_001cbec4d9a4283f": {
      "text": "Thanks, MIX! Now I'm fired up!",
      "status": "imported"
    },
    "voice_031:r_8ad40afecd02b41e": {
      "text": "Sorry, Yunoha! I got hit!",
      "status": "imported"
    },
    "voice_031:r_26e5efec03c03d78": {
      "text": "I'm fine,\\nso don't worry!",
      "status": "imported"
    },
    "voice_031:r_4ad81e88c7557a8b": {
      "text": "What are you doing, Andy?!",
      "status": "imported"
    },
    "voice_031:r_1f65a7af190e4674": {
      "text": "Shut it! My hand just slipped!",
      "status": "imported"
    },
    "voice_031:r_40c5a9358ed5bf29": {
      "text": "Andy W. Hole,\\nis that your best?",
      "status": "imported"
    },
    "voice_031:r_f2e18dfdfe0c89ea": {
      "text": "No way!\\nI'll dodge next time!",
      "status": "imported"
    },
    "voice_031:r_cf7dbf49e96a5755": {
      "text": "You bastard! You really got me!",
      "status": "imported"
    },
    "voice_031:r_fa96676cc65bb509": {
      "text": "Ow! It's packing serious power...!",
      "status": "imported"
    },
    "voice_031:r_4e37f92e7d2fc62e": {
      "text": "Odd...\\nI know I dodged it.",
      "status": "imported"
    },
    "voice_031:r_66ab4cfe1557909d": {
      "text": "Yikes! That one's strong!",
      "status": "imported"
    },
    "voice_031:r_0bad405ee6ca63ba": {
      "text": "Ugh! I took that one head-on!",
      "status": "imported"
    },
    "voice_031:r_2072eaf71a260ae7": {
      "text": "Gah!\\nThey found my weak spot!",
      "status": "imported"
    },
    "voice_031:r_6c13bbfd27a7799e": {
      "text": "You beast! Better than I thought!",
      "status": "imported"
    },
    "voice_031:r_06f88dcbd3c9e738": {
      "text": "Damn!\\nThis stray dog's tough!",
      "status": "imported"
    },
    "voice_031:r_b28faf9f71bc3598": {
      "text": "Damn it! How dare you pull that!",
      "status": "imported"
    },
    "voice_031:r_8a29278549f8e07a": {
      "text": "Andy! Being fired up isn't enough!",
      "status": "imported"
    },
    "voice_031:r_7e6c573c26177f98": {
      "text": "Andy! Watch the enemy more closely!",
      "status": "imported"
    },
    "voice_031:r_45abf84f7757d6eb": {
      "text": "You don't need to tell me! I am!",
      "status": "imported"
    },
    "voice_031:r_edd7a13ab8f06a14": {
      "text": "What's this?\\nDid they use magic?!",
      "status": "imported"
    },
    "voice_031:r_8165e5b41f0124c4": {
      "text": "Admit your own mistake!",
      "status": "imported"
    },
    "voice_031:r_4e05581b7432cce8": {
      "text": "Andy?\\nIs that your whole melody?",
      "status": "imported"
    },
    "voice_031:r_a60b107ea3c36a86": {
      "text": "No jokes!\\nMy show starts now!",
      "status": "imported"
    },
    "voice_031:r_e33693e5ba4665b0": {
      "text": "Gah! MIX, are you all right?!",
      "status": "imported"
    },
    "voice_031:r_72a21a1a489af001": {
      "text": "Forget about me and focus!",
      "status": "imported"
    },
    "voice_031:r_eb643f8bf737a0ca": {
      "text": "Are you all right, Andy?!",
      "status": "imported"
    },
    "voice_031:r_0a3fccb71ec6cf2a": {
      "text": "Don't worry! My guts are bottomless!",
      "status": "imported"
    },
    "voice_031:r_9b63cf1f3e0207ef": {
      "text": "Andy,\\nyou've taken heavy damage!",
      "status": "imported"
    },
    "voice_031:r_8356f4e3dcdff938": {
      "text": "Sorry, Yunoha!\\nThey won't do more!",
      "status": "imported"
    },
    "voice_031:r_1d6d784036ae0bd7": {
      "text": "Hey, Andy!\\nGepard's full of holes!",
      "status": "imported"
    },
    "voice_031:r_625664af02183c17": {
      "text": "Damn!\\nI hate being full of holes!",
      "status": "imported"
    },
    "voice_031:r_3701cba361f80ea5": {
      "text": "Sorry, Director!\\nI'll pull through!",
      "status": "imported"
    },
    "voice_031:r_63f429c5c68c0863": {
      "text": "I believe in you, Andy W. Hole.",
      "status": "imported"
    },
    "voice_031:r_4824bea6bab3af67": {
      "text": "Gwaah! Right where it hurts!",
      "status": "imported"
    },
    "voice_031:r_862b92e63adb9734": {
      "text": "W-wait! Wait, I said!",
      "status": "imported"
    },
    "voice_031:r_cb306ef55e49d107": {
      "text": "Damn!\\nThis is no ordinary foe!",
      "status": "imported"
    },
    "voice_031:r_57b2bd2de8a1408d": {
      "text": "Just hold on a bit longer, Gepard!",
      "status": "imported"
    },
    "voice_031:r_76f080a4881e8ab5": {
      "text": "Damn it!\\nI won't dig my own grave!",
      "status": "imported"
    },
    "voice_031:r_288133bc5b573dae": {
      "text": "Bastard!\\nI'll risk my life!",
      "status": "imported"
    },
    "voice_031:r_6f95653e548f8fcf": {
      "text": "Andy! You can't take any more!",
      "status": "imported"
    },
    "voice_031:r_d249d68bada91ab9": {
      "text": "I know! I'll finish it next time!",
      "status": "imported"
    },
    "voice_031:r_e9b3307e9eb69f11": {
      "text": "Amata...!\\nRisk your life too!",
      "status": "imported"
    },
    "voice_031:r_03cdac73042343ee": {
      "text": "I'm ready! Let's do this!",
      "status": "imported"
    },
    "voice_031:r_6026da5acbda7c69": {
      "text": "Andy! We need to retreat!",
      "status": "imported"
    },
    "voice_031:r_981f8fedd5414fe5": {
      "text": "No!\\nMen don't know 'retreat'!",
      "status": "imported"
    },
    "voice_031:r_96bb0dcde0c8c44a": {
      "text": "Shrade, are you alive?!",
      "status": "imported"
    },
    "voice_031:r_641550a2f54cb456": {
      "text": "Till I find my opus,\\nI won't die.",
      "status": "imported"
    },
    "voice_031:r_a0f2074af8debbfa": {
      "text": "Are you okay, MIX?! MIX?!",
      "status": "imported"
    },
    "voice_031:r_b5f5a97ed82acb0b": {
      "text": "I-I'm fine...!\\nFix this situation!",
      "status": "imported"
    },
    "voice_031:r_d9cd2e4ded064396": {
      "text": "Andy! Get a grip! Andy!",
      "status": "imported"
    },
    "voice_031:r_99e6349431aaf23b": {
      "text": "I'm fine!\\nWith you, I can't lose!",
      "status": "imported"
    },
    "voice_031:r_ec1081caf845f56a": {
      "text": "Yunoha! Can you still fight?!",
      "status": "imported"
    },
    "voice_031:r_2c5b7ee872c1ed7f": {
      "text": "Y-yes! I'll fight to the very end!",
      "status": "imported"
    },
    "voice_031:r_76d1e51c8b494a60": {
      "text": "N-no! I don't want to die yet!",
      "status": "imported"
    },
    "voice_031:r_eb5f687fcd372ae7": {
      "text": "I'm fine, Sazanka! I feel the same!",
      "status": "imported"
    },
    "voice_031:r_2329428a6871d9fa": {
      "text": "Andy W. Hole,\\ndon't give up now!",
      "status": "imported"
    },
    "voice_031:r_0e7466971bec4cc4": {
      "text": "Understood! Full power to the end!",
      "status": "imported"
    },
    "voice_031:r_efa71f7a4cc33ff3": {
      "text": "Daaamn!\\nDid they get me?!",
      "status": "imported"
    },
    "voice_031:r_3fc2e1186557e7a0": {
      "text": "Raaaagh!\\nI have to eject!",
      "status": "imported"
    },
    "voice_031:r_fa6930340a545054": {
      "text": "Nice work! Let's go relax together!",
      "status": "imported"
    },
    "voice_031:r_2332b9d56461d7ab": {
      "text": "A man's soul is destined to... dig!",
      "status": "imported"
    },
    "voice_031:r_854aa0a91a3c80d1": {
      "text": "Don't go killing me without asking!",
      "status": "imported"
    },
    "voice_031:r_1ff312798a52c8eb": {
      "text": "MIX!",
      "status": "imported"
    },
    "voice_031:r_fa07d90fca62f593": {
      "text": "I want to fill in your hole!",
      "status": "imported"
    },
    "voice_031:r_a25bf2676ecf9d83": {
      "text": "A hole...\\nis made to connect worlds!",
      "status": "imported"
    },
    "voice_031:r_237a0288b42dce20": {
      "text": "I'll link our worlds\\nat any cost!",
      "status": "imported"
    },
    "voice_031:r_0556e8a22779ea8e": {
      "text": "I'll put a huge hole in your heart!",
      "status": "imported"
    },
    "voice_031:r_09d377101a48d92a": {
      "text": "One big enough to bury me in!",
      "status": "imported"
    },
    "voice_031:r_11517cc7b0494dbf": {
      "text": "Raaaaaaagh!",
      "status": "imported"
    },
    "voice_031:r_b5864501463db244": {
      "text": "This time, I'm sticking to support!",
      "status": "imported"
    },
    "voice_031:r_a88939ea84b4474d": {
      "text": "No complaints if I finish them off!",
      "status": "imported"
    },
    "voice_031:r_a870d0cf7cc11ec6": {
      "text": "I'll nip their charge in the bud!",
      "status": "imported"
    },
    "voice_031:r_03f6158ef83964f3": {
      "text": "Just this once, you can finish them!",
      "status": "imported"
    },
    "voice_031:r_2970a83693cdcc25": {
      "text": "Come on! I'm your opponent!",
      "status": "imported"
    },
    "voice_031:r_be661448b85d0009": {
      "text": "Too bad!\\nThe great Andy's your foe!",
      "status": "imported"
    },
    "voice_031:r_958a56c1151cab9e": {
      "text": "I've got this side! You've got that!",
      "status": "imported"
    },
    "voice_031:r_8b18aa4cc69547df": {
      "text": "Let's enjoy our date!",
      "status": "imported"
    }
  }
}
