{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_203:r_479b340ccc6c572b": {
      "text": "Leave this to me!",
      "status": "imported"
    },
    "voice_203:r_ca4acbac57a2a35e": {
      "text": "I'll scatter them!",
      "status": "imported"
    },
    "voice_203:r_77949221bf58f862": {
      "text": "Why don't you settle down!",
      "status": "imported"
    },
    "voice_203:r_70b9c4b9f1f37eff": {
      "text": "Feel Shin Getter 3's power!",
      "status": "imported"
    },
    "voice_203:r_9fcb3754cb1773c7": {
      "text": "Quit stalling!\\nFinish them already!",
      "status": "imported"
    },
    "voice_203:r_3559d2fad32c2435": {
      "text": "Jeez, still as hotheaded as ever!",
      "status": "imported"
    },
    "voice_203:r_f7570547e9f80a64": {
      "text": "Let's show them Getter's power!",
      "status": "imported"
    },
    "voice_203:r_cbab0f4720e1fcf1": {
      "text": "Don't hold back! Smash them flat!",
      "status": "imported"
    },
    "voice_203:r_0bbe0b4f5364e732": {
      "text": "Benkei! Make sure you finish them!",
      "status": "imported"
    },
    "voice_203:r_5dda5198137cb02a": {
      "text": "You got it! Leave it to me!",
      "status": "imported"
    },
    "voice_203:r_83ec59afbecdec14": {
      "text": "I'm counting on your vaunted power!",
      "status": "imported"
    },
    "voice_203:r_e20bfd42ad95a3c9": {
      "text": "If you insist,\\nI'll give it my all!",
      "status": "imported"
    },
    "voice_203:r_0f58a8822381e57f": {
      "text": "No time to drag your feet!",
      "status": "imported"
    },
    "voice_203:r_6dbcc507fb61b51d": {
      "text": "Benkei! Smash them in one blow!",
      "status": "imported"
    },
    "voice_203:r_b42ab697149a7c8a": {
      "text": "All right! Full power ahead!",
      "status": "imported"
    },
    "voice_203:r_4de4fcf3b440baf4": {
      "text": "Listen, Ryoma, Hayato! Stay sharp!",
      "status": "imported"
    },
    "voice_203:r_0121a166c715cdff": {
      "text": "Yeah!",
      "status": "imported"
    },
    "voice_203:r_30fad37a42bd3ad3": {
      "text": "All right! One more blow!",
      "status": "imported"
    },
    "voice_203:r_80a0b2a84e05d81a": {
      "text": "Prepare yourself, Invader!",
      "status": "imported"
    },
    "voice_203:r_4a9ac1dff86506d9": {
      "text": "We stand!\\nNo Invader runs free!",
      "status": "imported"
    },
    "voice_203:r_bc8538e6af3d2577": {
      "text": "Mechanical Beast!\\nPower contest!",
      "status": "imported"
    },
    "voice_203:r_924516c8de2b5342": {
      "text": "Skip the grunts!\\nThe big one's mine!",
      "status": "imported"
    },
    "voice_203:r_da1174533722333f": {
      "text": "It's only fast!\\nCatch it and we win!",
      "status": "imported"
    },
    "voice_203:r_fdeb8162976e72c1": {
      "text": "Yeah! I won't miss one opening!",
      "status": "imported"
    },
    "voice_203:r_0fadb5c26df92b42": {
      "text": "Enemy's in the air! Benkei, switch!",
      "status": "imported"
    },
    "voice_203:r_6b15af9a0057cdc8": {
      "text": "The thought's all I'll take!",
      "status": "imported"
    },
    "voice_203:r_15b4a90140e8a33a": {
      "text": "Benkei! Underwater is all yours!",
      "status": "imported"
    },
    "voice_203:r_af884a6b11dff121": {
      "text": "You got it!",
      "status": "imported"
    },
    "voice_203:r_ac6fe7838e95647b": {
      "text": "So they're behind all this...!",
      "status": "imported"
    },
    "voice_203:r_77ca87eacd17ad52": {
      "text": "Time to settle this!",
      "status": "imported"
    },
    "voice_203:r_bf3244994760e535": {
      "text": "Let's go!\\nWe'll end this ourselves!",
      "status": "imported"
    },
    "voice_203:r_aabfb21c9d069ce7": {
      "text": "I'll pound them with all I've got!",
      "status": "imported"
    },
    "voice_203:r_02479dc8fe989560": {
      "text": "Hammaaaaaar! Puuuunch!",
      "status": "imported"
    },
    "voice_203:r_a2df00f91a9b0a9e": {
      "text": "Don't hold back! Take all of this!",
      "status": "imported"
    },
    "voice_203:r_48b60d6c48b9b142": {
      "text": "Missile Storm!",
      "status": "imported"
    },
    "voice_203:r_8927e6fb681aa809": {
      "text": "Homing Missile!",
      "status": "imported"
    },
    "voice_203:r_665f01666859013b": {
      "text": "All riiight!",
      "status": "imported"
    },
    "voice_203:r_a571eec59b258d11": {
      "text": "Time for my ace in the hole!",
      "status": "imported"
    },
    "voice_203:r_ddbe581c5ea9183d": {
      "text": "Daisetsuzan Oroshi!!",
      "status": "imported"
    },
    "voice_203:r_faae935cca0edc72": {
      "text": "Mentor, watch me!",
      "status": "imported"
    },
    "voice_203:r_d4430bf362340b32": {
      "text": "Secret Art! Daisetsuzan Oroshi!",
      "status": "imported"
    },
    "voice_203:r_6ff1323b355593e0": {
      "text": "Hrrrrrngh!",
      "status": "imported"
    },
    "voice_203:r_b7b5625d7cd4282f": {
      "text": "Daisetsuzan Oroshi! Raaagh!",
      "status": "imported"
    },
    "voice_203:r_24cf161287ef9d5c": {
      "text": "You got me, so now I'll hit back!",
      "status": "imported"
    },
    "voice_203:r_8f60f6fc86db3107": {
      "text": "Attack carelessly and this happens!",
      "status": "imported"
    },
    "voice_203:r_b1de76a75a253c13": {
      "text": "Hit the enemy while you still can!",
      "status": "imported"
    },
    "voice_203:r_128c35bf3e0e394c": {
      "text": "Gotta set an example for Kei's gang!",
      "status": "imported"
    },
    "voice_203:r_5213c17e13b23de0": {
      "text": "No choice! I'll be your shield!",
      "status": "imported"
    },
    "voice_203:r_38fdff9483e9245c": {
      "text": "Shielding the youngsters is our job!",
      "status": "imported"
    },
    "voice_203:r_620fedec67706d7d": {
      "text": "Pathetic! I can't hit back here!",
      "status": "imported"
    },
    "voice_203:r_9680dcd0fddcfcc7": {
      "text": "Damn! We're out of energy...!?",
      "status": "imported"
    },
    "voice_203:r_2a00f1044ad5cbaa": {
      "text": "They attacked from way over there!?",
      "status": "imported"
    },
    "voice_203:r_3dbeead1bd3164ef": {
      "text": "Useless!",
      "status": "imported"
    },
    "voice_203:r_46e86d000250e137": {
      "text": "What's wrong? We're right here!",
      "status": "imported"
    },
    "voice_203:r_ac341e7976e88f0b": {
      "text": "I won't fall for that trick!",
      "status": "imported"
    },
    "voice_203:r_cdbd128a5b4127cc": {
      "text": "Don't get carried away, Invaders!",
      "status": "imported"
    },
    "voice_203:r_cfccaa1fbeda124c": {
      "text": "Such a stupid attack won't hit us!",
      "status": "imported"
    },
    "voice_203:r_b1f8ec192b9c083a": {
      "text": "If you wanna kill us, get serious!",
      "status": "imported"
    },
    "voice_203:r_a007f9ab9cf048b3": {
      "text": "Hah! What a sluggish attack!",
      "status": "imported"
    },
    "voice_203:r_ddafde4b065ced49": {
      "text": "Even I could dodge that one!",
      "status": "imported"
    },
    "voice_203:r_de1213040856c089": {
      "text": "You haven't lost your touch, Benkei.",
      "status": "imported"
    },
    "voice_203:r_3304412ac41f47a6": {
      "text": "I didn't survive hell for nothing!",
      "status": "imported"
    },
    "voice_203:r_0c0775e051211840": {
      "text": "Now that was way off target!",
      "status": "imported"
    },
    "voice_203:r_a2afffe1c396f0b3": {
      "text": "Heh... Listen to you now, Benkei.",
      "status": "imported"
    },
    "voice_203:r_13c25fbdfddc8a24": {
      "text": "Whoa! I botched that dodge!",
      "status": "imported"
    },
    "voice_203:r_42ba1ecb310b4bd7": {
      "text": "Take your childish games elsewhere!",
      "status": "imported"
    },
    "voice_203:r_d692f1d420460a47": {
      "text": "What's wrong? Want me to switch in?",
      "status": "imported"
    },
    "voice_203:r_a5643cec86b18bd2": {
      "text": "Don't worry. Shut up and watch!",
      "status": "imported"
    },
    "voice_203:r_68f2dfab20a4a30e": {
      "text": "Hmph! That was nothing!",
      "status": "imported"
    },
    "voice_203:r_9cedad8237480563": {
      "text": "Yeah!\\nDon't sweat the small stuff!",
      "status": "imported"
    },
    "voice_203:r_a03fabecba1508ca": {
      "text": "Sorry, that one hit me.",
      "status": "imported"
    },
    "voice_203:r_5391b24a71eb10ae": {
      "text": "Fix it yourself.\\nThat's our way.",
      "status": "imported"
    },
    "voice_203:r_a554ceef5c87b972": {
      "text": "I'm ashamed of myself!",
      "status": "imported"
    },
    "voice_203:r_546c3d5937fbb7ee": {
      "text": "Quit regretting it.\\nDodge properly.",
      "status": "imported"
    },
    "voice_203:r_1568ff6298b12b96": {
      "text": "Gwaaah! A direct hit!?",
      "status": "imported"
    },
    "voice_203:r_2c9d94ba13c5fc50": {
      "text": "Hmph, nowhere near a mortal wound!",
      "status": "imported"
    },
    "voice_203:r_a77f4913375098d2": {
      "text": "Tch!\\nMore than numbers, huh!",
      "status": "imported"
    },
    "voice_203:r_428c2116ac3071b1": {
      "text": "Thanks! Now I'm all fired up!",
      "status": "imported"
    },
    "voice_203:r_84c116267b79f540": {
      "text": "Heh, same old goofball!",
      "status": "imported"
    },
    "voice_203:r_dad38ee29af2df3a": {
      "text": "Switch, Benkei! I can't trust you!",
      "status": "imported"
    },
    "voice_203:r_3d32e86f8dc80909": {
      "text": "That's crazy!\\nI won't back down!",
      "status": "imported"
    },
    "voice_203:r_70451ffbabe2f876": {
      "text": "What's wrong? You're badly damaged!",
      "status": "imported"
    },
    "voice_203:r_69dfa1659715e2fa": {
      "text": "No need to worry!",
      "status": "imported"
    },
    "voice_203:r_d996fd6d4ef5b329": {
      "text": "Looks rough, Benkei. Want to switch?",
      "status": "imported"
    },
    "voice_203:r_8ab47a28f99ef565": {
      "text": "Don't joke! This fight starts now!",
      "status": "imported"
    },
    "voice_203:r_546de3fb6db156ea": {
      "text": "Ngh! That was a solid hit!",
      "status": "imported"
    },
    "voice_203:r_ca85f87cee5e31f7": {
      "text": "Lose here,\\ncan't face my mentor...!",
      "status": "imported"
    },
    "voice_203:r_9072ea7bc71df136": {
      "text": "They're doing whatever they please!",
      "status": "imported"
    },
    "voice_203:r_04e815a8d425827d": {
      "text": "Now that's a foe worthy of us!",
      "status": "imported"
    },
    "voice_203:r_d89011fe3e5d082a": {
      "text": "Guh! So we're doomed, huh!",
      "status": "imported"
    },
    "voice_203:r_3c5b0c2ac812d5de": {
      "text": "Relax!\\nI'll kick Enma aside!",
      "status": "imported"
    },
    "voice_203:r_5b9e8897190892eb": {
      "text": "Benkei! This is turning against us!",
      "status": "imported"
    },
    "voice_203:r_7bea3023abbf8a94": {
      "text": "One shot can turn this all around!",
      "status": "imported"
    },
    "voice_203:r_dd01a4c0d1b36a8d": {
      "text": "That hit dead on! You okay, Benkei!",
      "status": "imported"
    },
    "voice_203:r_20920ad2eb3542db": {
      "text": "You, being kind?\\nWell, I'll be...!",
      "status": "imported"
    },
    "voice_203:r_0ab7914877fd48ed": {
      "text": "I-Is this the end!!",
      "status": "imported"
    },
    "voice_203:r_cb846feec748c2e3": {
      "text": "Chaaaaange! Getter 3!",
      "status": "imported"
    },
    "voice_203:r_c958860b0676b1f5": {
      "text": "All right, let's go!",
      "status": "imported"
    },
    "voice_203:r_5e2669b82ef75ce3": {
      "text": "We won't fall behind\\nunderwater!",
      "status": "imported"
    },
    "voice_203:r_6825fd1ff907bd22": {
      "text": "It's too late for regrets!",
      "status": "imported"
    },
    "voice_203:r_607f666f1563bc0d": {
      "text": "Made it this far!\\nI won't die here!",
      "status": "imported"
    },
    "voice_203:r_97b7431eeb81e6b6": {
      "text": "You're damn good!",
      "status": "imported"
    },
    "voice_203:r_132f605d02975e71": {
      "text": "That puny attack\\nwon't faze Getter!",
      "status": "imported"
    },
    "voice_203:r_9b9726b1872759d6": {
      "text": "Thought you aimed well, did you!",
      "status": "imported"
    },
    "voice_203:r_8c61c59a1c0aebbf": {
      "text": "I'll go first!",
      "status": "imported"
    },
    "voice_203:r_aba6a7662129d8ce": {
      "text": "Looks like you're my opponent!",
      "status": "imported"
    }
  }
}
