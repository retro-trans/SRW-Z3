{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_056:r_479b340ccc6c572b": {
      "text": "Guh... Not yet! Hold together!!",
      "status": "imported"
    },
    "voice_056:r_ca4acbac57a2a35e": {
      "text": "Ngh!\\nPower loss!? Not now...",
      "status": "imported"
    },
    "voice_056:r_77949221bf58f862": {
      "text": "An attack like that won't work!!",
      "status": "imported"
    },
    "voice_056:r_70b9c4b9f1f37eff": {
      "text": "A hit!? No, it only grazed me.",
      "status": "imported"
    },
    "voice_056:r_9fcb3754cb1773c7": {
      "text": "That won't take me down!!",
      "status": "imported"
    },
    "voice_056:r_3559d2fad32c2435": {
      "text": "You won't hit me!",
      "status": "imported"
    },
    "voice_056:r_f7570547e9f80a64": {
      "text": "Not that easily!!",
      "status": "imported"
    },
    "voice_056:r_cbab0f4720e1fcf1": {
      "text": "Not a chance!",
      "status": "imported"
    },
    "voice_056:r_0bbe0b4f5364e732": {
      "text": "I see you... There!!",
      "status": "imported"
    },
    "voice_056:r_5dda5198137cb02a": {
      "text": "No good. I won't last like this.",
      "status": "imported"
    },
    "voice_056:r_83ec59afbecdec14": {
      "text": "Whoa! C-can it hold!?",
      "status": "imported"
    },
    "voice_056:r_e20bfd42ad95a3c9": {
      "text": "What!? Y-you bastard!!",
      "status": "imported"
    },
    "voice_056:r_0f58a8822381e57f": {
      "text": "You're good! But I'm not done!",
      "status": "imported"
    },
    "voice_056:r_6dbcc507fb61b51d": {
      "text": "An attack that weak!",
      "status": "imported"
    },
    "voice_056:r_b42ab697149a7c8a": {
      "text": "Like I'd let that hit!",
      "status": "imported"
    },
    "voice_056:r_4de4fcf3b440baf4": {
      "text": "I can see you!",
      "status": "imported"
    },
    "voice_056:r_0121a166c715cdff": {
      "text": "There! Funnel!!",
      "status": "imported"
    },
    "voice_056:r_30fad37a42bd3ad3": {
      "text": "Faaall!",
      "status": "imported"
    },
    "voice_056:r_80a0b2a84e05d81a": {
      "text": "Go! Funnel!",
      "status": "imported"
    },
    "voice_056:r_bc8538e6af3d2577": {
      "text": "Funnel!!",
      "status": "imported"
    },
    "voice_056:r_da1174533722333f": {
      "text": "This'll work!",
      "status": "imported"
    },
    "voice_056:r_fdeb8162976e72c1": {
      "text": "Fin Funnel, go!",
      "status": "imported"
    },
    "voice_056:r_6b15af9a0057cdc8": {
      "text": "I won't let you!!",
      "status": "imported"
    },
    "voice_056:r_15b4a90140e8a33a": {
      "text": "Go! Fin Funnel!",
      "status": "imported"
    },
    "voice_056:r_ac6fe7838e95647b": {
      "text": "There you are!",
      "status": "imported"
    },
    "voice_056:r_77ca87eacd17ad52": {
      "text": "Fin Funnel!!",
      "status": "imported"
    },
    "voice_056:r_aabfb21c9d069ce7": {
      "text": "I'll finish this!",
      "status": "imported"
    },
    "voice_056:r_02479dc8fe989560": {
      "text": "Everyone, lend me your strength!",
      "status": "imported"
    },
    "voice_056:r_a2df00f91a9b0a9e": {
      "text": "Hit them!",
      "status": "imported"
    },
    "voice_056:r_48b60d6c48b9b142": {
      "text": "Aaaaaaagh!!",
      "status": "imported"
    },
    "voice_056:r_665f01666859013b": {
      "text": "I won't go down that easily!",
      "status": "imported"
    },
    "voice_056:r_a571eec59b258d11": {
      "text": "Here it comes! Direct hit!",
      "status": "imported"
    },
    "voice_056:r_ddbe581c5ea9183d": {
      "text": "You'd throw away lives like that!?",
      "status": "imported"
    },
    "voice_056:r_faae935cca0edc72": {
      "text": "You came forward...\\nWant to die?!",
      "status": "imported"
    },
    "voice_056:r_d4430bf362340b32": {
      "text": "Ugh!\\nOne more hit and I'm done!!",
      "status": "imported"
    },
    "voice_056:r_6ff1323b355593e0": {
      "text": "I'm not dying in a place like this!",
      "status": "imported"
    },
    "voice_056:r_b7b5625d7cd4282f": {
      "text": "Damn... I fell into their rhythm!",
      "status": "imported"
    },
    "voice_056:r_36133ad73a73ef98": {
      "text": "That won't bring Zeta down!",
      "status": "imported"
    },
    "voice_056:r_920740a0219c5085": {
      "text": "Damage is minor.\\nI can still fight!",
      "status": "imported"
    },
    "voice_056:r_a8451712c57c1a72": {
      "text": "It's no use targeting me!",
      "status": "imported"
    },
    "voice_056:r_3633df5b7b8f47fa": {
      "text": "No way you can\\nkeep up with Zeta!",
      "status": "imported"
    },
    "voice_056:r_52dfc56b14b93551": {
      "text": "It's useless!\\nDon't you get it?!",
      "status": "imported"
    },
    "voice_056:r_1b9b2aab5cb104da": {
      "text": "Damn... I can't do anything!",
      "status": "imported"
    },
    "voice_056:r_342044c706a2340f": {
      "text": "I can't counterattack here...!",
      "status": "imported"
    },
    "voice_056:r_cf41e8828a90cbdb": {
      "text": "Where... Where are you!?",
      "status": "imported"
    },
    "voice_056:r_719e897304ec42d4": {
      "text": "I'll end this now!",
      "status": "imported"
    },
    "voice_056:r_d5e0a2317c40d322": {
      "text": "My attack\\nisn't over yet!",
      "status": "imported"
    },
    "voice_056:r_ec2ea17765052401": {
      "text": "I won't let you! I'll defend them!",
      "status": "imported"
    },
    "voice_056:r_f2d4255f1c2f7542": {
      "text": "Enough!\\nYou won't have your way!",
      "status": "imported"
    },
    "voice_056:r_5d08ad19e2da125b": {
      "text": "Generator's online!\\nWe can counter!",
      "status": "imported"
    },
    "voice_056:r_a7246b52782a877e": {
      "text": "Ngh!\\nGundam armor fell that easily!?",
      "status": "imported"
    },
    "voice_056:r_dc8701f6bcb9904f": {
      "text": "Thruster tuning\\nstill isn't right!?",
      "status": "imported"
    },
    "voice_056:r_d6bdd730f24f66eb": {
      "text": "Don't think you'll get past me!",
      "status": "imported"
    },
    "voice_056:r_41997412868c48c4": {
      "text": "Through Zeta,\\nmy power spreads...!",
      "status": "imported"
    },
    "voice_056:r_9e0c80ac7e33b459": {
      "text": "Go!!",
      "status": "imported"
    },
    "voice_056:r_7432ef43ed3471dc": {
      "text": "If Zeta embodies\\nsoul power...!",
      "status": "imported"
    },
    "voice_056:r_847f82e7f3eef651": {
      "text": "Power flows through my body...!",
      "status": "imported"
    },
    "voice_056:r_55417493fce1d347": {
      "text": "Not yet!\\nI can't go down yet!!",
      "status": "imported"
    },
    "voice_056:r_8fdf5910927c9591": {
      "text": "I took damage that easily!?",
      "status": "imported"
    },
    "voice_056:r_7d724dbcc4451e10": {
      "text": "Drive systems damaged!?\\nI'll manage!",
      "status": "imported"
    },
    "voice_056:r_93e25418a203cb8f": {
      "text": "What!?\\nI focused too much on them!?",
      "status": "imported"
    },
    "voice_056:r_adeb0a29274d3d9b": {
      "text": "Ngh... Zeta,\\nbeaten so one-sidedly!?",
      "status": "imported"
    },
    "voice_056:r_24cf161287ef9d5c": {
      "text": "That won't work on a Gundam!",
      "status": "imported"
    },
    "voice_056:r_5213c17e13b23de0": {
      "text": "You're leaving yourself wide open!",
      "status": "imported"
    },
    "voice_056:r_38fdff9483e9245c": {
      "text": "If you'd pulled away, you'd be safe!",
      "status": "imported"
    },
    "voice_056:r_cdbd128a5b4127cc": {
      "text": "I'll lend my body to everyone!!",
      "status": "imported"
    },
    "voice_056:r_cfccaa1fbeda124c": {
      "text": "Get out of here!!",
      "status": "imported"
    },
    "voice_056:r_a007f9ab9cf048b3": {
      "text": "Life...\\nLife is what holds space...!",
      "status": "imported"
    },
    "voice_056:r_ddafde4b065ced49": {
      "text": "You need to understand that!!",
      "status": "imported"
    },
    "voice_056:r_de1213040856c089": {
      "text": "I see them...! The enemy's moves!",
      "status": "imported"
    },
    "voice_056:r_3304412ac41f47a6": {
      "text": "I'll finish you with this!",
      "status": "imported"
    },
    "voice_056:r_0c0775e051211840": {
      "text": "This isn't some game!!",
      "status": "imported"
    },
    "voice_056:r_a2afffe1c396f0b3": {
      "text": "I understand...! Now I can!",
      "status": "imported"
    },
    "voice_056:r_d692f1d420460a47": {
      "text": "Now... I can do this!",
      "status": "imported"
    },
    "voice_056:r_68f2dfab20a4a30e": {
      "text": "Out of my way!!",
      "status": "imported"
    },
    "voice_056:r_9cedad8237480563": {
      "text": "At this range...!",
      "status": "imported"
    },
    "voice_056:r_a554ceef5c87b972": {
      "text": "Can I do it?",
      "status": "imported"
    },
    "voice_056:r_1568ff6298b12b96": {
      "text": "If you still mean to resist!",
      "status": "imported"
    },
    "voice_056:r_a77f4913375098d2": {
      "text": "You'd be safe if you stayed away!",
      "status": "imported"
    },
    "voice_056:r_428c2116ac3071b1": {
      "text": "This'll hit dead-on!",
      "status": "imported"
    },
    "voice_056:r_69dfa1659715e2fa": {
      "text": "Don't chase too far, Fa!",
      "status": "imported"
    },
    "voice_056:r_d996fd6d4ef5b329": {
      "text": "Captain Quattro! I'll take them!",
      "status": "imported"
    },
    "voice_056:r_8ab47a28f99ef565": {
      "text": "Can I match Amuro's movements...!?",
      "status": "imported"
    },
    "voice_056:r_546de3fb6db156ea": {
      "text": "Shin, don't charge in carelessly!",
      "status": "imported"
    },
    "voice_056:r_ca85f87cee5e31f7": {
      "text": "Fa! Fall back!",
      "status": "imported"
    },
    "voice_056:r_9072ea7bc71df136": {
      "text": "Too far forward, Captain Quattro!",
      "status": "imported"
    },
    "voice_056:r_04e815a8d425827d": {
      "text": "Amuro! I won't let them do this!",
      "status": "imported"
    },
    "voice_056:r_d89011fe3e5d082a": {
      "text": "Shin, leave this to me!",
      "status": "imported"
    },
    "voice_056:r_3c5b0c2ac812d5de": {
      "text": "You moved too far up front...!",
      "status": "imported"
    },
    "voice_056:r_5b9e8897190892eb": {
      "text": "We'll pick them off one by one!",
      "status": "imported"
    },
    "voice_056:r_7bea3023abbf8a94": {
      "text": "To make sure I finish them...!",
      "status": "imported"
    },
    "voice_056:r_dd01a4c0d1b36a8d": {
      "text": "First, one machine at a time!",
      "status": "imported"
    },
    "voice_056:r_20920ad2eb3542db": {
      "text": "I can't line up a shot!\\nBad angle?",
      "status": "imported"
    },
    "voice_056:r_0ab7914877fd48ed": {
      "text": "Strong, but far too predictable!",
      "status": "imported"
    },
    "voice_056:r_cb846feec748c2e3": {
      "text": "Just lining up a shot isn't enough!",
      "status": "imported"
    },
    "voice_056:r_c958860b0676b1f5": {
      "text": "Push that far and you'll go down!",
      "status": "imported"
    },
    "voice_056:r_5e2669b82ef75ce3": {
      "text": "You fell for my feint!",
      "status": "imported"
    },
    "voice_056:r_7847e0ed7dc9282d": {
      "text": "I'm moving too!\\nI won't stand still!",
      "status": "imported"
    },
    "voice_056:r_e42b52c7a987b906": {
      "text": "I'm not here to be a target!",
      "status": "imported"
    },
    "voice_056:r_6825fd1ff907bd22": {
      "text": "Do they only think of destruction!?",
      "status": "imported"
    },
    "voice_056:r_607f666f1563bc0d": {
      "text": "If they won't listen to reason!",
      "status": "imported"
    },
    "voice_056:r_97b7431eeb81e6b6": {
      "text": "I won't let you land a direct hit!",
      "status": "imported"
    },
    "voice_056:r_132f605d02975e71": {
      "text": "The shield can handle this!",
      "status": "imported"
    },
    "voice_056:r_9b9726b1872759d6": {
      "text": "Damn! That movement threw me off!",
      "status": "imported"
    },
    "voice_056:r_1252db29683fefe0": {
      "text": "Targeted!?\\nDid I overextend...?",
      "status": "imported"
    },
    "voice_056:r_ad3d538f1e909184": {
      "text": "Ngh! Move, Zeta!",
      "status": "imported"
    },
    "voice_056:r_8c61c59a1c0aebbf": {
      "text": "Not yet...\\nI don't want to die...!",
      "status": "imported"
    },
    "voice_056:r_aba6a7662129d8ce": {
      "text": "Damn! Did they take out the camera?",
      "status": "imported"
    },
    "voice_056:r_fa944da4b6519006": {
      "text": "You won't\\nstop Zeta that easily!",
      "status": "imported"
    },
    "voice_056:r_95d047bcc17fccc6": {
      "text": "They can put me\\nunder pressure...!",
      "status": "imported"
    },
    "voice_056:r_640327a12a559b31": {
      "text": "That pressure won't stop me!",
      "status": "imported"
    },
    "voice_056:r_217aa5e1d545b44d": {
      "text": "There!!",
      "status": "imported"
    },
    "voice_056:r_381992c5d8224937": {
      "text": "That was careless!",
      "status": "imported"
    },
    "voice_056:r_f1e7ed9e5874aba5": {
      "text": "I won't allow it!",
      "status": "imported"
    },
    "voice_056:r_ceb935ccbf830724": {
      "text": "Beam Confuse!!",
      "status": "imported"
    },
    "voice_056:r_862ef7385bf2abd4": {
      "text": "Can't you grasp what's happening!?",
      "status": "imported"
    },
    "voice_056:r_001cbec4d9a4283f": {
      "text": "Come at me and I'll take your power!",
      "status": "imported"
    },
    "voice_056:r_8ad40afecd02b41e": {
      "text": "This is wrong!\\nCan't you see that!?",
      "status": "imported"
    },
    "voice_056:r_7e6c573c26177f98": {
      "text": "Do you think this is some game!?",
      "status": "imported"
    },
    "voice_056:r_45abf84f7757d6eb": {
      "text": "You mustn't fight!\\nNot you, Four!!",
      "status": "imported"
    },
    "voice_056:r_edd7a13ab8f06a14": {
      "text": "Grit your teeth!\\nI'll correct you!",
      "status": "imported"
    },
    "voice_056:r_8165e5b41f0124c4": {
      "text": "Kamille, Zeta Gundam, launching!",
      "status": "imported"
    },
    "voice_056:r_4e05581b7432cce8": {
      "text": "Why can't a man be named Kamille!?",
      "status": "imported"
    },
    "voice_056:r_a60b107ea3c36a86": {
      "text": "I'm a man!!",
      "status": "imported"
    },
    "voice_056:r_57b2bd2de8a1408d": {
      "text": "A fatal hit!? Damn it!",
      "status": "imported"
    },
    "voice_056:r_76f080a4881e8ab5": {
      "text": "Uaaaaagh!",
      "status": "imported"
    },
    "voice_056:r_288133bc5b573dae": {
      "text": "Ngh, not bad!\\nBut I'm not beaten!",
      "status": "imported"
    },
    "voice_056:r_6f95653e548f8fcf": {
      "text": "That hit me? Not bad!!",
      "status": "imported"
    },
    "voice_056:r_d249d68bada91ab9": {
      "text": "If that's all the damage!",
      "status": "imported"
    },
    "voice_056:r_e9b3307e9eb69f11": {
      "text": "Such a one-sided fight...!",
      "status": "imported"
    },
    "voice_056:r_03cdac73042343ee": {
      "text": "Don't think this'll go as you plan!",
      "status": "imported"
    },
    "voice_056:r_981f8fedd5414fe5": {
      "text": "I'll take the one who moved up...!",
      "status": "imported"
    },
    "voice_056:r_641550a2f54cb456": {
      "text": "Now, of all times...!",
      "status": "imported"
    },
    "voice_056:r_d9cd2e4ded064396": {
      "text": "I'm serious, Captain...!\\nNo, Char!",
      "status": "imported"
    },
    "voice_056:r_99e6349431aaf23b": {
      "text": "I'll stop Char Aznable!",
      "status": "imported"
    },
    "voice_056:r_ec1081caf845f56a": {
      "text": "If you're taking the name Char...!",
      "status": "imported"
    },
    "voice_056:r_2c5b7ee872c1ed7f": {
      "text": "Haman!\\nIf that's how you fight...!",
      "status": "imported"
    },
    "voice_056:r_76d1e51c8b494a60": {
      "text": "Is that Captain Quattro...!?",
      "status": "imported"
    },
    "voice_056:r_eb5f687fcd372ae7": {
      "text": "Full Frontal! Here and now!",
      "status": "imported"
    },
    "voice_056:r_2329428a6871d9fa": {
      "text": "This pressure...!",
      "status": "imported"
    },
    "voice_056:r_efa71f7a4cc33ff3": {
      "text": "They made another Cyber-Newtype...!",
      "status": "imported"
    },
    "voice_056:r_3fc2e1186557e7a0": {
      "text": "Neo Zeon, fall back!",
      "status": "imported"
    },
    "voice_056:r_fa6930340a545054": {
      "text": "Why is battle your only option...!?",
      "status": "imported"
    },
    "voice_056:r_2332b9d56461d7ab": {
      "text": "Banagher!\\nDon't let it consume you!",
      "status": "imported"
    },
    "voice_056:r_854aa0a91a3c80d1": {
      "text": "Banagher! Reject the Unicorn!",
      "status": "imported"
    },
    "voice_056:r_0bc8ae32a406ceab": {
      "text": "All this,\\nand you still want war!?",
      "status": "imported"
    },
    "voice_056:r_82c09f011d703b2c": {
      "text": "Even after that, you still fight!?",
      "status": "imported"
    },
    "voice_056:r_2b4d8818c77b6dca": {
      "text": "Not to those who feed on war!",
      "status": "imported"
    },
    "voice_056:r_087354f2db0a31e6": {
      "text": "Warmongers, get out of here!",
      "status": "imported"
    },
    "voice_056:r_d520c6d5298a848d": {
      "text": "This mobile armor is dangerous...!",
      "status": "imported"
    },
    "voice_056:r_099e2458cabf796f": {
      "text": "A machine that controls people...!",
      "status": "imported"
    },
    "voice_056:r_fd910d714be70870": {
      "text": "Is that another Gundam...!?",
      "status": "imported"
    },
    "voice_056:r_9736f29b11344ec3": {
      "text": "Who are they...!?",
      "status": "imported"
    },
    "voice_056:r_fcd05582aa5c6068": {
      "text": "Has another enemy appeared...!?",
      "status": "imported"
    },
    "voice_056:r_bece29562818acba": {
      "text": "For now, focus on stopping it!",
      "status": "imported"
    },
    "voice_056:r_a4a5a96f4bd58920": {
      "text": "Before it's too late,\\nI'll stop it!",
      "status": "imported"
    },
    "voice_056:r_cd06d0820d82524b": {
      "text": "I can't let humanity's foe pass...!",
      "status": "imported"
    },
    "voice_056:r_c94c6d04be583774": {
      "text": "Let them run free,\\nand humanity...!",
      "status": "imported"
    },
    "voice_056:r_e54e2c99ef8297af": {
      "text": "Baal...! The root of all calamity!",
      "status": "imported"
    },
    "voice_056:r_f16a3eb0bcaac082": {
      "text": "We won't let despair consume us!",
      "status": "imported"
    },
    "voice_056:r_10a408809e512df1": {
      "text": "We'll break through and end despair!",
      "status": "imported"
    },
    "voice_056:r_bc7b9e308b879dd4": {
      "text": "I reject\\nthat ego, that arrogance!",
      "status": "imported"
    },
    "voice_056:r_98902fd3143c393e": {
      "text": "Force and fear...\\nNot forever!",
      "status": "imported"
    },
    "voice_056:r_d907fbd7bc1c4298": {
      "text": "I'll end this fight here!",
      "status": "imported"
    },
    "voice_056:r_96b21e3a028dd074": {
      "text": "Watch!\\nThe world wants no war!",
      "status": "imported"
    },
    "voice_056:r_ce140b5d8e6b7310": {
      "text": "Your methods are cowardly...!",
      "status": "imported"
    },
    "voice_056:r_0e0335789c5396d7": {
      "text": "Clean hands,\\nand all the profit...!",
      "status": "imported"
    },
    "voice_056:r_db54e717bff3e3b2": {
      "text": "We'll support the Unicorn!",
      "status": "imported"
    },
    "voice_056:r_fcab8d80aef7e9d8": {
      "text": "Lieutenant Riddhe, I'll take over!",
      "status": "imported"
    },
    "voice_056:r_2174bd0edc164171": {
      "text": "I'll use Nahel Argama as cover!",
      "status": "imported"
    },
    "voice_056:r_ad54419336b49578": {
      "text": "I'll support the Ra Cailum!",
      "status": "imported"
    },
    "voice_056:r_63c353e1e05e8e39": {
      "text": "Hathaway, leave the rest to me!",
      "status": "imported"
    },
    "voice_056:r_87646dd472438e88": {
      "text": "So this is Char Aznable's power...!",
      "status": "imported"
    },
    "voice_056:r_4e32ac89cba02001": {
      "text": "Quess...! Impressive movement...!",
      "status": "imported"
    },
    "voice_056:r_02d24e5915bfa5b7": {
      "text": "With Gyunei's coordination...!",
      "status": "imported"
    },
    "voice_056:r_9331c2c2ef55c78f": {
      "text": "Get the Unicorn back!",
      "status": "imported"
    },
    "voice_056:r_49734bdb3507acf7": {
      "text": "Lieutenant Riddhe, fall back!",
      "status": "imported"
    },
    "voice_056:r_2a730c9b4df0dca3": {
      "text": "Nahel Argama, pull back!",
      "status": "imported"
    },
    "voice_056:r_1e5842ba5dc3f705": {
      "text": "I won't let them harm Ra Cailum!",
      "status": "imported"
    },
    "voice_056:r_9747bd61ad23ecd3": {
      "text": "You're too eager, Hathaway!",
      "status": "imported"
    },
    "voice_056:r_6823f8abe05c4727": {
      "text": "Red Comet\\ncan give everyone hope!",
      "status": "imported"
    },
    "voice_056:r_b8ccfd8b8ac323ac": {
      "text": "Quess, don't give in to hostility!",
      "status": "imported"
    },
    "voice_056:r_c885ff2097749991": {
      "text": "Calm down, Gyunei!",
      "status": "imported"
    },
    "voice_056:r_a8da7f8d8b705db0": {
      "text": "Even the Red Comet can't scare me!",
      "status": "imported"
    },
    "voice_056:r_02e1c5e19de5bd22": {
      "text": "Captain!\\nIf in doubt, eject now!",
      "status": "imported"
    },
    "voice_056:r_6fb823898811e210": {
      "text": "I can sense Haman's hesitation...!",
      "status": "imported"
    },
    "voice_056:r_5dcbcf1682cc3ab8": {
      "text": "Playing games, Full Frontal!?",
      "status": "imported"
    },
    "voice_056:r_5a20988e743dc1d0": {
      "text": "At this rate, Banagher won't last!",
      "status": "imported"
    },
    "voice_056:r_197f05bf899b7697": {
      "text": "That attack reeks of hostility!",
      "status": "imported"
    },
    "voice_056:r_623ee03bd91ab2a1": {
      "text": "War isn't a game, Quess!",
      "status": "imported"
    },
    "voice_056:r_c5c491f8761152f0": {
      "text": "Enough!\\nHow often must this repeat!?",
      "status": "imported"
    },
    "voice_056:r_15042263763f11bb": {
      "text": "If you choose to fight, then...!",
      "status": "imported"
    },
    "voice_056:r_96b3a8f080aea8b4": {
      "text": "This widens\\nthe Earth-space rift!",
      "status": "imported"
    },
    "voice_056:r_aeb9079d86e2a924": {
      "text": "Your hate...\\nI won't say forget it!",
      "status": "imported"
    },
    "voice_056:r_4069f7e9517c47e8": {
      "text": "You're not the Quattro I knew!",
      "status": "imported"
    },
    "voice_056:r_2835a8af1c41be9b": {
      "text": "Such resolve to take the name Char!",
      "status": "imported"
    },
    "voice_056:r_cd84325a7c1a820f": {
      "text": "So this is\\nChar's answer...!?",
      "status": "imported"
    },
    "voice_056:r_0465f74c0488ad70": {
      "text": "Haman! Trapped by rage and hatred!",
      "status": "imported"
    },
    "voice_056:r_a30c8238b5208470": {
      "text": "This pressure...!\\nBeyond Quattro!?",
      "status": "imported"
    },
    "voice_056:r_64bf1c63c7c1ebdd": {
      "text": "Will you let that machine beat you!?",
      "status": "imported"
    },
    "voice_056:r_f6d5042f671118fa": {
      "text": "If they win,\\nyou legitimize them...!",
      "status": "imported"
    },
    "voice_056:r_0be18539fac21ba4": {
      "text": "Stop, Quess!\\nBefore it's too late!",
      "status": "imported"
    },
    "voice_056:r_c05bd0cf089d667f": {
      "text": "You mean you're fighting to die...!?",
      "status": "imported"
    },
    "voice_056:r_f69a0e1d0d67fd0e": {
      "text": "You stubborn fool!",
      "status": "imported"
    },
    "voice_056:r_c4e734ceafabd82c": {
      "text": "Do you want to engulf space in war!?",
      "status": "imported"
    },
    "voice_056:r_111aa50202ff773f": {
      "text": "Isn't Juaggu good enough...!?",
      "status": "imported"
    },
    "voice_056:r_10cb1d3f8f325f52": {
      "text": "Good job, Banagher. Enjoying SRW?",
      "status": "imported"
    },
    "voice_056:r_ed69cbf9ff3779a7": {
      "text": "Ask Shin or Kira for overhead tips.",
      "status": "imported"
    },
    "voice_056:r_82e0a318411dcbf7": {
      "text": "Who knows... You'll get it in time.",
      "status": "imported"
    },
    "voice_056:r_36c402609f13ec14": {
      "text": "The SRW Z series finally ends...",
      "status": "imported"
    },
    "voice_056:r_5ec6634ac287489a": {
      "text": "Yeah. When we met, I wondered...",
      "status": "imported"
    },
    "voice_056:r_0f6c6e8f33422ecf": {
      "text": "I'm glad I fought with you all.",
      "status": "imported"
    },
    "voice_056:r_035b4f6912ba7eed": {
      "text": "Yeah. Let's all fight to the end!",
      "status": "imported"
    },
    "voice_056:r_7a533f3a77a702e3": {
      "text": "We'll hold them here!",
      "status": "imported"
    },
    "voice_056:r_f13d4928e70aad04": {
      "text": "Roger!\\nI'll match your timing!",
      "status": "imported"
    }
  }
}
