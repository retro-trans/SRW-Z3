{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_034:r_479b340ccc6c572b": {
      "text": "Annalotta Stohls,\\nbeginning attack!",
      "status": "imported"
    },
    "voice_034:r_ca4acbac57a2a35e": {
      "text": "Won't forgive you! Never will!",
      "status": "imported"
    },
    "voice_034:r_77949221bf58f862": {
      "text": "We fight to the end! Never give up!",
      "status": "imported"
    },
    "voice_034:r_70b9c4b9f1f37eff": {
      "text": "We'll avenge our people!",
      "status": "imported"
    },
    "voice_034:r_9fcb3754cb1773c7": {
      "text": "Geminiss will fight to the end!",
      "status": "imported"
    },
    "voice_034:r_3559d2fad32c2435": {
      "text": "Our rage and grief...\\nfeel it all!",
      "status": "imported"
    },
    "voice_034:r_f7570547e9f80a64": {
      "text": "This time, I'll finish you!",
      "status": "imported"
    },
    "voice_034:r_cbab0f4720e1fcf1": {
      "text": "My attack isn't over yet!",
      "status": "imported"
    },
    "voice_034:r_0bbe0b4f5364e732": {
      "text": "Light Particle Maser!",
      "status": "imported"
    },
    "voice_034:r_5dda5198137cb02a": {
      "text": "Light particles, converge! Go!",
      "status": "imported"
    },
    "voice_034:r_83ec59afbecdec14": {
      "text": "Psychokinetic targeting! Shoot!",
      "status": "imported"
    },
    "voice_034:r_e20bfd42ad95a3c9": {
      "text": "I'll use the blade!",
      "status": "imported"
    },
    "voice_034:r_0f58a8822381e57f": {
      "text": "I'll turn my fury into a blade!",
      "status": "imported"
    },
    "voice_034:r_6dbcc507fb61b51d": {
      "text": "Light particles! Become a blade!",
      "status": "imported"
    },
    "voice_034:r_b42ab697149a7c8a": {
      "text": "Command Arts! Set!",
      "status": "imported"
    },
    "voice_034:r_4de4fcf3b440baf4": {
      "text": "I'm going all out!",
      "status": "imported"
    },
    "voice_034:r_0121a166c715cdff": {
      "text": "Haaaaaah!",
      "status": "imported"
    },
    "voice_034:r_30fad37a42bd3ad3": {
      "text": "Psy-Control!",
      "status": "imported"
    },
    "voice_034:r_80a0b2a84e05d81a": {
      "text": "Going in at full power!",
      "status": "imported"
    },
    "voice_034:r_4a9ac1dff86506d9": {
      "text": "This is Geminis Arts!",
      "status": "imported"
    },
    "voice_034:r_15b4a90140e8a33a": {
      "text": "Annalotta, counterattacking!",
      "status": "imported"
    },
    "voice_034:r_af884a6b11dff121": {
      "text": "I won't let it end like this!",
      "status": "imported"
    },
    "voice_034:r_ac6fe7838e95647b": {
      "text": "You won't get away!",
      "status": "imported"
    },
    "voice_034:r_77ca87eacd17ad52": {
      "text": "If you're still in range...!",
      "status": "imported"
    },
    "voice_034:r_bf3244994760e535": {
      "text": "Leave this to me!",
      "status": "imported"
    },
    "voice_034:r_aabfb21c9d069ce7": {
      "text": "Annalotta, providing support!",
      "status": "imported"
    },
    "voice_034:r_48b60d6c48b9b142": {
      "text": "Damn! I can't counter like this!",
      "status": "imported"
    },
    "voice_034:r_8927e6fb681aa809": {
      "text": "A mistake, at a time like this?!",
      "status": "imported"
    },
    "voice_034:r_665f01666859013b": {
      "text": "I knew you'd come at me like that!",
      "status": "imported"
    },
    "voice_034:r_a571eec59b258d11": {
      "text": "An attack like that won't...!",
      "status": "imported"
    },
    "voice_034:r_ddbe581c5ea9183d": {
      "text": "We're the faster ones!",
      "status": "imported"
    },
    "voice_034:r_faae935cca0edc72": {
      "text": "Your hostility is crystal clear!",
      "status": "imported"
    },
    "voice_034:r_d4430bf362340b32": {
      "text": "Pointless!",
      "status": "imported"
    },
    "voice_034:r_b7b5625d7cd4282f": {
      "text": "If I block it with the field...!",
      "status": "imported"
    },
    "voice_034:r_36133ad73a73ef98": {
      "text": "I couldn't evade it completely?!",
      "status": "imported"
    },
    "voice_034:r_920740a0219c5085": {
      "text": "A graze is nothing...!",
      "status": "imported"
    },
    "voice_034:r_a8451712c57c1a72": {
      "text": "Damage is minor! I can still fight!",
      "status": "imported"
    },
    "voice_034:r_3633df5b7b8f47fa": {
      "text": "The armor stopped it...!",
      "status": "imported"
    },
    "voice_034:r_52dfc56b14b93551": {
      "text": "Ugh! A direct hit?!",
      "status": "imported"
    },
    "voice_034:r_1b9b2aab5cb104da": {
      "text": "The damage keeps building up...!",
      "status": "imported"
    },
    "voice_034:r_342044c706a2340f": {
      "text": "At this rate, sooner or later...!",
      "status": "imported"
    },
    "voice_034:r_cf41e8828a90cbdb": {
      "text": "Don't lose heart!\\nIt still moves!",
      "status": "imported"
    },
    "voice_034:r_719e897304ec42d4": {
      "text": "I have to fight...! For Geminai!",
      "status": "imported"
    },
    "voice_034:r_d5e0a2317c40d322": {
      "text": "I won't scream!\\nI'm one of Geminis!",
      "status": "imported"
    },
    "voice_034:r_ec2ea17765052401": {
      "text": "I'll avenge everyone! I can't lose!",
      "status": "imported"
    },
    "voice_034:r_f2d4255f1c2f7542": {
      "text": "M-More damage...\\neven Diosc...!",
      "status": "imported"
    },
    "voice_034:r_5d08ad19e2da125b": {
      "text": "Aaaah! C-Captain!!",
      "status": "imported"
    },
    "voice_034:r_a7246b52782a877e": {
      "text": "I-It's over! The unit won't hold!",
      "status": "imported"
    }
  }
}
