{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_128:r_479b340ccc6c572b": {
      "text": "Found you!",
      "status": "imported"
    },
    "voice_128:r_ca4acbac57a2a35e": {
      "text": "If I can seize the initiative...!",
      "status": "imported"
    },
    "voice_128:r_77949221bf58f862": {
      "text": "I'll show them... my potential!",
      "status": "imported"
    },
    "voice_128:r_70b9c4b9f1f37eff": {
      "text": "Banagher here! I'm engaging!",
      "status": "imported"
    },
    "voice_128:r_9fcb3754cb1773c7": {
      "text": "If that's how you'll move...!",
      "status": "imported"
    },
    "voice_128:r_3559d2fad32c2435": {
      "text": "If you won't fall back...!",
      "status": "imported"
    },
    "voice_128:r_f7570547e9f80a64": {
      "text": "You made yourself stand out!",
      "status": "imported"
    },
    "voice_128:r_cbab0f4720e1fcf1": {
      "text": "I can't afford to hold back!",
      "status": "imported"
    },
    "voice_128:r_0bbe0b4f5364e732": {
      "text": "You're far too careless!",
      "status": "imported"
    },
    "voice_128:r_5dda5198137cb02a": {
      "text": "Why did you come out here?!",
      "status": "imported"
    },
    "voice_128:r_83ec59afbecdec14": {
      "text": "Moves like that won't cut it!",
      "status": "imported"
    },
    "voice_128:r_e20bfd42ad95a3c9": {
      "text": "What I can do right now is...!",
      "status": "imported"
    },
    "voice_128:r_0f58a8822381e57f": {
      "text": "This isn't a bluff!",
      "status": "imported"
    },
    "voice_128:r_6dbcc507fb61b51d": {
      "text": "I'm fighting for my life too!",
      "status": "imported"
    },
    "voice_128:r_b42ab697149a7c8a": {
      "text": "I'll pull it off!",
      "status": "imported"
    },
    "voice_128:r_4de4fcf3b440baf4": {
      "text": "My potential...!",
      "status": "imported"
    },
    "voice_128:r_0121a166c715cdff": {
      "text": "You could just move aside!",
      "status": "imported"
    },
    "voice_128:r_30fad37a42bd3ad3": {
      "text": "I don't want to do anything rash!",
      "status": "imported"
    },
    "voice_128:r_80a0b2a84e05d81a": {
      "text": "There's nothing I can't do!",
      "status": "imported"
    },
    "voice_128:r_4a9ac1dff86506d9": {
      "text": "Unicorn... Let's go!",
      "status": "imported"
    },
    "voice_128:r_bc8538e6af3d2577": {
      "text": "I'm firing!",
      "status": "imported"
    },
    "voice_128:r_924516c8de2b5342": {
      "text": "Target locked!",
      "status": "imported"
    },
    "voice_128:r_da1174533722333f": {
      "text": "I won't miss!",
      "status": "imported"
    },
    "voice_128:r_fdeb8162976e72c1": {
      "text": "I should make it from this range!",
      "status": "imported"
    },
    "voice_128:r_0fadb5c26df92b42": {
      "text": "If I can get in close!",
      "status": "imported"
    },
    "voice_128:r_6b15af9a0057cdc8": {
      "text": "If that's how you want it...!",
      "status": "imported"
    },
    "voice_128:r_15b4a90140e8a33a": {
      "text": "They're this close...!",
      "status": "imported"
    },
    "voice_128:r_af884a6b11dff121": {
      "text": "If the range is bad, close in!",
      "status": "imported"
    },
    "voice_128:r_ac6fe7838e95647b": {
      "text": "With the Beam Magnum...!",
      "status": "imported"
    },
    "voice_128:r_77ca87eacd17ad52": {
      "text": "There!!",
      "status": "imported"
    },
    "voice_128:r_bf3244994760e535": {
      "text": "Did I get them...?",
      "status": "imported"
    },
    "voice_128:r_aabfb21c9d069ce7": {
      "text": "I'll have to use the Magnum!",
      "status": "imported"
    },
    "voice_128:r_02479dc8fe989560": {
      "text": "Take this!!",
      "status": "imported"
    },
    "voice_128:r_a2df00f91a9b0a9e": {
      "text": "Is it over...?",
      "status": "imported"
    },
    "voice_128:r_665f01666859013b": {
      "text": "I had no other choice...!",
      "status": "imported"
    },
    "voice_128:r_5d08ad19e2da125b": {
      "text": "If you're still there...!",
      "status": "imported"
    },
    "voice_128:r_a7246b52782a877e": {
      "text": "It's time you stopped moving!",
      "status": "imported"
    },
    "voice_128:r_dc8701f6bcb9904f": {
      "text": "One more shot! I have to do it!",
      "status": "imported"
    },
    "voice_128:r_d6bdd730f24f66eb": {
      "text": "The four-winged mobile suit...!",
      "status": "imported"
    },
    "voice_128:r_41997412868c48c4": {
      "text": "You're all too direct,\\nMarida...!",
      "status": "imported"
    },
    "voice_128:r_9e6cf4f389dae55c": {
      "text": "Gilboa...! Please fall back!",
      "status": "imported"
    },
    "voice_128:r_9e0c80ac7e33b459": {
      "text": "I won't hold back, Captain...!",
      "status": "imported"
    },
    "voice_128:r_7432ef43ed3471dc": {
      "text": "The Red Comet...!",
      "status": "imported"
    },
    "voice_128:r_47d52a2839c71715": {
      "text": "Full Frontal...! Here and now...!",
      "status": "imported"
    },
    "voice_128:r_847f82e7f3eef651": {
      "text": "So these are the Royal Guards...!",
      "status": "imported"
    },
    "voice_128:r_eb7ae28b53dc033c": {
      "text": "Being Royal Guards changes nothing!",
      "status": "imported"
    },
    "voice_128:r_857c4a52ce8df0fd": {
      "text": "Even against Char Aznable!",
      "status": "imported"
    },
    "voice_128:r_55417493fce1d347": {
      "text": "This isn't Full Frontal...?!",
      "status": "imported"
    },
    "voice_128:r_8fdf5910927c9591": {
      "text": "If Haman Karn has come...!",
      "status": "imported"
    },
    "voice_128:r_7d724dbcc4451e10": {
      "text": "Why would Neo Zeon do this...?!",
      "status": "imported"
    },
    "voice_128:r_93e25418a203cb8f": {
      "text": "There has to be another way!",
      "status": "imported"
    },
    "voice_128:r_adeb0a29274d3d9b": {
      "text": "I understand your point... But!",
      "status": "imported"
    },
    "voice_128:r_24cf161287ef9d5c": {
      "text": "War is no answer!\\nIt can't be right!",
      "status": "imported"
    },
    "voice_128:r_8f60f6fc86db3107": {
      "text": "Those moves...!\\nAn enhanced human?!",
      "status": "imported"
    },
    "voice_128:r_b1de76a75a253c13": {
      "text": "What...?! Such an awful pressure...!",
      "status": "imported"
    },
    "voice_128:r_5213c17e13b23de0": {
      "text": "Unicorn...! Lend me your strength!",
      "status": "imported"
    },
    "voice_128:r_38fdff9483e9245c": {
      "text": "I won't... let that happen again!",
      "status": "imported"
    },
    "voice_128:r_620fedec67706d7d": {
      "text": "Loni!\\nStop doing this, or...!",
      "status": "imported"
    },
    "voice_128:r_9680dcd0fddcfcc7": {
      "text": "Living for hate and rage...\\nHow sad!",
      "status": "imported"
    },
    "voice_128:r_2a00f1044ad5cbaa": {
      "text": "Loni! Come back!!",
      "status": "imported"
    },
    "voice_128:r_3dbeead1bd3164ef": {
      "text": "I want to stop Loni!\\nI have to!",
      "status": "imported"
    },
    "voice_128:r_98d15b8cc09bc915": {
      "text": "In that old machine! Want to die?!",
      "status": "imported"
    },
    "voice_128:r_46e86d000250e137": {
      "text": "This is just repaying hatred...!",
      "status": "imported"
    },
    "voice_128:r_ac341e7976e88f0b": {
      "text": "I can't let that hit directly...!",
      "status": "imported"
    },
    "voice_128:r_cdbd128a5b4127cc": {
      "text": "I have to stop its movements...!",
      "status": "imported"
    },
    "voice_128:r_cfccaa1fbeda124c": {
      "text": "What's the point of this battle...?!",
      "status": "imported"
    },
    "voice_128:r_b1f8ec192b9c083a": {
      "text": "They're coming in a Gundam too...!",
      "status": "imported"
    },
    "voice_128:r_a007f9ab9cf048b3": {
      "text": "A Gundam doesn't make it right...!",
      "status": "imported"
    },
    "voice_128:r_ddafde4b065ced49": {
      "text": "If their goal is to invade Earth...!",
      "status": "imported"
    },
    "voice_128:r_de1213040856c089": {
      "text": "If that's why you came to Earth...!",
      "status": "imported"
    },
    "voice_128:r_3304412ac41f47a6": {
      "text": "I won't watch\\nthe world end...!",
      "status": "imported"
    },
    "voice_128:r_0c0775e051211840": {
      "text": "I can't let this monster through...!",
      "status": "imported"
    },
    "voice_128:r_a2afffe1c396f0b3": {
      "text": "If they think only of ruin...!",
      "status": "imported"
    },
    "voice_128:r_13c25fbdfddc8a24": {
      "text": "We won't sit by\\nand be destroyed!",
      "status": "imported"
    },
    "voice_128:r_d692f1d420460a47": {
      "text": "What in the world is this thing...!",
      "status": "imported"
    },
    "voice_128:r_a5643cec86b18bd2": {
      "text": "What are these things after...?!",
      "status": "imported"
    },
    "voice_128:r_68f2dfab20a4a30e": {
      "text": "Doubt potential,\\nand despair wins!",
      "status": "imported"
    },
    "voice_128:r_9cedad8237480563": {
      "text": "With possibility,\\nwe can move on!",
      "status": "imported"
    },
    "voice_128:r_a03fabecba1508ca": {
      "text": "Crush the head and it should fall!",
      "status": "imported"
    },
    "voice_128:r_5391b24a71eb10ae": {
      "text": "You're in command, right?! Then...!",
      "status": "imported"
    },
    "voice_128:r_a554ceef5c87b972": {
      "text": "Your methods are\\nfar too one-sided!",
      "status": "imported"
    },
    "voice_128:r_546c3d5937fbb7ee": {
      "text": "No!\\nYou can't force this through!",
      "status": "imported"
    },
    "voice_128:r_1568ff6298b12b96": {
      "text": "If this is the last fight...!\\nI win!",
      "status": "imported"
    },
    "voice_128:r_2c9d94ba13c5fc50": {
      "text": "Wait, Audrey...!\\nThis is the end!",
      "status": "imported"
    },
    "voice_128:r_a77f4913375098d2": {
      "text": "I can't forgive the way you fight!",
      "status": "imported"
    },
    "voice_128:r_428c2116ac3071b1": {
      "text": "I won't lose to cowards like you...!",
      "status": "imported"
    },
    "voice_128:r_84c116267b79f540": {
      "text": "NT-D...!",
      "status": "imported"
    },
    "voice_128:r_dad38ee29af2df3a": {
      "text": "With this power...!",
      "status": "imported"
    },
    "voice_128:r_3d32e86f8dc80909": {
      "text": "This should bring you down!",
      "status": "imported"
    },
    "voice_128:r_70451ffbabe2f876": {
      "text": "This is... the Unicorn's...!",
      "status": "imported"
    },
    "voice_128:r_69dfa1659715e2fa": {
      "text": "If I use Destroy Mode...!",
      "status": "imported"
    },
    "voice_128:r_d996fd6d4ef5b329": {
      "text": "I'll pull this off!",
      "status": "imported"
    },
    "voice_128:r_8ab47a28f99ef565": {
      "text": "Damn you!!",
      "status": "imported"
    },
    "voice_128:r_546de3fb6db156ea": {
      "text": "I did it...! Did I get them...?!",
      "status": "imported"
    },
    "voice_128:r_ca85f87cee5e31f7": {
      "text": "Please, Unicorn...!",
      "status": "imported"
    },
    "voice_128:r_9072ea7bc71df136": {
      "text": "Lend me your strength...!",
      "status": "imported"
    },
    "voice_128:r_04e815a8d425827d": {
      "text": "How's this?!",
      "status": "imported"
    },
    "voice_128:r_d89011fe3e5d082a": {
      "text": "Hah... hah... hah...!",
      "status": "imported"
    },
    "voice_128:r_6c13bbfd27a7799e": {
      "text": "You should've fled sooner...!",
      "status": "imported"
    },
    "voice_128:r_06f88dcbd3c9e738": {
      "text": "That half-hearted attack...!",
      "status": "imported"
    },
    "voice_128:r_b28faf9f71bc3598": {
      "text": "You're the one who attacked!",
      "status": "imported"
    },
    "voice_128:r_8a29278549f8e07a": {
      "text": "Why do you keep coming at me?!",
      "status": "imported"
    },
    "voice_128:r_7e6c573c26177f98": {
      "text": "I won't let you escape!",
      "status": "imported"
    },
    "voice_128:r_45abf84f7757d6eb": {
      "text": "You can't stay there forever!",
      "status": "imported"
    },
    "voice_128:r_edd7a13ab8f06a14": {
      "text": "This time, I'm coming to you!",
      "status": "imported"
    },
    "voice_128:r_8165e5b41f0124c4": {
      "text": "If you hit me, I'll hit back!",
      "status": "imported"
    },
    "voice_128:r_4e05581b7432cce8": {
      "text": "I'll help out!",
      "status": "imported"
    },
    "voice_128:r_a60b107ea3c36a86": {
      "text": "Banagher here! I'm following up!",
      "status": "imported"
    },
    "voice_128:r_e33693e5ba4665b0": {
      "text": "Ensign Riddhe! Let's coordinate!",
      "status": "imported"
    },
    "voice_128:r_72a21a1a489af001": {
      "text": "Captain Otto! I'll attack too!",
      "status": "imported"
    },
    "voice_128:r_eb643f8bf737a0ca": {
      "text": "Captain! I'll take it from here!",
      "status": "imported"
    },
    "voice_128:r_0a3fccb71ec6cf2a": {
      "text": "Count on me, Marida!",
      "status": "imported"
    },
    "voice_128:r_9b63cf1f3e0207ef": {
      "text": "I'll follow Captain Bright's lead!",
      "status": "imported"
    },
    "voice_128:r_8356f4e3dcdff938": {
      "text": "Amuro...! I'll match your timing!",
      "status": "imported"
    },
    "voice_128:r_1d6d784036ae0bd7": {
      "text": "So this is the true Red Comet...!",
      "status": "imported"
    },
    "voice_128:r_625664af02183c17": {
      "text": "That's Kamille for you!",
      "status": "imported"
    },
    "voice_128:r_3701cba361f80ea5": {
      "text": "I'm joining in, Shinn!",
      "status": "imported"
    },
    "voice_128:r_63f429c5c68c0863": {
      "text": "Kira...! What incredible moves...!",
      "status": "imported"
    },
    "voice_128:r_38e4a434c91d8ef0": {
      "text": "I'll block it!",
      "status": "imported"
    },
    "voice_128:r_98ed411352a3a6ac": {
      "text": "Get out of there! Hurry!",
      "status": "imported"
    },
    "voice_128:r_4824bea6bab3af67": {
      "text": "That's reckless, Ensign Riddhe!",
      "status": "imported"
    },
    "voice_128:r_862b92e63adb9734": {
      "text": "I won't let you hit Nahel Argama!",
      "status": "imported"
    },
    "voice_128:r_cb306ef55e49d107": {
      "text": "Captain, fall back!",
      "status": "imported"
    },
    "voice_128:r_57b2bd2de8a1408d": {
      "text": "You can sense it, right, Marida?!",
      "status": "imported"
    },
    "voice_128:r_76f080a4881e8ab5": {
      "text": "Even if you target Ra Cailum...!",
      "status": "imported"
    },
    "voice_128:r_288133bc5b573dae": {
      "text": "Amuro, please go on ahead!",
      "status": "imported"
    },
    "voice_128:r_6f95653e548f8fcf": {
      "text": "What is the Red Comet doing?!",
      "status": "imported"
    },
    "voice_128:r_d249d68bada91ab9": {
      "text": "Leave this to me, Kamille!",
      "status": "imported"
    },
    "voice_128:r_e9b3307e9eb69f11": {
      "text": "Shinn! Fall back for now!",
      "status": "imported"
    },
    "voice_128:r_03cdac73042343ee": {
      "text": "Kira! While you still can!",
      "status": "imported"
    },
    "voice_128:r_6026da5acbda7c69": {
      "text": "I can't counterattack...!",
      "status": "imported"
    },
    "voice_128:r_981f8fedd5414fe5": {
      "text": "If all I can do is endure, then...!",
      "status": "imported"
    },
    "voice_128:r_96bb0dcde0c8c44a": {
      "text": "Charging...! Hurry up!",
      "status": "imported"
    },
    "voice_128:r_641550a2f54cb456": {
      "text": "At this range...! Still no good...?!",
      "status": "imported"
    },
    "voice_128:r_a0f2074af8debbfa": {
      "text": "Where'd that come from...?! Where?!",
      "status": "imported"
    },
    "voice_128:r_b5f5a97ed82acb0b": {
      "text": "It missed...! Was that a feint?!",
      "status": "imported"
    },
    "voice_128:r_d9cd2e4ded064396": {
      "text": "I'd call luck a skill too, but...!",
      "status": "imported"
    },
    "voice_128:r_99e6349431aaf23b": {
      "text": "Keep your movements to a minimum...!",
      "status": "imported"
    },
    "voice_128:r_ec1081caf845f56a": {
      "text": "I can't get hit that easily...!",
      "status": "imported"
    },
    "voice_128:r_2c5b7ee872c1ed7f": {
      "text": "That was a daring attack, but!",
      "status": "imported"
    },
    "voice_128:r_76d1e51c8b494a60": {
      "text": "It's vague, but I sense their moves!",
      "status": "imported"
    },
    "voice_128:r_eb5f687fcd372ae7": {
      "text": "I dodged it! I can do this...!",
      "status": "imported"
    },
    "voice_128:r_2329428a6871d9fa": {
      "text": "Your aim's too straightforward!",
      "status": "imported"
    },
    "voice_128:r_0e7466971bec4cc4": {
      "text": "A focused shot misses if I pivot!",
      "status": "imported"
    },
    "voice_128:r_efa71f7a4cc33ff3": {
      "text": "I won't stay in one place forever!",
      "status": "imported"
    },
    "voice_128:r_3fc2e1186557e7a0": {
      "text": "Better not to get hit at all...!",
      "status": "imported"
    },
    "voice_128:r_fa6930340a545054": {
      "text": "Just keep aiming at me...!",
      "status": "imported"
    },
    "voice_128:r_2332b9d56461d7ab": {
      "text": "Even the four-wing's attacks...!",
      "status": "imported"
    },
    "voice_128:r_854aa0a91a3c80d1": {
      "text": "Please understand, Marida!",
      "status": "imported"
    },
    "voice_128:r_0bc8ae32a406ceab": {
      "text": "Gilboa...!\\nMust we fight?!",
      "status": "imported"
    },
    "voice_128:r_82c09f011d703b2c": {
      "text": "Captain...! If you mean to fight...!",
      "status": "imported"
    },
    "voice_128:r_2b4d8818c77b6dca": {
      "text": "Full Frontal's\\nwarning...?!",
      "status": "imported"
    },
    "voice_128:r_087354f2db0a31e6": {
      "text": "Char Aznable...!\\nJust testing me?!",
      "status": "imported"
    },
    "voice_128:r_db02a2dec93dd263": {
      "text": "Against the Red Comet, I can't...!",
      "status": "imported"
    },
    "voice_128:r_d520c6d5298a848d": {
      "text": "Royal Guards won't beat me easily!",
      "status": "imported"
    },
    "voice_128:r_099e2458cabf796f": {
      "text": "If it's pointless,\\nfall back!",
      "status": "imported"
    },
    "voice_128:r_fd910d714be70870": {
      "text": "Fixing the world this way\\nis wrong!",
      "status": "imported"
    },
    "voice_128:r_9736f29b11344ec3": {
      "text": "You're trapped,\\nLoni!",
      "status": "imported"
    },
    "voice_128:r_fcd05582aa5c6068": {
      "text": "Loni! Stop this now!",
      "status": "imported"
    },
    "voice_128:r_bece29562818acba": {
      "text": "This dark mire...\\nDon't be stained!",
      "status": "imported"
    },
    "voice_128:r_494b5da92ed24ecb": {
      "text": "No wish controls Loni.\\nIt's a curse!",
      "status": "imported"
    },
    "voice_128:r_a4a5a96f4bd58920": {
      "text": "That machine can't do it!\\nSee that!",
      "status": "imported"
    },
    "voice_128:r_b57d2d74233f889a": {
      "text": "This won't\\nbring you anything...!",
      "status": "imported"
    },
    "voice_128:r_041dd920da4a7c17": {
      "text": "There's no way that could work!",
      "status": "imported"
    },
    "voice_128:r_c7f4280cde4605b3": {
      "text": "I still have the barrier!",
      "status": "imported"
    },
    "voice_128:r_33236ffa3ea95b68": {
      "text": "As long as the I-Field holds!",
      "status": "imported"
    },
    "voice_128:r_689d0b123de71ae0": {
      "text": "If I block it with the shield...!",
      "status": "imported"
    },
    "voice_128:r_84883aa95f63ce32": {
      "text": "As long as I can use the shield...!",
      "status": "imported"
    },
    "voice_128:r_25493e978ce8ff16": {
      "text": "Are they testing my response?",
      "status": "imported"
    },
    "voice_128:r_7316666150e42960": {
      "text": "It won't do serious damage yet...!",
      "status": "imported"
    },
    "voice_128:r_c4f11aa93dc5b668": {
      "text": "I can't keep this up forever...!",
      "status": "imported"
    },
    "voice_128:r_ce1a22dfe3a4d339": {
      "text": "Stay calm...! It's not fatal yet...!",
      "status": "imported"
    },
    "voice_128:r_240651adab81e145": {
      "text": "They're reading my movements...?!",
      "status": "imported"
    },
    "voice_128:r_cff0deaae73c2858": {
      "text": "Armor can stop this much, but...!",
      "status": "imported"
    },
    "voice_128:r_dca67f68a573fab7": {
      "text": "I have to react faster...!",
      "status": "imported"
    },
    "voice_128:r_a6630215fefaf294": {
      "text": "I reacted! Now I just have to move!",
      "status": "imported"
    },
    "voice_128:r_6f94566ad37f8ff8": {
      "text": "I knew it was coming, and still...!",
      "status": "imported"
    },
    "voice_128:r_942ca03c9de80143": {
      "text": "Were my movements too simple...?!",
      "status": "imported"
    },
    "voice_128:r_d8c669c70659e18a": {
      "text": "Move more, or they'll catch me...!",
      "status": "imported"
    },
    "voice_128:r_8f5bade7ac2db78e": {
      "text": "Damn...! Did they lure me in?!",
      "status": "imported"
    },
    "voice_128:r_05ea490d2f522520": {
      "text": "Can they read my moves?!",
      "status": "imported"
    },
    "voice_128:r_f5658c702d91db7a": {
      "text": "I'm being pushed back bit by bit...!",
      "status": "imported"
    },
    "voice_128:r_686df329b50f195b": {
      "text": "Was that last move a taunt...?!",
      "status": "imported"
    },
    "voice_128:r_25f0ab0fa3cf690c": {
      "text": "Damn! I was swept up by their force!",
      "status": "imported"
    },
    "voice_128:r_b708a1d959013dbf": {
      "text": "They hit me! Damn!",
      "status": "imported"
    },
    "voice_128:r_59fca03e929366c1": {
      "text": "I decided I'd pull it off, so...!",
      "status": "imported"
    },
    "voice_128:r_0d65eb631dcb7514": {
      "text": "Why can't you see,\\nMarida?!",
      "status": "imported"
    },
    "voice_128:r_d03018a31e23f1e9": {
      "text": "Gilboa...!\\nI don't plan to die!",
      "status": "imported"
    },
    "voice_128:r_279da5f732aa8847": {
      "text": "Captain...! You're serious...!",
      "status": "imported"
    },
    "voice_128:r_97f82e3cb6f70110": {
      "text": "Full Frontal is serious...!",
      "status": "imported"
    },
    "voice_128:r_c5611d8dd6def96b": {
      "text": "Red Comet's aura is crushing me?!",
      "status": "imported"
    },
    "voice_128:r_6f12cc8ed2732eb5": {
      "text": "I can't stop the Red Comet...?!",
      "status": "imported"
    },
    "voice_128:r_7abfc55f8fb62ba7": {
      "text": "Their pressure is driving me back!",
      "status": "imported"
    },
    "voice_128:r_99e7a66c650b5892": {
      "text": "The Royal Guards...!\\nSuch skill...!",
      "status": "imported"
    },
    "voice_128:r_5b2247b5cfbcd7b2": {
      "text": "Serious about changing the world...!",
      "status": "imported"
    },
    "voice_128:r_2d7a9c06347582d9": {
      "text": "Is their resolve overpowering me?!",
      "status": "imported"
    },
    "voice_128:r_bf953d64c3c7d9b7": {
      "text": "Is this what you want,\\nLoni?!",
      "status": "imported"
    },
    "voice_128:r_e09b933e3e706779": {
      "text": "Ghh...! Don't let it take you, Loni!",
      "status": "imported"
    },
    "voice_128:r_66236eb99b676e5b": {
      "text": "Fighting to die...?!\\nThis is...!",
      "status": "imported"
    },
    "voice_128:r_a870d0cf7cc11ec6": {
      "text": "Is it going to end like this...?!",
      "status": "imported"
    },
    "voice_128:r_03f6158ef83964f3": {
      "text": "How did I get this cornered...?!",
      "status": "imported"
    },
    "voice_128:r_2970a83693cdcc25": {
      "text": "Before this,\\nI should've acted...!",
      "status": "imported"
    },
    "voice_128:r_be661448b85d0009": {
      "text": "I don't want to kill or die...!",
      "status": "imported"
    },
    "voice_128:r_958a56c1151cab9e": {
      "text": "You can still do more, Banagher...!",
      "status": "imported"
    },
    "voice_128:r_8b18aa4cc69547df": {
      "text": "Focus only on surviving for now...!",
      "status": "imported"
    },
    "voice_128:r_3e87f6fc3ea65aef": {
      "text": "Die here,\\nand all hope is lost...!",
      "status": "imported"
    },
    "voice_128:r_5508a7bfa9074eb9": {
      "text": "Still moving...!\\nI can still fight!",
      "status": "imported"
    },
    "voice_128:r_09a003e91f0d5dc7": {
      "text": "Audrey...! I won't die...!",
      "status": "imported"
    },
    "voice_128:r_192447448ebd7bb5": {
      "text": "I'm at my limit...! Ejecting!",
      "status": "imported"
    },
    "voice_128:r_e92920ba4b301b9f": {
      "text": "Is this really all my potential...?!",
      "status": "imported"
    },
    "voice_128:r_207b256d613bb896": {
      "text": "Audrey...! I...!",
      "status": "imported"
    },
    "voice_128:r_a6fd676d8146501b": {
      "text": "The Unicorn...! No...!",
      "status": "imported"
    },
    "voice_128:r_94d35e5fa8e3a198": {
      "text": "Audrey! That talk corners us both!",
      "status": "imported"
    },
    "voice_128:r_b686510e636673f3": {
      "text": "Let's rest. You're tired too.",
      "status": "imported"
    },
    "voice_128:r_59369bad143d4272": {
      "text": "Player! We'll take our leave now!",
      "status": "imported"
    },
    "voice_128:r_25f9b1e39dd8d366": {
      "text": "Ah...!",
      "status": "imported"
    },
    "voice_128:r_307477bedd148060": {
      "text": "I did it... I did! All for this!",
      "status": "imported"
    },
    "voice_128:r_09a780acca0eb4b0": {
      "text": "Raise levels, kills, funds, Z Chips!",
      "status": "imported"
    },
    "voice_128:r_af62f2ee466b5c8c": {
      "text": "What more can I do?! Fight what?!",
      "status": "imported"
    },
    "voice_128:r_20cfb719db02fafd": {
      "text": "Pardon... Trouble? If not, play on.",
      "status": "imported"
    },
    "voice_128:r_570c1fdf72edb283": {
      "text": "Do I... have to answer that?",
      "status": "imported"
    },
    "voice_128:r_23f0d87a5a6cfca1": {
      "text": "I botch Unicorn's Destroy Mode...",
      "status": "imported"
    },
    "voice_128:r_60c94ea4eb7f7404": {
      "text": "How can I split Unicorn's horn...?",
      "status": "imported"
    },
    "voice_128:r_727b2ee0277f9159": {
      "text": "...What do you mean?",
      "status": "imported"
    },
    "voice_128:r_cff4d2eae8a939ed": {
      "text": "Dad!!",
      "status": "imported"
    },
    "voice_128:r_1428fe5f35a9427b": {
      "text": "Ngh! Dad...? I... now... my...!",
      "status": "imported"
    },
    "voice_128:r_96d39b8bdfa6f183": {
      "text": "My hope. Beast of Possibility. Dad.",
      "status": "imported"
    },
    "voice_128:r_0e4f9b8a2d26ebff": {
      "text": "Mom, sorry... I...! I'm going...!",
      "status": "imported"
    },
    "voice_128:r_79e0d542fe12bcf7": {
      "text": "I can't fire!!",
      "status": "imported"
    },
    "voice_128:r_eff747ba39a55393": {
      "text": "Banagher",
      "status": "imported"
    },
    "voice_128:r_b2dc77aa6dd77e69": {
      "text": "Because this one called to me.",
      "status": "imported"
    },
    "voice_128:r_445d40d8b5d7092b": {
      "text": "Audrey. Audrey Burne...",
      "status": "imported"
    },
    "voice_128:r_bbb633cb5e8e6daf": {
      "text": "I did it... I did!! All for this!!",
      "status": "imported"
    },
    "voice_128:r_0abd8b6c713ccdac": {
      "text": "Killed in a suit. Now crossing sand!",
      "status": "imported"
    },
    "voice_128:r_f4ff463b2fda1b86": {
      "text": "What more can I do! Fight what now!!",
      "status": "imported"
    },
    "voice_128:r_141415c1def5ab2d": {
      "text": "Throwing them off balance is enough!",
      "status": "imported"
    },
    "voice_128:r_c894e35becf35a03": {
      "text": "To make certain they go down!",
      "status": "imported"
    },
    "voice_128:r_79b1abf5fc86483c": {
      "text": "I'll assist you!",
      "status": "imported"
    },
    "voice_128:r_e9a11621911acb19": {
      "text": "If I can be of any help...!",
      "status": "imported"
    },
    "voice_128:r_d52bece55796f599": {
      "text": "It's okay. I can do this!",
      "status": "imported"
    },
    "voice_128:r_358fe5a50bbee1df": {
      "text": "I'll handle this side!",
      "status": "imported"
    },
    "voice_128:r_638834e16724002f": {
      "text": "There's something I can do too!",
      "status": "imported"
    },
    "voice_128:r_b02fca1590ac1210": {
      "text": "I'll stop that one!",
      "status": "imported"
    }
  }
}
