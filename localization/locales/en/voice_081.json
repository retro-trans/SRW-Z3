{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_081:r_ca4acbac57a2a35e": {
      "text": "Show them how S.M.S. fights!",
      "status": "imported"
    },
    "voice_081:r_77949221bf58f862": {
      "text": "Small, but a Macross.\\nShow them!",
      "status": "imported"
    },
    "voice_081:r_70b9c4b9f1f37eff": {
      "text": "Drive our power into their bones!",
      "status": "imported"
    },
    "voice_081:r_9fcb3754cb1773c7": {
      "text": "Enemy craft approaching!",
      "status": "imported"
    },
    "voice_081:r_3559d2fad32c2435": {
      "text": "Intercept them at once!",
      "status": "imported"
    },
    "voice_081:r_f7570547e9f80a64": {
      "text": "Charge in, Bobby! Full speed!",
      "status": "imported"
    },
    "voice_081:r_cbab0f4720e1fcf1": {
      "text": "Okay, Boss!",
      "status": "imported"
    },
    "voice_081:r_0bbe0b4f5364e732": {
      "text": "Scatter the enemy!",
      "status": "imported"
    },
    "voice_081:r_5dda5198137cb02a": {
      "text": "Roger that!!",
      "status": "imported"
    },
    "voice_081:r_83ec59afbecdec14": {
      "text": "Attack again!",
      "status": "imported"
    },
    "voice_081:r_e20bfd42ad95a3c9": {
      "text": "Target: Vajra! Commence attack!",
      "status": "imported"
    },
    "voice_081:r_0f58a8822381e57f": {
      "text": "Take their leader! All hands, rally!",
      "status": "imported"
    },
    "voice_081:r_6dbcc507fb61b51d": {
      "text": "Strike their head and end this!",
      "status": "imported"
    },
    "voice_081:r_b42ab697149a7c8a": {
      "text": "Final foe!\\nProud flyers, follow me!",
      "status": "imported"
    },
    "voice_081:r_4de4fcf3b440baf4": {
      "text": "Wipe out the Vajra ahead! Charge!",
      "status": "imported"
    },
    "voice_081:r_0121a166c715cdff": {
      "text": "Aye, Captain!",
      "status": "imported"
    },
    "voice_081:r_30fad37a42bd3ad3": {
      "text": "Captain! Final target acquired!",
      "status": "imported"
    },
    "voice_081:r_80a0b2a84e05d81a": {
      "text": "We'll settle this battle ourselves!",
      "status": "imported"
    },
    "voice_081:r_4a9ac1dff86506d9": {
      "text": "Prepare to fire Macross Cannon!",
      "status": "imported"
    },
    "voice_081:r_bc8538e6af3d2577": {
      "text": "Delta 1: all!\\nUsing Macross Cannon!",
      "status": "imported"
    },
    "voice_081:r_924516c8de2b5342": {
      "text": "Clear our line of fire at once!",
      "status": "imported"
    },
    "voice_081:r_da1174533722333f": {
      "text": "Macross Cannon, let 'em have it!!",
      "status": "imported"
    },
    "voice_081:r_fdeb8162976e72c1": {
      "text": "Goooo!!",
      "status": "imported"
    },
    "voice_081:r_6b15af9a0057cdc8": {
      "text": "Delta 1 to all!\\nClear our fire lane!",
      "status": "imported"
    },
    "voice_081:r_15b4a90140e8a33a": {
      "text": "Allied units are clear of our fire!",
      "status": "imported"
    },
    "voice_081:r_af884a6b11dff121": {
      "text": "Macross Cannon, fire!!",
      "status": "imported"
    },
    "voice_081:r_ac6fe7838e95647b": {
      "text": "Time to dieeee!!",
      "status": "imported"
    },
    "voice_081:r_77ca87eacd17ad52": {
      "text": "Sweep away the enemies ahead!",
      "status": "imported"
    },
    "voice_081:r_bf3244994760e535": {
      "text": "Okay, Boss!",
      "status": "imported"
    },
    "voice_081:r_aabfb21c9d069ce7": {
      "text": "No allies in our line of fire!",
      "status": "imported"
    },
    "voice_081:r_02479dc8fe989560": {
      "text": "All right, fire!!",
      "status": "imported"
    },
    "voice_081:r_a2df00f91a9b0a9e": {
      "text": "Uoooooh!!",
      "status": "imported"
    },
    "voice_081:r_48b60d6c48b9b142": {
      "text": "Destroy the enemies ahead of us!",
      "status": "imported"
    },
    "voice_081:r_8927e6fb681aa809": {
      "text": "Aye, Captain!",
      "status": "imported"
    },
    "voice_081:r_665f01666859013b": {
      "text": "Allied units have cleared our fire!",
      "status": "imported"
    },
    "voice_081:r_a571eec59b258d11": {
      "text": "Now! Fire!!",
      "status": "imported"
    },
    "voice_081:r_ddbe581c5ea9183d": {
      "text": "Uoooooh!!",
      "status": "imported"
    },
    "voice_081:r_d4430bf362340b32": {
      "text": "Delta 1, all units!\\nClear our fire!",
      "status": "imported"
    },
    "voice_081:r_6ff1323b355593e0": {
      "text": "Let 'em have it!!",
      "status": "imported"
    },
    "voice_081:r_b7b5625d7cd4282f": {
      "text": "Time to dieeeee!!",
      "status": "imported"
    },
    "voice_081:r_36133ad73a73ef98": {
      "text": "We'll use Macross Cannon!",
      "status": "imported"
    },
    "voice_081:r_920740a0219c5085": {
      "text": "Roger!\\nI'll get our allies clear!",
      "status": "imported"
    },
    "voice_081:r_a8451712c57c1a72": {
      "text": "Macross Cannon, fireeee!!",
      "status": "imported"
    },
    "voice_081:r_3633df5b7b8f47fa": {
      "text": "All riiight!!",
      "status": "imported"
    },
    "voice_081:r_52dfc56b14b93551": {
      "text": "Don't let the enemy escape!",
      "status": "imported"
    },
    "voice_081:r_1b9b2aab5cb104da": {
      "text": "Don't let up the attack!",
      "status": "imported"
    },
    "voice_081:r_342044c706a2340f": {
      "text": "Counterattack at once!",
      "status": "imported"
    },
    "voice_081:r_cf41e8828a90cbdb": {
      "text": "They're still in range! Return fire!",
      "status": "imported"
    },
    "voice_081:r_719e897304ec42d4": {
      "text": "Attack S.M.S.,\\nand you'll pay!",
      "status": "imported"
    },
    "voice_081:r_d5e0a2317c40d322": {
      "text": "Hit us,\\nyou won't leave unscathed!",
      "status": "imported"
    },
    "voice_081:r_9e0c80ac7e33b459": {
      "text": "Enemy craft now within range!",
      "status": "imported"
    },
    "voice_081:r_7432ef43ed3471dc": {
      "text": "All right, open fire!",
      "status": "imported"
    },
    "voice_081:r_5213c17e13b23de0": {
      "text": "Enemy Vajra swarm incoming!",
      "status": "imported"
    },
    "voice_081:r_38fdff9483e9245c": {
      "text": "Open fire!",
      "status": "imported"
    },
    "voice_081:r_46e86d000250e137": {
      "text": "Continue the attack!",
      "status": "imported"
    },
    "voice_081:r_ac341e7976e88f0b": {
      "text": "Cover our allied units!",
      "status": "imported"
    },
    "voice_081:r_cdbd128a5b4127cc": {
      "text": "Follow Skull Leader! Open fire!",
      "status": "imported"
    },
    "voice_081:r_cfccaa1fbeda124c": {
      "text": "Follow Skull 4! We attack too!",
      "status": "imported"
    },
    "voice_081:r_b1f8ec192b9c083a": {
      "text": "Cover Pixie Squadron!",
      "status": "imported"
    },
    "voice_081:r_a007f9ab9cf048b3": {
      "text": "Follow our sister ship! Open fire!",
      "status": "imported"
    },
    "voice_081:r_ddafde4b065ced49": {
      "text": "Fall back! We'll be your shield!",
      "status": "imported"
    },
    "voice_081:r_de1213040856c089": {
      "text": "This ship will protect our allies!",
      "status": "imported"
    },
    "voice_081:r_3304412ac41f47a6": {
      "text": "Maximum battle speed! Cut in!",
      "status": "imported"
    },
    "voice_081:r_0c0775e051211840": {
      "text": "Fall back, Skull Leader!",
      "status": "imported"
    },
    "voice_081:r_a2afffe1c396f0b3": {
      "text": "Skull 4! Don't be so reckless!",
      "status": "imported"
    },
    "voice_081:r_13c25fbdfddc8a24": {
      "text": "Shield Pixie Squadron!",
      "status": "imported"
    },
    "voice_081:r_42ba1ecb310b4bd7": {
      "text": "Protect our sister ship! Charge!",
      "status": "imported"
    },
    "voice_081:r_d692f1d420460a47": {
      "text": "To think we can't do a thing...!",
      "status": "imported"
    },
    "voice_081:r_a5643cec86b18bd2": {
      "text": "Trust victory will come.\\nNow endure!",
      "status": "imported"
    },
    "voice_081:r_68f2dfab20a4a30e": {
      "text": "Request allied escort for us!",
      "status": "imported"
    },
    "voice_081:r_9cedad8237480563": {
      "text": "Understood!",
      "status": "imported"
    },
    "voice_081:r_a03fabecba1508ca": {
      "text": "Captain, we've lost the enemy!",
      "status": "imported"
    },
    "voice_081:r_5391b24a71eb10ae": {
      "text": "Reacquire them, quickly!",
      "status": "imported"
    },
    "voice_081:r_a554ceef5c87b972": {
      "text": "We can't track the enemy!",
      "status": "imported"
    },
    "voice_081:r_546c3d5937fbb7ee": {
      "text": "No choice. Engage the closest foe!",
      "status": "imported"
    },
    "voice_081:r_1568ff6298b12b96": {
      "text": "We won't make such an easy target.",
      "status": "imported"
    },
    "voice_081:r_2c9d94ba13c5fc50": {
      "text": "This ship's nimbler than it looks.",
      "status": "imported"
    },
    "voice_081:r_a77f4913375098d2": {
      "text": "Whoa!",
      "status": "imported"
    },
    "voice_081:r_428c2116ac3071b1": {
      "text": "Well done, Bobby.",
      "status": "imported"
    },
    "voice_081:r_84c116267b79f540": {
      "text": "Dammit!",
      "status": "imported"
    },
    "voice_081:r_dad38ee29af2df3a": {
      "text": "Fine helmsmanship, Bobby.",
      "status": "imported"
    },
    "voice_081:r_3d32e86f8dc80909": {
      "text": "That one's a slowpoke, Captain.",
      "status": "imported"
    },
    "voice_081:r_70451ffbabe2f876": {
      "text": "Still, don't let your guard down.",
      "status": "imported"
    },
    "voice_081:r_69dfa1659715e2fa": {
      "text": "No way that's hitting us!",
      "status": "imported"
    },
    "voice_081:r_d996fd6d4ef5b329": {
      "text": "I'm counting on you, Bobby.",
      "status": "imported"
    },
    "voice_081:r_8ab47a28f99ef565": {
      "text": "Evasion complete, Captain.",
      "status": "imported"
    },
    "voice_081:r_546de3fb6db156ea": {
      "text": "Good. Keep it up next time.",
      "status": "imported"
    },
    "voice_081:r_ca85f87cee5e31f7": {
      "text": "We won't flinch at such a thing.",
      "status": "imported"
    },
    "voice_081:r_9072ea7bc71df136": {
      "text": "That won't affect us!",
      "status": "imported"
    },
    "voice_081:r_3c5b0c2ac812d5de": {
      "text": "Hmph. Small, but still a Macross.",
      "status": "imported"
    },
    "voice_081:r_5b9e8897190892eb": {
      "text": "You can't sink this ship with that.",
      "status": "imported"
    },
    "voice_081:r_7bea3023abbf8a94": {
      "text": "None of us\\nwill flinch at so little.",
      "status": "imported"
    },
    "voice_081:r_dd01a4c0d1b36a8d": {
      "text": "Damn Vajra. They've targeted us.",
      "status": "imported"
    },
    "voice_081:r_20920ad2eb3542db": {
      "text": "Don't let the Vajra latch onto us!",
      "status": "imported"
    },
    "voice_081:r_0ab7914877fd48ed": {
      "text": "Their moves\\ndon't look like a feint.",
      "status": "imported"
    },
    "voice_081:r_cb846feec748c2e3": {
      "text": "They've gravely underestimated us.",
      "status": "imported"
    },
    "voice_081:r_c958860b0676b1f5": {
      "text": "My apologies, Captain!",
      "status": "imported"
    },
    "voice_081:r_5e2669b82ef75ce3": {
      "text": "Never mind. Refocus on the helm.",
      "status": "imported"
    },
    "voice_081:r_7847e0ed7dc9282d": {
      "text": "Hey! What are you doing?!",
      "status": "imported"
    },
    "voice_081:r_e42b52c7a987b906": {
      "text": "Ignore minor damage. Advance!",
      "status": "imported"
    },
    "voice_081:r_6825fd1ff907bd22": {
      "text": "Maintain strict anti-air watch!",
      "status": "imported"
    },
    "voice_081:r_607f666f1563bc0d": {
      "text": "Understood!",
      "status": "imported"
    },
    "voice_081:r_97b7431eeb81e6b6": {
      "text": "Don't let the enemy any closer!",
      "status": "imported"
    },
    "voice_081:r_132f605d02975e71": {
      "text": "We never expected to be unscathed!",
      "status": "imported"
    },
    "voice_081:r_9b9726b1872759d6": {
      "text": "Don't let the Vajra near this ship!",
      "status": "imported"
    },
    "voice_081:r_1252db29683fefe0": {
      "text": "All guns! Down every Vajra!",
      "status": "imported"
    },
    "voice_081:r_ad3d538f1e909184": {
      "text": "Damn it! Bastard!",
      "status": "imported"
    },
    "voice_081:r_8c61c59a1c0aebbf": {
      "text": "Don't get carried away, Bobby!",
      "status": "imported"
    },
    "voice_081:r_aba6a7662129d8ce": {
      "text": "Allied units to close escort!",
      "status": "imported"
    },
    "voice_081:r_b84afafb8a33ec60": {
      "text": "Roger! Delta 1:\\nNearby, support!",
      "status": "imported"
    },
    "voice_081:r_c8c59db85bf875e6": {
      "text": "Ngh! More enemy craft approaching!",
      "status": "imported"
    },
    "voice_081:r_391aa56435d9dd6e": {
      "text": "Anti-air intercept!",
      "status": "imported"
    },
    "voice_081:r_7c796ba53bd7ea03": {
      "text": "C-Captain!",
      "status": "imported"
    },
    "voice_081:r_fa944da4b6519006": {
      "text": "Order nearby allies to support us!",
      "status": "imported"
    },
    "voice_081:r_95d047bcc17fccc6": {
      "text": "Ngh! They've pushed us this far...!",
      "status": "imported"
    },
    "voice_081:r_640327a12a559b31": {
      "text": "All hands, rally! This is it!",
      "status": "imported"
    },
    "voice_081:r_bdd38c584fa313d0": {
      "text": "Ugh!\\nReport impact sites and damage!",
      "status": "imported"
    },
    "voice_081:r_3fd86c1027f317c8": {
      "text": "Vajra closing even further!",
      "status": "imported"
    },
    "voice_081:r_d0372a183d2007ad": {
      "text": "Shoot it down at any cost!",
      "status": "imported"
    },
    "voice_081:r_217aa5e1d545b44d": {
      "text": "Don't tell me to fall back, Boss!",
      "status": "imported"
    },
    "voice_081:r_381992c5d8224937": {
      "text": "Of course! Now show them our pride!",
      "status": "imported"
    },
    "voice_081:r_f1e7ed9e5874aba5": {
      "text": "We can still fight! Too soon to run!",
      "status": "imported"
    },
    "voice_081:r_fc25e66a86fc2c85": {
      "text": "Bobby, the ship can still move?",
      "status": "imported"
    },
    "voice_081:r_5aeeb4917340c42d": {
      "text": "Yes, Boss!\\nNow we fight back!",
      "status": "imported"
    },
    "voice_081:r_b765659981b6516d": {
      "text": "All hands, abandon ship at once!",
      "status": "imported"
    },
    "voice_081:r_0c427458bc00eb95": {
      "text": "Nngh! What a bitter end...!!",
      "status": "imported"
    },
    "voice_081:r_7d2617c809fead70": {
      "text": "Enemy commander closing on us!",
      "status": "imported"
    },
    "voice_081:r_ceb935ccbf830724": {
      "text": "Invader approaching this ship!",
      "status": "imported"
    },
    "voice_081:r_862ef7385bf2abd4": {
      "text": "Enemy Mobile Armor within range!",
      "status": "imported"
    },
    "voice_081:r_001cbec4d9a4283f": {
      "text": "Enemy AT approaching this ship!",
      "status": "imported"
    },
    "voice_081:r_8ad40afecd02b41e": {
      "text": "Mechanical Beast closing on us!",
      "status": "imported"
    },
    "voice_081:r_625664af02183c17": {
      "text": "Enemy attack missed us by a mile!",
      "status": "imported"
    },
    "voice_081:r_3701cba361f80ea5": {
      "text": "Delta 1 here! Moving to support!",
      "status": "imported"
    },
    "voice_081:r_63f429c5c68c0863": {
      "text": "Delta 1: Skull 4!\\nFall back now!",
      "status": "imported"
    },
    "voice_081:r_38e4a434c91d8ef0": {
      "text": "Delta 1: Skull Leader!\\nBack now!",
      "status": "imported"
    },
    "voice_081:r_98ed411352a3a6ac": {
      "text": "Enemy Mobile Suit approaching!",
      "status": "imported"
    },
    "voice_081:r_862b92e63adb9734": {
      "text": "Now! Macross Attack!!",
      "status": "imported"
    },
    "voice_081:r_cb306ef55e49d107": {
      "text": "All riiight!!",
      "status": "imported"
    },
    "voice_081:r_57b2bd2de8a1408d": {
      "text": "Fireeee!!",
      "status": "imported"
    },
    "voice_081:r_76f080a4881e8ab5": {
      "text": "Here we go! Macross Attack!",
      "status": "imported"
    },
    "voice_081:r_288133bc5b573dae": {
      "text": "All riiiiight!!",
      "status": "imported"
    },
    "voice_081:r_6f95653e548f8fcf": {
      "text": "All Destroids, attack!",
      "status": "imported"
    },
    "voice_081:r_d249d68bada91ab9": {
      "text": "Heat signature... It's Ghost V9!",
      "status": "imported"
    },
    "voice_081:r_03cdac73042343ee": {
      "text": "We have a Pinpoint Barrier.",
      "status": "imported"
    },
    "voice_081:r_6026da5acbda7c69": {
      "text": "Keep up the Pinpoint Barrier.",
      "status": "imported"
    },
    "voice_081:r_981f8fedd5414fe5": {
      "text": "The Pinpoint Barrier saved us.",
      "status": "imported"
    },
    "voice_081:r_96bb0dcde0c8c44a": {
      "text": "The Quarter won't go down so easily!",
      "status": "imported"
    },
    "voice_081:r_a0f2074af8debbfa": {
      "text": "Give them a barrage of our own!",
      "status": "imported"
    },
    "voice_081:r_b5f5a97ed82acb0b": {
      "text": "Don't let up the attack!",
      "status": "imported"
    },
    "voice_081:r_d9cd2e4ded064396": {
      "text": "Guh!\\nWe can't fall here!",
      "status": "imported"
    },
    "voice_081:r_99e6349431aaf23b": {
      "text": "Ngh! Keep up our anti-air defense!",
      "status": "imported"
    },
    "voice_081:r_ec1081caf845f56a": {
      "text": "Hmm. They're no match for this ship.",
      "status": "imported"
    },
    "voice_081:r_2c5b7ee872c1ed7f": {
      "text": "That attack won't work on this ship.",
      "status": "imported"
    },
    "voice_081:r_0e7466971bec4cc4": {
      "text": "No abnormalities across the hull!",
      "status": "imported"
    },
    "voice_081:r_efa71f7a4cc33ff3": {
      "text": "Prepare for battle!",
      "status": "imported"
    },
    "voice_081:r_3fc2e1186557e7a0": {
      "text": "Delta 1 to all.\\nClear our fire lane!",
      "status": "imported"
    },
    "voice_081:r_fa6930340a545054": {
      "text": "I expect great things from you all!",
      "status": "imported"
    },
    "voice_081:r_2332b9d56461d7ab": {
      "text": "We fight for our dreams,\\nour future!",
      "status": "imported"
    },
    "voice_081:r_854aa0a91a3c80d1": {
      "text": "You lot! This is our final battle!",
      "status": "imported"
    },
    "voice_081:r_0bc8ae32a406ceab": {
