{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_193:r_479b340ccc6c572b": {
      "text": "All right, let's do this!",
      "status": "imported"
    },
    "voice_193:r_77949221bf58f862": {
      "text": "Through for riichi! Win with guts!",
      "status": "imported"
    },
    "voice_193:r_70b9c4b9f1f37eff": {
      "text": "We're no useless junk!\\nNot anymore!",
      "status": "imported"
    },
    "voice_193:r_9fcb3754cb1773c7": {
      "text": "This is for everyone in Division 2!",
      "status": "imported"
    },
    "voice_193:r_3559d2fad32c2435": {
      "text": "Hot-blooded justice, straight ahead!",
      "status": "imported"
    },
    "voice_193:r_f7570547e9f80a64": {
      "text": "Where there's a will, there's a way!",
      "status": "imported"
    },
    "voice_193:r_cbab0f4720e1fcf1": {
      "text": "Citizens! 21st Century Security!",
      "status": "imported"
    },
    "voice_193:r_0bbe0b4f5364e732": {
      "text": "You're safe now!\\nDai-Guard is here!",
      "status": "imported"
    },
    "voice_193:r_5dda5198137cb02a": {
      "text": "Let's go! We'll defend the city!",
      "status": "imported"
    },
    "voice_193:r_83ec59afbecdec14": {
      "text": "Ibuki, Aoyama, are you ready?",
      "status": "imported"
    },
    "voice_193:r_e20bfd42ad95a3c9": {
      "text": "Ready!",
      "status": "imported"
    },
    "voice_193:r_0f58a8822381e57f": {
      "text": "You'd better do this right, Akagi!",
      "status": "imported"
    },
    "voice_193:r_6dbcc507fb61b51d": {
      "text": "Aoyama, raise the output!",
      "status": "imported"
    },
    "voice_193:r_b42ab697149a7c8a": {
      "text": "Roger! But don't push it too far!",
      "status": "imported"
    },
    "voice_193:r_4de4fcf3b440baf4": {
      "text": "Our lives are in your hands! Do it!",
      "status": "imported"
    },
    "voice_193:r_0121a166c715cdff": {
      "text": "We're in this together! Trust me!",
      "status": "imported"
    },
    "voice_193:r_30fad37a42bd3ad3": {
      "text": "First, we take down the enemy ahead!",
      "status": "imported"
    },
    "voice_193:r_80a0b2a84e05d81a": {
      "text": "I know, Ibuki!",
      "status": "imported"
    },
    "voice_193:r_4a9ac1dff86506d9": {
      "text": "Ibuki, what's our distance?",
      "status": "imported"
    },
    "voice_193:r_bc8538e6af3d2577": {
      "text": "They're in range! You can do it!",
      "status": "imported"
    },
    "voice_193:r_924516c8de2b5342": {
      "text": "This time, I'll finish it!",
      "status": "imported"
    },
    "voice_193:r_da1174533722333f": {
      "text": "Then let's give it another shot!",
      "status": "imported"
    },
    "voice_193:r_fdeb8162976e72c1": {
      "text": "Damn Heterodyne!\\nFeel Dai-Guard!",
      "status": "imported"
    },
    "voice_193:r_0fadb5c26df92b42": {
      "text": "Heterodyne\\nPeace warrior Dai-Guard!",
      "status": "imported"
    },
    "voice_193:r_6b15af9a0057cdc8": {
      "text": "This is no time for people to fight!",
      "status": "imported"
    },
    "voice_193:r_af884a6b11dff121": {
      "text": "We civilians have our pride too!",
      "status": "imported"
    },
    "voice_193:r_77ca87eacd17ad52": {
      "text": "Rescue, rebuild.\\nThere's more to do!",
      "status": "imported"
    },
    "voice_193:r_aabfb21c9d069ce7": {
      "text": "Damn! So this is the army's way!",
      "status": "imported"
    },
    "voice_193:r_a2df00f91a9b0a9e": {
      "text": "Dai-Guard isn't a weapon. But...!",
      "status": "imported"
    },
    "voice_193:r_8927e6fb681aa809": {
      "text": "You can't do things like that!",
      "status": "imported"
    },
    "voice_193:r_665f01666859013b": {
      "text": "I won't accept\\nyour twisted logic!",
      "status": "imported"
    },
    "voice_193:r_a571eec59b258d11": {
      "text": "Even if you're fast, I can time it!",
      "status": "imported"
    },
    "voice_193:r_ddbe581c5ea9183d": {
      "text": "Threaten peace,\\nwhoever you are!",
      "status": "imported"
    },
    "voice_193:r_faae935cca0edc72": {
      "text": "We can't let that thing run wild!",
      "status": "imported"
    },
    "voice_193:r_d4430bf362340b32": {
      "text": "Come on, Mechanical Beast! Face us!",
      "status": "imported"
    },
    "voice_193:r_6ff1323b355593e0": {
      "text": "Pest control is part of the job!",
      "status": "imported"
    },
    "voice_193:r_b7b5625d7cd4282f": {
      "text": "Your proposal is rejected!",
      "status": "imported"
    },
    "voice_193:r_36133ad73a73ef98": {
      "text": "Nice pitch, but\\nproposal rejected!",
      "status": "imported"
    },
    "voice_193:r_920740a0219c5085": {
      "text": "Got a point?\\nWrite, stamp, submit!",
      "status": "imported"
    },
    "voice_193:r_a8451712c57c1a72": {
      "text": "I'm a salaryman.\\nMade it! Let's go!",
      "status": "imported"
    },
    "voice_193:r_3633df5b7b8f47fa": {
      "text": "Target: Heterodyne!",
      "status": "imported"
    },
    "voice_193:r_52dfc56b14b93551": {
      "text": "I won't let you do any more damage!",
      "status": "imported"
    },
    "voice_193:r_1b9b2aab5cb104da": {
      "text": "Distance to Heterodyne: 50!",
      "status": "imported"
    },
    "voice_193:r_342044c706a2340f": {
      "text": "Aoyama, increase output!",
      "status": "imported"
    },
    "voice_193:r_cf41e8828a90cbdb": {
      "text": "OK, Akagi!",
      "status": "imported"
    },
    "voice_193:r_719e897304ec42d4": {
      "text": "Don't hit the cockpit, Akagi!",
      "status": "imported"
    },
    "voice_193:r_d5e0a2317c40d322": {
      "text": "I know!",
      "status": "imported"
    },
    "voice_193:r_5d08ad19e2da125b": {
      "text": "Ibuki! Hurry and track the enemy!",
      "status": "imported"
    },
    "voice_193:r_a7246b52782a877e": {
      "text": "Quit yelling yourself red!",
      "status": "imported"
    },
    "voice_193:r_dc8701f6bcb9904f": {
      "text": "You two need to calm down...",
      "status": "imported"
    },
    "voice_193:r_d6bdd730f24f66eb": {
      "text": "This is the real moment of truth...!",
      "status": "imported"
    },
    "voice_193:r_41997412868c48c4": {
      "text": "Stay sharp, Akagi!",
      "status": "imported"
    },
    "voice_193:r_9e6cf4f389dae55c": {
      "text": "Yeah! Finish fast,\\nthen go home!",
      "status": "imported"
    },
    "voice_193:r_9e0c80ac7e33b459": {
      "text": "Final target acquired!",
      "status": "imported"
    },
    "voice_193:r_7432ef43ed3471dc": {
      "text": "This is it! Give it all you've got!",
      "status": "imported"
    },
    "voice_193:r_065443f6ddfcf0d7": {
      "text": "I know! Here we go!",
      "status": "imported"
    },
    "voice_193:r_47d52a2839c71715": {
      "text": "Hyah!",
      "status": "imported"
    },
    "voice_193:r_847f82e7f3eef651": {
      "text": "Aoyama, jump! Full power!",
      "status": "imported"
    },
    "voice_193:r_eb7ae28b53dc033c": {
      "text": "Sei!",
      "status": "imported"
    },
    "voice_193:r_857c4a52ce8df0fd": {
      "text": "Aoyama, maximum output!",
      "status": "imported"
    },
    "voice_193:r_55417493fce1d347": {
      "text": "Taah!",
      "status": "imported"
    },
    "voice_193:r_7d724dbcc4451e10": {
      "text": "Arm parts, connection confirmed!",
      "status": "imported"
    },
    "voice_193:r_93e25418a203cb8f": {
      "text": "Posture-control balancer, power up!",
      "status": "imported"
    },
    "voice_193:r_adeb0a29274d3d9b": {
      "text": "Double Driller, let's go!",
      "status": "imported"
    },
    "voice_193:r_24cf161287ef9d5c": {
      "text": "Raaagh!",
      "status": "imported"
    },
    "voice_193:r_8f60f6fc86db3107": {
      "text": "Parts locked in place!",
      "status": "imported"
    },
    "voice_193:r_b1de76a75a253c13": {
      "text": "You got this, Akagi!",
      "status": "imported"
    },
    "voice_193:r_128c35bf3e0e394c": {
      "text": "Double Driller!",
      "status": "imported"
    },
    "voice_193:r_5213c17e13b23de0": {
      "text": "Oryaaah!",
      "status": "imported"
    },
    "voice_193:r_38fdff9483e9245c": {
      "text": "Parts secured!",
      "status": "imported"
    },
    "voice_193:r_620fedec67706d7d": {
      "text": "Wheel, start! Counting on you!",
      "status": "imported"
    },
    "voice_193:r_9680dcd0fddcfcc7": {
      "text": "Roger! Let's go!",
      "status": "imported"
    },
    "voice_193:r_2a00f1044ad5cbaa": {
      "text": "Take thiiis!",
      "status": "imported"
    },
    "voice_193:r_3dbeead1bd3164ef": {
      "text": "Target locked!",
      "status": "imported"
    },
    "voice_193:r_98d15b8cc09bc915": {
      "text": "Flywheel at critical!",
      "status": "imported"
    },
    "voice_193:r_46e86d000250e137": {
      "text": "Great Knot Punisher,\\nFiiire!",
      "status": "imported"
    },
    "voice_193:r_ac341e7976e88f0b": {
      "text": "Even salarymen can defend peace!",
      "status": "imported"
    },
    "voice_193:r_cdbd128a5b4127cc": {
      "text": "Connection confirmed! Ready to go!",
      "status": "imported"
    },
    "voice_193:r_cfccaa1fbeda124c": {
      "text": "Flywheel, start up!",
      "status": "imported"
    },
    "voice_193:r_b1f8ec192b9c083a": {
      "text": "Gooo!",
      "status": "imported"
    },
    "voice_193:r_a007f9ab9cf048b3": {
      "text": "Oooooh!",
      "status": "imported"
    },
    "voice_193:r_ddafde4b065ced49": {
      "text": "Got you! Now!",
      "status": "imported"
    },
    "voice_193:r_de1213040856c089": {
      "text": "Flywheel, maximum output!",
      "status": "imported"
    },
    "voice_193:r_3304412ac41f47a6": {
      "text": "Doryaaaaah!",
      "status": "imported"
    },
    "voice_193:r_0c0775e051211840": {
      "text": "Keep them safe...\\nThat's our job!",
      "status": "imported"
    },
    "voice_193:r_a2afffe1c396f0b3": {
      "text": "Bastard! You won't get away!",
      "status": "imported"
    },
    "voice_193:r_13c25fbdfddc8a24": {
      "text": "If they hit us, we hit them back!",
      "status": "imported"
    },
    "voice_193:r_42ba1ecb310b4bd7": {
      "text": "We'll pay them back double the pain!",
      "status": "imported"
    },
    "voice_193:r_d692f1d420460a47": {
      "text": "All right! Time to counterattack!",
      "status": "imported"
    },
    "voice_193:r_a5643cec86b18bd2": {
      "text": "Dai-Guard can't catch you?\\nWrong!",
      "status": "imported"
    },
    "voice_193:r_68f2dfab20a4a30e": {
      "text": "Don't tell me you're staying down!?",
      "status": "imported"
    },
    "voice_193:r_9cedad8237480563": {
      "text": "Not a chance! We'll pay them back!",
      "status": "imported"
    },
    "voice_193:r_a03fabecba1508ca": {
      "text": "They hit first, but keep your cool!",
      "status": "imported"
    },
    "voice_193:r_5391b24a71eb10ae": {
      "text": "Enough talk! Counterattack!",
      "status": "imported"
    },
    "voice_193:r_a554ceef5c87b972": {
      "text": "I can still go!",
      "status": "imported"
    },
    "voice_193:r_546c3d5937fbb7ee": {
      "text": "Here's our chance! Let's go!",
      "status": "imported"
    },
    "voice_193:r_1568ff6298b12b96": {
      "text": "Leave the rest to Team Dai-Guard!",
      "status": "imported"
    },
    "voice_193:r_2c9d94ba13c5fc50": {
      "text": "Leave the follow-up to me!",
      "status": "imported"
    },
    "voice_193:r_a77f4913375098d2": {
      "text": "21st Century Security\\nwon't lose!",
      "status": "imported"
    },
    "voice_193:r_428c2116ac3071b1": {
      "text": "Corporate warriors too!\\nWe'll help!",
      "status": "imported"
    },
    "voice_193:r_84c116267b79f540": {
      "text": "I can't let this go!",
      "status": "imported"
    },
    "voice_193:r_dad38ee29af2df3a": {
      "text": "We'll protect it ourselves!",
      "status": "imported"
    },
    "voice_193:r_3d32e86f8dc80909": {
      "text": "Wait, wait! Hold on a second!",
      "status": "imported"
    },
    "voice_193:r_70451ffbabe2f876": {
      "text": "The volunteer spirit never dies!",
      "status": "imported"
    },
    "voice_193:r_69dfa1659715e2fa": {
      "text": "I told you not to look away, Watta!",
      "status": "imported"
    },
    "voice_193:r_d996fd6d4ef5b329": {
      "text": "Mind your blood pressure,\\nDirector!",
      "status": "imported"
    },
    "voice_193:r_8ab47a28f99ef565": {
      "text": "Damn! We can't just stand by!",
      "status": "imported"
    },
    "voice_193:r_546de3fb6db156ea": {
      "text": "At this rate, we're sitting ducks!",
      "status": "imported"
    },
    "voice_193:r_ca85f87cee5e31f7": {
      "text": "Pull Dai-Guard back, Akagi!",
      "status": "imported"
    },
    "voice_193:r_9072ea7bc71df136": {
      "text": "Then why did we even come out...!",
      "status": "imported"
    },
    "voice_193:r_04e815a8d425827d": {
      "text": "Do we have to fall back for now...!?",
      "status": "imported"
    },
    "voice_193:r_d89011fe3e5d082a": {
      "text": "The battery's already dead!",
      "status": "imported"
    },
    "voice_193:r_3c5b0c2ac812d5de": {
      "text": "We can do it with guts!",
      "status": "imported"
    },
    "voice_193:r_5b9e8897190892eb": {
      "text": "That's impossible!",
      "status": "imported"
    },
    "voice_193:r_7bea3023abbf8a94": {
      "text": "Damn! Where'd that thing go!?",
      "status": "imported"
    },
    "voice_193:r_dd01a4c0d1b36a8d": {
      "text": "Crap! I lost it!",
      "status": "imported"
    },
    "voice_193:r_20920ad2eb3542db": {
      "text": "No good. Not from this position...",
      "status": "imported"
    },
    "voice_193:r_0ab7914877fd48ed": {
      "text": "Well, with our weapons, no wonder...",
      "status": "imported"
    },
    "voice_193:r_cb846feec748c2e3": {
      "text": "This is no time for that, you two!",
      "status": "imported"
    },
    "voice_193:r_c958860b0676b1f5": {
      "text": "Dai-Guard's my life!\\nDon't wreck it!",
      "status": "imported"
    },
    "voice_193:r_5e2669b82ef75ce3": {
      "text": "All right! I dodged it!",
      "status": "imported"
    },
    "voice_193:r_7847e0ed7dc9282d": {
      "text": "If that hit, repairs would cost us!",
      "status": "imported"
    },
    "voice_193:r_e42b52c7a987b906": {
      "text": "Can't wreck PR Division 2's mascot!",
      "status": "imported"
    },
    "voice_193:r_6825fd1ff907bd22": {
      "text": "Dodging is how we save on repairs!",
      "status": "imported"
    },
    "voice_193:r_607f666f1563bc0d": {
      "text": "See that, Hetero?\\nDai-Guard's power!",
      "status": "imported"
    },
    "voice_193:r_97b7431eeb81e6b6": {
      "text": "Your attacks will never hit us!",
      "status": "imported"
    },
    "voice_193:r_132f605d02975e71": {
      "text": "All sections, zero damage!",
      "status": "imported"
    },
    "voice_193:r_9b9726b1872759d6": {
      "text": "Not bad, Akagi!",
      "status": "imported"
    },
    "voice_193:r_1252db29683fefe0": {
      "text": "We can't let this thing get wrecked!",
      "status": "imported"
    },
    "voice_193:r_ad3d538f1e909184": {
      "text": "Engine and drive systems normal!",
      "status": "imported"
    },
    "voice_193:r_8c61c59a1c0aebbf": {
      "text": "All right, keep it going!",
      "status": "imported"
    },
    "voice_193:r_aba6a7662129d8ce": {
      "text": "Hey! Did that just graze us!?",
      "status": "imported"
    },
    "voice_193:r_b84afafb8a33ec60": {
      "text": "Excuse me! I dodged by a hair!",
      "status": "imported"
    },
    "voice_193:r_c8c59db85bf875e6": {
      "text": "Dai-Guard is undamaged... Good!",
      "status": "imported"
    },
    "voice_193:r_391aa56435d9dd6e": {
      "text": "Ibuki, what's the damage?",
      "status": "imported"
    },
    "voice_193:r_7c796ba53bd7ea03": {
      "text": "Zero! But don't let your guard down!",
      "status": "imported"
    },
    "voice_193:r_fa944da4b6519006": {
      "text": "We've got a barrier on our side!",
      "status": "imported"
    },
    "voice_193:r_95d047bcc17fccc6": {
      "text": "This lets us focus on the attack!",
      "status": "imported"
    },
    "voice_193:r_640327a12a559b31": {
      "text": "Don't be dumb! It's not invincible!",
      "status": "imported"
    },
    "voice_193:r_bdd38c584fa313d0": {
      "text": "That's right!\\nRead the manual!",
      "status": "imported"
    },
    "voice_193:r_381992c5d8224937": {
      "text": "Damn! Breaking it is a huge hassle!",
      "status": "imported"
    },
    "voice_193:r_f1e7ed9e5874aba5": {
      "text": "Ngh! Is the balancer acting up?",
      "status": "imported"
    },
    "voice_193:r_fc25e66a86fc2c85": {
      "text": "Crap! More damage means a report!",
      "status": "imported"
    },
    "voice_193:r_5aeeb4917340c42d": {
      "text": "Not yet! We only move forward!",
      "status": "imported"
    },
    "voice_193:r_b765659981b6516d": {
      "text": "It's just a dent in the armor!",
      "status": "imported"
    },
    "voice_193:r_0c427458bc00eb95": {
      "text": "Heterodyne!\\nOne lapse, and look!",
      "status": "imported"
    },
    "voice_193:r_774a9ab4d8fd5351": {
      "text": "Ngh! I'll dodge the next one!",
      "status": "imported"
    },
    "voice_193:r_d3f01de714c015bd": {
      "text": "Ten grand says it hits again. Bet?",
      "status": "imported"
    },
    "voice_193:r_7d2617c809fead70": {
      "text": "Absolutely not!",
      "status": "imported"
    },
    "voice_193:r_ceb935ccbf830724": {
      "text": "What are you doing, idiot!?",
      "status": "imported"
    },
    "voice_193:r_862ef7385bf2abd4": {
      "text": "Yeah! Do it right, you idiot!",
      "status": "imported"
    },
    "voice_193:r_001cbec4d9a4283f": {
      "text": "You two say 'idiot' way too much...",
      "status": "imported"
    },
    "voice_193:r_8ad40afecd02b41e": {
      "text": "Why didn't you dodge!?",
      "status": "imported"
    },
    "voice_193:r_26e5efec03c03d78": {
      "text": "I didn't refuse!\\nI couldn't dodge!",
      "status": "imported"
    },
    "voice_193:r_4ad81e88c7557a8b": {
      "text": "That's nothing to brag about!",
      "status": "imported"
    },
    "voice_193:r_1f65a7af190e4674": {
      "text": "Hey! Are you even trying!?",
      "status": "imported"
    },
    "voice_193:r_40c5a9358ed5bf29": {
      "text": "You bet! I've got drive to spare!",
      "status": "imported"
    },
    "voice_193:r_f2e18dfdfe0c89ea": {
      "text": "Left shoulder joint damage: 17%!",
      "status": "imported"
    },
    "voice_193:r_cf7dbf49e96a5755": {
      "text": "Damn! Next time...!",
      "status": "imported"
    },
    "voice_193:r_fa96676cc65bb509": {
      "text": "Damn!\\nBreak it and face paperwork!!",
      "status": "imported"
    },
    "voice_193:r_4e37f92e7d2fc62e": {
      "text": "Can't worry the Division 2 crew!",
      "status": "imported"
    },
    "voice_193:r_66ab4cfe1557909d": {
      "text": "Ngh! N-not yet!",
      "status": "imported"
    },
    "voice_193:r_0bad405ee6ca63ba": {
      "text": "N-not yet! Guts and spirit work!",
      "status": "imported"
    },
    "voice_193:r_2072eaf71a260ae7": {
      "text": "Built to fight them!\\nWe won't lose!",
      "status": "imported"
    },
    "voice_193:r_6c13bbfd27a7799e": {
      "text": "Sub-cameras 4 and 6 destroyed!",
      "status": "imported"
    },
    "voice_193:r_06f88dcbd3c9e738": {
      "text": "Cameras don't matter...!",
      "status": "imported"
    },
    "voice_193:r_b28faf9f71bc3598": {
      "text": "Of course we need them!",
      "status": "imported"
    },
    "voice_193:r_8a29278549f8e07a": {
      "text": "This is why I can't trust you!",
      "status": "imported"
    },
    "voice_193:r_7e6c573c26177f98": {
      "text": "That wasn't my fault!",
      "status": "imported"
    },
    "voice_193:r_45abf84f7757d6eb": {
      "text": "Stop fighting!\\nFocus on dodging!",
      "status": "imported"
    },
    "voice_193:r_edd7a13ab8f06a14": {
      "text": "Aoyama, check the power systems!",
      "status": "imported"
    },
    "voice_193:r_8165e5b41f0124c4": {
      "text": "Barely holding!\\nTwo more hits, tops!",
      "status": "imported"
    },
    "voice_193:r_4e05581b7432cce8": {
      "text": "Generator 3 hit! Output at 60%!",
      "status": "imported"
    },
    "voice_193:r_a60b107ea3c36a86": {
      "text": "Damn...!",
      "status": "imported"
    },
    "voice_193:r_e33693e5ba4665b0": {
      "text": "Left leg actuator damaged!",
      "status": "imported"
    },
    "voice_193:r_72a21a1a489af001": {
      "text": "I'll turn this around from here!",
      "status": "imported"
    },
    "voice_193:r_eb643f8bf737a0ca": {
      "text": "Damn!\\nIf it breaks, we're doomed!!",
      "status": "imported"
    },
    "voice_193:r_0a3fccb71ec6cf2a": {
      "text": "A-ah... A mountain of forms...!",
      "status": "imported"
    },
    "voice_193:r_9b63cf1f3e0207ef": {
      "text": "We carry Earth's peace!\\nCan't lose!",
      "status": "imported"
    },
    "voice_193:r_8356f4e3dcdff938": {
      "text": "Time to bet it all on a comeback!",
      "status": "imported"
    },
    "voice_193:r_1d6d784036ae0bd7": {
      "text": "Engine output has dropped to 20%!",
      "status": "imported"
    },
    "voice_193:r_625664af02183c17": {
      "text": "Abnormalities in every joint drive!",
      "status": "imported"
    },
    "voice_193:r_3701cba361f80ea5": {
      "text": "Damn...!\\nI won't go down here!",
      "status": "imported"
    },
    "voice_193:r_63f429c5c68c0863": {
      "text": "Right upper arm damper damaged!",
      "status": "imported"
    },
    "voice_193:r_38e4a434c91d8ef0": {
      "text": "Any more is bad, Akagi!",
      "status": "imported"
    },
    "voice_193:r_98ed411352a3a6ac": {
      "text": "I know, I know!",
      "status": "imported"
    },
    "voice_193:r_4824bea6bab3af67": {
      "text": "Rear armor plate one detached!",
      "status": "imported"
    },
    "voice_193:r_862b92e63adb9734": {
      "text": "Output is dropping too!",
      "status": "imported"
    },
    "voice_193:r_cb306ef55e49d107": {
      "text": "Y-you bastard...!",
      "status": "imported"
    },
    "voice_193:r_57b2bd2de8a1408d": {
      "text": "What? The relay system froze!?",
      "status": "imported"
    },
    "voice_193:r_76f080a4881e8ab5": {
      "text": "Aoyama, restart it! Hurry!",
      "status": "imported"
    },
    "voice_193:r_288133bc5b573dae": {
      "text": "I'm doing it!",
      "status": "imported"
    },
    "voice_193:r_6f95653e548f8fcf": {
      "text": "Crack in front armor plate three!",
      "status": "imported"
    },
    "voice_193:r_d249d68bada91ab9": {
      "text": "Never give up!\\nOr it's over!",
      "status": "imported"
    },
    "voice_193:r_e9b3307e9eb69f11": {
      "text": "Auto-balancer damaged!",
      "status": "imported"
    },
    "voice_193:r_03cdac73042343ee": {
      "text": "Fall back for now, Akagi!",
      "status": "imported"
    },
    "voice_193:r_6026da5acbda7c69": {
      "text": "A Heterodyne!\\nI can't retreat now!",
      "status": "imported"
    },
    "voice_193:r_981f8fedd5414fe5": {
      "text": "D-daaaamn it!!",
      "status": "imported"
    },
    "voice_193:r_96bb0dcde0c8c44a": {
      "text": "D-Dai-Guard!!",
      "status": "imported"
    },
    "voice_193:r_641550a2f54cb456": {
      "text": "Battery at zero!",
      "status": "imported"
    },
    "voice_193:r_a0f2074af8debbfa": {
      "text": "Main generator stopped!",
      "status": "imported"
    },
    "voice_193:r_b5f5a97ed82acb0b": {
      "text": "Damn it! Move! Come on, move!",
      "status": "imported"
    },
    "voice_193:r_d9cd2e4ded064396": {
      "text": "Let's go, Dai-Guard!",
      "status": "imported"
    },
    "voice_193:r_99e6349431aaf23b": {
      "text": "Launch!",
      "status": "imported"
    },
    "voice_193:r_ec1081caf845f56a": {
      "text": "Both sides balanced! Sensors clear!",
      "status": "imported"
    },
    "voice_193:r_2c5b7ee872c1ed7f": {
      "text": "Main generator: 98%! Power contact!",
      "status": "imported"
    },
    "voice_193:r_76d1e51c8b494a60": {
      "text": "Let's go! Dai-Guard, launch!",
      "status": "imported"
    },
    "voice_193:r_eb5f687fcd372ae7": {
      "text": "Target: Lockon!",
      "status": "imported"
    },
    "voice_193:r_2329428a6871d9fa": {
      "text": "What you're doing\\nis totally wrong!",
      "status": "imported"
    },
    "voice_193:r_279da5f732aa8847": {
      "text": "Fear reports?\\nThen don't pilot!",
      "status": "imported"
    },
    "voice_193:r_97f82e3cb6f70110": {
      "text": "Adapt on-site!\\nRight, Shirota?",
      "status": "imported"
    },
    "voice_193:r_c5611d8dd6def96b": {
      "text": "With our teamwork, we can do it!",
      "status": "imported"
    },
    "voice_193:r_6f12cc8ed2732eb5": {
      "text": "We have teamwork?",
      "status": "imported"
    },
    "voice_193:r_7abfc55f8fb62ba7": {
      "text": "H-hey, Aoyama!",
      "status": "imported"
    },
    "voice_193:r_99e7a66c650b5892": {
      "text": "No one dies...!\\nNot even you!",
      "status": "imported"
    },
    "voice_193:r_aeea0893acb93d35": {
      "text": "Now it's our turn!",
      "status": "imported"
    },
    "voice_193:r_b31568654e53487b": {
      "text": "After-sales service, guaranteed!",
      "status": "imported"
    },
    "voice_193:r_2502132569141ea3": {
      "text": "Chief Osugi, Shirota, I'm sorry...!",
      "status": "imported"
    },
    "voice_193:r_1ff312798a52c8eb": {
      "text": "Uwaah!\\nDid the balancer go haywire!?",
      "status": "imported"
    },
    "voice_193:r_fa07d90fca62f593": {
      "text": "Not yet! I won't let them beat me!",
      "status": "imported"
    },
    "voice_193:r_a25bf2676ecf9d83": {
      "text": "Our lives are at risk! Retreat!",
      "status": "imported"
    },
    "voice_193:r_237a0288b42dce20": {
      "text": "I won't run!\\nNo one will mock me...!",
      "status": "imported"
    },
    "voice_193:r_0556e8a22779ea8e": {
      "text": "Ibuki...",
      "status": "imported"
    },
    "voice_193:r_09d377101a48d92a": {
      "text": "Kyaaaah!",
      "status": "imported"
    },
    "voice_193:r_11517cc7b0494dbf": {
      "text": "Damn! I have to protect Ibuki...",
      "status": "imported"
    },
    "voice_193:r_b5864501463db244": {
      "text": "Then hurry up and do something!",
      "status": "imported"
    },
    "voice_193:r_a88939ea84b4474d": {
      "text": "You bastard! I'll turn this around!",
      "status": "imported"
    },
    "voice_193:r_a870d0cf7cc11ec6": {
      "text": "Ugh... Another incident report, huh.",
      "status": "imported"
    },
    "voice_193:r_03f6158ef83964f3": {
      "text": "Aoyama, what's with the balancer!?",
      "status": "imported"
    },
    "voice_193:r_2970a83693cdcc25": {
      "text": "That last hit damaged it!",
      "status": "imported"
    },
    "voice_193:r_be661448b85d0009": {
      "text": "External armor damage: 48.7%!",
      "status": "imported"
    },
    "voice_193:r_958a56c1151cab9e": {
      "text": "Not yet! If it moves, I can manage!",
      "status": "imported"
    },
    "voice_193:r_8b18aa4cc69547df": {
      "text": "Damage like this won't stop me!",
      "status": "imported"
    },
    "voice_193:r_3e87f6fc3ea65aef": {
      "text": "Hey! That hit us!",
      "status": "imported"
    },
    "voice_193:r_5508a7bfa9074eb9": {
      "text": "Accident, incident, damage. Thanks!",
      "status": "imported"
    },
    "voice_193:r_09a003e91f0d5dc7": {
      "text": "Guard their happiness, and get this.",
      "status": "imported"
    },
    "voice_193:r_192447448ebd7bb5": {
      "text": "Management says,\\nCut costs...",
      "status": "imported"
    },
    "voice_193:r_e92920ba4b301b9f": {
      "text": "Let's keep charging at this pace!",
      "status": "imported"
    },
    "voice_193:r_207b256d613bb896": {
      "text": "Whoa there! That was close...",
      "status": "imported"
    },
    "voice_193:r_a6fd676d8146501b": {
      "text": "Sheesh...\\nI'd need endless lives...",
      "status": "imported"
    },
    "voice_193:r_94d35e5fa8e3a198": {
      "text": "Ibuki!\\nPretty good move, right!?",
      "status": "imported"
    },
    "voice_193:r_b686510e636673f3": {
      "text": "Just watch what's in front of you!",
      "status": "imported"
    },
    "voice_193:r_59369bad143d4272": {
      "text": "This equipment's really handy!",
      "status": "imported"
    },
    "voice_193:r_25f9b1e39dd8d366": {
      "text": "Why can't I attack!?",
      "status": "imported"
    },
    "voice_193:r_307477bedd148060": {
      "text": "Help each other in times of need!",
      "status": "imported"
    },
    "voice_193:r_09a780acca0eb4b0": {
      "text": "What? Why can't I attack!?",
      "status": "imported"
    },
    "voice_193:r_af62f2ee466b5c8c": {
      "text": "Hit them fast, before they hit us!",
      "status": "imported"
    },
    "voice_193:r_20cfb719db02fafd": {
      "text": "Protect lives!\\nThat's our mission!",
      "status": "imported"
    },
    "voice_193:r_570c1fdf72edb283": {
      "text": "Dai-Guard,\\ncommencing interception!",
      "status": "imported"
    },
    "voice_193:r_23f0d87a5a6cfca1": {
      "text": "Anywhere, anytime,\\nwe go all out!",
      "status": "imported"
    },
    "voice_193:r_60c94ea4eb7f7404": {
      "text": "Charge in, then finish with a bang!",
      "status": "imported"
    },
    "voice_193:r_727b2ee0277f9159": {
      "text": "Reckless is my specialty!",
      "status": "imported"
    },
    "voice_193:r_cff4d2eae8a939ed": {
      "text": "New Dai-Guard, let's go!",
      "status": "imported"
    },
    "voice_193:r_1428fe5f35a9427b": {
      "text": "Reborn Dai-Guard -\\nsee its power!",
      "status": "imported"
    },
    "voice_193:r_96d39b8bdfa6f183": {
      "text": "We've powered up, so let's deliver!",
      "status": "imported"
    },
    "voice_193:r_0e4f9b8a2d26ebff": {
      "text": "Output is stable!",
      "status": "imported"
    },
    "voice_193:r_79e0d542fe12bcf7": {
      "text": "Then I'm going all out!",
      "status": "imported"
    },
    "voice_193:r_eff747ba39a55393": {
      "text": "This is way beyond civilian work!",
      "status": "imported"
    },
    "voice_193:r_b2dc77aa6dd77e69": {
      "text": "Even so,\\nwe can't just abandon it!",
      "status": "imported"
    },
    "voice_193:r_445d40d8b5d7092b": {
      "text": "Battery draining!\\nFinish them fast!",
      "status": "imported"
    },
    "voice_193:r_bbb633cb5e8e6daf": {
      "text": "That's always my plan!",
      "status": "imported"
    },
    "voice_193:r_0abd8b6c713ccdac": {
      "text": "All right, perfect timing!",
      "status": "imported"
    },
    "voice_193:r_f4ff463b2fda1b86": {
      "text": "We'll overwhelm them all at once!",
      "status": "imported"
    },
    "voice_193:r_4e63c037d3cb8a3d": {
      "text": "Don't let the enemy catch a breath!",
      "status": "imported"
    },
    "voice_193:r_9ca8d188ae805e3a": {
      "text": "I know already!",
      "status": "imported"
    },
    "voice_193:r_795ed21f3e28e1f5": {
      "text": "No holding back! Get serious, Watta!",
      "status": "imported"
    },
    "voice_193:r_141415c1def5ab2d": {
      "text": "Show our company pride!\\nPresident!",
      "status": "imported"
    },
    "voice_193:r_c894e35becf35a03": {
      "text": "Dai-Guard vs. Trider!\\nCan't lose!",
      "status": "imported"
    },
    "voice_193:r_79b1abf5fc86483c": {
      "text": "Sorry, Directors...!",
      "status": "imported"
    },
    "voice_193:r_e9a11621911acb19": {
      "text": "We can't lose even a mock battle!",
      "status": "imported"
    },
    "voice_193:r_d52bece55796f599": {
      "text": "It's come to this. Fight for real!",
      "status": "imported"
    },
    "voice_193:r_358fe5a50bbee1df": {
      "text": "Watch me, Iizuka Sensei!",
      "status": "imported"
    },
    "voice_193:r_638834e16724002f": {
      "text": "Come, Red Dragon! Let's fight!",
      "status": "imported"
    },
    "voice_193:r_b02fca1590ac1210": {
      "text": "Lose to Akaten and you flunk!",
      "status": "imported"
    },
    "voice_193:r_f0344d2fbaa9db77": {
      "text": "There are ways besides war!",
      "status": "imported"
    },
    "voice_193:r_3328eef766ff2c2c": {
      "text": "Why\\nis that the only way you know!?",
      "status": "imported"
    },
    "voice_193:r_23b037cf6ccc695c": {
      "text": "For peace!\\nI'll stop you!",
      "status": "imported"
    },
    "voice_193:r_883ad1128d340c5e": {
      "text": "So, more than triple speed? Got it!",
      "status": "imported"
    },
    "voice_193:r_a9e6ed99025a703b": {
      "text": "Though we once fought together...!",
      "status": "imported"
    },
    "voice_193:r_b0d1459d6daeebbe": {
      "text": "We're both red!\\nI can't lose!",
      "status": "imported"
    },
    "voice_193:r_cd4893b409472e97": {
      "text": "Space Monster! You won't pass me!",
      "status": "imported"
    },
    "voice_193:r_5691cc71770ffdde": {
      "text": "We'll protect peace in space too!",
      "status": "imported"
    },
    "voice_193:r_db54e717bff3e3b2": {
      "text": "Is that what a god does!?",
      "status": "imported"
    },
    "voice_193:r_fcab8d80aef7e9d8": {
      "text": "Break the field to gain a chance!",
      "status": "imported"
    },
    "voice_193:r_2174bd0edc164171": {
      "text": "I won't allow\\nThird Impact!",
      "status": "imported"
    },
    "voice_193:r_ad54419336b49578": {
      "text": "Hold on! I'm coming to save you!",
      "status": "imported"
    },
    "voice_193:r_63c353e1e05e8e39": {
      "text": "Bear with it a little longer...!",
      "status": "imported"
    },
    "voice_193:r_87646dd472438e88": {
      "text": "I won't let you abduct anyone!",
      "status": "imported"
    },
    "voice_193:r_4e32ac89cba02001": {
      "text": "You're in too much of a hurry!",
      "status": "imported"
    },
    "voice_193:r_02d24e5915bfa5b7": {
      "text": "Memories matter!\\nDon't erase them!",
      "status": "imported"
    },
    "voice_193:r_9331c2c2ef55c78f": {
      "text": "I'm warning you! I'm truly furious!",
      "status": "imported"
    },
    "voice_193:r_49734bdb3507acf7": {
      "text": "No more dirty tricks!",
      "status": "imported"
    },
    "voice_193:r_1e5842ba5dc3f705": {
      "text": "One last bet on you! Don't lose!",
      "status": "imported"
    },
    "voice_193:r_9747bd61ad23ecd3": {
      "text": "Of course!\\nWe carry all their hopes!",
      "status": "imported"
    },
    "voice_193:r_d6c7a401f55ee42f": {
      "text": "I'll smash you with the wheel!",
      "status": "imported"
    },
    "voice_193:r_7bce428a8c95c22c": {
      "text": "Flywheel has plenty of uses!",
      "status": "imported"
    },
    "voice_193:r_97b5fedc5b19e6af": {
      "text": "Take the Flywheel!",
      "status": "imported"
    },
    "voice_193:r_111aa50202ff773f": {
      "text": "I deliver! Count on Shunsuke Akagi!",
      "status": "imported"
    },
    "voice_193:r_10cb1d3f8f325f52": {
      "text": "Now, time for the star to enter!",
      "status": "imported"
    },
    "voice_193:r_ed69cbf9ff3779a7": {
      "text": "Hold your head higher, Shinji!",
      "status": "imported"
    },
    "voice_193:r_82e0a318411dcbf7": {
      "text": "Nice attack, Shinji!",
      "status": "imported"
    },
    "voice_193:r_36c402609f13ec14": {
      "text": "You're champions of justice too!",
      "status": "imported"
    },
    "voice_193:r_5ec6634ac287489a": {
      "text": "We adults had better step up too!",
      "status": "imported"
    },
    "voice_193:r_0f6c6e8f33422ecf": {
      "text": "Dai-Guard is everyone's shield!",
      "status": "imported"
    },
    "voice_193:r_035b4f6912ba7eed": {
      "text": "Protecting people is a fine job too!",
      "status": "imported"
    },
    "voice_193:r_f74b67b3cfcbe05c": {
      "text": "Times like this, lean on us, Shinji!",
      "status": "imported"
    },
    "voice_193:r_6d8a80e2956870ed": {
      "text": "Shinji! Leave this to me!",
      "status": "imported"
    },
    "voice_193:r_426b68d671486c8e": {
      "text": "This is a job for adults!",
      "status": "imported"
    },
    "voice_193:r_ae913eb08e0ff29b": {
      "text": "I won't let them steal future hope!",
      "status": "imported"
    },
    "voice_193:r_6fbc129ae3a24bb0": {
      "text": "Damn you, coward!",
      "status": "imported"
    },
    "voice_193:r_0e58a97c7f8c9ecf": {
      "text": "Tricks won't cut it.\\nWhy hire me!?",
      "status": "imported"
    },
    "voice_193:r_46e80691278d2e90": {
      "text": "This is the most basic of basics!",
      "status": "imported"
    },
    "voice_193:r_c4c8af04ee11993c": {
      "text": "Our experience level has risen too!",
      "status": "imported"
    },
    "voice_193:r_ef1ca3b6b4a983b9": {
      "text": "Tuning the legs is paying off!",
      "status": "imported"
    },
    "voice_193:r_cdfaf9cd1fd55c77": {
      "text": "Well?\\nBehold reborn Dai-Guard!",
      "status": "imported"
    },
    "voice_193:r_3d2454ac7a0fed22": {
      "text": "Huh? How'd they dodge that?",
      "status": "imported"
    },
    "voice_193:r_437f5e90c3bb0592": {
      "text": "Because I reduced our output!",
      "status": "imported"
    },
    "voice_193:r_cf9a2e6954ba3564": {
      "text": "Huh. You actually did well for once!",
      "status": "imported"
    },
    "voice_193:r_a9474d20d8dd3193": {
      "text": "What's that supposed to mean!?",
      "status": "imported"
    },
    "voice_193:r_d1b635ea0c0c2d67": {
      "text": "We've survived\\nour share of hell!",
      "status": "imported"
    },
    "voice_193:r_b8b0c93fd828bea6": {
      "text": "Failed then,\\nsuper salaryman now!",
      "status": "imported"
    },
    "voice_193:r_eb6326b22b74aaf5": {
      "text": "Sorry, Watta!\\nOur firm's at stake!",
      "status": "imported"
    },
    "voice_193:r_4561a1a3695f1597": {
      "text": "Sponsors!\\nThis is Dai-Guard!",
      "status": "imported"
    },
    "voice_193:r_e756cef3d5de51e9": {
      "text": "21st Century Security\\nmeans safety!",
      "status": "imported"
    },
    "voice_193:r_5b9baad61908571a": {
      "text": "New armor really is something else!",
      "status": "imported"
    },
    "voice_193:r_7eedcce1036b4f4a": {
      "text": "Oh no! New Dai-Guard got scratched!",
      "status": "imported"
    },
    "voice_193:r_e016bd611281c0a6": {
      "text": "You're lacking guts and much more!",
      "status": "imported"
    },
    "voice_193:r_aa211e3c1f473e51": {
      "text": "You bastard! You made fools of us!",
      "status": "imported"
    },
    "voice_193:r_c07813b8d06a7217": {
      "text": "Not us. You, right?",
      "status": "imported"
    },
    "voice_193:r_febe65de885f155a": {
      "text": "The higher-ups won't let this slide.",
      "status": "imported"
    },
    "voice_193:r_c081014541c22ae4": {
      "text": "Well, let's all share the blame...",
      "status": "imported"
    },
    "voice_193:r_3840c01b1a9bf34b": {
      "text": "Sumida and Rika are gonna be mad...",
      "status": "imported"
    },
    "voice_193:r_f03ef5034d024e8e": {
      "text": "Crap!\\nOur budget was slashed...!",
      "status": "imported"
    },
    "voice_193:r_bc1a77b291081b0f": {
      "text": "More damage,\\nthen the board calls!",
      "status": "imported"
    },
    "voice_193:r_94089c60b94d9a81": {
      "text": "I'll turn this around in one shot!",
      "status": "imported"
    },
    "voice_193:r_56edc0d4b579afd1": {
      "text": "And what backs up that confidence?",
      "status": "imported"
    },
    "voice_193:r_42c897bd608f37fd": {
      "text": "Spirit and guts!",
      "status": "imported"
    },
    "voice_193:r_689700a088dc2f5b": {
      "text": "This is bad... But we'll manage...!",
      "status": "imported"
    },
    "voice_193:r_5a1e097aa0ec9859": {
      "text": "What do you mean, manage somehow!?",
      "status": "imported"
    },
    "voice_193:r_2a8d41aa8f4749ec": {
      "text": "Sorry, both!\\nYour lives are on me!",
      "status": "imported"
    },
    "voice_193:r_870a7c766b4e2144": {
      "text": "Same as above!",
      "status": "imported"
    },
    "voice_193:r_a9f39df34c38f5b3": {
      "text": "Not bad! Worthy of Iizuka Sensei!",
      "status": "imported"
    },
    "voice_193:r_c9f83672cc4c8866": {
      "text": "Akaten\\ncan't beat Red Dragon...!?",
      "status": "imported"
    },
    "voice_193:r_19631c3492e99773": {
      "text": "Takeo General's\\ntrue strength...!",
      "status": "imported"
    },
    "voice_193:r_a49cb27d62c078ed": {
      "text": "Damn! Trider really is strong!",
      "status": "imported"
    },
    "voice_193:r_aa6642a8b00c07f9": {
      "text": "At this rate,\\nWatta gets our work!",
      "status": "imported"
    },
    "voice_193:r_b6a1f76ff2f0b93d": {
      "text": "Crap! The Director has more guts!",
      "status": "imported"
    },
    "voice_193:r_9ca308feda543481": {
      "text": "We powered up!\\nWe won't lose now!",
      "status": "imported"
    },
    "voice_193:r_323506822dc933d1": {
      "text": "I can still act, so I won't give up!",
      "status": "imported"
    },
    "voice_193:r_a60677a64d47d57d": {
      "text": "There's still work only we can do!",
      "status": "imported"
    },
    "voice_193:r_eb27b8cd0e427016": {
      "text": "Sheesh, what an unrewarding job...!",
      "status": "imported"
    },
    "voice_193:r_d99d6b303b9eca7a": {
      "text": "Not just a job!\\nIt's human decency!",
      "status": "imported"
    },
    "voice_193:r_46e646d7ceafbf12": {
      "text": "A hero acts\\nwhen it matters, right!?",
      "status": "imported"
    },
    "voice_193:r_2f49681a2d6f9e2b": {
      "text": "Naturally!",
      "status": "imported"
    },
    "voice_193:r_645e1e5c1c16c791": {
      "text": "Commander says retreat, you know?",
      "status": "imported"
    },
    "voice_193:r_f8ed7cb3cc3d3275": {
      "text": "Like we'd listen to that!",
      "status": "imported"
    },
    "voice_193:r_05e4c8c66077e99e": {
      "text": "Figured...",
      "status": "imported"
    },
    "voice_193:r_8d9b4fc385aef7c5": {
      "text": "Whoa!\\nDai-Guard went down!",
      "status": "imported"
    },
    "voice_193:r_00f6ca39fc3acf2f": {
      "text": "Sorry, Chief!\\nI gave it my all!",
      "status": "imported"
    },
    "voice_193:r_5007f4e5632e10dc": {
      "text": "N-no! Another failing grade!",
      "status": "imported"
    },
    "voice_193:r_07aec1c333dfbb19": {
      "text": "Beat Gaiou, now the world's a mess!",
      "status": "imported"
    },
    "voice_193:r_107aa098b3ff1499": {
      "text": "Can a mere salaryman handle this!?",
      "status": "imported"
    },
    "voice_193:r_77289aae7685d872": {
      "text": "Next: SRW Z3 - The Sealed World!",
      "status": "imported"
    },
    "voice_193:r_5b29d293c437429d": {
      "text": "A salaryman can defend peace too!",
      "status": "imported"
    },
    "voice_193:r_03a3a973128986f1": {
      "text": "Stopping? I'm hooked! Keep playing!",
      "status": "imported"
    },
    "voice_193:r_13209866a96cdb7e": {
      "text": "True, but use Spirit and Vigor!",
      "status": "imported"
    },
    "voice_193:r_58fa3a0d2bd59f45": {
      "text": "You had a command like that!?",
      "status": "imported"
    },
    "voice_193:r_6290e34747497854": {
      "text": "What's this private-use thing...?",
      "status": "imported"
    },
    "voice_193:r_20f27bcf531af7a7": {
      "text": "Sorry, Aoyama! I'm gonna push it!",
      "status": "imported"
    },
    "voice_193:r_d6e13e5d6953bb84": {
      "text": "So, same as always!",
      "status": "imported"
    },
    "voice_193:r_3baf3d844fb1d682": {
      "text": "Dai-Guard, maximum output!",
      "status": "imported"
    },
    "voice_193:r_3360fe6adb1d6342": {
      "text": "Uoryaaaaah!",
      "status": "imported"
    },
    "voice_193:r_5102781c1e823018": {
      "text": "Take thiiiiiis!",
      "status": "imported"
    },
    "voice_193:r_21062243b0a51b01": {
      "text": "We'll have to take the gamble...!",
      "status": "imported"
    },
    "voice_193:r_ecb10ae1dba4d07b": {
      "text": "Will makes a way!\\nUse your forte!",
      "status": "imported"
    },
    "voice_193:r_ff4fca801d10da93": {
      "text": "Dai-Guard, output at maximum!",
      "status": "imported"
    },
    "voice_193:r_248e2e68f66891d5": {
      "text": "Don't push players. Overtime sucks!",
      "status": "imported"
    },
    "voice_193:r_dc569fdc0d6c30a3": {
      "text": "Players, save your Spirit Command!",
      "status": "imported"
    },
    "voice_193:r_e58eebaa984b6a93": {
      "text": "So I'll give you Bless and Cheer!",
      "status": "imported"
    },
    "voice_193:r_75727ed69511d963": {
      "text": "Private use. Players, see you again!",
      "status": "imported"
    },
    "voice_193:r_d876f2286c3c1194": {
      "text": "No feuds. Target allies, not foes...",
      "status": "imported"
    },
    "voice_193:r_c4afbc5dcb6aff0f": {
      "text": "I'll go on ahead. See you, everyone!",
      "status": "imported"
    },
    "voice_193:r_30f0f30fbc8a7ba7": {
      "text": "You\\nhave no right to fix the world!",
      "status": "imported"
    },
    "voice_193:r_814dde2abac39def": {
      "text": "People mustn't\\ncross that line!",
      "status": "imported"
    },
    "voice_193:r_d23baf327f21df3d": {
      "text": "Let's do it! Combo Attack!",
      "status": "imported"
    },
    "voice_193:r_29b7ea4092df4b1b": {
      "text": "Dai-Guard, charge!!",
      "status": "imported"
    },
    "voice_193:r_f534186539acfbc2": {
      "text": "Net Gun, fire!",
      "status": "imported"
    },
    "voice_193:r_c17bbeb7638f9448": {
      "text": "Time to show what I can do!",
      "status": "imported"
    },
    "voice_193:r_8bd9a45beabc7906": {
      "text": "Let's go, Dai-Guard!\\nFull throttle!",
      "status": "imported"
    },
    "voice_193:r_cd9a2530d3339bb9": {
      "text": "Finger Net, fire!",
      "status": "imported"
    },
    "voice_193:r_08e1901fa81a3ce2": {
      "text": "Once I decide, it's straight ahead!",
      "status": "imported"
    },
    "voice_193:r_c33c630320a0f42d": {
      "text": "Uoooooh! Charge!!",
      "status": "imported"
    },
    "voice_193:r_2890b43c4f3875b2": {
      "text": "Oryah!",
      "status": "imported"
    },
    "voice_193:r_857d69cc06534ed0": {
      "text": "I'll cling to you and stop you!",
      "status": "imported"
    },
    "voice_193:r_abadc65ae19c6a47": {
      "text": "Just draw their attention...!",
      "status": "imported"
    },
    "voice_193:r_5f804641f79a8d84": {
      "text": "We'll act as the decoy!",
      "status": "imported"
    },
    "voice_193:r_06de74b3649b56a6": {
      "text": "We're fine in a supporting role!",
      "status": "imported"
    },
    "voice_193:r_c564bb4a57113de9": {
      "text": "Let's fight fair and square!",
      "status": "imported"
    },
    "voice_193:r_35d7693142bfac0c": {
      "text": "You're a worthy opponent!",
      "status": "imported"
    },
    "voice_193:r_a8ba71836345ee71": {
      "text": "This is my job!",
      "status": "imported"
    },
    "voice_193:r_bbce9cc348b5fec2": {
      "text": "Dai-Guard will grapple you head-on!",
      "status": "imported"
    },
    "voice_193:r_6a33536cdb9e9c32": {
      "text": "Roger! We'll cooperate here!",
      "status": "imported"
    },
    "voice_193:r_93b13f545db4d55e": {
      "text": "Adults deliver when entrusted!",
      "status": "imported"
    },
    "voice_193:r_49f278326a3ba3df": {
      "text": "We'll handle that one!",
      "status": "imported"
    },
    "voice_193:r_00d67eda0ca8bcac": {
      "text": "OK! We'll do it right!",
      "status": "imported"
    }
  }
}
