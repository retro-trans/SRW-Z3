{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_014:r_479b340ccc6c572b": {
      "text": "Commencing attack!",
      "status": "imported"
    },
    "voice_014:r_77949221bf58f862": {
      "text": "Now, the time for battle has come!",
      "status": "imported"
    },
    "voice_014:r_70b9c4b9f1f37eff": {
      "text": "Receive my attack!",
      "status": "imported"
    },
    "voice_014:r_9fcb3754cb1773c7": {
      "text": "I will keep fighting!",
      "status": "imported"
    },
    "voice_014:r_3559d2fad32c2435": {
      "text": "I will fulfill my mission!",
      "status": "imported"
    },
    "voice_014:r_f7570547e9f80a64": {
      "text": "To fight like this is also my joy!",
      "status": "imported"
    },
    "voice_014:r_cbab0f4720e1fcf1": {
      "text": "I won't surrender tomorrow's hope!",
      "status": "imported"
    },
    "voice_014:r_0bbe0b4f5364e732": {
      "text": "I will safeguard human evolution!",
      "status": "imported"
    },
    "voice_014:r_5dda5198137cb02a": {
      "text": "Halt our evolution-\\nyou are my foe!",
      "status": "imported"
    },
    "voice_014:r_83ec59afbecdec14": {
      "text": "I'll challenge you time and again!",
      "status": "imported"
    },
    "voice_014:r_e20bfd42ad95a3c9": {
      "text": "My attack is not over yet!",
      "status": "imported"
    },
    "voice_014:r_0f58a8822381e57f": {
      "text": "Baal! You won't have your way!",
      "status": "imported"
    },
    "voice_014:r_b42ab697149a7c8a": {
      "text": "I reject humanity's extinction!",
      "status": "imported"
    },
    "voice_014:r_0121a166c715cdff": {
      "text": "Humanity moves forward!\\nBeyond you!",
      "status": "imported"
    },
    "voice_014:r_80a0b2a84e05d81a": {
      "text": "I will not accept your wish!",
      "status": "imported"
    },
    "voice_014:r_4a9ac1dff86506d9": {
      "text": "Pitiful Geminis!\\nI'll finish you!",
      "status": "imported"
    },
    "voice_014:r_bc8538e6af3d2577": {
      "text": "Woeful remnant!\\nI purge your karma!",
      "status": "imported"
    },
    "voice_014:r_924516c8de2b5342": {
      "text": "Gadlight Meonsam!\\nFace me!",
      "status": "imported"
    },
    "voice_014:r_da1174533722333f": {
      "text": "Taiji's power\\nisn't yours alone!",
      "status": "imported"
    },
    "voice_014:r_fdeb8162976e72c1": {
      "text": "Your Sphere's power\\nyou cannot use!",
      "status": "imported"
    },
    "voice_014:r_0fadb5c26df92b42": {
      "text": "You cannot evade this barrage!",
      "status": "imported"
    },
    "voice_014:r_6b15af9a0057cdc8": {
      "text": "Scramble Edge!",
      "status": "imported"
    },
    "voice_014:r_15b4a90140e8a33a": {
      "text": "Take the final blow!",
      "status": "imported"
    },
    "voice_014:r_af884a6b11dff121": {
      "text": "Scramble Edge! Go!",
      "status": "imported"
    },
    "voice_014:r_ac6fe7838e95647b": {
      "text": "You will not escape!",
      "status": "imported"
    },
    "voice_014:r_77ca87eacd17ad52": {
      "text": "This will finish it!",
      "status": "imported"
    },
    "voice_014:r_bf3244994760e535": {
      "text": "With Asclepus's speed!",
      "status": "imported"
    },
    "voice_014:r_aabfb21c9d069ce7": {
      "text": "I'll bring this to Cross Combat!",
      "status": "imported"
    },
    "voice_014:r_02479dc8fe989560": {
      "text": "Haaaaah!",
      "status": "imported"
    },
    "voice_014:r_a2df00f91a9b0a9e": {
      "text": "I will strike true!",
      "status": "imported"
    },
    "voice_014:r_48b60d6c48b9b142": {
      "text": "Folding Smasher!",
      "status": "imported"
    },
    "voice_014:r_8927e6fb681aa809": {
      "text": "Smasher deployed! Fire!",
      "status": "imported"
    },
    "voice_014:r_665f01666859013b": {
      "text": "Two serpents shall strike the foe!",
      "status": "imported"
    },
    "voice_014:r_a571eec59b258d11": {
      "text": "Serpent's jaws, devour the foe!",
      "status": "imported"
    },
    "voice_014:r_ddbe581c5ea9183d": {
      "text": "Serpent's fangs, don't let it flee!",
      "status": "imported"
    },
    "voice_014:r_faae935cca0edc72": {
      "text": "Liberator! Come to my hand!",
      "status": "imported"
    },
    "voice_014:r_d4430bf362340b32": {
      "text": "Target Insight!",
      "status": "imported"
    },
    "voice_014:r_6ff1323b355593e0": {
      "text": "G Dimension! Fire!",
      "status": "imported"
    },
    "voice_014:r_b7b5625d7cd4282f": {
      "text": "This is your destiny.",
      "status": "imported"
    },
    "voice_014:r_36133ad73a73ef98": {
      "text": "I release you from causality!",
      "status": "imported"
    },
    "voice_014:r_920740a0219c5085": {
      "text": "Liberator, deploy!",
      "status": "imported"
    },
    "voice_014:r_a8451712c57c1a72": {
      "text": "Astral Shot!",
      "status": "imported"
    },
    "voice_014:r_3633df5b7b8f47fa": {
      "text": "Rest in peace.",
      "status": "imported"
    },
    "voice_014:r_52dfc56b14b93551": {
      "text": "Open, dimensional corridor!",
      "status": "imported"
    },
    "voice_014:r_1b9b2aab5cb104da": {
      "text": "I now unravel causality's spiral!",
      "status": "imported"
    },
    "voice_014:r_342044c706a2340f": {
      "text": "Liberator Discharge!",
      "status": "imported"
    },
    "voice_014:r_cf41e8828a90cbdb": {
      "text": "This is the world's true form.",
      "status": "imported"
    },
    "voice_014:r_adeb0a29274d3d9b": {
      "text": "Now, it is my turn to act!",
      "status": "imported"
    },
    "voice_014:r_24cf161287ef9d5c": {
      "text": "Do not think you can escape!",
      "status": "imported"
    },
    "voice_014:r_8f60f6fc86db3107": {
      "text": "You are the one who attacked first!",
      "status": "imported"
    },
    "voice_014:r_b1de76a75a253c13": {
      "text": "I must give you your due.",
      "status": "imported"
    },
    "voice_014:r_128c35bf3e0e394c": {
      "text": "Turn the other cheek?\\nNot today.",
      "status": "imported"
    },
    "voice_014:r_5213c17e13b23de0": {
      "text": "I dislike a one-sided beating.",
      "status": "imported"
    },
    "voice_014:r_38fdff9483e9245c": {
      "text": "That was a grievous error.",
      "status": "imported"
    },
    "voice_014:r_620fedec67706d7d": {
      "text": "I let the foe escape. How shameful.",
      "status": "imported"
    },
    "voice_014:r_9680dcd0fddcfcc7": {
      "text": "The foe is slyer than I expected.",
      "status": "imported"
    },
    "voice_014:r_2a00f1044ad5cbaa": {
      "text": "What a pity for you.",
      "status": "imported"
    },
    "voice_014:r_3dbeead1bd3164ef": {
      "text": "I saw that attack coming.",
      "status": "imported"
    },
    "voice_014:r_98d15b8cc09bc915": {
      "text": "It is futile even to try.",
      "status": "imported"
    },
    "voice_014:r_46e86d000250e137": {
      "text": "Yes... This was inevitable.",
      "status": "imported"
    },
    "voice_014:r_ac341e7976e88f0b": {
      "text": "I would rather not die either.",
      "status": "imported"
    },
    "voice_014:r_cdbd128a5b4127cc": {
      "text": "Where exactly were you aiming?",
      "status": "imported"
    },
    "voice_014:r_cfccaa1fbeda124c": {
      "text": "Forgive me, but I cannot be slain.",
      "status": "imported"
    },
    "voice_014:r_b1f8ec192b9c083a": {
      "text": "Perhaps it is all causality...",
      "status": "imported"
    },
    "voice_014:r_a007f9ab9cf048b3": {
      "text": "Give up, Geminis.",
      "status": "imported"
    },
    "voice_014:r_ddafde4b065ced49": {
      "text": "None of you can defeat me!",
      "status": "imported"
    },
    "voice_014:r_de1213040856c089": {
      "text": "It is futile, Gadlight Meonsam!",
      "status": "imported"
    },
    "voice_014:r_3304412ac41f47a6": {
      "text": "Feuding Twin Sphere\\ncan't fell me!",
      "status": "imported"
    },
    "voice_014:r_d692f1d420460a47": {
      "text": "You are pitifully powerless...",
      "status": "imported"
    },
    "voice_014:r_a5643cec86b18bd2": {
      "text": "I have made preparations as well!",
      "status": "imported"
    },
    "voice_014:r_68f2dfab20a4a30e": {
      "text": "The defenses appear flawless.",
      "status": "imported"
    },
    "voice_014:r_a03fabecba1508ca": {
      "text": "What is the meaning of this?",
      "status": "imported"
    },
    "voice_014:r_5391b24a71eb10ae": {
      "text": "This much\\ncannot break my will.",
      "status": "imported"
    },
    "voice_014:r_a554ceef5c87b972": {
      "text": "No problem. I will keep attacking!",
      "status": "imported"
    },
    "voice_014:r_546c3d5937fbb7ee": {
      "text": "Even Asclepus could not evade it!",
      "status": "imported"
    },
    "voice_014:r_1568ff6298b12b96": {
      "text": "This wound... The cost of my lapse.",
      "status": "imported"
    },
    "voice_014:r_2c9d94ba13c5fc50": {
      "text": "My movements were a little sloppy.",
      "status": "imported"
    },
    "voice_014:r_a77f4913375098d2": {
      "text": "Ugh... A surprise attack?!",
      "status": "imported"
    },
    "voice_014:r_428c2116ac3071b1": {
      "text": "I will not make that mistake again!",
      "status": "imported"
    },
    "voice_014:r_84c116267b79f540": {
      "text": "Output is holding! I won't retreat!",
      "status": "imported"
    },
    "voice_014:r_dad38ee29af2df3a": {
      "text": "This peril was within my plans!",
      "status": "imported"
    },
    "voice_014:r_3d32e86f8dc80909": {
      "text": "More damage-\\nI cannot allow it!",
      "status": "imported"
    },
    "voice_014:r_70451ffbabe2f876": {
      "text": "I cannot shame myself as captain!",
      "status": "imported"
    },
    "voice_014:r_69dfa1659715e2fa": {
      "text": "Asclepus, beaten this badly?!",
      "status": "imported"
    },
    "voice_014:r_d996fd6d4ef5b329": {
      "text": "All of my predictions have failed!",
      "status": "imported"
    },
    "voice_014:r_8ab47a28f99ef565": {
      "text": "My opponent exceeds projections?!",
      "status": "imported"
    },
    "voice_014:r_546de3fb6db156ea": {
      "text": "Win unscathed?\\nReality is harsher.",
      "status": "imported"
    },
    "voice_014:r_ca85f87cee5e31f7": {
      "text": "Guh! I cannot hold out any longer!",
      "status": "imported"
    },
    "voice_014:r_9072ea7bc71df136": {
      "text": "Why can't I draw\\nAsclepus's power?!",
      "status": "imported"
    },
    "voice_014:r_04e815a8d425827d": {
      "text": "At this rate...!\\nNo fear in battle!",
      "status": "imported"
    },
    "voice_014:r_d89011fe3e5d082a": {
      "text": "I cannot fall with my duty undone!",
      "status": "imported"
    },
    "voice_014:r_3c5b0c2ac812d5de": {
      "text": "Hold on, Asclepus!\\nA little longer!",
      "status": "imported"
    },
    "voice_014:r_5b9e8897190892eb": {
      "text": "My mission: guard\\nhuman evolution!",
      "status": "imported"
    },
    "voice_014:r_7bea3023abbf8a94": {
      "text": "Chrono's mission\\nI won't forsake!",
      "status": "imported"
    },
    "voice_014:r_dd01a4c0d1b36a8d": {
      "text": "I won't forsake hope until the end!",
      "status": "imported"
    },
    "voice_014:r_20920ad2eb3542db": {
      "text": "Baal...! Enemy of humanity!",
      "status": "imported"
    },
    "voice_014:r_cb846feec748c2e3": {
      "text": "I must stop this unjust violence!",
      "status": "imported"
    },
    "voice_014:r_5e2669b82ef75ce3": {
      "text": "Geminis! Still denying your sins?!",
      "status": "imported"
    },
    "voice_014:r_7847e0ed7dc9282d": {
      "text": "Gadlight Meonsam!\\nWhat a man...!",
      "status": "imported"
    },
    "voice_014:r_e42b52c7a987b906": {
      "text": "Feuding Twin Sphere!\\nRoot it out!",
      "status": "imported"
    },
    "voice_014:r_8c61c59a1c0aebbf": {
      "text": "I still... cannot let it end...!",
      "status": "imported"
    },
    "voice_014:r_aba6a7662129d8ce": {
      "text": "Is this... my destiny?!",
      "status": "imported"
    },
    "voice_014:r_b84afafb8a33ec60": {
      "text": "My joy... because you are... my...",
      "status": "imported"
    },
    "voice_014:r_c8c59db85bf875e6": {
      "text": "Advent - Chrono's evolution captain",
      "status": "imported"
    },
    "voice_014:r_391aa56435d9dd6e": {
      "text": "Ha... Leaving history's shadows...",
      "status": "imported"
    },
    "voice_014:r_7c796ba53bd7ea03": {
      "text": "I gladly guide you with foresight.",
      "status": "imported"
    },
    "voice_014:r_fa944da4b6519006": {
      "text": "Jigoku-hen save pays off. Obvious?",
      "status": "imported"
    },
    "voice_014:r_95d047bcc17fccc6": {
      "text": "More: Link Bonus caps at 5 clears.",
      "status": "imported"
    },
    "voice_014:r_640327a12a559b31": {
      "text": "More runs? Splendid. Until we meet!",
      "status": "imported"
    },
    "voice_014:r_fc25e66a86fc2c85": {
      "text": "I will provide support!",
      "status": "imported"
    },
    "voice_014:r_5aeeb4917340c42d": {
      "text": "You may leave the rest to me!",
      "status": "imported"
    },
    "voice_014:r_b765659981b6516d": {
      "text": "Hibiki, I will handle the rest!",
      "status": "imported"
    },
    "voice_014:r_0c427458bc00eb95": {
      "text": "It is my joy to help you.",
      "status": "imported"
    },
    "voice_014:r_774a9ab4d8fd5351": {
      "text": "Fall back behind me!",
      "status": "imported"
    },
    "voice_014:r_d3f01de714c015bd": {
      "text": "This too is my duty.",
      "status": "imported"
    },
    "voice_014:r_7d2617c809fead70": {
      "text": "It is my duty to protect Hibiki!",
      "status": "imported"
    },
    "voice_014:r_ceb935ccbf830724": {
      "text": "I will not let them defeat him!",
      "status": "imported"
    },
    "voice_014:r_001cbec4d9a4283f": {
      "text": "Guh!",
      "status": "imported"
    },
    "voice_014:r_8ad40afecd02b41e": {
      "text": "This... was my role... wasn't it...",
      "status": "imported"
    },
    "voice_014:r_26e5efec03c03d78": {
      "text": "I will go first!",
      "status": "imported"
    },
    "voice_014:r_4ad81e88c7557a8b": {
      "text": "I will keep the enemy in check!",
      "status": "imported"
    },
    "voice_014:r_1f65a7af190e4674": {
      "text": "Follow my lead!",
      "status": "imported"
    },
    "voice_014:r_40c5a9358ed5bf29": {
      "text": "I will create an opening for you!",
      "status": "imported"
    },
    "voice_014:r_f2e18dfdfe0c89ea": {
      "text": "Leave that enemy to me!",
      "status": "imported"
    },
    "voice_014:r_cf7dbf49e96a5755": {
      "text": "A one-on-one duel!",
      "status": "imported"
    },
    "voice_014:r_fa96676cc65bb509": {
      "text": "Now, allow me to face you!",
      "status": "imported"
    },
    "voice_014:r_4e37f92e7d2fc62e": {
      "text": "I will not let you interfere!",
      "status": "imported"
    }
  }
}
