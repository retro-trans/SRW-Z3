{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_041:r_479b340ccc6c572b": {
      "text": "There!",
      "status": "imported"
    },
    "voice_041:r_ca4acbac57a2a35e": {
      "text": "I won't let you!!",
      "status": "imported"
    },
    "voice_041:r_77949221bf58f862": {
      "text": "Careless!!",
      "status": "imported"
    },
    "voice_041:r_70b9c4b9f1f37eff": {
      "text": "I'll make this hit!!",
      "status": "imported"
    },
    "voice_041:r_9fcb3754cb1773c7": {
      "text": "I'm moving to the front!",
      "status": "imported"
    },
    "voice_041:r_3559d2fad32c2435": {
      "text": "Hit!",
      "status": "imported"
    },
    "voice_041:r_f7570547e9f80a64": {
      "text": "Why, you!",
      "status": "imported"
    },
    "voice_041:r_cbab0f4720e1fcf1": {
      "text": "This'll do!!",
      "status": "imported"
    },
    "voice_041:r_0bbe0b4f5364e732": {
      "text": "Get out of my way!!",
      "status": "imported"
    },
    "voice_041:r_5dda5198137cb02a": {
      "text": "Sink!",
      "status": "imported"
    },
    "voice_041:r_83ec59afbecdec14": {
      "text": "Ngh... I-I'm hit!!",
      "status": "imported"
    },
    "voice_041:r_e20bfd42ad95a3c9": {
      "text": "Oh no!?",
      "status": "imported"
    },
    "voice_041:r_0f58a8822381e57f": {
      "text": "W-What power!?",
      "status": "imported"
    },
    "voice_041:r_6dbcc507fb61b51d": {
      "text": "I can't go down yet...",
      "status": "imported"
    },
    "voice_041:r_b42ab697149a7c8a": {
      "text": "Ngh! A-At this rate...",
      "status": "imported"
    },
    "voice_041:r_4de4fcf3b440baf4": {
      "text": "I-I won't lose!!",
      "status": "imported"
    },
    "voice_041:r_0121a166c715cdff": {
      "text": "Ngh! Not yet!!",
      "status": "imported"
    },
    "voice_041:r_30fad37a42bd3ad3": {
      "text": "Not bad! But I'm not done!!",
      "status": "imported"
    },
    "voice_041:r_80a0b2a84e05d81a": {
      "text": "Not yet! I won't let you!!",
      "status": "imported"
    },
    "voice_041:r_4a9ac1dff86506d9": {
      "text": "Damage!? But I'm not done!!",
      "status": "imported"
    },
    "voice_041:r_bc8538e6af3d2577": {
      "text": "Ngh! Th-This may be too much...",
      "status": "imported"
    },
    "voice_041:r_924516c8de2b5342": {
      "text": "That's just a scratch!",
      "status": "imported"
    },
    "voice_041:r_da1174533722333f": {
      "text": "This isn't enough to down me!",
      "status": "imported"
    },
    "voice_041:r_fdeb8162976e72c1": {
      "text": "It grazed me!?",
      "status": "imported"
    },
    "voice_041:r_0fadb5c26df92b42": {
      "text": "That kind of attack won't stop me!",
      "status": "imported"
    },
    "voice_041:r_6b15af9a0057cdc8": {
      "text": "As if I'd let that hit me!",
      "status": "imported"
    },
    "voice_041:r_15b4a90140e8a33a": {
      "text": "I dodged it!",
      "status": "imported"
    },
    "voice_041:r_af884a6b11dff121": {
      "text": "Too slow!",
      "status": "imported"
    },
    "voice_041:r_ac6fe7838e95647b": {
      "text": "Head-on? No, to the left!!",
      "status": "imported"
    },
    "voice_041:r_77ca87eacd17ad52": {
      "text": "I can't let it hit me!",
      "status": "imported"
    },
    "voice_041:r_bf3244994760e535": {
      "text": "I can dodge this much!!",
      "status": "imported"
    },
    "voice_041:r_02479dc8fe989560": {
      "text": "Ngh, not at this range...",
      "status": "imported"
    },
    "voice_041:r_8927e6fb681aa809": {
      "text": "Scirocco...! Back from Jupiter...!",
      "status": "imported"
    },
    "voice_041:r_665f01666859013b": {
      "text": "So many care... You're not alone.",
      "status": "imported"
    },
    "voice_041:r_a571eec59b258d11": {
      "text": "I can do this! One more shot!",
      "status": "imported"
    },
    "voice_041:r_ddbe581c5ea9183d": {
      "text": "I failed to finish it!? Then...!",
      "status": "imported"
    },
    "voice_041:r_faae935cca0edc72": {
      "text": "Emma here! I'll provide support!",
      "status": "imported"
    },
    "voice_041:r_d4430bf362340b32": {
      "text": "I'll be your shield!",
      "status": "imported"
    },
    "voice_041:r_6ff1323b355593e0": {
      "text": "If I cover you, we can manage!",
      "status": "imported"
    },
    "voice_041:r_b7b5625d7cd4282f": {
      "text": "Leave these enemies to me!",
      "status": "imported"
    },
    "voice_041:r_36133ad73a73ef98": {
      "text": "Roger!\\nAttacking enemies ahead!",
      "status": "imported"
    },
    "voice_041:r_920740a0219c5085": {
      "text": "Once we stop the enemy, the rest...!",
      "status": "imported"
    },
    "voice_041:r_a8451712c57c1a72": {
      "text": "Understood. I'll hold them back!",
      "status": "imported"
    },
    "voice_041:r_3633df5b7b8f47fa": {
      "text": "We'll withdraw and buy some time.",
      "status": "imported"
    },
    "voice_041:r_52dfc56b14b93551": {
      "text": "Lost them! Reacquire the target!",
      "status": "imported"
    },
    "voice_041:r_1b9b2aab5cb104da": {
      "text": "That won't work!",
      "status": "imported"
    },
    "voice_041:r_342044c706a2340f": {
      "text": "I managed to dodge that...!",
      "status": "imported"
    },
    "voice_041:r_cf41e8828a90cbdb": {
      "text": "Such a sloppy attack won't hit me!",
      "status": "imported"
    },
    "voice_041:r_719e897304ec42d4": {
      "text": "I won't fall to a careless attack!",
      "status": "imported"
    },
    "voice_041:r_d5e0a2317c40d322": {
      "text": "As if I'd let you beat me!",
      "status": "imported"
    },
    "voice_041:r_ec2ea17765052401": {
      "text": "In this machine, that won't work!",
      "status": "imported"
    },
    "voice_041:r_f2d4255f1c2f7542": {
      "text": "Trying to stop me in my tracks!",
      "status": "imported"
    },
    "voice_041:r_5d08ad19e2da125b": {
      "text": "Ngh! That simple feint\\nfooled me...!",
      "status": "imported"
    },
    "voice_041:r_a7246b52782a877e": {
      "text": "I can't afford to fall behind here!",
      "status": "imported"
    },
    "voice_041:r_dc8701f6bcb9904f": {
      "text": "I can recover from this much!",
      "status": "imported"
    },
    "voice_041:r_d6bdd730f24f66eb": {
      "text": "If the thrusters still work!",
      "status": "imported"
    },
    "voice_041:r_41997412868c48c4": {
      "text": "Ngh! They move well!",
      "status": "imported"
    },
    "voice_041:r_9e6cf4f389dae55c": {
      "text": "No! I can't go on like this...!",
      "status": "imported"
    },
    "voice_041:r_9e0c80ac7e33b459": {
      "text": "Ngh!\\nIt still moves! I can do this!",
      "status": "imported"
    },
    "voice_041:r_7432ef43ed3471dc": {
      "text": "Check the missing parts! Rebalance!",
      "status": "imported"
    },
    "voice_041:r_065443f6ddfcf0d7": {
      "text": "They're better than I expected...!!",
      "status": "imported"
    },
    "voice_041:r_620fedec67706d7d": {
      "text": "Hit your mark!",
      "status": "imported"
    },
    "voice_041:r_46e86d000250e137": {
      "text": "Go down!",
      "status": "imported"
    },
    "voice_041:r_ac341e7976e88f0b": {
      "text": "Emma here. I'm going on ahead.",
      "status": "imported"
    },
    "voice_041:r_cdbd128a5b4127cc": {
      "text": "Ngh, I'm losing control...!",
      "status": "imported"
    },
    "voice_041:r_cfccaa1fbeda124c": {
      "text": "You hit me...! Not bad!",
      "status": "imported"
    },
    "voice_041:r_b1f8ec192b9c083a": {
      "text": "A direct hit!? What's the damage!?",
      "status": "imported"
    },
    "voice_041:r_a007f9ab9cf048b3": {
      "text": "Aaaah!!",
      "status": "imported"
    },
    "voice_041:r_ddafde4b065ced49": {
      "text": "Ngh! I couldn't dodge it!",
      "status": "imported"
    },
    "voice_041:r_de1213040856c089": {
      "text": "Ngh...!\\nEmma here. Leaving combat!",
      "status": "imported"
    },
    "voice_041:r_3304412ac41f47a6": {
      "text": "Combat disabled...! Withdrawing!",
      "status": "imported"
    },
    "voice_041:r_0c0775e051211840": {
      "text": "Emma, Gundam Mk-II, engaging!",
      "status": "imported"
    },
    "voice_041:r_a2afffe1c396f0b3": {
      "text": "I'm counting on you, Mk-II...!",
      "status": "imported"
    },
    "voice_041:r_13c25fbdfddc8a24": {
      "text": "Normal attacks won't work on it...!",
      "status": "imported"
    },
    "voice_041:r_42ba1ecb310b4bd7": {
      "text": "It's huge...! But that's all it is!",
      "status": "imported"
    },
    "voice_041:r_d692f1d420460a47": {
      "text": "We must win...!\\nTo end this war...!",
      "status": "imported"
    },
    "voice_041:r_a5643cec86b18bd2": {
      "text": "I'll stake my life...!\\nIt ends now!",
      "status": "imported"
    },
    "voice_041:r_68f2dfab20a4a30e": {
      "text": "I'll finish you in one blow!",
      "status": "imported"
    },
    "voice_041:r_9cedad8237480563": {
      "text": "This much output will be enough!",
      "status": "imported"
    },
    "voice_041:r_a03fabecba1508ca": {
      "text": "Kamille, I'll cover you!",
      "status": "imported"
    },
    "voice_041:r_5391b24a71eb10ae": {
      "text": "Kamille, fall back!",
      "status": "imported"
    },
    "voice_041:r_a554ceef5c87b972": {
      "text": "Fall back, Kamille! I'll take over!",
      "status": "imported"
    },
    "voice_041:r_546c3d5937fbb7ee": {
      "text": "Quattro, I'll cover you!",
      "status": "imported"
    },
    "voice_041:r_1568ff6298b12b96": {
      "text": "Quattro, leave the rest to me!",
      "status": "imported"
    },
    "voice_041:r_2c9d94ba13c5fc50": {
      "text": "I'll cover you, Amuro!",
      "status": "imported"
    },
    "voice_041:r_a77f4913375098d2": {
      "text": "Amuro, leave the rest to me!",
      "status": "imported"
    },
    "voice_041:r_428c2116ac3071b1": {
      "text": "Katz! Don't rush in carelessly!",
      "status": "imported"
    },
    "voice_041:r_84c116267b79f540": {
      "text": "Kamille! That was careless!",
      "status": "imported"
    },
    "voice_041:r_dad38ee29af2df3a": {
      "text": "Quattro, attack on your side too!",
      "status": "imported"
    },
    "voice_041:r_3d32e86f8dc80909": {
      "text": "Amuro! Your movements are slowing!",
      "status": "imported"
    },
    "voice_041:r_70451ffbabe2f876": {
      "text": "Bright, please pull the ship back!",
      "status": "imported"
    },
    "voice_041:r_69dfa1659715e2fa": {
      "text": "Katz! What are you doing in battle?",
      "status": "imported"
    }
  }
}
