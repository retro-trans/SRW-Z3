{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_198:r_479b340ccc6c572b": {
      "text": "Enemy unit confirmed!",
      "status": "imported"
    },
    "voice_198:r_77949221bf58f862": {
      "text": "Commencing attack!",
      "status": "imported"
    },
    "voice_198:r_70b9c4b9f1f37eff": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_198:r_9fcb3754cb1773c7": {
      "text": "There!",
      "status": "imported"
    },
    "voice_198:r_3559d2fad32c2435": {
      "text": "You won't escape!",
      "status": "imported"
    },
    "voice_198:r_f7570547e9f80a64": {
      "text": "I've got you!",
      "status": "imported"
    },
    "voice_198:r_cbab0f4720e1fcf1": {
      "text": "This attack will do it...!",
      "status": "imported"
    },
    "voice_198:r_0bbe0b4f5364e732": {
      "text": "I'll handle this!",
      "status": "imported"
    },
    "voice_198:r_5dda5198137cb02a": {
      "text": "Don't resist!",
      "status": "imported"
    },
    "voice_198:r_83ec59afbecdec14": {
      "text": "This will finish you!",
      "status": "imported"
    },
    "voice_198:r_e20bfd42ad95a3c9": {
      "text": "Coming out was your last mistake!",
      "status": "imported"
    },
    "voice_198:r_0f58a8822381e57f": {
      "text": "You took the bait!",
      "status": "imported"
    },
    "voice_198:r_6dbcc507fb61b51d": {
      "text": "The timing is perfect!",
      "status": "imported"
    },
    "voice_198:r_b42ab697149a7c8a": {
      "text": "I see my chance!",
      "status": "imported"
    },
    "voice_198:r_4de4fcf3b440baf4": {
      "text": "This is our mission!",
      "status": "imported"
    },
    "voice_198:r_0121a166c715cdff": {
      "text": "Execute the mission swiftly!",
      "status": "imported"
    },
    "voice_198:r_30fad37a42bd3ad3": {
      "text": "Just as planned!",
      "status": "imported"
    },
    "voice_198:r_80a0b2a84e05d81a": {
      "text": "Exterminate all Spacenoids!",
      "status": "imported"
    },
    "voice_198:r_4a9ac1dff86506d9": {
      "text": "Purge all who dwell in space!",
      "status": "imported"
    },
    "voice_198:r_bc8538e6af3d2577": {
      "text": "Die, Spacenoid!",
      "status": "imported"
    },
    "voice_198:r_924516c8de2b5342": {
      "text": "All colonies must be destroyed!",
      "status": "imported"
    },
    "voice_198:r_da1174533722333f": {
      "text": "Colony-dwelling Spacenoids...!",
      "status": "imported"
    },
    "voice_198:r_fdeb8162976e72c1": {
      "text": "Citizens demand the colonies fall!",
      "status": "imported"
    },
    "voice_198:r_0fadb5c26df92b42": {
      "text": "Witness Nerima Red Dragon's power!",
      "status": "imported"
    },
    "voice_198:r_6b15af9a0057cdc8": {
      "text": "The Red Dragon name isn't for show!",
      "status": "imported"
    },
    "voice_198:r_15b4a90140e8a33a": {
      "text": "We won't lose to mere civilians!",
      "status": "imported"
    },
    "voice_198:r_af884a6b11dff121": {
      "text": "Mock battle or not, no holding back!",
      "status": "imported"
    },
    "voice_198:r_ac6fe7838e95647b": {
      "text": "Behold the latest model's power!",
      "status": "imported"
    },
    "voice_198:r_77ca87eacd17ad52": {
      "text": "It performs on par with a Gundam!",
      "status": "imported"
    },
    "voice_198:r_bf3244994760e535": {
      "text": "Target locked!",
      "status": "imported"
    },
    "voice_198:r_aabfb21c9d069ce7": {
      "text": "I'll shoot you down!",
      "status": "imported"
    },
    "voice_198:r_02479dc8fe989560": {
      "text": "If I land a direct hit...!",
      "status": "imported"
    },
    "voice_198:r_a2df00f91a9b0a9e": {
      "text": "I'll finish you in close combat!",
      "status": "imported"
    },
    "voice_198:r_48b60d6c48b9b142": {
      "text": "I'll engage you at close range!",
      "status": "imported"
    },
    "voice_198:r_8927e6fb681aa809": {
      "text": "Charging in!",
      "status": "imported"
    },
    "voice_198:r_665f01666859013b": {
      "text": "Hyaa!",
      "status": "imported"
    },
    "voice_198:r_a571eec59b258d11": {
      "text": "Raaaaaagh!",
      "status": "imported"
    },
    "voice_198:r_ddbe581c5ea9183d": {
      "text": "Hah!",
      "status": "imported"
    },
    "voice_198:r_faae935cca0edc72": {
      "text": "Faaall!",
      "status": "imported"
    },
    "voice_198:r_d4430bf362340b32": {
      "text": "Haaah!",
      "status": "imported"
    },
    "voice_198:r_b7b5625d7cd4282f": {
      "text": "Right there!",
      "status": "imported"
    },
    "voice_198:r_920740a0219c5085": {
      "text": "Now!",
      "status": "imported"
    },
    "voice_198:r_3633df5b7b8f47fa": {
      "text": "It's over!",
      "status": "imported"
    },
    "voice_198:r_1b9b2aab5cb104da": {
      "text": "Can I land one more blow?!",
      "status": "imported"
    },
    "voice_198:r_342044c706a2340f": {
      "text": "I won't let this chance slip away!",
      "status": "imported"
    },
    "voice_198:r_cf41e8828a90cbdb": {
      "text": "Neo Zeon! I'll teach you a lesson!",
      "status": "imported"
    },
    "voice_198:r_719e897304ec42d4": {
      "text": "Strike down Neo Zeon!",
      "status": "imported"
    },
    "voice_198:r_d5e0a2317c40d322": {
      "text": "So that's the Red Comet!",
      "status": "imported"
    },
    "voice_198:r_ec2ea17765052401": {
      "text": "Even against the Red Comet...!",
      "status": "imported"
    },
    "voice_198:r_f2d4255f1c2f7542": {
      "text": "They have a Gundam over there too?!",
      "status": "imported"
    },
    "voice_198:r_5d08ad19e2da125b": {
      "text": "Attack target: Vajra!",
      "status": "imported"
    },
    "voice_198:r_a7246b52782a877e": {
      "text": "You monster! I won't let you pass!",
      "status": "imported"
    },
    "voice_198:r_dc8701f6bcb9904f": {
      "text": "Drive the aliens off Earth!",
      "status": "imported"
    },
    "voice_198:r_55417493fce1d347": {
      "text": "Counterattack!",
      "status": "imported"
    },
    "voice_198:r_8fdf5910927c9591": {
      "text": "I'll strike whoever comes closest!",
      "status": "imported"
    },
    "voice_198:r_7d724dbcc4451e10": {
      "text": "I'll hit you back!",
      "status": "imported"
    },
    "voice_198:r_93e25418a203cb8f": {
      "text": "Now it's our turn to attack!",
      "status": "imported"
    },
    "voice_198:r_adeb0a29274d3d9b": {
      "text": "Here's some payback!",
      "status": "imported"
    },
    "voice_198:r_24cf161287ef9d5c": {
      "text": "Even if you try to disengage...!",
      "status": "imported"
    },
    "voice_198:r_8f60f6fc86db3107": {
      "text": "I'll return fire!",
      "status": "imported"
    },
    "voice_198:r_b1de76a75a253c13": {
      "text": "I'll counterattack by the book!",
      "status": "imported"
    },
    "voice_198:r_128c35bf3e0e394c": {
      "text": "I'll provide support!",
      "status": "imported"
    },
    "voice_198:r_5213c17e13b23de0": {
      "text": "I'll leave the rest to you!",
      "status": "imported"
    },
    "voice_198:r_38fdff9483e9245c": {
      "text": "Witness Nerima Red Dragon's unity!",
      "status": "imported"
    },
    "voice_198:r_620fedec67706d7d": {
      "text": "Providing support, Captain!",
      "status": "imported"
    },
    "voice_198:r_9680dcd0fddcfcc7": {
      "text": "I won't let you do that before me!",
      "status": "imported"
    },
    "voice_198:r_2a00f1044ad5cbaa": {
      "text": "Fall back while you can!",
      "status": "imported"
    },
    "voice_198:r_3dbeead1bd3164ef": {
      "text": "Nerima Red Dragon is immortal!",
      "status": "imported"
    },
    "voice_198:r_98d15b8cc09bc915": {
      "text": "Captain, please fall back!",
      "status": "imported"
    },
    "voice_198:r_46e86d000250e137": {
      "text": "Unable to counterattack...?!",
      "status": "imported"
    },
    "voice_198:r_ac341e7976e88f0b": {
      "text": "What's going on?! Can't I attack?!",
      "status": "imported"
    },
    "voice_198:r_cdbd128a5b4127cc": {
      "text": "At this rate, they'll focus fire!",
      "status": "imported"
    },
    "voice_198:r_cfccaa1fbeda124c": {
      "text": "Damn! Is this unit wearing out?!",
      "status": "imported"
    },
    "voice_198:r_b1f8ec192b9c083a": {
      "text": "No! That position is out of range!",
      "status": "imported"
    },
    "voice_198:r_a007f9ab9cf048b3": {
      "text": "Out-of-range attack...\\nGood tactics!",
      "status": "imported"
    },
    "voice_198:r_ddafde4b065ced49": {
      "text": "Whoa, that was close!",
      "status": "imported"
    },
    "voice_198:r_de1213040856c089": {
      "text": "Not so fast!",
      "status": "imported"
    },
    "voice_198:r_3304412ac41f47a6": {
      "text": "Too slow!",
      "status": "imported"
    },
    "voice_198:r_0c0775e051211840": {
      "text": "I can do it...! I can do it!",
      "status": "imported"
    },
    "voice_198:r_a2afffe1c396f0b3": {
      "text": "Good reflexes!",
      "status": "imported"
    },
    "voice_198:r_13c25fbdfddc8a24": {
      "text": "As long as I dodge early...!",
      "status": "imported"
    },
    "voice_198:r_42ba1ecb310b4bd7": {
      "text": "I saw that coming!",
      "status": "imported"
    },
    "voice_198:r_d692f1d420460a47": {
      "text": "Your attack is painfully obvious!",
      "status": "imported"
    },
    "voice_198:r_a5643cec86b18bd2": {
      "text": "Mere civilians! You're no threat!",
      "status": "imported"
    },
    "voice_198:r_68f2dfab20a4a30e": {
      "text": "Learned your lesson?\\nThen give up!",
      "status": "imported"
    },
    "voice_198:r_5391b24a71eb10ae": {
      "text": "That was pointless!",
      "status": "imported"
    },
    "voice_198:r_a554ceef5c87b972": {
      "text": "That kind of attack won't work!",
      "status": "imported"
    },
    "voice_198:r_2c9d94ba13c5fc50": {
      "text": "We have a barrier on our side!",
      "status": "imported"
    },
    "voice_198:r_a77f4913375098d2": {
      "text": "If I can block it with my shield...!",
      "status": "imported"
    },
    "voice_198:r_428c2116ac3071b1": {
      "text": "It struck the shield!",
      "status": "imported"
    },
    "voice_198:r_84c116267b79f540": {
      "text": "I failed to dodge...!",
      "status": "imported"
    },
    "voice_198:r_dad38ee29af2df3a": {
      "text": "That wasn't much damage...!",
      "status": "imported"
    },
    "voice_198:r_3d32e86f8dc80909": {
      "text": "Was my timing off...!",
      "status": "imported"
    },
    "voice_198:r_70451ffbabe2f876": {
      "text": "I fell for a trick like that...!",
      "status": "imported"
    },
    "voice_198:r_69dfa1659715e2fa": {
      "text": "You call that an attack?!",
      "status": "imported"
    },
    "voice_198:r_d996fd6d4ef5b329": {
      "text": "Nothing to concern myself with!",
      "status": "imported"
    },
    "voice_198:r_8ab47a28f99ef565": {
      "text": "It was merely a chance collision!",
      "status": "imported"
    },
    "voice_198:r_546de3fb6db156ea": {
      "text": "It won't impede the operation!",
      "status": "imported"
    },
    "voice_198:r_ca85f87cee5e31f7": {
      "text": "I hate to admit it - a fine strike!",
      "status": "imported"
    },
    "voice_198:r_9072ea7bc71df136": {
      "text": "To think I took that head-on...!",
      "status": "imported"
    },
    "voice_198:r_04e815a8d425827d": {
      "text": "They're slowly cornering me...!",
      "status": "imported"
    },
    "voice_198:r_d89011fe3e5d082a": {
      "text": "I must turn the tide somehow...!",
      "status": "imported"
    },
    "voice_198:r_3c5b0c2ac812d5de": {
      "text": "Trouble throughout the unit...!",
      "status": "imported"
    },
    "voice_198:r_5b9e8897190892eb": {
      "text": "Gah! The damage keeps piling up!",
      "status": "imported"
    },
    "voice_198:r_7bea3023abbf8a94": {
      "text": "This beating... A bad matchup?!",
      "status": "imported"
    },
    "voice_198:r_dd01a4c0d1b36a8d": {
      "text": "Damn! I can't shake them!",
      "status": "imported"
    },
    "voice_198:r_20920ad2eb3542db": {
      "text": "I-I cannot lose to civilians!",
      "status": "imported"
    },
    "voice_198:r_0ab7914877fd48ed": {
      "text": "What's happening?!\\nThey're veterans!",
      "status": "imported"
    },
    "voice_198:r_cb846feec748c2e3": {
      "text": "Nerima Red Dragon...\\nDriven back?!",
      "status": "imported"
    },
    "voice_198:r_c958860b0676b1f5": {
      "text": "Dai-Guard\\nwasn't a fake prop?!",
      "status": "imported"
    },
    "voice_198:r_607f666f1563bc0d": {
      "text": "Rrraaagh! At this rate...!",
      "status": "imported"
    },
    "voice_198:r_97b7431eeb81e6b6": {
      "text": "Impossible! A direct hit?!",
      "status": "imported"
    },
    "voice_198:r_132f605d02975e71": {
      "text": "Damn! This unit is near its limit!",
      "status": "imported"
    },
    "voice_198:r_9b9726b1872759d6": {
      "text": "Why?! Why can't I dodge?!",
      "status": "imported"
    },
    "voice_198:r_1252db29683fefe0": {
      "text": "I won't allow any more of this!",
      "status": "imported"
    },
    "voice_198:r_ad3d538f1e909184": {
      "text": "Damn it!\\nWhat is happening?!",
      "status": "imported"
    },
    "voice_198:r_8c61c59a1c0aebbf": {
      "text": "I haven't lost!\\nThe fight begins!",
      "status": "imported"
    },
    "voice_198:r_aba6a7662129d8ce": {
      "text": "As long as it moves, I'll fight!",
      "status": "imported"
    },
    "voice_198:r_b84afafb8a33ec60": {
      "text": "Agh! Aaaaaaagh!",
      "status": "imported"
    },
    "voice_198:r_c8c59db85bf875e6": {
      "text": "Damn it...! Is this the end?!",
      "status": "imported"
    },
    "voice_198:r_391aa56435d9dd6e": {
      "text": "N-no! I'm ejecting!",
      "status": "imported"
    },
    "voice_198:r_7c796ba53bd7ea03": {
      "text": "Daaamn! Not in a place like this!",
      "status": "imported"
    },
    "voice_198:r_fa944da4b6519006": {
      "text": "Regrettably, I must abandon my unit!",
      "status": "imported"
    },
    "voice_198:r_95d047bcc17fccc6": {
      "text": "The unit won't hold! Retreat!",
      "status": "imported"
    },
    "voice_198:r_640327a12a559b31": {
      "text": "C-Captain! Forgive me!",
      "status": "imported"
    },
    "voice_198:r_bdd38c584fa313d0": {
      "text": "G-glory to Nerima Red Dragon!",
      "status": "imported"
    },
    "voice_198:r_0c427458bc00eb95": {
      "text": "We'll strike first!",
      "status": "imported"
    },
    "voice_198:r_774a9ab4d8fd5351": {
      "text": "We'll pin the enemy down!",
      "status": "imported"
    },
    "voice_198:r_d3f01de714c015bd": {
      "text": "Don't think it's merely a feint!",
      "status": "imported"
    },
    "voice_198:r_7d2617c809fead70": {
      "text": "Leave this side to me!",
      "status": "imported"
    },
    "voice_198:r_ceb935ccbf830724": {
      "text": "We'll divide their forces!",
      "status": "imported"
    },
    "voice_198:r_862ef7385bf2abd4": {
      "text": "If I can get them one-on-one!",
      "status": "imported"
    }
  }
}
