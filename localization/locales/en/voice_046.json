{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_046:r_479b340ccc6c572b": {
      "text": "At this range...!",
      "status": "imported"
    },
    "voice_046:r_ca4acbac57a2a35e": {
      "text": "Sights set...!",
      "status": "imported"
    },
    "voice_046:r_77949221bf58f862": {
      "text": "Got you...!",
      "status": "imported"
    },
    "voice_046:r_70b9c4b9f1f37eff": {
      "text": "You're in range!",
      "status": "imported"
    },
    "voice_046:r_9fcb3754cb1773c7": {
      "text": "This one will hit!",
      "status": "imported"
    },
    "voice_046:r_3559d2fad32c2435": {
      "text": "Hold still!",
      "status": "imported"
    },
    "voice_046:r_f7570547e9f80a64": {
      "text": "This is the deciding moment!",
      "status": "imported"
    },
    "voice_046:r_cbab0f4720e1fcf1": {
      "text": "I'll pull it off...!",
      "status": "imported"
    },
    "voice_046:r_0bbe0b4f5364e732": {
      "text": "I'll finish you in one shot!",
      "status": "imported"
    },
    "voice_046:r_5dda5198137cb02a": {
      "text": "Right through the weak point!",
      "status": "imported"
    },
    "voice_046:r_83ec59afbecdec14": {
      "text": "Now, our long-held wish...!",
      "status": "imported"
    },
    "voice_046:r_e20bfd42ad95a3c9": {
      "text": "Our fight isn't over yet!",
      "status": "imported"
    },
    "voice_046:r_0f58a8822381e57f": {
      "text": "Don't underestimate Zeon!",
      "status": "imported"
    },
    "voice_046:r_6dbcc507fb61b51d": {
      "text": "The Gundam must be crushed early!",
      "status": "imported"
    },
    "voice_046:r_b42ab697149a7c8a": {
      "text": "Gundam...! So you survived too!",
      "status": "imported"
    },
    "voice_046:r_4de4fcf3b440baf4": {
      "text": "Feel the tenacity of Zeon!",
      "status": "imported"
    },
    "voice_046:r_0121a166c715cdff": {
      "text": "So, a Gundam impostor appears!",
      "status": "imported"
    },
    "voice_046:r_30fad37a42bd3ad3": {
      "text": "One shot at its transform system!",
      "status": "imported"
    },
    "voice_046:r_80a0b2a84e05d81a": {
      "text": "The Gundam's grown rather flashy!",
      "status": "imported"
    },
    "voice_046:r_924516c8de2b5342": {
      "text": "Feds...!\\nBehold our final battle!",
      "status": "imported"
    },
    "voice_046:r_da1174533722333f": {
      "text": "I know I can't win...!\\nBut I must!",
      "status": "imported"
    },
    "voice_046:r_fdeb8162976e72c1": {
      "text": "Sniper duel!\\nSpeed and aim win!",
      "status": "imported"
    },
    "voice_046:r_6b15af9a0057cdc8": {
      "text": "Equal range...! Skill decides this!",
      "status": "imported"
    },
    "voice_046:r_af884a6b11dff121": {
      "text": "So stiff...! A rookie's machine?!",
      "status": "imported"
    },
    "voice_046:r_ac6fe7838e95647b": {
      "text": "Aim for the warship's engine room!",
      "status": "imported"
    },
    "voice_046:r_77ca87eacd17ad52": {
      "text": "Split-horn Gundam...! Can I win?!",
      "status": "imported"
    },
    "voice_046:r_719e897304ec42d4": {
      "text": "As long as I live, I'll fire back!",
      "status": "imported"
    },
    "voice_046:r_d5e0a2317c40d322": {
      "text": "You failed to down me. You've lost!",
      "status": "imported"
    },
    "voice_046:r_ec2ea17765052401": {
      "text": "You came flying right at me...!",
      "status": "imported"
    },
    "voice_046:r_f2d4255f1c2f7542": {
      "text": "You were too slow to break away!",
      "status": "imported"
    },
    "voice_046:r_5d08ad19e2da125b": {
      "text": "We'll never forget our hatred...!",
      "status": "imported"
    },
    "voice_046:r_a7246b52782a877e": {
      "text": "You're still within my range!",
      "status": "imported"
    },
    "voice_046:r_dc8701f6bcb9904f": {
      "text": "Leave the finishing blow to me!",
      "status": "imported"
    },
    "voice_046:r_d6bdd730f24f66eb": {
      "text": "I'll provide covering fire!",
      "status": "imported"
    },
    "voice_046:r_41997412868c48c4": {
      "text": "Stay calm, Loni!",
      "status": "imported"
    },
    "voice_046:r_9e6cf4f389dae55c": {
      "text": "I'll cover you! Fall back!",
      "status": "imported"
    },
    "voice_046:r_9e0c80ac7e33b459": {
      "text": "Evade! Another one's coming!",
      "status": "imported"
    },
    "voice_046:r_7432ef43ed3471dc": {
      "text": "Loni, what's wrong?!",
      "status": "imported"
    },
    "voice_046:r_065443f6ddfcf0d7": {
      "text": "A sniper turned into the target...!",
      "status": "imported"
    },
    "voice_046:r_47d52a2839c71715": {
      "text": "Damn! I'm on the back foot...!",
      "status": "imported"
    },
    "voice_046:r_847f82e7f3eef651": {
      "text": "They exploited its poor handling!",
      "status": "imported"
    },
    "voice_046:r_eb7ae28b53dc033c": {
      "text": "Damn! I'm out of energy...!",
      "status": "imported"
    },
    "voice_046:r_857c4a52ce8df0fd": {
      "text": "That spot!\\nThey've read our tactics!",
      "status": "imported"
    },
    "voice_046:r_55417493fce1d347": {
      "text": "So it missed me...",
      "status": "imported"
    },
    "voice_046:r_8fdf5910927c9591": {
      "text": "I read you better that time.",
      "status": "imported"
    },
    "voice_046:r_7d724dbcc4451e10": {
      "text": "Looks like they're panicking too.",
      "status": "imported"
    },
    "voice_046:r_93e25418a203cb8f": {
      "text": "That was too close...!",
      "status": "imported"
    },
    "voice_046:r_adeb0a29274d3d9b": {
      "text": "I can see your every move...!",
      "status": "imported"
    },
    "voice_046:r_24cf161287ef9d5c": {
      "text": "My years at war weren't for nothing!",
      "status": "imported"
    },
    "voice_046:r_8f60f6fc86db3107": {
      "text": "Far from the Gundam I remember",
      "status": "imported"
    },
    "voice_046:r_b1de76a75a253c13": {
      "text": "How far the Gundam has fallen...!",
      "status": "imported"
    },
    "voice_046:r_128c35bf3e0e394c": {
      "text": "What's wrong, split-horn Gundam...!",
      "status": "imported"
    },
    "voice_046:r_5213c17e13b23de0": {
      "text": "Our resolve is greater than yours!",
      "status": "imported"
    },
    "voice_046:r_38fdff9483e9245c": {
      "text": "Fewer troops,\\nbut Zeon has the edge!",
      "status": "imported"
    },
    "voice_046:r_620fedec67706d7d": {
      "text": "The difference in skill is clear...!",
      "status": "imported"
    },
    "voice_046:r_2a00f1044ad5cbaa": {
      "text": "You're a second-rate sniper.",
      "status": "imported"
    },
    "voice_046:r_0c0775e051211840": {
      "text": "Didn't expect\\nthis gear, did you?!",
      "status": "imported"
    },
    "voice_046:r_a2afffe1c396f0b3": {
      "text": "This gear lets me focus on offense!",
      "status": "imported"
    },
    "voice_046:r_13c25fbdfddc8a24": {
      "text": "I'll take it on my shield...!",
      "status": "imported"
    },
    "voice_046:r_42ba1ecb310b4bd7": {
      "text": "It hit my shield this time, but...!",
      "status": "imported"
    },
    "voice_046:r_d692f1d420460a47": {
      "text": "Is that all...!",
      "status": "imported"
    },
    "voice_046:r_a5643cec86b18bd2": {
      "text": "That wasn't even a distraction...!",
      "status": "imported"
    },
    "voice_046:r_68f2dfab20a4a30e": {
      "text": "For now, offense over evasion...!",
      "status": "imported"
    },
    "voice_046:r_9cedad8237480563": {
      "text": "Damage check can wait...!",
      "status": "imported"
    },
    "voice_046:r_a03fabecba1508ca": {
      "text": "Can you afford to size me up...?",
      "status": "imported"
    },
    "voice_046:r_5391b24a71eb10ae": {
      "text": "You lack far too much to stop us!",
      "status": "imported"
    },
    "voice_046:r_a554ceef5c87b972": {
      "text": "Damn! That hit me head-on!",
      "status": "imported"
    },
    "voice_046:r_546c3d5937fbb7ee": {
      "text": "Taking so many direct hits...!",
      "status": "imported"
    },
    "voice_046:r_1568ff6298b12b96": {
      "text": "One instant's delay did this...!",
      "status": "imported"
    },
    "voice_046:r_2c9d94ba13c5fc50": {
      "text": "The main camera's still intact!",
      "status": "imported"
    },
    "voice_046:r_a77f4913375098d2": {
      "text": "I didn't let my guard down!",
      "status": "imported"
    },
    "voice_046:r_428c2116ac3071b1": {
      "text": "If this drags on, we're worse off!",
      "status": "imported"
    },
    "voice_046:r_84c116267b79f540": {
      "text": "Gundam...! Strong, as expected...!",
      "status": "imported"
    },
    "voice_046:r_dad38ee29af2df3a": {
      "text": "Must I relive that day again...?!",
      "status": "imported"
    },
    "voice_046:r_3d32e86f8dc80909": {
      "text": "Gundam...! I may not win, but...!",
      "status": "imported"
    },
    "voice_046:r_70451ffbabe2f876": {
      "text": "This is the newest Gundam's power!",
      "status": "imported"
    },
    "voice_046:r_69dfa1659715e2fa": {
      "text": "Federation! We're not done yet!",
      "status": "imported"
    },
    "voice_046:r_d996fd6d4ef5b329": {
      "text": "Damn! Federation elites indeed...!",
      "status": "imported"
    },
    "voice_046:r_8ab47a28f99ef565": {
      "text": "They've corrected their aim...!",
      "status": "imported"
    },
    "voice_046:r_ca85f87cee5e31f7": {
      "text": "Sharp eyes!\\nMaybe better than mine!",
      "status": "imported"
    },
    "voice_046:r_5e2669b82ef75ce3": {
      "text": "Sniper rifle intact,\\nI'll manage!",
      "status": "imported"
    },
    "voice_046:r_7847e0ed7dc9282d": {
      "text": "I'm long past my limit...!\\nEven so!",
      "status": "imported"
    },
    "voice_046:r_e42b52c7a987b906": {
      "text": "Never counted on\\nreturning alive!",
      "status": "imported"
    },
    "voice_046:r_6825fd1ff907bd22": {
      "text": "I won't retreat...!\\nI'm prepared!",
      "status": "imported"
    },
    "voice_046:r_607f666f1563bc0d": {
      "text": "Stay up! Get off every last shot!",
      "status": "imported"
    },
    "voice_046:r_97b7431eeb81e6b6": {
      "text": "Not yet! I can't leave Loni behind!",
      "status": "imported"
    },
    "voice_046:r_132f605d02975e71": {
      "text": "My war... is ending...",
      "status": "imported"
    },
    "voice_046:r_9b9726b1872759d6": {
      "text": "So this is where my fight ends...",
      "status": "imported"
    },
    "voice_046:r_1252db29683fefe0": {
      "text": "Loni...! You...!\\nDon't be like us!!",
      "status": "imported"
    },
    "voice_046:r_ad3d538f1e909184": {
      "text": "I'll stop you in your tracks!",
      "status": "imported"
    },
    "voice_046:r_8c61c59a1c0aebbf": {
      "text": "We'll bury them with teamwork!",
      "status": "imported"
    },
    "voice_046:r_aba6a7662129d8ce": {
      "text": "Destroy each enemy individually!",
      "status": "imported"
    },
    "voice_046:r_b84afafb8a33ec60": {
      "text": "I must fulfill my assigned role...!",
      "status": "imported"
    },
    "voice_046:r_c8c59db85bf875e6": {
      "text": "One more shot!",
      "status": "imported"
    },
    "voice_046:r_391aa56435d9dd6e": {
      "text": "Too slow! This will finish you!",
      "status": "imported"
    }
  }
}
