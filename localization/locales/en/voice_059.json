{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_059:r_479b340ccc6c572b": {
      "text": "If I take that one down...!",
      "status": "imported"
    },
    "voice_059:r_ca4acbac57a2a35e": {
      "text": "Once I've made up my mind...!",
      "status": "imported"
    },
    "voice_059:r_77949221bf58f862": {
      "text": "No matter how many enemies!",
      "status": "imported"
    },
    "voice_059:r_70b9c4b9f1f37eff": {
      "text": "I'll change this twisted world!",
      "status": "imported"
    },
    "voice_059:r_9fcb3754cb1773c7": {
      "text": "I'll do whatever it takes to win!",
      "status": "imported"
    },
    "voice_059:r_3559d2fad32c2435": {
      "text": "For something dearer than life!",
      "status": "imported"
    },
    "voice_059:r_f7570547e9f80a64": {
      "text": "I won't let you interfere!",
      "status": "imported"
    },
    "voice_059:r_cbab0f4720e1fcf1": {
      "text": "Don't stand in my way!",
      "status": "imported"
    },
    "voice_059:r_0bbe0b4f5364e732": {
      "text": "I can't lose... Never!",
      "status": "imported"
    },
    "voice_059:r_5dda5198137cb02a": {
      "text": "Don't underestimate Guren!",
      "status": "imported"
    },
    "voice_059:r_83ec59afbecdec14": {
      "text": "I'm going in!",
      "status": "imported"
    },
    "voice_059:r_e20bfd42ad95a3c9": {
      "text": "Once I close the distance...!",
      "status": "imported"
    },
    "voice_059:r_0f58a8822381e57f": {
      "text": "If this is how we're fighting...!",
      "status": "imported"
    },
    "voice_059:r_6dbcc507fb61b51d": {
      "text": "I've got the edge in close combat!",
      "status": "imported"
    },
    "voice_059:r_b42ab697149a7c8a": {
      "text": "Get in close, and victory's mine!",
      "status": "imported"
    },
    "voice_059:r_4de4fcf3b440baf4": {
      "text": "Get outta my way!",
      "status": "imported"
    },
    "voice_059:r_0121a166c715cdff": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_059:r_30fad37a42bd3ad3": {
      "text": "You're in my way!",
      "status": "imported"
    },
    "voice_059:r_80a0b2a84e05d81a": {
      "text": "Hyaah!",
      "status": "imported"
    },
    "voice_059:r_4a9ac1dff86506d9": {
      "text": "You'll face me before Chirico!",
      "status": "imported"
    },
    "voice_059:r_bc8538e6af3d2577": {
      "text": "I've faced ATs in Battling!",
      "status": "imported"
    },
    "voice_059:r_924516c8de2b5342": {
      "text": "You're no ordinary AT pilot...!",
      "status": "imported"
    },
    "voice_059:r_da1174533722333f": {
      "text": "I can't jump at every little thing!",
      "status": "imported"
    },
    "voice_059:r_fdeb8162976e72c1": {
      "text": "Whoever we face, Guren can win!",
      "status": "imported"
    },
    "voice_059:r_0fadb5c26df92b42": {
      "text": "I'll crush that monster right here!",
      "status": "imported"
    },
    "voice_059:r_6b15af9a0057cdc8": {
      "text": "Try not to get dizzy, big brute!",
      "status": "imported"
    },
    "voice_059:r_15b4a90140e8a33a": {
      "text": "Size difference won't stop me!",
      "status": "imported"
    },
    "voice_059:r_af884a6b11dff121": {
      "text": "Even if I'm facing a Gundam...!",
      "status": "imported"
    },
    "voice_059:r_ac6fe7838e95647b": {
      "text": "We're nothing like you people!",
      "status": "imported"
    },
    "voice_059:r_77ca87eacd17ad52": {
      "text": "You just crossed the line!",
      "status": "imported"
    },
    "voice_059:r_bf3244994760e535": {
      "text": "I will never accept\\nyour world!",
      "status": "imported"
    },
    "voice_059:r_aabfb21c9d069ce7": {
      "text": "I'll take you down and end it all!",
      "status": "imported"
    },
    "voice_059:r_cf41e8828a90cbdb": {
      "text": "This time, I'll handle it!",
      "status": "imported"
    },
    "voice_059:r_719e897304ec42d4": {
      "text": "I can't let it end with me beaten!",
      "status": "imported"
    },
    "voice_059:r_d5e0a2317c40d322": {
      "text": "We will keep resisting!",
      "status": "imported"
    },
    "voice_059:r_ec2ea17765052401": {
      "text": "Now, we strike back!",
      "status": "imported"
    },
    "voice_059:r_f2d4255f1c2f7542": {
      "text": "It's too late for regrets!",
      "status": "imported"
    },
    "voice_059:r_5d08ad19e2da125b": {
      "text": "Come near, and I'll knock you down!",
      "status": "imported"
    },
    "voice_059:r_a7246b52782a877e": {
      "text": "Don't forget, I'm still here!",
      "status": "imported"
    },
    "voice_059:r_dc8701f6bcb9904f": {
      "text": "We'll have to work together here!",
      "status": "imported"
    },
    "voice_059:r_d6bdd730f24f66eb": {
      "text": "Zero made an opening. I'll strike!",
      "status": "imported"
    },
    "voice_059:r_41997412868c48c4": {
      "text": "Zero, leave this to me...!",
      "status": "imported"
    },
    "voice_059:r_9e6cf4f389dae55c": {
      "text": "I won't let anyone else get hurt!",
      "status": "imported"
    },
    "voice_059:r_9e0c80ac7e33b459": {
      "text": "Move! I'll handle this!",
      "status": "imported"
    },
    "voice_059:r_7432ef43ed3471dc": {
      "text": "I'll protect Zero!",
      "status": "imported"
    },
    "voice_059:r_065443f6ddfcf0d7": {
      "text": "I lead Zero's personal guard!",
      "status": "imported"
    },
    "voice_059:r_47d52a2839c71715": {
      "text": "No! This won't win us the fight...!",
      "status": "imported"
    },
    "voice_059:r_847f82e7f3eef651": {
      "text": "Damn!\\nWhy can't I counter now...!",
      "status": "imported"
    },
    "voice_059:r_eb7ae28b53dc033c": {
      "text": "No! The Energy Filler is empty!",
      "status": "imported"
    },
    "voice_059:r_857c4a52ce8df0fd": {
      "text": "They're outside my attack range...!",
      "status": "imported"
    },
    "voice_059:r_55417493fce1d347": {
      "text": "Taking shots from over there...!",
      "status": "imported"
    },
    "voice_059:r_8fdf5910927c9591": {
      "text": "Your movements are predictable.",
      "status": "imported"
    },
    "voice_059:r_7d724dbcc4451e10": {
      "text": "That kind of attack won't...!",
      "status": "imported"
    },
    "voice_059:r_93e25418a203cb8f": {
      "text": "As long as I watch our distance...!",
      "status": "imported"
    },
    "voice_059:r_adeb0a29274d3d9b": {
      "text": "If I just keep moving...!",
      "status": "imported"
    },
    "voice_059:r_24cf161287ef9d5c": {
      "text": "I don't have time to play around!",
      "status": "imported"
    },
    "voice_059:r_8f60f6fc86db3107": {
      "text": "Don't underestimate Kallen Kozuki!",
      "status": "imported"
    },
    "voice_059:r_b1de76a75a253c13": {
      "text": "Ha! Don't make me laugh!",
      "status": "imported"
    },
    "voice_059:r_128c35bf3e0e394c": {
      "text": "You won't lay a finger on me!",
      "status": "imported"
    },
    "voice_059:r_5213c17e13b23de0": {
      "text": "I moved out of there ages ago!",
      "status": "imported"
    },
    "voice_059:r_38fdff9483e9245c": {
      "text": "Come back with a better attack!",
      "status": "imported"
    },
    "voice_059:r_620fedec67706d7d": {
      "text": "This is Guren's power!",
      "status": "imported"
    },
    "voice_059:r_9680dcd0fddcfcc7": {
      "text": "I can't stand clingy men.",
      "status": "imported"
    },
    "voice_059:r_3dbeead1bd3164ef": {
      "text": "That won't work on me!",
      "status": "imported"
    },
    "voice_059:r_98d15b8cc09bc915": {
      "text": "I'll deflect it!",
      "status": "imported"
    },
    "voice_059:r_46e86d000250e137": {
      "text": "I can use it like this too!",
      "status": "imported"
    },
    "voice_059:r_cdbd128a5b4127cc": {
      "text": "You're persistent...!",
      "status": "imported"
    },
    "voice_059:r_cfccaa1fbeda124c": {
      "text": "Don't hit anywhere critical...!",
      "status": "imported"
    },
    "voice_059:r_b1f8ec192b9c083a": {
      "text": "This is getting on my nerves...!",
      "status": "imported"
    },
    "voice_059:r_a007f9ab9cf048b3": {
      "text": "Tch! You think this is a game?!",
      "status": "imported"
    },
    "voice_059:r_ddafde4b065ced49": {
      "text": "A scratch won't stop me!",
      "status": "imported"
    },
    "voice_059:r_de1213040856c089": {
      "text": "Come ready to die to take me down!",
      "status": "imported"
    },
    "voice_059:r_3304412ac41f47a6": {
      "text": "You're keeping up with Guren...!",
      "status": "imported"
    },
    "voice_059:r_0c0775e051211840": {
      "text": "Tch! You're ticking me off...!",
      "status": "imported"
    },
    "voice_059:r_a2afffe1c396f0b3": {
      "text": "Don't get cocky!",
      "status": "imported"
    },
    "voice_059:r_13c25fbdfddc8a24": {
      "text": "You fight dirty!",
      "status": "imported"
    },
    "voice_059:r_42ba1ecb310b4bd7": {
      "text": "Nothing...!\\nNext to Japan's pain!",
      "status": "imported"
    },
    "voice_059:r_d692f1d420460a47": {
      "text": "So you won't go down easily...!",
      "status": "imported"
    },
    "voice_059:r_a5643cec86b18bd2": {
      "text": "It still moves. That's all I need!",
      "status": "imported"
    },
    "voice_059:r_68f2dfab20a4a30e": {
      "text": "Thought you had me? Too bad!",
      "status": "imported"
    },
    "voice_059:r_9cedad8237480563": {
      "text": "Left me alive?\\nYou'll regret it!",
      "status": "imported"
    },
    "voice_059:r_a03fabecba1508ca": {
      "text": "Doesn't hurt...! Doesn't hurt!",
      "status": "imported"
    },
    "voice_059:r_5391b24a71eb10ae": {
      "text": "This won't bring Guren down...!",
      "status": "imported"
    },
    "voice_059:r_a554ceef5c87b972": {
      "text": "I won't give up! Never!",
      "status": "imported"
    },
    "voice_059:r_546c3d5937fbb7ee": {
      "text": "Ngh! I refuse to scream!",
      "status": "imported"
    },
    "voice_059:r_1568ff6298b12b96": {
      "text": "I can't fall! Not here!",
      "status": "imported"
    },
    "voice_059:r_2c9d94ba13c5fc50": {
      "text": "Not yet!\\nOur fight isn't over yet!",
      "status": "imported"
    },
    "voice_059:r_a77f4913375098d2": {
      "text": "I'll die before I yield!\\nFight on!",
      "status": "imported"
    },
    "voice_059:r_428c2116ac3071b1": {
      "text": "I can still move! I won't lose!",
      "status": "imported"
    },
    "voice_059:r_84c116267b79f540": {
      "text": "Friends inherit my will...!\\nSo...!",
      "status": "imported"
    },
    "voice_059:r_dad38ee29af2df3a": {
      "text": "Big brother... protect me...!",
      "status": "imported"
    },
    "voice_059:r_3d32e86f8dc80909": {
      "text": "Mom... I swear. I swear I'll do it!",
      "status": "imported"
    },
    "voice_059:r_70451ffbabe2f876": {
      "text": "Please...! Hold on, Guren...!",
      "status": "imported"
    },
    "voice_059:r_69dfa1659715e2fa": {
      "text": "N-no...! The machine won't hold...!",
      "status": "imported"
    },
    "voice_059:r_d996fd6d4ef5b329": {
      "text": "No...! Is this as far as I go?!",
      "status": "imported"
    },
    "voice_059:r_8ab47a28f99ef565": {
      "text": "One more hit! This ends it!",
      "status": "imported"
    },
    "voice_059:r_546de3fb6db156ea": {
      "text": "You should've stayed down before!",
      "status": "imported"
    },
    "voice_059:r_ca85f87cee5e31f7": {
      "text": "With the mighty Guren's power...!",
      "status": "imported"
    },
    "voice_059:r_9072ea7bc71df136": {
      "text": "S.E.I.T.E.N.! With this power!",
      "status": "imported"
    },
    "voice_059:r_04e815a8d425827d": {
      "text": "Guren! Dance with me in battle!",
      "status": "imported"
    },
    "voice_059:r_d89011fe3e5d082a": {
      "text": "I won't let you wipe out humanity!",
      "status": "imported"
    },
    "voice_059:r_774a9ab4d8fd5351": {
      "text": "There!",
      "status": "imported"
    },
    "voice_059:r_d3f01de714c015bd": {
      "text": "I'll drive it straight into you!",
      "status": "imported"
    },
    "voice_059:r_7d2617c809fead70": {
      "text": "I'll fight for my own justice!",
      "status": "imported"
    },
    "voice_059:r_862ef7385bf2abd4": {
      "text": "I'll pull it off!",
      "status": "imported"
    },
    "voice_059:r_001cbec4d9a4283f": {
      "text": "Blow apart!",
      "status": "imported"
    },
    "voice_059:r_8ad40afecd02b41e": {
      "text": "I can do this with S.E.I.T.E.N.!",
      "status": "imported"
    },
    "voice_059:r_4ad81e88c7557a8b": {
      "text": "You're not getting away!",
      "status": "imported"
    },
    "voice_059:r_1f65a7af190e4674": {
      "text": "This will finish it!",
      "status": "imported"
    },
    "voice_059:r_40c5a9358ed5bf29": {
      "text": "No one can stop me now!",
      "status": "imported"
    },
    "voice_059:r_f2e18dfdfe0c89ea": {
      "text": "I'll lend you a hand, C.C.!",
      "status": "imported"
    },
    "voice_059:r_cf7dbf49e96a5755": {
      "text": "You're pretty reliable, Suzaku!",
      "status": "imported"
    },
    "voice_059:r_fa96676cc65bb509": {
      "text": "Fall back, C.C.!",
      "status": "imported"
    },
    "voice_059:r_4e37f92e7d2fc62e": {
      "text": "Don't just stand there, Suzaku!",
      "status": "imported"
    },
    "voice_059:r_66ab4cfe1557909d": {
      "text": "Get a grip, Lelouch!",
      "status": "imported"
    },
    "voice_059:r_0bad405ee6ca63ba": {
      "text": "Incredible...! That's S.E.I.T.E.N.!",
      "status": "imported"
    },
    "voice_059:r_2072eaf71a260ae7": {
      "text": "This is Energy Wing's speed!",
      "status": "imported"
    },
    "voice_059:r_6c13bbfd27a7799e": {
      "text": "You scratched S.E.I.T.E.N....!",
      "status": "imported"
    },
    "voice_059:r_06f88dcbd3c9e738": {
      "text": "You're on S.E.I.T.E.N.'s heels...!",
      "status": "imported"
    },
    "voice_059:r_b28faf9f71bc3598": {
      "text": "This S.E.I.T.E.N.\\nYou cornered it?!",
      "status": "imported"
    },
    "voice_059:r_8a29278549f8e07a": {
      "text": "Thanks! Play again soon, or else...",
      "status": "imported"
    },
    "voice_059:r_7e6c573c26177f98": {
      "text": "You're just as unfriendly!",
      "status": "imported"
    },
    "voice_059:r_45abf84f7757d6eb": {
      "text": "Huh?! What was that?!",
      "status": "imported"
    },
    "voice_059:r_edd7a13ab8f06a14": {
      "text": "I need power to fight Britannia!",
      "status": "imported"
    },
    "voice_059:r_8165e5b41f0124c4": {
      "text": "Time to settle this, Suzaku!",
      "status": "imported"
    },
    "voice_059:r_4e05581b7432cce8": {
      "text": "Goodbye, Lelouch...",
      "status": "imported"
    },
    "voice_059:r_e33693e5ba4665b0": {
      "text": "Disappear!",
      "status": "imported"
    },
    "voice_059:r_eb643f8bf737a0ca": {
      "text": "Haaaaah!",
      "status": "imported"
    },
    "voice_059:r_1d6d784036ae0bd7": {
      "text": "Burst!",
      "status": "imported"
    },
    "voice_059:r_625664af02183c17": {
      "text": "I won't yield to the likes of you!",
      "status": "imported"
    },
    "voice_059:r_38e4a434c91d8ef0": {
      "text": "This is the Radiant Wave Surger!",
      "status": "imported"
    },
    "voice_059:r_98ed411352a3a6ac": {
      "text": "I'm Kallen Kozuki! Remember that!",
      "status": "imported"
    },
    "voice_059:r_862b92e63adb9734": {
      "text": "Got you!",
      "status": "imported"
    },
    "voice_059:r_cb306ef55e49d107": {
      "text": "Be blown away!",
      "status": "imported"
    },
    "voice_059:r_57b2bd2de8a1408d": {
      "text": "See that? That's Guren's power!",
      "status": "imported"
    },
    "voice_059:r_6f95653e548f8fcf": {
      "text": "Eat this!",
      "status": "imported"
    },
    "voice_059:r_d249d68bada91ab9": {
      "text": "We won't lose...! Guren and I!",
      "status": "imported"
    },
    "voice_059:r_03cdac73042343ee": {
      "text": "Even from this far away...!",
      "status": "imported"
    },
    "voice_059:r_a0f2074af8debbfa": {
      "text": "So that's all you've got...!",
      "status": "imported"
    },
    "voice_059:r_b5f5a97ed82acb0b": {
      "text": "That doesn't even count as damage!",
      "status": "imported"
    },
    "voice_059:r_d9cd2e4ded064396": {
      "text": "You're terrible at this.",
      "status": "imported"
    },
    "voice_059:r_99e6349431aaf23b": {
      "text": "Don't underestimate humanity!",
      "status": "imported"
    },
    "voice_059:r_76d1e51c8b494a60": {
      "text": "You know, you're pretty vulgar!",
      "status": "imported"
    },
    "voice_059:r_3fc2e1186557e7a0": {
      "text": "The world doesn't need rulers!",
      "status": "imported"
    },
    "voice_059:r_0bc8ae32a406ceab": {
      "text": "I'll hold that one off!",
      "status": "imported"
    },
    "voice_059:r_82c09f011d703b2c": {
      "text": "If I can help everyone a little...!",
      "status": "imported"
    },
    "voice_059:r_2b4d8818c77b6dca": {
      "text": "I'll fight too...! So we can win!",
      "status": "imported"
    },
    "voice_059:r_087354f2db0a31e6": {
      "text": "I'll take that role!",
      "status": "imported"
    },
    "voice_059:r_db02a2dec93dd263": {
      "text": "Roger! Leave this side to me!",
      "status": "imported"
    },
    "voice_059:r_d520c6d5298a848d": {
      "text": "It's in my hands. I'll pull it off!",
      "status": "imported"
    },
    "voice_059:r_099e2458cabf796f": {
      "text": "If it's a one-on-one fight...!",
      "status": "imported"
    },
    "voice_059:r_fd910d714be70870": {
      "text": "If fighting is the only choice!",
      "status": "imported"
    }
  }
}
