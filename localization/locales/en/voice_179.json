{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_179:r_479b340ccc6c572b": {
      "text": "Here we go!",
      "status": "imported"
    },
    "voice_179:r_77949221bf58f862": {
      "text": "Everyone, are you ready?!",
      "status": "imported"
    },
    "voice_179:r_70b9c4b9f1f37eff": {
      "text": "All employees, give it your all!",
      "status": "imported"
    },
    "voice_179:r_9fcb3754cb1773c7": {
      "text": "We can't let Boss fight\\nall alone!",
      "status": "imported"
    },
    "voice_179:r_3559d2fad32c2435": {
      "text": "That's right! We'll fight too!",
      "status": "imported"
    },
    "voice_179:r_f7570547e9f80a64": {
      "text": "No fighting means no paycheck!",
      "status": "imported"
    },
    "voice_179:r_cbab0f4720e1fcf1": {
      "text": "That would be a huge disaster!",
      "status": "imported"
    },
    "voice_179:r_0bbe0b4f5364e732": {
      "text": "Takeo General's power-\\nbehold!",
      "status": "imported"
    },
    "voice_179:r_5dda5198137cb02a": {
      "text": "Yes! I'll do my best too!",
      "status": "imported"
    },
    "voice_179:r_83ec59afbecdec14": {
      "text": "Cut costs,\\nattack one more time!",
      "status": "imported"
    },
    "voice_179:r_e20bfd42ad95a3c9": {
      "text": "Your job,\\nour job too! Let's go!",
      "status": "imported"
    },
    "voice_179:r_6dbcc507fb61b51d": {
      "text": "No retreat, even against monsters!",
      "status": "imported"
    },
    "voice_179:r_b42ab697149a7c8a": {
      "text": "Vile aliens attacking Earth! Fight!",
      "status": "imported"
    },
    "voice_179:r_4de4fcf3b440baf4": {
      "text": "Everyone! This is our big moment!",
      "status": "imported"
    },
    "voice_179:r_0121a166c715cdff": {
      "text": "Exec! Heterodyne is\\nDai-Guard's job!",
      "status": "imported"
    },
    "voice_179:r_30fad37a42bd3ad3": {
      "text": "Nonsense! We'll fight too!",
      "status": "imported"
    },
    "voice_179:r_80a0b2a84e05d81a": {
      "text": "Mechanical Beasts need\\nMazinger Z...",
      "status": "imported"
    },
    "voice_179:r_4a9ac1dff86506d9": {
      "text": "We can't always rely on others!",
      "status": "imported"
    },
    "voice_179:r_bc8538e6af3d2577": {
      "text": "Fighting people in Shuttle?!",
      "status": "imported"
    },
    "voice_179:r_924516c8de2b5342": {
      "text": "I feel the same way, yes...",
      "status": "imported"
    },
    "voice_179:r_0fadb5c26df92b42": {
      "text": "Looks like they're psychic, Exec!",
      "status": "imported"
    },
    "voice_179:r_6b15af9a0057cdc8": {
      "text": "No fear! Spoons aboard\\nare hidden!",
      "status": "imported"
    },
    "voice_179:r_15b4a90140e8a33a": {
      "text": "Exec! They look awfully strong!",
      "status": "imported"
    },
    "voice_179:r_af884a6b11dff121": {
      "text": "We can't overdo it,\\nor run away!",
      "status": "imported"
    },
    "voice_179:r_ac6fe7838e95647b": {
      "text": "You fiend! I shall punish you!",
      "status": "imported"
    },
    "voice_179:r_77ca87eacd17ad52": {
      "text": "21st Century Security\\nwon't win!",
      "status": "imported"
    },
    "voice_179:r_bf3244994760e535": {
      "text": "Aim, aim, aim...\\nFire the Missile!",
      "status": "imported"
    },
    "voice_179:r_aabfb21c9d069ce7": {
      "text": "Please aim carefully... Now!",
      "status": "imported"
    },
    "voice_179:r_02479dc8fe989560": {
      "text": "Let's go big!",
      "status": "imported"
    },
    "voice_179:r_a2df00f91a9b0a9e": {
      "text": "I, Umemaro Kakikouji, will do it!",
      "status": "imported"
    },
    "voice_179:r_48b60d6c48b9b142": {
      "text": "Keep at it, Exec!",
      "status": "imported"
    },
    "voice_179:r_719e897304ec42d4": {
      "text": "There! Now! Return fire!",
      "status": "imported"
    },
    "voice_179:r_d5e0a2317c40d322": {
      "text": "If we let them, we're sitting ducks!",
      "status": "imported"
    },
    "voice_179:r_ec2ea17765052401": {
      "text": "That's right!\\nWe'll counterattack!",
      "status": "imported"
    },
    "voice_179:r_f2d4255f1c2f7542": {
      "text": "We can't just sit here\\nand take it!",
      "status": "imported"
    },
    "voice_179:r_5d08ad19e2da125b": {
      "text": "Let's hit back big! Go big!",
      "status": "imported"
    },
    "voice_179:r_a7246b52782a877e": {
      "text": "We'll cover you!",
      "status": "imported"
    },
    "voice_179:r_dc8701f6bcb9904f": {
      "text": "Young Boss! We're here to help!!",
      "status": "imported"
    },
    "voice_179:r_d6bdd730f24f66eb": {
      "text": "We're here to support Trider!",
      "status": "imported"
    },
    "voice_179:r_41997412868c48c4": {
      "text": "21st Century Security-\\nwe owe you!",
      "status": "imported"
    },
    "voice_179:r_9e6cf4f389dae55c": {
      "text": "Otsuka!\\nWe'll aid the Crusher Team!",
      "status": "imported"
    },
    "voice_179:r_7432ef43ed3471dc": {
      "text": "Forget repairs-\\nthis isn't the time!",
      "status": "imported"
    },
    "voice_179:r_065443f6ddfcf0d7": {
      "text": "Boss! We're coming right now!!",
      "status": "imported"
    },
    "voice_179:r_47d52a2839c71715": {
      "text": "We'll serve as the Boss's shield!",
      "status": "imported"
    },
    "voice_179:r_847f82e7f3eef651": {
      "text": "Rivals or not,\\nwe won't leave them!",
      "status": "imported"
    },
    "voice_179:r_eb7ae28b53dc033c": {
      "text": "Tell Otsuka\\nof our company's valor!",
      "status": "imported"
    },
    "voice_179:r_55417493fce1d347": {
      "text": "No counter!\\nUmemaro, forever shamed!",
      "status": "imported"
    },
    "voice_179:r_8fdf5910927c9591": {
      "text": "Ikue! How much energy is left?!",
      "status": "imported"
    },
    "voice_179:r_7d724dbcc4451e10": {
      "text": "No good! We can't counter like this!",
      "status": "imported"
    },
    "voice_179:r_93e25418a203cb8f": {
      "text": "Out of reach! Pay\\nmisses loans too!",
      "status": "imported"
    },
    "voice_179:r_adeb0a29274d3d9b": {
      "text": "Nobody asked about that!",
      "status": "imported"
    },
    "voice_179:r_24cf161287ef9d5c": {
      "text": "Such a weak attack\\nwon't hit us!",
      "status": "imported"
    },
    "voice_179:r_8f60f6fc86db3107": {
      "text": "Phew... Looks like we dodged it.",
      "status": "imported"
    },
    "voice_179:r_b1de76a75a253c13": {
      "text": "Ah! D-Dange... That's dangerous?!",
      "status": "imported"
    },
    "voice_179:r_128c35bf3e0e394c": {
      "text": "Exec! Quiet, or bite your tongue!",
      "status": "imported"
    },
    "voice_179:r_5213c17e13b23de0": {
      "text": "See that?!\\nKinoshita's Ultra C!",
      "status": "imported"
    },
    "voice_179:r_38fdff9483e9245c": {
      "text": "Don't get cocky!\\nNext one! The next!",
      "status": "imported"
    },
    "voice_179:r_620fedec67706d7d": {
      "text": "The enemy's attack missed!",
      "status": "imported"
    },
    "voice_179:r_9680dcd0fddcfcc7": {
      "text": "Wahaha!\\nLuck counts as skill!",
      "status": "imported"
    },
    "voice_179:r_2a00f1044ad5cbaa": {
      "text": "What did that barrier cost...?",
      "status": "imported"
    },
    "voice_179:r_3dbeead1bd3164ef": {
      "text": "You think that'll work?!",
      "status": "imported"
    },
    "voice_179:r_ac341e7976e88f0b": {
      "text": "Built to last!\\nOur proud Shuttle!",
      "status": "imported"
    },
    "voice_179:r_cdbd128a5b4127cc": {
      "text": "Aaaagh?!\\n...Huh? No big deal.",
      "status": "imported"
    },
    "voice_179:r_cfccaa1fbeda124c": {
      "text": "Hey! I only just polished it!",
      "status": "imported"
    },
    "voice_179:r_b1f8ec192b9c083a": {
      "text": "Repair costs worry me more...",
      "status": "imported"
    },
    "voice_179:r_a007f9ab9cf048b3": {
      "text": "A hit like that is no problem, Exec.",
      "status": "imported"
    },
    "voice_179:r_ddafde4b065ced49": {
      "text": "Don't be stupid!\\nDodging is better!",
      "status": "imported"
    },
    "voice_179:r_de1213040856c089": {
      "text": "Ikue! What's the damage?!",
      "status": "imported"
    },
    "voice_179:r_3304412ac41f47a6": {
      "text": "Just a scratch.\\nWe're not done yet!",
      "status": "imported"
    },
    "voice_179:r_0c0775e051211840": {
      "text": "Grrr...! As expected, they're good!",
      "status": "imported"
    },
    "voice_179:r_a2afffe1c396f0b3": {
      "text": "Owww!\\nH-How could you do that?!",
      "status": "imported"
    },
    "voice_179:r_13c25fbdfddc8a24": {
      "text": "M-Mgr! Where did that hit?!",
      "status": "imported"
    },
    "voice_179:r_42ba1ecb310b4bd7": {
      "text": "Not fatal,\\nbut still pretty bad!",
      "status": "imported"
    },
    "voice_179:r_d692f1d420460a47": {
      "text": "I, Umemaro,\\nwon't fall to this!",
      "status": "imported"
    },
    "voice_179:r_a5643cec86b18bd2": {
      "text": "Exec is safe,\\nbut Shuttle isn't!",
      "status": "imported"
    },
    "voice_179:r_68f2dfab20a4a30e": {
      "text": "I-Ikue!\\nIs Shuttle all right?!",
      "status": "imported"
    },
    "voice_179:r_9cedad8237480563": {
      "text": "Y-Yes! But any more is dangerous!",
      "status": "imported"
    },
    "voice_179:r_a03fabecba1508ca": {
      "text": "Gnnngh!\\nStill okay! Still okay!!",
      "status": "imported"
    },
    "voice_179:r_5391b24a71eb10ae": {
      "text": "Fall here,\\nshame our former Boss!!",
      "status": "imported"
    },
    "voice_179:r_a554ceef5c87b972": {
      "text": "Core hit! Seal it!\\nAuto extinguish!",
      "status": "imported"
    },
    "voice_179:r_546c3d5937fbb7ee": {
      "text": "W-We must hold out at any cost!",
      "status": "imported"
    },
    "voice_179:r_1568ff6298b12b96": {
      "text": "Short life...\\nTime to write my will.",
      "status": "imported"
    },
    "voice_179:r_2c9d94ba13c5fc50": {
      "text": "Forget that! Focus on surviving!",
      "status": "imported"
    },
    "voice_179:r_a77f4913375098d2": {
      "text": "Over 70% damage!\\nWe won't last!",
      "status": "imported"
    },
    "voice_179:r_428c2116ac3071b1": {
      "text": "Not for free!\\nRam Attack if need be!",
      "status": "imported"
    },
    "voice_179:r_84c116267b79f540": {
      "text": "E-Evacuate! Everyone, evacuate!",
      "status": "imported"
    },
    "voice_179:r_dad38ee29af2df3a": {
      "text": "Right! Power isn't cheap either!",
      "status": "imported"
    },
    "voice_179:r_3d32e86f8dc80909": {
      "text": "Indeed. I agree.",
      "status": "imported"
    },
    "voice_179:r_70451ffbabe2f876": {
      "text": "Honestly, Boss... Don't be selfish.",
      "status": "imported"
    },
    "voice_179:r_69dfa1659715e2fa": {
      "text": "That's right, Boss. You need breaks.",
      "status": "imported"
    },
    "voice_179:r_d996fd6d4ef5b329": {
      "text": "I can do it too! Just watch me!",
      "status": "imported"
    },
    "voice_179:r_8ab47a28f99ef565": {
      "text": "Underestimate Shuttle and get hurt!",
      "status": "imported"
    },
    "voice_179:r_9072ea7bc71df136": {
      "text": "Missile, launch!",
      "status": "imported"
    },
    "voice_179:r_04e815a8d425827d": {
      "text": "All right! Missile attack!",
      "status": "imported"
    },
    "voice_179:r_d89011fe3e5d082a": {
      "text": "Leave the rest to Shuttle!",
      "status": "imported"
    },
    "voice_179:r_3c5b0c2ac812d5de": {
      "text": "Bad! They're targeting our allies!",
      "status": "imported"
    },
    "voice_179:r_5b9e8897190892eb": {
      "text": "Damn! I can't locate the enemy!",
      "status": "imported"
    },
    "voice_179:r_7bea3023abbf8a94": {
      "text": "No good! We can't do anything now!",
      "status": "imported"
    },
    "voice_179:r_dd01a4c0d1b36a8d": {
      "text": "I know how to handle Shuttle!",
      "status": "imported"
    },
    "voice_179:r_20920ad2eb3542db": {
      "text": "The barrier's functioning normally!",
      "status": "imported"
    },
    "voice_179:r_0ab7914877fd48ed": {
      "text": "Didn't affect us at all!",
      "status": "imported"
    },
    "voice_179:r_cb846feec748c2e3": {
      "text": "I've improved it day and night!",
      "status": "imported"
    },
    "voice_179:r_c958860b0676b1f5": {
      "text": "I'll have this fixed in no time!",
      "status": "imported"
    },
    "voice_179:r_5e2669b82ef75ce3": {
      "text": "If the engine's safe, we can manage!",
      "status": "imported"
    },
    "voice_179:r_7847e0ed7dc9282d": {
      "text": "Shuttle is ruined...\\nHow shameful!",
      "status": "imported"
    },
    "voice_179:r_e42b52c7a987b906": {
      "text": "Even Shuttle can fight...!",
      "status": "imported"
    },
    "voice_179:r_6825fd1ff907bd22": {
      "text": "I hope my office skills will help...",
      "status": "imported"
    },
    "voice_179:r_b84afafb8a33ec60": {
      "text": "Fire the Missile!",
      "status": "imported"
    },
    "voice_179:r_c8c59db85bf875e6": {
      "text": "Let's see, Missile is... Ah, this!",
      "status": "imported"
    },
    "voice_179:r_391aa56435d9dd6e": {
      "text": "You can leave the rest to us!",
      "status": "imported"
    },
    "voice_179:r_7c796ba53bd7ea03": {
      "text": "Please stand back!",
      "status": "imported"
    },
    "voice_179:r_fa944da4b6519006": {
      "text": "Can't counter,\\nwe'll be easy prey!",
      "status": "imported"
    },
    "voice_179:r_95d047bcc17fccc6": {
      "text": "That's fine piloting, Mgr!",
      "status": "imported"
    },
    "voice_179:r_640327a12a559b31": {
      "text": "The barrier's working beautifully!",
      "status": "imported"
    },
    "voice_179:r_bdd38c584fa313d0": {
      "text": "Eek! I think something hit us!",
      "status": "imported"
    },
    "voice_179:r_3fd86c1027f317c8": {
      "text": "At times like this-\\nfight! Fight!",
      "status": "imported"
    },
    "voice_179:r_d0372a183d2007ad": {
      "text": "As staff, I'll fight to the end!",
      "status": "imported"
    },
    "voice_179:r_217aa5e1d545b44d": {
      "text": "No good! Shuttle can't move!",
      "status": "imported"
    },
    "voice_179:r_381992c5d8224937": {
      "text": "Let's kick this battle off big!",
      "status": "imported"
    },
    "voice_179:r_7d2617c809fead70": {
      "text": "This is a Missile attack!",
      "status": "imported"
    },
    "voice_179:r_ceb935ccbf830724": {
      "text": "Missile, firing!",
      "status": "imported"
    },
    "voice_179:r_862ef7385bf2abd4": {
      "text": "Leave the rest to us!",
      "status": "imported"
    },
    "voice_179:r_001cbec4d9a4283f": {
      "text": "P-Please run!",
      "status": "imported"
    },
    "voice_179:r_8ad40afecd02b41e": {
      "text": "Oh no!\\nWe lost sight of the enemy!",
      "status": "imported"
    },
    "voice_179:r_26e5efec03c03d78": {
      "text": "This is Kinoshita's true skill!",
      "status": "imported"
    },
    "voice_179:r_4ad81e88c7557a8b": {
      "text": "This barrier is incredible!",
      "status": "imported"
    },
    "voice_179:r_1f65a7af190e4674": {
      "text": "Hah! The enemy's nothing special!",
      "status": "imported"
    },
    "voice_179:r_40c5a9358ed5bf29": {
      "text": "N-Not bad at all...",
      "status": "imported"
    },
    "voice_179:r_f2e18dfdfe0c89ea": {
      "text": "N-No!\\nShuttle and company are done!",
      "status": "imported"
    },
    "voice_179:r_cf7dbf49e96a5755": {
      "text": "Everyone...\\nBye, bye, bye...",
      "status": "imported"
    },
    "voice_179:r_fa96676cc65bb509": {
      "text": "Sorry for the trouble, as always.",
      "status": "imported"
    },
    "voice_179:r_4e37f92e7d2fc62e": {
      "text": "Trider will now launch.",
      "status": "imported"
    },
    "voice_179:r_66ab4cfe1557909d": {
      "text": "For safety, clear the white line.",
      "status": "imported"
    },
    "voice_179:r_0bad405ee6ca63ba": {
      "text": "Boss,\\nhow about a snack?",
      "status": "imported"
    },
    "voice_179:r_2072eaf71a260ae7": {
      "text": "Too many Missiles will cost us...",
      "status": "imported"
    },
    "voice_179:r_6c13bbfd27a7799e": {
      "text": "This is no time to say that!",
      "status": "imported"
    },
    "voice_179:r_06f88dcbd3c9e738": {
      "text": "Hit them with the Beam!",
      "status": "imported"
    },
    "voice_179:r_b28faf9f71bc3598": {
      "text": "Even the Beam consumes fuel!",
      "status": "imported"
    },
    "voice_179:r_8a29278549f8e07a": {
      "text": "I know! Leave this to me!",
      "status": "imported"
    },
    "voice_179:r_7e6c573c26177f98": {
      "text": "Time to go big with a Beam attack!",
      "status": "imported"
    },
    "voice_179:r_45abf84f7757d6eb": {
      "text": "Chief's in charge,\\nso I'm uneasy...",
      "status": "imported"
    },
    "voice_179:r_edd7a13ab8f06a14": {
      "text": "Ikue! Fire the Beam!",
      "status": "imported"
    },
    "voice_179:r_8165e5b41f0124c4": {
      "text": "Understood! Hyaaah!",
      "status": "imported"
    },
    "voice_179:r_4e05581b7432cce8": {
      "text": "Eat this Beam!",
      "status": "imported"
    },
    "voice_179:r_a60b107ea3c36a86": {
      "text": "All right! Fire the Beam!",
      "status": "imported"
    },
    "voice_179:r_e33693e5ba4665b0": {
      "text": "Attacking with the Beam!",
      "status": "imported"
    },
    "voice_179:r_72a21a1a489af001": {
      "text": "This is the Beam button!",
      "status": "imported"
    },
    "voice_179:r_eb643f8bf737a0ca": {
      "text": "There! Beam attack!",
      "status": "imported"
    },
    "voice_179:r_0a3fccb71ec6cf2a": {
      "text": "Firing the Beam!",
      "status": "imported"
    },
    "voice_179:r_9b63cf1f3e0207ef": {
      "text": "Let's work hard again today!",
      "status": "imported"
    },
    "voice_179:r_8356f4e3dcdff938": {
      "text": "All right! Commence battle!",
      "status": "imported"
    },
    "voice_179:r_1d6d784036ae0bd7": {
      "text": "Let's go too!",
      "status": "imported"
    },
    "voice_179:r_625664af02183c17": {
      "text": "Behold the Chief's skill!",
      "status": "imported"
    },
    "voice_179:r_4824bea6bab3af67": {
      "text": "Now it's our turn!",
      "status": "imported"
    },
    "voice_179:r_862b92e63adb9734": {
      "text": "Time to properly return the favor!",
      "status": "imported"
    },
    "voice_179:r_cb306ef55e49d107": {
      "text": "The enemy's getting away! Hurry!",
      "status": "imported"
    },
    "voice_179:r_57b2bd2de8a1408d": {
      "text": "Leave both sales and combat to me!",
      "status": "imported"
    },
    "voice_179:r_76f080a4881e8ab5": {
      "text": "I, Kinoshita, won't back down here!",
      "status": "imported"
    },
    "voice_179:r_288133bc5b573dae": {
      "text": "Now we can launch an attack too!",
      "status": "imported"
    },
    "voice_179:r_6f95653e548f8fcf": {
      "text": "I can fight around the clock!",
      "status": "imported"
    },
    "voice_179:r_d249d68bada91ab9": {
      "text": "Old Boss! Young Boss!\\nI'm sorry!!",
      "status": "imported"
    },
    "voice_179:r_e9b3307e9eb69f11": {
      "text": "Shuttle...! Damn it!!",
      "status": "imported"
    },
    "voice_179:r_03cdac73042343ee": {
      "text": "I-I'll be leaving before you!",
      "status": "imported"
    },
    "voice_179:r_6026da5acbda7c69": {
      "text": "I maintain Shuttle!\\nIt won't fall!",
      "status": "imported"
    },
    "voice_179:r_981f8fedd5414fe5": {
      "text": "Aaaah!\\nWe'll crash if this keeps up!",
      "status": "imported"
    },
    "voice_179:r_96bb0dcde0c8c44a": {
      "text": "Anyone at all, please help us!",
      "status": "imported"
    },
    "voice_179:r_641550a2f54cb456": {
      "text": "Parts cost more!\\nNo more!",
      "status": "imported"
    },
    "voice_179:r_a0f2074af8debbfa": {
      "text": "I need to tally up the damages...!",
      "status": "imported"
    },
    "voice_179:r_b5f5a97ed82acb0b": {
      "text": "Ah! Whoa!\\nWe must act fast!!",
      "status": "imported"
    },
    "voice_179:r_d9cd2e4ded064396": {
      "text": "This barely even counts as damage!",
      "status": "imported"
    },
    "voice_179:r_99e6349431aaf23b": {
      "text": "We can rest easy with just this!",
      "status": "imported"
    },
    "voice_179:r_ec1081caf845f56a": {
      "text": "Oho! We're shaking a little!",
      "status": "imported"
    },
    "voice_179:r_2c5b7ee872c1ed7f": {
      "text": "I won't let them damage Shuttle!",
      "status": "imported"
    },
    "voice_179:r_76d1e51c8b494a60": {
      "text": "Phew... Looks like it worked.",
      "status": "imported"
    },
    "voice_179:r_eb5f687fcd372ae7": {
      "text": "We did it! We really did it!",
      "status": "imported"
    },
    "voice_179:r_0e7466971bec4cc4": {
      "text": "The enemy's attacks can't reach us!",
      "status": "imported"
    },
    "voice_179:r_efa71f7a4cc33ff3": {
      "text": "If that's all, keep it coming!",
      "status": "imported"
    },
    "voice_179:r_854aa0a91a3c80d1": {
      "text": "We'll protect you!",
      "status": "imported"
    },
    "voice_179:r_0bc8ae32a406ceab": {
      "text": "That's cheating! Shame! Shame!",
      "status": "imported"
    },
    "voice_179:r_82c09f011d703b2c": {
      "text": "We truly can't do anything...!",
      "status": "imported"
    },
    "voice_179:r_2b4d8818c77b6dca": {
      "text": "Grrr...! We can't do a thing!",
      "status": "imported"
    },
    "voice_179:r_087354f2db0a31e6": {
      "text": "We deliver fast and handle it all!",
      "status": "imported"
    },
    "voice_179:r_db02a2dec93dd263": {
      "text": "Leave this to us!",
      "status": "imported"
    }
  }
}
