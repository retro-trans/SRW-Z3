    },
    "voice_048:r_be661448b85d0009": {
      "text": "Let me show you how it's done!",
      "status": "imported"
    },
    "voice_048:r_958a56c1151cab9e": {
      "text": "Here, some covering fire for you!",
      "status": "imported"
    },
    "voice_048:r_8b18aa4cc69547df": {
      "text": "So that's my share of the spoils.",
