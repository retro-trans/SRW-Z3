{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_048:r_479b340ccc6c572b": {
      "text": "Hah!",
      "status": "imported"
    },
    "voice_048:r_ca4acbac57a2a35e": {
      "text": "See ya!",
      "status": "imported"
    },
    "voice_048:r_77949221bf58f862": {
      "text": "How's this!",
      "status": "imported"
    },
    "voice_048:r_70b9c4b9f1f37eff": {
      "text": "Here you go!",
      "status": "imported"
    },
    "voice_048:r_9fcb3754cb1773c7": {
      "text": "Die.",
      "status": "imported"
    },
    "voice_048:r_3559d2fad32c2435": {
      "text": "Take this, damn you!",
      "status": "imported"
    },
    "voice_048:r_f7570547e9f80a64": {
      "text": "Hahahahaha!",
      "status": "imported"
    },
    "voice_048:r_cbab0f4720e1fcf1": {
      "text": "Brace yourself!",
      "status": "imported"
    },
    "voice_048:r_0bbe0b4f5364e732": {
      "text": "Disappear!",
      "status": "imported"
    },
    "voice_048:r_5dda5198137cb02a": {
      "text": "Now there's some enticing prey.",
      "status": "imported"
    },
    "voice_048:r_83ec59afbecdec14": {
      "text": "You wanna try dying too?",
      "status": "imported"
    },
    "voice_048:r_e20bfd42ad95a3c9": {
      "text": "I'm a gentleman.\\nI show no mercy.",
      "status": "imported"
    },
    "voice_048:r_0f58a8822381e57f": {
      "text": "Where should I\\nblow you apart first?",
      "status": "imported"
    },
    "voice_048:r_6dbcc507fb61b51d": {
      "text": "Say hi to the Sanzu ferryman.",
      "status": "imported"
    },
    "voice_048:r_b42ab697149a7c8a": {
      "text": "Regretfully, this is goodbye.",
      "status": "imported"
    },
    "voice_048:r_4de4fcf3b440baf4": {
      "text": "Now, can you survive this?",
      "status": "imported"
    },
    "voice_048:r_0121a166c715cdff": {
      "text": "Don't go dying too easily on me.",
      "status": "imported"
    },
    "voice_048:r_30fad37a42bd3ad3": {
      "text": "Well? Gonna beg for your life?",
      "status": "imported"
    },
    "voice_048:r_80a0b2a84e05d81a": {
      "text": "I'll strip you bare!",
      "status": "imported"
    },
    "voice_048:r_4a9ac1dff86506d9": {
      "text": "You...\\nwill die a gruesome death!",
      "status": "imported"
    },
    "voice_048:r_bc8538e6af3d2577": {
      "text": "Now then,\\nlet the fun begin!",
      "status": "imported"
    },
    "voice_048:r_924516c8de2b5342": {
      "text": "Where should I shoot you through?",
      "status": "imported"
    },
    "voice_048:r_da1174533722333f": {
      "text": "Let's make you dance up a storm!",
      "status": "imported"
    },
    "voice_048:r_fdeb8162976e72c1": {
      "text": "You can't escape my sights!",
      "status": "imported"
    },
    "voice_048:r_0fadb5c26df92b42": {
      "text": "I've locked on to your life!",
      "status": "imported"
    },
    "voice_048:r_6b15af9a0057cdc8": {
      "text": "The fun's only getting started!",
      "status": "imported"
    },
    "voice_048:r_15b4a90140e8a33a": {
      "text": "Consider this after-sales service!",
      "status": "imported"
    },
    "voice_048:r_af884a6b11dff121": {
      "text": "Fancy meeting you again like this!",
      "status": "imported"
    },
    "voice_048:r_ac6fe7838e95647b": {
      "text": "I'm thrilled to see you, Kashim!",
      "status": "imported"
    },
    "voice_048:r_77ca87eacd17ad52": {
      "text": "Kaaaashiiiim!!",
      "status": "imported"
    },
    "voice_048:r_bf3244994760e535": {
      "text": "Hate me! Hate me!\\nKashiiim!!",
      "status": "imported"
    },
    "voice_048:r_aabfb21c9d069ce7": {
      "text": "I'm here to settle up, Kashim!",
      "status": "imported"
    },
    "voice_048:r_02479dc8fe989560": {
      "text": "Let's settle this once and for all!",
      "status": "imported"
    },
    "voice_048:r_a2df00f91a9b0a9e": {
      "text": "Everyone at Mithril, I missed you!",
      "status": "imported"
    },
    "voice_048:r_48b60d6c48b9b142": {
      "text": "I'm sick of seeing your faces.",
      "status": "imported"
    },
    "voice_048:r_8927e6fb681aa809": {
      "text": "Hey, Ivan, are you in there?",
      "status": "imported"
    },
    "voice_048:r_665f01666859013b": {
      "text": "Let's greet your cute, cute\\ncaptain!",
      "status": "imported"
    },
    "voice_048:r_a571eec59b258d11": {
      "text": "Oh, dear.\\nA girl shouldn't fight!",
      "status": "imported"
    },
    "voice_048:r_ddbe581c5ea9183d": {
      "text": "Kids are so adorable. Like dogs!",
      "status": "imported"
    },
    "voice_048:r_faae935cca0edc72": {
      "text": "You should be kind to the elderly!",
      "status": "imported"
    },
    "voice_048:r_d4430bf362340b32": {
      "text": "A young CEO? Very, very impressive!",
      "status": "imported"
    },
    "voice_048:r_6ff1323b355593e0": {
      "text": "Come play with Uncle,\\nboy detective?",
      "status": "imported"
    },
    "voice_048:r_b7b5625d7cd4282f": {
      "text": "Let's see those psychic powers!",
      "status": "imported"
    },
    "voice_048:r_36133ad73a73ef98": {
      "text": "Heard the rumors,\\nex-Red Shoulder!",
      "status": "imported"
    },
    "voice_048:r_920740a0219c5085": {
      "text": "Let's test those\\nimmortality rumors!",
      "status": "imported"
    },
    "voice_048:r_a8451712c57c1a72": {
      "text": "Are you\\nthat rumored Newtype?",
      "status": "imported"
    },
    "voice_048:r_3633df5b7b8f47fa": {
      "text": "Live up to your name,\\nGundam!",
      "status": "imported"
    },
    "voice_048:r_52dfc56b14b93551": {
      "text": "Gundams need\\nthinning out!",
      "status": "imported"
    },
    "voice_048:r_1b9b2aab5cb104da": {
      "text": "Care for a bout,\\nyoung terrorist?",
      "status": "imported"
    },
    "voice_048:r_342044c706a2340f": {
      "text": "Oh, a business rival has arrived!",
      "status": "imported"
    },
    "voice_048:r_cf41e8828a90cbdb": {
      "text": "Saachez's killers!\\nThis'll be fun!",
      "status": "imported"
    },
    "voice_048:r_719e897304ec42d4": {
      "text": "You all\\nhurt my business enough!",
      "status": "imported"
    },
    "voice_048:r_d5e0a2317c40d322": {
      "text": "Go busk outside the station, pal!",
      "status": "imported"
    },
    "voice_048:r_ec2ea17765052401": {
      "text": "We're fellow mercs!\\nLet's be pals!",
      "status": "imported"
    },
    "voice_048:r_f2d4255f1c2f7542": {
      "text": "No bloody work\\nfor civilians.",
      "status": "imported"
    },
    "voice_048:r_5d08ad19e2da125b": {
      "text": "Shut your noisy mouth!\\nNegotiator!",
      "status": "imported"
    },
    "voice_048:r_a7246b52782a877e": {
      "text": "I have no taste for melodrama!",
      "status": "imported"
    },
    "voice_048:r_dc8701f6bcb9904f": {
      "text": "Let's use tactics\\nto beat strategy!",
      "status": "imported"
    },
    "voice_048:r_d6bdd730f24f66eb": {
      "text": "The Black Knights have fallen far!",
      "status": "imported"
    },
    "voice_048:r_41997412868c48c4": {
      "text": "Masked men\\nalways look suspicious.",
      "status": "imported"
    },
    "voice_048:r_9e6cf4f389dae55c": {
      "text": "Whoa!\\nNot taking that drill!",
      "status": "imported"
    },
    "voice_048:r_9e0c80ac7e33b459": {
      "text": "EVA's terrifying!\\nLike a demon!",
      "status": "imported"
    },
    "voice_048:r_7432ef43ed3471dc": {
      "text": "Even for me, that's off the charts!",
      "status": "imported"
    },
    "voice_048:r_065443f6ddfcf0d7": {
      "text": "I may need to\\nget a bit serious...!",
      "status": "imported"
    },
    "voice_048:r_47d52a2839c71715": {
      "text": "Crush the head, mop up the rest!",
      "status": "imported"
    },
    "voice_048:r_847f82e7f3eef651": {
      "text": "Hit the power core,\\nbig fireworks!",
      "status": "imported"
    },
    "voice_048:r_eb7ae28b53dc033c": {
      "text": "Skip the fuss. Hit the bridge!",
      "status": "imported"
    },
    "voice_048:r_857c4a52ce8df0fd": {
      "text": "Let's give this thing a try!",
      "status": "imported"
    },
    "voice_048:r_55417493fce1d347": {
      "text": "Will it hit? Or will it miss?",
      "status": "imported"
    },
    "voice_048:r_8fdf5910927c9591": {
      "text": "Eh, either way is fine by me!",
      "status": "imported"
    },
    "voice_048:r_7d724dbcc4451e10": {
      "text": "How pathetic...",
      "status": "imported"
    },
    "voice_048:r_93e25418a203cb8f": {
      "text": "Bang!",
      "status": "imported"
    },
    "voice_048:r_adeb0a29274d3d9b": {
      "text": "All right, Lambda Driver, activate!",
      "status": "imported"
    },
    "voice_048:r_24cf161287ef9d5c": {
      "text": "Will you dodge? Or will you defend?",
      "status": "imported"
    },
    "voice_048:r_8f60f6fc86db3107": {
      "text": "Either way, it's useless!",
      "status": "imported"
    },
    "voice_048:r_b1de76a75a253c13": {
      "text": "Aw, you poor thing.",
      "status": "imported"
    },
    "voice_048:r_128c35bf3e0e394c": {
      "text": "Heeere you go!",
      "status": "imported"
    },
    "voice_048:r_5213c17e13b23de0": {
      "text": "I'll show you a little magic trick.",
      "status": "imported"
    },
    "voice_048:r_38fdff9483e9245c": {
      "text": "If it works, enjoy the show...!",
      "status": "imported"
    },
    "voice_048:r_620fedec67706d7d": {
      "text": "How will it go this time?",
      "status": "imported"
    },
    "voice_048:r_9680dcd0fddcfcc7": {
      "text": "Well, that was anticlimactic.",
      "status": "imported"
    },
    "voice_048:r_2a00f1044ad5cbaa": {
      "text": "Zwooom!",
      "status": "imported"
    },
    "voice_048:r_6f95653e548f8fcf": {
      "text": "Time to switch offense and defense.",
      "status": "imported"
    },
    "voice_048:r_d249d68bada91ab9": {
      "text": "Oh my, did you get careless?",
      "status": "imported"
    },
    "voice_048:r_e9b3307e9eb69f11": {
      "text": "You knew this would happen, right?",
      "status": "imported"
    },
    "voice_048:r_03cdac73042343ee": {
      "text": "Good grief... You're awfully noisy.",
      "status": "imported"
    },
    "voice_048:r_6026da5acbda7c69": {
      "text": "I'll pay you back with interest!",
      "status": "imported"
    },
    "voice_048:r_981f8fedd5414fe5": {
      "text": "That shot gave away your position!",
      "status": "imported"
    },
    "voice_048:r_96bb0dcde0c8c44a": {
      "text": "Whoa, can't let my guard down!",
      "status": "imported"
    },
    "voice_048:r_641550a2f54cb456": {
      "text": "Too bad! This is the real attack!",
      "status": "imported"
    },
    "voice_048:r_a0f2074af8debbfa": {
      "text": "Nice attack, Wang Fang.",
      "status": "imported"
    },
    "voice_048:r_b5f5a97ed82acb0b": {
      "text": "Leave the rest to me, Wang Lan.",
      "status": "imported"
    },
    "voice_048:r_d9cd2e4ded064396": {
      "text": "Dawdle and I'll kill you too.",
      "status": "imported"
    },
    "voice_048:r_99e6349431aaf23b": {
      "text": "If you're useless, fall back...!",
      "status": "imported"
    },
    "voice_048:r_ec1081caf845f56a": {
      "text": "Fall back, Wang Fang.",
      "status": "imported"
    },
    "voice_048:r_2c5b7ee872c1ed7f": {
      "text": "Wang Lan, retreat.",
      "status": "imported"
    },
    "voice_048:r_76d1e51c8b494a60": {
      "text": "Well, I'll be. You can't hit back!",
      "status": "imported"
    },
    "voice_048:r_eb5f687fcd372ae7": {
      "text": "You got lucky and lived.",
      "status": "imported"
    },
    "voice_048:r_2329428a6871d9fa": {
      "text": "This is what pisses me off most.",
      "status": "imported"
    },
    "voice_048:r_0e7466971bec4cc4": {
      "text": "I see. So that's another option.",
      "status": "imported"
    },
    "voice_048:r_efa71f7a4cc33ff3": {
      "text": "What's wrong? Are you scared?",
      "status": "imported"
    },
    "voice_048:r_3fc2e1186557e7a0": {
      "text": "You seem to be quite the shy guest.",
      "status": "imported"
    },
    "voice_048:r_fa6930340a545054": {
      "text": "Aw, how pathetic...",
      "status": "imported"
    },
    "voice_048:r_2332b9d56461d7ab": {
      "text": "What a pitiful display...",
      "status": "imported"
    },
    "voice_048:r_854aa0a91a3c80d1": {
      "text": "Ooh, how scary.",
      "status": "imported"
    },
    "voice_048:r_0bc8ae32a406ceab": {
      "text": "Reality's always a harsh thing.",
      "status": "imported"
    },
    "voice_048:r_82c09f011d703b2c": {
      "text": "Can't hurt if it doesn't hit, right?",
      "status": "imported"
    },
    "voice_048:r_2b4d8818c77b6dca": {
      "text": "No good. You've no fight in you.",
      "status": "imported"
    },
    "voice_048:r_087354f2db0a31e6": {
      "text": "Oh, Kashim... Don't disappoint me.",
      "status": "imported"
    },
    "voice_048:r_db02a2dec93dd263": {
      "text": "You ran with weaklings. Now look.",
      "status": "imported"
    },
    "voice_048:r_d520c6d5298a848d": {
      "text": "What a waste of new gear, Mithril.",
      "status": "imported"
    },
    "voice_048:r_099e2458cabf796f": {
      "text": "Shouldn't the heroes be winning?",
      "status": "imported"
    },
    "voice_048:r_494b5da92ed24ecb": {
      "text": "Nice work wasting all that effort!",
      "status": "imported"
    },
    "voice_048:r_a4a5a96f4bd58920": {
      "text": "So pathetic I could cry...",
      "status": "imported"
    },
    "voice_048:r_c94c6d04be583774": {
      "text": "Too bad! I've got this trick too!",
      "status": "imported"
    },
    "voice_048:r_e54e2c99ef8297af": {
      "text": "This is what a Lambda Driver does.",
      "status": "imported"
    },
    "voice_048:r_f16a3eb0bcaac082": {
      "text": "Thanks. My shoulders feel better.",
      "status": "imported"
    },
    "voice_048:r_10a408809e512df1": {
      "text": "What's wrong? No need to hold back.",
      "status": "imported"
    },
    "voice_048:r_bc7b9e308b879dd4": {
      "text": "That attack was like a damn fart.",
      "status": "imported"
    },
    "voice_048:r_98902fd3143c393e": {
      "text": "Oh my, is that really your best?",
      "status": "imported"
    },
    "voice_048:r_d907fbd7bc1c4298": {
      "text": "I don't mind picking on the weak.",
      "status": "imported"
    },
    "voice_048:r_96b21e3a028dd074": {
      "text": "Well, well, well!\\nSo fired up...!",
      "status": "imported"
    },
    "voice_048:r_ce140b5d8e6b7310": {
      "text": "That's full power? I could just cry.",
      "status": "imported"
    },
    "voice_048:r_0e0335789c5396d7": {
      "text": "Desperate at last? What a letdown!",
      "status": "imported"
    },
    "voice_048:r_a8e85bd950696403": {
      "text": "Hey, what's wrong? Is that all?",
      "status": "imported"
    },
    "voice_048:r_772c8bc40ab6cb61": {
      "text": "I don't mind this sort of thing.",
      "status": "imported"
    },
    "voice_048:r_58dd2826a199ef51": {
      "text": "Hmm. That really pissed me off.",
      "status": "imported"
    },
    "voice_048:r_aadc0b2442adb93b": {
      "text": "Not bad for a spineless coward!",
      "status": "imported"
    },
    "voice_048:r_e7a8cd8ed5bc2d1b": {
      "text": "Letdown, Kashim...!\\nIs that all?!",
      "status": "imported"
    },
    "voice_048:r_041dd920da4a7c17": {
      "text": "Let's have flashy fun!\\nKashiiiim!",
      "status": "imported"
    },
    "voice_048:r_c7f4280cde4605b3": {
      "text": "That's it! This is the best, honey!",
      "status": "imported"
    },
    "voice_048:r_ec349c8ea9511a18": {
      "text": "That's my killer saint, Kashim...!",
      "status": "imported"
    },
    "voice_048:r_33236ffa3ea95b68": {
      "text": "You've got some fight,\\nMithril!",
      "status": "imported"
    },
    "voice_048:r_689d0b123de71ae0": {
      "text": "Good, good!\\nWorth crushing now!",
      "status": "imported"
    },
    "voice_048:r_84883aa95f63ce32": {
      "text": "Ho! Not bad at all, young lady!",
      "status": "imported"
    },
    "voice_048:r_25493e978ce8ff16": {
      "text": "Better than expected, Captain!",
      "status": "imported"
    },
    "voice_048:r_7316666150e42960": {
      "text": "This is good!\\nThis is truly super!",
      "status": "imported"
    },
    "voice_048:r_c4f11aa93dc5b668": {
      "text": "Just like a hero!\\nTough on evil!",
      "status": "imported"
    },
    "voice_048:r_ce1a22dfe3a4d339": {
      "text": "Hahaha!\\nLove me to the end, Gundam!",
      "status": "imported"
    },
    "voice_048:r_240651adab81e145": {
      "text": "Ex-Red Shoulder -\\nthe real thing!",
      "status": "imported"
    },
    "voice_048:r_59fca03e929366c1": {
      "text": "Don't get cocky over so little!",
      "status": "imported"
    },
    "voice_048:r_0d65eb631dcb7514": {
      "text": "Haha! Not bad! Oh, yeah!",
      "status": "imported"
    },
    "voice_048:r_d03018a31e23f1e9": {
      "text": "Hehehehe...! Yeah, that's perfect!",
      "status": "imported"
    },
    "voice_048:r_279da5f732aa8847": {
      "text": "Oh, yes...\\nLet's fight to the end!",
      "status": "imported"
    },
    "voice_048:r_97f82e3cb6f70110": {
      "text": "Hahaha! What a delight! What fun!",
      "status": "imported"
    },
    "voice_048:r_c5611d8dd6def96b": {
      "text": "You'll regret sparing me,\\nyou will!",
      "status": "imported"
    },
    "voice_048:r_6f12cc8ed2732eb5": {
      "text": "When I die, you die too...\\nHahaha!",
      "status": "imported"
    },
    "voice_048:r_7abfc55f8fb62ba7": {
      "text": "All right! It's here, here, here!",
      "status": "imported"
    },
    "voice_048:r_99e7a66c650b5892": {
      "text": "That's it!\\nThat's more like you!",
      "status": "imported"
    },
    "voice_048:r_5b2247b5cfbcd7b2": {
      "text": "Hehehehe... Hahahahaha!",
      "status": "imported"
    },
    "voice_048:r_2d7a9c06347582d9": {
      "text": "You got me. I overheated.",
      "status": "imported"
    },
    "voice_048:r_bf953d64c3c7d9b7": {
      "text": "Hehehehe... So glad, Kashim...!",
      "status": "imported"
    },
    "voice_048:r_e09b933e3e706779": {
      "text": "You win this time,\\nKashim!",
      "status": "imported"
    },
    "voice_048:r_66236eb99b676e5b": {
      "text": "I love you, Kashiiiim...!",
      "status": "imported"
    },
    "voice_048:r_9639a2dbcd2f58ed": {
      "text": "Stopping here? How pathetic...",
      "status": "imported"
    },
    "voice_048:r_aeea0893acb93d35": {
      "text": "Ugly face! Quit game? Torn? Lost?",
      "status": "imported"
    },
    "voice_048:r_b31568654e53487b": {
      "text": "Where's your saintly self? Letdown.",
      "status": "imported"
    },
    "voice_048:r_2502132569141ea3": {
      "text": "Conflicted now? I'll remind you...",
      "status": "imported"
    },
    "voice_048:r_1ff312798a52c8eb": {
      "text": "You bet it all on Super Robot Wars!",
