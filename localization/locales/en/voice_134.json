{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_134:r_479b340ccc6c572b": {
      "text": "The timing's right...!",
      "status": "imported"
    },
    "voice_134:r_ca4acbac57a2a35e": {
      "text": "With Genion's power...!",
      "status": "imported"
    },
    "voice_134:r_77949221bf58f862": {
      "text": "I'll pull this off...!",
      "status": "imported"
    },
    "voice_134:r_70b9c4b9f1f37eff": {
      "text": "No time to hesitate...!",
      "status": "imported"
    },
    "voice_134:r_9fcb3754cb1773c7": {
      "text": "I need this power...!",
      "status": "imported"
    },
    "voice_134:r_3559d2fad32c2435": {
      "text": "This power... I'll make it mine!",
      "status": "imported"
    },
    "voice_134:r_f7570547e9f80a64": {
      "text": "I have to protect Sensei...!",
      "status": "imported"
    },
    "voice_134:r_cbab0f4720e1fcf1": {
      "text": "Bear with it a little, Sensei!",
      "status": "imported"
    },
    "voice_134:r_0bbe0b4f5364e732": {
      "text": "Hold on tight, Sensei!",
      "status": "imported"
    },
    "voice_134:r_5dda5198137cb02a": {
      "text": "Y-yes!",
      "status": "imported"
    },
    "voice_134:r_83ec59afbecdec14": {
      "text": "E-enemies, right in front of us!",
      "status": "imported"
    },
    "voice_134:r_e20bfd42ad95a3c9": {
      "text": "I'll end this as fast as I can!",
      "status": "imported"
    },
    "voice_134:r_0f58a8822381e57f": {
      "text": "So this is... a battle...",
      "status": "imported"
    },
    "voice_134:r_6dbcc507fb61b51d": {
      "text": "If you're scared, just say so!",
      "status": "imported"
    },
    "voice_134:r_b42ab697149a7c8a": {
      "text": "Enemy's right there! Here we go!",
      "status": "imported"
    },
    "voice_134:r_4de4fcf3b440baf4": {
      "text": "O-okay!",
      "status": "imported"
    },
    "voice_134:r_0121a166c715cdff": {
      "text": "Next hit takes it down!",
      "status": "imported"
    },
    "voice_134:r_30fad37a42bd3ad3": {
      "text": "I'll make this finish count...!",
      "status": "imported"
    },
    "voice_134:r_80a0b2a84e05d81a": {
      "text": "They'd start a war here?!",
      "status": "imported"
    },
    "voice_134:r_4a9ac1dff86506d9": {
      "text": "Keep your war out of our lives!",
      "status": "imported"
    },
    "voice_134:r_bc8538e6af3d2577": {
      "text": "I don't care who you are!",
      "status": "imported"
    },
    "voice_134:r_924516c8de2b5342": {
      "text": "The city comes first right now!",
      "status": "imported"
    },
    "voice_134:r_da1174533722333f": {
      "text": "So this is a Mechanical Beast!",
      "status": "imported"
    },
    "voice_134:r_fdeb8162976e72c1": {
      "text": "You'll pay for attacking\\nour school!",
      "status": "imported"
    },
    "voice_134:r_0fadb5c26df92b42": {
      "text": "I'll blast right through!",
      "status": "imported"
    },
    "voice_134:r_6b15af9a0057cdc8": {
      "text": "Nitro Pike, fire!",
      "status": "imported"
    },
    "voice_134:r_15b4a90140e8a33a": {
      "text": "Impact Dagger, set!",
      "status": "imported"
    },
    "voice_134:r_af884a6b11dff121": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_134:r_ac6fe7838e95647b": {
      "text": "Same as using a knife!",
      "status": "imported"
    },
    "voice_134:r_77ca87eacd17ad52": {
      "text": "Go!",
      "status": "imported"
    },
    "voice_134:r_bf3244994760e535": {
      "text": "Punisher, set!",
      "status": "imported"
    },
    "voice_134:r_aabfb21c9d069ce7": {
      "text": "Shoot!",
      "status": "imported"
    },
    "voice_134:r_02479dc8fe989560": {
      "text": "This one... finishes it!",
      "status": "imported"
    },
    "voice_134:r_a2df00f91a9b0a9e": {
      "text": "TS-DEMON, activate!",
      "status": "imported"
    },
    "voice_134:r_8927e6fb681aa809": {
      "text": "This one ends it!",
      "status": "imported"
    },
    "voice_134:r_665f01666859013b": {
      "text": "Glaive, set!",
      "status": "imported"
    },
    "voice_134:r_ddbe581c5ea9183d": {
      "text": "Going all out!",
      "status": "imported"
    },
    "voice_134:r_faae935cca0edc72": {
      "text": "TS-DEMON, blade on!",
      "status": "imported"
    },
    "voice_134:r_6ff1323b355593e0": {
      "text": "Full throttle, go!",
      "status": "imported"
    },
    "voice_134:r_47d52a2839c71715": {
      "text": "This time it's my turn!",
      "status": "imported"
    },
    "voice_134:r_847f82e7f3eef651": {
      "text": "You're not getting away!",
      "status": "imported"
    },
    "voice_134:r_eb7ae28b53dc033c": {
      "text": "You hit me, I hit back!",
      "status": "imported"
    },
    "voice_134:r_857c4a52ce8df0fd": {
      "text": "If you're still in range...!",
      "status": "imported"
    },
    "voice_134:r_55417493fce1d347": {
      "text": "Don't take me for a scarecrow!",
      "status": "imported"
    },
    "voice_134:r_8fdf5910927c9591": {
      "text": "I'm not nice enough to let it go!",
      "status": "imported"
    },
    "voice_134:r_7d724dbcc4451e10": {
      "text": "I'll back you up!",
      "status": "imported"
    },
    "voice_134:r_93e25418a203cb8f": {
      "text": "An opening...! That's my chance!",
      "status": "imported"
    },
    "voice_134:r_adeb0a29274d3d9b": {
      "text": "I can take a hit like that!",
      "status": "imported"
    },
    "voice_134:r_24cf161287ef9d5c": {
      "text": "I can at least be your shield!",
      "status": "imported"
    },
    "voice_134:r_8f60f6fc86db3107": {
      "text": "I can't counter...?!",
      "status": "imported"
    },
    "voice_134:r_b1de76a75a253c13": {
      "text": "Am I out of position...?!",
      "status": "imported"
    },
    "voice_134:r_128c35bf3e0e394c": {
      "text": "Damn it! What am I even doing?!",
      "status": "imported"
    },
    "voice_134:r_5213c17e13b23de0": {
      "text": "Yes...! I dodged it!",
      "status": "imported"
    },
    "voice_134:r_38fdff9483e9245c": {
      "text": "This much I can handle...!",
      "status": "imported"
    },
    "voice_134:r_620fedec67706d7d": {
      "text": "I can't afford to die here!",
      "status": "imported"
    },
    "voice_134:r_9680dcd0fddcfcc7": {
      "text": "I can feel the bloodlust...!",
      "status": "imported"
    },
    "voice_134:r_2a00f1044ad5cbaa": {
      "text": "Sharpen every nerve...!",
      "status": "imported"
    },
    "voice_134:r_3dbeead1bd3164ef": {
      "text": "Genion's reflexes saved me...",
      "status": "imported"
    },
    "voice_134:r_98d15b8cc09bc915": {
      "text": "Kyaaah!",
      "status": "imported"
    },
    "voice_134:r_46e86d000250e137": {
      "text": "It's fine, Sensei!\\nIt didn't hit us!",
      "status": "imported"
    },
    "voice_134:r_ac341e7976e88f0b": {
      "text": "Th-they're shooting at us!",
      "status": "imported"
    },
    "voice_134:r_cdbd128a5b4127cc": {
      "text": "They're serious, Sensei!",
      "status": "imported"
    },
    "voice_134:r_cfccaa1fbeda124c": {
      "text": "Kyaaah!",
      "status": "imported"
    },
    "voice_134:r_b1f8ec192b9c083a": {
      "text": "Please stop screaming every time!",
      "status": "imported"
    },
    "voice_134:r_ddafde4b065ced49": {
      "text": "We've got D-Fault!",
      "status": "imported"
    },
    "voice_134:r_de1213040856c089": {
      "text": "Let the field catch it...!",
      "status": "imported"
    },
    "voice_134:r_3304412ac41f47a6": {
      "text": "It got me!",
      "status": "imported"
    },
    "voice_134:r_0c0775e051211840": {
      "text": "It's just a scratch...!",
      "status": "imported"
    },
    "voice_134:r_a2afffe1c396f0b3": {
      "text": "Ngh...! The whole frame's shaking!",
      "status": "imported"
    },
    "voice_134:r_13c25fbdfddc8a24": {
      "text": "What did I do wrong?!\\nRange? Timing?!",
      "status": "imported"
    },
    "voice_134:r_42ba1ecb310b4bd7": {
      "text": "I can react, but I can't keep up!",
      "status": "imported"
    },
    "voice_134:r_d692f1d420460a47": {
      "text": "I need more movement\\npatterns...!",
      "status": "imported"
    },
    "voice_134:r_a5643cec86b18bd2": {
      "text": "W-we're hit!",
      "status": "imported"
    },
    "voice_134:r_68f2dfab20a4a30e": {
      "text": "That much is just a graze!",
      "status": "imported"
    },
    "voice_134:r_9cedad8237480563": {
      "text": "Ah... aah...",
      "status": "imported"
    },
    "voice_134:r_a03fabecba1508ca": {
      "text": "Damn! I can't risk Sensei's life!",
      "status": "imported"
    },
    "voice_134:r_5391b24a71eb10ae": {
      "text": "Agh!",
      "status": "imported"
    },
    "voice_134:r_a554ceef5c87b972": {
      "text": "That doesn't even count as damage!",
      "status": "imported"
    },
    "voice_134:r_546c3d5937fbb7ee": {
      "text": "Gah...! This is a real battlefield!",
      "status": "imported"
    },
    "voice_134:r_1568ff6298b12b96": {
      "text": "I can still move...! I can fight!",
      "status": "imported"
    },
    "voice_134:r_2c9d94ba13c5fc50": {
      "text": "You call this pain?!",
      "status": "imported"
    },
    "voice_134:r_a77f4913375098d2": {
      "text": "Move faster, Genion!",
      "status": "imported"
    },
    "voice_134:r_428c2116ac3071b1": {
      "text": "There's no going back now...!",
      "status": "imported"
    },
    "voice_134:r_84c116267b79f540": {
      "text": "Lose your nerve here and you die!",
      "status": "imported"
    },
    "voice_134:r_dad38ee29af2df3a": {
      "text": "Let me out! I've had enough!",
      "status": "imported"
    },
    "voice_134:r_3d32e86f8dc80909": {
      "text": "Please calm down, Sensei!",
      "status": "imported"
    },
    "voice_134:r_70451ffbabe2f876": {
      "text": "Ngh! Sensei will get killed too...!",
      "status": "imported"
    },
    "voice_134:r_69dfa1659715e2fa": {
      "text": "N-no way...! Tell me we're okay!",
      "status": "imported"
    },
    "voice_134:r_d996fd6d4ef5b329": {
      "text": "A-are we going to be okay?!",
      "status": "imported"
    },
    "voice_134:r_8ab47a28f99ef565": {
      "text": "I don't know!\\nBut we've got no choice!",
      "status": "imported"
    },
    "voice_134:r_546de3fb6db156ea": {
      "text": "No good! I can't dodge it!",
      "status": "imported"
    },
    "voice_134:r_ca85f87cee5e31f7": {
      "text": "No good?! Not with me...!",
      "status": "imported"
    },
    "voice_134:r_9072ea7bc71df136": {
      "text": "Am I not drawing out its power...?!",
      "status": "imported"
    },
    "voice_134:r_04e815a8d425827d": {
      "text": "Like hell I'll die here!",
      "status": "imported"
    },
    "voice_134:r_d89011fe3e5d082a": {
      "text": "Dad... Sis...! I...",
      "status": "imported"
    },
    "voice_134:r_3c5b0c2ac812d5de": {
      "text": "No...! I can't die yet...!",
      "status": "imported"
    },
    "voice_134:r_5b9e8897190892eb": {
      "text": "Kyaaaaah!",
      "status": "imported"
    },
    "voice_134:r_7bea3023abbf8a94": {
      "text": "Can't I protect anyone...?!",
      "status": "imported"
    },
    "voice_134:r_dd01a4c0d1b36a8d": {
      "text": "L-let's get out of here, fast!",
      "status": "imported"
    },
    "voice_134:r_20920ad2eb3542db": {
      "text": "Turn our backs now and we're shot!",
      "status": "imported"
    },
    "voice_134:r_0ab7914877fd48ed": {
      "text": "I-it's hopeless! Just run!",
      "status": "imported"
    },
    "voice_134:r_cb846feec748c2e3": {
      "text": "Out here, whoever quits dies first!",
      "status": "imported"
    },
    "voice_134:r_c958860b0676b1f5": {
      "text": "Damn it! Damn iiiit!!",
      "status": "imported"
    },
    "voice_134:r_5e2669b82ef75ce3": {
      "text": "Is this as far as I go...?!",
      "status": "imported"
    },
    "voice_134:r_7847e0ed7dc9282d": {
      "text": "Kyaaaaaaaah!!",
      "status": "imported"
    },
    "voice_134:r_e42b52c7a987b906": {
      "text": "Senseiii!!",
      "status": "imported"
    },
    "voice_134:r_6825fd1ff907bd22": {
      "text": "Genion's output is climbing...?!",
      "status": "imported"
    },
    "voice_134:r_607f666f1563bc0d": {
      "text": "With this... I can do it!",
      "status": "imported"
    },
    "voice_134:r_97b7431eeb81e6b6": {
      "text": "Raaaaaagh!!",
      "status": "imported"
    },
    "voice_134:r_132f605d02975e71": {
      "text": "This is the finishing blow!!",
      "status": "imported"
    },
    "voice_134:r_9b9726b1872759d6": {
      "text": "So this is Genion's true power...",
      "status": "imported"
    },
    "voice_134:r_1252db29683fefe0": {
      "text": "Huh...?! Whaaat?!",
      "status": "imported"
    },
    "voice_134:r_ad3d538f1e909184": {
      "text": "Lend me your power!",
      "status": "imported"
    },
    "voice_134:r_8c61c59a1c0aebbf": {
      "text": "Come on, Genion!",
      "status": "imported"
    },
    "voice_134:r_aba6a7662129d8ce": {
      "text": "Like hell I'm dying heeere!!",
      "status": "imported"
    },
    "voice_134:r_b84afafb8a33ec60": {
      "text": "So I'm the distraction...!",
      "status": "imported"
    },
    "voice_134:r_c8c59db85bf875e6": {
      "text": "Pull all their fire onto me!",
      "status": "imported"
    },
    "voice_134:r_391aa56435d9dd6e": {
      "text": "Stop them early. Hunting basics!",
      "status": "imported"
    },
    "voice_134:r_7c796ba53bd7ea03": {
      "text": "So that one's mine...!",
      "status": "imported"
    },
    "voice_134:r_fa944da4b6519006": {
      "text": "They trusted me, so I'll deliver!",
      "status": "imported"
    },
    "voice_134:r_95d047bcc17fccc6": {
      "text": "One on one...! Nowhere to run!",
      "status": "imported"
    },
    "voice_134:r_fc25e66a86fc2c85": {
      "text": "Output, maximum!",
      "status": "imported"
    },
    "voice_134:r_b765659981b6516d": {
      "text": "No half measures...!",
      "status": "imported"
    },
    "voice_134:r_0c427458bc00eb95": {
      "text": "Raaaaaagh!!",
      "status": "imported"
    },
    "voice_134:r_774a9ab4d8fd5351": {
      "text": "I'm ending this now!!",
      "status": "imported"
    },
    "voice_134:r_d3f01de714c015bd": {
      "text": "With this power, I can beat anyone!",
      "status": "imported"
    }
  }
}
