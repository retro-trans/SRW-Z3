{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_039:r_479b340ccc6c572b": {
      "text": "This is as far as you go!",
      "status": "imported"
    },
    "voice_039:r_ca4acbac57a2a35e": {
      "text": "I won't let you escape!",
      "status": "imported"
    },
    "voice_039:r_77949221bf58f862": {
      "text": "For my... for our mission...!",
      "status": "imported"
    },
    "voice_039:r_70b9c4b9f1f37eff": {
      "text": "I'll fight for the future too...!",
      "status": "imported"
    },
    "voice_039:r_9fcb3754cb1773c7": {
      "text": "R-Daigan, let's go!",
      "status": "imported"
    },
    "voice_039:r_3559d2fad32c2435": {
      "text": "R-Daigan's speed - one more blow!",
      "status": "imported"
    },
    "voice_039:r_f7570547e9f80a64": {
      "text": "You won't have your way with Earth!",
      "status": "imported"
    },
    "voice_039:r_cbab0f4720e1fcf1": {
      "text": "On this Earth,\\nyou have no place!",
      "status": "imported"
    },
    "voice_039:r_4de4fcf3b440baf4": {
      "text": "Stinger!",
      "status": "imported"
    },
    "voice_039:r_0121a166c715cdff": {
      "text": "There! Stinger!",
      "status": "imported"
    },
    "voice_039:r_30fad37a42bd3ad3": {
      "text": "One stroke, clean cut! Blade Twin!",
      "status": "imported"
    },
    "voice_039:r_80a0b2a84e05d81a": {
      "text": "Blade! Twin!",
      "status": "imported"
    },
    "voice_039:r_4a9ac1dff86506d9": {
      "text": "Every attack leaves an opening!",
      "status": "imported"
    },
    "voice_039:r_bc8538e6af3d2577": {
      "text": "I'll counterattack at once!",
      "status": "imported"
    },
    "voice_039:r_924516c8de2b5342": {
      "text": "Allow me to return the favor!",
      "status": "imported"
    },
    "voice_039:r_da1174533722333f": {
      "text": "R-Daigan is still going strong!",
      "status": "imported"
    },
    "voice_039:r_fdeb8162976e72c1": {
      "text": "I'll fight alongside you too!",
      "status": "imported"
    },
    "voice_039:r_0fadb5c26df92b42": {
      "text": "R-Daigan's up next!",
      "status": "imported"
    },
    "voice_039:r_6b15af9a0057cdc8": {
      "text": "Please don't push yourself!",
      "status": "imported"
    },
    "voice_039:r_15b4a90140e8a33a": {
      "text": "I'll protect my friends!",
      "status": "imported"
    },
    "voice_039:r_af884a6b11dff121": {
      "text": "For now, we can only endure...!",
      "status": "imported"
    },
    "voice_039:r_ac6fe7838e95647b": {
      "text": "No...!\\nI can't counter like this!",
      "status": "imported"
    },
    "voice_039:r_77ca87eacd17ad52": {
      "text": "Generator\\nwon't charge in time...!",
      "status": "imported"
    },
    "voice_039:r_bf3244994760e535": {
      "text": "No...!\\nNo weapons can fire back...!",
      "status": "imported"
    },
    "voice_039:r_aabfb21c9d069ce7": {
      "text": "I knew what you were aiming for...!",
      "status": "imported"
    },
    "voice_039:r_02479dc8fe989560": {
      "text": "I don't plan on getting hit...!",
      "status": "imported"
    },
    "voice_039:r_a2df00f91a9b0a9e": {
      "text": "Our speed is in a different league!",
      "status": "imported"
    },
    "voice_039:r_48b60d6c48b9b142": {
      "text": "You can't catch R-Daigan!",
      "status": "imported"
    },
    "voice_039:r_8927e6fb681aa809": {
      "text": "Th-The barrier saved me...!",
      "status": "imported"
    },
    "voice_039:r_665f01666859013b": {
      "text": "R-Daigan...! Thank you!",
      "status": "imported"
    },
    "voice_039:r_ddbe581c5ea9183d": {
      "text": "That won't take me down...!",
      "status": "imported"
    },
    "voice_039:r_faae935cca0edc72": {
      "text": "That won't work on R-Daigan!",
      "status": "imported"
    },
    "voice_039:r_d4430bf362340b32": {
      "text": "I relied too much on speed...!?",
      "status": "imported"
    },
    "voice_039:r_6ff1323b355593e0": {
      "text": "I'll dodge it next time for sure!",
      "status": "imported"
    },
    "voice_039:r_b7b5625d7cd4282f": {
      "text": "Ngh...! You're pretty good...!",
      "status": "imported"
    },
    "voice_039:r_36133ad73a73ef98": {
      "text": "I'll endure this wound by willpower!",
      "status": "imported"
    },
    "voice_039:r_920740a0219c5085": {
      "text": "I'm all right...! I can still fight!",
      "status": "imported"
    },
    "voice_039:r_a8451712c57c1a72": {
      "text": "I too defend Earth!\\nI won't lose!",
      "status": "imported"
    },
    "voice_039:r_3633df5b7b8f47fa": {
      "text": "Aaaah!",
      "status": "imported"
    },
    "voice_039:r_52dfc56b14b93551": {
      "text": "Though hurt,\\nI have cause to stand!",
      "status": "imported"
    },
    "voice_039:r_1b9b2aab5cb104da": {
      "text": "R-Daigan...\\nMy wings remain whole!",
      "status": "imported"
    },
    "voice_039:r_342044c706a2340f": {
      "text": "R-Daigan, please!\\nA bit more power!",
      "status": "imported"
    },
    "voice_039:r_cf41e8828a90cbdb": {
      "text": "Farewell... Adieu, I suppose...",
      "status": "imported"
    },
    "voice_039:r_719e897304ec42d4": {
      "text": "Enemy acquired!",
      "status": "imported"
    },
    "voice_039:r_d5e0a2317c40d322": {
      "text": "I won't hold back!",
      "status": "imported"
    },
    "voice_039:r_5d08ad19e2da125b": {
      "text": "I won't take this lying down...!",
      "status": "imported"
    },
    "voice_039:r_a7246b52782a877e": {
      "text": "I won't just sit here and take it!",
      "status": "imported"
    },
    "voice_039:r_dc8701f6bcb9904f": {
      "text": "Fuse R-Daigan\\nwith Dancouga Nova!",
      "status": "imported"
    },
    "voice_039:r_d6bdd730f24f66eb": {
      "text": "Leave the rest to me, Aoi!",
      "status": "imported"
    },
    "voice_039:r_41997412868c48c4": {
      "text": "I...\\nI want to help Johnny...!",
      "status": "imported"
    },
    "voice_039:r_9e6cf4f389dae55c": {
      "text": "If you let up, I'll strike again!",
      "status": "imported"
    },
    "voice_039:r_9e0c80ac7e33b459": {
      "text": "I'm sorry... R-Daigan...!",
      "status": "imported"
    },
    "voice_039:r_7432ef43ed3471dc": {
      "text": "Ahh...! Johnny...!",
      "status": "imported"
    },
    "voice_039:r_065443f6ddfcf0d7": {
      "text": "S-So strong...!\\nMy fiercest foe...!",
      "status": "imported"
    },
    "voice_039:r_47d52a2839c71715": {
      "text": "I won't lose...!\\nI'm here to win!",
      "status": "imported"
    },
    "voice_039:r_847f82e7f3eef651": {
      "text": "You're stronger than I expected...!",
      "status": "imported"
    },
    "voice_039:r_eb7ae28b53dc033c": {
      "text": "Fight on, R-Daigan!\\nI'll fight on!",
      "status": "imported"
    },
    "voice_039:r_857c4a52ce8df0fd": {
      "text": "That attack won't work on me now!",
      "status": "imported"
    },
    "voice_039:r_55417493fce1d347": {
      "text": "Aah...! You hit me...!?",
      "status": "imported"
    },
    "voice_039:r_8fdf5910927c9591": {
      "text": "You're too slow!",
      "status": "imported"
    },
    "voice_039:r_7d724dbcc4451e10": {
      "text": "This is R-Daigan!",
      "status": "imported"
    },
    "voice_039:r_93e25418a203cb8f": {
      "text": "Dancouga Nova is\\nour future's hope!",
      "status": "imported"
    },
    "voice_039:r_adeb0a29274d3d9b": {
      "text": "Fall back for now, Aoi",
      "status": "imported"
    },
    "voice_039:r_24cf161287ef9d5c": {
      "text": "Please, R-Daigan!\\nProtect Johnny!",
      "status": "imported"
    }
  }
}
