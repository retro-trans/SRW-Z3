{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_016:r_479b340ccc6c572b": {
      "text": "Like this?! Or maybe this?!",
      "status": "imported"
    },
    "voice_016:r_ca4acbac57a2a35e": {
      "text": "I-if fighting's the only way...!",
      "status": "imported"
    },
    "voice_016:r_77949221bf58f862": {
      "text": "I've got to...!\\nTo protect Mikono!",
      "status": "imported"
    },
    "voice_016:r_70b9c4b9f1f37eff": {
      "text": "What do I do...?\\nWhat do I do?!",
      "status": "imported"
    },
    "voice_016:r_9fcb3754cb1773c7": {
      "text": "Mikono...! I'll protect you!",
      "status": "imported"
    },
    "voice_016:r_3559d2fad32c2435": {
      "text": "Now I've got no choice but to fight!",
      "status": "imported"
    },
    "voice_016:r_f7570547e9f80a64": {
      "text": "You! Get away from Mikono!",
      "status": "imported"
    },
    "voice_016:r_cbab0f4720e1fcf1": {
      "text": "B-but! Not in a situation like this!",
      "status": "imported"
    },
    "voice_016:r_0bbe0b4f5364e732": {
      "text": "Amateurs, stay out of this!",
      "status": "imported"
    },
    "voice_016:r_5dda5198137cb02a": {
      "text": "That's easy for you to say...!",
      "status": "imported"
    },
    "voice_016:r_83ec59afbecdec14": {
      "text": "Hey, you! What the heck are you?!",
      "status": "imported"
    },
    "voice_016:r_e20bfd42ad95a3c9": {
      "text": "I don't know either!",
      "status": "imported"
    },
    "voice_016:r_0f58a8822381e57f": {
      "text": "If I can manage one more...!",
      "status": "imported"
    },
    "voice_016:r_6dbcc507fb61b51d": {
      "text": "W-what the heck is this thing?!",
      "status": "imported"
    },
    "voice_016:r_b42ab697149a7c8a": {
      "text": "This thing...! It's a wild beast!",
      "status": "imported"
    },
    "voice_016:r_4de4fcf3b440baf4": {
      "text": "If this thing's their leader...!",
      "status": "imported"
    },
    "voice_016:r_0121a166c715cdff": {
      "text": "Are they... abducting women?!",
      "status": "imported"
    },
    "voice_016:r_30fad37a42bd3ad3": {
      "text": "I never thought I'd fight Abductors!",
      "status": "imported"
    },
    "voice_016:r_80a0b2a84e05d81a": {
      "text": "Hit! Come on, hit!!",
      "status": "imported"
    },
    "voice_016:r_4a9ac1dff86506d9": {
      "text": "Right there!",
      "status": "imported"
    },
    "voice_016:r_bc8538e6af3d2577": {
      "text": "Just do it!",
      "status": "imported"
    },
    "voice_016:r_924516c8de2b5342": {
      "text": "If I throw my whole body at it...!",
      "status": "imported"
    },
    "voice_016:r_da1174533722333f": {
      "text": "Rraaagh!",
      "status": "imported"
    },
    "voice_016:r_fdeb8162976e72c1": {
      "text": "Rraaagh! Mikono!",
      "status": "imported"
    },
    "voice_016:r_0fadb5c26df92b42": {
      "text": "Rraaaaagh!!",
      "status": "imported"
    },
    "voice_016:r_6b15af9a0057cdc8": {
      "text": "Rraaaaaaaaaagh!!",
      "status": "imported"
    },
    "voice_016:r_36133ad73a73ef98": {
      "text": "I-I can't just keep taking this!",
      "status": "imported"
    },
    "voice_016:r_920740a0219c5085": {
      "text": "I'll counterattack!",
      "status": "imported"
    },
    "voice_016:r_a8451712c57c1a72": {
      "text": "N-now it's our turn to attack!",
      "status": "imported"
    },
    "voice_016:r_3633df5b7b8f47fa": {
      "text": "I can still fight!",
      "status": "imported"
    },
    "voice_016:r_52dfc56b14b93551": {
      "text": "I have to protect Mikono...!",
      "status": "imported"
    },
    "voice_016:r_1b9b2aab5cb104da": {
      "text": "If I don't fight, they'll get me!",
      "status": "imported"
    },
    "voice_016:r_342044c706a2340f": {
      "text": "Huh?! I can't counterattack?!",
      "status": "imported"
    },
    "voice_016:r_cf41e8828a90cbdb": {
      "text": "No...!\\nThen I can only wait to die!",
      "status": "imported"
    },
    "voice_016:r_719e897304ec42d4": {
      "text": "I'll cover you from here!",
      "status": "imported"
    },
    "voice_016:r_d5e0a2317c40d322": {
      "text": "Leave the support to me!",
      "status": "imported"
    },
    "voice_016:r_ec2ea17765052401": {
      "text": "I can at least be your shield...!",
      "status": "imported"
    },
    "voice_016:r_f2d4255f1c2f7542": {
      "text": "G-get back while you can!",
      "status": "imported"
    },
    "voice_016:r_5d08ad19e2da125b": {
      "text": "Phew... I managed to dodge it...",
      "status": "imported"
    },
    "voice_016:r_a7246b52782a877e": {
      "text": "Who cares how it looks! Just run!",
      "status": "imported"
    },
    "voice_016:r_dc8701f6bcb9904f": {
      "text": "G-good! If we can just get away...!",
      "status": "imported"
    },
    "voice_016:r_d6bdd730f24f66eb": {
      "text": "I won't let them scratch Mikono!",
      "status": "imported"
    },
    "voice_016:r_41997412868c48c4": {
      "text": "A-Amata!",
      "status": "imported"
    },
    "voice_016:r_9e6cf4f389dae55c": {
      "text": "It's okay! I promise to protect you!",
      "status": "imported"
    },
    "voice_016:r_9e0c80ac7e33b459": {
      "text": "Stay sharp! Another one's coming!",
      "status": "imported"
    },
    "voice_016:r_7432ef43ed3471dc": {
      "text": "Y-yes!",
      "status": "imported"
    },
    "voice_016:r_065443f6ddfcf0d7": {
      "text": "Nice! You're pretty good!",
      "status": "imported"
    },
    "voice_016:r_47d52a2839c71715": {
      "text": "I-it was just luck...!",
      "status": "imported"
    },
    "voice_016:r_847f82e7f3eef651": {
      "text": "Y-you saved me...",
      "status": "imported"
    },
    "voice_016:r_857c4a52ce8df0fd": {
      "text": "I-I'm okay! It only grazed me!",
      "status": "imported"
    },
    "voice_016:r_55417493fce1d347": {
      "text": "Whoa! I-it hit!",
      "status": "imported"
    },
    "voice_016:r_8fdf5910927c9591": {
      "text": "Even light hits\\nwill add up...!",
      "status": "imported"
    },
    "voice_016:r_7d724dbcc4451e10": {
      "text": "Wow! You survived that attack!",
      "status": "imported"
    },
    "voice_016:r_93e25418a203cb8f": {
      "text": "Aagh!",
      "status": "imported"
    },
    "voice_016:r_adeb0a29274d3d9b": {
      "text": "I'm fine, Mikono!\\nIt just grazed me!",
      "status": "imported"
    },
    "voice_016:r_24cf161287ef9d5c": {
      "text": "W-whoa!",
      "status": "imported"
    },
    "voice_016:r_8f60f6fc86db3107": {
      "text": "Don't whine!\\nIt's just a scratch!",
      "status": "imported"
    },
    "voice_016:r_b1de76a75a253c13": {
      "text": "Hey, you!\\nYou could've dodged that!",
      "status": "imported"
    },
    "voice_016:r_128c35bf3e0e394c": {
      "text": "S-sorry!",
      "status": "imported"
    },
    "voice_016:r_5213c17e13b23de0": {
      "text": "No! At this rate, they'll get us!",
      "status": "imported"
    },
    "voice_016:r_38fdff9483e9245c": {
      "text": "I-I knew I wasn't good enough!",
      "status": "imported"
    },
    "voice_016:r_620fedec67706d7d": {
      "text": "I-I won't lose hope till the end...!",
      "status": "imported"
    },
    "voice_016:r_9680dcd0fddcfcc7": {
      "text": "Gah! What a powerful impact!",
      "status": "imported"
    },
    "voice_016:r_2a00f1044ad5cbaa": {
      "text": "Protect!\\nI must protect Mikono!",
      "status": "imported"
    },
    "voice_016:r_3dbeead1bd3164ef": {
      "text": "Amata...",
      "status": "imported"
    },
    "voice_016:r_98d15b8cc09bc915": {
      "text": "A-at this rate...!",
      "status": "imported"
    },
    "voice_016:r_46e86d000250e137": {
      "text": "Quit whining and move! Wanna die?!",
      "status": "imported"
    },
    "voice_016:r_ac341e7976e88f0b": {
      "text": "What are you doing?! Focus harder!",
      "status": "imported"
    },
    "voice_016:r_cdbd128a5b4127cc": {
      "text": "I-I'm giving it everything I've got!",
      "status": "imported"
    },
    "voice_016:r_cfccaa1fbeda124c": {
      "text": "I-if we take another hit...!",
      "status": "imported"
    },
    "voice_016:r_b1f8ec192b9c083a": {
      "text": "W-we can't hold out any longer...!",
      "status": "imported"
    },
    "voice_016:r_a007f9ab9cf048b3": {
      "text": "No...!\\nIs my life ending here...?!",
      "status": "imported"
    },
    "voice_016:r_ddafde4b065ced49": {
      "text": "Sorry, Mikono!\\nBut I'll protect you!",
      "status": "imported"
    },
    "voice_016:r_de1213040856c089": {
      "text": "Aaaagh!!",
      "status": "imported"
    },
    "voice_016:r_3304412ac41f47a6": {
      "text": "Guard!\\nGuard Mikono with my life!",
      "status": "imported"
    },
    "voice_016:r_0c0775e051211840": {
      "text": "N-no! I can't take any more...!",
      "status": "imported"
    },
    "voice_016:r_a2afffe1c396f0b3": {
      "text": "Damn!\\nDoes despair alone await us?!",
      "status": "imported"
    },
    "voice_016:r_13c25fbdfddc8a24": {
      "text": "Coed union at last,\\nand this is it?!",
      "status": "imported"
    },
    "voice_016:r_42ba1ecb310b4bd7": {
      "text": "I-I must try, or that girl too...!",
      "status": "imported"
    },
    "voice_016:r_d692f1d420460a47": {
      "text": "Whoa! M-Mikonooo!!",
      "status": "imported"
    },
    "voice_016:r_a5643cec86b18bd2": {
      "text": "Aaaaaagh!!",
      "status": "imported"
    },
    "voice_016:r_68f2dfab20a4a30e": {
      "text": "Sorry, Mikono... I'm so sorry...",
      "status": "imported"
    },
    "voice_016:r_546c3d5937fbb7ee": {
      "text": "I'll hold them off!",
      "status": "imported"
    },
    "voice_016:r_1568ff6298b12b96": {
      "text": "I'll handle things over here!",
      "status": "imported"
    }
  }
}
