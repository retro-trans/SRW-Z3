{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_090:r_ca4acbac57a2a35e": {
      "text": "Well then, what should I do?",
      "status": "imported"
    },
    "voice_090:r_77949221bf58f862": {
      "text": "The soul's melody... Movement I.",
      "status": "imported"
    },
    "voice_090:r_70b9c4b9f1f37eff": {
      "text": "Care to hear the melody I play?",
      "status": "imported"
    },
    "voice_090:r_9fcb3754cb1773c7": {
      "text": "I can play some fine music today.",
      "status": "imported"
    },
    "voice_090:r_3559d2fad32c2435": {
      "text": "Now, let us play the sound of life.",
      "status": "imported"
    },
    "voice_090:r_f7570547e9f80a64": {
      "text": "Let us begin. The soul's arpeggio.",
      "status": "imported"
    },
    "voice_090:r_cbab0f4720e1fcf1": {
      "text": "Hold together, my life...!",
      "status": "imported"
    },
    "voice_090:r_0bbe0b4f5364e732": {
      "text": "Pluck fate's string,\\nbinding us...!",
      "status": "imported"
    },
    "voice_090:r_5dda5198137cb02a": {
      "text": "My soul yearns for beauty in sound.",
      "status": "imported"
    },
    "voice_090:r_83ec59afbecdec14": {
      "text": "Is it time to offer up my life...!",
      "status": "imported"
    },
    "voice_090:r_e20bfd42ad95a3c9": {
      "text": "Ultimate melody... Almost there...",
      "status": "imported"
    },
    "voice_090:r_0f58a8822381e57f": {
      "text": "More than life,\\nI seek something...!",
      "status": "imported"
    },
    "voice_090:r_6dbcc507fb61b51d": {
      "text": "Three souls\\nplay a new harmony...!",
      "status": "imported"
    },
    "voice_090:r_b42ab697149a7c8a": {
      "text": "Now we can\\nplay a fine trio.",
      "status": "imported"
    },
    "voice_090:r_4de4fcf3b440baf4": {
      "text": "Shrade! Take my strength too!",
      "status": "imported"
    },
    "voice_090:r_0121a166c715cdff": {
      "text": "Animato... My soul takes wing!",
      "status": "imported"
    },
    "voice_090:r_30fad37a42bd3ad3": {
      "text": "Amata, lend me your strength too.",
      "status": "imported"
    },
    "voice_090:r_80a0b2a84e05d81a": {
      "text": "Yeah! Let's go, Shrade!",
      "status": "imported"
    },
    "voice_090:r_4a9ac1dff86506d9": {
      "text": "Shrade, the enemy's coming!",
      "status": "imported"
    },
    "voice_090:r_bc8538e6af3d2577": {
      "text": "My best friend's sister... Lovely.",
      "status": "imported"
    },
    "voice_090:r_924516c8de2b5342": {
      "text": "Don't overdo it, Shrade!",
      "status": "imported"
    },
    "voice_090:r_da1174533722333f": {
      "text": "My friend's here.\\nNo shoddy playing.",
      "status": "imported"
    },
    "voice_090:r_fdeb8162976e72c1": {
      "text": "Come, friend... Let our souls sing!",
      "status": "imported"
    },
    "voice_090:r_0fadb5c26df92b42": {
      "text": "Enough talk! Hurry up and attack!",
      "status": "imported"
    },
    "voice_090:r_6b15af9a0057cdc8": {
      "text": "I feel it...!\\nOur souls are one...!",
      "status": "imported"
    },
    "voice_090:r_15b4a90140e8a33a": {
      "text": "Yes. This is the ultimate melody.",
      "status": "imported"
    },
    "voice_090:r_af884a6b11dff121": {
      "text": "Let's see what you can do, Shrade!",
      "status": "imported"
    },
    "voice_090:r_ac6fe7838e95647b": {
      "text": "Then let me play a song for you.",
      "status": "imported"
    },
    "voice_090:r_77ca87eacd17ad52": {
      "text": "Shrade! I'll cover you too!",
      "status": "imported"
    },
    "voice_090:r_bf3244994760e535": {
      "text": "Good to have you, Malloy.",
      "status": "imported"
    },
    "voice_090:r_aabfb21c9d069ce7": {
      "text": "Your feroce\\nwill add a fine accent.",
      "status": "imported"
    },
    "voice_090:r_02479dc8fe989560": {
      "text": "Enough chatter! Just attack already!",
      "status": "imported"
    },
    "voice_090:r_a2df00f91a9b0a9e": {
      "text": "Enemy dead ahead! You can do it!",
      "status": "imported"
    },
    "voice_090:r_48b60d6c48b9b142": {
      "text": "With you,\\nharmony can cross worlds.",
      "status": "imported"
    },
    "voice_090:r_8927e6fb681aa809": {
      "text": "Da capo. I'll attack once more.",
      "status": "imported"
    },
    "voice_090:r_665f01666859013b": {
      "text": "Let's answer their encore.",
      "status": "imported"
    },
    "voice_090:r_a571eec59b258d11": {
      "text": "You'll make a beautiful sound.",
      "status": "imported"
    },
    "voice_090:r_ddbe581c5ea9183d": {
      "text": "I'll tune your dissonance.",
      "status": "imported"
    },
    "voice_090:r_faae935cca0edc72": {
      "text": "Your deeds are utterly tasteless.",
      "status": "imported"
    },
    "voice_090:r_d4430bf362340b32": {
      "text": "Otherworldly intruder... Begone.",
      "status": "imported"
    },
    "voice_090:r_6ff1323b355593e0": {
      "text": "Baton stops,\\nthe music must end.",
      "status": "imported"
    },
    "voice_090:r_b7b5625d7cd4282f": {
      "text": "Despair rules you, as it did me.",
      "status": "imported"
    },
    "voice_090:r_36133ad73a73ef98": {
      "text": "We won't bow to your death song...!",
      "status": "imported"
    },
    "voice_090:r_920740a0219c5085": {
      "text": "Well, Amata...\\nlet me hear you play.",
      "status": "imported"
    },
    "voice_090:r_a8451712c57c1a72": {
      "text": "Spada and EVOL,\\nsounds layered.",
      "status": "imported"
    },
    "voice_090:r_3633df5b7b8f47fa": {
      "text": "Two Aquarions...\\nWhat will emerge?",
      "status": "imported"
    },
    "voice_090:r_52dfc56b14b93551": {
      "text": "Gepard, Spada...\\nFine music awaits.",
      "status": "imported"
    },
    "voice_090:r_1b9b2aab5cb104da": {
      "text": "Spada's sound...\\nWhere does it lead?",
      "status": "imported"
    },
    "voice_090:r_342044c706a2340f": {
      "text": "Prestissimo... Fine moves indeed.",
      "status": "imported"
    },
    "voice_090:r_cf41e8828a90cbdb": {
      "text": "Gundam... What music will it play?",
      "status": "imported"
    },
    "voice_090:r_719e897304ec42d4": {
      "text": "I can feel your emotions surging...",
      "status": "imported"
    },
    "voice_090:r_d5e0a2317c40d322": {
      "text": "No crude puppet will stop my music.",
      "status": "imported"
    },
    "voice_090:r_ec2ea17765052401": {
      "text": "Can my sound reach all of you?",
      "status": "imported"
    },
    "voice_090:r_f2d4255f1c2f7542": {
      "text": "Let me deliver the melody I weave.",
      "status": "imported"
    },
    "voice_090:r_5d08ad19e2da125b": {
      "text": "Will the monster heed my music...?",
      "status": "imported"
    },
    "voice_090:r_a7246b52782a877e": {
      "text": "The unknown is what stirs romance.",
      "status": "imported"
    },
    "voice_090:r_dc8701f6bcb9904f": {
      "text": "Endless destroyer...\\nBegone forever!",
      "status": "imported"
    },
    "voice_090:r_d6bdd730f24f66eb": {
      "text": "We'll free you from that dissonance!",
      "status": "imported"
    },
    "voice_090:r_41997412868c48c4": {
      "text": "If that machine's din\\nbinds you...!",
      "status": "imported"
    },
    "voice_090:r_9e6cf4f389dae55c": {
      "text": "If this sound distorts the world...!",
      "status": "imported"
    },
    "voice_090:r_9e0c80ac7e33b459": {
      "text": "World harmony\\nrejects selfish notes!",
      "status": "imported"
    },
    "voice_090:r_7432ef43ed3471dc": {
      "text": "No mercy:\\nyou disrupt human harmony!",
      "status": "imported"
    },
    "voice_090:r_065443f6ddfcf0d7": {
      "text": "The world's baton isn't yours...!",
      "status": "imported"
    },
    "voice_090:r_47d52a2839c71715": {
      "text": "Shrade! Let's unite our strength!",
      "status": "imported"
    },
    "voice_090:r_847f82e7f3eef651": {
      "text": "Come, friend!\\nUltimate melody, now!",
      "status": "imported"
    },
    "voice_090:r_eb7ae28b53dc033c": {
      "text": "Play it, Shrade!\\nUltimate melody!",
      "status": "imported"
    },
    "voice_090:r_857c4a52ce8df0fd": {
      "text": "Gladly, friend! Now is the time...!",
      "status": "imported"
    },
    "voice_090:r_55417493fce1d347": {
      "text": "Come. Transcend death and despair.",
      "status": "imported"
    },
    "voice_090:r_8fdf5910927c9591": {
      "text": "Join me,\\nand we can do it!",
      "status": "imported"
    },
    "voice_090:r_7d724dbcc4451e10": {
      "text": "You won't evade me...!",
      "status": "imported"
    },
    "voice_090:r_93e25418a203cb8f": {
      "text": "This is forte...!",
      "status": "imported"
    },
    "voice_090:r_adeb0a29274d3d9b": {
      "text": "My blade's tip plays a note...!",
      "status": "imported"
    },
    "voice_090:r_24cf161287ef9d5c": {
      "text": "Upon a sweet melody...!",
      "status": "imported"
    },
    "voice_090:r_8f60f6fc86db3107": {
      "text": "Amata, Zessica...!\\nLend me strength!",
      "status": "imported"
    },
    "voice_090:r_b1de76a75a253c13": {
      "text": "Got it!",
      "status": "imported"
    },
    "voice_090:r_128c35bf3e0e394c": {
      "text": "Let's do this, Shrade!",
      "status": "imported"
    },
    "voice_090:r_5213c17e13b23de0": {
      "text": "Here we go! The soul's arpeggio!",
      "status": "imported"
    },
    "voice_090:r_38fdff9483e9245c": {
      "text": "Sky: vibrato.\\nSea: allegro vivace.",
      "status": "imported"
    },
    "voice_090:r_620fedec67706d7d": {
      "text": "The human moon sings life\\nagitato!",
      "status": "imported"
    },
    "voice_090:r_9680dcd0fddcfcc7": {
      "text": "Moonlight Requiem!",
      "status": "imported"
    },
    "voice_090:r_2a00f1044ad5cbaa": {
      "text": "My life...! It plays with the moon!",
      "status": "imported"
    },
    "voice_090:r_46e86d000250e137": {
      "text": "Haaaaah!",
      "status": "imported"
    },
    "voice_090:r_ac341e7976e88f0b": {
      "text": "My soul and life ring in moonlight!",
      "status": "imported"
    },
    "voice_090:r_cdbd128a5b4127cc": {
      "text": "Resound, Moonlight Requiem!",
      "status": "imported"
    },
    "voice_090:r_cfccaa1fbeda124c": {
      "text": "This is the finale!",
      "status": "imported"
    },
    "voice_090:r_b1f8ec192b9c083a": {
      "text": "Swiftest toccata,\\nI'll pluck away!",
      "status": "imported"
    },
    "voice_090:r_a007f9ab9cf048b3": {
      "text": "Tonight's moon shall play...!",
      "status": "imported"
    },
    "voice_090:r_ddafde4b065ced49": {
      "text": "Moonlight Rhapsody!",
      "status": "imported"
    },
    "voice_090:r_de1213040856c089": {
      "text": "One bewitched by the lovely moon...!",
      "status": "imported"
    },
    "voice_090:r_3304412ac41f47a6": {
      "text": "Lose yourself in my melody...!",
      "status": "imported"
    },
    "voice_090:r_0c0775e051211840": {
      "text": "Moonlight Rhapsody!",
      "status": "imported"
    },
    "voice_090:r_ceb935ccbf830724": {
      "text": "I'll lay my sound over yours...!",
      "status": "imported"
    },
    "voice_090:r_862ef7385bf2abd4": {
      "text": "Then allow me to perform for you.",
      "status": "imported"
    },
    "voice_090:r_001cbec4d9a4283f": {
      "text": "I'll lay a pure tone over that murk.",
      "status": "imported"
    },
    "voice_090:r_8ad40afecd02b41e": {
      "text": "This is my return gift.",
      "status": "imported"
    },
    "voice_090:r_26e5efec03c03d78": {
      "text": "I won't offer this life for nothing.",
      "status": "imported"
    },
    "voice_090:r_4ad81e88c7557a8b": {
      "text": "This exchange... It resembles jazz.",
      "status": "imported"
    },
    "voice_090:r_1f65a7af190e4674": {
      "text": "Let's play four hands.",
      "status": "imported"
    },
    "voice_090:r_40c5a9358ed5bf29": {
      "text": "A duet isn't bad either.",
      "status": "imported"
    },
    "voice_090:r_f2e18dfdfe0c89ea": {
      "text": "Get behind me...!",
      "status": "imported"
    },
    "voice_090:r_cf7dbf49e96a5755": {
      "text": "Don't throw your life away...!",
      "status": "imported"
    },
    "voice_090:r_fa96676cc65bb509": {
      "text": "I see. So I can only see you off...",
      "status": "imported"
    },
    "voice_090:r_4e37f92e7d2fc62e": {
      "text": "So I've been thoroughly outwitted.",
      "status": "imported"
    },
    "voice_090:r_66ab4cfe1557909d": {
      "text": "It seems\\nAquarion and I are spent.",
      "status": "imported"
    },
    "voice_090:r_0bad405ee6ca63ba": {
      "text": "Well placed. You sealed my counter.",
      "status": "imported"
    },
    "voice_090:r_2072eaf71a260ae7": {
      "text": "It seems\\nyou have read my range.",
      "status": "imported"
    },
    "voice_090:r_6c13bbfd27a7799e": {
      "text": "Heh... Too slow.",
      "status": "imported"
    },
    "voice_090:r_06f88dcbd3c9e738": {
      "text": "That sound won't reach me.",
      "status": "imported"
    },
    "voice_090:r_b28faf9f71bc3598": {
      "text": "The result speaks for itself.",
      "status": "imported"
    },
    "voice_090:r_8a29278549f8e07a": {
      "text": "Is the tempo adagio?",
      "status": "imported"
    },
    "voice_090:r_7e6c573c26177f98": {
      "text": "I've read your intentions.",
      "status": "imported"
    },
    "voice_090:r_45abf84f7757d6eb": {
      "text": "No one can catch me.",
      "status": "imported"
    },
    "voice_090:r_edd7a13ab8f06a14": {
      "text": "I already control your every move.",
      "status": "imported"
    },
    "voice_090:r_8165e5b41f0124c4": {
      "text": "I feel like a beast tamer.",
      "status": "imported"
    },
    "voice_090:r_4e05581b7432cce8": {
      "text": "Presto... But that is all.",
      "status": "imported"
    },
    "voice_090:r_a60b107ea3c36a86": {
      "text": "Just what I'd expect, Shrade!",
      "status": "imported"
    },
    "voice_090:r_e33693e5ba4665b0": {
      "text": "Heh... Praise doesn't feel too bad.",
      "status": "imported"
    },
    "voice_090:r_72a21a1a489af001": {
      "text": "Shrade, another one's coming!",
      "status": "imported"
    },
    "voice_090:r_eb643f8bf737a0ca": {
      "text": "Then I'll simply dodge that as well.",
      "status": "imported"
    },
    "voice_090:r_0a3fccb71ec6cf2a": {
      "text": "You saw through that attack...!?",
      "status": "imported"
    },
    "voice_090:r_9b63cf1f3e0207ef": {
      "text": "That's hardly surprising, my friend.",
      "status": "imported"
    },
    "voice_090:r_8356f4e3dcdff938": {
      "text": "My soul is a free melody, my friend.",
      "status": "imported"
    },
    "voice_090:r_1d6d784036ae0bd7": {
      "text": "Enough talk! Another one's coming!",
      "status": "imported"
    },
    "voice_090:r_625664af02183c17": {
      "text": "Not bad, Shrade!",
      "status": "imported"
    },
    "voice_090:r_3701cba361f80ea5": {
      "text": "All flows in rhythm and melody.",
      "status": "imported"
    },
    "voice_090:r_63f429c5c68c0863": {
      "text": "Lento... Too slow.",
      "status": "imported"
    },
    "voice_090:r_38e4a434c91d8ef0": {
      "text": "Can't keep pace\\nwith Spada's speed.",
      "status": "imported"
    },
    "voice_090:r_98ed411352a3a6ac": {
      "text": "Heh...!\\nDamn, those moves are good!",
      "status": "imported"
    },
    "voice_090:r_4824bea6bab3af67": {
      "text": "This is only 50% of my strength.",
      "status": "imported"
    },
    "voice_090:r_862b92e63adb9734": {
      "text": "That movement... What is it?",
      "status": "imported"
    },
    "voice_090:r_cb306ef55e49d107": {
      "text": "Heh... Did you feel my melody?",
      "status": "imported"
    },
    "voice_090:r_6f95653e548f8fcf": {
      "text": "I prepared this as well.",
      "status": "imported"
    },
    "voice_090:r_d249d68bada91ab9": {
      "text": "A barrier... I still have far to go.",
      "status": "imported"
    },
    "voice_090:r_e9b3307e9eb69f11": {
      "text": "I'll simply block it with my shield.",
      "status": "imported"
    },
    "voice_090:r_03cdac73042343ee": {
      "text": "Spada has an impregnable shield.",
      "status": "imported"
    },
    "voice_090:r_6026da5acbda7c69": {
      "text": "Heh... How could I...?",
      "status": "imported"
    },
    "voice_090:r_981f8fedd5414fe5": {
      "text": "Has the flow changed...?",
      "status": "imported"
    },
    "voice_090:r_96bb0dcde0c8c44a": {
      "text": "Has dissonance crept in...?",
      "status": "imported"
    },
    "voice_090:r_641550a2f54cb456": {
      "text": "What a sloppy rhythm.",
      "status": "imported"
    },
    "voice_090:r_a0f2074af8debbfa": {
      "text": "What a wild rhapsody.",
      "status": "imported"
    },
    "voice_090:r_b5f5a97ed82acb0b": {
      "text": "I never expected to win unscathed.",
      "status": "imported"
    },
    "voice_090:r_d9cd2e4ded064396": {
      "text": "Are you all right, Shrade!?",
      "status": "imported"
    },
    "voice_090:r_99e6349431aaf23b": {
      "text": "Heh... You worry too much, Amata.",
      "status": "imported"
    },
    "voice_090:r_ec1081caf845f56a": {
      "text": "Sorry, Mikono.\\nThat was my mistake.",
      "status": "imported"
    },
    "voice_090:r_2c5b7ee872c1ed7f": {
      "text": "N-no! I'm all right!",
      "status": "imported"
    },
    "voice_090:r_76d1e51c8b494a60": {
      "text": "Shrade, switch with me!",
      "status": "imported"
    },
    "voice_090:r_eb5f687fcd372ae7": {
      "text": "Worried about my body, my friend?",
      "status": "imported"
    },
    "voice_090:r_2329428a6871d9fa": {
      "text": "It seems our foe is quite skilled.",
      "status": "imported"
    },
    "voice_090:r_0e7466971bec4cc4": {
      "text": "No time to be impressed! Think!",
      "status": "imported"
    },
    "voice_090:r_efa71f7a4cc33ff3": {
      "text": "A rare hit on you,\\nShrade!",
      "status": "imported"
    },
    "voice_090:r_3fc2e1186557e7a0": {
      "text": "A missed note. I won't make excuses.",
      "status": "imported"
    },
    "voice_090:r_fa6930340a545054": {
      "text": "An odd meter. You surprised me.",
      "status": "imported"
    },
    "voice_090:r_2332b9d56461d7ab": {
      "text": "That composure... You must be fine.",
      "status": "imported"
    },
    "voice_090:r_854aa0a91a3c80d1": {
      "text": "You got hit!\\nDrop the damn calm act!",
      "status": "imported"
    },
    "voice_090:r_0bc8ae32a406ceab": {
      "text": "In a crisis,\\na calm mind is vital.",
      "status": "imported"
    },
    "voice_090:r_82c09f011d703b2c": {
      "text": "A foe who exceeds my data...!?",
      "status": "imported"
    },
    "voice_090:r_2b4d8818c77b6dca": {
      "text": "Then I'll counter even faster.",
      "status": "imported"
    },
    "voice_090:r_087354f2db0a31e6": {
      "text": "Ngh...! I didn't expect that...!",
      "status": "imported"
    },
    "voice_090:r_db02a2dec93dd263": {
      "text": "Grave... So heavy and resonant...",
      "status": "imported"
    },
    "voice_090:r_d520c6d5298a848d": {
      "text": "Stringendo... More than expected.",
      "status": "imported"
    },
    "voice_090:r_099e2458cabf796f": {
      "text": "That wild sound toys with me...",
      "status": "imported"
    },
    "voice_090:r_fd910d714be70870": {
      "text": "It seems I must risk my life too...",
      "status": "imported"
    },
    "voice_090:r_9736f29b11344ec3": {
      "text": "Fine attack. My life is worn away...",
      "status": "imported"
    },
    "voice_090:r_fcd05582aa5c6068": {
      "text": "Wild melody...\\nDanger is its charm!",
      "status": "imported"
    },
    "voice_090:r_bece29562818acba": {
      "text": "Prestissimo...!\\nYou're speeding up!",
      "status": "imported"
    },
    "voice_090:r_494b5da92ed24ecb": {
      "text": "Shrade, can you still fight!?",
      "status": "imported"
    },
    "voice_090:r_a4a5a96f4bd58920": {
      "text": "Of course.\\nMy life still burns.",
      "status": "imported"
    },
    "voice_090:r_b57d2d74233f889a": {
      "text": "Shrade, you can't keep this up...!",
      "status": "imported"
    },
    "voice_090:r_cd06d0820d82524b": {
      "text": "No. I have a reason I can't retreat.",
      "status": "imported"
    },
    "voice_090:r_c94c6d04be583774": {
      "text": "Shrade!\\nIs that all you've got!?",
      "status": "imported"
    },
    "voice_090:r_e54e2c99ef8297af": {
      "text": "Heh... Rough encouragement, friend.",
      "status": "imported"
    },
    "voice_090:r_f16a3eb0bcaac082": {
      "text": "Not yet.\\nPerfection lies ahead...",
      "status": "imported"
    },
    "voice_090:r_10a408809e512df1": {
      "text": "Shrade, you...",
      "status": "imported"
    },
    "voice_090:r_bc7b9e308b879dd4": {
      "text": "You bastard! You'll pay for that!",
      "status": "imported"
    },
    "voice_090:r_98902fd3143c393e": {
      "text": "Heh... Your spirit fires me up too.",
      "status": "imported"
    },
    "voice_090:r_d907fbd7bc1c4298": {
      "text": "You took that head-on, Shrade!",
      "status": "imported"
    },
    "voice_090:r_96b21e3a028dd074": {
      "text": "Fine, Malloy.\\nTheir moves are clear.",
      "status": "imported"
    },
    "voice_090:r_ce140b5d8e6b7310": {
      "text": "We're pressed! What's your plan?!",
      "status": "imported"
    },
    "voice_090:r_0e0335789c5396d7": {
      "text": "Obviously...!\\nWe'll turn it around!",
      "status": "imported"
    },
    "voice_090:r_a8e85bd950696403": {
      "text": "If this keeps up,\\neven Aquarion...!",
      "status": "imported"
    },
    "voice_090:r_772c8bc40ab6cb61": {
      "text": "No need to worry. We attack...!",
      "status": "imported"
    },
    "voice_090:r_e7a8cd8ed5bc2d1b": {
      "text": "My soul fades perdendosi...",
      "status": "imported"
    },
    "voice_090:r_041dd920da4a7c17": {
      "text": "Guh...! My body's near its limit!",
      "status": "imported"
    },
    "voice_090:r_c7f4280cde4605b3": {
      "text": "Aquarion...!\\nJust give me more time!",
      "status": "imported"
    },
    "voice_090:r_ec349c8ea9511a18": {
      "text": "My life won't end\\nin this place...!",
      "status": "imported"
    },
    "voice_090:r_33236ffa3ea95b68": {
      "text": "Not yet...!\\nMy true melody awaits!",
      "status": "imported"
    },
    "voice_090:r_689d0b123de71ae0": {
      "text": "Flesh cries become soul's melody...!",
      "status": "imported"
    },
    "voice_090:r_84883aa95f63ce32": {
      "text": "Shrade, take our power!\\nPlease...!",
      "status": "imported"
    },
    "voice_090:r_25493e978ce8ff16": {
      "text": "I know. I'll fight to the very end.",
      "status": "imported"
    },
    "voice_090:r_7316666150e42960": {
      "text": "Mikono...\\nwill you lend me power?",
      "status": "imported"
    },
    "voice_090:r_c4f11aa93dc5b668": {
      "text": "Yes! I'll fight to the very end too!",
      "status": "imported"
    },
    "voice_090:r_ce1a22dfe3a4d339": {
      "text": "Shrade! You wouldn't die here...!?",
      "status": "imported"
    },
    "voice_090:r_240651adab81e145": {
      "text": "No jokes, friend.\\nI won't die here.",
      "status": "imported"
    },
    "voice_090:r_cff0deaae73c2858": {
      "text": "Sorry, friend.\\nI hold your life too.",
      "status": "imported"
    },
    "voice_090:r_dca67f68a573fab7": {
      "text": "Don't fret!\\nLet's take them down!",
      "status": "imported"
    },
    "voice_090:r_a6630215fefaf294": {
      "text": "Ignore the damage!\\nWe'll cover you!",
      "status": "imported"
    },
    "voice_090:r_6f94566ad37f8ff8": {
      "text": "I'll take you up on that, Andy.",
      "status": "imported"
    },
    "voice_090:r_942ca03c9de80143": {
      "text": "Shrade! You've got one shot left!",
      "status": "imported"
    },
    "voice_090:r_d8c669c70659e18a": {
      "text": "Understood. I'll beat them first!",
      "status": "imported"
    },
    "voice_090:r_8f5bade7ac2db78e": {
      "text": "It seems\\ntime to steel myself...!",
      "status": "imported"
    },
    "voice_090:r_05ea490d2f522520": {
      "text": "Don't worry!\\nWith you to the end!",
      "status": "imported"
    },
    "voice_090:r_f5658c702d91db7a": {
      "text": "No! The machine can't take any more!",
      "status": "imported"
    },
    "voice_090:r_686df329b50f195b": {
      "text": "Remember, Jin!\\nOnly you decide!",
      "status": "imported"
    },
    "voice_090:r_25f0ab0fa3cf690c": {
      "text": "Will my melody... end here...?",
      "status": "imported"
    },
    "voice_090:r_b708a1d959013dbf": {
      "text": "Ultimate tune... Still unfinished...",
      "status": "imported"
    },
    "voice_090:r_59fca03e929366c1": {
      "text": "Farewell, my friend...",
      "status": "imported"
    },
    "voice_090:r_0d65eb631dcb7514": {
      "text": "Friend... Speak to players on break.",
      "status": "imported"
    },
    "voice_090:r_d03018a31e23f1e9": {
      "text": "Heh... Praise my sound, then air it.",
      "status": "imported"
    },
    "voice_090:r_279da5f732aa8847": {
      "text": "The classic tsundere.",
      "status": "imported"
    },
    "voice_090:r_97f82e3cb6f70110": {
      "text": "Doesn't seem that way, does it?",
      "status": "imported"
    },
    "voice_090:r_c5611d8dd6def96b": {
      "text": "I feel my friend's soul so near...!",
      "status": "imported"
    },
    "voice_090:r_6f12cc8ed2732eb5": {
      "text": "Come fight beside me, Cayenne!",
      "status": "imported"
    },
    "voice_090:r_7abfc55f8fb62ba7": {
      "text": "Let's go, my friend!",
      "status": "imported"
    },
    "voice_090:r_99e7a66c650b5892": {
      "text": "I dedicate this to my friend!",
      "status": "imported"
    },
    "voice_090:r_5b2247b5cfbcd7b2": {
      "text": "Trinity Requiem!!",
      "status": "imported"
    },
    "voice_090:r_2d7a9c06347582d9": {
      "text": "Time to play the ultimate melody...!",
      "status": "imported"
    },
    "voice_090:r_bf953d64c3c7d9b7": {
      "text": "Will you play with me, Cayenne?",
      "status": "imported"
    },
    "voice_090:r_e09b933e3e706779": {
      "text": "Of course, my friend.",
      "status": "imported"
    },
    "voice_090:r_66236eb99b676e5b": {
      "text": "I'll play with my friend!",
      "status": "imported"
    },
    "voice_090:r_9639a2dbcd2f58ed": {
      "text": "Trinity Requiem!!",
      "status": "imported"
    },
    "voice_090:r_aeea0893acb93d35": {
      "text": "From me...\\nfrom us, a new sound!",
      "status": "imported"
    },
    "voice_090:r_b31568654e53487b": {
      "text": "This is... what Shrade longed for!",
      "status": "imported"
    },
    "voice_090:r_2502132569141ea3": {
      "text": "Yes! The ultimate melody!",
      "status": "imported"
    },
    "voice_090:r_1ff312798a52c8eb": {
      "text": "Spada and Gepard's power as one...!",
      "status": "imported"
    },
    "voice_090:r_03f6158ef83964f3": {
      "text": "No... My bare skin is sensitive...!",
      "status": "imported"
    },
    "voice_090:r_2970a83693cdcc25": {
      "text": "Every last bit of my body...!",
      "status": "imported"
    },
    "voice_090:r_be661448b85d0009": {
      "text": "It's so stimulatinggg!",
      "status": "imported"
    },
    "voice_090:r_958a56c1151cab9e": {
      "text": "Uoooooh!",
      "status": "imported"
    },
    "voice_090:r_8b18aa4cc69547df": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_090:r_3e87f6fc3ea65aef": {
      "text": "No Guard!",
      "status": "imported"
    },
    "voice_090:r_5508a7bfa9074eb9": {
      "text": "Attaaack!!",
      "status": "imported"
    },
    "voice_090:r_09a003e91f0d5dc7": {
      "text": "Embarrassing, but it feels so good!",
      "status": "imported"
    },
    "voice_090:r_192447448ebd7bb5": {
      "text": "My whole body's burning up!",
      "status": "imported"
    },
    "voice_090:r_e92920ba4b301b9f": {
      "text": "I-it's embarrassing, but...!",
      "status": "imported"
    },
    "voice_090:r_207b256d613bb896": {
      "text": "This somehow feels so good!",
      "status": "imported"
    },
    "voice_090:r_a6fd676d8146501b": {
      "text": "Haaaaah!",
      "status": "imported"
    },
    "voice_090:r_94d35e5fa8e3a198": {
      "text": "Scorch the skin and sever the flesh!",
      "status": "imported"
    },
    "voice_090:r_25f9b1e39dd8d366": {
      "text": "We did it, Amata! Mikono!",
      "status": "imported"
    },
    "voice_090:r_307477bedd148060": {
      "text": "M-my shame, and...!",
      "status": "imported"
    },
    "voice_090:r_09a780acca0eb4b0": {
      "text": "A sense of release...!",
      "status": "imported"
    },
    "voice_090:r_af62f2ee466b5c8c": {
      "text": "Their fierce struggle!",
      "status": "imported"
    },
    "voice_090:r_727b2ee0277f9159": {
      "text": "Ah... My heart won't stop racing...!",
      "status": "imported"
    },
    "voice_090:r_c885ff2097749991": {
      "text": "Did it reach you... my... melody...!",
      "status": "imported"
    },
    "voice_090:r_0465f74c0488ad70": {
      "text": "I'll get this started.",
      "status": "imported"
    },
    "voice_090:r_a30c8238b5208470": {
      "text": "I won't stop at mere diversion.",
      "status": "imported"
    },
    "voice_090:r_64bf1c63c7c1ebdd": {
      "text": "I'll play the opening note.",
      "status": "imported"
    },
    "voice_090:r_f6d5042f671118fa": {
      "text": "I'll leave the main part to you.",
      "status": "imported"
    },
    "voice_090:r_0be18539fac21ba4": {
      "text": "Allow me to play my solo.",
      "status": "imported"
    },
    "voice_090:r_c05bd0cf089d667f": {
      "text": "This piece is for you.",
      "status": "imported"
    },
    "voice_090:r_f69a0e1d0d67fd0e": {
      "text": "Will you be my opponent?",
      "status": "imported"
    },
    "voice_090:r_c4e734ceafabd82c": {
      "text": "Bad luck for you.",
      "status": "imported"
    }
  }
}
