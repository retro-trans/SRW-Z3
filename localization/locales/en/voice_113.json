{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_113:r_479b340ccc6c572b": {
      "text": "Move it!\\nDeath's coming through!",
      "status": "imported"
    },
    "voice_113:r_ca4acbac57a2a35e": {
      "text": "Just go down already!!",
      "status": "imported"
    },
    "voice_113:r_77949221bf58f862": {
      "text": "I said get outta my way!!",
      "status": "imported"
    },
    "voice_113:r_70b9c4b9f1f37eff": {
      "text": "Brace yourself!!",
      "status": "imported"
    },
    "voice_113:r_9fcb3754cb1773c7": {
      "text": "Hyaaaaaah!!",
      "status": "imported"
    },
    "voice_113:r_3559d2fad32c2435": {
      "text": "You bastard!!",
      "status": "imported"
    },
    "voice_113:r_f7570547e9f80a64": {
      "text": "Get too close...and you'll die!",
      "status": "imported"
    },
    "voice_113:r_cbab0f4720e1fcf1": {
      "text": "Let's go, partner!",
      "status": "imported"
    },
    "voice_113:r_0bbe0b4f5364e732": {
      "text": "Come to hell with me!",
      "status": "imported"
    },
    "voice_113:r_5dda5198137cb02a": {
      "text": "All right, then!",
      "status": "imported"
    },
    "voice_113:r_83ec59afbecdec14": {
      "text": "Eat this!",
      "status": "imported"
    },
    "voice_113:r_e20bfd42ad95a3c9": {
      "text": "This is the end!!",
      "status": "imported"
    },
    "voice_113:r_0f58a8822381e57f": {
      "text": "It's useless! Totally useless!!",
      "status": "imported"
    },
    "voice_113:r_6dbcc507fb61b51d": {
      "text": "Gah! They got me, damn it!",
      "status": "imported"
    },
    "voice_113:r_b42ab697149a7c8a": {
      "text": "Ugh...I look so uncool!",
      "status": "imported"
    },
    "voice_113:r_4de4fcf3b440baf4": {
      "text": "Ow...this is bad!",
      "status": "imported"
    },
    "voice_113:r_0121a166c715cdff": {
      "text": "Ngh! That one hurt...",
      "status": "imported"
    },
    "voice_113:r_30fad37a42bd3ad3": {
      "text": "Gah! Th-this is bad!!",
      "status": "imported"
    },
    "voice_113:r_80a0b2a84e05d81a": {
      "text": "Agh!\\nDid I take too much damage?!",
      "status": "imported"
    },
    "voice_113:r_4a9ac1dff86506d9": {
      "text": "Ow! You're pretty good!!",
      "status": "imported"
    },
    "voice_113:r_bc8538e6af3d2577": {
      "text": "Y-you! You made me go all out!!",
      "status": "imported"
    },
    "voice_113:r_924516c8de2b5342": {
      "text": "Ow!!\\nDon't get so full of yourself!!",
      "status": "imported"
    },
    "voice_113:r_da1174533722333f": {
      "text": "Whoa! What're you doing!!",
      "status": "imported"
    },
    "voice_113:r_fdeb8162976e72c1": {
      "text": "Ow ow ow...\\nYou got me good!",
      "status": "imported"
    },
    "voice_113:r_0fadb5c26df92b42": {
      "text": "What, is that all?!",
      "status": "imported"
    },
    "voice_113:r_6b15af9a0057cdc8": {
      "text": "Ha ha ha! Didn't feel a thing!",
      "status": "imported"
    },
    "voice_113:r_15b4a90140e8a33a": {
      "text": "Well? Well? Is that all you've got?!",
      "status": "imported"
    },
    "voice_113:r_af884a6b11dff121": {
      "text": "Whoa there!",
      "status": "imported"
    },
    "voice_113:r_ac6fe7838e95647b": {
      "text": "You'll never hit me!!",
      "status": "imported"
    },
    "voice_113:r_77ca87eacd17ad52": {
      "text": "Where're you aiming, lousy shot!",
      "status": "imported"
    },
    "voice_113:r_bf3244994760e535": {
      "text": "Hit the great Duo?\\n100 years early!",
      "status": "imported"
    },
    "voice_113:r_aabfb21c9d069ce7": {
      "text": "Whoa!\\nHate to brag, but I'm a pro!",
      "status": "imported"
    },
    "voice_113:r_02479dc8fe989560": {
      "text": "Huh?! Came up short, didn't you?",
      "status": "imported"
    },
    "voice_113:r_a2df00f91a9b0a9e": {
      "text": "Move! Move! Death's coming through!",
      "status": "imported"
    },
    "voice_113:r_48b60d6c48b9b142": {
      "text": "Here! Let's go another round!",
      "status": "imported"
    },
    "voice_113:r_8927e6fb681aa809": {
      "text": "Eat this one too!",
      "status": "imported"
    },
    "voice_113:r_665f01666859013b": {
      "text": "You owe me one, Heero!",
      "status": "imported"
    },
    "voice_113:r_a571eec59b258d11": {
      "text": "Trowa! I'll lend you a hand!",
      "status": "imported"
    },
    "voice_113:r_ddbe581c5ea9183d": {
      "text": "Quatre! I'm coming in too!",
      "status": "imported"
    },
    "voice_113:r_faae935cca0edc72": {
      "text": "I'll lend a hand, Wufei!",
      "status": "imported"
    },
    "voice_113:r_d4430bf362340b32": {
      "text": "Leave this to the great Duo!",
      "status": "imported"
    },
    "voice_113:r_6ff1323b355593e0": {
      "text": "You won't have your way!",
      "status": "imported"
    },
    "voice_113:r_b7b5625d7cd4282f": {
      "text": "Sorry, but I'm cutting in!",
      "status": "imported"
    },
    "voice_113:r_36133ad73a73ef98": {
      "text": "You'd better thank me, Heero!",
      "status": "imported"
    },
    "voice_113:r_920740a0219c5085": {
      "text": "Trowa, leave this to me!",
      "status": "imported"
    },
    "voice_113:r_a8451712c57c1a72": {
      "text": "Fall back, Quatre!",
      "status": "imported"
    },
    "voice_113:r_3633df5b7b8f47fa": {
      "text": "Wufei! Now's your chance!",
      "status": "imported"
    },
    "voice_113:r_52dfc56b14b93551": {
      "text": "Heh, what? This is easy!",
      "status": "imported"
    },
    "voice_113:r_1b9b2aab5cb104da": {
      "text": "There! Is that all?",
      "status": "imported"
    },
    "voice_113:r_342044c706a2340f": {
      "text": "Hey, watch it! That was dangerous!",
      "status": "imported"
    },
    "voice_113:r_cf41e8828a90cbdb": {
      "text": "That won't be enough\\nto stop Death!",
      "status": "imported"
    },
    "voice_113:r_719e897304ec42d4": {
      "text": "Wanna live long?\\nDon't make me mad!",
      "status": "imported"
    },
    "voice_113:r_d5e0a2317c40d322": {
      "text": "Ngh! This one's truly tough!",
      "status": "imported"
    },
    "voice_113:r_ec2ea17765052401": {
      "text": "Ow ow...\\nI shame the name of Death!",
      "status": "imported"
    },
    "voice_113:r_f2d4255f1c2f7542": {
      "text": "Tch!\\nQuit messing with my partner!",
      "status": "imported"
    },
    "voice_113:r_5d08ad19e2da125b": {
      "text": "Retreat?\\nI'd have fled at the start!",
      "status": "imported"
    },
    "voice_113:r_a7246b52782a877e": {
      "text": "All we can do is charge!!",
      "status": "imported"
    },
    "voice_113:r_dc8701f6bcb9904f": {
      "text": "Well then, let's break through!",
      "status": "imported"
    },
    "voice_113:r_d6bdd730f24f66eb": {
      "text": "Hate to copy Heero.\\nJoin me in hell!",
      "status": "imported"
    },
    "voice_113:r_41997412868c48c4": {
      "text": "Wanna live long?\\nDon't make me mad",
      "status": "imported"
    },
    "voice_113:r_9e6cf4f389dae55c": {
      "text": "Well then, let's get going!",
      "status": "imported"
    },
    "voice_113:r_7432ef43ed3471dc": {
      "text": "And that's a wrap!",
      "status": "imported"
    },
    "voice_113:r_065443f6ddfcf0d7": {
      "text": "Wanna live long?\\nDon't anger me!",
      "status": "imported"
    },
    "voice_113:r_47d52a2839c71715": {
      "text": "Here we gooooo!!",
      "status": "imported"
    },
    "voice_113:r_847f82e7f3eef651": {
      "text": "Heh, tough luck!",
      "status": "imported"
    },
    "voice_113:r_eb7ae28b53dc033c": {
      "text": "There you go!",
      "status": "imported"
    },
    "voice_113:r_857c4a52ce8df0fd": {
      "text": "And another!",
      "status": "imported"
    },
    "voice_113:r_55417493fce1d347": {
      "text": "Brace yourself!",
      "status": "imported"
    },
    "voice_113:r_8fdf5910927c9591": {
      "text": "Hyaah!",
      "status": "imported"
    },
    "voice_113:r_b1de76a75a253c13": {
      "text": "You're in my way! Move!!",
      "status": "imported"
    },
    "voice_113:r_5213c17e13b23de0": {
      "text": "Damn it! They just keep coming!",
      "status": "imported"
    },
    "voice_113:r_38fdff9483e9245c": {
      "text": "Th-this is nothing!!",
      "status": "imported"
    },
    "voice_113:r_620fedec67706d7d": {
      "text": "Huh? That didn't hurt!",
      "status": "imported"
    },
    "voice_113:r_9680dcd0fddcfcc7": {
      "text": "Think I'll dodge this for now.",
      "status": "imported"
    },
    "voice_113:r_2a00f1044ad5cbaa": {
      "text": "Jeez...give me a break!",
      "status": "imported"
    },
    "voice_113:r_cfccaa1fbeda124c": {
      "text": "Well then, let's get to it!",
      "status": "imported"
    },
    "voice_113:r_ddafde4b065ced49": {
      "text": "Today, there's no backing down!",
      "status": "imported"
    },
    "voice_113:r_3304412ac41f47a6": {
      "text": "I'm dragging you to hell with me!!",
      "status": "imported"
    },
    "voice_113:r_0c0775e051211840": {
      "text": "That one...seriously?!",
      "status": "imported"
    },
    "voice_113:r_a2afffe1c396f0b3": {
      "text": "You want it?\\nThen no holding back!",
      "status": "imported"
    },
    "voice_113:r_13c25fbdfddc8a24": {
      "text": "A god? Well, I'm the god of death!",
      "status": "imported"
    },
    "voice_113:r_68f2dfab20a4a30e": {
      "text": "You can't stop Death!",
      "status": "imported"
    },
    "voice_113:r_9cedad8237480563": {
      "text": "There we go!",
      "status": "imported"
    },
    "voice_113:r_a03fabecba1508ca": {
      "text": "There!",
      "status": "imported"
    },
    "voice_113:r_5391b24a71eb10ae": {
      "text": "Move!",
      "status": "imported"
    },
    "voice_113:r_a554ceef5c87b972": {
      "text": "Here I go!",
      "status": "imported"
    },
    "voice_113:r_546c3d5937fbb7ee": {
      "text": "Go down!",
      "status": "imported"
    },
    "voice_113:r_1568ff6298b12b96": {
      "text": "Why, you!",
      "status": "imported"
    },
    "voice_113:r_2c9d94ba13c5fc50": {
      "text": "Ngh! Doing whatever you please!",
      "status": "imported"
    },
    "voice_113:r_a77f4913375098d2": {
      "text": "Pathetic...and I call myself Death!",
      "status": "imported"
    },
    "voice_113:r_428c2116ac3071b1": {
      "text": "Sorry, I'm done! The rest is yours!",
      "status": "imported"
    },
    "voice_113:r_84c116267b79f540": {
      "text": "Ngh! I'm checking out early!",
      "status": "imported"
    },
    "voice_113:r_dad38ee29af2df3a": {
      "text": "Zechs, you reckless bastard!",
      "status": "imported"
    },
    "voice_113:r_3d32e86f8dc80909": {
      "text": "All right, leave the backup to me!",
      "status": "imported"
    },
    "voice_113:r_20920ad2eb3542db": {
      "text": "I'll go on ahead!",
      "status": "imported"
    },
    "voice_113:r_0ab7914877fd48ed": {
      "text": "Waiting around just isn't my style!",
      "status": "imported"
    },
    "voice_113:r_c958860b0676b1f5": {
      "text": "Then I'll do as I please!",
      "status": "imported"
    }
  }
}
