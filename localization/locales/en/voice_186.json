{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_186:r_479b340ccc6c572b": {
      "text": "It's settled. We're moving in!",
      "status": "imported"
    },
    "voice_186:r_ca4acbac57a2a35e": {
      "text": "What are we gonna do, Sousuke?",
      "status": "imported"
    },
    "voice_186:r_70b9c4b9f1f37eff": {
      "text": "You'd better do this right, got it?",
      "status": "imported"
    },
    "voice_186:r_9fcb3754cb1773c7": {
      "text": "No problem. I'm a specialist.",
      "status": "imported"
    },
    "voice_186:r_3559d2fad32c2435": {
      "text": "Chidori, hold on tight!",
      "status": "imported"
    },
    "voice_186:r_f7570547e9f80a64": {
      "text": "W-Wait... Aaaaaaaah!!",
      "status": "imported"
    },
    "voice_186:r_cbab0f4720e1fcf1": {
      "text": "You can't lose to that thing!",
      "status": "imported"
    },
    "voice_186:r_0bbe0b4f5364e732": {
      "text": "That's exactly what I intend!",
      "status": "imported"
    },
    "voice_186:r_5dda5198137cb02a": {
      "text": "Let's really tear 'em up!",
      "status": "imported"
    },
    "voice_186:r_83ec59afbecdec14": {
      "text": "I'm the one fighting, though.",
      "status": "imported"
    },
    "voice_186:r_e20bfd42ad95a3c9": {
      "text": "Get in there and finish them off!",
      "status": "imported"
    },
    "voice_186:r_0f58a8822381e57f": {
      "text": "Roger that!",
      "status": "imported"
    },
    "voice_186:r_6dbcc507fb61b51d": {
      "text": "We've still got this!",
      "status": "imported"
    },
    "voice_186:r_b42ab697149a7c8a": {
      "text": "That's right! It's not over yet!",
      "status": "imported"
    },
    "voice_186:r_4de4fcf3b440baf4": {
      "text": "I'll grate you like Nerima daikon!",
      "status": "imported"
    },
    "voice_186:r_0121a166c715cdff": {
      "text": "Yeah! Grind them to a pulp!",
      "status": "imported"
    },
    "voice_186:r_aabfb21c9d069ce7": {
      "text": "Don't let them get away, Sousuke!",
      "status": "imported"
    },
    "voice_186:r_02479dc8fe989560": {
      "text": "Yeah, I know!",
      "status": "imported"
    },
    "voice_186:r_a2df00f91a9b0a9e": {
      "text": "Hold it right there, damn you!",
      "status": "imported"
    },
    "voice_186:r_48b60d6c48b9b142": {
      "text": "Don't worry. They won't get away!",
      "status": "imported"
    },
    "voice_186:r_8927e6fb681aa809": {
      "text": "Counterattack! Go, Sousuke, go!",
      "status": "imported"
    },
    "voice_186:r_665f01666859013b": {
      "text": "Leave it to me!",
      "status": "imported"
    },
    "voice_186:r_a571eec59b258d11": {
      "text": "Good. Time for threefold payback.",
      "status": "imported"
    },
    "voice_186:r_ddbe581c5ea9183d": {
      "text": "Pathetic! Ten... no, hundredfold!",
      "status": "imported"
    },
    "voice_186:r_faae935cca0edc72": {
      "text": "Sousuke, we can link up!",
      "status": "imported"
    },
    "voice_186:r_d4430bf362340b32": {
      "text": "Good. Follow the allied unit!",
      "status": "imported"
    },
    "voice_186:r_6ff1323b355593e0": {
      "text": "Our allies are in trouble! Hurry!",
      "status": "imported"
    },
    "voice_186:r_b7b5625d7cd4282f": {
      "text": "I know!",
      "status": "imported"
    },
    "voice_186:r_36133ad73a73ef98": {
      "text": "Why can't we attack them?!",
      "status": "imported"
    },
    "voice_186:r_920740a0219c5085": {
      "text": "Those are the rules. Can't help it.",
      "status": "imported"
    },
    "voice_186:r_a8451712c57c1a72": {
      "text": "Hey!\\nWhat the heck is going on?!",
      "status": "imported"
    },
    "voice_186:r_3633df5b7b8f47fa": {
      "text": "Easy, Chidori.\\nThis was expected.",
      "status": "imported"
    },
    "voice_186:r_52dfc56b14b93551": {
      "text": "Way to go, Sousuke!",
      "status": "imported"
    },
    "voice_186:r_1b9b2aab5cb104da": {
      "text": "That's only natural for me.",
      "status": "imported"
    },
    "voice_186:r_342044c706a2340f": {
      "text": "Nothing next to Chidori's retorts!",
      "status": "imported"
    },
    "voice_186:r_cf41e8828a90cbdb": {
      "text": "Yeah, yeah... Wait, what?!",
      "status": "imported"
    },
    "voice_186:r_719e897304ec42d4": {
      "text": "Chidori, are you all right?",
      "status": "imported"
    },
    "voice_186:r_d5e0a2317c40d322": {
      "text": "I'm fine, so just keep blasting!",
      "status": "imported"
    },
    "voice_186:r_ec2ea17765052401": {
      "text": "Pointless! Nwahahahaha!",
      "status": "imported"
    },
    "voice_186:r_f2d4255f1c2f7542": {
      "text": "Chidori, don't let your guard down.",
      "status": "imported"
    },
    "voice_186:r_5d08ad19e2da125b": {
      "text": "Come on! Show some guts! Guts!",
      "status": "imported"
    },
    "voice_186:r_a7246b52782a877e": {
      "text": "I've been doing that all along!",
      "status": "imported"
    },
    "voice_186:r_dc8701f6bcb9904f": {
      "text": "You're not goofing off, are you?!",
      "status": "imported"
    },
    "voice_186:r_d6bdd730f24f66eb": {
      "text": "It means the enemy outplayed us.",
      "status": "imported"
    },
    "voice_186:r_41997412868c48c4": {
      "text": "How'd you let that thing hit us?!",
      "status": "imported"
    },
    "voice_186:r_9e6cf4f389dae55c": {
      "text": "Sorry. That was a basic mistake.",
      "status": "imported"
    },
    "voice_186:r_9e0c80ac7e33b459": {
      "text": "One shot can turn it around.\\nRight?",
      "status": "imported"
    },
    "voice_186:r_7432ef43ed3471dc": {
      "text": "Of course!",
      "status": "imported"
    },
    "voice_186:r_065443f6ddfcf0d7": {
      "text": "Big talk,\\nand this is the result?!",
      "status": "imported"
    },
    "voice_186:r_47d52a2839c71715": {
      "text": "This is wrong... It can't be...!",
      "status": "imported"
    },
    "voice_186:r_847f82e7f3eef651": {
      "text": "What are you doing?! We're losing!",
      "status": "imported"
    },
    "voice_186:r_eb7ae28b53dc033c": {
      "text": "A pro won't quit\\ntill the very end!",
      "status": "imported"
    },
    "voice_186:r_857c4a52ce8df0fd": {
      "text": "Get serious already, Sousuke.",
      "status": "imported"
    },
    "voice_186:r_55417493fce1d347": {
      "text": "I'm always serious, though?",
      "status": "imported"
    },
    "voice_186:r_8fdf5910927c9591": {
      "text": "That means we're in big trouble!",
      "status": "imported"
    },
    "voice_186:r_620fedec67706d7d": {
      "text": "Aaaaah! I lost!!",
      "status": "imported"
    },
    "voice_186:r_9680dcd0fddcfcc7": {
      "text": "Sorry, Chidori... I've shamed you.",
      "status": "imported"
    },
    "voice_186:r_2a00f1044ad5cbaa": {
      "text": "Stopping here? Good work. My turn.",
      "status": "imported"
    },
    "voice_186:r_3dbeead1bd3164ef": {
      "text": "Wait, Chidori. Bad data ruins sims.",
      "status": "imported"
    },
    "voice_186:r_98d15b8cc09bc915": {
      "text": "Monomolecular Cutter on jets? Nuts!",
      "status": "imported"
    },
    "voice_186:r_46e86d000250e137": {
      "text": "You just trashed the whole game!",
      "status": "imported"
    },
    "voice_186:r_ac341e7976e88f0b": {
      "text": "Hand it over. I'll set real stats-",
      "status": "imported"
    },
    "voice_186:r_cdbd128a5b4127cc": {
      "text": "Don't do it!!",
      "status": "imported"
    },
    "voice_186:r_cfccaa1fbeda124c": {
      "text": "Enough! Quit with the fumoffu!",
      "status": "imported"
    },
    "voice_186:r_b1f8ec192b9c083a": {
      "text": "Greet players properly! Properly!",
      "status": "imported"
    },
    "voice_186:r_a007f9ab9cf048b3": {
      "text": "Polish your gun well before bed!",
      "status": "imported"
    },
    "voice_186:r_ddafde4b065ced49": {
      "text": "You mean teeth, not the gun...",
      "status": "imported"
    },
    "voice_186:r_de1213040856c089": {
      "text": "Valor! Beat the enemy closing in!",
      "status": "imported"
    },
    "voice_186:r_3304412ac41f47a6": {
      "text": "Fine! Way better than a bad captain!",
      "status": "imported"
    },
    "voice_186:r_0c0775e051211840": {
      "text": "Pick one, Sousuke! Valor or Alert?!",
      "status": "imported"
    },
    "voice_186:r_a2afffe1c396f0b3": {
      "text": "Uh... Ummmmmm...",
      "status": "imported"
    }
  }
}
