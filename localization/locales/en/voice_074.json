{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_074:r_479b340ccc6c572b": {
      "text": "Well then, farewell!",
      "status": "imported"
    },
    "voice_074:r_ca4acbac57a2a35e": {
      "text": "Drop dead!",
      "status": "imported"
    },
    "voice_074:r_77949221bf58f862": {
      "text": "You naive little fool!",
      "status": "imported"
    },
    "voice_074:r_70b9c4b9f1f37eff": {
      "text": "You're too soft!",
      "status": "imported"
    },
    "voice_074:r_9fcb3754cb1773c7": {
      "text": "Prepare yourself!",
      "status": "imported"
    },
    "voice_074:r_3559d2fad32c2435": {
      "text": "Time to say goodbye!",
      "status": "imported"
    },
    "voice_074:r_f7570547e9f80a64": {
      "text": "See ya!",
      "status": "imported"
    },
    "voice_074:r_cbab0f4720e1fcf1": {
      "text": "Farewell!",
      "status": "imported"
    },
    "voice_074:r_0bbe0b4f5364e732": {
      "text": "Hahahahahahaha!",
      "status": "imported"
    },
    "voice_074:r_5dda5198137cb02a": {
      "text": "Didn't your mommy teach you?",
      "status": "imported"
    },
    "voice_074:r_83ec59afbecdec14": {
      "text": "Meet a thug?\\nGuard wallet and ass!",
      "status": "imported"
    },
    "voice_074:r_e20bfd42ad95a3c9": {
      "text": "Ave Mari-a...",
      "status": "imported"
    },
    "voice_074:r_0f58a8822381e57f": {
      "text": "Mom always says,\\ndon't blame others!",
      "status": "imported"
    },
    "voice_074:r_6dbcc507fb61b51d": {
      "text": "This li'l mouth\\ncalls people stupid?",
      "status": "imported"
    },
    "voice_074:r_b42ab697149a7c8a": {
      "text": "Now for a spanking!",
      "status": "imported"
    },
    "voice_074:r_4de4fcf3b440baf4": {
      "text": "Hah hah hahahahaha! Hello there!",
      "status": "imported"
    },
    "voice_074:r_0121a166c715cdff": {
      "text": "Got you trapped like a rat!",
      "status": "imported"
    },
    "voice_074:r_30fad37a42bd3ad3": {
      "text": "Disobey me, and this happens!",
      "status": "imported"
    },
    "voice_074:r_80a0b2a84e05d81a": {
      "text": "Poor little lamb, said your prayers?",
      "status": "imported"
    },
    "voice_074:r_4a9ac1dff86506d9": {
      "text": "Now I'll slaughter all of you!",
      "status": "imported"
    },
    "voice_074:r_bc8538e6af3d2577": {
      "text": "Too bad! You there, you're dead!",
      "status": "imported"
    },
    "voice_074:r_924516c8de2b5342": {
      "text": "A fabulous show is about to begin!",
      "status": "imported"
    },
    "voice_074:r_da1174533722333f": {
      "text": "Don't move, or my shots will miss!",
      "status": "imported"
    },
    "voice_074:r_fdeb8162976e72c1": {
      "text": "Good, good! They're getting closer!",
      "status": "imported"
    },
    "voice_074:r_0fadb5c26df92b42": {
      "text": "The head or chest... Which one?",
      "status": "imported"
    },
    "voice_074:r_6b15af9a0057cdc8": {
      "text": "Hah hah hah! I'll riddle you!",
      "status": "imported"
    },
    "voice_074:r_15b4a90140e8a33a": {
      "text": "Nightmares repeat again and again!",
      "status": "imported"
    },
    "voice_074:r_af884a6b11dff121": {
      "text": "Huh? You still want more, baby?",
      "status": "imported"
    },
    "voice_074:r_ac6fe7838e95647b": {
      "text": "Heh heh...\\nAs lovely as they say!",
      "status": "imported"
    },
    "voice_074:r_77ca87eacd17ad52": {
      "text": "Heh heh! Come quietly and be mine!",
      "status": "imported"
    },
    "voice_074:r_bf3244994760e535": {
      "text": "Now for the main event: the hunt!",
      "status": "imported"
    },
    "voice_074:r_aabfb21c9d069ce7": {
      "text": "You worthless reject!!",
      "status": "imported"
    },
    "voice_074:r_02479dc8fe989560": {
      "text": "Show me what Mithril can do!",
      "status": "imported"
    },
    "voice_074:r_a2df00f91a9b0a9e": {
      "text": "Give me your best, Mithril!",
      "status": "imported"
    },
    "voice_074:r_48b60d6c48b9b142": {
      "text": "I've missed you, my sweet Mithril!",
      "status": "imported"
    },
    "voice_074:r_8927e6fb681aa809": {
      "text": "What! It's Bonta-kun!",
      "status": "imported"
    },
    "voice_074:r_665f01666859013b": {
      "text": "So cute!\\nI could have you stuffed!",
      "status": "imported"
    },
    "voice_074:r_a571eec59b258d11": {
      "text": "I must greet the cute captain!",
      "status": "imported"
    },
    "voice_074:r_ddbe581c5ea9183d": {
      "text": "Naughty little Lolita, spotted!",
      "status": "imported"
    },
    "voice_074:r_faae935cca0edc72": {
      "text": "Kittens,\\nno naughty business!",
      "status": "imported"
    },
    "voice_074:r_d4430bf362340b32": {
      "text": "The mighty, sexy\\nLord Gates is here!",
      "status": "imported"
    },
    "voice_074:r_b7b5625d7cd4282f": {
      "text": "All of you!\\nInto Lord Gates's arms!",
      "status": "imported"
    },
    "voice_074:r_920740a0219c5085": {
      "text": "Boss! There's a good kid right here!",
      "status": "imported"
    },
    "voice_074:r_a8451712c57c1a72": {
      "text": "Kids can't play\\nwith toys like this!",
      "status": "imported"
    },
    "voice_074:r_3633df5b7b8f47fa": {
      "text": "Psychic powers don't scare me!\\nHmph!",
      "status": "imported"
    },
    "voice_074:r_52dfc56b14b93551": {
      "text": "Touch the Untouchable!",
      "status": "imported"
    },
    "voice_074:r_1b9b2aab5cb104da": {
      "text": "Yahoo! It's Gundam hunting time!",
      "status": "imported"
    },
    "voice_074:r_342044c706a2340f": {
      "text": "Gundam there! Gundam here!\\nSuch fun!",
      "status": "imported"
    },
    "voice_074:r_cf41e8828a90cbdb": {
      "text": "What!? Did you guys change careers!?",
      "status": "imported"
    },
    "voice_074:r_719e897304ec42d4": {
      "text": "What!\\nA flashy move from terrorism!",
      "status": "imported"
    },
    "voice_074:r_d5e0a2317c40d322": {
      "text": "Super rare! The Black Knights!",
      "status": "imported"
    },
    "voice_074:r_ec2ea17765052401": {
      "text": "Great song! My sideburns tingle!",
      "status": "imported"
    },
    "voice_074:r_f2d4255f1c2f7542": {
      "text": "Tabloid scoop!\\nMr. Triangler, right?",
      "status": "imported"
    },
    "voice_074:r_5d08ad19e2da125b": {
      "text": "Way to go, Japanese salaryman!",
      "status": "imported"
    },
    "voice_074:r_dc8701f6bcb9904f": {
      "text": "Shut up! Shut up!\\nI won't listen!",
      "status": "imported"
    },
    "voice_074:r_41997412868c48c4": {
      "text": "Ahh! The bittersweet scent of youth!",
      "status": "imported"
    },
    "voice_074:r_9e6cf4f389dae55c": {
      "text": "Hey!\\nDon't aim that drill at my ass!",
      "status": "imported"
    },
    "voice_074:r_9e0c80ac7e33b459": {
      "text": "Don't act all high and mighty, EVA!",
      "status": "imported"
    },
    "voice_074:r_7432ef43ed3471dc": {
      "text": "For Gates, size\\nmakes no difference!",
      "status": "imported"
    },
    "voice_074:r_065443f6ddfcf0d7": {
      "text": "Ngh...! I've got a bad feeling!",
      "status": "imported"
    },
    "voice_074:r_47d52a2839c71715": {
      "text": "Aaaaaaagh!!",
      "status": "imported"
    },
    "voice_074:r_847f82e7f3eef651": {
      "text": "You're green!",
      "status": "imported"
    },
    "voice_074:r_eb7ae28b53dc033c": {
      "text": "Be obliterated!",
      "status": "imported"
    },
    "voice_074:r_857c4a52ce8df0fd": {
      "text": "Bwahahah! Ahh, that felt good!",
      "status": "imported"
    },
    "voice_074:r_55417493fce1d347": {
      "text": "Raaaaaagh!!",
      "status": "imported"
    },
    "voice_074:r_8fdf5910927c9591": {
      "text": "You're too slow!",
      "status": "imported"
    },
    "voice_074:r_7d724dbcc4451e10": {
      "text": "Get blown away!",
      "status": "imported"
    },
    "voice_074:r_93e25418a203cb8f": {
      "text": "Gwahahaha! My condolences!",
      "status": "imported"
    },
    "voice_074:r_eb643f8bf737a0ca": {
      "text": "Useless, useless! You can't escape!",
      "status": "imported"
    },
    "voice_074:r_0a3fccb71ec6cf2a": {
      "text": "Punishment time begins now!",
      "status": "imported"
    },
    "voice_074:r_9b63cf1f3e0207ef": {
      "text": "Bottom of the first: Gates attacks!",
      "status": "imported"
    },
    "voice_074:r_8356f4e3dcdff938": {
      "text": "Return each favor,\\nMommy told me.",
      "status": "imported"
    },
    "voice_074:r_1d6d784036ae0bd7": {
      "text": "Here comes the payback!",
      "status": "imported"
    },
    "voice_074:r_625664af02183c17": {
      "text": "Oh my, where are you going, baby?",
      "status": "imported"
    },
    "voice_074:r_3701cba361f80ea5": {
      "text": "You let me counter? How very sweet!",
      "status": "imported"
    },
    "voice_074:r_63f429c5c68c0863": {
      "text": "Heeey! Wait for me!",
      "status": "imported"
    },
    "voice_074:r_38e4a434c91d8ef0": {
      "text": "You're wide open, I tell you!",
      "status": "imported"
    },
    "voice_074:r_98ed411352a3a6ac": {
      "text": "And now, our special guest!",
      "status": "imported"
    },
    "voice_074:r_4824bea6bab3af67": {
      "text": "That was pretty good, Yu Fan!",
      "status": "imported"
    },
    "voice_074:r_862b92e63adb9734": {
      "text": "Well, well! Not bad, Yu Lan!",
      "status": "imported"
    },
    "voice_074:r_cb306ef55e49d107": {
      "text": "Anything less would disappoint me.",
      "status": "imported"
    },
    "voice_074:r_57b2bd2de8a1408d": {
      "text": "Nice attack there, brother!",
      "status": "imported"
    },
    "voice_074:r_76f080a4881e8ab5": {
      "text": "Your follow-through is weak!",
      "status": "imported"
    },
    "voice_074:r_288133bc5b573dae": {
      "text": "Now scram!",
      "status": "imported"
    },
    "voice_074:r_6f95653e548f8fcf": {
      "text": "You'll be punished later!",
      "status": "imported"
    },
    "voice_074:r_d249d68bada91ab9": {
      "text": "Did you get careless, Yu Fan?",
      "status": "imported"
    },
    "voice_074:r_e9b3307e9eb69f11": {
      "text": "No looking away, Yu Lan.",
      "status": "imported"
    },
    "voice_074:r_03cdac73042343ee": {
      "text": "Tch! So much for an executive...",
      "status": "imported"
    },
    "voice_074:r_6026da5acbda7c69": {
      "text": "Brother! I'll rip out that beard!",
      "status": "imported"
    },
    "voice_074:r_981f8fedd5414fe5": {
      "text": "Sheesh! You're always like this!",
      "status": "imported"
    },
    "voice_074:r_96bb0dcde0c8c44a": {
      "text": "Seriously lame...",
      "status": "imported"
    },
    "voice_074:r_641550a2f54cb456": {
      "text": "Huh? What? What's going on?\\nHuuuh!?",
      "status": "imported"
    },
    "voice_074:r_a0f2074af8debbfa": {
      "text": "Unable to attack!? Nobody told me!",
      "status": "imported"
    },
    "voice_074:r_b5f5a97ed82acb0b": {
      "text": "Poor little me is sooo sad...",
      "status": "imported"
    },
    "voice_074:r_d9cd2e4ded064396": {
      "text": "Yes, yes! Always protect your ass!",
      "status": "imported"
    },
    "voice_074:r_99e6349431aaf23b": {
      "text": "Like a stray dog denied its treat!",
      "status": "imported"
    },
    "voice_074:r_ec1081caf845f56a": {
      "text": "Balance matters in everything.",
      "status": "imported"
    },
    "voice_074:r_2c5b7ee872c1ed7f": {
      "text": "Nahahahahahaaa!",
      "status": "imported"
    },
    "voice_074:r_76d1e51c8b494a60": {
      "text": "Thought you outsmarted me,\\nbut no!",
      "status": "imported"
    },
    "voice_074:r_eb5f687fcd372ae7": {
      "text": "Tch, how boring!",
      "status": "imported"
    },
    "voice_074:r_2329428a6871d9fa": {
      "text": "Plan your attacks, you silly thing!",
      "status": "imported"
    },
    "voice_074:r_0e7466971bec4cc4": {
      "text": "Hellooo? Are you even trying?",
      "status": "imported"
    },
    "voice_074:r_efa71f7a4cc33ff3": {
      "text": "What's going on!? That didn't hit!",
      "status": "imported"
    },
    "voice_074:r_3fc2e1186557e7a0": {
      "text": "Oh, sorry! I dodged it!",
      "status": "imported"
    },
    "voice_074:r_fa6930340a545054": {
      "text": "Oh? Are you all show, no substance?",
      "status": "imported"
    },
    "voice_074:r_2332b9d56461d7ab": {
      "text": "Lambda Driver:\\nyou can't master it.",
      "status": "imported"
    },
    "voice_074:r_854aa0a91a3c80d1": {
      "text": "Mithril dear, are you even trying?",
      "status": "imported"
    },
    "voice_074:r_0bc8ae32a406ceab": {
      "text": "Weak, too weak!\\nWhat's up, Mithril!?",
      "status": "imported"
    },
    "voice_074:r_d520c6d5298a848d": {
      "text": "Heh! Too bad for you!",
      "status": "imported"
    },
    "voice_074:r_099e2458cabf796f": {
      "text": "I can do this too, you know!",
      "status": "imported"
    },
    "voice_074:r_fd910d714be70870": {
      "text": "Well, naturally.",
      "status": "imported"
    },
    "voice_074:r_494b5da92ed24ecb": {
      "text": "All systems are operating normally.",
      "status": "imported"
    },
    "voice_074:r_a4a5a96f4bd58920": {
      "text": "As expected, that's all you've got.",
      "status": "imported"
    },
    "voice_074:r_b57d2d74233f889a": {
      "text": "No, no! No looking away.",
      "status": "imported"
    },
    "voice_074:r_cd06d0820d82524b": {
      "text": "Hmm, my sideburns aren't reacting.",
      "status": "imported"
    },
    "voice_074:r_c94c6d04be583774": {
      "text": "Gwah! I bumped my forehead!",
      "status": "imported"
    },
    "voice_074:r_e54e2c99ef8297af": {
      "text": "Hmm? Low on energy?\\nWhat's wrong?",
      "status": "imported"
    },
    "voice_074:r_f16a3eb0bcaac082": {
      "text": "Come at me with all you've got!",
      "status": "imported"
    },
    "voice_074:r_10a408809e512df1": {
      "text": "Not bad. A little, anyway.",
      "status": "imported"
    },
    "voice_074:r_bc7b9e308b879dd4": {
      "text": "Can't concede\\nany more points...!",
      "status": "imported"
    },
    "voice_074:r_98902fd3143c393e": {
      "text": "Regret failing to finish me off!",
      "status": "imported"
    },
    "voice_074:r_d907fbd7bc1c4298": {
      "text": "Soft, soft...!\\nNot nearly enough!",
      "status": "imported"
    },
    "voice_074:r_96b21e3a028dd074": {
      "text": "This won't\\nsatisfy me at all!",
      "status": "imported"
    },
    "voice_074:r_ce140b5d8e6b7310": {
      "text": "Oh, come on! What's with this world?",
      "status": "imported"
    },
    "voice_074:r_0e0335789c5396d7": {
      "text": "Impossible! Who is that...!?",
      "status": "imported"
    },
    "voice_074:r_a8e85bd950696403": {
      "text": "Ngh!\\nWasn't that one defective!?",
      "status": "imported"
    },
    "voice_074:r_772c8bc40ab6cb61": {
      "text": "Mithril...! You keep me entertained!",
      "status": "imported"
    },
    "voice_074:r_58dd2826a199ef51": {
      "text": "You came prepared to counter me...!",
      "status": "imported"
    },
    "voice_074:r_aadc0b2442adb93b": {
      "text": "Ngh! Attacking me with brute force!",
      "status": "imported"
    },
    "voice_074:r_e7a8cd8ed5bc2d1b": {
      "text": "This is why I hate Super Robots!",
      "status": "imported"
    },
    "voice_074:r_041dd920da4a7c17": {
      "text": "Enough already, Gundam!",
      "status": "imported"
    },
    "voice_074:r_c7f4280cde4605b3": {
      "text": "Come on!\\nGundam runs wild unchecked!",
      "status": "imported"
    },
    "voice_074:r_ec349c8ea9511a18": {
      "text": "Hey!\\nThat was over the speed limit!",
      "status": "imported"
    },
    "voice_074:r_33236ffa3ea95b68": {
      "text": "No, no!\\nThe Untouchable is tough!",
      "status": "imported"
    },
    "voice_074:r_689d0b123de71ae0": {
      "text": "Nfuh! Not bad, Black Knights!",
      "status": "imported"
    },
    "voice_074:r_d8c669c70659e18a": {
      "text": "Ohhh, come on!",
      "status": "imported"
    },
    "voice_074:r_8f5bade7ac2db78e": {
      "text": "So I'm the rat in the trap!?",
      "status": "imported"
    },
    "voice_074:r_05ea490d2f522520": {
      "text": "You miserable bastard!!",
      "status": "imported"
    },
    "voice_074:r_f5658c702d91db7a": {
      "text": "Lies! Lies! Lies! What the hell!?",
      "status": "imported"
    },
    "voice_074:r_686df329b50f195b": {
      "text": "This puts me in a real bind!",
      "status": "imported"
    },
    "voice_074:r_25f0ab0fa3cf690c": {
      "text": "Oh no! My sideburns are reacting!",
      "status": "imported"
    },
    "voice_074:r_b708a1d959013dbf": {
      "text": "Back!\\nBack! Back! Back! Back!!",
      "status": "imported"
    },
    "voice_074:r_59fca03e929366c1": {
      "text": "Gates in peril!\\nNow, epic comeback!",
      "status": "imported"
    },
    "voice_074:r_0d65eb631dcb7514": {
      "text": "Shorter sideburns,\\nand I'd be dead!",
      "status": "imported"
    },
    "voice_074:r_d03018a31e23f1e9": {
      "text": "Hmph!\\nI'm not the least bit upset!",
      "status": "imported"
    },
    "voice_074:r_279da5f732aa8847": {
      "text": "I'm not upset!\\nRemember this!",
      "status": "imported"
    },
    "voice_074:r_97f82e3cb6f70110": {
      "text": "Balance...",
      "status": "imported"
    },
    "voice_074:r_c5611d8dd6def96b": {
      "text": "Balance is key in games and in life.",
      "status": "imported"
    },
    "voice_074:r_6f12cc8ed2732eb5": {
      "text": "Too much is bad! I mean, baaad!",
      "status": "imported"
    },
    "voice_074:r_7abfc55f8fb62ba7": {
      "text": "Ignore advice and overdo it: see?",
      "status": "imported"
    },
    "voice_074:r_99e7a66c650b5892": {
      "text": "Prof. Gates 101! See you next week!",
      "status": "imported"
    },
    "voice_074:r_9639a2dbcd2f58ed": {
      "text": "Phew... Was that a bit too short...?",
      "status": "imported"
    },
    "voice_074:r_aeea0893acb93d35": {
      "text": "I think I'll help myself first!",
      "status": "imported"
    },
    "voice_074:r_b31568654e53487b": {
      "text": "The warm-up won't satisfy me...!",
      "status": "imported"
    },
    "voice_074:r_2502132569141ea3": {
      "text": "I'll go all out, even just to stall!",
      "status": "imported"
    },
    "voice_074:r_1ff312798a52c8eb": {
