{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_080:r_479b340ccc6c572b": {
      "text": "Prepare yourself!",
      "status": "imported"
    },
    "voice_080:r_ca4acbac57a2a35e": {
      "text": "Get out of my way!",
      "status": "imported"
    },
    "voice_080:r_77949221bf58f862": {
      "text": "You're not getting away!",
      "status": "imported"
    },
    "voice_080:r_70b9c4b9f1f37eff": {
      "text": "I can fight too!",
      "status": "imported"
    },
    "voice_080:r_9fcb3754cb1773c7": {
      "text": "Every foe has a weakness!\\nAim there!",
      "status": "imported"
    },
    "voice_080:r_3559d2fad32c2435": {
      "text": "Sayaka here! Commencing attack!",
      "status": "imported"
    },
    "voice_080:r_f7570547e9f80a64": {
      "text": "I won't let you destroy Atami!",
      "status": "imported"
    },
    "voice_080:r_b42ab697149a7c8a": {
      "text": "It's too late to notice now!",
      "status": "imported"
    },
    "voice_080:r_4de4fcf3b440baf4": {
      "text": "Mechabeast!\\nYou won't have your way!",
      "status": "imported"
    },
    "voice_080:r_0121a166c715cdff": {
      "text": "You're here, Mechabeast! Face me!",
      "status": "imported"
    },
    "voice_080:r_30fad37a42bd3ad3": {
      "text": "Ugh... I'm no good against these...!",
      "status": "imported"
    },
    "voice_080:r_4a9ac1dff86506d9": {
      "text": "They may be tough,\\nbut I won't lose!",
      "status": "imported"
    },
    "voice_080:r_bc8538e6af3d2577": {
      "text": "Commander or not, I'll take them on!",
      "status": "imported"
    },
    "voice_080:r_77ca87eacd17ad52": {
      "text": "You'll pay for that!",
      "status": "imported"
    },
    "voice_080:r_bf3244994760e535": {
      "text": "I won't just take this lying down!",
      "status": "imported"
    },
    "voice_080:r_aabfb21c9d069ce7": {
      "text": "Now it's my turn!",
      "status": "imported"
    },
    "voice_080:r_02479dc8fe989560": {
      "text": "I can't win by just defending!",
      "status": "imported"
    },
    "voice_080:r_a2df00f91a9b0a9e": {
      "text": "An opening! I won't miss it!",
      "status": "imported"
    },
    "voice_080:r_48b60d6c48b9b142": {
      "text": "If one can't beat them,\\ntwo can...!",
      "status": "imported"
    },
    "voice_080:r_8927e6fb681aa809": {
      "text": "Sayaka here! I'll back you up!",
      "status": "imported"
    },
    "voice_080:r_665f01666859013b": {
      "text": "Kouji! Leave the support to me!",
      "status": "imported"
    },
    "voice_080:r_ddbe581c5ea9183d": {
      "text": "I won't let you!",
      "status": "imported"
    },
    "voice_080:r_faae935cca0edc72": {
      "text": "I'll move up! Fall back while I do!",
      "status": "imported"
    },
    "voice_080:r_d4430bf362340b32": {
      "text": "I'll save Mazinger... and Kouji!",
      "status": "imported"
    },
    "voice_080:r_6ff1323b355593e0": {
      "text": "At this rate,\\nI'm a sitting duck!",
      "status": "imported"
    },
    "voice_080:r_b7b5625d7cd4282f": {
      "text": "Just because I can't fight back...!",
      "status": "imported"
    },
    "voice_080:r_a8451712c57c1a72": {
      "text": "I need to fall back and resupply...!",
      "status": "imported"
    },
    "voice_080:r_3633df5b7b8f47fa": {
      "text": "What?! They attacked from there?!",
      "status": "imported"
    },
    "voice_080:r_52dfc56b14b93551": {
      "text": "Where do you think you're aiming?",
      "status": "imported"
    },
    "voice_080:r_1b9b2aab5cb104da": {
      "text": "How do you like that!",
      "status": "imported"
    },
    "voice_080:r_342044c706a2340f": {
      "text": "I could see that coming!",
      "status": "imported"
    },
    "voice_080:r_cf41e8828a90cbdb": {
      "text": "Eek! That was dangerous!",
      "status": "imported"
    },
    "voice_080:r_719e897304ec42d4": {
      "text": "Don't underestimate me for a woman!",
      "status": "imported"
    },
    "voice_080:r_d5e0a2317c40d322": {
      "text": "So this is all a Mechabeast can do!",
      "status": "imported"
    },
    "voice_080:r_ec2ea17765052401": {
      "text": "Too bad!\\nI've got a barrier too!",
      "status": "imported"
    },
    "voice_080:r_f2d4255f1c2f7542": {
      "text": "Thanks, Father...!\\nSayaka is safe!",
      "status": "imported"
    },
    "voice_080:r_a7246b52782a877e": {
      "text": "Oww! How dare you do that!",
      "status": "imported"
    },
    "voice_080:r_dc8701f6bcb9904f": {
      "text": "What?! That actually hit me?!",
      "status": "imported"
    },
    "voice_080:r_d6bdd730f24f66eb": {
      "text": "I can't worry about this scratch!",
      "status": "imported"
    },
    "voice_080:r_41997412868c48c4": {
      "text": "That won't work on an Alloy Z body!",
      "status": "imported"
    },
    "voice_080:r_9e6cf4f389dae55c": {
      "text": "This much is nothing!",
      "status": "imported"
    },
    "voice_080:r_9e0c80ac7e33b459": {
      "text": "Eek! That hurt!",
      "status": "imported"
    },
    "voice_080:r_065443f6ddfcf0d7": {
      "text": "No...! Alloy Z failed so easily...!",
      "status": "imported"
    },
    "voice_080:r_47d52a2839c71715": {
      "text": "Ugh...! This one's tough!",
      "status": "imported"
    },
    "voice_080:r_847f82e7f3eef651": {
      "text": "Think that attack can make me quit?!",
      "status": "imported"
    },
    "voice_080:r_eb7ae28b53dc033c": {
      "text": "What was that just now?!",
      "status": "imported"
    },
    "voice_080:r_857c4a52ce8df0fd": {
      "text": "Aah!\\nAt this rate, they'll get me!",
      "status": "imported"
    },
    "voice_080:r_55417493fce1d347": {
      "text": "I'm okay!\\nI can fight through this!",
      "status": "imported"
    },
    "voice_080:r_8fdf5910927c9591": {
      "text": "Ugh! This is a Mechabeast's power!",
      "status": "imported"
    },
    "voice_080:r_7d724dbcc4451e10": {
      "text": "Moves like a robot?!\\nA true beast!",
      "status": "imported"
    },
    "voice_080:r_24cf161287ef9d5c": {
      "text": "No matter the pain,\\nI won't whine!",
      "status": "imported"
    },
    "voice_080:r_8f60f6fc86db3107": {
      "text": "I can't afford\\nto be a burden...!",
      "status": "imported"
    },
    "voice_080:r_b1de76a75a253c13": {
      "text": "Not yet... I haven't lost yet!",
      "status": "imported"
    },
    "voice_080:r_128c35bf3e0e394c": {
      "text": "No! I can't hold out any longer!",
      "status": "imported"
    },
    "voice_080:r_5213c17e13b23de0": {
      "text": "The Alloy Z body is falling apart!",
      "status": "imported"
    },
    "voice_080:r_38fdff9483e9245c": {
      "text": "Aaaaaah!",
      "status": "imported"
    },
    "voice_080:r_620fedec67706d7d": {
      "text": "It's over...! I can't go on!",
      "status": "imported"
    },
    "voice_080:r_9680dcd0fddcfcc7": {
      "text": "I'm sorry... Father...",
      "status": "imported"
    },
    "voice_080:r_2a00f1044ad5cbaa": {
      "text": "Got you, Kouji! Skipping training?!",
      "status": "imported"
    },
    "voice_080:r_3dbeead1bd3164ef": {
      "text": "Fine, then... but I'm playing too.",
      "status": "imported"
    },
    "voice_080:r_98d15b8cc09bc915": {
      "text": "No way...!",
      "status": "imported"
    },
    "voice_080:r_46e86d000250e137": {
      "text": "Let's go, Venus A!",
      "status": "imported"
    },
    "voice_080:r_ac341e7976e88f0b": {
      "text": "Venus A, reporting for duty!",
      "status": "imported"
    },
    "voice_080:r_cdbd128a5b4127cc": {
      "text": "Venus A was\\nbuilt as a combat robot!",
      "status": "imported"
    },
    "voice_080:r_cfccaa1fbeda124c": {
      "text": "Count Brocken!\\nFight honorably!",
      "status": "imported"
    },
    "voice_080:r_3304412ac41f47a6": {
      "text": "Now for payback! Venus A!",
      "status": "imported"
    },
    "voice_080:r_0c0775e051211840": {
      "text": "I'll show you Z's cutting edge!",
      "status": "imported"
    },
    "voice_080:r_a2afffe1c396f0b3": {
      "text": "Don't blame me if you're cut in two!",
      "status": "imported"
    },
    "voice_080:r_13c25fbdfddc8a24": {
      "text": "Photon Beam!",
      "status": "imported"
    },
    "voice_080:r_42ba1ecb310b4bd7": {
      "text": "Photon Beam!!",
      "status": "imported"
    },
    "voice_080:r_d692f1d420460a47": {
      "text": "Go! Mazinger Corps All-Out Attack!",
      "status": "imported"
    },
    "voice_080:r_a5643cec86b18bd2": {
      "text": "Million Alpha!",
      "status": "imported"
    },
    "voice_080:r_68f2dfab20a4a30e": {
      "text": "Baion Beta!",
      "status": "imported"
    },
    "voice_080:r_9cedad8237480563": {
      "text": "Daion Gamma!",
      "status": "imported"
    },
    "voice_080:r_a03fabecba1508ca": {
      "text": "My turn!",
      "status": "imported"
    },
    "voice_080:r_5391b24a71eb10ae": {
      "text": "Now!\\nWitness our Mazinger power!",
      "status": "imported"
    },
    "voice_080:r_a554ceef5c87b972": {
      "text": "Million Alpha One!",
      "status": "imported"
    },
    "voice_080:r_546c3d5937fbb7ee": {
      "text": "Baion Beta Two!",
      "status": "imported"
    },
    "voice_080:r_1568ff6298b12b96": {
      "text": "Daion Gamma Three!",
      "status": "imported"
    },
    "voice_080:r_2c9d94ba13c5fc50": {
      "text": "I'll finish this!",
      "status": "imported"
    },
    "voice_080:r_a77f4913375098d2": {
      "text": "Everyone! I'm counting on you!",
      "status": "imported"
    },
    "voice_080:r_428c2116ac3071b1": {
      "text": "Rolly! Roll!",
      "status": "imported"
    },
    "voice_080:r_84c116267b79f540": {
      "text": "Higashi!",
      "status": "imported"
    },
    "voice_080:r_dad38ee29af2df3a": {
      "text": "Ooide!",
      "status": "imported"
    },
    "voice_080:r_3d32e86f8dc80909": {
      "text": "This will finish you!",
      "status": "imported"
    },
    "voice_080:r_70451ffbabe2f876": {
      "text": "As I thought,\\nBorot alone won't do!",
      "status": "imported"
    },
    "voice_080:r_69dfa1659715e2fa": {
      "text": "No way!\\nBorot can't take that!",
      "status": "imported"
    },
    "voice_080:r_d996fd6d4ef5b329": {
      "text": "Oh?\\nWere you dazzled by Venus A?",
      "status": "imported"
    },
    "voice_080:r_8ab47a28f99ef565": {
      "text": "Eek! Venus A's porcelain skin!",
      "status": "imported"
    },
    "voice_080:r_546de3fb6db156ea": {
      "text": "Oh no! The enemy's still moving!",
      "status": "imported"
    },
    "voice_080:r_ca85f87cee5e31f7": {
      "text": "Keep your eyes on the fight!",
      "status": "imported"
    },
    "voice_080:r_9072ea7bc71df136": {
      "text": "You're wide open!",
      "status": "imported"
    },
    "voice_080:r_04e815a8d425827d": {
      "text": "Like I'd let that attack hit me!",
      "status": "imported"
    },
    "voice_080:r_d89011fe3e5d082a": {
      "text": "I'll keep them in check!",
      "status": "imported"
    },
    "voice_080:r_3c5b0c2ac812d5de": {
      "text": "Together, we can beat anyone...!",
      "status": "imported"
    },
    "voice_080:r_5b9e8897190892eb": {
      "text": "So you're my opponent!",
      "status": "imported"
    },
    "voice_080:r_7bea3023abbf8a94": {
      "text": "I can't afford to lose either!",
      "status": "imported"
    }
  }
}
