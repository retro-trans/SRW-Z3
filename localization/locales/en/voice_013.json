{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_013:r_479b340ccc6c572b": {
      "text": "Ha! What a weak-looking enemy!",
      "status": "imported"
    },
    "voice_013:r_ca4acbac57a2a35e": {
      "text": "I'm special... I've got to deliver!",
      "status": "imported"
    },
    "voice_013:r_77949221bf58f862": {
      "text": "Asuka, are you ready?",
      "status": "imported"
    },
    "voice_013:r_70b9c4b9f1f37eff": {
      "text": "Leave it to me!",
      "status": "imported"
    },
    "voice_013:r_9fcb3754cb1773c7": {
      "text": "I'm counting on you, Asuka.",
      "status": "imported"
    },
    "voice_013:r_3559d2fad32c2435": {
      "text": "You don't have to tell me!",
      "status": "imported"
    },
    "voice_013:r_f7570547e9f80a64": {
      "text": "Out of my way!",
      "status": "imported"
    },
    "voice_013:r_cbab0f4720e1fcf1": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_013:r_0bbe0b4f5364e732": {
      "text": "Got you!",
      "status": "imported"
    },
    "voice_013:r_5dda5198137cb02a": {
      "text": "Just give up already!",
      "status": "imported"
    },
    "voice_013:r_83ec59afbecdec14": {
      "text": "So primitive. What an idiot!",
      "status": "imported"
    },
    "voice_013:r_e20bfd42ad95a3c9": {
      "text": "What is this thing?! It's so gross!",
      "status": "imported"
    },
    "voice_013:r_0f58a8822381e57f": {
      "text": "Asuka, make a miracle,\\nby our will!",
      "status": "imported"
    },
    "voice_013:r_6dbcc507fb61b51d": {
      "text": "I know, Misato.",
      "status": "imported"
    },
    "voice_013:r_b42ab697149a7c8a": {
      "text": "You won't get off scot-free!",
      "status": "imported"
    },
    "voice_013:r_4de4fcf3b440baf4": {
      "text": "Eat thiiis!!",
      "status": "imported"
    },
    "voice_013:r_0121a166c715cdff": {
      "text": "Goooo!!",
      "status": "imported"
    },
    "voice_013:r_30fad37a42bd3ad3": {
      "text": "Prepare yourself!",
      "status": "imported"
    },
    "voice_013:r_80a0b2a84e05d81a": {
      "text": "Taaah!",
      "status": "imported"
    },
    "voice_013:r_4a9ac1dff86506d9": {
      "text": "Oraaaah!",
      "status": "imported"
    },
    "voice_013:r_bc8538e6af3d2577": {
      "text": "I swear I'll hit you!",
      "status": "imported"
    },
    "voice_013:r_fdeb8162976e72c1": {
      "text": "Come on, hit!!",
      "status": "imported"
    },
    "voice_013:r_0fadb5c26df92b42": {
      "text": "Don't you move!",
      "status": "imported"
    },
    "voice_013:r_6b15af9a0057cdc8": {
      "text": "Dei!",
      "status": "imported"
    },
    "voice_013:r_15b4a90140e8a33a": {
      "text": "Hup!",
      "status": "imported"
    },
    "voice_013:r_77ca87eacd17ad52": {
      "text": "Goooot you!",
      "status": "imported"
    },
    "voice_013:r_02479dc8fe989560": {
      "text": "Hah!",
      "status": "imported"
    },
    "voice_013:r_a2df00f91a9b0a9e": {
      "text": "You little...!!",
      "status": "imported"
    },
    "voice_013:r_48b60d6c48b9b142": {
      "text": "Hyaaaaaah!",
      "status": "imported"
    },
    "voice_013:r_8927e6fb681aa809": {
      "text": "Doryaaaaah!",
      "status": "imported"
    },
    "voice_013:r_3633df5b7b8f47fa": {
      "text": "I'm not letting you escape!",
      "status": "imported"
    },
    "voice_013:r_52dfc56b14b93551": {
      "text": "You're naive to let me counter!",
      "status": "imported"
    },
    "voice_013:r_1b9b2aab5cb104da": {
      "text": "Guess it's an elite's duty!",
      "status": "imported"
    },
    "voice_013:r_342044c706a2340f": {
      "text": "Totally oblivious and unguarded!",
      "status": "imported"
    },
    "voice_013:r_cf41e8828a90cbdb": {
      "text": "Ugh! Stupid Shinji!",
      "status": "imported"
    },
    "voice_013:r_719e897304ec42d4": {
      "text": "Ugh, this is so irritating!",
      "status": "imported"
    },
    "voice_013:r_d5e0a2317c40d322": {
      "text": "Just as expected!",
      "status": "imported"
    },
    "voice_013:r_ec2ea17765052401": {
      "text": "Like that could ever hit me!",
      "status": "imported"
    },
    "voice_013:r_f2d4255f1c2f7542": {
      "text": "Ha! What a sloppy attack!",
      "status": "imported"
    },
    "voice_013:r_5d08ad19e2da125b": {
      "text": "Oh, what a boring attack!",
      "status": "imported"
    },
    "voice_013:r_a7246b52782a877e": {
      "text": "There! Misato, did you see that?",
      "status": "imported"
    },
    "voice_013:r_dc8701f6bcb9904f": {
      "text": "Sorry, I got a little distracted.",
      "status": "imported"
    },
    "voice_013:r_d6bdd730f24f66eb": {
      "text": "Jeez!",
      "status": "imported"
    },
    "voice_013:r_41997412868c48c4": {
      "text": "You always deliver, Asuka!",
      "status": "imported"
    },
    "voice_013:r_9e6cf4f389dae55c": {
      "text": "Of course!",
      "status": "imported"
    },
    "voice_013:r_9e0c80ac7e33b459": {
      "text": "It's no use!",
      "status": "imported"
    },
    "voice_013:r_065443f6ddfcf0d7": {
      "text": "Hmph, what an idiot!",
      "status": "imported"
    },
    "voice_013:r_47d52a2839c71715": {
      "text": "What a disgrace!",
      "status": "imported"
    },
    "voice_013:r_847f82e7f3eef651": {
      "text": "Oh? That's rare for you, Asuka.",
      "status": "imported"
    },
    "voice_013:r_eb7ae28b53dc033c": {
      "text": "Oh, shut up! It was an accident!",
      "status": "imported"
    },
    "voice_013:r_857c4a52ce8df0fd": {
      "text": "Ghh...! You're so irritating!",
      "status": "imported"
    },
    "voice_013:r_55417493fce1d347": {
      "text": "Now we're talking!",
      "status": "imported"
    },
    "voice_013:r_8fdf5910927c9591": {
      "text": "Ugh! What is with this thing?!",
      "status": "imported"
    },
    "voice_013:r_7d724dbcc4451e10": {
      "text": "They've pushed Asuka this far...!",
      "status": "imported"
    },
    "voice_013:r_93e25418a203cb8f": {
      "text": "Ghh! If I lose, then I...!",
      "status": "imported"
    },
    "voice_013:r_adeb0a29274d3d9b": {
      "text": "Asuka, retreat!",
      "status": "imported"
    },
    "voice_013:r_24cf161287ef9d5c": {
      "text": "No! I absolutely refuse to retreat!",
      "status": "imported"
    },
    "voice_013:r_8f60f6fc86db3107": {
      "text": "Kyaaaaaah!!",
      "status": "imported"
    },
    "voice_013:r_b1de76a75a253c13": {
      "text": "See ya!",
      "status": "imported"
    },
    "voice_013:r_128c35bf3e0e394c": {
      "text": "You're no match for Unit-02!",
      "status": "imported"
    },
    "voice_013:r_5213c17e13b23de0": {
      "text": "This... is the end!",
      "status": "imported"
    },
    "voice_013:r_38fdff9483e9245c": {
      "text": "I'll end this right away!",
      "status": "imported"
    },
    "voice_013:r_620fedec67706d7d": {
      "text": "I can see right through you!",
      "status": "imported"
    },
    "voice_013:r_9680dcd0fddcfcc7": {
      "text": "You're in my way!",
      "status": "imported"
    },
    "voice_013:r_2a00f1044ad5cbaa": {
      "text": "I'll show you Unit-02's power!!",
      "status": "imported"
    },
    "voice_013:r_3dbeead1bd3164ef": {
      "text": "Don't underestimate me!!",
      "status": "imported"
    },
    "voice_013:r_98d15b8cc09bc915": {
      "text": "All right, let's do this!",
      "status": "imported"
    },
    "voice_013:r_46e86d000250e137": {
      "text": "Your moves,\\nI see through them!",
      "status": "imported"
    },
    "voice_013:r_ac341e7976e88f0b": {
      "text": "Stay out of my way!",
      "status": "imported"
    },
    "voice_013:r_cfccaa1fbeda124c": {
      "text": "Why, youuu!!",
      "status": "imported"
    },
    "voice_013:r_ddafde4b065ced49": {
      "text": "Let's finish you off completely!",
      "status": "imported"
    },
    "voice_013:r_de1213040856c089": {
      "text": "Don't move from that spot!",
      "status": "imported"
    },
    "voice_013:r_3304412ac41f47a6": {
      "text": "You've got some nerve!",
      "status": "imported"
    },
    "voice_013:r_0c0775e051211840": {
      "text": "This is where you end too!",
      "status": "imported"
    },
    "voice_013:r_a2afffe1c396f0b3": {
      "text": "You just wait!",
      "status": "imported"
    },
    "voice_013:r_13c25fbdfddc8a24": {
      "text": "Move, move! Out of my way!",
      "status": "imported"
    },
    "voice_013:r_42ba1ecb310b4bd7": {
      "text": "The great Asuka will handle this.",
      "status": "imported"
    },
    "voice_013:r_d692f1d420460a47": {
      "text": "I've got this!",
      "status": "imported"
    },
    "voice_013:r_a5643cec86b18bd2": {
      "text": "Oh, fine...\\nI'll cover our allies!",
      "status": "imported"
    },
    "voice_013:r_68f2dfab20a4a30e": {
      "text": "Stupid Shinji!\\nYou owe me for this!",
      "status": "imported"
    },
    "voice_013:r_9cedad8237480563": {
      "text": "You'd better show some gratitude!",
      "status": "imported"
    },
    "voice_013:r_a03fabecba1508ca": {
      "text": "I'm going on ahead!!",
      "status": "imported"
    },
    "voice_013:r_5391b24a71eb10ae": {
      "text": "Waiting around isn't my style!",
      "status": "imported"
    },
    "voice_013:r_a554ceef5c87b972": {
      "text": "Roger!",
      "status": "imported"
    },
    "voice_013:r_546c3d5937fbb7ee": {
      "text": "I got it!",
      "status": "imported"
    },
    "voice_013:r_1568ff6298b12b96": {
      "text": "W-What?! It doesn't reach!",
      "status": "imported"
    },
    "voice_013:r_2c9d94ba13c5fc50": {
      "text": "Hmph! What are you even doing?!",
      "status": "imported"
    },
    "voice_013:r_a77f4913375098d2": {
      "text": "Hmph. Right where I wanted you.",
      "status": "imported"
    },
    "voice_013:r_428c2116ac3071b1": {
      "text": "Hmph! Where are you even aiming?!",
      "status": "imported"
    },
    "voice_013:r_84c116267b79f540": {
      "text": "As if that attack could hit me!!",
      "status": "imported"
    },
    "voice_013:r_dad38ee29af2df3a": {
      "text": "Like that'd ever hit me!",
      "status": "imported"
    },
    "voice_013:r_3d32e86f8dc80909": {
      "text": "What are you doing?!",
      "status": "imported"
    },
    "voice_013:r_70451ffbabe2f876": {
      "text": "Honestly, what a dull attack.",
      "status": "imported"
    },
    "voice_013:r_69dfa1659715e2fa": {
      "text": "Yawn... What a boring loser!",
      "status": "imported"
    },
    "voice_013:r_d996fd6d4ef5b329": {
      "text": "Hah! Like that would work!!",
      "status": "imported"
    },
    "voice_013:r_8ab47a28f99ef565": {
      "text": "Idiot! Like that could work!!",
      "status": "imported"
    },
    "voice_013:r_546de3fb6db156ea": {
      "text": "Are you stupid?!",
      "status": "imported"
    },
    "voice_013:r_d89011fe3e5d082a": {
      "text": "AT Field, deploy!",
      "status": "imported"
    },
    "voice_013:r_3c5b0c2ac812d5de": {
      "text": "What was that pathetic attack?!",
      "status": "imported"
    },
    "voice_013:r_5b9e8897190892eb": {
      "text": "Are you even trying?!",
      "status": "imported"
    },
    "voice_013:r_7bea3023abbf8a94": {
      "text": "That hit me?!",
      "status": "imported"
    },
    "voice_013:r_dd01a4c0d1b36a8d": {
      "text": "That didn't even graze me!",
      "status": "imported"
    },
    "voice_013:r_20920ad2eb3542db": {
      "text": "As long as it's not a direct hit!",
      "status": "imported"
    },
    "voice_013:r_cb846feec748c2e3": {
      "text": "Hmph. It's only their numbers.",
      "status": "imported"
    },
    "voice_013:r_c958860b0676b1f5": {
      "text": "I-I won't go down from this!!",
      "status": "imported"
    },
    "voice_013:r_5e2669b82ef75ce3": {
      "text": "Uagh!?",
      "status": "imported"
    },
    "voice_013:r_7847e0ed7dc9282d": {
      "text": "Ghh! Not bad,\\nyou made this fun!",
      "status": "imported"
    },
    "voice_013:r_e42b52c7a987b906": {
      "text": "This is only the beginning!",
      "status": "imported"
    },
    "voice_013:r_6825fd1ff907bd22": {
      "text": "Ugh!?\\nPulling a stunt like that...!",
      "status": "imported"
    },
    "voice_013:r_607f666f1563bc0d": {
      "text": "Ghh! Not yet, not yet!!",
      "status": "imported"
    },
    "voice_013:r_97b7431eeb81e6b6": {
      "text": "I-I refuse to go down!!",
      "status": "imported"
    },
    "voice_013:r_132f605d02975e71": {
      "text": "Kyaaah! W-What was that?!",
      "status": "imported"
    },
    "voice_013:r_9b9726b1872759d6": {
      "text": "Ghh! You'll pay for this!!",
      "status": "imported"
    },
    "voice_013:r_1252db29683fefe0": {
      "text": "How dare you do that to me!!",
      "status": "imported"
    },
    "voice_013:r_ad3d538f1e909184": {
      "text": "Y-You've got to be kidding me!!",
      "status": "imported"
    },
    "voice_013:r_aba6a7662129d8ce": {
      "text": "N-No way!?",
      "status": "imported"
    },
    "voice_013:r_b84afafb8a33ec60": {
      "text": "Stay out of this, rookie!",
      "status": "imported"
    },
    "voice_013:r_381992c5d8224937": {
      "text": "That stupid look annoys me!",
      "status": "imported"
    },
    "voice_013:r_b765659981b6516d": {
      "text": "I have to fight this loser?",
      "status": "imported"
    },
    "voice_013:r_7d2617c809fead70": {
      "text": "That enemy's a piece of cake!",
      "status": "imported"
    },
    "voice_013:r_fa96676cc65bb509": {
      "text": "I'll finish this with one blow!",
      "status": "imported"
    },
    "voice_013:r_66ab4cfe1557909d": {
      "text": "Take that! Take that!",
      "status": "imported"
    },
    "voice_013:r_6c13bbfd27a7799e": {
      "text": "Oryaaaaah!",
      "status": "imported"
    },
    "voice_013:r_06f88dcbd3c9e738": {
      "text": "One moooore!",
      "status": "imported"
    },
    "voice_013:r_7e6c573c26177f98": {
      "text": "Uoryaaaaah!!",
      "status": "imported"
    }
  }
}
