{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_099:r_479b340ccc6c572b": {
      "text": "I shall deliver divine judgment!",
      "status": "imported"
    },
    "voice_099:r_ca4acbac57a2a35e": {
      "text": "I, Zeus, show my foes no mercy!",
      "status": "imported"
    },
    "voice_099:r_77949221bf58f862": {
      "text": "That wicked heart ends here!",
      "status": "imported"
    },
    "voice_099:r_70b9c4b9f1f37eff": {
      "text": "I will not forgive your tyranny!",
      "status": "imported"
    },
    "voice_099:r_9fcb3754cb1773c7": {
      "text": "Branded traitor,\\nI guard this world!",
      "status": "imported"
    },
    "voice_099:r_3559d2fad32c2435": {
      "text": "This! This!\\nA god who left Mycenae!",
      "status": "imported"
    },
    "voice_099:r_f7570547e9f80a64": {
      "text": "Let us settle this, Hades!",
      "status": "imported"
    },
    "voice_099:r_b42ab697149a7c8a": {
      "text": "My wrath shall pierce you!",
      "status": "imported"
    },
    "voice_099:r_4de4fcf3b440baf4": {
      "text": "Face my blade of wrath!",
      "status": "imported"
    },
    "voice_099:r_0121a166c715cdff": {
      "text": "Uoooooh!",
      "status": "imported"
    },
    "voice_099:r_30fad37a42bd3ad3": {
      "text": "Receive your just deserts!",
      "status": "imported"
    },
    "voice_099:r_80a0b2a84e05d81a": {
      "text": "Consider this repayment!",
      "status": "imported"
    },
    "voice_099:r_4a9ac1dff86506d9": {
      "text": "Face divine wrath!",
      "status": "imported"
    },
    "voice_099:r_bc8538e6af3d2577": {
      "text": "Then I shall join you!",
      "status": "imported"
    },
    "voice_099:r_924516c8de2b5342": {
      "text": "Allow me to lend a hand!",
      "status": "imported"
    },
    "voice_099:r_da1174533722333f": {
      "text": "Wielder of divine power, join me!",
      "status": "imported"
    },
    "voice_099:r_fdeb8162976e72c1": {
      "text": "Bearer of endless futures, I follow!",
      "status": "imported"
    },
    "voice_099:r_0fadb5c26df92b42": {
      "text": "I will not allow it!",
      "status": "imported"
    },
    "voice_099:r_6b15af9a0057cdc8": {
      "text": "I, Zeus, shall take that blow!",
      "status": "imported"
    },
    "voice_099:r_15b4a90140e8a33a": {
      "text": "Stand back, my fellow warrior!",
      "status": "imported"
    },
    "voice_099:r_af884a6b11dff121": {
      "text": "Ngh... How careless of me!",
      "status": "imported"
    },
    "voice_099:r_ac6fe7838e95647b": {
      "text": "It seems I have no choice!",
      "status": "imported"
    },
    "voice_099:r_77ca87eacd17ad52": {
      "text": "You shall not have your way!",
      "status": "imported"
    },
    "voice_099:r_bf3244994760e535": {
      "text": "You fool!",
      "status": "imported"
    },
    "voice_099:r_aabfb21c9d069ce7": {
      "text": "You cannot hit me!",
      "status": "imported"
    },
    "voice_099:r_02479dc8fe989560": {
      "text": "You cannot stop me!",
      "status": "imported"
    },
    "voice_099:r_a2df00f91a9b0a9e": {
      "text": "What, Hades?\\nNeed tricks to fight?",
      "status": "imported"
    },
    "voice_099:r_48b60d6c48b9b142": {
      "text": "Arrogant god!\\nKnow your smallness!",
      "status": "imported"
    },
    "voice_099:r_a571eec59b258d11": {
      "text": "It is futile!",
      "status": "imported"
    },
    "voice_099:r_ddbe581c5ea9183d": {
      "text": "That has no effect!",
      "status": "imported"
    },
    "voice_099:r_faae935cca0edc72": {
      "text": "You touched my body...!",
      "status": "imported"
    },
    "voice_099:r_d4430bf362340b32": {
      "text": "You still desire battle?!",
      "status": "imported"
    },
    "voice_099:r_6ff1323b355593e0": {
      "text": "To defeat Zeus, fight all out!",
      "status": "imported"
    },
    "voice_099:r_b7b5625d7cd4282f": {
      "text": "Your blows fail\\non my golden body!",
      "status": "imported"
    },
    "voice_099:r_36133ad73a73ef98": {
      "text": "A foe worthy of me!",
      "status": "imported"
    },
    "voice_099:r_920740a0219c5085": {
      "text": "I, Zeus,\\ndo not fear being wounded!",
      "status": "imported"
    },
    "voice_099:r_a8451712c57c1a72": {
      "text": "Ngh, what is this?!",
      "status": "imported"
    },
    "voice_099:r_3633df5b7b8f47fa": {
      "text": "Ggh, how can this be?!",
      "status": "imported"
    },
    "voice_099:r_52dfc56b14b93551": {
      "text": "Curse you, Hades! How dare you!",
      "status": "imported"
    },
    "voice_099:r_1b9b2aab5cb104da": {
      "text": "You differ from other Machine Gods!",
      "status": "imported"
    },
    "voice_099:r_719e897304ec42d4": {
      "text": "To think you made me flinch...!",
      "status": "imported"
    },
    "voice_099:r_d5e0a2317c40d322": {
      "text": "Can't lose!\\nLives hinge on this!",
      "status": "imported"
    },
    "voice_099:r_ec2ea17765052401": {
      "text": "If my body shatters, I won't yield!",
      "status": "imported"
    },
    "voice_099:r_f2d4255f1c2f7542": {
      "text": "Light, grant me final strength!",
      "status": "imported"
    },
    "voice_099:r_5d08ad19e2da125b": {
      "text": "N-no... I die unfulfilled...!!",
      "status": "imported"
    },
    "voice_099:r_a7246b52782a877e": {
      "text": "Nwoooooh!!",
      "status": "imported"
    },
    "voice_099:r_dc8701f6bcb9904f": {
      "text": "Me? All-wise, almighty guardian...",
      "status": "imported"
    },
    "voice_099:r_d6bdd730f24f66eb": {
      "text": "I am Zeus. In truth, Z Mazinger!",
      "status": "imported"
    },
    "voice_099:r_41997412868c48c4": {
      "text": "ROCKEEEET!\\nPUUUUUNCH!",
      "status": "imported"
    }
  }
}
