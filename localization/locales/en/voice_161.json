{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_161:r_479b340ccc6c572b": {
      "text": "Let's make our move!",
      "status": "imported"
    },
    "voice_161:r_ca4acbac57a2a35e": {
      "text": "If they're in range, they're ours!",
      "status": "imported"
    },
    "voice_161:r_77949221bf58f862": {
      "text": "Strike at their weak point!",
      "status": "imported"
    },
    "voice_161:r_70b9c4b9f1f37eff": {
      "text": "Witness Aquarion's power!",
      "status": "imported"
    },
    "voice_161:r_9fcb3754cb1773c7": {
      "text": "Enemy dead ahead! Let's go!",
      "status": "imported"
    },
    "voice_161:r_3559d2fad32c2435": {
      "text": "I'm an Element too!\\nI'll prove it!",
      "status": "imported"
    },
    "voice_161:r_f7570547e9f80a64": {
      "text": "I'll attack with my Fragility!",
      "status": "imported"
    },
    "voice_161:r_cbab0f4720e1fcf1": {
      "text": "Mallooooy! Mallooooy!",
      "status": "imported"
    },
    "voice_161:r_0bbe0b4f5364e732": {
      "text": "Now, Malloy!",
      "status": "imported"
    },
    "voice_161:r_5dda5198137cb02a": {
      "text": "All right! I'll finish this!",
      "status": "imported"
    },
    "voice_161:r_83ec59afbecdec14": {
      "text": "Malloy! I'll lend you my strength!",
      "status": "imported"
    },
    "voice_161:r_e20bfd42ad95a3c9": {
      "text": "Zessica and I can shatter anything!",
      "status": "imported"
    },
    "voice_161:r_0f58a8822381e57f": {
      "text": "If we combine our strength...!",
      "status": "imported"
    },
    "voice_161:r_6dbcc507fb61b51d": {
      "text": "Vivo... You're powerful, Malloy.",
      "status": "imported"
    },
    "voice_161:r_b42ab697149a7c8a": {
      "text": "Malloy, the enemy's coming!",
      "status": "imported"
    },
    "voice_161:r_4de4fcf3b440baf4": {
      "text": "Leave this to me, MIX!",
      "status": "imported"
    },
    "voice_161:r_0121a166c715cdff": {
      "text": "Yunoha! Don't lose heart!",
      "status": "imported"
    },
    "voice_161:r_30fad37a42bd3ad3": {
      "text": "Yes! I'm going too!",
      "status": "imported"
    },
    "voice_161:r_80a0b2a84e05d81a": {
      "text": "Rot, rot, rot...! My Corrosion...!",
      "status": "imported"
    },
    "voice_161:r_4a9ac1dff86506d9": {
      "text": "Malloooy! With my Fragility...!",
      "status": "imported"
    },
    "voice_161:r_bc8538e6af3d2577": {
      "text": "Go all out, Malloy Direzza!",
      "status": "imported"
    },
    "voice_161:r_924516c8de2b5342": {
      "text": "Chair Crea, here I go!",
      "status": "imported"
    },
    "voice_161:r_da1174533722333f": {
      "text": "Not done yet! One more time!",
      "status": "imported"
    },
    "voice_161:r_fdeb8162976e72c1": {
      "text": "An opening! I'll strike again!",
      "status": "imported"
    },
    "voice_161:r_0fadb5c26df92b42": {
      "text": "Beasts who hurt girls get\\nno mercy!",
      "status": "imported"
    },
    "voice_161:r_6b15af9a0057cdc8": {
      "text": "I won't hand the girls over to you!",
      "status": "imported"
    },
    "voice_161:r_15b4a90140e8a33a": {
      "text": "Go quietly back to your own world!",
      "status": "imported"
    },
    "voice_161:r_af884a6b11dff121": {
      "text": "Beat their commander and end this!",
      "status": "imported"
    },
    "voice_161:r_77ca87eacd17ad52": {
      "text": "Your hate won't\\ndevour the world!",
      "status": "imported"
    },
    "voice_161:r_bf3244994760e535": {
      "text": "Stop, MIX!\\nWe're not your enemies!",
      "status": "imported"
    },
    "voice_161:r_aabfb21c9d069ce7": {
      "text": "Amata! I'll put your power to test!",
      "status": "imported"
    },
    "voice_161:r_02479dc8fe989560": {
      "text": "Same Gepard!\\nSkill will decide this!",
      "status": "imported"
    },
    "voice_161:r_a2df00f91a9b0a9e": {
      "text": "Before Spada closes in,\\nI'll win!",
      "status": "imported"
    },
    "voice_161:r_48b60d6c48b9b142": {
      "text": "Speed won't matter! Power wins!",
      "status": "imported"
    },
    "voice_161:r_8927e6fb681aa809": {
      "text": "Let's see what that Gundam can do!",
      "status": "imported"
    },
    "voice_161:r_665f01666859013b": {
      "text": "You started this!\\nDon't blame me!",
      "status": "imported"
    },
    "voice_161:r_a571eec59b258d11": {
      "text": "Machines are easier to deal with!",
      "status": "imported"
    },
    "voice_161:r_ddbe581c5ea9183d": {
      "text": "It's a monster! Kill or be killed!",
      "status": "imported"
    },
    "voice_161:r_faae935cca0edc72": {
      "text": "An unknown enemy! Stay alert!",
      "status": "imported"
    },
    "voice_161:r_d4430bf362340b32": {
      "text": "A scourge from space!\\nWe won't lose!",
      "status": "imported"
    },
    "voice_161:r_6ff1323b355593e0": {
      "text": "I'll end this source of distortion!",
      "status": "imported"
    },
    "voice_161:r_b7b5625d7cd4282f": {
      "text": "This battle will settle everything!",
      "status": "imported"
    },
    "voice_161:r_36133ad73a73ef98": {
      "text": "Your friendly-fire trick\\nwon't work!",
      "status": "imported"
    },
    "voice_161:r_920740a0219c5085": {
      "text": "This one will hit dead-on!",
      "status": "imported"
    },
    "voice_161:r_a8451712c57c1a72": {
      "text": "Hit...! Hit!",
      "status": "imported"
    },
    "voice_161:r_3633df5b7b8f47fa": {
      "text": "I'll let loose on full auto!",
      "status": "imported"
    },
    "voice_161:r_52dfc56b14b93551": {
      "text": "Running won't save you!",
      "status": "imported"
    },
    "voice_161:r_1b9b2aab5cb104da": {
      "text": "There's no escaping these sights!",
      "status": "imported"
    },
    "voice_161:r_342044c706a2340f": {
      "text": "Missile - full salvo!",
      "status": "imported"
    },
    "voice_161:r_cf41e8828a90cbdb": {
      "text": "Target confirmed! Take this!!",
      "status": "imported"
    },
    "voice_161:r_719e897304ec42d4": {
      "text": "Sheer numbers will overwhelm you!",
      "status": "imported"
    },
    "voice_161:r_d5e0a2317c40d322": {
      "text": "Fire every Missile!",
      "status": "imported"
    },
    "voice_161:r_ec2ea17765052401": {
      "text": "Missile set! And another set!",
      "status": "imported"
    },
    "voice_161:r_f2d4255f1c2f7542": {
      "text": "Go, bye-bye Missile!",
      "status": "imported"
    },
    "voice_161:r_5d08ad19e2da125b": {
      "text": "Run if you like!\\nI've got Missiles!",
      "status": "imported"
    },
    "voice_161:r_a7246b52782a877e": {
      "text": "Raaagh! Goooooo!!",
      "status": "imported"
    },
    "voice_161:r_68f2dfab20a4a30e": {
      "text": "I won't let you hit and run!",
      "status": "imported"
    },
    "voice_161:r_9cedad8237480563": {
      "text": "I'll return the favor!",
      "status": "imported"
    },
    "voice_161:r_a03fabecba1508ca": {
      "text": "I may not look it, but I burn hot!",
      "status": "imported"
    },
    "voice_161:r_5391b24a71eb10ae": {
      "text": "Eye for an eye! Tooth for a tooth!",
      "status": "imported"
    },
    "voice_161:r_a554ceef5c87b972": {
      "text": "Hit back when hit!\\nThat's the rule!",
      "status": "imported"
    },
    "voice_161:r_546c3d5937fbb7ee": {
      "text": "You won't hit me and get away!",
      "status": "imported"
    },
    "voice_161:r_1568ff6298b12b96": {
      "text": "I'll provide support from here!",
      "status": "imported"
    },
    "voice_161:r_2c9d94ba13c5fc50": {
      "text": "Leave the finishing blow to me!",
      "status": "imported"
    },
    "voice_161:r_a77f4913375098d2": {
      "text": "I'm the man you can rely on now!",
      "status": "imported"
    },
    "voice_161:r_428c2116ac3071b1": {
      "text": "Gepard's armor can withstand this!",
      "status": "imported"
    },
    "voice_161:r_84c116267b79f540": {
      "text": "Damn, I can't counter from here!",
      "status": "imported"
    },
    "voice_161:r_dad38ee29af2df3a": {
      "text": "I won't stay here as their target!",
      "status": "imported"
    },
    "voice_161:r_3d32e86f8dc80909": {
      "text": "I misjudged\\nmy pacing...!",
      "status": "imported"
    },
    "voice_161:r_70451ffbabe2f876": {
      "text": "They got outside my counter range!",
      "status": "imported"
    },
    "voice_161:r_69dfa1659715e2fa": {
      "text": "Out of range!\\nThey know the rules!",
      "status": "imported"
    },
    "voice_161:r_d996fd6d4ef5b329": {
      "text": "Hmph... Just as I expected.",
      "status": "imported"
    },
    "voice_161:r_8ab47a28f99ef565": {
      "text": "Whoa! They missed!",
      "status": "imported"
    },
    "voice_161:r_546de3fb6db156ea": {
      "text": "Too bad. I'm over here!",
      "status": "imported"
    },
    "voice_161:r_ca85f87cee5e31f7": {
      "text": "That weak attack won't take me down!",
      "status": "imported"
    },
    "voice_161:r_9072ea7bc71df136": {
      "text": "If I can read their movements...!",
      "status": "imported"
    },
    "voice_161:r_04e815a8d425827d": {
      "text": "Looks like\\nyou fell for my feint.",
      "status": "imported"
    },
    "voice_161:r_d89011fe3e5d082a": {
      "text": "Linear movements\\nare easy to read!",
      "status": "imported"
    },
    "voice_161:r_3c5b0c2ac812d5de": {
      "text": "As expected, that's your move.",
      "status": "imported"
    },
    "voice_161:r_5b9e8897190892eb": {
      "text": "Malloy's always so calm.",
      "status": "imported"
    },
    "voice_161:r_7bea3023abbf8a94": {
      "text": "Not bad at all, Malloy.",
      "status": "imported"
    },
    "voice_161:r_dd01a4c0d1b36a8d": {
      "text": "This is nothing to me.",
      "status": "imported"
    },
    "voice_161:r_20920ad2eb3542db": {
      "text": "That's a good rhythm, Malloy.",
      "status": "imported"
    },
    "voice_161:r_0ab7914877fd48ed": {
      "text": "I grew up in the tropics, you know.",
      "status": "imported"
    },
    "voice_161:r_cb846feec748c2e3": {
      "text": "MIX, damage report?",
      "status": "imported"
    },
    "voice_161:r_c958860b0676b1f5": {
      "text": "Not a scratch! A perfect dodge!",
      "status": "imported"
    },
    "voice_161:r_5e2669b82ef75ce3": {
      "text": "Evasion successful, Malloy!",
      "status": "imported"
    },
    "voice_161:r_7847e0ed7dc9282d": {
      "text": "Maybe Yunoha's cheers did the trick.",
      "status": "imported"
    },
    "voice_161:r_e42b52c7a987b906": {
      "text": "Amazing! I'm impressed, Malloy!",
      "status": "imported"
    },
    "voice_161:r_6825fd1ff907bd22": {
      "text": "Come on, that's all it took?",
      "status": "imported"
    },
    "voice_161:r_607f666f1563bc0d": {
      "text": "Unassuming, but clearly skilled...",
      "status": "imported"
    },
    "voice_161:r_97b7431eeb81e6b6": {
      "text": "Ah, thank you, Chair.",
      "status": "imported"
    },
    "voice_161:r_9b9726b1872759d6": {
      "text": "This is the power of a barrier!",
      "status": "imported"
    },
    "voice_161:r_1252db29683fefe0": {
      "text": "With a barrier,\\nthat's nothing!",
      "status": "imported"
    },
    "voice_161:r_aba6a7662129d8ce": {
      "text": "Looks like I misjudged the distance.",
      "status": "imported"
    },
    "voice_161:r_b84afafb8a33ec60": {
      "text": "I never thought you'd try that.",
      "status": "imported"
    },
    "voice_161:r_c8c59db85bf875e6": {
      "text": "What a surprise attack...!",
      "status": "imported"
    },
    "voice_161:r_391aa56435d9dd6e": {
      "text": "Ugh! I couldn't dodge it all!",
      "status": "imported"
    },
    "voice_161:r_7c796ba53bd7ea03": {
      "text": "Gepard's armor will take this!",
      "status": "imported"
    },
    "voice_161:r_fa944da4b6519006": {
      "text": "No flinch!\\nMy heart's not Fragile!",
      "status": "imported"
    },
    "voice_161:r_95d047bcc17fccc6": {
      "text": "Are you all right, Malloy?",
      "status": "imported"
    },
    "voice_161:r_640327a12a559b31": {
      "text": "Sorry, I let my guard down a little.",
      "status": "imported"
    },
    "voice_161:r_bdd38c584fa313d0": {
      "text": "That's not like you, Malloy.",
      "status": "imported"
    },
    "voice_161:r_3fd86c1027f317c8": {
      "text": "Right. A careless mistake for me.",
      "status": "imported"
    },
    "voice_161:r_d0372a183d2007ad": {
      "text": "Is your rhythm off, Malloy?",
      "status": "imported"
    },
    "voice_161:r_217aa5e1d545b44d": {
      "text": "Sharp as ever, Shrade.",
      "status": "imported"
    },
    "voice_161:r_381992c5d8224937": {
      "text": "Malloy!\\nYou could've dodged that!",
      "status": "imported"
    },
    "voice_161:r_f1e7ed9e5874aba5": {
      "text": "You're tough on me, MIX...",
      "status": "imported"
    },
    "voice_161:r_fc25e66a86fc2c85": {
      "text": "I'm fine, Malloy!\\nJust a scratch!",
      "status": "imported"
    },
    "voice_161:r_5aeeb4917340c42d": {
      "text": "Yunoha cheered me on!\\nI can't quit!",
      "status": "imported"
    },
    "voice_161:r_b765659981b6516d": {
      "text": "Malloy! Make sure you dodge!",
      "status": "imported"
    },
    "voice_161:r_0c427458bc00eb95": {
      "text": "What?!\\nIt'd hit anyone else dead-on!",
      "status": "imported"
    },
    "voice_161:r_774a9ab4d8fd5351": {
      "text": "Are you unharmed, Chair?",
      "status": "imported"
    },
    "voice_161:r_d3f01de714c015bd": {
      "text": "I'm fine.\\nGet ready for the next!",
      "status": "imported"
    },
    "voice_161:r_7d2617c809fead70": {
      "text": "Damn! I fell for their trap!",
      "status": "imported"
    },
    "voice_161:r_ceb935ccbf830724": {
      "text": "Ugh! I can't believe they got me!",
      "status": "imported"
    },
    "voice_161:r_862ef7385bf2abd4": {
      "text": "They completely headed me off...!",
      "status": "imported"
    },
    "voice_161:r_001cbec4d9a4283f": {
      "text": "Damn! I took that head-on!",
      "status": "imported"
    },
    "voice_161:r_8ad40afecd02b41e": {
      "text": "Gepard's armor\\nhas its limits...!",
      "status": "imported"
    },
    "voice_161:r_26e5efec03c03d78": {
      "text": "Ngh! They read my dodge!",
      "status": "imported"
    },
    "voice_161:r_4ad81e88c7557a8b": {
      "text": "Damn! Their instincts overwhelm me!",
      "status": "imported"
    },
    "voice_161:r_1f65a7af190e4674": {
      "text": "Malloy! They breached the armor!",
      "status": "imported"
    },
    "voice_161:r_40c5a9358ed5bf29": {
      "text": "I know! I'll dodge the next one!",
      "status": "imported"
    },
    "voice_161:r_f2e18dfdfe0c89ea": {
      "text": "Damn!\\nAquarion turns it around now!",
      "status": "imported"
    },
    "voice_161:r_cf7dbf49e96a5755": {
      "text": "That's the spirit, Malloy!",
      "status": "imported"
    },
    "voice_161:r_fa96676cc65bb509": {
      "text": "Shrade, are you all right?!",
      "status": "imported"
    },
    "voice_161:r_4e37f92e7d2fc62e": {
      "text": "Forget me! Focus on the enemy!",
      "status": "imported"
    },
    "voice_161:r_66ab4cfe1557909d": {
      "text": "MIX, what's the damage?!",
      "status": "imported"
    },
    "voice_161:r_0bad405ee6ca63ba": {
      "text": "I'll handle things over there!",
      "status": "imported"
    },
    "voice_161:r_2072eaf71a260ae7": {
      "text": "Yunoha, are you hurt?!",
      "status": "imported"
    },
    "voice_161:r_6c13bbfd27a7799e": {
      "text": "I'm fine! I can still fight!",
      "status": "imported"
    },
    "voice_161:r_06f88dcbd3c9e738": {
      "text": "Hang in there, Malloy! Don't lose!",
      "status": "imported"
    },
    "voice_161:r_b28faf9f71bc3598": {
      "text": "Thanks, Sazanka!\\nWe'll rally now!",
      "status": "imported"
    },
    "voice_161:r_8a29278549f8e07a": {
      "text": "It starts here,\\nMalloy Direzza.",
      "status": "imported"
    },
    "voice_161:r_7e6c573c26177f98": {
      "text": "Understood! I'll give it everything!",
      "status": "imported"
    },
    "voice_161:r_edd7a13ab8f06a14": {
      "text": "Ghh! Can't I beat them?!",
      "status": "imported"
    },
    "voice_161:r_8165e5b41f0124c4": {
      "text": "No! At this rate, I'm finished!",
      "status": "imported"
    },
    "voice_161:r_4e05581b7432cce8": {
      "text": "Damn!\\nIs my own heart Fragile?!",
      "status": "imported"
    },
    "voice_161:r_a60b107ea3c36a86": {
      "text": "So powerful...! What a fearsome foe!",
      "status": "imported"
    },
    "voice_161:r_e33693e5ba4665b0": {
      "text": "Pathetic...!\\nThey've cornered me!",
      "status": "imported"
    },
    "voice_161:r_72a21a1a489af001": {
      "text": "At this point,\\nit's all or nothing!",
      "status": "imported"
    },
    "voice_161:r_eb643f8bf737a0ca": {
      "text": "Malloy! We won't last much longer!",
      "status": "imported"
    },
    "voice_161:r_0a3fccb71ec6cf2a": {
      "text": "Then we have to end it before that!",
      "status": "imported"
    },
    "voice_161:r_9b63cf1f3e0207ef": {
      "text": "Armored Gepard\\ntook this much...!",
      "status": "imported"
    },
    "voice_161:r_8356f4e3dcdff938": {
      "text": "Malloy! Don't lose heart!",
      "status": "imported"
    },
    "voice_161:r_1d6d784036ae0bd7": {
      "text": "I made my peace long ago too!",
      "status": "imported"
    },
    "voice_161:r_625664af02183c17": {
      "text": "Shrade!\\nLend me your last strength!",
      "status": "imported"
    },
    "voice_161:r_3701cba361f80ea5": {
      "text": "Aaaah! Malloy, do something!",
      "status": "imported"
    },
    "voice_161:r_63f429c5c68c0863": {
      "text": "I know! I won't let them do more!",
      "status": "imported"
    },
    "voice_161:r_38e4a434c91d8ef0": {
      "text": "Yunoha! You have to eject!",
      "status": "imported"
    },
    "voice_161:r_98ed411352a3a6ac": {
      "text": "No! I'll fight with you to the end!",
      "status": "imported"
    },
    "voice_161:r_4824bea6bab3af67": {
      "text": "Aaaah! I can't take any more!",
      "status": "imported"
    },
    "voice_161:r_862b92e63adb9734": {
      "text": "Fight, Sazanka!\\nWe need your power!",
      "status": "imported"
    },
    "voice_161:r_cb306ef55e49d107": {
      "text": "Chair, stay with me to the end!",
      "status": "imported"
    },
    "voice_161:r_57b2bd2de8a1408d": {
      "text": "Of course. We'll win this!",
      "status": "imported"
    },
    "voice_161:r_76f080a4881e8ab5": {
      "text": "Is this as far as my strength goes?!",
      "status": "imported"
    },
    "voice_161:r_288133bc5b573dae": {
      "text": "Sorry, everyone! Eject now!",
      "status": "imported"
    },
    "voice_161:r_6f95653e548f8fcf": {
      "text": "Mallooy! Mallooy! Mallooy! Mallooy!",
      "status": "imported"
    },
    "voice_161:r_d249d68bada91ab9": {
      "text": "Crush study and work - keep playing!",
      "status": "imported"
    },
    "voice_161:r_e9b3307e9eb69f11": {
      "text": "Mallooooy! Mallooooy!",
      "status": "imported"
    },
    "voice_161:r_03cdac73042343ee": {
      "text": "Mallooooy!! Mallooooy!!",
      "status": "imported"
    },
    "voice_161:r_ec1081caf845f56a": {
      "text": "I'll dig this hole with all I have!",
      "status": "imported"
    },
    "voice_161:r_2c5b7ee872c1ed7f": {
      "text": "Let's do this, Gepard!",
      "status": "imported"
    },
    "voice_161:r_76d1e51c8b494a60": {
      "text": "Uoooooh!!",
      "status": "imported"
    },
    "voice_161:r_eb5f687fcd372ae7": {
      "text": "Punch straight through!!",
      "status": "imported"
    },
    "voice_161:r_2329428a6871d9fa": {
      "text": "I'll... dig a hole!",
      "status": "imported"
    },
    "voice_161:r_0e7466971bec4cc4": {
      "text": "Everyone, lend me your strength!",
      "status": "imported"
    },
    "voice_161:r_efa71f7a4cc33ff3": {
      "text": "Dimension Tunnel Shell!",
      "status": "imported"
    },
    "voice_161:r_3fc2e1186557e7a0": {
      "text": "Goooooo!!",
      "status": "imported"
    },
    "voice_161:r_fa6930340a545054": {
      "text": "I'll make the first move!",
      "status": "imported"
    },
    "voice_161:r_2332b9d56461d7ab": {
      "text": "First, let's see what they can do!",
      "status": "imported"
    },
    "voice_161:r_854aa0a91a3c80d1": {
      "text": "Focus your attacks on them!",
      "status": "imported"
    },
    "voice_161:r_0bc8ae32a406ceab": {
      "text": "Finish them with a combination!",
      "status": "imported"
    },
    "voice_161:r_82c09f011d703b2c": {
      "text": "I'll take you on!",
      "status": "imported"
    },
    "voice_161:r_2b4d8818c77b6dca": {
      "text": "If I can get them one-on-one...!",
      "status": "imported"
    },
    "voice_161:r_087354f2db0a31e6": {
      "text": "My role is to stop you!",
      "status": "imported"
    },
    "voice_161:r_db02a2dec93dd263": {
      "text": "First, draw them away from the unit!",
      "status": "imported"
    }
  }
}
