{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_093:r_479b340ccc6c572b": {
      "text": "The final trump card... This is it?",
      "status": "imported"
    },
    "voice_093:r_ca4acbac57a2a35e": {
      "text": "Is this what you wanted, Father?",
      "status": "imported"
    },
    "voice_093:r_77949221bf58f862": {
      "text": "Vital work protecting humanity...",
      "status": "imported"
    },
    "voice_093:r_70b9c4b9f1f37eff": {
      "text": "Why does it have to be me?",
      "status": "imported"
    },
    "voice_093:r_9fcb3754cb1773c7": {
      "text": "I just have to do as I'm told.",
      "status": "imported"
    },
    "voice_093:r_3559d2fad32c2435": {
      "text": "But the enemy isn't even an Angel...",
      "status": "imported"
    },
    "voice_093:r_f7570547e9f80a64": {
      "text": "What exactly is an EVA...?",
      "status": "imported"
    },
    "voice_093:r_cbab0f4720e1fcf1": {
      "text": "Why am I even piloting this...?",
      "status": "imported"
    },
    "voice_093:r_0bbe0b4f5364e732": {
      "text": "Don't run, don't run,\\ndon't run...!",
      "status": "imported"
    },
    "voice_093:r_5dda5198137cb02a": {
      "text": "If I have no choice, I'll do it...!",
      "status": "imported"
    },
    "voice_093:r_83ec59afbecdec14": {
      "text": "I have to...! I have to...!",
      "status": "imported"
    },
    "voice_093:r_e20bfd42ad95a3c9": {
      "text": "I chose to do this. I can't run!",
      "status": "imported"
    },
    "voice_093:r_0f58a8822381e57f": {
      "text": "I'll do what only I can do!",
      "status": "imported"
    },
    "voice_093:r_6dbcc507fb61b51d": {
      "text": "This is... what I have to do!",
      "status": "imported"
    },
    "voice_093:r_b42ab697149a7c8a": {
      "text": "I absolutely can't lose...!",
      "status": "imported"
    },
    "voice_093:r_4de4fcf3b440baf4": {
      "text": "I won't lose anything else!",
      "status": "imported"
    },
    "voice_093:r_0121a166c715cdff": {
      "text": "I decided to pilot it myself!",
      "status": "imported"
    },
    "voice_093:r_30fad37a42bd3ad3": {
      "text": "Got it, Shinji?",
      "status": "imported"
    },
    "voice_093:r_80a0b2a84e05d81a": {
      "text": "Y-yes!",
      "status": "imported"
    },
    "voice_093:r_4a9ac1dff86506d9": {
      "text": "Follow the plan, Shinji. Got it?",
      "status": "imported"
    },
    "voice_093:r_bc8538e6af3d2577": {
      "text": "Understood, Misato!",
      "status": "imported"
    },
    "voice_093:r_924516c8de2b5342": {
      "text": "Good luck, Shinji!",
      "status": "imported"
    },
    "voice_093:r_da1174533722333f": {
      "text": "Yes...!",
      "status": "imported"
    },
    "voice_093:r_fdeb8162976e72c1": {
      "text": "Retreat, Shinji!",
      "status": "imported"
    },
    "voice_093:r_0fadb5c26df92b42": {
      "text": "I said run, transfer student!!",
      "status": "imported"
    },
    "voice_093:r_6b15af9a0057cdc8": {
      "text": "Don't run away, don't run away...!",
      "status": "imported"
    },
    "voice_093:r_15b4a90140e8a33a": {
      "text": "Can this guy really pull it off?!",
      "status": "imported"
    },
    "voice_093:r_af884a6b11dff121": {
      "text": "Even I don't\\nwant to pilot this!",
      "status": "imported"
    },
    "voice_093:r_ac6fe7838e95647b": {
      "text": "W-wait! I said wait, transfer kid!",
      "status": "imported"
    },
    "voice_093:r_77ca87eacd17ad52": {
      "text": "Just be quiet for a minute...!",
      "status": "imported"
    },
    "voice_093:r_bf3244994760e535": {
      "text": "I have to attack...!",
      "status": "imported"
    },
    "voice_093:r_aabfb21c9d069ce7": {
      "text": "If I don't, they'll get me...!",
      "status": "imported"
    },
    "voice_093:r_02479dc8fe989560": {
      "text": "I can do this if I stay calm...!",
      "status": "imported"
    },
    "voice_093:r_a2df00f91a9b0a9e": {
      "text": "That's the target...!",
      "status": "imported"
    },
    "voice_093:r_48b60d6c48b9b142": {
      "text": "Target acquired!",
      "status": "imported"
    },
    "voice_093:r_8927e6fb681aa809": {
      "text": "Here I go!",
      "status": "imported"
    },
    "voice_093:r_665f01666859013b": {
      "text": "This could work!",
      "status": "imported"
    },
    "voice_093:r_a571eec59b258d11": {
      "text": "Ngh...!",
      "status": "imported"
    },
    "voice_093:r_ddbe581c5ea9183d": {
      "text": "There!",
      "status": "imported"
    },
    "voice_093:r_faae935cca0edc72": {
      "text": "I have to do this!",
      "status": "imported"
    },
    "voice_093:r_d4430bf362340b32": {
      "text": "I'll handle this!",
      "status": "imported"
    },
    "voice_093:r_6ff1323b355593e0": {
      "text": "Goooo!",
      "status": "imported"
    },
    "voice_093:r_b7b5625d7cd4282f": {
      "text": "Center target, pull the switch...",
      "status": "imported"
    },
    "voice_093:r_36133ad73a73ef98": {
      "text": "I've got it in my sights!",
      "status": "imported"
    },
    "voice_093:r_920740a0219c5085": {
      "text": "Please, just hit...!",
      "status": "imported"
    },
    "voice_093:r_a8451712c57c1a72": {
      "text": "Target locked!",
      "status": "imported"
    },
    "voice_093:r_3633df5b7b8f47fa": {
      "text": "I have to get close to it...!",
      "status": "imported"
    },
    "voice_093:r_52dfc56b14b93551": {
      "text": "Close combat!",
      "status": "imported"
    },
    "voice_093:r_1b9b2aab5cb104da": {
      "text": "With the knife!",
      "status": "imported"
    },
    "voice_093:r_342044c706a2340f": {
      "text": "I have to get closer!",
      "status": "imported"
    },
    "voice_093:r_cf41e8828a90cbdb": {
      "text": "I'll have to ram it!",
      "status": "imported"
    },
    "voice_093:r_719e897304ec42d4": {
      "text": "I'll do everything I can...!",
      "status": "imported"
    },
    "voice_093:r_d5e0a2317c40d322": {
      "text": "Not yet!",
      "status": "imported"
    },
    "voice_093:r_ec2ea17765052401": {
      "text": "Youuuu!",
      "status": "imported"
    },
    "voice_093:r_f2d4255f1c2f7542": {
      "text": "I have to do this here and now!",
      "status": "imported"
    },
    "voice_093:r_5d08ad19e2da125b": {
      "text": "More!",
      "status": "imported"
    },
    "voice_093:r_a7246b52782a877e": {
      "text": "Grrr...!",
      "status": "imported"
    },
    "voice_093:r_dc8701f6bcb9904f": {
      "text": "No one else...! I have to do it!",
      "status": "imported"
    },
    "voice_093:r_d6bdd730f24f66eb": {
      "text": "It's not over!",
      "status": "imported"
    },
    "voice_093:r_9e6cf4f389dae55c": {
      "text": "I can still fight!",
      "status": "imported"
    },
    "voice_093:r_9e0c80ac7e33b459": {
      "text": "One more hit...!",
      "status": "imported"
    },
    "voice_093:r_7432ef43ed3471dc": {
      "text": "Keep the pressure on!",
      "status": "imported"
    },
    "voice_093:r_065443f6ddfcf0d7": {
      "text": "If I don't stop that Angel, then...!",
      "status": "imported"
    },
    "voice_093:r_47d52a2839c71715": {
      "text": "That's humanity's... enemy...!",
      "status": "imported"
    },
    "voice_093:r_847f82e7f3eef651": {
      "text": "I'll stop it, no matter what!",
      "status": "imported"
    },
    "voice_093:r_eb7ae28b53dc033c": {
      "text": "I won't let it reach HQ!",
      "status": "imported"
    },
    "voice_093:r_857c4a52ce8df0fd": {
      "text": "Here we go, Noriko!",
      "status": "imported"
    },
    "voice_093:r_55417493fce1d347": {
      "text": "Gunbuster means\\nI must go all-out!",
      "status": "imported"
    },
    "voice_093:r_8fdf5910927c9591": {
      "text": "I'll learn by challenging Simon...!",
      "status": "imported"
    },
    "voice_093:r_7d724dbcc4451e10": {
      "text": "Fear the drill and I'm helpless!",
      "status": "imported"
    },
    "voice_093:r_93e25418a203cb8f": {
      "text": "No relaxing in a mock battle...!",
      "status": "imported"
    },
    "voice_093:r_24cf161287ef9d5c": {
      "text": "I'll prove I can do this...!",
      "status": "imported"
    },
    "voice_093:r_b1de76a75a253c13": {
      "text": "Invading us from another planet...!",
      "status": "imported"
    },
    "voice_093:r_128c35bf3e0e394c": {
      "text": "Psychics really do exist...",
      "status": "imported"
    },
    "voice_093:r_5213c17e13b23de0": {
      "text": "Why do people wage war...?",
      "status": "imported"
    },
    "voice_093:r_38fdff9483e9245c": {
      "text": "Do people in space hate Earth...?",
      "status": "imported"
    },
    "voice_093:r_620fedec67706d7d": {
      "text": "That's the Red Comet...!",
      "status": "imported"
    },
    "voice_093:r_9680dcd0fddcfcc7": {
      "text": "Why must we\\nfight each other...?",
      "status": "imported"
    },
    "voice_093:r_3dbeead1bd3164ef": {
      "text": "I have to avoid their cockpit...!",
      "status": "imported"
    },
    "voice_093:r_46e86d000250e137": {
      "text": "Aren't those people afraid...?",
      "status": "imported"
    },
    "voice_093:r_ac341e7976e88f0b": {
      "text": "How could they kidnap women...!",
      "status": "imported"
    },
    "voice_093:r_cdbd128a5b4127cc": {
      "text": "Are they... trying to wipe us out?",
      "status": "imported"
    },
    "voice_093:r_cfccaa1fbeda124c": {
      "text": "Creatures like that live in space?!",
      "status": "imported"
    },
    "voice_093:r_ddafde4b065ced49": {
      "text": "If that attacks us, Earth will...!",
      "status": "imported"
    },
    "voice_093:r_3304412ac41f47a6": {
      "text": "That's humanity's natural enemy...!",
      "status": "imported"
    },
    "voice_093:r_a2afffe1c396f0b3": {
      "text": "It's like an Angel. Hit the core...!",
      "status": "imported"
    },
    "voice_093:r_13c25fbdfddc8a24": {
      "text": "T-that person moves differently!",
      "status": "imported"
    },
    "voice_093:r_42ba1ecb310b4bd7": {
      "text": "They're human, just like me...!",
      "status": "imported"
    },
    "voice_093:r_d692f1d420460a47": {
      "text": "It's moving too fast...!",
      "status": "imported"
    },
    "voice_093:r_a5643cec86b18bd2": {
      "text": "I can fight if I read its pattern!",
      "status": "imported"
    },
    "voice_093:r_68f2dfab20a4a30e": {
      "text": "Fighting something this huge...?!",
      "status": "imported"
    },
    "voice_093:r_9cedad8237480563": {
      "text": "Even if it's huge, I have to fight!",
      "status": "imported"
    },
    "voice_093:r_a03fabecba1508ca": {
      "text": "I'm sorry! I'll stop your machine!",
      "status": "imported"
    },
    "voice_093:r_5391b24a71eb10ae": {
      "text": "Even by force,\\nI have to stop it...!",
      "status": "imported"
    },
    "voice_093:r_a554ceef5c87b972": {
      "text": "The world meant nothing.\\nBut...!",
      "status": "imported"
    },
    "voice_093:r_546c3d5937fbb7ee": {
      "text": "That's right.\\nOnly I can do this!",
      "status": "imported"
    },
    "voice_093:r_1568ff6298b12b96": {
      "text": "They trust me.\\nI'll fight for them!",
      "status": "imported"
    },
    "voice_093:r_2c9d94ba13c5fc50": {
      "text": "Everyone's future lies ahead...!",
      "status": "imported"
    },
    "voice_093:r_a77f4913375098d2": {
      "text": "I'll use every weapon we've got!",
      "status": "imported"
    },
    "voice_093:r_dad38ee29af2df3a": {
      "text": "Counting down... 3... 2... 1...!",
      "status": "imported"
    },
    "voice_093:r_3d32e86f8dc80909": {
      "text": "Fire!",
      "status": "imported"
    },
    "voice_093:r_70451ffbabe2f876": {
      "text": "I can't afford to miss...!",
      "status": "imported"
    },
    "voice_093:r_69dfa1659715e2fa": {
      "text": "Hit it!!",
      "status": "imported"
    },
    "voice_093:r_d996fd6d4ef5b329": {
      "text": "I have to make this hit...!",
      "status": "imported"
    },
    "voice_093:r_8ab47a28f99ef565": {
      "text": "Goooo!!",
      "status": "imported"
    },
    "voice_093:r_546de3fb6db156ea": {
      "text": "Counting down... 3... 2... 1...!",
      "status": "imported"
    },
    "voice_093:r_ca85f87cee5e31f7": {
      "text": "Ngh...!",
      "status": "imported"
    },
    "voice_093:r_04e815a8d425827d": {
      "text": "Fire!",
      "status": "imported"
    },
    "voice_093:r_d89011fe3e5d082a": {
      "text": "Counter... I have to counter...!",
      "status": "imported"
    },
    "voice_093:r_3c5b0c2ac812d5de": {
      "text": "I have to counterattack!",
      "status": "imported"
    },
    "voice_093:r_5b9e8897190892eb": {
      "text": "I can't just keep running away!",
      "status": "imported"
    },
    "voice_093:r_7bea3023abbf8a94": {
      "text": "Now it's our turn!",
      "status": "imported"
    },
    "voice_093:r_dd01a4c0d1b36a8d": {
      "text": "We have to hit back...!",
      "status": "imported"
    },
    "voice_093:r_20920ad2eb3542db": {
      "text": "I can't let them do any more...!",
      "status": "imported"
    },
    "voice_093:r_0ab7914877fd48ed": {
      "text": "You're not getting away!",
      "status": "imported"
    },
    "voice_093:r_cb846feec748c2e3": {
      "text": "I'll chase them down and attack!",
      "status": "imported"
    },
    "voice_093:r_c958860b0676b1f5": {
      "text": "This time, I'll...!",
      "status": "imported"
    },
    "voice_093:r_5e2669b82ef75ce3": {
      "text": "I'll keep it going!",
      "status": "imported"
    },
    "voice_093:r_7847e0ed7dc9282d": {
      "text": "I hope I won't get in the way...!",
      "status": "imported"
    },
    "voice_093:r_e42b52c7a987b906": {
      "text": "Rei, I'll take it from here!",
      "status": "imported"
    },
    "voice_093:r_6825fd1ff907bd22": {
      "text": "Um... Asuka, I'll cover you.",
      "status": "imported"
    },
    "voice_093:r_607f666f1563bc0d": {
      "text": "I'll cover you, Asuka!",
      "status": "imported"
    },
    "voice_093:r_97b7431eeb81e6b6": {
      "text": "I'll follow your lead, Mari...!",
      "status": "imported"
    },
    "voice_093:r_132f605d02975e71": {
      "text": "I'll support Noriko!",
      "status": "imported"
    },
    "voice_093:r_9b9726b1872759d6": {
      "text": "I'll do it the way Simon would!",
      "status": "imported"
    },
    "voice_093:r_1252db29683fefe0": {
      "text": "Watch me, Akagi!",
      "status": "imported"
    },
    "voice_093:r_ad3d538f1e909184": {
      "text": "I'm in the Volunteer Club too!",
      "status": "imported"
    },
    "voice_093:r_8c61c59a1c0aebbf": {
      "text": "That's Kallen for you!",
      "status": "imported"
    },
    "voice_093:r_aba6a7662129d8ce": {
      "text": "Jin gave me this data.\\nI'll use it!",
      "status": "imported"
    },
    "voice_093:r_b84afafb8a33ec60": {
      "text": "I'll protect you!",
      "status": "imported"
    },
    "voice_093:r_c8c59db85bf875e6": {
      "text": "I'll handle things over here!",
      "status": "imported"
    },
    "voice_093:r_391aa56435d9dd6e": {
      "text": "Even I can manage this much...!",
      "status": "imported"
    },
    "voice_093:r_7c796ba53bd7ea03": {
      "text": "I don't want to lose anyone else!",
      "status": "imported"
    },
    "voice_093:r_fa944da4b6519006": {
      "text": "Rei!",
      "status": "imported"
    },
    "voice_093:r_95d047bcc17fccc6": {
      "text": "Asuka, fall back!",
      "status": "imported"
    },
    "voice_093:r_640327a12a559b31": {
      "text": "Look out, Asuka!",
      "status": "imported"
    },
    "voice_093:r_bdd38c584fa313d0": {
      "text": "Mari, you're too far ahead!",
      "status": "imported"
    },
    "voice_093:r_3fd86c1027f317c8": {
      "text": "Noriko, please fall back!",
      "status": "imported"
    },
    "voice_093:r_d0372a183d2007ad": {
      "text": "Even Gurren Lagann can't do that!",
      "status": "imported"
    },
    "voice_093:r_217aa5e1d545b44d": {
      "text": "Protect Dai-Guard!",
      "status": "imported"
    },
    "voice_093:r_381992c5d8224937": {
      "text": "I won't let them hurt the club!",
      "status": "imported"
    },
    "voice_093:r_f1e7ed9e5874aba5": {
      "text": "I'll protect Kallen!",
      "status": "imported"
    },
    "voice_093:r_fc25e66a86fc2c85": {
      "text": "I never want to feel that way again!",
      "status": "imported"
    },
    "voice_093:r_5aeeb4917340c42d": {
      "text": "N-no!\\nI knew this would happen...!",
      "status": "imported"
    },
    "voice_093:r_b765659981b6516d": {
      "text": "No...! I can't do anything!",
      "status": "imported"
    },
    "voice_093:r_0c427458bc00eb95": {
      "text": "I can't even touch them...!",
      "status": "imported"
    },
    "voice_093:r_774a9ab4d8fd5351": {
      "text": "At this rate,\\nI'm helpless...!",
      "status": "imported"
    },
    "voice_093:r_d3f01de714c015bd": {
      "text": "Can I only endure this for now...?",
      "status": "imported"
    },
    "voice_093:r_7d2617c809fead70": {
      "text": "No! I've lost sight of the enemy!",
      "status": "imported"
    },
    "voice_093:r_ceb935ccbf830724": {
      "text": "You're getting thrashed out there!",
      "status": "imported"
    },
    "voice_093:r_862ef7385bf2abd4": {
      "text": "But there's nothing I can do!",
      "status": "imported"
    },
    "voice_093:r_001cbec4d9a4283f": {
      "text": "Weapons disabled...?! Misato!",
      "status": "imported"
    },
    "voice_093:r_8ad40afecd02b41e": {
      "text": "Fall back and regroup, Shinji!",
      "status": "imported"
    },
    "voice_093:r_26e5efec03c03d78": {
      "text": "Whew, that was close.",
      "status": "imported"
    },
    "voice_093:r_4ad81e88c7557a8b": {
      "text": "I dodged it properly.",
      "status": "imported"
    },
    "voice_093:r_1f65a7af190e4674": {
      "text": "Zero damage... All right!",
      "status": "imported"
    },
    "voice_093:r_40c5a9358ed5bf29": {
      "text": "It actually missed me...!",
      "status": "imported"
    },
    "voice_093:r_f2e18dfdfe0c89ea": {
      "text": "I managed to dodge it, but...!",
      "status": "imported"
    },
    "voice_093:r_cf7dbf49e96a5755": {
      "text": "That saved me...!",
      "status": "imported"
    },
    "voice_093:r_fa96676cc65bb509": {
      "text": "I'm okay. I can keep going!",
      "status": "imported"
    },
    "voice_093:r_4e37f92e7d2fc62e": {
      "text": "They gripe about the budget...",
      "status": "imported"
    },
    "voice_093:r_66ab4cfe1557909d": {
      "text": "Misato, your next order!",
      "status": "imported"
    },
    "voice_093:r_0bad405ee6ca63ba": {
      "text": "All right! It missed!",
      "status": "imported"
    },
    "voice_093:r_2072eaf71a260ae7": {
      "text": "Please, don't go berserk!",
      "status": "imported"
    },
    "voice_093:r_6c13bbfd27a7799e": {
      "text": "Good, transfer kid! Keep it up!",
      "status": "imported"
    },
    "voice_093:r_06f88dcbd3c9e738": {
      "text": "Y-yeah...",
      "status": "imported"
    },
    "voice_093:r_b28faf9f71bc3598": {
      "text": "Misato, your next order!",
      "status": "imported"
    },
    "voice_093:r_8a29278549f8e07a": {
      "text": "Good job, Shinji!\\nEyes on the enemy!",
      "status": "imported"
    },
    "voice_093:r_7e6c573c26177f98": {
      "text": "Not bad, Shinji!",
      "status": "imported"
    },
    "voice_093:r_45abf84f7757d6eb": {
      "text": "It was just a fluke...",
      "status": "imported"
    },
    "voice_093:r_edd7a13ab8f06a14": {
      "text": "Not bad, Shinji!",
      "status": "imported"
    },
    "voice_093:r_8165e5b41f0124c4": {
      "text": "It's thanks to your orders, Misato.",
      "status": "imported"
    },
    "voice_093:r_4e05581b7432cce8": {
      "text": "Huh? Not a scratch...?",
      "status": "imported"
    },
    "voice_093:r_a60b107ea3c36a86": {
      "text": "That won't work!",
      "status": "imported"
    },
    "voice_093:r_e33693e5ba4665b0": {
      "text": "You can't hurt me!",
      "status": "imported"
    },
    "voice_093:r_9b63cf1f3e0207ef": {
      "text": "AT Field, full power!",
      "status": "imported"
    },
    "voice_093:r_8356f4e3dcdff938": {
      "text": "Deploying the field!",
      "status": "imported"
    },
    "voice_093:r_1d6d784036ae0bd7": {
      "text": "With the AT Field...!",
      "status": "imported"
    },
    "voice_093:r_625664af02183c17": {
      "text": "Field at full power!",
      "status": "imported"
    },
    "voice_093:r_3701cba361f80ea5": {
      "text": "If I can block it with the field...!",
      "status": "imported"
    },
    "voice_093:r_63f429c5c68c0863": {
      "text": "Eek...! Aah!",
      "status": "imported"
    },
    "voice_093:r_38e4a434c91d8ef0": {
      "text": "Aagh!",
      "status": "imported"
    },
    "voice_093:r_98ed411352a3a6ac": {
      "text": "Ah... Aah...!",
      "status": "imported"
    },
    "voice_093:r_4824bea6bab3af67": {
      "text": "If it only grazed me...!",
      "status": "imported"
    },
    "voice_093:r_862b92e63adb9734": {
      "text": "Damn...!",
      "status": "imported"
    },
    "voice_093:r_cb306ef55e49d107": {
      "text": "I can't dodge it!",
      "status": "imported"
    },
    "voice_093:r_57b2bd2de8a1408d": {
      "text": "I'm still okay!",
      "status": "imported"
    },
    "voice_093:r_76f080a4881e8ab5": {
      "text": "This is nothing!",
      "status": "imported"
    },
    "voice_093:r_288133bc5b573dae": {
      "text": "If it was just one hit...!",
      "status": "imported"
    },
    "voice_093:r_6f95653e548f8fcf": {
      "text": "I-i-i-it only grazed us just now!",
      "status": "imported"
    },
    "voice_093:r_d249d68bada91ab9": {
      "text": "I know that without being told!",
      "status": "imported"
    },
    "voice_093:r_e9b3307e9eb69f11": {
      "text": "It hit me...!",
      "status": "imported"
    },
    "voice_093:r_03cdac73042343ee": {
      "text": "You're fine. That was nothing.",
      "status": "imported"
    },
    "voice_093:r_6026da5acbda7c69": {
      "text": "No! I can't take this anymore!",
      "status": "imported"
    },
    "voice_093:r_981f8fedd5414fe5": {
      "text": "Let me out!\\nLet me out, Father!!",
      "status": "imported"
    },
    "voice_093:r_96bb0dcde0c8c44a": {
      "text": "What's so wrong with running away?!",
      "status": "imported"
    },
    "voice_093:r_641550a2f54cb456": {
      "text": "No... This can't be happening!",
      "status": "imported"
    },
    "voice_093:r_a0f2074af8debbfa": {
      "text": "Why must this\\nhappen to me...?!",
      "status": "imported"
    },
    "voice_093:r_b5f5a97ed82acb0b": {
      "text": "I knew I couldn't do this...!",
      "status": "imported"
    },
    "voice_093:r_d9cd2e4ded064396": {
      "text": "Urgh!",
      "status": "imported"
    },
    "voice_093:r_99e6349431aaf23b": {
      "text": "Aaaaagh!",
      "status": "imported"
    },
    "voice_093:r_ec1081caf845f56a": {
      "text": "They're cornering me?!",
      "status": "imported"
    },
    "voice_093:r_2c5b7ee872c1ed7f": {
      "text": "Even the AT Field can't stop it?!",
      "status": "imported"
    },
    "voice_093:r_76d1e51c8b494a60": {
      "text": "They haven't beaten me yet...!",
      "status": "imported"
    },
    "voice_093:r_eb5f687fcd372ae7": {
      "text": "Running away won't solve anything!",
      "status": "imported"
    },
    "voice_093:r_2329428a6871d9fa": {
      "text": "I have to do this myself...!",
      "status": "imported"
    },
    "voice_093:r_0e7466971bec4cc4": {
      "text": "Everyone else is fighting! So am I!",
      "status": "imported"
    },
    "voice_093:r_efa71f7a4cc33ff3": {
      "text": "No! At this rate...!",
      "status": "imported"
    },
    "voice_093:r_3fc2e1186557e7a0": {
      "text": "Do something, transfer student!",
      "status": "imported"
    },
    "voice_093:r_fa6930340a545054": {
      "text": "Oh no! It's all over!",
      "status": "imported"
    },
    "voice_093:r_2332b9d56461d7ab": {
      "text": "Want to avoid that?\\nThen hold still!",
      "status": "imported"
    },
    "voice_093:r_854aa0a91a3c80d1": {
      "text": "Aaaaagh!",
      "status": "imported"
    },
    "voice_093:r_0bc8ae32a406ceab": {
      "text": "Get a hold of yourself, Shinji!",
      "status": "imported"
    },
    "voice_093:r_fd910d714be70870": {
      "text": "Help me, Misato! Misato!",
      "status": "imported"
    },
    "voice_093:r_9736f29b11344ec3": {
      "text": "It's over! I can't take any more!",
      "status": "imported"
    },
    "voice_093:r_fcd05582aa5c6068": {
      "text": "No... I could never do this...",
      "status": "imported"
    },
    "voice_093:r_bece29562818acba": {
      "text": "Aaaaaaaaaagh!",
      "status": "imported"
    },
    "voice_093:r_494b5da92ed24ecb": {
      "text": "What is this...?! This is all wrong!",
      "status": "imported"
    },
    "voice_093:r_a4a5a96f4bd58920": {
      "text": "What do I do?!\\nWhat do I do?!",
      "status": "imported"
    },
    "voice_093:r_b57d2d74233f889a": {
      "text": "My AT Field\\nis useless...!",
      "status": "imported"
    },
    "voice_093:r_cd06d0820d82524b": {
      "text": "No, I don't want to give up...!",
      "status": "imported"
    },
    "voice_093:r_c94c6d04be583774": {
      "text": "I don't want any more regrets!",
      "status": "imported"
    },
    "voice_093:r_e54e2c99ef8297af": {
      "text": "I can't lose in a place like this!",
      "status": "imported"
    },
    "voice_093:r_f16a3eb0bcaac082": {
      "text": "No more running!\\nThat's my decision!",
      "status": "imported"
    },
    "voice_093:r_10a408809e512df1": {
      "text": "A-aaaaaagh!!",
      "status": "imported"
    },
    "voice_093:r_bc7b9e308b879dd4": {
      "text": "I have to...!\\nI have to, I have to!!",
      "status": "imported"
    },
    "voice_093:r_98902fd3143c393e": {
      "text": "Obey me, Shinji!\\nFall back now!",
      "status": "imported"
    },
    "voice_093:r_d907fbd7bc1c4298": {
      "text": "I can't run!\\nOr those two will...!",
      "status": "imported"
    },
    "voice_093:r_96b21e3a028dd074": {
      "text": "Transfer student... You...",
      "status": "imported"
    },
    "voice_093:r_ce140b5d8e6b7310": {
      "text": "What?!\\nMisato, what's going on?!",
      "status": "imported"
    },
    "voice_093:r_0e0335789c5396d7": {
      "text": "Calm down, Shinji!",
      "status": "imported"
    },
    "voice_093:r_a8e85bd950696403": {
      "text": "That's enough...! Pilot, fall back!",
      "status": "imported"
    },
    "voice_093:r_772c8bc40ab6cb61": {
      "text": "No! I don't want to give up yet...!",
      "status": "imported"
    },
    "voice_093:r_58dd2826a199ef51": {
      "text": "I knew it... Nobody needs me...",
      "status": "imported"
    },
    "voice_093:r_e7a8cd8ed5bc2d1b": {
      "text": "No...! I can't hold out any longer!",
      "status": "imported"
    },
    "voice_093:r_c7f4280cde4605b3": {
      "text": "I'm sorry! I'm retreating!",
      "status": "imported"
    },
    "voice_093:r_ec349c8ea9511a18": {
      "text": "But we were just getting started...!",
      "status": "imported"
    },
    "voice_093:r_33236ffa3ea95b68": {
      "text": "Misato's job... Fine, I'll read.",
      "status": "imported"
    },
    "voice_093:r_689d0b123de71ae0": {
      "text": "At last, Rebuild of Evangelion!",
      "status": "imported"
    },
    "voice_093:r_84883aa95f63ce32": {
      "text": "Shinji's roped into Volunteer Club.",
      "status": "imported"
    },
    "voice_093:r_25493e978ce8ff16": {
      "text": "Where will their fated tale lead?",
      "status": "imported"
    },
    "voice_093:r_7316666150e42960": {
      "text": "Next time too, service, service!",
      "status": "imported"
    },
    "voice_093:r_c4f11aa93dc5b668": {
      "text": "Haaah...",
      "status": "imported"
    },
    "voice_093:r_ce1a22dfe3a4d339": {
      "text": "What?",
      "status": "imported"
    },
    "voice_093:r_240651adab81e145": {
      "text": "Oh, okay.",
      "status": "imported"
    },
    "voice_093:r_cff0deaae73c2858": {
      "text": "Probably, I think.",
      "status": "imported"
    },
    "voice_093:r_dca67f68a573fab7": {
      "text": "Huh...?! Even that's a bit...",
      "status": "imported"
    },
    "voice_093:r_a6630215fefaf294": {
      "text": "I'm asking you too.",
      "status": "imported"
    },
    "voice_093:r_6f94566ad37f8ff8": {
      "text": "Not really. I don't like crowds...",
      "status": "imported"
    },
    "voice_093:r_942ca03c9de80143": {
      "text": "Oh, I hear that's not in this one.",
      "status": "imported"
    },
    "voice_093:r_d8c669c70659e18a": {
      "text": "I can't settle on the team lineup...",
      "status": "imported"
    },
    "voice_093:r_8f5bade7ac2db78e": {
      "text": "Th-that's just absurd...",
      "status": "imported"
    },
    "voice_093:r_05ea490d2f522520": {
      "text": "Hey, Shinji! Settled in yet?",
      "status": "imported"
    },
    "voice_093:r_f5658c702d91db7a": {
      "text": "Still shy, huh? Then I'll do it!",
      "status": "imported"
    },
    "voice_093:r_686df329b50f195b": {
      "text": "I'll pilot the EVA and nail it!",
      "status": "imported"
    },
    "voice_093:r_25f0ab0fa3cf690c": {
      "text": "What?! When we finally got to talk?!",
      "status": "imported"
    },
    "voice_093:r_b708a1d959013dbf": {
      "text": "New worlds, new foes, new allies.",
      "status": "imported"
    },
    "voice_093:r_59fca03e929366c1": {
      "text": "Where will this war take Shinji?",
      "status": "imported"
    },
    "voice_093:r_0d65eb631dcb7514": {
      "text": "Next: SRW Z3 Jigoku-hen...",
      "status": "imported"
    },
    "voice_093:r_d03018a31e23f1e9": {
      "text": "Next time too: service, service!",
      "status": "imported"
    },
    "voice_093:r_279da5f732aa8847": {
      "text": "Yeah... The original has real class.",
      "status": "imported"
    },
    "voice_093:r_97f82e3cb6f70110": {
      "text": "Duty fills my head, unlike yours.",
      "status": "imported"
    },
    "voice_093:r_c5611d8dd6def96b": {
      "text": "W-why bring that up now...?!",
      "status": "imported"
    },
    "voice_093:r_6f12cc8ed2732eb5": {
      "text": "W-what?! Stop listening and suspend!",
      "status": "imported"
    },
    "voice_093:r_7abfc55f8fb62ba7": {
      "text": "Shin, why the serious face?",
      "status": "imported"
    },
    "voice_093:r_99e7a66c650b5892": {
      "text": "Which partner, Shin? Rei or Asuka?",
      "status": "imported"
    },
    "voice_093:r_5b2247b5cfbcd7b2": {
      "text": "You care. Quit peeking at the game.",
      "status": "imported"
    },
    "voice_093:r_2d7a9c06347582d9": {
      "text": "So Shin can pair with Rei, then?",
      "status": "imported"
    },
    "voice_093:r_bf953d64c3c7d9b7": {
      "text": "Asuka, done? Then lend me SRW!",
      "status": "imported"
    },
    "voice_093:r_e09b933e3e706779": {
      "text": "Cheapskate!",
      "status": "imported"
    },
    "voice_093:r_66236eb99b676e5b": {
      "text": "No reason. That fate was yours.",
      "status": "imported"
    },
    "voice_093:r_9639a2dbcd2f58ed": {
      "text": "Shinji's not alone. We're with him.",
      "status": "imported"
    },
    "voice_093:r_aeea0893acb93d35": {
      "text": "Player rests. You're still working?",
      "status": "imported"
    },
    "voice_093:r_b31568654e53487b": {
      "text": "A date if we had time... Too bad.",
      "status": "imported"
    },
    "voice_093:r_2502132569141ea3": {
      "text": "Don't pretend. I know how you sleep.",
      "status": "imported"
    },
    "voice_093:r_1ff312798a52c8eb": {
      "text": "That's how it is. See you.",
      "status": "imported"
    },
    "voice_093:r_fa07d90fca62f593": {
      "text": "I'll do it...! I'll pilot it!",
      "status": "imported"
    },
    "voice_093:r_a25bf2676ecf9d83": {
      "text": "Why me? Why must this be so hard...?",
      "status": "imported"
    },
    "voice_093:r_237a0288b42dce20": {
      "text": "I'll try... piloting it again.",
      "status": "imported"
    },
    "voice_093:r_0556e8a22779ea8e": {
      "text": "Rei... Why do you pilot an EVA?",
      "status": "imported"
    },
    "voice_093:r_09d377101a48d92a": {
      "text": "Father...? What are you doing?!",
      "status": "imported"
    },
    "voice_093:r_11517cc7b0494dbf": {
      "text": "Damn! Stop stop stop stop stop stop!",
      "status": "imported"
    },
    "voice_093:r_a88939ea84b4474d": {
      "text": "Stop stop stop stop stop stop stop!!",
      "status": "imported"
    },
    "voice_093:r_a870d0cf7cc11ec6": {
      "text": "Stop it!",
      "status": "imported"
    },
    "voice_093:r_03f6158ef83964f3": {
      "text": "Stooooooop!!",
      "status": "imported"
    },
    "voice_093:r_2970a83693cdcc25": {
      "text": "Evangelion Unit-01, Shinji Ikari!",
      "status": "imported"
    },
    "voice_093:r_be661448b85d0009": {
      "text": "Then, commence the operation...!",
      "status": "imported"
    },
    "voice_093:r_958a56c1151cab9e": {
      "text": "Begin the attack!",
      "status": "imported"
    },
    "voice_093:r_8b18aa4cc69547df": {
      "text": "Now! Attack!",
      "status": "imported"
    },
    "voice_093:r_3e87f6fc3ea65aef": {
      "text": "Target ahead...! You can do it!",
      "status": "imported"
    },
    "voice_093:r_5508a7bfa9074eb9": {
      "text": "Follow your orders, Shinji!",
      "status": "imported"
    },
    "voice_093:r_09a003e91f0d5dc7": {
      "text": "That idiot...!",
      "status": "imported"
    },
    "voice_093:r_192447448ebd7bb5": {
      "text": "Don't let up! Next!",
      "status": "imported"
    },
    "voice_093:r_e92920ba4b301b9f": {
      "text": "Don't give them an opening!",
      "status": "imported"
    },
    "voice_093:r_207b256d613bb896": {
      "text": "Keep them from HQ!\\nWipe them out!",
      "status": "imported"
    },
    "voice_093:r_a6fd676d8146501b": {
      "text": "We will stop Third Impact, period!",
      "status": "imported"
    },
    "voice_093:r_94d35e5fa8e3a198": {
      "text": "EVA's duty is to intercept Angels!",
      "status": "imported"
    },
    "voice_093:r_b686510e636673f3": {
      "text": "It's Gunbuster.\\nThe odds are bad...!",
      "status": "imported"
    },
    "voice_093:r_59369bad143d4272": {
      "text": "First, we must stop that drill...!",
      "status": "imported"
    },
    "voice_093:r_25f9b1e39dd8d366": {
      "text": "They came from space\\nto visit us...!",
      "status": "imported"
    },
    "voice_093:r_307477bedd148060": {
      "text": "Psychic powers? How irritating!",
      "status": "imported"
    },
    "voice_093:r_09a780acca0eb4b0": {
      "text": "All units, fire away from cockpits!",
      "status": "imported"
    },
    "voice_093:r_af62f2ee466b5c8c": {
      "text": "So EVA is being used in war...",
      "status": "imported"
    },
    "voice_093:r_20cfb719db02fafd": {
      "text": "Being too pure is its own problem.",
      "status": "imported"
    },
    "voice_093:r_570c1fdf72edb283": {
      "text": "Attack target: the Red Comet!",
      "status": "imported"
    },
    "voice_093:r_23f0d87a5a6cfca1": {
      "text": "Don't let her obsession sway you...!",
      "status": "imported"
    },
    "voice_093:r_60c94ea4eb7f7404": {
      "text": "A grudge drove this.\\nBold or petty?",
      "status": "imported"
    },
    "voice_093:r_727b2ee0277f9159": {
      "text": "Small target. Focus your aim...!",
      "status": "imported"
    },
    "voice_093:r_cff4d2eae8a939ed": {
      "text": "Careful! They're coming from above!",
      "status": "imported"
    },
    "voice_093:r_1428fe5f35a9427b": {
      "text": "No time to care about their side!",
      "status": "imported"
    },
    "voice_093:r_96d39b8bdfa6f183": {
      "text": "Our only choice is to stop it...!",
      "status": "imported"
    },
    "voice_093:r_0e4f9b8a2d26ebff": {
      "text": "This one's rather tricky...!",
      "status": "imported"
    },
    "voice_093:r_79e0d542fe12bcf7": {
      "text": "No AT Field.\\nBetter than an Angel...",
      "status": "imported"
    },
    "voice_093:r_eff747ba39a55393": {
      "text": "They won't talk.\\nDrive them back!",
      "status": "imported"
    },
    "voice_093:r_b2dc77aa6dd77e69": {
      "text": "Their numbers could overwhelm us...!",
      "status": "imported"
    },
    "voice_093:r_445d40d8b5d7092b": {
      "text": "No space monster gets through...!",
      "status": "imported"
    },
    "voice_093:r_bbb633cb5e8e6daf": {
      "text": "Wipe out every last one...! Clear?!",
      "status": "imported"
    },
    "voice_093:r_0abd8b6c713ccdac": {
      "text": "Aim for the core, as with an Angel!",
      "status": "imported"
    },
    "voice_093:r_f4ff463b2fda1b86": {
      "text": "I bet it all on you and the EVA...!",
      "status": "imported"
    },
    "voice_093:r_9ca8d188ae805e3a": {
      "text": "Shinji's not alone.\\nWe're together.",
      "status": "imported"
    },
    "voice_093:r_795ed21f3e28e1f5": {
      "text": "Never forget that...!",
      "status": "imported"
    },
    "voice_093:r_141415c1def5ab2d": {
      "text": "Yes...!",
      "status": "imported"
    },
    "voice_093:r_c894e35becf35a03": {
      "text": "Win, Shinji.\\nThen come back. Got it?",
      "status": "imported"
    },
    "voice_093:r_79b1abf5fc86483c": {
      "text": "Yes. Please stay safe too, Misato...",
      "status": "imported"
    },
    "voice_093:r_e9a11621911acb19": {
      "text": "Shinji,\\nnot for anyone else now...",
      "status": "imported"
    },
    "voice_093:r_d52bece55796f599": {
      "text": "Fight above all for your own wish.",
      "status": "imported"
    },
    "voice_093:r_358fe5a50bbee1df": {
      "text": "My... wish...",
      "status": "imported"
    },
    "voice_093:r_3840c01b1a9bf34b": {
      "text": "Counterattack, hurry!",
      "status": "imported"
    },
    "voice_093:r_f03ef5034d024e8e": {
      "text": "Watch for a chance to fall back!",
      "status": "imported"
    },
    "voice_093:r_bc1a77b291081b0f": {
      "text": "Don't let them escape! Corner them!",
      "status": "imported"
    },
    "voice_093:r_94089c60b94d9a81": {
      "text": "So now it's our turn...!",
      "status": "imported"
    },
    "voice_093:r_56edc0d4b579afd1": {
      "text": "Follow up with our own attack!",
      "status": "imported"
    },
    "voice_093:r_42c897bd608f37fd": {
      "text": "Cover them, just as planned!",
      "status": "imported"
    },
    "voice_093:r_689700a088dc2f5b": {
      "text": "Provide backup!",
      "status": "imported"
    },
    "voice_093:r_5a1e097aa0ec9859": {
      "text": "Hurry and cover our allies!",
      "status": "imported"
    },
    "voice_093:r_2a8d41aa8f4749ec": {
      "text": "Move away! You're an easy target!",
      "status": "imported"
    },
    "voice_093:r_01c80710474b30ae": {
      "text": "The spare weapons won't make it...?",
      "status": "imported"
    },
    "voice_093:r_870a7c766b4e2144": {
      "text": "So we can't reach them from here...!",
      "status": "imported"
    },
    "voice_093:r_a9f39df34c38f5b3": {
      "text": "We're exposed! Move!\\nMove out!",
      "status": "imported"
    },
    "voice_093:r_c9f83672cc4c8866": {
      "text": "Continue the operation! Stay alert!",
      "status": "imported"
    },
    "voice_093:r_19631c3492e99773": {
      "text": "Good move!\\nCounterattack if you can!",
      "status": "imported"
    },
    "voice_093:r_a49cb27d62c078ed": {
      "text": "Honestly, that had me sweating...",
      "status": "imported"
    },
    "voice_093:r_aa6642a8b00c07f9": {
      "text": "Repairs cost plenty. What a relief.",
      "status": "imported"
    },
    "voice_093:r_b6a1f76ff2f0b93d": {
      "text": "The field is still intact...",
      "status": "imported"
    },
    "voice_093:r_16669b320b466ffb": {
      "text": "Thank goodness for the AT Field.",
      "status": "imported"
    },
    "voice_093:r_50c7272601f9608b": {
      "text": "So weak?\\nAT Field will stop it!",
      "status": "imported"
    },
    "voice_093:r_9783be4881baaf30": {
      "text": "Damage is fine!\\nFocus on the plan!",
      "status": "imported"
    },
    "voice_093:r_7a533f3a77a702e3": {
      "text": "It's okay!\\nNo need to worry!",
      "status": "imported"
    },
    "voice_093:r_f13d4928e70aad04": {
      "text": "They pierced the AT Field...?",
      "status": "imported"
    },
    "voice_093:r_bf8c22ddf5e5ebc4": {
      "text": "They broke through the AT Field...!",
      "status": "imported"
    },
    "voice_093:r_9ca308feda543481": {
      "text": "This isn't looking good...!",
      "status": "imported"
    },
    "voice_093:r_323506822dc933d1": {
      "text": "We can't just\\nkeep losing ground!",
      "status": "imported"
    },
    "voice_093:r_a60677a64d47d57d": {
      "text": "We have to break their momentum...!",
      "status": "imported"
    },
    "voice_093:r_eb27b8cd0e427016": {
      "text": "This is where it gets serious...!",
      "status": "imported"
    },
    "voice_093:r_d99d6b303b9eca7a": {
      "text": "Retreat may be needed.\\nNo, we fight!",
      "status": "imported"
    },
    "voice_093:r_46e646d7ceafbf12": {
      "text": "The armor can't hold much longer...!",
      "status": "imported"
    },
    "voice_093:r_2f49681a2d6f9e2b": {
      "text": "We can still fight.\\nNo surrender!",
      "status": "imported"
    },
    "voice_093:r_645e1e5c1c16c791": {
      "text": "Shinji!",
      "status": "imported"
    },
    "voice_093:r_f8ed7cb3cc3d3275": {
      "text": "Abort! Save pilot!\\nForce-eject plug!",
      "status": "imported"
    },
    "voice_093:r_05e4c8c66077e99e": {
      "text": "Temporary retreat! We'll try again!",
      "status": "imported"
    },
    "voice_093:r_8d9b4fc385aef7c5": {
      "text": "Abort! Recover EVA!\\nHurry!",
      "status": "imported"
    },
    "voice_093:r_00f6ca39fc3acf2f": {
      "text": "Drop plan! Pilot first!\\nEject plug!",
      "status": "imported"
    },
    "voice_093:r_fd60a3acea1b3ee7": {
      "text": "Hah... Hah... Hah... Hah...",
      "status": "imported"
    },
    "voice_093:r_4ae43494550cddb4": {
      "text": "Ngh...!",
      "status": "imported"
    },
    "voice_093:r_5b29d293c437429d": {
      "text": "Everyone believed in me...!",
      "status": "imported"
    },
    "voice_093:r_03a3a973128986f1": {
      "text": "Me too...! I can do it too!!",
      "status": "imported"
    },
    "voice_093:r_6290e34747497854": {
      "text": "Go on ahead? But...",
      "status": "imported"
    },
    "voice_093:r_20f27bcf531af7a7": {
      "text": "I'll go on ahead!",
      "status": "imported"
    },
    "voice_093:r_d6e13e5d6953bb84": {
      "text": "I can at least draw their fire...!",
      "status": "imported"
    },
    "voice_093:r_3baf3d844fb1d682": {
      "text": "I'll hold them back with the EVA!",
      "status": "imported"
    },
    "voice_093:r_3360fe6adb1d6342": {
      "text": "That's my enemy...!",
      "status": "imported"
    },
    "voice_093:r_5102781c1e823018": {
      "text": "I have to make it one-on-one...!",
      "status": "imported"
    },
    "voice_093:r_21062243b0a51b01": {
      "text": "I have to do this right...!",
      "status": "imported"
    },
    "voice_093:r_ecb10ae1dba4d07b": {
      "text": "Engaging the target!",
      "status": "imported"
    }
  }
}
