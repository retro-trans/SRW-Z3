{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_158:r_479b340ccc6c572b": {
      "text": "I-I don't know if I can do this...!",
      "status": "imported"
    },
    "voice_158:r_ca4acbac57a2a35e": {
      "text": "Mikono Suzushiro, attack commencing!",
      "status": "imported"
    },
    "voice_158:r_77949221bf58f862": {
      "text": "Th-This...?! Is this what I use?!",
      "status": "imported"
    },
    "voice_158:r_70b9c4b9f1f37eff": {
      "text": "I-If the enemy's coming...!",
      "status": "imported"
    },
    "voice_158:r_9fcb3754cb1773c7": {
      "text": "I must...!\\nI must... I must!",
      "status": "imported"
    },
    "voice_158:r_3559d2fad32c2435": {
      "text": "I'm scared... but I have to!",
      "status": "imported"
    },
    "voice_158:r_f7570547e9f80a64": {
      "text": "Mikono, stay calm!",
      "status": "imported"
    },
    "voice_158:r_cbab0f4720e1fcf1": {
      "text": "Y-Yeah!",
      "status": "imported"
    },
    "voice_158:r_0bbe0b4f5364e732": {
      "text": "I-I'm attacking!",
      "status": "imported"
    },
    "voice_158:r_5dda5198137cb02a": {
      "text": "Go, Mikono!\\nI'll back you up!",
      "status": "imported"
    },
    "voice_158:r_83ec59afbecdec14": {
      "text": "Get a grip, Mikono!",
      "status": "imported"
    },
    "voice_158:r_e20bfd42ad95a3c9": {
      "text": "Here I go!",
      "status": "imported"
    },
    "voice_158:r_0f58a8822381e57f": {
      "text": "M-Me...?! Can I really fight?!",
      "status": "imported"
    },
    "voice_158:r_6dbcc507fb61b51d": {
      "text": "Oh no.\\nHer pulse is stringendo.",
      "status": "imported"
    },
    "voice_158:r_b42ab697149a7c8a": {
      "text": "Mikono, okay?! Can you do this?!",
      "status": "imported"
    },
    "voice_158:r_4de4fcf3b440baf4": {
      "text": "I-I don't know, but...!",
      "status": "imported"
    },
    "voice_158:r_0121a166c715cdff": {
      "text": "Mikono! Relax, and take it easy!",
      "status": "imported"
    },
    "voice_158:r_30fad37a42bd3ad3": {
      "text": "E-Even if you tell me that...!",
      "status": "imported"
    },
    "voice_158:r_80a0b2a84e05d81a": {
      "text": "I-If I can attack one more time...!",
      "status": "imported"
    },
    "voice_158:r_4a9ac1dff86506d9": {
      "text": "Could this be my chance...?!",
      "status": "imported"
    },
    "voice_158:r_bc8538e6af3d2577": {
      "text": "N-No! Stay away!!",
      "status": "imported"
    },
    "voice_158:r_924516c8de2b5342": {
      "text": "Y-You...! What are you, anyway?!",
      "status": "imported"
    },
    "voice_158:r_da1174533722333f": {
      "text": "I'm attacking the Abductor...!",
      "status": "imported"
    },
    "voice_158:r_fdeb8162976e72c1": {
      "text": "Abducting women...\\nUnforgivable!",
      "status": "imported"
    },
    "voice_158:r_0fadb5c26df92b42": {
      "text": "That monster too...\\nI must fight?!",
      "status": "imported"
    },
    "voice_158:r_6b15af9a0057cdc8": {
      "text": "What's that...?\\nIt makes me uneasy!",
      "status": "imported"
    },
    "voice_158:r_15b4a90140e8a33a": {
      "text": "Mikono, that thing's coming!",
      "status": "imported"
    },
    "voice_158:r_af884a6b11dff121": {
      "text": "W-Who is that person...?!",
      "status": "imported"
    },
    "voice_158:r_ac6fe7838e95647b": {
      "text": "I-If I use this...!",
      "status": "imported"
    },
    "voice_158:r_77ca87eacd17ad52": {
      "text": "I don't know if it'll hit, but...!",
      "status": "imported"
    },
    "voice_158:r_bf3244994760e535": {
      "text": "Missile...! Fire!",
      "status": "imported"
    },
    "voice_158:r_aabfb21c9d069ce7": {
      "text": "I'll use the Missile here!",
      "status": "imported"
    },
    "voice_158:r_02479dc8fe989560": {
      "text": "I-I have to counterattack!",
      "status": "imported"
    },
    "voice_158:r_a2df00f91a9b0a9e": {
      "text": "I-If enemies are still nearby...!",
      "status": "imported"
    },
    "voice_158:r_48b60d6c48b9b142": {
      "text": "If I can't run, I have to fight...!",
      "status": "imported"
    },
    "voice_158:r_8927e6fb681aa809": {
      "text": "Th-They attacked us first, so...!",
      "status": "imported"
    },
    "voice_158:r_665f01666859013b": {
      "text": "Huh?! I can't counterattack!",
      "status": "imported"
    },
    "voice_158:r_a571eec59b258d11": {
      "text": "N-No! I can't counter from here!",
      "status": "imported"
    },
    "voice_158:r_ddbe581c5ea9183d": {
      "text": "I-It missed me...",
      "status": "imported"
    },
    "voice_158:r_faae935cca0edc72": {
      "text": "Th-That was close...",
      "status": "imported"
    },
    "voice_158:r_d4430bf362340b32": {
      "text": "What if they attack again...?",
      "status": "imported"
    },
    "voice_158:r_6ff1323b355593e0": {
      "text": "Thank goodness...! It missed!",
      "status": "imported"
    },
    "voice_158:r_b7b5625d7cd4282f": {
      "text": "They're targeting me...!",
      "status": "imported"
    },
    "voice_158:r_36133ad73a73ef98": {
      "text": "You did it, Mikono! Evasion success!",
      "status": "imported"
    },
    "voice_158:r_920740a0219c5085": {
      "text": "I-I did it too...",
      "status": "imported"
    },
    "voice_158:r_a8451712c57c1a72": {
      "text": "I-I dodged it...?!",
      "status": "imported"
    },
    "voice_158:r_3633df5b7b8f47fa": {
      "text": "Not bad, Mikono!",
      "status": "imported"
    },
    "voice_158:r_1b9b2aab5cb104da": {
      "text": "Oh... There was a barrier...",
      "status": "imported"
    },
    "voice_158:r_342044c706a2340f": {
      "text": "If there hadn't been a barrier...",
      "status": "imported"
    },
    "voice_158:r_719e897304ec42d4": {
      "text": "I-If I keep taking these hits...!",
      "status": "imported"
    },
    "voice_158:r_d5e0a2317c40d322": {
      "text": "It was just a scratch this time...",
      "status": "imported"
    },
    "voice_158:r_ec2ea17765052401": {
      "text": "I knew I was no good...",
      "status": "imported"
    },
    "voice_158:r_f2d4255f1c2f7542": {
      "text": "I think I can handle this much...",
      "status": "imported"
    },
    "voice_158:r_5d08ad19e2da125b": {
      "text": "If this keeps up, they'll get me!",
      "status": "imported"
    },
    "voice_158:r_a7246b52782a877e": {
      "text": "Easy, Mikono!\\nIt's only a scratch!",
      "status": "imported"
    },
    "voice_158:r_dc8701f6bcb9904f": {
      "text": "Easy, Mikono! They're targeting you!",
      "status": "imported"
    },
    "voice_158:r_d6bdd730f24f66eb": {
      "text": "B-But if it's me...!",
      "status": "imported"
    },
    "voice_158:r_41997412868c48c4": {
      "text": "N-No! Don't come near me!",
      "status": "imported"
    },
    "voice_158:r_9e6cf4f389dae55c": {
      "text": "I can't! I really am no good!",
      "status": "imported"
    },
    "voice_158:r_9e0c80ac7e33b459": {
      "text": "I'm done...!\\nLike this, I'm done!",
      "status": "imported"
    },
    "voice_158:r_7432ef43ed3471dc": {
      "text": "Me as Head...\\neveryone's in danger!",
      "status": "imported"
    },
    "voice_158:r_065443f6ddfcf0d7": {
      "text": "What are you?!\\nWhy target me?!",
      "status": "imported"
    },
    "voice_158:r_47d52a2839c71715": {
      "text": "A-Amata! What should I do...?!",
      "status": "imported"
    },
    "voice_158:r_847f82e7f3eef651": {
      "text": "Focus, Mikono!\\nYou're Head now!",
      "status": "imported"
    },
    "voice_158:r_eb7ae28b53dc033c": {
      "text": "Mikono!\\nFear won't change anything!",
      "status": "imported"
    },
    "voice_158:r_857c4a52ce8df0fd": {
      "text": "But...! It's just...!",
      "status": "imported"
    },
    "voice_158:r_8fdf5910927c9591": {
      "text": "No more! I really can't do this!",
      "status": "imported"
    },
    "voice_158:r_7d724dbcc4451e10": {
      "text": "I-I knew it.\\nI'm a useless girl...",
      "status": "imported"
    },
    "voice_158:r_93e25418a203cb8f": {
      "text": "I'm putting them all in danger...!",
      "status": "imported"
    },
    "voice_158:r_adeb0a29274d3d9b": {
      "text": "Aaaah!\\nHelp me, Amata, Cayenne!",
      "status": "imported"
    },
    "voice_158:r_24cf161287ef9d5c": {
      "text": "I can't! I can't take any more!",
      "status": "imported"
    },
    "voice_158:r_8f60f6fc86db3107": {
      "text": "Easy, Mikono!\\nFall back for now!",
      "status": "imported"
    },
    "voice_158:r_b1de76a75a253c13": {
      "text": "No! I can't take this anymore!",
      "status": "imported"
    },
    "voice_158:r_128c35bf3e0e394c": {
      "text": "Complain later!\\nGet away, now!",
      "status": "imported"
    },
    "voice_158:r_5213c17e13b23de0": {
      "text": "Aaaaaaah!!",
      "status": "imported"
    },
    "voice_158:r_38fdff9483e9245c": {
      "text": "E-Eject! I have to eject, now!",
      "status": "imported"
    },
    "voice_158:r_1568ff6298b12b96": {
      "text": "I'll provide support from here!",
      "status": "imported"
    },
    "voice_158:r_2c9d94ba13c5fc50": {
      "text": "Please leave the rest to me!",
      "status": "imported"
    },
    "voice_158:r_a77f4913375098d2": {
      "text": "I'll protect you!",
      "status": "imported"
    },
    "voice_158:r_428c2116ac3071b1": {
      "text": "I'll take the hit!",
      "status": "imported"
    },
    "voice_158:r_84c116267b79f540": {
      "text": "Please fall back behind Gepard!",
      "status": "imported"
    },
    "voice_158:r_dad38ee29af2df3a": {
      "text": "No need to fuss!\\nFocus on combat!",
      "status": "imported"
    },
    "voice_158:r_3d32e86f8dc80909": {
      "text": "All right!",
      "status": "imported"
    },
    "voice_158:r_70451ffbabe2f876": {
      "text": "I feel it... Zessica's feelings...",
      "status": "imported"
    },
    "voice_158:r_69dfa1659715e2fa": {
      "text": "Eek! Y-You can tell?!",
      "status": "imported"
    },
    "voice_158:r_d996fd6d4ef5b329": {
      "text": "H-Huh? What do you mean?!",
      "status": "imported"
    },
    "voice_158:r_d89011fe3e5d082a": {
      "text": "I'll go on ahead!",
      "status": "imported"
    },
    "voice_158:r_3c5b0c2ac812d5de": {
      "text": "I must at least hold them off...!",
      "status": "imported"
    },
    "voice_158:r_5b9e8897190892eb": {
      "text": "I have to be of some help...!",
      "status": "imported"
    },
    "voice_158:r_7bea3023abbf8a94": {
      "text": "I-I have to do my part too...!",
      "status": "imported"
    },
    "voice_158:r_dd01a4c0d1b36a8d": {
      "text": "I'll handle the enemy over there...!",
      "status": "imported"
    },
    "voice_158:r_20920ad2eb3542db": {
      "text": "A one-on-one fight...!",
      "status": "imported"
    },
    "voice_158:r_0ab7914877fd48ed": {
      "text": "Double! Then double it again!",
      "status": "imported"
    },
    "voice_158:r_cb846feec748c2e3": {
      "text": "Take this! Bye-Bye Missile!",
      "status": "imported"
    },
    "voice_158:r_c958860b0676b1f5": {
      "text": "This is goodbye!",
      "status": "imported"
    },
    "voice_158:r_5e2669b82ef75ce3": {
      "text": "Bye-Bye Missile!",
      "status": "imported"
    },
    "voice_158:r_7847e0ed7dc9282d": {
      "text": "With this, I can...!",
      "status": "imported"
    },
    "voice_158:r_e42b52c7a987b906": {
      "text": "Missile, full salvo!",
      "status": "imported"
    },
    "voice_158:r_6825fd1ff907bd22": {
      "text": "I'm gonna... dig a hole!",
      "status": "imported"
    },
    "voice_158:r_607f666f1563bc0d": {
      "text": "Everyone, lend me your strength!",
      "status": "imported"
    },
    "voice_158:r_97b7431eeb81e6b6": {
      "text": "Dimension Tunnel Shell!",
      "status": "imported"
    },
    "voice_158:r_132f605d02975e71": {
      "text": "Gooooooo!!",
      "status": "imported"
    },
    "voice_158:r_9b9726b1872759d6": {
      "text": "I'll dig with everything I've got!",
      "status": "imported"
    },
    "voice_158:r_1252db29683fefe0": {
      "text": "Let's do this, Gepard!",
      "status": "imported"
    },
    "voice_158:r_ad3d538f1e909184": {
      "text": "Raaaaaaagh!!",
      "status": "imported"
    },
    "voice_158:r_8c61c59a1c0aebbf": {
      "text": "Blast right through!!",
      "status": "imported"
    }
  }
}
