{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_118:r_479b340ccc6c572b": {
      "text": "Commencing combat!",
      "status": "imported"
    },
    "voice_118:r_77949221bf58f862": {
      "text": "Enemy unit spotted!",
      "status": "imported"
    },
    "voice_118:r_70b9c4b9f1f37eff": {
      "text": "Target acquired!",
      "status": "imported"
    },
    "voice_118:r_9fcb3754cb1773c7": {
      "text": "If I can shoot down the Gundam...!",
      "status": "imported"
    },
    "voice_118:r_3559d2fad32c2435": {
      "text": "A Gundam-type... Can I take it...!",
      "status": "imported"
    },
    "voice_118:r_f7570547e9f80a64": {
      "text": "Even if it's a Gundam...!",
      "status": "imported"
    },
    "voice_118:r_cbab0f4720e1fcf1": {
      "text": "I have a grudge against Gundams too!",
      "status": "imported"
    },
    "voice_118:r_0bbe0b4f5364e732": {
      "text": "Disable it and seize it!",
      "status": "imported"
    },
    "voice_118:r_5dda5198137cb02a": {
      "text": "Is this our top-priority target?!",
      "status": "imported"
    },
    "voice_118:r_83ec59afbecdec14": {
      "text": "Even against a new Gundam!",
      "status": "imported"
    },
    "voice_118:r_e20bfd42ad95a3c9": {
      "text": "A transformable Gundam?!",
      "status": "imported"
    },
    "voice_118:r_0f58a8822381e57f": {
      "text": "You winged freak! Fall!",
      "status": "imported"
    },
    "voice_118:r_0121a166c715cdff": {
      "text": "Stay back, you Gundam knockoff!",
      "status": "imported"
    },
    "voice_118:r_30fad37a42bd3ad3": {
      "text": "It's just an advanced GM!",
      "status": "imported"
    },
    "voice_118:r_80a0b2a84e05d81a": {
      "text": "A Federation grunt mobile suit!",
      "status": "imported"
    },
    "voice_118:r_4a9ac1dff86506d9": {
      "text": "I'll shoot Londo Bell down!",
      "status": "imported"
    },
    "voice_118:r_bc8538e6af3d2577": {
      "text": "Here to ring bells in battle?!",
      "status": "imported"
    },
    "voice_118:r_924516c8de2b5342": {
      "text": "Celestial Being\\njoined the Feds too!",
      "status": "imported"
    },
    "voice_118:r_da1174533722333f": {
      "text": "We're fighting for\\nour colonies!",
      "status": "imported"
    },
    "voice_118:r_0fadb5c26df92b42": {
      "text": "Side with the Feds, become my foe!",
      "status": "imported"
    },
    "voice_118:r_af884a6b11dff121": {
      "text": "Traitors will be purged!",
      "status": "imported"
    },
    "voice_118:r_77ca87eacd17ad52": {
      "text": "Defectors will get their due!",
      "status": "imported"
    },
    "voice_118:r_aabfb21c9d069ce7": {
      "text": "Colonel... I can never forgive you!",
      "status": "imported"
    },
    "voice_118:r_02479dc8fe989560": {
      "text": "That emblem... Is that Amuro Ray?!",
      "status": "imported"
    },
    "voice_118:r_a2df00f91a9b0a9e": {
      "text": "I'll stop the Feds' White Devil!",
      "status": "imported"
    },
    "voice_118:r_48b60d6c48b9b142": {
      "text": "You're just a thick-armored oaf!",
      "status": "imported"
    },
    "voice_118:r_8927e6fb681aa809": {
      "text": "You hollow fake! I'll show you!",
      "status": "imported"
    },
    "voice_118:r_665f01666859013b": {
      "text": "I'll smash that expensive toy!",
      "status": "imported"
    },
    "voice_118:r_a571eec59b258d11": {
      "text": "That thing... Is it a machine...?!",
      "status": "imported"
    },
    "voice_118:r_ddbe581c5ea9183d": {
      "text": "Its combination system must be weak!",
      "status": "imported"
    },
    "voice_118:r_faae935cca0edc72": {
      "text": "A Frontier Fleet variable fighter?!",
      "status": "imported"
    },
    "voice_118:r_d4430bf362340b32": {
      "text": "Speed alone won't decide this fight!",
      "status": "imported"
    },
    "voice_118:r_6ff1323b355593e0": {
      "text": "A mere AT...!",
      "status": "imported"
    },
    "voice_118:r_b7b5625d7cd4282f": {
      "text": "An AS is charging us head-on?!",
      "status": "imported"
    },
    "voice_118:r_36133ad73a73ef98": {
      "text": "Black Knights serving the Feds!",
      "status": "imported"
    },
    "voice_118:r_920740a0219c5085": {
      "text": "You who abandoned your ideals...!",
      "status": "imported"
    },
    "voice_118:r_a8451712c57c1a72": {
      "text": "Small units are hard to target...!",
      "status": "imported"
    },
    "voice_118:r_3633df5b7b8f47fa": {
      "text": "Civilians waltzing into battle...?!",
      "status": "imported"
    },
    "voice_118:r_1b9b2aab5cb104da": {
      "text": "In battle,\\nno mercy for civilians!",
      "status": "imported"
    },
    "voice_118:r_cf41e8828a90cbdb": {
      "text": "I'll crush their chain of command!",
      "status": "imported"
    },
    "voice_118:r_719e897304ec42d4": {
      "text": "You're the unit commander?!",
      "status": "imported"
    },
    "voice_118:r_d5e0a2317c40d322": {
      "text": "I'll sink your mothership!",
      "status": "imported"
    },
    "voice_118:r_ec2ea17765052401": {
      "text": "Up close, a battleship is...!",
      "status": "imported"
    },
    "voice_118:r_a77f4913375098d2": {
      "text": "Payback!",
      "status": "imported"
    },
    "voice_118:r_428c2116ac3071b1": {
      "text": "Commencing counterattack!",
      "status": "imported"
    },
    "voice_118:r_84c116267b79f540": {
      "text": "I'll hit you back!",
      "status": "imported"
    },
    "voice_118:r_dad38ee29af2df3a": {
      "text": "Then I'll make a move too!",
      "status": "imported"
    },
    "voice_118:r_3d32e86f8dc80909": {
      "text": "I won't forget what you did!",
      "status": "imported"
    },
    "voice_118:r_70451ffbabe2f876": {
      "text": "I'll find a chance to break away!",
      "status": "imported"
    },
    "voice_118:r_69dfa1659715e2fa": {
      "text": "You'll pay for that!",
      "status": "imported"
    },
    "voice_118:r_d996fd6d4ef5b329": {
      "text": "I'll turn this crisis into a chance!",
      "status": "imported"
    },
    "voice_118:r_8ab47a28f99ef565": {
      "text": "You took the bait!",
      "status": "imported"
    },
    "voice_118:r_546de3fb6db156ea": {
      "text": "Don't think you can escape me!",
      "status": "imported"
    },
    "voice_118:r_1f65a7af190e4674": {
      "text": "Let's coordinate our attack!",
      "status": "imported"
    },
    "voice_118:r_40c5a9358ed5bf29": {
      "text": "I'll match my attack to our allies!",
      "status": "imported"
    },
    "voice_118:r_f2e18dfdfe0c89ea": {
      "text": "Leave the rest to me!",
      "status": "imported"
    },
    "voice_118:r_cf7dbf49e96a5755": {
      "text": "Commander! I'll go with you!",
      "status": "imported"
    },
    "voice_118:r_fa96676cc65bb509": {
      "text": "Colonel! Let me aid you!",
      "status": "imported"
    },
    "voice_118:r_4e37f92e7d2fc62e": {
      "text": "Follow the Red Comet!",
      "status": "imported"
    },
    "voice_118:r_66ab4cfe1557909d": {
      "text": "Haman! Leave the rest to me!",
      "status": "imported"
    },
    "voice_118:r_0bad405ee6ca63ba": {
      "text": "Follow the Royal Guard!",
      "status": "imported"
    },
    "voice_118:r_2072eaf71a260ae7": {
      "text": "Captain! Leave the rest to me!",
      "status": "imported"
    },
    "voice_118:r_6c13bbfd27a7799e": {
      "text": "Lieutenant! I'll finish them!",
      "status": "imported"
    },
    "voice_118:r_06f88dcbd3c9e738": {
      "text": "Support the Ensign!",
      "status": "imported"
    },
    "voice_118:r_b28faf9f71bc3598": {
      "text": "If you're not going to move!",
      "status": "imported"
    },
    "voice_118:r_8a29278549f8e07a": {
      "text": "If I can land one more blow...!",
      "status": "imported"
    },
    "voice_118:r_7e6c573c26177f98": {
      "text": "It's not over yet!",
      "status": "imported"
    },
    "voice_118:r_45abf84f7757d6eb": {
      "text": "A-aaaaaaaaagh!!",
      "status": "imported"
    },
    "voice_118:r_edd7a13ab8f06a14": {
      "text": "N-no! Aaaaaaagh!!",
      "status": "imported"
    },
    "voice_118:r_8165e5b41f0124c4": {
      "text": "Is retreat our only choice?!",
      "status": "imported"
    },
    "voice_118:r_4e05581b7432cce8": {
      "text": "I-I have to abandon the unit!",
      "status": "imported"
    },
    "voice_118:r_a60b107ea3c36a86": {
      "text": "I have to fall back here...!",
      "status": "imported"
    },
    "voice_118:r_e33693e5ba4665b0": {
      "text": "At my limit! The ejector...!",
      "status": "imported"
    },
    "voice_118:r_72a21a1a489af001": {
      "text": "N-not in a place like this!",
      "status": "imported"
    },
    "voice_118:r_eb643f8bf737a0ca": {
      "text": "C-captain! Forgive me!",
      "status": "imported"
    },
    "voice_118:r_0a3fccb71ec6cf2a": {
      "text": "Z-Zeon's spirit will never die!",
      "status": "imported"
    },
    "voice_118:r_9b63cf1f3e0207ef": {
      "text": "Zeon's spirit will surely live on!",
      "status": "imported"
    },
    "voice_118:r_8356f4e3dcdff938": {
      "text": "Even if I fall, Neo Zeon will...!",
      "status": "imported"
    },
    "voice_118:r_1d6d784036ae0bd7": {
      "text": "Comrades! The rest is up to you!!",
      "status": "imported"
    },
    "voice_118:r_625664af02183c17": {
      "text": "Will Gundam's myth claim me too...?!",
      "status": "imported"
    },
    "voice_118:r_3701cba361f80ea5": {
      "text": "Damn! So this is a Gundam's power!",
      "status": "imported"
    },
    "voice_118:r_63f429c5c68c0863": {
      "text": "Gundam!\\nBlocking Zeon's path again?!",
      "status": "imported"
    },
    "voice_118:r_38e4a434c91d8ef0": {
      "text": "Damn!\\nHeld back, and you got cocky!",
      "status": "imported"
    },
    "voice_118:r_98ed411352a3a6ac": {
      "text": "The latest model's no mere show...!",
      "status": "imported"
    },
    "voice_118:r_4824bea6bab3af67": {
      "text": "Londo Bell... Better than rumored!",
      "status": "imported"
    },
    "voice_118:r_862b92e63adb9734": {
      "text": "You're a class above the other Feds!",
      "status": "imported"
    },
    "voice_118:r_cb306ef55e49d107": {
      "text": "Can't beat a Gundam knockoff...?!",
      "status": "imported"
    },
    "voice_118:r_57b2bd2de8a1408d": {
      "text": "Celestial Being!\\nStill that strong?!",
      "status": "imported"
    },
    "voice_118:r_76f080a4881e8ab5": {
      "text": "You mean to abandon the colonies?!",
      "status": "imported"
    },
    "voice_118:r_6f95653e548f8fcf": {
      "text": "That one...!\\nA Newtype, maybe?!",
      "status": "imported"
    },
    "voice_118:r_d249d68bada91ab9": {
      "text": "I-it moves differently... No way?!",
      "status": "imported"
    },
    "voice_118:r_e9b3307e9eb69f11": {
      "text": "Amuro Ray... You White Devil!",
      "status": "imported"
    },
    "voice_118:r_03cdac73042343ee": {
      "text": "Their Newtype rumor\\nwas true?!",
      "status": "imported"
    },
    "voice_118:r_6026da5acbda7c69": {
      "text": "So this is the Red Comet's skill...!",
      "status": "imported"
    },
    "voice_118:r_981f8fedd5414fe5": {
      "text": "Red Comet... With that power, why?!",
      "status": "imported"
    },
    "voice_118:r_96bb0dcde0c8c44a": {
      "text": "W-what is that power?!",
      "status": "imported"
    },
    "voice_118:r_641550a2f54cb456": {
      "text": "Armor and raw power...\\nNo weakness?!",
      "status": "imported"
    },
    "voice_118:r_a0f2074af8debbfa": {
      "text": "So it's Super, true to its name!",
      "status": "imported"
    },
    "voice_118:r_b5f5a97ed82acb0b": {
      "text": "Damn! I can't flee or pursue it!",
      "status": "imported"
    },
    "voice_118:r_d9cd2e4ded064396": {
      "text": "Mobile suits\\ncan't match that speed!",
      "status": "imported"
    },
    "voice_118:r_99e6349431aaf23b": {
      "text": "What in the world is that AT?!",
      "status": "imported"
    },
    "voice_118:r_ec1081caf845f56a": {
      "text": "So this is an AS's firepower?!",
      "status": "imported"
    },
    "voice_118:r_2c5b7ee872c1ed7f": {
      "text": "Black Knights!\\nWhy block our way?!",
      "status": "imported"
    },
    "voice_118:r_76d1e51c8b494a60": {
      "text": "Damn!\\nHow can it have such power?!",
      "status": "imported"
    },
    "voice_118:r_eb5f687fcd372ae7": {
      "text": "Aaaaargh!",
      "status": "imported"
    },
    "voice_118:r_2329428a6871d9fa": {
      "text": "It's no use! Output won't rise...",
      "status": "imported"
    },
    "voice_118:r_0e7466971bec4cc4": {
      "text": "I'm already near the limit...!",
      "status": "imported"
    },
    "voice_118:r_efa71f7a4cc33ff3": {
      "text": "A-am I truly outclassed...?!",
      "status": "imported"
    },
    "voice_118:r_3fc2e1186557e7a0": {
      "text": "My main camera's been hit!",
      "status": "imported"
    },
    "voice_118:r_fa6930340a545054": {
      "text": "Damn!\\nThe thrusters won't work!",
      "status": "imported"
    },
    "voice_118:r_2332b9d56461d7ab": {
      "text": "Serious drive-system trouble?!",
      "status": "imported"
    },
    "voice_118:r_854aa0a91a3c80d1": {
      "text": "Bad...!\\nThe reactor will ignite!",
      "status": "imported"
    },
    "voice_118:r_0bc8ae32a406ceab": {
      "text": "The instant I give up, I lose...!",
      "status": "imported"
    },
    "voice_118:r_82c09f011d703b2c": {
      "text": "Fight...! Fight to the very end!",
      "status": "imported"
    },
    "voice_118:r_2b4d8818c77b6dca": {
      "text": "It's too soon to think you've won!",
      "status": "imported"
    },
    "voice_118:r_087354f2db0a31e6": {
      "text": "I can fight! I'll see it to the end!",
      "status": "imported"
    },
    "voice_118:r_db02a2dec93dd263": {
      "text": "Until Spacenoids have a future...!",
      "status": "imported"
    },
    "voice_118:r_d520c6d5298a848d": {
      "text": "Not yet...! Neo Zeon still lives...!",
      "status": "imported"
    },
    "voice_118:r_099e2458cabf796f": {
      "text": "Our ideals and cause!\\nNot to you!",
      "status": "imported"
    },
    "voice_118:r_fd910d714be70870": {
      "text": "Suit breaks,\\nNeo Zeon's soul lives!",
      "status": "imported"
    },
    "voice_118:r_9736f29b11344ec3": {
      "text": "Ngh! They fired where I dodged!",
      "status": "imported"
    },
    "voice_118:r_fcd05582aa5c6068": {
      "text": "This is bad! I took it head-on...!",
      "status": "imported"
    },
    "voice_118:r_bece29562818acba": {
      "text": "Can't let them build momentum...!",
      "status": "imported"
    },
    "voice_118:r_494b5da92ed24ecb": {
      "text": "One opening, and this happens...!",
      "status": "imported"
    },
    "voice_118:r_a4a5a96f4bd58920": {
      "text": "Half my monitors are dead!",
      "status": "imported"
    },
    "voice_118:r_b57d2d74233f889a": {
      "text": "Urgh! They pierced the armor!",
      "status": "imported"
    },
    "voice_118:r_cd06d0820d82524b": {
      "text": "Damn! Am I outmatched in power?!",
      "status": "imported"
    },
    "voice_118:r_c94c6d04be583774": {
      "text": "Sluggish response! Drive trouble?!",
      "status": "imported"
    },
    "voice_118:r_e54e2c99ef8297af": {
      "text": "Our fight won't end that easily!",
      "status": "imported"
    },
    "voice_118:r_f16a3eb0bcaac082": {
      "text": "I was prepared for this much!",
      "status": "imported"
    },
    "voice_118:r_10a408809e512df1": {
      "text": "Neo Zeon won't lose... Never!",
      "status": "imported"
    },
    "voice_118:r_bc7b9e308b879dd4": {
      "text": "If we lose,\\nwhat of the Spacenoids?!",
      "status": "imported"
    },
    "voice_118:r_d8c669c70659e18a": {
      "text": "Drop the Gundam name!",
      "status": "imported"
    },
    "voice_118:r_8f5bade7ac2db78e": {
      "text": "Gundams won't lord over us forever!",
      "status": "imported"
    },
    "voice_118:r_05ea490d2f522520": {
      "text": "The age of Gundams is over!",
      "status": "imported"
    },
    "voice_118:r_f5658c702d91db7a": {
      "text": "Surrender now and I'll spare you!",
      "status": "imported"
    },
    "voice_118:r_686df329b50f195b": {
      "text": "So much for the latest model!",
      "status": "imported"
    },
    "voice_118:r_25f0ab0fa3cf690c": {
      "text": "A knockoff is a knockoff to the end!",
      "status": "imported"
    },
    "voice_118:r_b708a1d959013dbf": {
      "text": "Is ringing bells all you can do?!",
      "status": "imported"
    },
    "voice_118:r_59fca03e929366c1": {
      "text": "Weak as the corrupt Federation!",
      "status": "imported"
    },
    "voice_118:r_0d65eb631dcb7514": {
      "text": "Siding with the Feds led to this!",
      "status": "imported"
    },
    "voice_118:r_97f82e3cb6f70110": {
      "text": "Red Comet suits the Colonel best!",
      "status": "imported"
    },
    "voice_118:r_c5611d8dd6def96b": {
      "text": "You've fallen low, Char Aznable!",
      "status": "imported"
    },
    "voice_118:r_6f12cc8ed2732eb5": {
      "text": "Oaf!\\nYou're wasting all that power!",
      "status": "imported"
    },
    "voice_118:r_7abfc55f8fb62ba7": {
      "text": "You're nothing but a fast gnat!",
      "status": "imported"
    },
    "voice_118:r_99e7a66c650b5892": {
      "text": "You're too weak!",
      "status": "imported"
    },
    "voice_118:r_5b2247b5cfbcd7b2": {
      "text": "My armor saved me...!",
      "status": "imported"
    },
    "voice_118:r_2d7a9c06347582d9": {
      "text": "You only managed to hit me!",
      "status": "imported"
    },
    "voice_118:r_bf953d64c3c7d9b7": {
      "text": "That was nothing but a fluke!",
      "status": "imported"
    },
    "voice_118:r_e09b933e3e706779": {
      "text": "Did I underestimate them...!",
      "status": "imported"
    },
    "voice_118:r_66236eb99b676e5b": {
      "text": "At least your aim is true!",
      "status": "imported"
    },
    "voice_118:r_9639a2dbcd2f58ed": {
      "text": "You call that damage?!",
      "status": "imported"
    },
    "voice_118:r_aeea0893acb93d35": {
      "text": "As long as it misses the reactor...!",
      "status": "imported"
    },
    "voice_118:r_b31568654e53487b": {
      "text": "A sub-camera or two won't matter!",
      "status": "imported"
    },
    "voice_118:r_2502132569141ea3": {
      "text": "All systems normal! I can fight!",
      "status": "imported"
    },
    "voice_118:r_1ff312798a52c8eb": {
      "text": "As long as my shield holds...!",
      "status": "imported"
    },
    "voice_118:r_fa07d90fca62f593": {
      "text": "My shield can handle that!",
      "status": "imported"
    },
    "voice_118:r_a25bf2676ecf9d83": {
      "text": "Like that'll hit me!",
      "status": "imported"
    },
    "voice_118:r_237a0288b42dce20": {
      "text": "Everything you do is too slow!",
      "status": "imported"
    },
    "voice_118:r_0556e8a22779ea8e": {
      "text": "All right! I dodged it!",
      "status": "imported"
    },
    "voice_118:r_09d377101a48d92a": {
      "text": "Luck is on my side!",
      "status": "imported"
    },
    "voice_118:r_11517cc7b0494dbf": {
      "text": "Perfect timing!",
      "status": "imported"
    },
    "voice_118:r_b5864501463db244": {
      "text": "I'll dodge the next one too!",
      "status": "imported"
    },
    "voice_118:r_a88939ea84b4474d": {
      "text": "You face me with skills like that?!",
      "status": "imported"
    },
    "voice_118:r_a870d0cf7cc11ec6": {
      "text": "I saw that attack coming!",
      "status": "imported"
    },
    "voice_118:r_03f6158ef83964f3": {
      "text": "Real combat has honed my skills!",
      "status": "imported"
    },
    "voice_118:r_09a780acca0eb4b0": {
      "text": "We've got equipment like that too!",
      "status": "imported"
    },
    "voice_118:r_af62f2ee466b5c8c": {
      "text": "That didn't even hurt!",
      "status": "imported"
    },
    "voice_118:r_23f0d87a5a6cfca1": {
      "text": "With an I-field...!",
      "status": "imported"
    },
    "voice_118:r_60c94ea4eb7f7404": {
      "text": "I can't even counterattack...!",
      "status": "imported"
    },
    "voice_118:r_727b2ee0277f9159": {
      "text": "Damn it! I lost them!",
      "status": "imported"
    },
    "voice_118:r_cff4d2eae8a939ed": {
      "text": "Damn it! What's going on here?!",
      "status": "imported"
    },
    "voice_118:r_1428fe5f35a9427b": {
      "text": "This is bad! I'm just a target!",
      "status": "imported"
    },
    "voice_118:r_96d39b8bdfa6f183": {
      "text": "Damn! I forgot combat basics...!",
      "status": "imported"
    },
    "voice_118:r_0e4f9b8a2d26ebff": {
      "text": "An attack from beyond my range?!",
      "status": "imported"
    },
    "voice_118:r_79e0d542fe12bcf7": {
      "text": "Damn! They got me from there...!",
      "status": "imported"
    },
    "voice_118:r_eff747ba39a55393": {
      "text": "My energy reserves...?!",
      "status": "imported"
    },
    "voice_118:r_b2dc77aa6dd77e69": {
      "text": "Fall back while you can!",
      "status": "imported"
    },
    "voice_118:r_445d40d8b5d7092b": {
      "text": "We'll be your shield!",
      "status": "imported"
    },
    "voice_118:r_bbb633cb5e8e6daf": {
      "text": "Don't push it! Fall back!",
      "status": "imported"
    },
    "voice_118:r_0abd8b6c713ccdac": {
      "text": "Protect the Commander!",
      "status": "imported"
    },
    "voice_118:r_f4ff463b2fda1b86": {
      "text": "I won't let them harm the Colonel!",
      "status": "imported"
    },
    "voice_118:r_4e63c037d3cb8a3d": {
      "text": "We cannot let the Red Comet fall!",
      "status": "imported"
    },
    "voice_118:r_9ca8d188ae805e3a": {
      "text": "Even at my life's cost, Haman...!",
      "status": "imported"
    },
    "voice_118:r_795ed21f3e28e1f5": {
      "text": "Are they targeting the Royal Guard?!",
      "status": "imported"
    },
    "voice_118:r_141415c1def5ab2d": {
      "text": "Captain! It's dangerous!",
      "status": "imported"
    },
    "voice_118:r_c894e35becf35a03": {
      "text": "Lieutenant! You're too far ahead!",
      "status": "imported"
    },
    "voice_118:r_79b1abf5fc86483c": {
      "text": "Ensign! Don't do anything reckless!",
      "status": "imported"
    },
    "voice_118:r_e9a11621911acb19": {
      "text": "Fall!",
      "status": "imported"
    },
    "voice_118:r_d52bece55796f599": {
      "text": "Come on, hit!",
      "status": "imported"
    },
    "voice_118:r_358fe5a50bbee1df": {
      "text": "This is the end!",
      "status": "imported"
    },
    "voice_118:r_638834e16724002f": {
      "text": "I'll pin them down!",
      "status": "imported"
    },
    "voice_118:r_b02fca1590ac1210": {
      "text": "If you wanna fight!",
      "status": "imported"
    },
    "voice_118:r_f0344d2fbaa9db77": {
      "text": "Come and get me!",
      "status": "imported"
    },
    "voice_118:r_3328eef766ff2c2c": {
      "text": "I'll take you on!",
      "status": "imported"
    },
    "voice_118:r_23b037cf6ccc695c": {
      "text": "No matter how outmatched we are!",
      "status": "imported"
    },
    "voice_118:r_883ad1128d340c5e": {
      "text": "You won't get past here!",
      "status": "imported"
    },
    "voice_118:r_a9e6ed99025a703b": {
      "text": "Take out the enemy in front!",
      "status": "imported"
    },
    "voice_118:r_b0d1459d6daeebbe": {
      "text": "I'll get you before you get me!",
      "status": "imported"
    },
    "voice_118:r_cd4893b409472e97": {
      "text": "You overextended, now you pay!",
      "status": "imported"
    },
    "voice_118:r_5691cc71770ffdde": {
      "text": "We'll create a new era!",
      "status": "imported"
    },
    "voice_118:r_964e07c5563a5508": {
      "text": "Feel the wrath of the Spacenoids!",
      "status": "imported"
    },
    "voice_118:r_db54e717bff3e3b2": {
      "text": "This battle will change the world!",
      "status": "imported"
    },
    "voice_118:r_fcab8d80aef7e9d8": {
      "text": "This is Neo Zeon!",
      "status": "imported"
    },
    "voice_118:r_2174bd0edc164171": {
      "text": "Witness how Neo Zeon fights!",
      "status": "imported"
    },
    "voice_118:r_ad54419336b49578": {
      "text": "To realize the Commander's ideals!",
      "status": "imported"
    },
    "voice_118:r_63c353e1e05e8e39": {
      "text": "Down with the Earth Federation!",
      "status": "imported"
    },
    "voice_118:r_87646dd472438e88": {
      "text": "You who still cling to Earth\\n...!",
      "status": "imported"
    },
    "voice_118:r_4e32ac89cba02001": {
      "text": "Spacenoids' hopes\\nare ours to bear!",
      "status": "imported"
    },
    "voice_118:r_02d24e5915bfa5b7": {
      "text": "If it falls, the world will change!",
      "status": "imported"
    },
    "voice_118:r_9331c2c2ef55c78f": {
      "text": "Don't hinder the final operation!",
      "status": "imported"
    },
    "voice_118:r_49734bdb3507acf7": {
      "text": "You won't break through here!",
      "status": "imported"
    },
    "voice_118:r_2a730c9b4df0dca3": {
      "text": "You won't get near Axis!",
      "status": "imported"
    },
    "voice_118:r_1e5842ba5dc3f705": {
      "text": "Earth's day of reckoning is here!",
      "status": "imported"
    },
    "voice_118:r_9747bd61ad23ecd3": {
      "text": "Now Earth will pay!",
      "status": "imported"
    },
    "voice_118:r_6823f8abe05c4727": {
      "text": "I'll crush you!",
      "status": "imported"
    },
    "voice_118:r_b8ccfd8b8ac323ac": {
      "text": "It's risky, but...!",
      "status": "imported"
    },
    "voice_118:r_c885ff2097749991": {
      "text": "Closing the distance!",
      "status": "imported"
    },
    "voice_118:r_a8da7f8d8b705db0": {
      "text": "You let me get close!",
      "status": "imported"
    },
    "voice_118:r_02e1c5e19de5bd22": {
      "text": "This will finish you!",
      "status": "imported"
    },
    "voice_118:r_6fb823898811e210": {
      "text": "I'll shoot you down!",
      "status": "imported"
    },
    "voice_118:r_5dcbcf1682cc3ab8": {
      "text": "I've got you in my sights!",
      "status": "imported"
    },
    "voice_118:r_5a20988e743dc1d0": {
      "text": "Hit them dead-on!",
      "status": "imported"
    },
    "voice_118:r_197f05bf899b7697": {
      "text": "Fire enough and something will hit!",
      "status": "imported"
    },
    "voice_118:r_623ee03bd91ab2a1": {
      "text": "At this range...!",
      "status": "imported"
    },
    "voice_118:r_3baa2292b050034a": {
      "text": "At this range... I'll snipe them!",
      "status": "imported"
    },
    "voice_118:r_8a303240a87b1c7d": {
      "text": "Target locked! Fire!",
      "status": "imported"
    },
    "voice_118:r_4069f7e9517c47e8": {
      "text": "Go!",
      "status": "imported"
    },
    "voice_118:r_2835a8af1c41be9b": {
      "text": "The finishing blow!",
      "status": "imported"
    },
    "voice_118:r_cd84325a7c1a820f": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_118:r_0465f74c0488ad70": {
      "text": "Damn you!",
      "status": "imported"
    },
    "voice_118:r_a30c8238b5208470": {
      "text": "There!",
      "status": "imported"
    },
    "voice_118:r_64bf1c63c7c1ebdd": {
      "text": "Haaah!",
      "status": "imported"
    },
    "voice_118:r_f6d5042f671118fa": {
      "text": "Got you!",
      "status": "imported"
    },
    "voice_118:r_c05bd0cf089d667f": {
      "text": "Let's do this!",
      "status": "imported"
    },
    "voice_118:r_7ecfe7ddfa4cdb6a": {
      "text": "Raaaaagh!",
      "status": "imported"
    },
    "voice_118:r_0ef83b6a1e87f6fd": {
      "text": "Faaaall!",
      "status": "imported"
    },
    "voice_118:r_953824ba6b607e1f": {
      "text": "Whatever it takes, you fall here!",
      "status": "imported"
    },
    "voice_118:r_82e0a318411dcbf7": {
      "text": "I can at least slow them down!",
      "status": "imported"
    },
    "voice_118:r_36c402609f13ec14": {
      "text": "I'll draw their attention!",
      "status": "imported"
    },
    "voice_118:r_5ec6634ac287489a": {
      "text": "If we focus our attacks...!",
      "status": "imported"
    },
    "voice_118:r_0f6c6e8f33422ecf": {
      "text": "I know what my duty is!",
      "status": "imported"
    },
    "voice_118:r_035b4f6912ba7eed": {
      "text": "I'll open a path through!",
      "status": "imported"
    },
    "voice_118:r_f74b67b3cfcbe05c": {
      "text": "Against only one unit!",
      "status": "imported"
    },
    "voice_118:r_6d8a80e2956870ed": {
      "text": "I can't afford to fail!",
      "status": "imported"
    },
    "voice_118:r_426b68d671486c8e": {
      "text": "The odds are even!",
      "status": "imported"
    },
    "voice_118:r_ae913eb08e0ff29b": {
      "text": "We'll use that strategy!",
      "status": "imported"
    },
    "voice_118:r_6fbc129ae3a24bb0": {
      "text": "I'll handle that one!",
      "status": "imported"
    }
  }
}
