{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_098:r_479b340ccc6c572b": {
      "text": "Hit!",
      "status": "imported"
    },
    "voice_098:r_ca4acbac57a2a35e": {
      "text": "Go!",
      "status": "imported"
    },
    "voice_098:r_77949221bf58f862": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_098:r_70b9c4b9f1f37eff": {
      "text": "This'll do it!",
      "status": "imported"
    },
    "voice_098:r_9fcb3754cb1773c7": {
      "text": "Got you!",
      "status": "imported"
    },
    "voice_098:r_3559d2fad32c2435": {
      "text": "Too bad...!",
      "status": "imported"
    },
    "voice_098:r_f7570547e9f80a64": {
      "text": "Sorry about this!",
      "status": "imported"
    },
    "voice_098:r_cbab0f4720e1fcf1": {
      "text": "Guess you're out of luck!",
      "status": "imported"
    },
    "voice_098:r_0bbe0b4f5364e732": {
      "text": "Peace-soft world,\\nwear our colors!",
      "status": "imported"
    },
    "voice_098:r_5dda5198137cb02a": {
      "text": "Terror's flames devour all!\\nMy wish!",
      "status": "imported"
    },
    "voice_098:r_83ec59afbecdec14": {
      "text": "Destroy it all!\\nThat is our revenge!",
      "status": "imported"
    },
    "voice_098:r_e20bfd42ad95a3c9": {
      "text": "The more victims, the better...!",
      "status": "imported"
    },
    "voice_098:r_0f58a8822381e57f": {
      "text": "Now that it's activated, we've won!",
      "status": "imported"
    },
    "voice_098:r_6dbcc507fb61b51d": {
      "text": "Go, Takuma!\\nDestroy everything!",
      "status": "imported"
    },
    "voice_098:r_b42ab697149a7c8a": {
      "text": "Takuma! Eliminate all in our way!",
      "status": "imported"
    },
    "voice_098:r_4de4fcf3b440baf4": {
      "text": "Devil unleashed!\\nNo one can stop it!",
      "status": "imported"
    },
    "voice_098:r_0121a166c715cdff": {
      "text": "Fighting is all I have left...!",
      "status": "imported"
    },
    "voice_098:r_30fad37a42bd3ad3": {
      "text": "If I die, it'll be in battle!",
      "status": "imported"
    },
    "voice_098:r_80a0b2a84e05d81a": {
      "text": "This is the life I've chosen...!",
      "status": "imported"
    },
    "voice_098:r_4a9ac1dff86506d9": {
      "text": "My fight isn't over yet!",
      "status": "imported"
    },
    "voice_098:r_bc8538e6af3d2577": {
      "text": "I won't miss my mark!",
      "status": "imported"
    },
    "voice_098:r_924516c8de2b5342": {
      "text": "Target lock!",
      "status": "imported"
    },
    "voice_098:r_da1174533722333f": {
      "text": "Once I read your movements...!",
      "status": "imported"
    },
    "voice_098:r_fdeb8162976e72c1": {
      "text": "Close in and finish it at once...!",
      "status": "imported"
    },
    "voice_098:r_0fadb5c26df92b42": {
      "text": "Once I close the distance...!",
      "status": "imported"
    },
    "voice_098:r_6b15af9a0057cdc8": {
      "text": "Close combat it is...!",
      "status": "imported"
    },
    "voice_098:r_15b4a90140e8a33a": {
      "text": "I'll make the most of this chance!",
      "status": "imported"
    },
    "voice_098:r_af884a6b11dff121": {
      "text": "I won't let this opening slip!",
      "status": "imported"
    },
    "voice_098:r_ac6fe7838e95647b": {
      "text": "That unit is unlike the others...!",
      "status": "imported"
    },
    "voice_098:r_77ca87eacd17ad52": {
      "text": "That's the AS our data flagged...!",
      "status": "imported"
    },
    "voice_098:r_bf3244994760e535": {
      "text": "Even against their latest model...!",
      "status": "imported"
    },
    "voice_098:r_aabfb21c9d069ce7": {
      "text": "I knew you'd show yourselves...!",
      "status": "imported"
    },
    "voice_098:r_02479dc8fe989560": {
      "text": "A capable commander, I see...!",
      "status": "imported"
    },
    "voice_098:r_a2df00f91a9b0a9e": {
      "text": "You seem like a tough opponent...!",
      "status": "imported"
    },
    "voice_098:r_48b60d6c48b9b142": {
      "text": "Power equal to Behemoth's...!",
      "status": "imported"
    },
    "voice_098:r_8927e6fb681aa809": {
      "text": "Even a Gundam won't stop me...!",
      "status": "imported"
    },
    "voice_098:r_665f01666859013b": {
      "text": "I've heard every last rumor...!",
      "status": "imported"
    },
    "voice_098:r_a571eec59b258d11": {
      "text": "A 21st Century Security robot...!",
      "status": "imported"
    },
    "voice_098:r_ddbe581c5ea9183d": {
      "text": "So you've joined the regime too...!",
      "status": "imported"
    },
    "voice_098:r_d4430bf362340b32": {
      "text": "Shame.\\nI felt for the Black Knights!",
      "status": "imported"
    },
    "voice_098:r_8f60f6fc86db3107": {
      "text": "Time for some payback.",
      "status": "imported"
    },
    "voice_098:r_b1de76a75a253c13": {
      "text": "You knew this would happen, right?",
      "status": "imported"
    },
    "voice_098:r_128c35bf3e0e394c": {
      "text": "Sorry, but I can't let you escape.",
      "status": "imported"
    },
    "voice_098:r_5213c17e13b23de0": {
      "text": "I won't take this lying down...!",
      "status": "imported"
    },
    "voice_098:r_38fdff9483e9245c": {
      "text": "Thanks for exposing your position!",
      "status": "imported"
    },
    "voice_098:r_620fedec67706d7d": {
      "text": "You don't flee very fast...!",
      "status": "imported"
    },
    "voice_098:r_9680dcd0fddcfcc7": {
      "text": "I'll follow up with an attack!",
      "status": "imported"
    },
    "voice_098:r_2a00f1044ad5cbaa": {
      "text": "Well done! Leave the rest to me!",
      "status": "imported"
    },
    "voice_098:r_3dbeead1bd3164ef": {
      "text": "I'll strike from Behemoth's shadow!",
      "status": "imported"
    },
    "voice_098:r_98d15b8cc09bc915": {
      "text": "I'll back you up, Wufei Chang!",
      "status": "imported"
    },
    "voice_098:r_46e86d000250e137": {
      "text": "Danger! Fall back for now!",
      "status": "imported"
    },
    "voice_098:r_ac341e7976e88f0b": {
      "text": "I'll take care of that one!",
      "status": "imported"
    },
    "voice_098:r_cdbd128a5b4127cc": {
      "text": "Run now,\\nand you're useless to me.",
      "status": "imported"
    },
    "voice_098:r_cfccaa1fbeda124c": {
      "text": "Don't whine over so little!",
      "status": "imported"
    },
    "voice_098:r_b1f8ec192b9c083a": {
      "text": "You're a comrade of mine now...!",
      "status": "imported"
    },
    "voice_098:r_5b9e8897190892eb": {
      "text": "So you got the better of me.",
      "status": "imported"
    },
    "voice_098:r_7bea3023abbf8a94": {
      "text": "So I'm out of options...",
      "status": "imported"
    },
    "voice_098:r_dd01a4c0d1b36a8d": {
      "text": "Can't counter...!? You got me!",
      "status": "imported"
    },
    "voice_098:r_20920ad2eb3542db": {
      "text": "I need to reposition, fast...!",
      "status": "imported"
    },
    "voice_098:r_0ab7914877fd48ed": {
      "text": "I'm caught in their trap...!?",
      "status": "imported"
    },
    "voice_098:r_cb846feec748c2e3": {
      "text": "How kind of you.",
      "status": "imported"
    },
    "voice_098:r_c958860b0676b1f5": {
      "text": "You seem softened by peace too.",
      "status": "imported"
    },
    "voice_098:r_5e2669b82ef75ce3": {
      "text": "This sort of thing makes me sick.",
      "status": "imported"
    },
    "voice_098:r_7847e0ed7dc9282d": {
      "text": "Your plan is painfully obvious...!",
      "status": "imported"
    },
    "voice_098:r_e42b52c7a987b906": {
      "text": "I knew you'd try that...!",
      "status": "imported"
    },
    "voice_098:r_6825fd1ff907bd22": {
      "text": "Don't take me so lightly...!",
      "status": "imported"
    },
    "voice_098:r_607f666f1563bc0d": {
      "text": "Their subordinate... How very kind.",
      "status": "imported"
    },
    "voice_098:r_97b7431eeb81e6b6": {
      "text": "Is that all that AS can do?",
      "status": "imported"
    },
    "voice_098:r_1252db29683fefe0": {
      "text": "All looks and no substance.",
      "status": "imported"
    },
    "voice_098:r_ad3d538f1e909184": {
      "text": "Had enough of the jokes?",
      "status": "imported"
    },
    "voice_098:r_8c61c59a1c0aebbf": {
      "text": "Are you trying to show me mercy?",
      "status": "imported"
    },
    "voice_098:r_aba6a7662129d8ce": {
      "text": "So naive...! Everything about you!",
      "status": "imported"
    },
    "voice_098:r_b84afafb8a33ec60": {
      "text": "Every last one of you is naive...!",
      "status": "imported"
    },
    "voice_098:r_c8c59db85bf875e6": {
      "text": "You think that can save the world!?",
      "status": "imported"
    },
    "voice_098:r_391aa56435d9dd6e": {
      "text": "That won't work.",
      "status": "imported"
    },
    "voice_098:r_7c796ba53bd7ea03": {
      "text": "Don't you get it? It's useless.",
      "status": "imported"
    },
    "voice_098:r_640327a12a559b31": {
      "text": "I will survive...!",
      "status": "imported"
    },
    "voice_098:r_bdd38c584fa313d0": {
      "text": "This won't stop me...!",
      "status": "imported"
    },
    "voice_098:r_3fd86c1027f317c8": {
      "text": "That island's hell drills were worse",
      "status": "imported"
    },
    "voice_098:r_d0372a183d2007ad": {
      "text": "I'll overcome both pain and fear...!",
      "status": "imported"
    },
    "voice_098:r_217aa5e1d545b44d": {
      "text": "If only everyone would vanish...!",
      "status": "imported"
    },
    "voice_098:r_381992c5d8224937": {
      "text": "Direct hit...!? I can still fight!",
      "status": "imported"
    },
    "voice_098:r_f1e7ed9e5874aba5": {
      "text": "You're as strong as I thought...!",
      "status": "imported"
    },
    "voice_098:r_fc25e66a86fc2c85": {
      "text": "That AS...\\nIt exceeds the data!?",
      "status": "imported"
    },
    "voice_098:r_5aeeb4917340c42d": {
      "text": "Hero of justice...\\nYou've earned it!",
      "status": "imported"
    },
    "voice_098:r_b765659981b6516d": {
      "text": "Is your company that important...!?",
      "status": "imported"
    },
    "voice_098:r_0c427458bc00eb95": {
      "text": "To you,\\nwe're surely evil's minions.",
      "status": "imported"
    },
    "voice_098:r_774a9ab4d8fd5351": {
      "text": "You\\nsupport this Earth Federation!?",
      "status": "imported"
    },
    "voice_098:r_d3f01de714c015bd": {
      "text": "Those bereft of ideals or creed...!",
      "status": "imported"
    },
    "voice_098:r_7d2617c809fead70": {
      "text": "You and I are equally despicable.",
      "status": "imported"
    },
    "voice_098:r_ceb935ccbf830724": {
      "text": "Heh... Free to fly the skies...",
      "status": "imported"
    },
    "voice_098:r_fa96676cc65bb509": {
      "text": "I cannot afford to stop...!",
      "status": "imported"
    },
    "voice_098:r_4e37f92e7d2fc62e": {
      "text": "Nothing is over yet...! That's why!",
      "status": "imported"
    },
    "voice_098:r_66ab4cfe1557909d": {
      "text": "As long as I live, I'll fight!",
      "status": "imported"
    },
    "voice_098:r_0bad405ee6ca63ba": {
      "text": "Takuma's fighting too...!\\nI am too!",
      "status": "imported"
    },
    "voice_098:r_2072eaf71a260ae7": {
      "text": "If I'm gone, what will Takuma do...!",
      "status": "imported"
    },
    "voice_098:r_6c13bbfd27a7799e": {
      "text": "Not yet!\\nTill I see the world burn!",
      "status": "imported"
    },
    "voice_098:r_06f88dcbd3c9e738": {
      "text": "I still haven't found anything!",
      "status": "imported"
    },
    "voice_098:r_b28faf9f71bc3598": {
      "text": "I'm not permitted to run away...!",
      "status": "imported"
    },
    "voice_098:r_8a29278549f8e07a": {
      "text": "My fight's not over!\\nIt can't end!",
      "status": "imported"
    },
    "voice_098:r_7e6c573c26177f98": {
      "text": "My fight... is still going!",
      "status": "imported"
    },
    "voice_098:r_45abf84f7757d6eb": {
      "text": "I can't end it yet...! Not yet...!",
      "status": "imported"
    },
    "voice_098:r_edd7a13ab8f06a14": {
      "text": "With this, everything... ends...",
      "status": "imported"
    },
    "voice_098:r_8165e5b41f0124c4": {
      "text": "I'll strike first!",
      "status": "imported"
    },
    "voice_098:r_4e05581b7432cce8": {
      "text": "I'll assist from here!",
      "status": "imported"
    },
    "voice_098:r_a60b107ea3c36a86": {
      "text": "First, I'll keep them in check...!",
      "status": "imported"
    },
    "voice_098:r_e33693e5ba4665b0": {
      "text": "We'll take them down one by one!",
      "status": "imported"
    },
    "voice_098:r_72a21a1a489af001": {
      "text": "If it's one-on-one!",
      "status": "imported"
    },
    "voice_098:r_eb643f8bf737a0ca": {
      "text": "I understand my role!",
      "status": "imported"
    }
  }
}
