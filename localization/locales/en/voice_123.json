{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_123:r_479b340ccc6c572b": {
      "text": "This is a battlefield...!",
      "status": "imported"
    },
    "voice_123:r_77949221bf58f862": {
      "text": "I trained so hard. I'll be fine...!",
      "status": "imported"
    },
    "voice_123:r_70b9c4b9f1f37eff": {
      "text": "It's not quite like a Medd, but...!",
      "status": "imported"
    },
    "voice_123:r_9fcb3754cb1773c7": {
      "text": "I'll have to do this on my own...!",
      "status": "imported"
    },
    "voice_123:r_3559d2fad32c2435": {
      "text": "Go!",
      "status": "imported"
    },
    "voice_123:r_f7570547e9f80a64": {
      "text": "Fall!",
      "status": "imported"
    },
    "voice_123:r_cbab0f4720e1fcf1": {
      "text": "There!",
      "status": "imported"
    },
    "voice_123:r_0bbe0b4f5364e732": {
      "text": "Sorry, but...!",
      "status": "imported"
    },
    "voice_123:r_5dda5198137cb02a": {
      "text": "I'll hit you!",
      "status": "imported"
    },
    "voice_123:r_83ec59afbecdec14": {
      "text": "Got you!",
      "status": "imported"
    },
    "voice_123:r_e20bfd42ad95a3c9": {
      "text": "I can do this too...!",
      "status": "imported"
    },
    "voice_123:r_0f58a8822381e57f": {
      "text": "You're wide open!",
      "status": "imported"
    },
    "voice_123:r_6dbcc507fb61b51d": {
      "text": "Don't hold it against me!",
      "status": "imported"
    },
    "voice_123:r_b42ab697149a7c8a": {
      "text": "Hathaway Noa, moving out!",
      "status": "imported"
    },
    "voice_123:r_4de4fcf3b440baf4": {
      "text": "Amuro managed it too!",
      "status": "imported"
    },
    "voice_123:r_0121a166c715cdff": {
      "text": "I'll survive by my own strength!",
      "status": "imported"
    },
    "voice_123:r_30fad37a42bd3ad3": {
      "text": "This isn't beyond me either!",
      "status": "imported"
    },
    "voice_123:r_80a0b2a84e05d81a": {
      "text": "I'll prove to Dad that I can do it!",
      "status": "imported"
    },
    "voice_123:r_4a9ac1dff86506d9": {
      "text": "I've come this far. I have to fight!",
      "status": "imported"
    },
    "voice_123:r_bc8538e6af3d2577": {
      "text": "I'll get Quess back...!",
      "status": "imported"
    },
    "voice_123:r_924516c8de2b5342": {
      "text": "Mom and Cheimin are on Earth!",
      "status": "imported"
    },
    "voice_123:r_da1174533722333f": {
      "text": "I have to stop Axis!",
      "status": "imported"
    },
    "voice_123:r_fdeb8162976e72c1": {
      "text": "I'm piloting a Gundam...!",
      "status": "imported"
    },
    "voice_123:r_0fadb5c26df92b42": {
      "text": "Now that I'm piloting a Gundam...!",
      "status": "imported"
    },
    "voice_123:r_6b15af9a0057cdc8": {
      "text": "If I use the Zeta's mobility...!",
      "status": "imported"
    },
    "voice_123:r_15b4a90140e8a33a": {
      "text": "Amuro's Gundam...\\nI'll master it...!",
      "status": "imported"
    },
    "voice_123:r_af884a6b11dff121": {
      "text": "A variable MS is hard to pilot...!",
      "status": "imported"
    },
    "voice_123:r_ac6fe7838e95647b": {
      "text": "In GM sims,\\nI've piloted endlessly!",
      "status": "imported"
    },
    "voice_123:r_77ca87eacd17ad52": {
      "text": "A simple build makes it easy to use!",
      "status": "imported"
    },
    "voice_123:r_bf3244994760e535": {
      "text": "I have to dive right in!",
      "status": "imported"
    },
    "voice_123:r_aabfb21c9d069ce7": {
      "text": "I have to handle close combat too!",
      "status": "imported"
    },
    "voice_123:r_02479dc8fe989560": {
      "text": "This way is faster!",
      "status": "imported"
    },
    "voice_123:r_a2df00f91a9b0a9e": {
      "text": "At this range, I won't miss!",
      "status": "imported"
    },
    "voice_123:r_48b60d6c48b9b142": {
      "text": "Try not to move so much...!",
      "status": "imported"
    },
    "voice_123:r_8927e6fb681aa809": {
      "text": "That's it, that's it. Stay there...!",
      "status": "imported"
    },
    "voice_123:r_665f01666859013b": {
      "text": "Sights... aligned!",
      "status": "imported"
    },
    "voice_123:r_a571eec59b258d11": {
      "text": "They say to read its moves, but...!",
      "status": "imported"
    },
    "voice_123:r_ddbe581c5ea9183d": {
      "text": "Funnel!",
      "status": "imported"
    },
    "voice_123:r_faae935cca0edc72": {
      "text": "Faaaall!",
      "status": "imported"
    },
    "voice_123:r_d4430bf362340b32": {
      "text": "Funnel, go!",
      "status": "imported"
    },
    "voice_123:r_6ff1323b355593e0": {
      "text": "This'll do it!",
      "status": "imported"
    },
    "voice_123:r_b7b5625d7cd4282f": {
      "text": "I'll finish this in one go!",
      "status": "imported"
    },
    "voice_123:r_36133ad73a73ef98": {
      "text": "If I use the Fin Funnel!",
      "status": "imported"
    },
    "voice_123:r_3633df5b7b8f47fa": {
      "text": "Fin Funnel!",
      "status": "imported"
    },
    "voice_123:r_55417493fce1d347": {
      "text": "It's that Beam Confuse move!",
      "status": "imported"
    },
    "voice_123:r_8fdf5910927c9591": {
      "text": "It's okay. Even I can do this...!",
      "status": "imported"
    },
    "voice_123:r_7d724dbcc4451e10": {
      "text": "Power gathers... then spreads...!",
      "status": "imported"
    },
    "voice_123:r_93e25418a203cb8f": {
      "text": "Uooooooooh!!",
      "status": "imported"
    },
    "voice_123:r_adeb0a29274d3d9b": {
      "text": "A voice...? No, someone's will...?",
      "status": "imported"
    },
    "voice_123:r_24cf161287ef9d5c": {
      "text": "Power is gathering in the Zeta...!",
      "status": "imported"
    },
    "voice_123:r_8f60f6fc86db3107": {
      "text": "Gooooooo!",
      "status": "imported"
    },
    "voice_123:r_2a00f1044ad5cbaa": {
      "text": "Firing!",
      "status": "imported"
    },
    "voice_123:r_46e86d000250e137": {
      "text": "Yaaaaaaa!",
      "status": "imported"
    },
    "voice_123:r_5391b24a71eb10ae": {
      "text": "I can still fight!",
      "status": "imported"
    },
    "voice_123:r_a554ceef5c87b972": {
      "text": "An opening...?! Then I'll strike!",
      "status": "imported"
    },
    "voice_123:r_546c3d5937fbb7ee": {
      "text": "We can't just trade insults,\\nQuess!",
      "status": "imported"
    },
    "voice_123:r_1568ff6298b12b96": {
      "text": "If this alone saves Quess,\\nthen...!",
      "status": "imported"
    },
    "voice_123:r_2c9d94ba13c5fc50": {
      "text": "You've turned Quess into a machine!",
      "status": "imported"
    },
    "voice_123:r_a77f4913375098d2": {
      "text": "Char! If only you weren't here!",
      "status": "imported"
    },
    "voice_123:r_428c2116ac3071b1": {
      "text": "Quess isn't like any of you!",
      "status": "imported"
    },
    "voice_123:r_84c116267b79f540": {
      "text": "I won't hand Quess over to you!",
      "status": "imported"
    },
    "voice_123:r_dad38ee29af2df3a": {
      "text": "What is this thing? Is it Char...?!",
      "status": "imported"
    },
    "voice_123:r_3d32e86f8dc80909": {
      "text": "You're just Full Frontal's lackey!",
      "status": "imported"
    },
    "voice_123:r_70451ffbabe2f876": {
      "text": "Adults who only spew hatred...!",
      "status": "imported"
    },
    "voice_123:r_69dfa1659715e2fa": {
      "text": "Don't cling to self-righteous views!",
      "status": "imported"
    },
    "voice_123:r_d996fd6d4ef5b329": {
      "text": "Does Zeon want war that badly?!",
      "status": "imported"
    },
    "voice_123:r_8ab47a28f99ef565": {
      "text": "You take everything way too far!",
      "status": "imported"
    },
    "voice_123:r_546de3fb6db156ea": {
      "text": "This is why adults are so...!",
      "status": "imported"
    },
    "voice_123:r_ca85f87cee5e31f7": {
      "text": "If adults won't,\\nkids have to try!",
      "status": "imported"
    },
    "voice_123:r_9072ea7bc71df136": {
      "text": "The war is over! Please understand!",
      "status": "imported"
    },
    "voice_123:r_04e815a8d425827d": {
      "text": "That pressure means nothing!",
      "status": "imported"
    },
    "voice_123:r_d89011fe3e5d082a": {
      "text": "Turning people into tools of war...!",
      "status": "imported"
    },
    "voice_123:r_3c5b0c2ac812d5de": {
      "text": "Like Quess...! They're being used!",
      "status": "imported"
    },
    "voice_123:r_5b9e8897190892eb": {
      "text": "W-what?\\nIt feels like a heart...!",
      "status": "imported"
    },
    "voice_123:r_7bea3023abbf8a94": {
      "text": "I must fight now, but someday...!",
      "status": "imported"
    },
    "voice_123:r_dd01a4c0d1b36a8d": {
      "text": "Keep this from\\nCheimin and everyone!",
      "status": "imported"
    },
    "voice_123:r_20920ad2eb3542db": {
      "text": "Now even this monster's here...!",
      "status": "imported"
    },
    "voice_123:r_0ab7914877fd48ed": {
      "text": "Let it pass,\\nand Earth is doomed!",
      "status": "imported"
    },
    "voice_123:r_cb846feec748c2e3": {
      "text": "I'll protect Earth, no matter what!",
      "status": "imported"
    },
    "voice_123:r_c958860b0676b1f5": {
      "text": "Different stars,\\nyet they attack...!",
      "status": "imported"
    },
    "voice_123:r_5e2669b82ef75ce3": {
      "text": "This is no time to be fighting...!",
      "status": "imported"
    },
    "voice_123:r_7847e0ed7dc9282d": {
      "text": "You mustn't do things like that!",
      "status": "imported"
    },
    "voice_123:r_e42b52c7a987b906": {
      "text": "Even the enemy has a Gundam...!",
      "status": "imported"
    },
    "voice_123:r_6825fd1ff907bd22": {
      "text": "I'll make a world where all smile!",
      "status": "imported"
    },
    "voice_123:r_607f666f1563bc0d": {
      "text": "I trust that Psycho-Frame\\nlight...!",
      "status": "imported"
    },
    "voice_123:r_ad3d538f1e909184": {
      "text": "Fight back...! I have to fight back!",
      "status": "imported"
    },
    "voice_123:r_8c61c59a1c0aebbf": {
      "text": "If I can fight back...!",
      "status": "imported"
    },
    "voice_123:r_aba6a7662129d8ce": {
      "text": "I should've finished them off!",
      "status": "imported"
    },
    "voice_123:r_b84afafb8a33ec60": {
      "text": "An escape would mean trouble...!",
      "status": "imported"
    },
    "voice_123:r_c8c59db85bf875e6": {
      "text": "Sorry, but now it's my turn!",
      "status": "imported"
    },
    "voice_123:r_391aa56435d9dd6e": {
      "text": "I won't just keep taking hits!",
      "status": "imported"
    },
    "voice_123:r_7c796ba53bd7ea03": {
      "text": "I'll keep going!",
      "status": "imported"
    },
    "voice_123:r_fa944da4b6519006": {
      "text": "While my opponent's off guard!",
      "status": "imported"
    },
    "voice_123:r_95d047bcc17fccc6": {
      "text": "So that's how ace pilots fight...!",
      "status": "imported"
    },
    "voice_123:r_640327a12a559b31": {
      "text": "That's Amuro for you!",
      "status": "imported"
    },
    "voice_123:r_bdd38c584fa313d0": {
      "text": "Dad, leave the rest to me!",
      "status": "imported"
    },
    "voice_123:r_3fd86c1027f317c8": {
      "text": "I have to show Quess I can do this!",
      "status": "imported"
    },
    "voice_123:r_d0372a183d2007ad": {
      "text": "That man really is like a comet...!",
      "status": "imported"
    },
    "voice_123:r_217aa5e1d545b44d": {
      "text": "I can't lose to that one!",
      "status": "imported"
    },
    "voice_123:r_381992c5d8224937": {
      "text": "I'm up after Kamille!",
      "status": "imported"
    },
    "voice_123:r_f1e7ed9e5874aba5": {
      "text": "Katz is giving it everything too!",
      "status": "imported"
    },
    "voice_123:r_fc25e66a86fc2c85": {
      "text": "Captain Otto, I'll cover you!",
      "status": "imported"
    },
    "voice_123:r_5aeeb4917340c42d": {
      "text": "Gundams really are amazing!",
      "status": "imported"
    },
    "voice_123:r_b765659981b6516d": {
      "text": "I can at least act as a shield!",
      "status": "imported"
    },
    "voice_123:r_0c427458bc00eb95": {
      "text": "I'll protect you!",
      "status": "imported"
    },
    "voice_123:r_774a9ab4d8fd5351": {
      "text": "I won't let them take Amuro down!",
      "status": "imported"
    },
    "voice_123:r_d3f01de714c015bd": {
      "text": "Dad! Pull the Ra Cailum back!",
      "status": "imported"
    },
    "voice_123:r_7d2617c809fead70": {
      "text": "I'll protect Quess!",
      "status": "imported"
    },
    "voice_123:r_ceb935ccbf830724": {
      "text": "This is just pathetic!",
      "status": "imported"
    },
    "voice_123:r_862ef7385bf2abd4": {
      "text": "Aren't you protecting Quess?!",
      "status": "imported"
    },
    "voice_123:r_001cbec4d9a4283f": {
      "text": "Kamille, fall back!",
      "status": "imported"
    },
    "voice_123:r_8ad40afecd02b41e": {
      "text": "Katz, you're pushing too hard!",
      "status": "imported"
    },
    "voice_123:r_26e5efec03c03d78": {
      "text": "Captain Otto, fall back now!",
      "status": "imported"
    },
    "voice_123:r_4ad81e88c7557a8b": {
      "text": "Even a Gundam isn't invincible!",
      "status": "imported"
    },
    "voice_123:r_1f65a7af190e4674": {
      "text": "Damn! I can't counter like this!",
      "status": "imported"
    },
    "voice_123:r_40c5a9358ed5bf29": {
      "text": "At this rate, I'm just a target!",
      "status": "imported"
    },
    "voice_123:r_f2e18dfdfe0c89ea": {
      "text": "Stay calm...!\\nPanic won't help!",
      "status": "imported"
    },
    "voice_123:r_cf7dbf49e96a5755": {
      "text": "Ah... Ah...! They're getting away!",
      "status": "imported"
    },
    "voice_123:r_fa96676cc65bb509": {
      "text": "I can't attack them from here...!",
      "status": "imported"
    },
    "voice_123:r_4e37f92e7d2fc62e": {
      "text": "Huh...?! Where did that come from?!",
      "status": "imported"
    },
    "voice_123:r_66ab4cfe1557909d": {
      "text": "You won't hit me!",
      "status": "imported"
    },
    "voice_123:r_0bad405ee6ca63ba": {
      "text": "It missed me...!",
      "status": "imported"
    },
    "voice_123:r_2072eaf71a260ae7": {
      "text": "Even I managed to dodge it!",
      "status": "imported"
    },
    "voice_123:r_6c13bbfd27a7799e": {
      "text": "Just now, I sensed a presence...!",
      "status": "imported"
    },
    "voice_123:r_06f88dcbd3c9e738": {
      "text": "Good...! I'll keep this up!",
      "status": "imported"
    },
    "voice_123:r_b28faf9f71bc3598": {
      "text": "Survival has to come first...!",
      "status": "imported"
    },
    "voice_123:r_8a29278549f8e07a": {
      "text": "I'm a Gundam pilot now!",
      "status": "imported"
    },
    "voice_123:r_7e6c573c26177f98": {
      "text": "Good...! I'm adapting to space!",
      "status": "imported"
    },
    "voice_123:r_45abf84f7757d6eb": {
      "text": "Acting like that only makes enemies!",
      "status": "imported"
    },
    "voice_123:r_edd7a13ab8f06a14": {
      "text": "Stop this now, Quess!",
      "status": "imported"
    },
    "voice_123:r_8165e5b41f0124c4": {
      "text": "Even if I'm facing the Red Comet...!",
      "status": "imported"
    },
    "voice_123:r_72a21a1a489af001": {
      "text": "That won't work on me!",
      "status": "imported"
    },
    "voice_123:r_eb643f8bf737a0ca": {
      "text": "I'm telling you, it's useless!",
      "status": "imported"
    },
    "voice_123:r_8356f4e3dcdff938": {
      "text": "What is this...?! A barrier?!",
      "status": "imported"
    },
    "voice_123:r_1d6d784036ae0bd7": {
      "text": "The Fin Funnel protected me...!",
      "status": "imported"
    },
    "voice_123:r_625664af02183c17": {
      "text": "Huh... Ah... It hit me...?!",
      "status": "imported"
    },
    "voice_123:r_3701cba361f80ea5": {
      "text": "S-so this is a real battle...!",
      "status": "imported"
    },
    "voice_123:r_63f429c5c68c0863": {
      "text": "I knew it was coming, but...!",
      "status": "imported"
    },
    "voice_123:r_38e4a434c91d8ef0": {
      "text": "I'm fine! It only grazed me!",
      "status": "imported"
    },
    "voice_123:r_98ed411352a3a6ac": {
      "text": "I won't lose heart...!",
      "status": "imported"
    },
    "voice_123:r_4824bea6bab3af67": {
      "text": "You...! How dare you!",
      "status": "imported"
    },
    "voice_123:r_862b92e63adb9734": {
      "text": "Uwah! Uwaaah!",
      "status": "imported"
    },
    "voice_123:r_cb306ef55e49d107": {
      "text": "It really differs from a sim...!",
      "status": "imported"
    },
    "voice_123:r_57b2bd2de8a1408d": {
      "text": "No! At this rate, they'll get me!",
      "status": "imported"
    },
    "voice_123:r_76f080a4881e8ab5": {
      "text": "I can't go down in front of Dad...!",
      "status": "imported"
    },
    "voice_123:r_288133bc5b573dae": {
      "text": "Ugh! Where did they hit me?!",
      "status": "imported"
    },
    "voice_123:r_6f95653e548f8fcf": {
      "text": "I think I'm probably still okay...!",
      "status": "imported"
    },
    "voice_123:r_d249d68bada91ab9": {
      "text": "Did I adapt to space too slowly...?!",
      "status": "imported"
    },
    "voice_123:r_e9b3307e9eb69f11": {
      "text": "Pathetic...!\\nEven in a Gundam!",
      "status": "imported"
    },
    "voice_123:r_03cdac73042343ee": {
      "text": "I can't get Quess back like this...!",
      "status": "imported"
    },
    "voice_123:r_6026da5acbda7c69": {
      "text": "Get out of that machine, Quess!",
      "status": "imported"
    },
    "voice_123:r_981f8fedd5414fe5": {
      "text": "See that face,\\nand the anger fades!",
      "status": "imported"
    },
    "voice_123:r_96bb0dcde0c8c44a": {
      "text": "I-it really is the Red Comet...!",
      "status": "imported"
    },
    "voice_123:r_641550a2f54cb456": {
      "text": "Strong...! But even scarier...!",
      "status": "imported"
    },
    "voice_123:r_eb5f687fcd372ae7": {
      "text": "Uwaaah! Dad! Mom!",
      "status": "imported"
    },
    "voice_123:r_2329428a6871d9fa": {
      "text": "I-I didn't come here\\nto die...!",
      "status": "imported"
    },
    "voice_123:r_0e7466971bec4cc4": {
      "text": "My Medd loan\\nisn't paid off yet...!",
      "status": "imported"
    },
    "voice_123:r_efa71f7a4cc33ff3": {
      "text": "Calm down!\\nCalm down, Hathaway...!",
      "status": "imported"
    },
    "voice_123:r_3fc2e1186557e7a0": {
      "text": "No! I haven't done anything yet...!",
      "status": "imported"
    },
    "voice_123:r_fa6930340a545054": {
      "text": "I wrote my will!\\nBut still...!",
      "status": "imported"
    },
    "voice_123:r_2332b9d56461d7ab": {
      "text": "Aah! Dad... Daaad!!",
      "status": "imported"
    },
    "voice_123:r_854aa0a91a3c80d1": {
      "text": "N-no! I have to eject!",
      "status": "imported"
    },
    "voice_123:r_0bc8ae32a406ceab": {
      "text": "Is this really my limit...?!",
      "status": "imported"
    },
    "voice_123:r_82c09f011d703b2c": {
      "text": "Quess! Why are you doing this...?!",
      "status": "imported"
    },
    "voice_123:r_2b4d8818c77b6dca": {
      "text": "Don't push yourself, Quess. Rest up!",
      "status": "imported"
    },
    "voice_123:r_087354f2db0a31e6": {
      "text": "Mine's the same. Health comes first!",
      "status": "imported"
    },
    "voice_123:r_db02a2dec93dd263": {
      "text": "Let's say goodbye. See you again!",
      "status": "imported"
    },
    "voice_123:r_11517cc7b0494dbf": {
      "text": "Quess is in this light...!",
      "status": "imported"
    },
    "voice_123:r_be661448b85d0009": {
      "text": "I can at least hold them off!",
      "status": "imported"
    },
    "voice_123:r_958a56c1151cab9e": {
      "text": "I can at least keep them in check!",
      "status": "imported"
    },
    "voice_123:r_8b18aa4cc69547df": {
      "text": "I'll leave the rest to you!",
      "status": "imported"
    },
    "voice_123:r_3e87f6fc3ea65aef": {
      "text": "I'll assist you!",
      "status": "imported"
    },
    "voice_123:r_5508a7bfa9074eb9": {
      "text": "So that's our target...!",
      "status": "imported"
    },
    "voice_123:r_09a003e91f0d5dc7": {
      "text": "It's one-on-one! I have to do this!",
      "status": "imported"
    },
    "voice_123:r_192447448ebd7bb5": {
      "text": "I can't be a burden to the others!",
      "status": "imported"
    },
    "voice_123:r_e92920ba4b301b9f": {
      "text": "For now, I have to draw them in!",
      "status": "imported"
    }
  }
}
