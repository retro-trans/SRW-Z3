{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_127:r_479b340ccc6c572b": {
      "text": "Gotcha!",
      "status": "imported"
    },
    "voice_127:r_ca4acbac57a2a35e": {
      "text": "All right!",
      "status": "imported"
    },
    "voice_127:r_77949221bf58f862": {
      "text": "Now's my chance!",
      "status": "imported"
    },
    "voice_127:r_70b9c4b9f1f37eff": {
      "text": "Outta my way!",
      "status": "imported"
    },
    "voice_127:r_9fcb3754cb1773c7": {
      "text": "Eat this!",
      "status": "imported"
    },
    "voice_127:r_3559d2fad32c2435": {
      "text": "I said go down!",
      "status": "imported"
    },
    "voice_127:r_f7570547e9f80a64": {
      "text": "I can see right through you!",
      "status": "imported"
    },
    "voice_127:r_cbab0f4720e1fcf1": {
      "text": "I'll get it done, Colonel!",
      "status": "imported"
    },
    "voice_127:r_0bbe0b4f5364e732": {
      "text": "I'll crush you in one fell swoop!",
      "status": "imported"
    },
    "voice_127:r_5dda5198137cb02a": {
      "text": "We just gotta win, right?!",
      "status": "imported"
    },
    "voice_127:r_83ec59afbecdec14": {
      "text": "You think that's enough distance?!",
      "status": "imported"
    },
    "voice_127:r_e20bfd42ad95a3c9": {
      "text": "You're not out of my reach!",
      "status": "imported"
    },
    "voice_127:r_0f58a8822381e57f": {
      "text": "Graah!",
      "status": "imported"
    },
    "voice_127:r_6dbcc507fb61b51d": {
      "text": "Why, you...!",
      "status": "imported"
    },
    "voice_127:r_b42ab697149a7c8a": {
      "text": "Hraaaah!",
      "status": "imported"
    },
    "voice_127:r_4de4fcf3b440baf4": {
      "text": "Hyah!",
      "status": "imported"
    },
    "voice_127:r_0121a166c715cdff": {
      "text": "This is where act two begins!",
      "status": "imported"
    },
    "voice_127:r_30fad37a42bd3ad3": {
      "text": "Don't let your guard down!",
      "status": "imported"
    },
    "voice_127:r_80a0b2a84e05d81a": {
      "text": "There you are, Gundam!",
      "status": "imported"
    },
    "voice_127:r_4a9ac1dff86506d9": {
      "text": "I'll show you what humans can do!",
      "status": "imported"
    },
    "voice_127:r_bc8538e6af3d2577": {
      "text": "You monster!\\nDon't touch my Colonel!",
      "status": "imported"
    },
    "voice_127:r_924516c8de2b5342": {
      "text": "Evil alien!\\nEarth is out of reach!",
      "status": "imported"
    },
    "voice_127:r_da1174533722333f": {
      "text": "Keep your hands off our Earth!",
      "status": "imported"
    },
    "voice_127:r_fdeb8162976e72c1": {
      "text": "We'll beat anyone!\\nVictory is ours!",
      "status": "imported"
    },
    "voice_127:r_0fadb5c26df92b42": {
      "text": "Last target set!\\nI'm off, Colonel!",
      "status": "imported"
    },
    "voice_127:r_b7b5625d7cd4282f": {
      "text": "Trans-Am!",
      "status": "imported"
    },
    "voice_127:r_36133ad73a73ef98": {
      "text": "Graaaaaah!",
      "status": "imported"
    },
    "voice_127:r_920740a0219c5085": {
      "text": "This is the eeeend!",
      "status": "imported"
    },
    "voice_127:r_a8451712c57c1a72": {
      "text": "Here's my trump card!",
      "status": "imported"
    },
    "voice_127:r_3633df5b7b8f47fa": {
      "text": "Hyaaaaaah!",
      "status": "imported"
    },
    "voice_127:r_52dfc56b14b93551": {
      "text": "Time for the finishing blow!",
      "status": "imported"
    },
    "voice_127:r_1b9b2aab5cb104da": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_127:r_342044c706a2340f": {
      "text": "Got you now!",
      "status": "imported"
    },
    "voice_127:r_cf41e8828a90cbdb": {
      "text": "Sink already!",
      "status": "imported"
    },
    "voice_127:r_55417493fce1d347": {
      "text": "Where do you think you're going?!",
      "status": "imported"
    },
    "voice_127:r_8fdf5910927c9591": {
      "text": "You're not getting away!",
      "status": "imported"
    },
    "voice_127:r_7d724dbcc4451e10": {
      "text": "You dare hit me?\\nYou've got nerve!",
      "status": "imported"
    },
    "voice_127:r_93e25418a203cb8f": {
      "text": "You won't get away with that!",
      "status": "imported"
    },
    "voice_127:r_adeb0a29274d3d9b": {
      "text": "I'll make sure to pay you back!",
      "status": "imported"
    },
    "voice_127:r_24cf161287ef9d5c": {
      "text": "I'll stop you here, no matter what!",
      "status": "imported"
    },
    "voice_127:r_8f60f6fc86db3107": {
      "text": "Leave the rest to me!",
      "status": "imported"
    },
    "voice_127:r_b1de76a75a253c13": {
      "text": "The Happy Colasour is here!",
      "status": "imported"
    },
    "voice_127:r_128c35bf3e0e394c": {
      "text": "The star can't afford to be late!",
      "status": "imported"
    },
    "voice_127:r_5213c17e13b23de0": {
      "text": "Roger! I'll support Gundam!",
      "status": "imported"
    },
    "voice_127:r_38fdff9483e9245c": {
      "text": "I'll take the glory, Gundam!",
      "status": "imported"
    },
    "voice_127:r_620fedec67706d7d": {
      "text": "Celestial Being!\\nLeave this to me!",
      "status": "imported"
    },
    "voice_127:r_9680dcd0fddcfcc7": {
      "text": "Top Gun's still going strong!",
      "status": "imported"
    },
    "voice_127:r_2a00f1044ad5cbaa": {
      "text": "Love advice isn't all I'm good for!",
      "status": "imported"
    },
    "voice_127:r_3dbeead1bd3164ef": {
      "text": "Not gonna happen!",
      "status": "imported"
    },
    "voice_127:r_98d15b8cc09bc915": {
      "text": "Special offer! I'll save you!",
      "status": "imported"
    },
    "voice_127:r_46e86d000250e137": {
      "text": "Why am I helping Gundam...?!",
      "status": "imported"
    },
    "voice_127:r_ac341e7976e88f0b": {
      "text": "Move it, Gundam!",
      "status": "imported"
    },
    "voice_127:r_cdbd128a5b4127cc": {
      "text": "Colonel asked me to protect you!",
      "status": "imported"
    },
    "voice_127:r_cfccaa1fbeda124c": {
      "text": "Leave this to me, Graham!",
      "status": "imported"
    },
    "voice_127:r_b1f8ec192b9c083a": {
      "text": "Too soon to follow the Wild Bear!",
      "status": "imported"
    },
    "voice_127:r_a007f9ab9cf048b3": {
      "text": "My big moment was finally here...!",
      "status": "imported"
    },
    "voice_127:r_ddafde4b065ced49": {
      "text": "Huh?! You call me useless?!",
      "status": "imported"
    },
    "voice_127:r_de1213040856c089": {
      "text": "Who the hell just attacked me?!",
      "status": "imported"
    },
    "voice_127:r_3304412ac41f47a6": {
      "text": "That was a dirty trick!",
      "status": "imported"
    },
    "voice_127:r_0c0775e051211840": {
      "text": "If you're coming, get in my range!",
      "status": "imported"
    },
    "voice_127:r_a2afffe1c396f0b3": {
      "text": "You're too soft!",
      "status": "imported"
    },
    "voice_127:r_13c25fbdfddc8a24": {
      "text": "Never doubt my skill or my luck!",
      "status": "imported"
    },
    "voice_127:r_42ba1ecb310b4bd7": {
      "text": "Come back ready to lose your head!",
      "status": "imported"
    },
    "voice_127:r_d692f1d420460a47": {
      "text": "Just as I predicted!",
      "status": "imported"
    },
    "voice_127:r_a5643cec86b18bd2": {
      "text": "Sheesh, what kinda amateur are you?!",
      "status": "imported"
    },
    "voice_127:r_68f2dfab20a4a30e": {
      "text": "Heh heh, how was that?!",
      "status": "imported"
    },
    "voice_127:r_9cedad8237480563": {
      "text": "I've got ace-class skills!",
      "status": "imported"
    },
    "voice_127:r_a03fabecba1508ca": {
      "text": "Trying to hit me is pointless!",
      "status": "imported"
    },
    "voice_127:r_5391b24a71eb10ae": {
      "text": "What a pathetic move, Gundam!",
      "status": "imported"
    },
    "voice_127:r_a554ceef5c87b972": {
      "text": "That won't work on me!",
      "status": "imported"
    },
    "voice_127:r_546c3d5937fbb7ee": {
      "text": "Bwa ha ha!",
      "status": "imported"
    },
    "voice_127:r_2c9d94ba13c5fc50": {
      "text": "This thing's incredible...!",
      "status": "imported"
    },
    "voice_127:r_428c2116ac3071b1": {
      "text": "Whoa! What the hell?!",
      "status": "imported"
    },
    "voice_127:r_84c116267b79f540": {
      "text": "Aiming at me?\\nFame sure is tough!",
      "status": "imported"
    },
    "voice_127:r_dad38ee29af2df3a": {
      "text": "Huh? Did that hit me?",
      "status": "imported"
    },
    "voice_127:r_3d32e86f8dc80909": {
      "text": "Hah, dumb luck.\\nNever again!",
      "status": "imported"
    },
    "voice_127:r_70451ffbabe2f876": {
      "text": "How dare you scratch my machine!",
      "status": "imported"
    },
    "voice_127:r_69dfa1659715e2fa": {
      "text": "Don't get cocky, you bastard!",
      "status": "imported"
    },
    "voice_127:r_d996fd6d4ef5b329": {
      "text": "Whoa! You made a fool of me!",
      "status": "imported"
    },
    "voice_127:r_8ab47a28f99ef565": {
      "text": "Huh, you're pretty good...!",
      "status": "imported"
    },
    "voice_127:r_546de3fb6db156ea": {
      "text": "You know my machine's blind spot?!",
      "status": "imported"
    },
    "voice_127:r_ca85f87cee5e31f7": {
      "text": "Hah!\\nIt's about time I got serious!",
      "status": "imported"
    },
    "voice_127:r_9072ea7bc71df136": {
      "text": "Gah, you actually hit me!",
      "status": "imported"
    },
    "voice_127:r_04e815a8d425827d": {
      "text": "You flanked me?! When did you...!",
      "status": "imported"
    },
    "voice_127:r_d89011fe3e5d082a": {
      "text": "Ngh! Look at you try, punk!",
      "status": "imported"
    },
    "voice_127:r_3c5b0c2ac812d5de": {
      "text": "Gah! Still\\nsuch a pain, Gundam!",
      "status": "imported"
    },
    "voice_127:r_5b9e8897190892eb": {
      "text": "Waaaaah!!\\nHuh? I'm alive...!",
      "status": "imported"
    },
    "voice_127:r_7bea3023abbf8a94": {
      "text": "The Undying Colasour lives on!",
      "status": "imported"
    },
    "voice_127:r_dd01a4c0d1b36a8d": {
      "text": "I won't die! Gundam\\nnever killed me!",
      "status": "imported"
    },
    "voice_127:r_20920ad2eb3542db": {
      "text": "I'll never give up! Not ever!",
      "status": "imported"
    },
    "voice_127:r_0ab7914877fd48ed": {
      "text": "I'm beat up...\\nBut weapons work...!",
      "status": "imported"
    },
    "voice_127:r_cb846feec748c2e3": {
      "text": "Graah! Like hell I'll go down!",
      "status": "imported"
    },
    "voice_127:r_c958860b0676b1f5": {
      "text": "Gaaah! I-I'll turn this around!",
      "status": "imported"
    },
    "voice_127:r_5e2669b82ef75ce3": {
      "text": "Damn! How can you be this strong?!",
      "status": "imported"
    },
    "voice_127:r_7847e0ed7dc9282d": {
      "text": "Again? Again?\\nGundam won't down me!",
      "status": "imported"
    },
    "voice_127:r_e42b52c7a987b906": {
      "text": "Not again?!",
      "status": "imported"
    },
    "voice_127:r_6825fd1ff907bd22": {
      "text": "What?! Whoaaaa!",
      "status": "imported"
    },
    "voice_127:r_607f666f1563bc0d": {
      "text": "C-Coloneeeel!",
      "status": "imported"
    },
    "voice_127:r_97b7431eeb81e6b6": {
      "text": "The vanguard is a warrior's honor!",
      "status": "imported"
    },
    "voice_127:r_132f605d02975e71": {
      "text": "My enemy is... Oh, you're it!",
      "status": "imported"
    },
    "voice_127:r_9b9726b1872759d6": {
      "text": "You're unlucky to be facing me!",
      "status": "imported"
    }
  }
}
