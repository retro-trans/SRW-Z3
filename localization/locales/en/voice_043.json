{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_043:r_479b340ccc6c572b": {
      "text": "Skull 1 here! Commencing attack!",
      "status": "imported"
    },
    "voice_043:r_ca4acbac57a2a35e": {
      "text": "Skull Leader to all units!\\nMove out!",
      "status": "imported"
    },
    "voice_043:r_77949221bf58f862": {
      "text": "Not on my watch!",
      "status": "imported"
    },
    "voice_043:r_70b9c4b9f1f37eff": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_043:r_9fcb3754cb1773c7": {
      "text": "Got you!",
      "status": "imported"
    },
    "voice_043:r_3559d2fad32c2435": {
      "text": "I'll shoot you down!",
      "status": "imported"
    },
    "voice_043:r_f7570547e9f80a64": {
      "text": "There you are!",
      "status": "imported"
    },
    "voice_043:r_cbab0f4720e1fcf1": {
      "text": "You won't get away!",
      "status": "imported"
    },
    "voice_043:r_0bbe0b4f5364e732": {
      "text": "I'll show you how to fight!",
      "status": "imported"
    },
    "voice_043:r_5dda5198137cb02a": {
      "text": "I never miss my mark!",
      "status": "imported"
    },
    "voice_043:r_83ec59afbecdec14": {
      "text": "Target locked!",
      "status": "imported"
    },
    "voice_043:r_e20bfd42ad95a3c9": {
      "text": "I didn't make captain for nothing!",
      "status": "imported"
    },
    "voice_043:r_0f58a8822381e57f": {
      "text": "Too slow! Here's another!",
      "status": "imported"
    },
    "voice_043:r_6dbcc507fb61b51d": {
      "text": "Once I start, I finish the job!",
      "status": "imported"
    },
    "voice_043:r_15b4a90140e8a33a": {
      "text": "Payback time! No holding back!",
      "status": "imported"
    },
    "voice_043:r_af884a6b11dff121": {
      "text": "Time to return the favor!",
      "status": "imported"
    },
    "voice_043:r_ac6fe7838e95647b": {
      "text": "Too slow getting back in position!",
      "status": "imported"
    },
    "voice_043:r_77ca87eacd17ad52": {
      "text": "I'm not taking this lying down!",
      "status": "imported"
    },
    "voice_043:r_bf3244994760e535": {
      "text": "You missed your chance to win!",
      "status": "imported"
    },
    "voice_043:r_aabfb21c9d069ce7": {
      "text": "One shot didn't kill me.\\nYou lose!",
      "status": "imported"
    },
    "voice_043:r_02479dc8fe989560": {
      "text": "Vajra sighted! Commencing attack!",
      "status": "imported"
    },
    "voice_043:r_a2df00f91a9b0a9e": {
      "text": "Vajra alone\\nare monsters enough!",
      "status": "imported"
    },
    "voice_043:r_48b60d6c48b9b142": {
      "text": "Never thought\\nI'd fight your kind!",
      "status": "imported"
    },
    "voice_043:r_8927e6fb681aa809": {
      "text": "A soldier who just obeys. Pitiful!",
      "status": "imported"
    },
    "voice_043:r_a571eec59b258d11": {
      "text": "A big one! This one's mine!",
      "status": "imported"
    },
    "voice_043:r_ddbe581c5ea9183d": {
      "text": "For my girl waiting, I'll end you!",
      "status": "imported"
    },
    "voice_043:r_847f82e7f3eef651": {
      "text": "I'll aim straight for the vitals!",
      "status": "imported"
    },
    "voice_043:r_eb7ae28b53dc033c": {
      "text": "A knife is all in how you use it!",
      "status": "imported"
    },
    "voice_043:r_8f60f6fc86db3107": {
      "text": "See how this machine can move!",
      "status": "imported"
    },
    "voice_043:r_b1de76a75a253c13": {
      "text": "Come on! Over here, over here!",
      "status": "imported"
    },
    "voice_043:r_128c35bf3e0e394c": {
      "text": "Hraaaaaah!!",
      "status": "imported"
    },
    "voice_043:r_5213c17e13b23de0": {
      "text": "Well, that's about the size of it!",
      "status": "imported"
    },
    "voice_043:r_38fdff9483e9245c": {
      "text": "Think you can keep up with me?",
      "status": "imported"
    },
    "voice_043:r_620fedec67706d7d": {
      "text": "Where are you looking?!",
      "status": "imported"
    },
    "voice_043:r_9680dcd0fddcfcc7": {
      "text": "Time to put an end to this!!",
      "status": "imported"
    },
    "voice_043:r_2a00f1044ad5cbaa": {
      "text": "All right, next!",
      "status": "imported"
    },
    "voice_043:r_3dbeead1bd3164ef": {
      "text": "First, I'll pin down the leader!",
      "status": "imported"
    },
    "voice_043:r_46e86d000250e137": {
      "text": "This'll do it...!",
      "status": "imported"
    },
    "voice_043:r_ac341e7976e88f0b": {
      "text": "I'll put an end to this!!",
      "status": "imported"
    },
    "voice_043:r_cdbd128a5b4127cc": {
      "text": "I marked you.\\nYour luck ran out.",
      "status": "imported"
    },
    "voice_043:r_cfccaa1fbeda124c": {
      "text": "I'll show you my secret weapon!",
      "status": "imported"
    },
    "voice_043:r_a007f9ab9cf048b3": {
      "text": "It's about time...!",
      "status": "imported"
    },
    "voice_043:r_ddafde4b065ced49": {
      "text": "Time for the climax!",
      "status": "imported"
    },
    "voice_043:r_de1213040856c089": {
      "text": "Don't expect an encore!",
      "status": "imported"
    },
    "voice_043:r_3304412ac41f47a6": {
      "text": "Ozma here! I'm joining the fight!",
      "status": "imported"
    },
    "voice_043:r_0c0775e051211840": {
      "text": "Skull 1 here! I'll cover you!",
      "status": "imported"
    },
    "voice_043:r_a2afffe1c396f0b3": {
      "text": "Alto! Don't rush ahead!",
      "status": "imported"
    },
    "voice_043:r_13c25fbdfddc8a24": {
      "text": "Nice work, Michel!",
      "status": "imported"
    },
    "voice_043:r_42ba1ecb310b4bd7": {
      "text": "Luca! Leave the front line to us!",
      "status": "imported"
    },
    "voice_043:r_d692f1d420460a47": {
      "text": "Thanks for the help, Klan Klang!",
      "status": "imported"
    },
    "voice_043:r_a5643cec86b18bd2": {
      "text": "Same as ever, Canaria!",
      "status": "imported"
    },
    "voice_043:r_68f2dfab20a4a30e": {
      "text": "Skull 1 to Delta 1! Covering you!",
      "status": "imported"
    },
    "voice_043:r_9cedad8237480563": {
      "text": "Honestly, you're such a handful!",
      "status": "imported"
    },
    "voice_043:r_a03fabecba1508ca": {
      "text": "I can't just abandon a comrade!",
      "status": "imported"
    },
    "voice_043:r_5391b24a71eb10ae": {
      "text": "Watch your surroundings, Alto!",
      "status": "imported"
    },
    "voice_043:r_a554ceef5c87b972": {
      "text": "Change position, Michel!",
      "status": "imported"
    },
    "voice_043:r_546c3d5937fbb7ee": {
      "text": "Luca! Fall back a little farther!",
      "status": "imported"
    },
    "voice_043:r_1568ff6298b12b96": {
      "text": "This isn't like you, Klan Klang!",
      "status": "imported"
    },
    "voice_043:r_2c9d94ba13c5fc50": {
      "text": "Here's my usual thanks, Canaria!",
      "status": "imported"
    },
    "voice_043:r_a77f4913375098d2": {
      "text": "I won't let you take the Quarter!",
      "status": "imported"
    },
    "voice_043:r_428c2116ac3071b1": {
      "text": "I can't lay a finger on them...!",
      "status": "imported"
    },
    "voice_043:r_84c116267b79f540": {
      "text": "Counterattack...! Can't I do it?!",
      "status": "imported"
    },
    "voice_043:r_dad38ee29af2df3a": {
      "text": "Damn! Did I push it too far?!",
      "status": "imported"
    },
    "voice_043:r_3d32e86f8dc80909": {
      "text": "Tch! They know how to keep away...!",
      "status": "imported"
    },
    "voice_043:r_70451ffbabe2f876": {
      "text": "Too far...!\\nNeed a Sniper Rifle!",
      "status": "imported"
    },
    "voice_043:r_69dfa1659715e2fa": {
      "text": "Like that'll hit me!",
      "status": "imported"
    },
    "voice_043:r_d996fd6d4ef5b329": {
      "text": "I'll focus on evasion for now...!",
      "status": "imported"
    },
    "voice_043:r_8ab47a28f99ef565": {
      "text": "Your aim is sloppy!",
      "status": "imported"
    },
    "voice_043:r_546de3fb6db156ea": {
      "text": "You don't have the skill!",
      "status": "imported"
    },
    "voice_043:r_ca85f87cee5e31f7": {
      "text": "Hmph. We're in different leagues!",
      "status": "imported"
    },
    "voice_043:r_9072ea7bc71df136": {
      "text": "If that hit me,\\nI'm no captain!",
      "status": "imported"
    },
    "voice_043:r_04e815a8d425827d": {
      "text": "Experience makes the difference.",
      "status": "imported"
    },
    "voice_043:r_d89011fe3e5d082a": {
      "text": "Can't get hurt,\\nor Ranka will cry!",
      "status": "imported"
    },
    "voice_043:r_3c5b0c2ac812d5de": {
      "text": "Never thought I'd need a barrier...!",
      "status": "imported"
    },
    "voice_043:r_5b9e8897190892eb": {
      "text": "That won't work on me!",
      "status": "imported"
    },
    "voice_043:r_20920ad2eb3542db": {
      "text": "No time to worry about a scratch!",
      "status": "imported"
    },
    "voice_043:r_0ab7914877fd48ed": {
      "text": "Don't think that can stop me!",
      "status": "imported"
    },
    "voice_043:r_cb846feec748c2e3": {
      "text": "I didn't think I was careless...!",
      "status": "imported"
    },
    "voice_043:r_c958860b0676b1f5": {
      "text": "Hmph! Is that meant to hold me off?",
      "status": "imported"
    },
    "voice_043:r_5e2669b82ef75ce3": {
      "text": "You must think I'm a pushover!",
      "status": "imported"
    },
    "voice_043:r_7847e0ed7dc9282d": {
      "text": "You can match me...! Not bad!",
      "status": "imported"
    },
    "voice_043:r_e42b52c7a987b906": {
      "text": "Good moves!\\nThey won't work again!",
      "status": "imported"
    },
    "voice_043:r_6825fd1ff907bd22": {
      "text": "This one's battle-hardened...!",
      "status": "imported"
    },
    "voice_043:r_607f666f1563bc0d": {
      "text": "Did I underestimate the enemy?!",
      "status": "imported"
    },
    "voice_043:r_97b7431eeb81e6b6": {
      "text": "Flinch at this?\\nNot fit for S.M.S.!",
      "status": "imported"
    },
    "voice_043:r_132f605d02975e71": {
      "text": "Tch! I took that one head-on!",
      "status": "imported"
    },
    "voice_043:r_9b9726b1872759d6": {
      "text": "Tch! You hit a troublesome spot!",
      "status": "imported"
    },
    "voice_043:r_1252db29683fefe0": {
      "text": "Ranka...!\\nI'll come back alive...!",
      "status": "imported"
    },
    "voice_043:r_ad3d538f1e909184": {
      "text": "Guh! Another hit could be fatal!",
      "status": "imported"
    },
    "voice_043:r_8c61c59a1c0aebbf": {
      "text": "Damn!\\nI can't face my men like this!",
      "status": "imported"
    },
    "voice_043:r_aba6a7662129d8ce": {
      "text": "Still moving!\\nYou haven't won yet!!",
      "status": "imported"
    },
    "voice_043:r_b84afafb8a33ec60": {
      "text": "Damn! Is it really faster than me?!",
      "status": "imported"
    },
    "voice_043:r_c8c59db85bf875e6": {
      "text": "I can't die and abandon Ranka...!",
      "status": "imported"
    },
    "voice_043:r_391aa56435d9dd6e": {
      "text": "All units! PLANET DANCE!",
      "status": "imported"
    },
    "voice_043:r_7c796ba53bd7ea03": {
      "text": "All units! TOTSUGEKI LOVE HEART!",
      "status": "imported"
    },
    "voice_043:r_fa944da4b6519006": {
      "text": "If I could, I'd help with my song!",
      "status": "imported"
    },
    "voice_043:r_95d047bcc17fccc6": {
      "text": "Me too -\\nMy heart is Fire Bomber!!",
      "status": "imported"
    },
    "voice_043:r_640327a12a559b31": {
      "text": "I'll follow you, Captain Gamlin!",
      "status": "imported"
    },
    "voice_043:r_bdd38c584fa313d0": {
      "text": "Fire Bomber\\nwon't fall. Not ever!!",
      "status": "imported"
    },
    "voice_043:r_3fd86c1027f317c8": {
      "text": "Honestly, what a rude guest!",
      "status": "imported"
    },
    "voice_043:r_d0372a183d2007ad": {
      "text": "Basara! Keep right on singing!",
      "status": "imported"
    },
    "voice_043:r_217aa5e1d545b44d": {
      "text": "Captain Gamlin! Leave this to me!",
      "status": "imported"
    },
    "voice_043:r_381992c5d8224937": {
      "text": "Make my girl cry?\\nNot a chance!",
      "status": "imported"
    },
    "voice_043:r_f1e7ed9e5874aba5": {
      "text": "Well,\\nCathy'll yell at me again...!",
      "status": "imported"
    },
    "voice_043:r_fc25e66a86fc2c85": {
      "text": "Sorry, Cathy...! I'm pulling back!",
      "status": "imported"
    },
    "voice_043:r_5aeeb4917340c42d": {
      "text": "Pinpoint Barrier!",
      "status": "imported"
    },
    "voice_043:r_b765659981b6516d": {
      "text": "Go!",
      "status": "imported"
    },
    "voice_043:r_0c427458bc00eb95": {
      "text": "If you won't come, I'll go to you!",
      "status": "imported"
    },
    "voice_043:r_d3f01de714c015bd": {
      "text": "Damn! How could I mess up?!",
      "status": "imported"
    },
    "voice_043:r_7d2617c809fead70": {
      "text": "What's wrong?! Is that your best?!",
      "status": "imported"
    },
    "voice_043:r_ceb935ccbf830724": {
      "text": "I don't even need to dodge!",
      "status": "imported"
    },
    "voice_043:r_001cbec4d9a4283f": {
      "text": "Now...! You're mine!!",
      "status": "imported"
    },
    "voice_043:r_8ad40afecd02b41e": {
      "text": "Here I go!",
      "status": "imported"
    },
    "voice_043:r_26e5efec03c03d78": {
      "text": "I'll eliminate you by force!",
      "status": "imported"
    },
    "voice_043:r_4ad81e88c7557a8b": {
      "text": "All I'm good at is fighting!",
      "status": "imported"
    },
    "voice_043:r_1f65a7af190e4674": {
      "text": "Vajra sent a big one.\\nGenerous...!",
      "status": "imported"
    },
    "voice_043:r_40c5a9358ed5bf29": {
      "text": "A warship...! Its guns are no joke!",
      "status": "imported"
    },
    "voice_043:r_f2e18dfdfe0c89ea": {
      "text": "Ghost or not,\\nI won't lose!",
      "status": "imported"
    },
    "voice_043:r_cf7dbf49e96a5755": {
      "text": "A V-9... A worthy opponent!",
      "status": "imported"
    },
    "voice_043:r_fa96676cc65bb509": {
      "text": "Hearts lead us!\\nYou'd never get it!",
      "status": "imported"
    },
    "voice_043:r_4e37f92e7d2fc62e": {
      "text": "I'll take the final kill!",
      "status": "imported"
    },
    "voice_043:r_66ab4cfe1557909d": {
      "text": "Hah. A kid\\nas savior? No way...!",
      "status": "imported"
    },
    "voice_043:r_8356f4e3dcdff938": {
      "text": "Just match the relative speed!",
      "status": "imported"
    },
    "voice_043:r_1d6d784036ae0bd7": {
      "text": "I'll force this into close combat!",
      "status": "imported"
    },
    "voice_043:r_625664af02183c17": {
      "text": "Deploying Reaction Missile!",
      "status": "imported"
    },
    "voice_043:r_3701cba361f80ea5": {
      "text": "All right...! Enemy down confirmed!",
      "status": "imported"
    },
    "voice_043:r_63f429c5c68c0863": {
      "text": "Reaction Missile will finish this!",
      "status": "imported"
    },
    "voice_043:r_38e4a434c91d8ef0": {
      "text": "I'll bill you for the expense!",
      "status": "imported"
    },
    "voice_043:r_98ed411352a3a6ac": {
      "text": "You can't escape, wherever you run!",
      "status": "imported"
    },
    "voice_043:r_862b92e63adb9734": {
      "text": "This'll do it...!",
      "status": "imported"
    },
    "voice_043:r_cb306ef55e49d107": {
      "text": "This is the end!",
      "status": "imported"
    },
    "voice_043:r_57b2bd2de8a1408d": {
      "text": "My life is at stake too. Forgive me.",
      "status": "imported"
    },
    "voice_043:r_76f080a4881e8ab5": {
      "text": "A freebie! Take all my rounds!",
      "status": "imported"
    },
    "voice_043:r_6f95653e548f8fcf": {
      "text": "With this, you're...!",
      "status": "imported"
    },
    "voice_043:r_d249d68bada91ab9": {
      "text": "It's the end!!",
      "status": "imported"
    },
    "voice_043:r_e9b3307e9eb69f11": {
      "text": "This was wasted on you.",
      "status": "imported"
    },
    "voice_043:r_03cdac73042343ee": {
      "text": "I'll take over from here!",
      "status": "imported"
    },
    "voice_043:r_6026da5acbda7c69": {
      "text": "Stay alert! Here it comes!",
      "status": "imported"
    },
    "voice_043:r_981f8fedd5414fe5": {
      "text": "Alto! Don't get too far ahead!",
      "status": "imported"
    },
    "voice_043:r_96bb0dcde0c8c44a": {
      "text": "Hmph. You're handling it well...!",
      "status": "imported"
    },
    "voice_043:r_641550a2f54cb456": {
      "text": "Don't let your machine control you!",
      "status": "imported"
    },
    "voice_043:r_a0f2074af8debbfa": {
      "text": "I see right through your aim!",
      "status": "imported"
    },
    "voice_043:r_b5f5a97ed82acb0b": {
      "text": "You're moving too slowly!",
      "status": "imported"
    },
    "voice_043:r_d9cd2e4ded064396": {
      "text": "Vajra attack?\\nAs if it'd hit me!",
      "status": "imported"
    },
    "voice_043:r_99e6349431aaf23b": {
      "text": "Tch! Damn Vajra!",
      "status": "imported"
    },
    "voice_043:r_ec1081caf845f56a": {
      "text": "Gaaah!\\nDamn it! A mere Vajra...!",
      "status": "imported"
    },
    "voice_043:r_2c5b7ee872c1ed7f": {
      "text": "Guh...!\\nI won't die from this...!",
      "status": "imported"
    },
    "voice_043:r_76d1e51c8b494a60": {
      "text": "Gwaaaaaah!",
      "status": "imported"
    },
    "voice_043:r_2329428a6871d9fa": {
      "text": "Focus on a single point!",
      "status": "imported"
    },
    "voice_043:r_0e7466971bec4cc4": {
      "text": "I'll stop it in its tracks!",
      "status": "imported"
    },
    "voice_043:r_efa71f7a4cc33ff3": {
      "text": "Time for some private tutoring!",
      "status": "imported"
    },
    "voice_043:r_3fc2e1186557e7a0": {
      "text": "That's the one! Leave it to me!",
      "status": "imported"
    }
  }
}
