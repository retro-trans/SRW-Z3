{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_057:r_479b340ccc6c572b": {
      "text": "This battle ends here!!",
      "status": "imported"
    },
    "voice_057:r_ca4acbac57a2a35e": {
      "text": "Final target locked!\\nLet's go!",
      "status": "imported"
    },
    "voice_057:r_77949221bf58f862": {
      "text": "I'll beat you into the ground!",
      "status": "imported"
    },
    "voice_057:r_70b9c4b9f1f37eff": {
      "text": "Raaaagh!",
      "status": "imported"
    },
    "voice_057:r_9fcb3754cb1773c7": {
      "text": "Reaction Missile!\\nAll craft, clear!",
      "status": "imported"
    },
    "voice_057:r_3559d2fad32c2435": {
      "text": "Target locked! Go!!",
      "status": "imported"
    },
    "voice_057:r_f7570547e9f80a64": {
      "text": "One of humanity's finest weapons!",
      "status": "imported"
    },
    "voice_057:r_0bbe0b4f5364e732": {
      "text": "All friendlies are clear! Fire!!",
      "status": "imported"
    },
    "voice_057:r_5dda5198137cb02a": {
      "text": "Its effectiveness is guaranteed!",
      "status": "imported"
    },
    "voice_057:r_83ec59afbecdec14": {
      "text": "Enemy acquired. Counterattacking!",
      "status": "imported"
    },
    "voice_057:r_e20bfd42ad95a3c9": {
      "text": "They won't get any closer!",
      "status": "imported"
    },
    "voice_057:r_0f58a8822381e57f": {
      "text": "Move! You're in my way!",
      "status": "imported"
    },
    "voice_057:r_6dbcc507fb61b51d": {
      "text": "You won't do as you please!",
      "status": "imported"
    },
    "voice_057:r_b42ab697149a7c8a": {
      "text": "Thought I was down? Not even close!",
      "status": "imported"
    },
    "voice_057:r_4de4fcf3b440baf4": {
      "text": "Don't think I'll retreat easily!",
      "status": "imported"
    },
    "voice_057:r_0121a166c715cdff": {
      "text": "Following up with another attack!",
      "status": "imported"
    },
    "voice_057:r_30fad37a42bd3ad3": {
      "text": "Leave this to me!",
      "status": "imported"
    },
    "voice_057:r_80a0b2a84e05d81a": {
      "text": "Leave the rest to Diamond Force!",
      "status": "imported"
    },
    "voice_057:r_4a9ac1dff86506d9": {
      "text": "I'm burning inside! What a song!",
      "status": "imported"
    },
    "voice_057:r_bc8538e6af3d2577": {
      "text": "Everyone, listen to Basara's song!",
      "status": "imported"
    },
    "voice_057:r_924516c8de2b5342": {
      "text": "You're in too deep! Pull back!",
      "status": "imported"
    },
    "voice_057:r_da1174533722333f": {
      "text": "I'll protect you!",
      "status": "imported"
    },
    "voice_057:r_fdeb8162976e72c1": {
      "text": "Don't be reckless, Basara!",
      "status": "imported"
    },
    "voice_057:r_0fadb5c26df92b42": {
      "text": "What!?",
      "status": "imported"
    },
    "voice_057:r_6b15af9a0057cdc8": {
      "text": "Damn, I lost the enemy!",
      "status": "imported"
    },
    "voice_057:r_15b4a90140e8a33a": {
      "text": "I'll surpass QM69!",
      "status": "imported"
    },
    "voice_057:r_af884a6b11dff121": {
      "text": "Where are you looking!?",
      "status": "imported"
    },
    "voice_057:r_ac6fe7838e95647b": {
      "text": "Too slow!!",
      "status": "imported"
    },
    "voice_057:r_77ca87eacd17ad52": {
      "text": "Don't underestimate Diamond Force!",
      "status": "imported"
    },
    "voice_057:r_bf3244994760e535": {
      "text": "Just as I predicted!",
      "status": "imported"
    },
    "voice_057:r_aabfb21c9d069ce7": {
      "text": "Evasion complete!",
      "status": "imported"
    },
    "voice_057:r_02479dc8fe989560": {
      "text": "You're far too predictable!",
      "status": "imported"
    },
    "voice_057:r_a2df00f91a9b0a9e": {
      "text": "Useless!",
      "status": "imported"
    },
    "voice_057:r_48b60d6c48b9b142": {
      "text": "An attack like that won't work!",
      "status": "imported"
    },
    "voice_057:r_8927e6fb681aa809": {
      "text": "Not bad!",
      "status": "imported"
    },
    "voice_057:r_665f01666859013b": {
      "text": "They hit me!",
      "status": "imported"
    },
    "voice_057:r_a571eec59b258d11": {
      "text": "Damn, I couldn't evade it all!",
      "status": "imported"
    },
    "voice_057:r_ddbe581c5ea9183d": {
      "text": "Damage check... I can still fight!",
      "status": "imported"
    },
    "voice_057:r_faae935cca0edc72": {
      "text": "I couldn't evade in time!?",
      "status": "imported"
    },
    "voice_057:r_d4430bf362340b32": {
      "text": "So, you're taking the bait!",
      "status": "imported"
    },
    "voice_057:r_6ff1323b355593e0": {
      "text": "So, they're targeting me!",
      "status": "imported"
    },
    "voice_057:r_b7b5625d7cd4282f": {
      "text": "Gah! A direct hit!?",
      "status": "imported"
    },
    "voice_057:r_36133ad73a73ef98": {
      "text": "Damn it! I can still fight!",
      "status": "imported"
    },
    "voice_057:r_920740a0219c5085": {
      "text": "Damn! My Valkyrie's sluggish...!",
      "status": "imported"
    },
    "voice_057:r_a8451712c57c1a72": {
      "text": "I-I won't go down here!",
      "status": "imported"
    },
    "voice_057:r_3633df5b7b8f47fa": {
      "text": "I can fight... I won't give up!",
      "status": "imported"
    },
    "voice_057:r_52dfc56b14b93551": {
      "text": "Damn! I'm nearing my limit...!",
      "status": "imported"
    },
    "voice_057:r_1b9b2aab5cb104da": {
      "text": "As long as it moves, I'll manage!",
      "status": "imported"
    },
    "voice_057:r_342044c706a2340f": {
      "text": "Damn! Is this the end!!",
      "status": "imported"
    },
    "voice_057:r_cf41e8828a90cbdb": {
      "text": "Siiiiiing!! Basaraaaaa!!",
      "status": "imported"
    },
    "voice_057:r_ec2ea17765052401": {
      "text": "There you are!",
      "status": "imported"
    },
    "voice_057:r_f2d4255f1c2f7542": {
      "text": "Get out of my way!",
      "status": "imported"
    },
    "voice_057:r_5d08ad19e2da125b": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_057:r_dc8701f6bcb9904f": {
      "text": "Gamlin here.\\nCommencing attack!",
      "status": "imported"
    },
    "voice_057:r_41997412868c48c4": {
      "text": "You won't get off easy!",
      "status": "imported"
    },
    "voice_057:r_9e0c80ac7e33b459": {
      "text": "You're not getting away!",
      "status": "imported"
    },
    "voice_057:r_7432ef43ed3471dc": {
      "text": "I'm your opponent!!",
      "status": "imported"
    },
    "voice_057:r_065443f6ddfcf0d7": {
      "text": "Here I go!",
      "status": "imported"
    },
    "voice_057:r_8fdf5910927c9591": {
      "text": "Moving to support Skull Squadron!",
      "status": "imported"
    },
    "voice_057:r_93e25418a203cb8f": {
      "text": "A special guest is joining us!\\nGo!",
      "status": "imported"
    },
    "voice_057:r_adeb0a29274d3d9b": {
      "text": "!",
      "status": "imported"
    },
    "voice_057:r_24cf161287ef9d5c": {
      "text": "Let's make them hear our song!",
      "status": "imported"
    },
    "voice_057:r_8f60f6fc86db3107": {
      "text": "All right! I'm fired up too!",
      "status": "imported"
    },
    "voice_057:r_128c35bf3e0e394c": {
      "text": "DYNAMITE EXPLOSION!",
      "status": "imported"
    },
    "voice_057:r_5213c17e13b23de0": {
      "text": "Raaaagh!",
      "status": "imported"
    },
    "voice_057:r_38fdff9483e9245c": {
      "text": "Now,\\nlet's give them our best show!",
      "status": "imported"
    },
    "voice_057:r_9680dcd0fddcfcc7": {
      "text": "Our hearts burn!\\nLet's strike hard!",
      "status": "imported"
    },
    "voice_057:r_2a00f1044ad5cbaa": {
      "text": "I'll sing with all my heart too!",
      "status": "imported"
    },
    "voice_057:r_98d15b8cc09bc915": {
      "text": "Extreme fiiiiire!!",
      "status": "imported"
    },
    "voice_057:r_ac341e7976e88f0b": {
      "text": "I can dodge this!",
      "status": "imported"
    },
    "voice_057:r_cdbd128a5b4127cc": {
      "text": "Watch your surroundings!",
      "status": "imported"
    },
    "voice_057:r_cfccaa1fbeda124c": {
      "text": "The command unit! Keep it back!",
      "status": "imported"
    },
    "voice_057:r_b1f8ec192b9c083a": {
      "text": "If I can just take out the leader!",
      "status": "imported"
    },
    "voice_057:r_a007f9ab9cf048b3": {
      "text": "D1 here! Commencing operations!",
      "status": "imported"
    },
    "voice_057:r_ddafde4b065ced49": {
      "text": "Gamlin Kizaki, commencing attack!",
      "status": "imported"
    },
    "voice_057:r_de1213040856c089": {
      "text": "Target acquired! Commencing attack!",
      "status": "imported"
    },
    "voice_057:r_3304412ac41f47a6": {
      "text": "The perfect moment to strike...!",
      "status": "imported"
    },
    "voice_057:r_0c0775e051211840": {
      "text": "I've got you!",
      "status": "imported"
    },
    "voice_057:r_a2afffe1c396f0b3": {
      "text": "All right, target locked!",
      "status": "imported"
    },
    "voice_057:r_13c25fbdfddc8a24": {
      "text": "I can't afford to miss this one!",
      "status": "imported"
    },
    "voice_057:r_42ba1ecb310b4bd7": {
      "text": "Taking aim... I can make it!",
      "status": "imported"
    },
    "voice_057:r_d692f1d420460a47": {
      "text": "Charging in!",
      "status": "imported"
    },
    "voice_057:r_a5643cec86b18bd2": {
      "text": "I'll take you on in close combat!",
      "status": "imported"
    },
    "voice_057:r_68f2dfab20a4a30e": {
      "text": "It's tougher than it looks!",
      "status": "imported"
    },
    "voice_057:r_9cedad8237480563": {
      "text": "I'll close the distance in one go!",
      "status": "imported"
    },
    "voice_057:r_546c3d5937fbb7ee": {
      "text": "I'll smash you flat!",
      "status": "imported"
    },
    "voice_057:r_1568ff6298b12b96": {
      "text": "Try this!",
      "status": "imported"
    },
    "voice_057:r_2c9d94ba13c5fc50": {
      "text": "Eat this!",
      "status": "imported"
    },
    "voice_057:r_a77f4913375098d2": {
      "text": "At this range!",
      "status": "imported"
    },
    "voice_057:r_428c2116ac3071b1": {
      "text": "Let's settle this!",
      "status": "imported"
    },
    "voice_057:r_84c116267b79f540": {
      "text": "You're mine!",
      "status": "imported"
    },
    "voice_057:r_dad38ee29af2df3a": {
      "text": "You'd better be ready!",
      "status": "imported"
    },
    "voice_057:r_3d32e86f8dc80909": {
      "text": "So be it.\\nWith Basara to the end!",
      "status": "imported"
    },
    "voice_057:r_70451ffbabe2f876": {
      "text": "Alone,\\nDiamond Force still stands!",
      "status": "imported"
    },
    "voice_057:r_69dfa1659715e2fa": {
      "text": "I must reach the fleet\\nand survive!",
      "status": "imported"
    },
    "voice_057:r_d996fd6d4ef5b329": {
      "text": "Behold Diamond Force's spirit!",
      "status": "imported"
    },
    "voice_057:r_8ab47a28f99ef565": {
      "text": "Basara sings! I fight!",
      "status": "imported"
    },
    "voice_057:r_546de3fb6db156ea": {
      "text": "I'll follow my own chosen path!",
      "status": "imported"
    },
    "voice_057:r_ca85f87cee5e31f7": {
      "text": "There!",
      "status": "imported"
    },
    "voice_057:r_9072ea7bc71df136": {
      "text": "I can do this!",
      "status": "imported"
    },
    "voice_057:r_04e815a8d425827d": {
      "text": "I'll bring you down!",
      "status": "imported"
    },
    "voice_057:r_d89011fe3e5d082a": {
      "text": "This is the finishing blow!",
      "status": "imported"
    },
    "voice_057:r_3c5b0c2ac812d5de": {
      "text": "It's over!",
      "status": "imported"
    },
    "voice_057:r_5b9e8897190892eb": {
      "text": "Here's my chance! I'll finish it!",
      "status": "imported"
    },
    "voice_057:r_7bea3023abbf8a94": {
      "text": "My attack isn't over yet!",
      "status": "imported"
    },
    "voice_057:r_dd01a4c0d1b36a8d": {
      "text": "Is there no way but to fight...!?",
      "status": "imported"
    },
    "voice_057:r_20920ad2eb3542db": {
      "text": "Human or Vajra...\\nwho survives!?",
      "status": "imported"
    },
    "voice_057:r_0ab7914877fd48ed": {
      "text": "I'll swiftly disable the machine!",
      "status": "imported"
    },
    "voice_057:r_cb846feec748c2e3": {
      "text": "I'll stop it, whatever it takes!",
      "status": "imported"
    },
    "voice_057:r_c958860b0676b1f5": {
      "text": "I'll avoid killing whenever I can!",
      "status": "imported"
    },
    "voice_057:r_5e2669b82ef75ce3": {
      "text": "So coordinated for a drone...!",
      "status": "imported"
    },
    "voice_057:r_7847e0ed7dc9282d": {
      "text": "It's unmanned.\\nI won't hold back!",
      "status": "imported"
    },
    "voice_057:r_e42b52c7a987b906": {
      "text": "Have its abilities been enhanced!?",
      "status": "imported"
    },
    "voice_057:r_97b7431eeb81e6b6": {
      "text": "That pilot\\nmay be a victim, but...!",
      "status": "imported"
    },
    "voice_057:r_1252db29683fefe0": {
      "text": "Humans fighting humans?\\nThink!",
      "status": "imported"
    },
    "voice_057:r_ad3d538f1e909184": {
      "text": "Beyond war,\\nmake your voice heard!",
      "status": "imported"
    },
    "voice_057:r_8c61c59a1c0aebbf": {
      "text": "Red Comet, prepare yourself!",
      "status": "imported"
    },
    "voice_057:r_aba6a7662129d8ce": {
      "text": "So I'm fighting a god!",
      "status": "imported"
    },
    "voice_057:r_b84afafb8a33ec60": {
      "text": "I will never allow the world's end!",
      "status": "imported"
    },
    "voice_057:r_c8c59db85bf875e6": {
      "text": "You monster! You won't get past me!",
      "status": "imported"
    },
    "voice_057:r_391aa56435d9dd6e": {
      "text": "We won't\\nmeekly accept extinction!",
      "status": "imported"
    },
    "voice_057:r_fa944da4b6519006": {
      "text": "Enemy of all women!",
      "status": "imported"
    },
    "voice_057:r_95d047bcc17fccc6": {
      "text": "Let you roam,\\nMylene's at risk too!",
      "status": "imported"
    },
    "voice_057:r_640327a12a559b31": {
      "text": "It hurts not to be chosen... But!",
      "status": "imported"
    },
    "voice_057:r_bdd38c584fa313d0": {
      "text": "Give up hope,\\nlose your future!",
      "status": "imported"
    },
    "voice_057:r_3fd86c1027f317c8": {
      "text": "First, take out the command unit!",
      "status": "imported"
    },
    "voice_057:r_d0372a183d2007ad": {
      "text": "That's one skilled pilot...!",
      "status": "imported"
    },
    "voice_057:r_217aa5e1d545b44d": {
      "text": "You're a worthy opponent! Let's go!",
      "status": "imported"
    },
    "voice_057:r_381992c5d8224937": {
      "text": "If Basara stays,\\nso will I!",
      "status": "imported"
    },
    "voice_057:r_fc25e66a86fc2c85": {
      "text": "Whoever you are, I fight!\\nMy way!",
      "status": "imported"
    },
    "voice_057:r_5aeeb4917340c42d": {
      "text": "I won't let you have your way here!",
      "status": "imported"
    },
    "voice_057:r_03cdac73042343ee": {
      "text": "Gamlin here. Charging in!",
      "status": "imported"
    },
    "voice_057:r_6026da5acbda7c69": {
      "text": "Haaaaaah!",
      "status": "imported"
    },
    "voice_057:r_981f8fedd5414fe5": {
      "text": "Pinpoint Barrier, deploy!",
      "status": "imported"
    },
    "voice_057:r_96bb0dcde0c8c44a": {
      "text": "Hryaaaaah!",
      "status": "imported"
    },
    "voice_057:r_641550a2f54cb456": {
      "text": "I'll finish you in close combat!",
      "status": "imported"
    },
    "voice_057:r_a0f2074af8debbfa": {
      "text": "Take thiiiiis!",
      "status": "imported"
    },
    "voice_057:r_a6fd676d8146501b": {
      "text": "I'm using a Reaction Missile!",
      "status": "imported"
    },
    "voice_057:r_b686510e636673f3": {
      "text": "Enemy destruction confirmed!",
      "status": "imported"
    },
    "voice_057:r_59369bad143d4272": {
      "text": "Firing the Reaction Missile!",
      "status": "imported"
    },
    "voice_057:r_09a780acca0eb4b0": {
      "text": "Commencing pursuit!",
      "status": "imported"
    },
    "voice_057:r_af62f2ee466b5c8c": {
      "text": "D1, commencing counterattack!",
      "status": "imported"
    },
    "voice_057:r_20cfb719db02fafd": {
      "text": "I won't let it end with me beaten!",
      "status": "imported"
    },
    "voice_057:r_570c1fdf72edb283": {
      "text": "I'll push them back!",
      "status": "imported"
    },
    "voice_057:r_23f0d87a5a6cfca1": {
      "text": "Now it's our turn!",
      "status": "imported"
    },
    "voice_057:r_60c94ea4eb7f7404": {
      "text": "I'll turn the tide in one stroke!",
      "status": "imported"
    },
    "voice_057:r_727b2ee0277f9159": {
      "text": "D1 here! Following up!",
      "status": "imported"
    },
    "voice_057:r_cff4d2eae8a939ed": {
      "text": "I'll cover you from here!",
      "status": "imported"
    },
    "voice_057:r_1428fe5f35a9427b": {
      "text": "Time for your big moment, Basara!",
      "status": "imported"
    },
    "voice_057:r_96d39b8bdfa6f183": {
      "text": "Leave the fighting to me, Basara!",
      "status": "imported"
    },
    "voice_057:r_0e4f9b8a2d26ebff": {
      "text": "D1 here! Supporting Skull 1!",
      "status": "imported"
    },
    "voice_057:r_79e0d542fe12bcf7": {
      "text": "Not bad, Skull 4!",
      "status": "imported"
    },
    "voice_057:r_eff747ba39a55393": {
      "text": "Still sharp-eyed, Skull 2!",
      "status": "imported"
    },
    "voice_057:r_b2dc77aa6dd77e69": {
      "text": "Leave the rest to me, Skull 3!",
      "status": "imported"
    },
    "voice_057:r_445d40d8b5d7092b": {
      "text": "Now that's Zentran spirit!",
      "status": "imported"
    },
    "voice_057:r_bbb633cb5e8e6daf": {
      "text": "Attacking right behind the Quarter!",
      "status": "imported"
    },
    "voice_057:r_0abd8b6c713ccdac": {
      "text": "Diamond Force's honor!\\nI defend!",
      "status": "imported"
    },
    "voice_057:r_f4ff463b2fda1b86": {
      "text": "I'll take over! Fall back for now!",
      "status": "imported"
    },
    "voice_057:r_4e63c037d3cb8a3d": {
      "text": "I won't let you ruin the show!",
      "status": "imported"
    },
    "voice_057:r_9ca8d188ae805e3a": {
      "text": "Your song must reach them, Basara!",
      "status": "imported"
    },
    "voice_057:r_795ed21f3e28e1f5": {
      "text": "Don't make\\nMylene sad!",
      "status": "imported"
    },
    "voice_057:r_141415c1def5ab2d": {
      "text": "Skull 4, watch your surroundings!",
      "status": "imported"
    },
    "voice_057:r_c894e35becf35a03": {
      "text": "Regroup, Skull 2!",
      "status": "imported"
    },
    "voice_057:r_79b1abf5fc86483c": {
      "text": "We must protect Skull 3's data...!",
      "status": "imported"
    },
    "voice_057:r_e9a11621911acb19": {
      "text": "Pixie Squadron, I'll cover you!",
      "status": "imported"
    },
    "voice_057:r_d52bece55796f599": {
      "text": "I won't let them sink the Quarter!",
      "status": "imported"
    },
    "voice_057:r_638834e16724002f": {
      "text": "Panicking won't do me any good...!",
      "status": "imported"
    },
    "voice_057:r_b02fca1590ac1210": {
      "text": "I can't counterattack now...!",
      "status": "imported"
    },
    "voice_057:r_f0344d2fbaa9db77": {
      "text": "I have to stand by and let them go!",
      "status": "imported"
    },
    "voice_057:r_3328eef766ff2c2c": {
      "text": "I have no moves left right now...!",
      "status": "imported"
    },
    "voice_057:r_23b037cf6ccc695c": {
      "text": "They slipped into my blind spot...!",
      "status": "imported"
    },
    "voice_057:r_883ad1128d340c5e": {
      "text": "They're beyond my search radius!?",
      "status": "imported"
    },
    "voice_057:r_a9e6ed99025a703b": {
      "text": "The name D1 is no empty boast!",
      "status": "imported"
    },
    "voice_057:r_b0d1459d6daeebbe": {
      "text": "I knew you'd try that!",
      "status": "imported"
    },
    "voice_057:r_cd4893b409472e97": {
      "text": "An evasive maneuver will do...!",
      "status": "imported"
    },
    "voice_057:r_5691cc71770ffdde": {
      "text": "I know how to pilot this thing!",
      "status": "imported"
    },
    "voice_057:r_964e07c5563a5508": {
      "text": "Flying lays your soul bare.\\nTrue!",
      "status": "imported"
    },
    "voice_057:r_db54e717bff3e3b2": {
      "text": "Any slower would've meant a hit...!",
      "status": "imported"
    },
    "voice_057:r_fcab8d80aef7e9d8": {
      "text": "I can withstand that much!",
      "status": "imported"
    },
    "voice_057:r_2174bd0edc164171": {
      "text": "Such a pointless attack...!",
      "status": "imported"
    },
    "voice_057:r_87646dd472438e88": {
      "text": "With the Pinpoint Barrier...!",
      "status": "imported"
    },
    "voice_057:r_4e32ac89cba02001": {
      "text": "Damage is minimal.",
      "status": "imported"
    },
    "voice_057:r_02d24e5915bfa5b7": {
      "text": "It's minor,\\nbut I must stay alert.",
      "status": "imported"
    },
    "voice_057:r_9331c2c2ef55c78f": {
      "text": "I should've dodged that...!",
      "status": "imported"
    },
    "voice_057:r_49734bdb3507acf7": {
      "text": "I must avoid more damage...!",
      "status": "imported"
    },
    "voice_057:r_2a730c9b4df0dca3": {
      "text": "I can't let Mylene\\nsee this...!",
      "status": "imported"
    },
    "voice_057:r_1e5842ba5dc3f705": {
      "text": "Was I too tense...!?",
      "status": "imported"
    },
    "voice_057:r_9747bd61ad23ecd3": {
      "text": "What am I doing...!?",
      "status": "imported"
    },
    "voice_057:r_6823f8abe05c4727": {
      "text": "I knew I'd take a few hits!",
      "status": "imported"
    },
    "voice_057:r_b8ccfd8b8ac323ac": {
      "text": "Before it worsens,\\nI end this...!",
      "status": "imported"
    },
    "voice_057:r_c885ff2097749991": {
      "text": "Promised Mylene\\nI'd return safe...!",
      "status": "imported"
    },
    "voice_057:r_a8da7f8d8b705db0": {
      "text": "Not yet! Basara's song still rings!",
      "status": "imported"
    },
    "voice_057:r_02e1c5e19de5bd22": {
      "text": "Don't mar\\nDiamond Force's name...!",
      "status": "imported"
    },
    "voice_057:r_6fb823898811e210": {
      "text": "Captain Kinryu!\\nPhysica! Help me!",
      "status": "imported"
    },
    "voice_057:r_5dcbcf1682cc3ab8": {
      "text": "Basara's the reckless one...!",
      "status": "imported"
    },
    "voice_057:r_5a20988e743dc1d0": {
      "text": "I have a duty...!\\nTill it's done!",
      "status": "imported"
    },
    "voice_057:r_197f05bf899b7697": {
      "text": "Basara sings.\\nI won't lose hope...!",
      "status": "imported"
    },
    "voice_057:r_623ee03bd91ab2a1": {
      "text": "Mylene, please\\npray I return safe!",
      "status": "imported"
    },
    "voice_057:r_c5c491f8761152f0": {
      "text": "Give my all!\\nDiamond Force's way!",
      "status": "imported"
    },
    "voice_057:r_15042263763f11bb": {
      "text": "Damn...! D1 is withdrawing!",
      "status": "imported"
    },
    "voice_057:r_96b3a8f080aea8b4": {
      "text": "Daaamn! Is this the end!?",
      "status": "imported"
    },
    "voice_057:r_3d4fa015b8b31648": {
      "text": "Good work, players! First, my vow.",
      "status": "imported"
    },
    "voice_057:r_c1f3167d7dd97543": {
      "text": "3 sleepless days to beat my limits!",
      "status": "imported"
    },
    "voice_057:r_1ac46173650ffe13": {
      "text": "I'll put all my feelings into song!",
      "status": "imported"
    },
    "voice_057:r_53660d6bc7fe8513": {
      "text": "I Am Gamlin! Raaaagh! Hear my song!",
      "status": "imported"
    },
    "voice_057:r_2e756557a1d92e8b": {
      "text": "Basaraaaaa!!",
      "status": "imported"
    },
    "voice_057:r_45d847e7b8d840e3": {
      "text": "Mylene, hear this with the players!",
      "status": "imported"
    },
    "voice_057:r_d2ebe8f28f2420cc": {
      "text": "I sang my resolve to change myself!",
      "status": "imported"
    },
    "voice_057:r_3baa2292b050034a": {
      "text": "I Am Gamlin! Now, hear my song...!",
      "status": "imported"
    },
    "voice_057:r_8a303240a87b1c7d": {
      "text": "M-Mylene...",
      "status": "imported"
    },
    "voice_057:r_69d009696527fa68": {
      "text": "Good...! I can sing here alone!",
      "status": "imported"
    },
    "voice_057:r_aeb9079d86e2a924": {
      "text": "I Am Gamlin! Hear my soooong!!",
      "status": "imported"
    },
    "voice_057:r_bc4658630f8e40a9": {
      "text": "I am Gaaaamlin!",
      "status": "imported"
    },
    "voice_057:r_92816afa2ba8a8c9": {
      "text": "Huh...? It's over already?",
      "status": "imported"
    },
    "voice_057:r_a29f58ecde5f7ddd": {
      "text": "What? My song won't help you rest?",
      "status": "imported"
    },
    "voice_057:r_4069f7e9517c47e8": {
      "text": "So fired up! Thanks! Till we meet!",
      "status": "imported"
    },
    "voice_057:r_2835a8af1c41be9b": {
      "text": "D1, taking point!",
      "status": "imported"
    },
    "voice_057:r_cd84325a7c1a820f": {
      "text": "First, stop the enemy cold!",
      "status": "imported"
    },
    "voice_057:r_0465f74c0488ad70": {
      "text": "Keeping the target pinned down!",
      "status": "imported"
    },
    "voice_057:r_a30c8238b5208470": {
      "text": "I'll draw its attention!",
      "status": "imported"
    },
    "voice_057:r_64bf1c63c7c1ebdd": {
      "text": "We'll split up the enemy team!",
      "status": "imported"
    },
    "voice_057:r_f6d5042f671118fa": {
      "text": "So, it's one-on-one!",
      "status": "imported"
    },
    "voice_057:r_0be18539fac21ba4": {
      "text": "I'll drive them into a corner!",
      "status": "imported"
    },
    "voice_057:r_c05bd0cf089d667f": {
      "text": "Then I'll leave that to you!",
      "status": "imported"
    }
  }
}
