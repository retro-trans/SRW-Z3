{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_028:r_479b340ccc6c572b": {
      "text": "The enemy's closing in!",
      "status": "imported"
    },
    "voice_028:r_ca4acbac57a2a35e": {
      "text": "Then we'll strike first!",
      "status": "imported"
    },
    "voice_028:r_77949221bf58f862": {
      "text": "The enemy's let their guard down!",
      "status": "imported"
    },
    "voice_028:r_70b9c4b9f1f37eff": {
      "text": "Roger, Marie!",
      "status": "imported"
    },
    "voice_028:r_9fcb3754cb1773c7": {
      "text": "Gundam Harute, move to intercept!",
      "status": "imported"
    },
    "voice_028:r_3559d2fad32c2435": {
      "text": "Gundam Harute, commencing attack!",
      "status": "imported"
    },
    "voice_028:r_f7570547e9f80a64": {
      "text": "We'll carve a path forward!",
      "status": "imported"
    },
    "voice_028:r_cbab0f4720e1fcf1": {
      "text": "Keep the enemy pinned down!",
      "status": "imported"
    },
    "voice_028:r_0bbe0b4f5364e732": {
      "text": "We'll strike at this opening!",
      "status": "imported"
    },
    "voice_028:r_5dda5198137cb02a": {
      "text": "There!",
      "status": "imported"
    },
    "voice_028:r_83ec59afbecdec14": {
      "text": "We've got no choice but to go!",
      "status": "imported"
    },
    "voice_028:r_e20bfd42ad95a3c9": {
      "text": "I see it!",
      "status": "imported"
    },
    "voice_028:r_0f58a8822381e57f": {
      "text": "Now!",
      "status": "imported"
    },
    "voice_028:r_6dbcc507fb61b51d": {
      "text": "I'll make this shot count!",
      "status": "imported"
    },
    "voice_028:r_b42ab697149a7c8a": {
      "text": "You're not getting away!",
      "status": "imported"
    },
    "voice_028:r_4de4fcf3b440baf4": {
      "text": "I won't miss!",
      "status": "imported"
    },
    "voice_028:r_4a9ac1dff86506d9": {
      "text": "Hyaah!",
      "status": "imported"
    },
    "voice_028:r_bc8538e6af3d2577": {
      "text": "Haaaaah!",
      "status": "imported"
    },
    "voice_028:r_924516c8de2b5342": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_028:r_da1174533722333f": {
      "text": "Damn yooou!",
      "status": "imported"
    },
    "voice_028:r_fdeb8162976e72c1": {
      "text": "Trans-Am!",
      "status": "imported"
    },
    "voice_028:r_0fadb5c26df92b42": {
      "text": "Marie!",
      "status": "imported"
    },
    "voice_028:r_6b15af9a0057cdc8": {
      "text": "I know!",
      "status": "imported"
    },
    "voice_028:r_15b4a90140e8a33a": {
      "text": "I'll sink you!",
      "status": "imported"
    },
    "voice_028:r_af884a6b11dff121": {
      "text": "It's Trans-Am!",
      "status": "imported"
    },
    "voice_028:r_ac6fe7838e95647b": {
      "text": "Charging in!",
      "status": "imported"
    },
    "voice_028:r_77ca87eacd17ad52": {
      "text": "Bring it on!",
      "status": "imported"
    },
    "voice_028:r_bf3244994760e535": {
      "text": "This'll finish it!",
      "status": "imported"
    },
    "voice_028:r_aabfb21c9d069ce7": {
      "text": "Activating Trans-Am!",
      "status": "imported"
    },
    "voice_028:r_02479dc8fe989560": {
      "text": "We'll open the way ourselves!",
      "status": "imported"
    },
    "voice_028:r_a2df00f91a9b0a9e": {
      "text": "Yeah!",
      "status": "imported"
    },
    "voice_028:r_48b60d6c48b9b142": {
      "text": "With this one blow!",
      "status": "imported"
    },
    "voice_028:r_8927e6fb681aa809": {
      "text": "Gundam Harute's not done yet!",
      "status": "imported"
    },
    "voice_028:r_665f01666859013b": {
      "text": "I'll try again as often as it takes!",
      "status": "imported"
    },
    "voice_028:r_a571eec59b258d11": {
      "text": "Gundam Harute, begin pursuit!",
      "status": "imported"
    },
    "voice_028:r_ddbe581c5ea9183d": {
      "text": "Even if our enemy is a Gundam!",
      "status": "imported"
    },
    "voice_028:r_faae935cca0edc72": {
      "text": "Gundam vs. Gundam...\\nOne last time!",
      "status": "imported"
    },
    "voice_028:r_d4430bf362340b32": {
      "text": "As we are now, we can hold back!",
      "status": "imported"
    },
    "voice_028:r_6ff1323b355593e0": {
      "text": "Aim only for their weapons!",
      "status": "imported"
    },
    "voice_028:r_b7b5625d7cd4282f": {
      "text": "You're too soft, Allelujah!",
      "status": "imported"
    },
    "voice_028:r_36133ad73a73ef98": {
      "text": "I may be soft.\\nI'll do what I can!",
      "status": "imported"
    },
    "voice_028:r_920740a0219c5085": {
      "text": "If I hold back, we lose!\\nBut...!",
      "status": "imported"
    },
    "voice_028:r_a8451712c57c1a72": {
      "text": "I'll save them, no matter what!",
      "status": "imported"
    },
    "voice_028:r_3633df5b7b8f47fa": {
      "text": "I'll fight to the very end!",
      "status": "imported"
    },
    "voice_028:r_52dfc56b14b93551": {
      "text": "So you've finally come, Allelujah!",
      "status": "imported"
    },
    "voice_028:r_1b9b2aab5cb104da": {
      "text": "Gundam Harute,\\nFinal mission, go!",
      "status": "imported"
    },
    "voice_028:r_342044c706a2340f": {
      "text": "We'll win and forge a way forward.",
      "status": "imported"
    },
    "voice_028:r_cf41e8828a90cbdb": {
      "text": "A future...!",
      "status": "imported"
    },
    "voice_028:r_719e897304ec42d4": {
      "text": "A tomorrow!",
      "status": "imported"
    },
    "voice_028:r_620fedec67706d7d": {
      "text": "If this battle can't be avoided!",
      "status": "imported"
    },
    "voice_028:r_9680dcd0fddcfcc7": {
      "text": "They're not beyond our reach!",
      "status": "imported"
    },
    "voice_028:r_2a00f1044ad5cbaa": {
      "text": "We won't just let them beat us!",
      "status": "imported"
    },
    "voice_028:r_3dbeead1bd3164ef": {
      "text": "Gundam Harute, begin counterattack!",
      "status": "imported"
    },
    "voice_028:r_98d15b8cc09bc915": {
      "text": "They're targeting us? Then...!",
      "status": "imported"
    },
    "voice_028:r_46e86d000250e137": {
      "text": "Allelujah!",
      "status": "imported"
    },
    "voice_028:r_ac341e7976e88f0b": {
      "text": "Yeah, we'll counterattack!",
      "status": "imported"
    },
    "voice_028:r_cdbd128a5b4127cc": {
      "text": "We can catch them anytime!",
      "status": "imported"
    },
    "voice_028:r_cfccaa1fbeda124c": {
      "text": "In that case!",
      "status": "imported"
    },
    "voice_028:r_b1f8ec192b9c083a": {
      "text": "We can overwhelm them together!",
      "status": "imported"
    },
    "voice_028:r_a007f9ab9cf048b3": {
      "text": "No rule says this is one-on-one!",
      "status": "imported"
    },
    "voice_028:r_ddafde4b065ced49": {
      "text": "Setsuna, we'll handle things here!",
      "status": "imported"
    },
    "voice_028:r_de1213040856c089": {
      "text": "Lockon, we'll pursue the enemy!",
      "status": "imported"
    },
    "voice_028:r_3304412ac41f47a6": {
      "text": "Tieria isn't the only one!",
      "status": "imported"
    },
    "voice_028:r_0c0775e051211840": {
      "text": "Just as Sumeragi ordered!",
      "status": "imported"
    },
    "voice_028:r_a2afffe1c396f0b3": {
      "text": "No!",
      "status": "imported"
    },
    "voice_028:r_13c25fbdfddc8a24": {
      "text": "I won't abandon my friends!",
      "status": "imported"
    },
    "voice_028:r_42ba1ecb310b4bd7": {
      "text": "You're overextending, Setsuna!",
      "status": "imported"
    },
    "voice_028:r_d692f1d420460a47": {
      "text": "Lockon, you're being too careless!",
      "status": "imported"
    },
    "voice_028:r_a5643cec86b18bd2": {
      "text": "Tieria, that's reckless!",
      "status": "imported"
    },
    "voice_028:r_68f2dfab20a4a30e": {
      "text": "Gundam Harute, defend the Ptolemy!",
      "status": "imported"
    },
    "voice_028:r_9cedad8237480563": {
      "text": "Damn, I need to regroup...!",
      "status": "imported"
    },
    "voice_028:r_a03fabecba1508ca": {
      "text": "Why now, of all times...!",
      "status": "imported"
    },
    "voice_028:r_5391b24a71eb10ae": {
      "text": "Sorry, if only I'd been careful...!",
      "status": "imported"
    },
    "voice_028:r_a554ceef5c87b972": {
      "text": "Marie, don't blame yourself...!",
      "status": "imported"
    },
    "voice_028:r_546c3d5937fbb7ee": {
      "text": "I can't do anything...!",
      "status": "imported"
    },
    "voice_028:r_1568ff6298b12b96": {
      "text": "We can't just let them beat us...!",
      "status": "imported"
    },
    "voice_028:r_2c9d94ba13c5fc50": {
      "text": "Over here!",
      "status": "imported"
    },
    "voice_028:r_a77f4913375098d2": {
      "text": "I'll dodge something like this!",
      "status": "imported"
    },
    "voice_028:r_428c2116ac3071b1": {
      "text": "With Gundam Harute's mobility!",
      "status": "imported"
    },
    "voice_028:r_84c116267b79f540": {
      "text": "If I can read its trajectory!",
      "status": "imported"
    },
    "voice_028:r_dad38ee29af2df3a": {
      "text": "I can't keep relying on Hallelujah!",
      "status": "imported"
    },
    "voice_028:r_3d32e86f8dc80909": {
      "text": "If we keep acting as their decoy...!",
      "status": "imported"
    },
    "voice_028:r_70451ffbabe2f876": {
      "text": "They seem to be underestimating us!",
      "status": "imported"
    },
    "voice_028:r_69dfa1659715e2fa": {
      "text": "Leave control of the unit to me!",
      "status": "imported"
    },
    "voice_028:r_d996fd6d4ef5b329": {
      "text": "Thanks, Marie!",
      "status": "imported"
    },
    "voice_028:r_8ab47a28f99ef565": {
      "text": "Something like that won't work!",
      "status": "imported"
    },
    "voice_028:r_546de3fb6db156ea": {
      "text": "Just what I'd expect from Ian!",
      "status": "imported"
    },
    "voice_028:r_ca85f87cee5e31f7": {
      "text": "With the GN Field!",
      "status": "imported"
    },
    "voice_028:r_9072ea7bc71df136": {
      "text": "Field output is stable!",
      "status": "imported"
    },
    "voice_028:r_04e815a8d425827d": {
      "text": "Roger, we'll keep going!",
      "status": "imported"
    },
    "voice_028:r_d89011fe3e5d082a": {
      "text": "Damn, we can't shake them...!",
      "status": "imported"
    },
    "voice_028:r_3c5b0c2ac812d5de": {
      "text": "They're reading our trajectory...?",
      "status": "imported"
    },
    "voice_028:r_5b9e8897190892eb": {
      "text": "That's hardly any damage!",
      "status": "imported"
    },
    "voice_028:r_7bea3023abbf8a94": {
      "text": "They kept pace with Harute...?!",
      "status": "imported"
    },
    "voice_028:r_dd01a4c0d1b36a8d": {
      "text": "Then we'll just change our tactics!",
      "status": "imported"
    },
    "voice_028:r_20920ad2eb3542db": {
      "text": "Th-that's way too reckless...!",
      "status": "imported"
    },
    "voice_028:r_0ab7914877fd48ed": {
      "text": "S-such precise attacks...!",
      "status": "imported"
    },
    "voice_028:r_cb846feec748c2e3": {
      "text": "It's even. We can still fight...!",
      "status": "imported"
    },
    "voice_028:r_c958860b0676b1f5": {
      "text": "Barely stopping a direct hit...!",
      "status": "imported"
    },
    "voice_028:r_5e2669b82ef75ce3": {
      "text": "Harute won't go down so easily!",
      "status": "imported"
    },
    "voice_028:r_7847e0ed7dc9282d": {
      "text": "Ugh! Marie, are you all right?",
      "status": "imported"
    },
    "voice_028:r_e42b52c7a987b906": {
      "text": "I'm fine! Worry about yourself!",
      "status": "imported"
    },
    "voice_028:r_6825fd1ff907bd22": {
      "text": "Ugh! Are we safe...?!",
      "status": "imported"
    },
    "voice_028:r_607f666f1563bc0d": {
      "text": "Even with limits, I can still fight!",
      "status": "imported"
    },
    "voice_028:r_97b7431eeb81e6b6": {
      "text": "Ugh! GN Drive's intact... Then!",
      "status": "imported"
    },
    "voice_028:r_132f605d02975e71": {
      "text": "Not yet! I have reason to fight!",
      "status": "imported"
    },
    "voice_028:r_9b9726b1872759d6": {
      "text": "I'm alive, so it's too soon to quit!",
      "status": "imported"
    },
    "voice_028:r_1252db29683fefe0": {
      "text": "I'll struggle for all I'm worth!",
      "status": "imported"
    },
    "voice_028:r_ad3d538f1e909184": {
      "text": "Right!\\nThat's how we've survived!",
      "status": "imported"
    },
    "voice_028:r_8c61c59a1c0aebbf": {
      "text": "Marie, eject! Save yourself!",
      "status": "imported"
    },
    "voice_028:r_aba6a7662129d8ce": {
      "text": "You can't ask me to do that!",
      "status": "imported"
    },
    "voice_028:r_b84afafb8a33ec60": {
      "text": "For the peace the Colonel wanted...!",
      "status": "imported"
    },
    "voice_028:r_c8c59db85bf875e6": {
      "text": "We can't lose yet!",
      "status": "imported"
    },
    "voice_028:r_391aa56435d9dd6e": {
      "text": "I'm no good, am I...!",
      "status": "imported"
    },
    "voice_028:r_7c796ba53bd7ea03": {
      "text": "Uwaaaah!!",
      "status": "imported"
    },
    "voice_028:r_fa944da4b6519006": {
      "text": "Is this the end...?",
      "status": "imported"
    },
    "voice_028:r_95d047bcc17fccc6": {
      "text": "Sorry, everyone! It's up to you...!",
      "status": "imported"
    },
    "voice_028:r_640327a12a559b31": {
      "text": "I'm sorry, Marie...",
      "status": "imported"
    },
    "voice_028:r_bdd38c584fa313d0": {
      "text": "Fine, hurry and eject!",
      "status": "imported"
    },
    "voice_028:r_3fd86c1027f317c8": {
      "text": "Oraaa!",
      "status": "imported"
    },
    "voice_028:r_d0372a183d2007ad": {
      "text": "Haaah hah hah!",
      "status": "imported"
    },
    "voice_028:r_217aa5e1d545b44d": {
      "text": "Come on, come on, come ooon!",
      "status": "imported"
    },
    "voice_028:r_8a29278549f8e07a": {
      "text": "If we focus our attacks!",
      "status": "imported"
    },
    "voice_028:r_7e6c573c26177f98": {
      "text": "Harute, move ahead and disrupt them!",
      "status": "imported"
    },
    "voice_028:r_45abf84f7757d6eb": {
      "text": "Got it! We'll hold them here!",
      "status": "imported"
    },
    "voice_028:r_edd7a13ab8f06a14": {
      "text": "It's my duty to defeat you!",
      "status": "imported"
    },
    "voice_028:r_8165e5b41f0124c4": {
      "text": "One-on-one, I won't lose!",
      "status": "imported"
    },
    "voice_028:r_4e05581b7432cce8": {
      "text": "I'm a Gundam Meister too!\\nWatch!",
      "status": "imported"
    }
  }
}
