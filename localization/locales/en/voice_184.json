{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_184:r_479b340ccc6c572b": {
      "text": "If you're coming, then bring it!",
      "status": "imported"
    },
    "voice_184:r_ca4acbac57a2a35e": {
      "text": "Here I go!",
      "status": "imported"
    },
    "voice_184:r_77949221bf58f862": {
      "text": "All right!",
      "status": "imported"
    },
    "voice_184:r_70b9c4b9f1f37eff": {
      "text": "You bastard!",
      "status": "imported"
    },
    "voice_184:r_9fcb3754cb1773c7": {
      "text": "This one's gonna hurt!",
      "status": "imported"
    },
    "voice_184:r_3559d2fad32c2435": {
      "text": "If you wanna fight, then...!",
      "status": "imported"
    },
    "voice_184:r_f7570547e9f80a64": {
      "text": "You won't get your way!",
      "status": "imported"
    },
    "voice_184:r_cbab0f4720e1fcf1": {
      "text": "Let's go, Mazinger Z!",
      "status": "imported"
    },
    "voice_184:r_0bbe0b4f5364e732": {
      "text": "You want a brawl? I'm your man!",
      "status": "imported"
    },
    "voice_184:r_5dda5198137cb02a": {
      "text": "Get outta my way!",
      "status": "imported"
    },
    "voice_184:r_83ec59afbecdec14": {
      "text": "Now! I'm counting on you, Mazinger!",
      "status": "imported"
    },
    "voice_184:r_e20bfd42ad95a3c9": {
      "text": "Watch what Mazinger and I can do!",
      "status": "imported"
    },
    "voice_184:r_0f58a8822381e57f": {
      "text": "This is Mazinger's power!",
      "status": "imported"
    },
    "voice_184:r_6dbcc507fb61b51d": {
      "text": "Get in my way and I'll blast you!",
      "status": "imported"
    },
    "voice_184:r_b42ab697149a7c8a": {
      "text": "Mazinger Z won't become a demon!",
      "status": "imported"
    },
    "voice_184:r_4de4fcf3b440baf4": {
      "text": "I'll use this power for peace!",
      "status": "imported"
    },
    "voice_184:r_0121a166c715cdff": {
      "text": "You won't take Atami from us!",
      "status": "imported"
    },
    "voice_184:r_30fad37a42bd3ad3": {
      "text": "Grandpa...!\\nI'll protect Atami!",
      "status": "imported"
    },
    "voice_184:r_80a0b2a84e05d81a": {
      "text": "Here's another one for you!",
      "status": "imported"
    },
    "voice_184:r_4a9ac1dff86506d9": {
      "text": "This time, I'll finish you off!",
      "status": "imported"
    },
    "voice_184:r_bc8538e6af3d2577": {
      "text": "Mechabeast,\\nsee Mazinger Z's power!",
      "status": "imported"
    },
    "voice_184:r_924516c8de2b5342": {
      "text": "No Mechabeast\\ncan beat Mazinger Z!",
      "status": "imported"
    },
    "voice_184:r_da1174533722333f": {
      "text": "That's it, Mechabeast! You're scrap!",
      "status": "imported"
    },
    "voice_184:r_fdeb8162976e72c1": {
      "text": "You won't have your way with Earth!",
      "status": "imported"
    },
    "voice_184:r_0fadb5c26df92b42": {
      "text": "Out of the solar system with you!",
      "status": "imported"
    },
    "voice_184:r_6b15af9a0057cdc8": {
      "text": "You freak! I'll carve you up!",
      "status": "imported"
    },
    "voice_184:r_15b4a90140e8a33a": {
      "text": "Damn! You're one disgusting creep!",
      "status": "imported"
    },
    "voice_184:r_af884a6b11dff121": {
      "text": "Back off, or you'll get hurt!",
      "status": "imported"
    },
    "voice_184:r_ac6fe7838e95647b": {
      "text": "Stop!\\nHumans shouldn't fight!",
      "status": "imported"
    },
    "voice_184:r_77ca87eacd17ad52": {
      "text": "Fast foes?\\nOkiku trained me!",
      "status": "imported"
    },
    "voice_184:r_bf3244994760e535": {
      "text": "Bigger foes\\njust fire me up more!",
      "status": "imported"
    },
    "voice_184:r_aabfb21c9d069ce7": {
      "text": "Brawl rule one: crush the head!",
      "status": "imported"
    },
    "voice_184:r_02479dc8fe989560": {
      "text": "I fight\\nto protect Earth's peace!",
      "status": "imported"
    },
    "voice_184:r_a2df00f91a9b0a9e": {
      "text": "Power used right\\ncan make you a god!",
      "status": "imported"
    },
    "voice_184:r_48b60d6c48b9b142": {
      "text": "Raaaaagh!",
      "status": "imported"
    },
    "voice_184:r_8927e6fb681aa809": {
      "text": "Why, youuu!",
      "status": "imported"
    },
    "voice_184:r_665f01666859013b": {
      "text": "Hyaaaaaah!",
      "status": "imported"
    },
    "voice_184:r_a571eec59b258d11": {
      "text": "Go flying!",
      "status": "imported"
    },
    "voice_184:r_ddbe581c5ea9183d": {
      "text": "Take thiiiiis!",
      "status": "imported"
    },
    "voice_184:r_faae935cca0edc72": {
      "text": "I'll blow a hole through you!",
      "status": "imported"
    },
    "voice_184:r_d4430bf362340b32": {
      "text": "Rocket Puuunch!",
      "status": "imported"
    },
    "voice_184:r_6ff1323b355593e0": {
      "text": "I'll pound you with all I've got!",
      "status": "imported"
    },
    "voice_184:r_b7b5625d7cd4282f": {
      "text": "Take this! Rocket Puuunch!",
      "status": "imported"
    },
    "voice_184:r_36133ad73a73ef98": {
      "text": "Fly, iron fist!",
      "status": "imported"
    },
    "voice_184:r_920740a0219c5085": {
      "text": "Rocket! Puuuuuuunch!",
      "status": "imported"
    },
    "voice_184:r_3633df5b7b8f47fa": {
      "text": "Pierce through! Rocket Puuunch!",
      "status": "imported"
    },
    "voice_184:r_52dfc56b14b93551": {
      "text": "Rust Hurricane!",
      "status": "imported"
    },
    "voice_184:r_1b9b2aab5cb104da": {
      "text": "Take this! Rust Hurricane!",
      "status": "imported"
    },
    "voice_184:r_342044c706a2340f": {
      "text": "Rust Hurricane!!",
      "status": "imported"
    },
    "voice_184:r_cf41e8828a90cbdb": {
      "text": "Burn to ashes!",
      "status": "imported"
    },
    "voice_184:r_719e897304ec42d4": {
      "text": "Breast Fire!",
      "status": "imported"
    },
    "voice_184:r_d5e0a2317c40d322": {
      "text": "Raaaaaaaaagh!",
      "status": "imported"
    },
    "voice_184:r_ec2ea17765052401": {
      "text": "How about this!",
      "status": "imported"
    },
    "voice_184:r_f2d4255f1c2f7542": {
      "text": "Breast Fire!!",
      "status": "imported"
    },
    "voice_184:r_5d08ad19e2da125b": {
      "text": "Maximum output!",
      "status": "imported"
    },
    "voice_184:r_a7246b52782a877e": {
      "text": "This'll finish you!",
      "status": "imported"
    },
    "voice_184:r_dc8701f6bcb9904f": {
      "text": "Breast Fire!!!",
      "status": "imported"
    },
    "voice_184:r_d6bdd730f24f66eb": {
      "text": "Goooooo!",
      "status": "imported"
    },
    "voice_184:r_41997412868c48c4": {
      "text": "Amazing! What incredible energy!",
      "status": "imported"
    },
    "voice_184:r_9e6cf4f389dae55c": {
      "text": "Photon Beam!!",
      "status": "imported"
    },
    "voice_184:r_9e0c80ac7e33b459": {
      "text": "Take thiiiiis!",
      "status": "imported"
    },
    "voice_184:r_7432ef43ed3471dc": {
      "text": "Mazinger! Full power!",
      "status": "imported"
    },
    "voice_184:r_065443f6ddfcf0d7": {
      "text": "How's that? That's Photon Power!",
      "status": "imported"
    },
    "voice_184:r_47d52a2839c71715": {
      "text": "All right! Energy fully charged!",
      "status": "imported"
    },
    "voice_184:r_847f82e7f3eef651": {
      "text": "Raaagh! Photon Beam!!",
      "status": "imported"
    },
    "voice_184:r_eb7ae28b53dc033c": {
      "text": "Goooooooo!",
      "status": "imported"
    },
    "voice_184:r_857c4a52ce8df0fd": {
      "text": "It's oooooover!",
      "status": "imported"
    },
    "voice_184:r_55417493fce1d347": {
      "text": "Oh, no!\\nDid I overdo it a little?",
      "status": "imported"
    },
    "voice_184:r_8fdf5910927c9591": {
      "text": "Taste the power of Photon Energy!",
      "status": "imported"
    },
    "voice_184:r_7d724dbcc4451e10": {
      "text": "Photon Power! Photon Beam!!",
      "status": "imported"
    },
    "voice_184:r_93e25418a203cb8f": {
      "text": "Why, youuuu!",
      "status": "imported"
    },
    "voice_184:r_adeb0a29274d3d9b": {
      "text": "Go flyyyyying!",
      "status": "imported"
    },
    "voice_184:r_24cf161287ef9d5c": {
      "text": "Grandpa,\\nMazinger is invincible!",
      "status": "imported"
    },
    "voice_184:r_8f60f6fc86db3107": {
      "text": "Damn! I can't counter from here!",
      "status": "imported"
    },
    "voice_184:r_b1de76a75a253c13": {
      "text": "This is bad! They'll gang up on me!",
      "status": "imported"
    },
    "voice_184:r_128c35bf3e0e394c": {
      "text": "No way...!?\\nPhoton Energy is gone!",
      "status": "imported"
    },
    "voice_184:r_5213c17e13b23de0": {
      "text": "Damn! I can't attack from here!",
      "status": "imported"
    },
    "voice_184:r_dad38ee29af2df3a": {
      "text": "I'll pay you back double!",
      "status": "imported"
    },
    "voice_184:r_3d32e86f8dc80909": {
      "text": "Let's go! Time to counterattack!",
      "status": "imported"
    },
    "voice_184:r_70451ffbabe2f876": {
      "text": "How dare you!\\nHere's some payback!",
      "status": "imported"
    },
    "voice_184:r_69dfa1659715e2fa": {
      "text": "Whoa! You're not leaving for free!",
      "status": "imported"
    },
    "voice_184:r_d996fd6d4ef5b329": {
      "text": "Time for a little payback!",
      "status": "imported"
    },
    "voice_184:r_8ab47a28f99ef565": {
      "text": "This is what happens when I get mad!",
      "status": "imported"
    },
    "voice_184:r_546de3fb6db156ea": {
      "text": "You can still go, Mazinger!",
      "status": "imported"
    },
    "voice_184:r_ca85f87cee5e31f7": {
      "text": "I'm your next opponent!",
      "status": "imported"
    },
    "voice_184:r_9072ea7bc71df136": {
      "text": "We'll show you our teamwork!",
      "status": "imported"
    },
    "voice_184:r_04e815a8d425827d": {
      "text": "Sayaka can't do this alone!",
      "status": "imported"
    },
    "voice_184:r_d89011fe3e5d082a": {
      "text": "Mazinger and Getter\\nare unbeatable!",
      "status": "imported"
    },
    "voice_184:r_3c5b0c2ac812d5de": {
      "text": "We can't lose to the Getter Team!",
      "status": "imported"
    },
    "voice_184:r_5b9e8897190892eb": {
      "text": "I won't let you!",
      "status": "imported"
    },
    "voice_184:r_7bea3023abbf8a94": {
      "text": "I'll stop it with my Alloy Z body!",
      "status": "imported"
    },
    "voice_184:r_dd01a4c0d1b36a8d": {
      "text": "Sayaka! I'll hold them off here!",
      "status": "imported"
    },
    "voice_184:r_20920ad2eb3542db": {
      "text": "Leave it to me, Getter Team!",
      "status": "imported"
    },
    "voice_184:r_0ab7914877fd48ed": {
      "text": "And there!",
      "status": "imported"
    },
    "voice_184:r_cb846feec748c2e3": {
      "text": "Get lost and don't come back!",
      "status": "imported"
    },
    "voice_184:r_c958860b0676b1f5": {
      "text": "Yes! That training's paying off!",
      "status": "imported"
    },
    "voice_184:r_5e2669b82ef75ce3": {
      "text": "Hey! What do you think you're doing?",
      "status": "imported"
    },
    "voice_184:r_7847e0ed7dc9282d": {
      "text": "What's wrong? You'll never hit me!",
      "status": "imported"
    },
    "voice_184:r_e42b52c7a987b906": {
      "text": "I can see your attacks coming!",
      "status": "imported"
    },
    "voice_184:r_6825fd1ff907bd22": {
      "text": "Heh! What are you aiming at?",
      "status": "imported"
    },
    "voice_184:r_607f666f1563bc0d": {
      "text": "Mechabeast!\\nSee Mazinger's power!",
      "status": "imported"
    },
    "voice_184:r_97b7431eeb81e6b6": {
      "text": "Stay back, Mechabeast!",
      "status": "imported"
    },
    "voice_184:r_9b9726b1872759d6": {
      "text": "Turn Photon Energy into a barrier!",
      "status": "imported"
    },
    "voice_184:r_1252db29683fefe0": {
      "text": "Not a chance!",
      "status": "imported"
    },
    "voice_184:r_8c61c59a1c0aebbf": {
      "text": "Heh! That was nothing!",
      "status": "imported"
    },
    "voice_184:r_aba6a7662129d8ce": {
      "text": "What's wrong? Is that your best?",
      "status": "imported"
    },
    "voice_184:r_b84afafb8a33ec60": {
      "text": "That's it? You're all for show!",
      "status": "imported"
    },
    "voice_184:r_c8c59db85bf875e6": {
      "text": "You think that'll beat Mazinger Z!?",
      "status": "imported"
    },
    "voice_184:r_391aa56435d9dd6e": {
      "text": "Mazinger Z,\\ninvincible super robot!",
      "status": "imported"
    },
    "voice_184:r_7c796ba53bd7ea03": {
      "text": "Heh... an impregnable iron castle!",
      "status": "imported"
    },
    "voice_184:r_fa944da4b6519006": {
      "text": "That was nothing!",
      "status": "imported"
    },
    "voice_184:r_95d047bcc17fccc6": {
      "text": "Is that all a Mechabeast can do?",
      "status": "imported"
    },
    "voice_184:r_640327a12a559b31": {
      "text": "No Invader's taking me down!",
      "status": "imported"
    },
    "voice_184:r_bdd38c584fa313d0": {
      "text": "So that's Getter's power!?",
      "status": "imported"
    },
    "voice_184:r_3fd86c1027f317c8": {
      "text": "Damn! I let my guard down on Getter!",
      "status": "imported"
    },
    "voice_184:r_d0372a183d2007ad": {
      "text": "Why, you...! What a dirty trick!",
      "status": "imported"
    },
    "voice_184:r_217aa5e1d545b44d": {
      "text": "Heh! You're better than you look!",
      "status": "imported"
    },
    "voice_184:r_381992c5d8224937": {
      "text": "Ngh...! What an impact!",
      "status": "imported"
    },
    "voice_184:r_f1e7ed9e5874aba5": {
      "text": "You asked for it, you bastard!",
      "status": "imported"
    },
    "voice_184:r_fc25e66a86fc2c85": {
      "text": "Watch them...!\\nOur chance will come!",
      "status": "imported"
    },
    "voice_184:r_5aeeb4917340c42d": {
      "text": "I'm heating up...!\\nNow it's real!",
      "status": "imported"
    },
    "voice_184:r_b765659981b6516d": {
      "text": "This is bad! Mazinger Z is...!",
      "status": "imported"
    },
    "voice_184:r_0c427458bc00eb95": {
      "text": "You damned Mechabeast!!",
      "status": "imported"
    },
    "voice_184:r_774a9ab4d8fd5351": {
      "text": "No Mechabeast is taking me down!",
      "status": "imported"
    },
    "voice_184:r_d3f01de714c015bd": {
      "text": "I'll stop the Invader right here!!",
      "status": "imported"
    },
    "voice_184:r_7d2617c809fead70": {
      "text": "Urgh! That's Getter Robo's power!",
      "status": "imported"
    },
    "voice_184:r_ceb935ccbf830724": {
      "text": "That Getter\\ncan't be left unchecked!",
      "status": "imported"
    },
    "voice_184:r_862ef7385bf2abd4": {
      "text": "It can break through Alloy Z!?",
      "status": "imported"
    },
    "voice_184:r_001cbec4d9a4283f": {
      "text": "Daaamn!\\nI refuse to lose here!",
      "status": "imported"
    },
    "voice_184:r_8ad40afecd02b41e": {
      "text": "Hold on, Mazinger!\\nYou can do it!",
      "status": "imported"
    },
    "voice_184:r_26e5efec03c03d78": {
      "text": "Hope remains!\\nFight to the end!",
      "status": "imported"
    },
    "voice_184:r_4ad81e88c7557a8b": {
      "text": "Give it everything left, Mazinger!",
      "status": "imported"
    },
    "voice_184:r_1f65a7af190e4674": {
      "text": "Mazinger!\\nTake my life and soul!",
      "status": "imported"
    },
    "voice_184:r_40c5a9358ed5bf29": {
      "text": "I refuse to go down here!!",
      "status": "imported"
    },
    "voice_184:r_f2e18dfdfe0c89ea": {
      "text": "So strong!\\nA mighty Mechabeast!?",
      "status": "imported"
    },
    "voice_184:r_cf7dbf49e96a5755": {
      "text": "Bad...!\\nThat Mechabeast is mighty!",
      "status": "imported"
    },
    "voice_184:r_fa96676cc65bb509": {
      "text": "No Invader\\nis taking me down!",
      "status": "imported"
    },
    "voice_184:r_4e37f92e7d2fc62e": {
      "text": "Uaaagh!\\nW-what is that Getter!?",
      "status": "imported"
    },
    "voice_184:r_66ab4cfe1557909d": {
      "text": "Mazinger...!\\nI'm sorry, Grandpa...!",
      "status": "imported"
    },
    "voice_184:r_0bad405ee6ca63ba": {
      "text": "Th-this can't be...!",
      "status": "imported"
    },
    "voice_184:r_2072eaf71a260ae7": {
      "text": "Mazin, go!",
      "status": "imported"
    },
    "voice_184:r_6c13bbfd27a7799e": {
      "text": "Pilder! Oooooon!!",
      "status": "imported"
    },
    "voice_184:r_06f88dcbd3c9e738": {
      "text": "Who... Who are you...!?",
      "status": "imported"
    },
    "voice_184:r_b28faf9f71bc3598": {
      "text": "Brocken!\\nYou won't get your way!",
      "status": "imported"
    },
    "voice_184:r_8a29278549f8e07a": {
      "text": "Ready, you floating-head count?",
      "status": "imported"
    },
    "voice_184:r_7e6c573c26177f98": {
      "text": "I'll shoot down that big fat pig!",
      "status": "imported"
    },
    "voice_184:r_4e05581b7432cce8": {
      "text": "Shining Zeus!\\nSmash all to atoms!",
      "status": "imported"
    },
    "voice_184:r_a60b107ea3c36a86": {
      "text": "Split land and sea!\\nCreate all!",
      "status": "imported"
    },
    "voice_184:r_e33693e5ba4665b0": {
      "text": "Big Bang Puuuuunch!!",
      "status": "imported"
    },
    "voice_184:r_0a3fccb71ec6cf2a": {
      "text": "Biiiig Baaaang!\\nPuuuuuuunch!!",
      "status": "imported"
    },
    "voice_184:r_9b63cf1f3e0207ef": {
      "text": "Mazinger Z and me, striking as one!",
      "status": "imported"
    },
    "voice_184:r_1d6d784036ae0bd7": {
      "text": "Smash through! Big Bang Puuunch!!",
      "status": "imported"
    },
    "voice_184:r_625664af02183c17": {
      "text": "Mazinger Z and I\\nstake all we have!",
      "status": "imported"
    },
    "voice_184:r_63f429c5c68c0863": {
      "text": "Big Bang! Puuuuuuunch!!",
      "status": "imported"
    },
    "voice_184:r_38e4a434c91d8ef0": {
      "text": "This is the fist of Zeus!",
      "status": "imported"
    },
    "voice_184:r_862b92e63adb9734": {
      "text": "Boss! Leave the rest to me!",
      "status": "imported"
    },
    "voice_184:r_cb306ef55e49d107": {
      "text": "Boss! You guys stay back!",
      "status": "imported"
    },
    "voice_184:r_57b2bd2de8a1408d": {
      "text": "Heh, that's how it's done!\\nBrocken!",
      "status": "imported"
    },
    "voice_184:r_76f080a4881e8ab5": {
      "text": "Brocken,\\nyou think that'll beat me?",
      "status": "imported"
    },
    "voice_184:r_6f95653e548f8fcf": {
      "text": "You're one push short, Brocken!",
      "status": "imported"
    },
    "voice_184:r_d249d68bada91ab9": {
      "text": "Brocken, you sneaky bastard!",
      "status": "imported"
    },
    "voice_184:r_e9b3307e9eb69f11": {
      "text": "Brocken! Like hell I'll lose to you!",
      "status": "imported"
    },
    "voice_184:r_03cdac73042343ee": {
      "text": "Damn!\\nI won't forgive you, Brocken!",
      "status": "imported"
    },
    "voice_184:r_6026da5acbda7c69": {
      "text": "A thousandfold payback,\\nBrocken!!",
      "status": "imported"
    },
    "voice_184:r_981f8fedd5414fe5": {
      "text": "All right, if that's how it is!",
      "status": "imported"
    },
    "voice_184:r_96bb0dcde0c8c44a": {
      "text": "You'll never beat me in a brawl!",
      "status": "imported"
    },
    "voice_184:r_641550a2f54cb456": {
      "text": "I know how I'll use this power now!",
      "status": "imported"
    },
    "voice_184:r_99e6349431aaf23b": {
      "text": "Like hell I'll let you escape!",
      "status": "imported"
    },
    "voice_184:r_ec1081caf845f56a": {
      "text": "All right, now we're attacking!",
      "status": "imported"
    },
    "voice_184:r_2c5b7ee872c1ed7f": {
      "text": "All right, leave the rest to me!",
      "status": "imported"
    },
    "voice_184:r_76d1e51c8b494a60": {
      "text": "Then here's a little extra!",
      "status": "imported"
    },
    "voice_184:r_eb5f687fcd372ae7": {
      "text": "Waaagh! What's with this power!?",
      "status": "imported"
    },
    "voice_184:r_2329428a6871d9fa": {
      "text": "Damn! Did I take that head-on!?",
      "status": "imported"
    },
    "voice_184:r_0e7466971bec4cc4": {
      "text": "Damn, it hit me!",
      "status": "imported"
    },
    "voice_184:r_efa71f7a4cc33ff3": {
      "text": "Mazinger's\\ntougher than you think!",
      "status": "imported"
    },
    "voice_184:r_3fc2e1186557e7a0": {
      "text": "Whoa! I can't let that hit me!",
      "status": "imported"
    },
    "voice_184:r_2332b9d56461d7ab": {
      "text": "Useless! I've got a barrier!",
      "status": "imported"
    },
    "voice_184:r_854aa0a91a3c80d1": {
      "text": "Charge, Mazinger!",
      "status": "imported"
    },
    "voice_184:r_0bc8ae32a406ceab": {
      "text": "Mazinger will take that one on!",
      "status": "imported"
    },
    "voice_184:r_82c09f011d703b2c": {
      "text": "I won't lose to someone I've fought!",
      "status": "imported"
    },
    "voice_184:r_2b4d8818c77b6dca": {
      "text": "The human mind won't lose to an AI!",
      "status": "imported"
    },
    "voice_184:r_d520c6d5298a848d": {
      "text": "Don't get cocky, Mycenae!",
      "status": "imported"
    },
    "voice_184:r_099e2458cabf796f": {
      "text": "You've done it now, Hades!",
      "status": "imported"
    },
    "voice_184:r_fd910d714be70870": {
      "text": "Damn Mycenae, you're good!",
      "status": "imported"
    },
    "voice_184:r_9736f29b11344ec3": {
      "text": "Hades! I'm not down yet!",
      "status": "imported"
    },
    "voice_184:r_fcd05582aa5c6068": {
      "text": "Mycenae won't get its way anymore!!",
      "status": "imported"
    },
    "voice_184:r_bece29562818acba": {
      "text": "H-Hades...\\nI'll beat you myself!",
      "status": "imported"
    },
    "voice_184:r_494b5da92ed24ecb": {
      "text": "Strike first to win!",
      "status": "imported"
    },
    "voice_184:r_a4a5a96f4bd58920": {
      "text": "This is where I come in!",
      "status": "imported"
    },
    "voice_184:r_b57d2d74233f889a": {
      "text": "Come on! Give it up already!",
      "status": "imported"
    },
    "voice_184:r_cd06d0820d82524b": {
      "text": "We'll finish this, Mazinger!",
      "status": "imported"
    },
    "voice_184:r_c94c6d04be583774": {
      "text": "Mazinger Z will take you on!",
      "status": "imported"
    },
    "voice_184:r_e54e2c99ef8297af": {
      "text": "Eat this!",
      "status": "imported"
    },
    "voice_184:r_f16a3eb0bcaac082": {
      "text": "All right! How's this!",
      "status": "imported"
    },
    "voice_184:r_10a408809e512df1": {
      "text": "I'm going all out on you!",
      "status": "imported"
    },
    "voice_184:r_bc7b9e308b879dd4": {
      "text": "I'll take the Mechabeast!",
      "status": "imported"
    },
    "voice_184:r_98902fd3143c393e": {
      "text": "No Mechabeast can beat Mazinger Z!",
      "status": "imported"
    },
    "voice_184:r_d907fbd7bc1c4298": {
      "text": "Go, Mazinger!\\nBeat the Mechabeast!",
      "status": "imported"
    },
    "voice_184:r_96b21e3a028dd074": {
      "text": "You won't escape today, Brocken!",
      "status": "imported"
    },
    "voice_184:r_ce140b5d8e6b7310": {
      "text": "I'm sick of you, Count Brocken!",
      "status": "imported"
    },
    "voice_184:r_0e0335789c5396d7": {
      "text": "Beyond a Mechabeast? Bring it!",
      "status": "imported"
    },
    "voice_184:r_a8e85bd950696403": {
      "text": "Bring it! I'll fight even a god!",
      "status": "imported"
    },
    "voice_184:r_772c8bc40ab6cb61": {
      "text": "Even against gods,\\nwe cannot lose!",
      "status": "imported"
    },
    "voice_184:r_58dd2826a199ef51": {
      "text": "This isn't my first Kedora!",
      "status": "imported"
    },
    "voice_184:r_aadc0b2442adb93b": {
      "text": "Mycenae champion!\\nFace Mazinger!",
      "status": "imported"
    },
    "voice_184:r_e7a8cd8ed5bc2d1b": {
      "text": "Hades!\\nZeus and I are unbeatable!",
      "status": "imported"
    },
    "voice_184:r_041dd920da4a7c17": {
      "text": "Hades!\\nZeus's Mazinger's power!",
      "status": "imported"
    },
    "voice_184:r_c7f4280cde4605b3": {
      "text": "Don't underestimate humans, Hades!",
      "status": "imported"
    },
    "voice_184:r_ec349c8ea9511a18": {
      "text": "Size alone won't beat Mazinger!",
      "status": "imported"
    },
    "voice_184:r_33236ffa3ea95b68": {
      "text": "Mazinger never loses on power!",
      "status": "imported"
    },
    "voice_184:r_689d0b123de71ae0": {
      "text": "See what Okiku's training did!",
      "status": "imported"
    },
    "voice_184:r_84883aa95f63ce32": {
      "text": "Fast opponents are tricky...!",
      "status": "imported"
    },
    "voice_184:r_25493e978ce8ff16": {
      "text": "One hit is all I need!",
      "status": "imported"
    },
    "voice_184:r_c4f11aa93dc5b668": {
      "text": "Watch their moves and I can hit!",
      "status": "imported"
    },
    "voice_184:r_240651adab81e145": {
      "text": "Small opponents can still be deadly!",
      "status": "imported"
    },
    "voice_184:r_cff0deaae73c2858": {
      "text": "Against a Gundam, I can't let up!",
      "status": "imported"
    },
    "voice_184:r_dca67f68a573fab7": {
      "text": "Even a Gundam must have an opening!",
      "status": "imported"
    },
    "voice_184:r_a6630215fefaf294": {
      "text": "We shouldn't be fighting! Think!",
      "status": "imported"
    },
    "voice_184:r_6f94566ad37f8ff8": {
      "text": "You stubborn fool! Then fight me!",
      "status": "imported"
    },
    "voice_184:r_942ca03c9de80143": {
      "text": "Prepare yourself, kidnapper!",
      "status": "imported"
    },
    "voice_184:r_d8c669c70659e18a": {
      "text": "Abductor!\\nYou won't get your way!",
      "status": "imported"
    },
    "voice_184:r_8f5bade7ac2db78e": {
      "text": "No holding back against a machine!",
      "status": "imported"
    },
    "voice_184:r_05ea490d2f522520": {
      "text": "Mazinger's hunting monsters!",
      "status": "imported"
    },
    "voice_184:r_f5658c702d91db7a": {
      "text": "We'll have to stop them by force!",
      "status": "imported"
    },
    "voice_184:r_686df329b50f195b": {
      "text": "No half measures!\\nFull power!",
      "status": "imported"
    },
    "voice_184:r_25f0ab0fa3cf690c": {
      "text": "That barrier has to go first...!",
      "status": "imported"
    },
    "voice_184:r_b708a1d959013dbf": {
      "text": "Let's go! Protect Earth from Baal!",
      "status": "imported"
    },
    "voice_184:r_59fca03e929366c1": {
      "text": "Eat this, space monster!",
      "status": "imported"
    },
    "voice_184:r_0d65eb631dcb7514": {
      "text": "Mazinger, man, and I\\nnever give up!",
      "status": "imported"
    },
    "voice_184:r_d03018a31e23f1e9": {
      "text": "I won't let you invade Earth!",
      "status": "imported"
    },
    "voice_184:r_279da5f732aa8847": {
      "text": "Just go back to your own planet!",
      "status": "imported"
    },
    "voice_184:r_97f82e3cb6f70110": {
      "text": "All right! Target the warship!",
      "status": "imported"
    },
    "voice_184:r_c5611d8dd6def96b": {
      "text": "No choice! I'll stop it moving!",
      "status": "imported"
    },
    "voice_184:r_6f12cc8ed2732eb5": {
      "text": "Sorry, but bear with it a little!",
      "status": "imported"
    },
    "voice_184:r_7abfc55f8fb62ba7": {
      "text": "Getter and Mazinger\\nshould be even!",
      "status": "imported"
    },
    "voice_184:r_99e7a66c650b5892": {
      "text": "Time to show off all that training!",
      "status": "imported"
    },
    "voice_184:r_5b2247b5cfbcd7b2": {
      "text": "I'll give it my all, Ryoma!",
      "status": "imported"
    },
    "voice_184:r_2d7a9c06347582d9": {
      "text": "Ryoma! Here I come at full force!",
      "status": "imported"
    },
    "voice_184:r_bf953d64c3c7d9b7": {
      "text": "Even Hayato\\nmust have a weak spot!",
      "status": "imported"
    },
    "voice_184:r_e09b933e3e706779": {
      "text": "Keep up with Hayato's speed!",
      "status": "imported"
    },
    "voice_184:r_66236eb99b676e5b": {
      "text": "You won't beat me on power, Benkei!",
      "status": "imported"
    },
    "voice_184:r_9639a2dbcd2f58ed": {
      "text": "Attack before Benkei can grab me!",
      "status": "imported"
    },
    "voice_184:r_aeea0893acb93d35": {
      "text": "I'll fight to protect world peace!",
      "status": "imported"
    },
    "voice_184:r_b31568654e53487b": {
      "text": "The enemy boss?\\nA worthy opponent!",
      "status": "imported"
    },
    "voice_184:r_2502132569141ea3": {
      "text": "Your kind gets no mercy from me!",
      "status": "imported"
    },
    "voice_184:r_1ff312798a52c8eb": {
      "text": "No coward\\npulling strings can win!",
      "status": "imported"
    },
    "voice_184:r_b0d1459d6daeebbe": {
      "text": "You hit me, I hit back!",
      "status": "imported"
    },
    "voice_184:r_cd4893b409472e97": {
      "text": "An opening! This is my chance!",
      "status": "imported"
    },
    "voice_184:r_5691cc71770ffdde": {
      "text": "Like hell I'll just take this!",
      "status": "imported"
    },
    "voice_184:r_964e07c5563a5508": {
      "text": "Now it's Mazinger's turn to shine!",
      "status": "imported"
    },
    "voice_184:r_db54e717bff3e3b2": {
      "text": "Now it's my turn to attack!",
      "status": "imported"
    },
    "voice_184:r_fcab8d80aef7e9d8": {
      "text": "I'll lend you a hand, Sousuke!",
      "status": "imported"
    },
    "voice_184:r_2174bd0edc164171": {
      "text": "I won't let Sousuke hog the glory!",
      "status": "imported"
    },
    "voice_184:r_ad54419336b49578": {
      "text": "I'll work with you, Bonta-kun!",
      "status": "imported"
    },
    "voice_184:r_63c353e1e05e8e39": {
      "text": "Nice, Shinji! I'm following up!",
      "status": "imported"
    },
    "voice_184:r_87646dd472438e88": {
      "text": "Good work, Shinji! I'll handle it!",
      "status": "imported"
    },
    "voice_184:r_4e32ac89cba02001": {
      "text": "Sorry, Asuka. That one's mine!",
      "status": "imported"
    },
    "voice_184:r_02d24e5915bfa5b7": {
      "text": "I'll back you up, Amata!",
      "status": "imported"
    },
    "voice_184:r_9331c2c2ef55c78f": {
      "text": "Volunteer Club combo attack!",
      "status": "imported"
    },
    "voice_184:r_49734bdb3507acf7": {
      "text": "See the Volunteer Club's unity!",
      "status": "imported"
    },
    "voice_184:r_2a730c9b4df0dca3": {
      "text": "Sousuke! Mazinger's your shield!",
      "status": "imported"
    },
    "voice_184:r_1e5842ba5dc3f705": {
      "text": "Whoa! They won't get Sousuke!",
      "status": "imported"
    },
    "voice_184:r_9747bd61ad23ecd3": {
      "text": "Look out! Bonta-kun's in trouble!",
      "status": "imported"
    },
    "voice_184:r_6823f8abe05c4727": {
      "text": "Leave this to your senior, Shinji!",
      "status": "imported"
    },
    "voice_184:r_b8ccfd8b8ac323ac": {
      "text": "Shinji! I'll handle things here!",
      "status": "imported"
    },
    "voice_184:r_c885ff2097749991": {
      "text": "Asuka! Look out, or you'll get hit!",
      "status": "imported"
    },
    "voice_184:r_a8da7f8d8b705db0": {
      "text": "Amata! I'll hold this one back!",
      "status": "imported"
    },
    "voice_184:r_02e1c5e19de5bd22": {
      "text": "That's the Volunteer Club spirit!",
      "status": "imported"
    },
    "voice_184:r_6fb823898811e210": {
      "text": "You won't hurt one of my clubmates!",
      "status": "imported"
    },
    "voice_184:r_5dcbcf1682cc3ab8": {
      "text": "I managed to dodge it!",
      "status": "imported"
    },
    "voice_184:r_5a20988e743dc1d0": {
      "text": "Just like dodging Ryoma's fists...!",
      "status": "imported"
    },
    "voice_184:r_197f05bf899b7697": {
      "text": "My dodging steps\\ncame from Hayato!",
      "status": "imported"
    },
    "voice_184:r_623ee03bd91ab2a1": {
      "text": "Mycenae gods\\nare just Mechabeasts!",
      "status": "imported"
    },
    "voice_184:r_c5c491f8761152f0": {
      "text": "You call that an underworld king!?",
      "status": "imported"
    },
    "voice_184:r_3d4fa015b8b31648": {
      "text": "Ngh!\\nArmor alone won't cut it!",
      "status": "imported"
    },
    "voice_184:r_c1f3167d7dd97543": {
      "text": "Damn! I thought I could dodge it!",
      "status": "imported"
    },
    "voice_184:r_1ac46173650ffe13": {
      "text": "Benkei's guard!\\nI'll block with it!",
      "status": "imported"
    },
    "voice_184:r_53660d6bc7fe8513": {
      "text": "Is this our gap in experience!?",
      "status": "imported"
    },
    "voice_184:r_2e756557a1d92e8b": {
      "text": "Getter is starting to overpower me!?",
      "status": "imported"
    },
    "voice_184:r_45d847e7b8d840e3": {
      "text": "That move...!\\nI'll master it myself!",
      "status": "imported"
    },
    "voice_184:r_d2ebe8f28f2420cc": {
      "text": "Ngh! Ryoma's spirit is crushing me!",
      "status": "imported"
    },
    "voice_184:r_3baa2292b050034a": {
      "text": "I-I can't see Hayato move!?",
      "status": "imported"
    },
    "voice_184:r_8a303240a87b1c7d": {
      "text": "This is Benkei's Getter 3 power!?",
      "status": "imported"
    },
    "voice_184:r_69d009696527fa68": {
      "text": "Damn! It's beyond any Mechabeast!",
      "status": "imported"
    },
    "voice_184:r_aeb9079d86e2a924": {
      "text": "Hades! What incredible power!",
      "status": "imported"
    },
    "voice_184:r_bc4658630f8e40a9": {
      "text": "Dead king?\\nI'm a demon god of light!",
      "status": "imported"
    },
    "voice_184:r_a30c8238b5208470": {
      "text": "Can't I control Mazinger\\nproperly!?",
      "status": "imported"
    },
    "voice_184:r_64bf1c63c7c1ebdd": {
      "text": "This is bad! Drill or not, enough!",
      "status": "imported"
    },
    "voice_184:r_f6d5042f671118fa": {
      "text": "Strong...!\\nMy greatest foe yet...!",
      "status": "imported"
    },
    "voice_184:r_0be18539fac21ba4": {
      "text": "Waaaaaaaaaagh!!",
      "status": "imported"
    },
    "voice_184:r_c05bd0cf089d667f": {
      "text": "Damn! It's back to training for me!",
      "status": "imported"
    },
    "voice_184:r_f69a0e1d0d67fd0e": {
      "text": "If you led the best army, then what?",
      "status": "imported"
    },
    "voice_184:r_c4e734ceafabd82c": {
      "text": "What if a stronger foe appeared?",
      "status": "imported"
    },
    "voice_184:r_62f1de6cdfb87024": {
      "text": "Sink in despair, or rise with hope?",
      "status": "imported"
    },
    "voice_184:r_7ecfe7ddfa4cdb6a": {
      "text": "Find it with Kouji Kabuto in Z3!",
      "status": "imported"
    },
    "voice_184:r_d1be92a2ad355176": {
      "text": "Awaiting our next hopeful battle...!",
      "status": "imported"
    },
    "voice_184:r_e0022ae8da32f998": {
      "text": "I want in on SRW! Mercy, Sayaka!",
      "status": "imported"
    },
    "voice_184:r_0ef83b6a1e87f6fd": {
      "text": "Okay, Sayaka. SRW is solo play...",
      "status": "imported"
    },
    "voice_184:r_a8f0666c4d6d24a0": {
      "text": "Mazinger and Venus A. Two as one!",
      "status": "imported"
    },
    "voice_184:r_3ec7c6e48027a853": {
      "text": "Nice work! Done for today? Me too.",
      "status": "imported"
    },
    "voice_184:r_953824ba6b607e1f": {
      "text": "What's wrong, Shiro!?",
      "status": "imported"
    },
    "voice_184:r_d6c7a401f55ee42f": {
      "text": "Easy... A break means time to cook!",
      "status": "imported"
    },
    "voice_184:r_7bce428a8c95c22c": {
      "text": "No girlfriend? So what? Stop, Shiro!",
      "status": "imported"
    },
    "voice_184:r_97b5fedc5b19e6af": {
      "text": "Bro, we've got a huge problem!",
      "status": "imported"
    },
    "voice_184:r_111aa50202ff773f": {
      "text": "I'm starving... My gut's caving in!",
      "status": "imported"
    },
    "voice_184:r_10cb1d3f8f325f52": {
      "text": "Three-star chef! How are you single?",
      "status": "imported"
    },
    "voice_184:r_ed69cbf9ff3779a7": {
      "text": "Your dream isn't everyone else's!",
      "status": "imported"
    },
    "voice_184:r_82e0a318411dcbf7": {
      "text": "Selfish ideas\\ngo flying with you!",
      "status": "imported"
    },
    "voice_184:r_ae913eb08e0ff29b": {
      "text": "I'll go first!",
      "status": "imported"
    },
