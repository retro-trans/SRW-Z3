{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_069:r_479b340ccc6c572b": {
      "text": "Got you!",
      "status": "imported"
    },
    "voice_069:r_ca4acbac57a2a35e": {
      "text": "I'll take point!",
      "status": "imported"
    },
    "voice_069:r_77949221bf58f862": {
      "text": "There!",
      "status": "imported"
    },
    "voice_069:r_70b9c4b9f1f37eff": {
      "text": "You won't escape!",
      "status": "imported"
    },
    "voice_069:r_9fcb3754cb1773c7": {
      "text": "I'll take this!",
      "status": "imported"
    },
    "voice_069:r_3559d2fad32c2435": {
      "text": "You're mine!",
      "status": "imported"
    },
    "voice_069:r_f7570547e9f80a64": {
      "text": "I'll make the first move!",
      "status": "imported"
    },
    "voice_069:r_cbab0f4720e1fcf1": {
      "text": "Show me what you can do!",
      "status": "imported"
    },
    "voice_069:r_0bbe0b4f5364e732": {
      "text": "This range is enough for me!",
      "status": "imported"
    },
    "voice_069:r_5dda5198137cb02a": {
      "text": "You were out of luck!",
      "status": "imported"
    },
    "voice_069:r_83ec59afbecdec14": {
      "text": "Behold the power of my Brave!",
      "status": "imported"
    },
    "voice_069:r_e20bfd42ad95a3c9": {
      "text": "Graham Aker and\\nBrave face you!",
      "status": "imported"
    },
    "voice_069:r_0f58a8822381e57f": {
      "text": "I'm quite sure of my marksmanship!",
      "status": "imported"
    },
    "voice_069:r_6dbcc507fb61b51d": {
      "text": "I'll hit you at any range!",
      "status": "imported"
    },
    "voice_069:r_b42ab697149a7c8a": {
      "text": "Uoooooh!",
      "status": "imported"
    },
    "voice_069:r_4de4fcf3b440baf4": {
      "text": "Haaah!",
      "status": "imported"
    },
    "voice_069:r_0121a166c715cdff": {
      "text": "Deyaaah!",
      "status": "imported"
    },
    "voice_069:r_30fad37a42bd3ad3": {
      "text": "You thought you could escape?!",
      "status": "imported"
    },
    "voice_069:r_80a0b2a84e05d81a": {
      "text": "Far too careless!",
      "status": "imported"
    },
    "voice_069:r_4a9ac1dff86506d9": {
      "text": "Pursuit is easy for the Brave!",
      "status": "imported"
    },
    "voice_069:r_bc8538e6af3d2577": {
      "text": "So my foe is a Gundam-type...!",
      "status": "imported"
    },
    "voice_069:r_924516c8de2b5342": {
      "text": "A Gundam-type! A worthy foe!",
      "status": "imported"
    },
    "voice_069:r_da1174533722333f": {
      "text": "I'd reason with another...\\nnot you!",
      "status": "imported"
    },
    "voice_069:r_fdeb8162976e72c1": {
      "text": "No words, fiend.\\nOnly this blow!",
      "status": "imported"
    },
    "voice_069:r_0fadb5c26df92b42": {
      "text": "Our peace was hard-won.\\nNo mercy!",
      "status": "imported"
    },
    "voice_069:r_6b15af9a0057cdc8": {
      "text": "If you won't listen, then leave!",
      "status": "imported"
    },
    "voice_069:r_15b4a90140e8a33a": {
      "text": "A life once cast off -\\nfor mankind!",
      "status": "imported"
    },
    "voice_069:r_af884a6b11dff121": {
      "text": "Graham Aker lives\\nto make tomorrow!",
      "status": "imported"
    },
    "voice_069:r_ac6fe7838e95647b": {
      "text": "I won't die.\\nI'll live through this!",
      "status": "imported"
    },
    "voice_069:r_7d724dbcc4451e10": {
      "text": "Trans-Am!",
      "status": "imported"
    },
    "voice_069:r_93e25418a203cb8f": {
      "text": "It doesn't end here!",
      "status": "imported"
    },
    "voice_069:r_adeb0a29274d3d9b": {
      "text": "Next time...!",
      "status": "imported"
    },
    "voice_069:r_24cf161287ef9d5c": {
      "text": "Engaging Trans-Am!",
      "status": "imported"
    },
    "voice_069:r_8f60f6fc86db3107": {
      "text": "Not yet, not yet! Raaaagh!!",
      "status": "imported"
    },
    "voice_069:r_b1de76a75a253c13": {
      "text": "Ngh! All that remains...!",
      "status": "imported"
    },
    "voice_069:r_128c35bf3e0e394c": {
      "text": "Behold my ultimate technique!",
      "status": "imported"
    },
    "voice_069:r_5213c17e13b23de0": {
      "text": "Brave, Full Blast!",
      "status": "imported"
    },
    "voice_069:r_38fdff9483e9245c": {
      "text": "This is getting us nowhere!",
      "status": "imported"
    },
    "voice_069:r_620fedec67706d7d": {
      "text": "You call that keeping away? Absurd!",
      "status": "imported"
    },
    "voice_069:r_9680dcd0fddcfcc7": {
      "text": "I won't rest until I've struck back!",
      "status": "imported"
    },
    "voice_069:r_2a00f1044ad5cbaa": {
      "text": "The post-attack opening is the key!",
      "status": "imported"
    },
    "voice_069:r_3dbeead1bd3164ef": {
      "text": "Know that arrogance is a sin!",
      "status": "imported"
    },
    "voice_069:r_98d15b8cc09bc915": {
      "text": "Even if you strike first!",
      "status": "imported"
    },
    "voice_069:r_46e86d000250e137": {
      "text": "You saved me the search. My thanks!",
      "status": "imported"
    },
    "voice_069:r_ac341e7976e88f0b": {
      "text": "A step behind? Then...!",
      "status": "imported"
    },
    "voice_069:r_cdbd128a5b4127cc": {
      "text": "Years pass, but\\nI'm still impatient!",
      "status": "imported"
    },
    "voice_069:r_cfccaa1fbeda124c": {
      "text": "The rest?\\nLeave it to Graham Aker!",
      "status": "imported"
    },
    "voice_069:r_b1f8ec192b9c083a": {
      "text": "You called for me?!",
      "status": "imported"
    },
    "voice_069:r_a007f9ab9cf048b3": {
      "text": "Fighting with Gundam isn't bad!",
      "status": "imported"
    },
    "voice_069:r_ddafde4b065ced49": {
      "text": "There's more than Gundam!",
      "status": "imported"
    },
    "voice_069:r_de1213040856c089": {
      "text": "Young man, leave the rest to me!",
      "status": "imported"
    },
    "voice_069:r_3304412ac41f47a6": {
      "text": "Understood. I'll carry out the plan!",
      "status": "imported"
    },
    "voice_069:r_0c0775e051211840": {
      "text": "I see boundless conviction in you!",
      "status": "imported"
    },
    "voice_069:r_a2afffe1c396f0b3": {
      "text": "Patrick Mannequin...\\nskilled, but...",
      "status": "imported"
    },
    "voice_069:r_13c25fbdfddc8a24": {
      "text": "Nothing blooms from dying!",
      "status": "imported"
    },
    "voice_069:r_42ba1ecb310b4bd7": {
      "text": "Our allies are in danger!",
      "status": "imported"
    },
    "voice_069:r_d692f1d420460a47": {
      "text": "I can't watch\\nGundam fall to them!",
      "status": "imported"
    },
    "voice_069:r_a5643cec86b18bd2": {
      "text": "How pathetic, Gundam!",
      "status": "imported"
    },
    "voice_069:r_68f2dfab20a4a30e": {
      "text": "Young man, focus on the battle!",
      "status": "imported"
    },
    "voice_069:r_9cedad8237480563": {
      "text": "Don't die yet!\\nYou have work to do!",
      "status": "imported"
    },
    "voice_069:r_a03fabecba1508ca": {
      "text": "With your title,\\nyou need no help!",
      "status": "imported"
    },
    "voice_069:r_5391b24a71eb10ae": {
      "text": "Out of options...?!",
      "status": "imported"
    },
    "voice_069:r_a554ceef5c87b972": {
      "text": "Must I return to resupply...?!",
      "status": "imported"
    },
    "voice_069:r_546c3d5937fbb7ee": {
      "text": "I've used more than expected...",
      "status": "imported"
    },
    "voice_069:r_1568ff6298b12b96": {
      "text": "No weapon can counter this...!",
      "status": "imported"
    },
    "voice_069:r_2c9d94ba13c5fc50": {
      "text": "They gave even me the slip...!",
      "status": "imported"
    },
    "voice_069:r_a77f4913375098d2": {
      "text": "You refuse my challenge...!",
      "status": "imported"
    },
    "voice_069:r_428c2116ac3071b1": {
      "text": "Too green to take aim at me!",
      "status": "imported"
    },
    "voice_069:r_84c116267b79f540": {
      "text": "Using this machine makes it easy!",
      "status": "imported"
    },
    "voice_069:r_dad38ee29af2df3a": {
      "text": "It seems\\nyou can't match my moves.",
      "status": "imported"
    },
    "voice_069:r_3d32e86f8dc80909": {
      "text": "That's not enough to take my head!",
      "status": "imported"
    },
    "voice_069:r_70451ffbabe2f876": {
      "text": "As expected, Katagiri. Fine work.",
      "status": "imported"
    },
    "voice_069:r_69dfa1659715e2fa": {
      "text": "Good aim. Wrong opponent.",
      "status": "imported"
    },
    "voice_069:r_d996fd6d4ef5b329": {
      "text": "It seems I read you correctly.",
      "status": "imported"
    },
    "voice_069:r_8ab47a28f99ef565": {
      "text": "You're moving stiffly, Gundam!",
      "status": "imported"
    },
    "voice_069:r_546de3fb6db156ea": {
      "text": "I know how to fight Gundams!",
      "status": "imported"
    },
    "voice_069:r_9072ea7bc71df136": {
      "text": "Hmph. A dependable ally.",
      "status": "imported"
    },
    "voice_069:r_04e815a8d425827d": {
      "text": "To think I must rely on this...!",
      "status": "imported"
    },
    "voice_069:r_d89011fe3e5d082a": {
      "text": "This equipment is rather useful.",
      "status": "imported"
    },
    "voice_069:r_3c5b0c2ac812d5de": {
      "text": "You offer no challenge!",
      "status": "imported"
    },
    "voice_069:r_5b9e8897190892eb": {
      "text": "You lack all it takes to defeat me!",
      "status": "imported"
    },
    "voice_069:r_7bea3023abbf8a94": {
      "text": "You would lure\\nthis Graham Aker?!",
      "status": "imported"
    },
    "voice_069:r_dd01a4c0d1b36a8d": {
      "text": "Damn it! What are you plotting...?!",
      "status": "imported"
    },
    "voice_069:r_20920ad2eb3542db": {
      "text": "Tch! I can't shake them...!",
      "status": "imported"
    },
    "voice_069:r_0ab7914877fd48ed": {
      "text": "Was my first move a bit late...?",
      "status": "imported"
    },
    "voice_069:r_cb846feec748c2e3": {
      "text": "Guh...! I was caught off guard...?!",
      "status": "imported"
    },
    "voice_069:r_c958860b0676b1f5": {
      "text": "This won't drive me to despair!",
      "status": "imported"
    },
    "voice_069:r_5e2669b82ef75ce3": {
      "text": "Hmph. I've learned patience...\\nbut!",
      "status": "imported"
    },
    "voice_069:r_7847e0ed7dc9282d": {
      "text": "I can't fall. I'd set a bad example!",
      "status": "imported"
    },
    "voice_069:r_e42b52c7a987b906": {
      "text": "Ngh...! You're good, I'll grant you!",
      "status": "imported"
    },
    "voice_069:r_6825fd1ff907bd22": {
      "text": "I truly am a man without luck...!",
      "status": "imported"
    },
    "voice_069:r_607f666f1563bc0d": {
      "text": "So... you'll make me get serious!",
      "status": "imported"
    },
    "voice_069:r_97b7431eeb81e6b6": {
      "text": "That's how it ought to be!",
      "status": "imported"
    },
    "voice_069:r_132f605d02975e71": {
      "text": "Gundam, we're bound by fate...!",
      "status": "imported"
    },
    "voice_069:r_9b9726b1872759d6": {
      "text": "You truly stand apart, Gundam!",
      "status": "imported"
    },
    "voice_069:r_1252db29683fefe0": {
      "text": "Such power...!\\nBut I won't cower!",
      "status": "imported"
    },
    "voice_069:r_ad3d538f1e909184": {
      "text": "Maybe hopeless...\\nStill, I fight on!",
      "status": "imported"
    },
    "voice_069:r_8c61c59a1c0aebbf": {
      "text": "A clean hit...!\\nWhat rotten luck...!",
      "status": "imported"
    },
    "voice_069:r_aba6a7662129d8ce": {
      "text": "Hit just wrong,\\nany armor fails?!",
      "status": "imported"
    },
    "voice_069:r_b84afafb8a33ec60": {
      "text": "Howard... Daryl...!\\nI can't go yet!",
      "status": "imported"
    },
    "voice_069:r_c8c59db85bf875e6": {
      "text": "I concede... you're a mighty foe!",
      "status": "imported"
    },
    "voice_069:r_391aa56435d9dd6e": {
      "text": "No performance gap will beat me!",
      "status": "imported"
    },
    "voice_069:r_7c796ba53bd7ea03": {
      "text": "Ugh!\\nI can't die with this undone!",
      "status": "imported"
    },
    "voice_069:r_fa944da4b6519006": {
      "text": "Guh...! I feel guilty joy,\\nGundam!",
      "status": "imported"
    },
    "voice_069:r_95d047bcc17fccc6": {
      "text": "Well done, Gundam!\\nI'm Graham Aker!",
      "status": "imported"
    },
    "voice_069:r_640327a12a559b31": {
      "text": "Am I only human after all...?",
      "status": "imported"
    },
    "voice_069:r_bdd38c584fa313d0": {
      "text": "I swear I'll erase this disgrace...!",
      "status": "imported"
    },
    "voice_069:r_3fd86c1027f317c8": {
      "text": "Magnificent...!",
      "status": "imported"
    },
    "voice_069:r_d0372a183d2007ad": {
      "text": "I'll follow\\nyour red thread of fate!",
      "status": "imported"
    },
    "voice_069:r_217aa5e1d545b44d": {
      "text": "Let me add a gleam to your freedom!",
      "status": "imported"
    },
    "voice_069:r_381992c5d8224937": {
      "text": "Young man,\\ndon't rage over pride!",
      "status": "imported"
    },
    "voice_069:r_f1e7ed9e5874aba5": {
      "text": "Kira Yamato's will\\nwas clear to me!",
      "status": "imported"
    },
    "voice_069:r_fc25e66a86fc2c85": {
      "text": "Red Comet!\\nShow me your brilliance!",
      "status": "imported"
    },
    "voice_069:r_5aeeb4917340c42d": {
      "text": "Face me in a duel, Char Aznable!",
      "status": "imported"
    },
    "voice_069:r_b765659981b6516d": {
      "text": "Give me your all, Full Frontal!",
      "status": "imported"
    },
    "voice_069:r_0c427458bc00eb95": {
      "text": "A boost that small\\ncan defeat me?!",
      "status": "imported"
    },
    "voice_069:r_7d2617c809fead70": {
      "text": "Are you all prisoners of obsession?!",
      "status": "imported"
    },
    "voice_069:r_ceb935ccbf830724": {
      "text": "A united world...!\\nStill beyond us?!",
      "status": "imported"
    },
    "voice_069:r_862ef7385bf2abd4": {
      "text": "Our homeworld is worth our lives!",
      "status": "imported"
    },
    "voice_069:r_001cbec4d9a4283f": {
      "text": "So fate brings us here, Gundam!",
      "status": "imported"
    },
    "voice_069:r_8ad40afecd02b41e": {
      "text": "Before Gundam,\\nI cannot remain calm!",
      "status": "imported"
    },
    "voice_069:r_26e5efec03c03d78": {
      "text": "This moment alone...\\nGundam is all!",
      "status": "imported"
    },
    "voice_069:r_4ad81e88c7557a8b": {
      "text": "I'm loath, but have no choice...!",
      "status": "imported"
    },
    "voice_069:r_1f65a7af190e4674": {
      "text": "You have no way with women...!",
      "status": "imported"
    },
    "voice_069:r_40c5a9358ed5bf29": {
      "text": "Quit your sniveling, Mikage!",
      "status": "imported"
    },
    "voice_069:r_f2e18dfdfe0c89ea": {
      "text": "I won't hear your hate-filled cries!",
      "status": "imported"
    },
    "voice_069:r_cf7dbf49e96a5755": {
      "text": "Explanations will have to wait...!",
      "status": "imported"
    },
    "voice_069:r_fa96676cc65bb509": {
      "text": "We stand as foes.\\nWhoever you are!",
      "status": "imported"
    },
    "voice_069:r_4e37f92e7d2fc62e": {
      "text": "We fight as humanity's hope!",
      "status": "imported"
    },
    "voice_069:r_0bad405ee6ca63ba": {
      "text": "Behold humanity's true power!",
      "status": "imported"
    },
    "voice_069:r_6c13bbfd27a7799e": {
      "text": "I see your ego...\\nand reject it!",
      "status": "imported"
    },
    "voice_069:r_06f88dcbd3c9e738": {
      "text": "Rule by force,\\nbe stopped by force!",
      "status": "imported"
    },
    "voice_069:r_b28faf9f71bc3598": {
      "text": "All ends here...!\\nThen it begins!",
      "status": "imported"
    },
    "voice_069:r_8a29278549f8e07a": {
      "text": "I dare say it: know your shame!",
      "status": "imported"
    },
    "voice_069:r_7e6c573c26177f98": {
      "text": "I detest this...!\\nThat says it all!",
      "status": "imported"
    },
    "voice_069:r_6026da5acbda7c69": {
      "text": "The Red Comet name is no mere boast!",
      "status": "imported"
    },
    "voice_069:r_981f8fedd5414fe5": {
      "text": "Thunder God follows Wind God!",
      "status": "imported"
    },
    "voice_069:r_96bb0dcde0c8c44a": {
      "text": "Union and AEU aces, side by side!",
      "status": "imported"
    },
    "voice_069:r_641550a2f54cb456": {
      "text": "Almost bewitching, Unicorn Gundam!",
      "status": "imported"
    },
    "voice_069:r_a0f2074af8debbfa": {
      "text": "I could fly wing to wing with you!",
      "status": "imported"
    },
    "voice_069:r_b5f5a97ed82acb0b": {
      "text": "The Red Comet must remain noble!",
      "status": "imported"
    },
    "voice_069:r_d9cd2e4ded064396": {
      "text": "I'll protect my ally myself!",
      "status": "imported"
    },
    "voice_069:r_99e6349431aaf23b": {
      "text": "You shame the name of the AEU's ace!",
      "status": "imported"
    },
    "voice_069:r_ec1081caf845f56a": {
      "text": "No one harms the Unicorn Gundam!",
      "status": "imported"
    },
    "voice_069:r_2c5b7ee872c1ed7f": {
      "text": "I'll protect your wings!",
      "status": "imported"
    },
    "voice_069:r_76d1e51c8b494a60": {
      "text": "I never knew unmasking felt so good.",
      "status": "imported"
    },
    "voice_069:r_eb5f687fcd372ae7": {
      "text": "But you mustn't be afraid of that.",
      "status": "imported"
    },
    "voice_069:r_2329428a6871d9fa": {
      "text": "Nice flying, Alto. Our sky is grand.",
      "status": "imported"
    },
    "voice_069:r_0e7466971bec4cc4": {
      "text": "Oh...? Then I am your wings?",
      "status": "imported"
    },
    "voice_069:r_efa71f7a4cc33ff3": {
      "text": "Ha ha ha ha ha! My romantic reply.",
      "status": "imported"
    },
    "voice_069:r_3fc2e1186557e7a0": {
      "text": "I'm a Virgo romantic. Shall I go on?",
      "status": "imported"
    },
    "voice_069:r_fa6930340a545054": {
      "text": "If you'll excuse me, I'll go ahead!",
      "status": "imported"
    },
    "voice_069:r_2332b9d56461d7ab": {
      "text": "First, allow me!",
      "status": "imported"
    },
    "voice_069:r_854aa0a91a3c80d1": {
      "text": "Launch your attack after mine!",
      "status": "imported"
    },
    "voice_069:r_0bc8ae32a406ceab": {
      "text": "Graham Aker is here!",
      "status": "imported"
    },
    "voice_069:r_82c09f011d703b2c": {
      "text": "I know what my duty is!",
      "status": "imported"
    },
    "voice_069:r_2b4d8818c77b6dca": {
      "text": "I need no help!",
      "status": "imported"
    },
    "voice_069:r_087354f2db0a31e6": {
      "text": "Rest easy. You're in capable hands!",
      "status": "imported"
    },
    "voice_069:r_db02a2dec93dd263": {
      "text": "I'll split their forces!",
      "status": "imported"
    },
    "voice_069:r_d520c6d5298a848d": {
      "text": "I'm not exactly eager, but...",
      "status": "imported"
    },
    "voice_069:r_099e2458cabf796f": {
      "text": "I'm going ahead! Don't fall behind!",
      "status": "imported"
    },
    "voice_069:r_fd910d714be70870": {
      "text": "I'll finish the enemy before us!",
      "status": "imported"
