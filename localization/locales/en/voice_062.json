{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_062:r_479b340ccc6c572b": {
      "text": "All right, let's go!",
      "status": "imported"
    },
    "voice_062:r_ca4acbac57a2a35e": {
      "text": "Heh heh, this one's mine!",
      "status": "imported"
    },
    "voice_062:r_77949221bf58f862": {
      "text": "Watch me, Simon!",
      "status": "imported"
    },
    "voice_062:r_70b9c4b9f1f37eff": {
      "text": "Gimmy Adai! Here I go!",
      "status": "imported"
    },
    "voice_062:r_9fcb3754cb1773c7": {
      "text": "I can't let Darry beat me!",
      "status": "imported"
    },
    "voice_062:r_3559d2fad32c2435": {
      "text": "I'm not just sitting back anymore!",
      "status": "imported"
    },
    "voice_062:r_f7570547e9f80a64": {
      "text": "Let's do this with style!",
      "status": "imported"
    },
    "voice_062:r_cbab0f4720e1fcf1": {
      "text": "Let's blaze ahead! Space Gunmarl!",
      "status": "imported"
    },
    "voice_062:r_0bbe0b4f5364e732": {
      "text": "One more time! One more time!",
      "status": "imported"
    },
    "voice_062:r_5dda5198137cb02a": {
      "text": "Mugann! You won't have your way!",
      "status": "imported"
    },
    "voice_062:r_83ec59afbecdec14": {
      "text": "Let's settle this, Anti-Spiral!",
      "status": "imported"
    },
    "voice_062:r_e20bfd42ad95a3c9": {
      "text": "I'll waste this monster in no time!",
      "status": "imported"
    },
    "voice_062:r_0f58a8822381e57f": {
      "text": "The enemy commander! They're mine!",
      "status": "imported"
    },
    "voice_062:r_6dbcc507fb61b51d": {
      "text": "It's over!\\nI'll end this in style!",
      "status": "imported"
    },
    "voice_062:r_b42ab697149a7c8a": {
      "text": "Don't be scared of my shooting!",
      "status": "imported"
    },
    "voice_062:r_4de4fcf3b440baf4": {
      "text": "Wherever you run, I'll shoot you!",
      "status": "imported"
    },
    "voice_062:r_0121a166c715cdff": {
      "text": "This really\\nsuits me better!",
      "status": "imported"
    },
    "voice_062:r_30fad37a42bd3ad3": {
      "text": "Wooooaaah!!",
      "status": "imported"
    },
    "voice_062:r_80a0b2a84e05d81a": {
      "text": "A man's gotta have guts! Let's go!",
      "status": "imported"
    },
    "voice_062:r_bc8538e6af3d2577": {
      "text": "Let's clean this up, Darry!",
      "status": "imported"
    },
    "voice_062:r_924516c8de2b5342": {
      "text": "Right! But don't get reckless!",
      "status": "imported"
    },
    "voice_062:r_da1174533722333f": {
      "text": "I know! Take this!",
      "status": "imported"
    },
    "voice_062:r_fdeb8162976e72c1": {
      "text": "You don't get it at all, Gimmy!",
      "status": "imported"
    },
    "voice_062:r_0fadb5c26df92b42": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_062:r_6b15af9a0057cdc8": {
      "text": "It's over!",
      "status": "imported"
    },
    "voice_062:r_15b4a90140e8a33a": {
      "text": "Heh heh! That was easy!",
      "status": "imported"
    },
    "voice_062:r_af884a6b11dff121": {
      "text": "Honestly, he gets carried away...",
      "status": "imported"
    },
    "voice_062:r_ac6fe7838e95647b": {
      "text": "Gimmy! Let's use our combo!",
      "status": "imported"
    },
    "voice_062:r_77ca87eacd17ad52": {
      "text": "I've been waiting! All right...",
      "status": "imported"
    },
    "voice_062:r_bf3244994760e535": {
      "text": "Here I gooooo!!",
      "status": "imported"
    },
    "voice_062:r_aabfb21c9d069ce7": {
      "text": "Honestly! You always rush ahead!",
      "status": "imported"
    },
    "voice_062:r_02479dc8fe989560": {
      "text": "Time to finish it!",
      "status": "imported"
    },
    "voice_062:r_a2df00f91a9b0a9e": {
      "text": "Let's combine our strength!",
      "status": "imported"
    },
    "voice_062:r_48b60d6c48b9b142": {
      "text": "Gimmy! Lucky we beat it, but...!",
      "status": "imported"
    },
    "voice_062:r_8927e6fb681aa809": {
      "text": "Great. Another lecture from Darry...",
      "status": "imported"
    },
    "voice_062:r_665f01666859013b": {
      "text": "Darry! Let's do a sibling fusion!",
      "status": "imported"
    },
    "voice_062:r_a571eec59b258d11": {
      "text": "Come on! Don't say stupid things!",
      "status": "imported"
    },
    "voice_062:r_ddbe581c5ea9183d": {
      "text": "I'm joking! Now let's go!",
      "status": "imported"
    },
    "voice_062:r_faae935cca0edc72": {
      "text": "We can't fuse, but we can team up!",
      "status": "imported"
    },
    "voice_062:r_dc8701f6bcb9904f": {
      "text": "You'll pay for that, you jerk!",
      "status": "imported"
    },
    "voice_062:r_d6bdd730f24f66eb": {
      "text": "You... How dare you!",
      "status": "imported"
    },
    "voice_062:r_41997412868c48c4": {
      "text": "I'll pay you back double!",
      "status": "imported"
    },
    "voice_062:r_9e6cf4f389dae55c": {
      "text": "Come on! The exit's that way!",
      "status": "imported"
    },
    "voice_062:r_9e0c80ac7e33b459": {
      "text": "Time to counter! Let's go!",
      "status": "imported"
    },
    "voice_062:r_7432ef43ed3471dc": {
      "text": "Now it's my turn!",
      "status": "imported"
    },
    "voice_062:r_065443f6ddfcf0d7": {
      "text": "Dead accurate as ever, Darry!",
      "status": "imported"
    },
    "voice_062:r_47d52a2839c71715": {
      "text": "Gurren Lagann's always amazing!",
      "status": "imported"
    },
    "voice_062:r_847f82e7f3eef651": {
      "text": "I'll catch up to Simon! Just watch!",
      "status": "imported"
    },
    "voice_062:r_eb7ae28b53dc033c": {
      "text": "I'll do my part too, Yoko!",
      "status": "imported"
    },
    "voice_062:r_857c4a52ce8df0fd": {
      "text": "You're really fired up, Kittan!",
      "status": "imported"
    },
    "voice_062:r_55417493fce1d347": {
      "text": "I'll be your shield!",
      "status": "imported"
    },
    "voice_062:r_8fdf5910927c9591": {
      "text": "Like hell I'll let you hurt Darry!",
      "status": "imported"
    },
    "voice_062:r_7d724dbcc4451e10": {
      "text": "I won't let you get in Simon's way!",
      "status": "imported"
    },
    "voice_062:r_93e25418a203cb8f": {
      "text": "Keep moving, Yoko! It's dangerous!",
      "status": "imported"
    },
    "voice_062:r_adeb0a29274d3d9b": {
      "text": "Kittan!\\nYou're getting way too wild!",
      "status": "imported"
    },
    "voice_062:r_24cf161287ef9d5c": {
      "text": "We can't attack them from here!?",
      "status": "imported"
    },
    "voice_062:r_8f60f6fc86db3107": {
      "text": "Damn it! I'm no good at waiting!",
      "status": "imported"
    },
    "voice_062:r_b1de76a75a253c13": {
      "text": "Crap! The battery's about to die!",
      "status": "imported"
    },
    "voice_062:r_128c35bf3e0e394c": {
      "text": "They're up high,\\nout of my reach...!",
      "status": "imported"
    },
    "voice_062:r_5213c17e13b23de0": {
      "text": "Heh heh! How's that?",
      "status": "imported"
    },
    "voice_062:r_38fdff9483e9245c": {
      "text": "That was a piece of cake!",
      "status": "imported"
    },
    "voice_062:r_620fedec67706d7d": {
      "text": "Whoa! Like I'd let that hit me!",
      "status": "imported"
    },
    "voice_062:r_9680dcd0fddcfcc7": {
      "text": "That didn't faze me at all!",
      "status": "imported"
    },
    "voice_062:r_98d15b8cc09bc915": {
      "text": "Whoa! It only hit my shield!",
      "status": "imported"
    },
    "voice_062:r_46e86d000250e137": {
      "text": "That shield saved me...!",
      "status": "imported"
    },
    "voice_062:r_ac341e7976e88f0b": {
      "text": "Tch! They got me!",
      "status": "imported"
    },
    "voice_062:r_cdbd128a5b4127cc": {
      "text": "What!? I thought I dodged that!",
      "status": "imported"
    },
    "voice_062:r_cfccaa1fbeda124c": {
      "text": "I can take all the hits you've got!",
      "status": "imported"
    },
    "voice_062:r_b1f8ec192b9c083a": {
      "text": "A Gunmarl's huge and tough!",
      "status": "imported"
    },
    "voice_062:r_a007f9ab9cf048b3": {
      "text": "Damn! Did I let my guard down!?",
      "status": "imported"
    },
    "voice_062:r_ddafde4b065ced49": {
      "text": "Tch! Big means easy to hit, huh...!",
      "status": "imported"
    },
    "voice_062:r_de1213040856c089": {
      "text": "No way... I never saw that coming!",
      "status": "imported"
    },
    "voice_062:r_3304412ac41f47a6": {
      "text": "Whoa!? That hit me dead-on!?",
      "status": "imported"
    },
    "voice_062:r_0c0775e051211840": {
      "text": "Rather than lose,\\nI'll risk it...!",
      "status": "imported"
    },
    "voice_062:r_a2afffe1c396f0b3": {
      "text": "Damn it!\\nDon't go down, Gunmarl!!",
      "status": "imported"
    },
    "voice_062:r_13c25fbdfddc8a24": {
      "text": "Not yet! Like our vets,\\ncomeback!!",
      "status": "imported"
    },
    "voice_062:r_42ba1ecb310b4bd7": {
      "text": "What's up, punk!?\\nI'm still alive!!",
      "status": "imported"
    },
    "voice_062:r_d692f1d420460a47": {
      "text": "Won't quit!\\nTeam Dai-Gurren spirit!",
      "status": "imported"
    },
    "voice_062:r_a5643cec86b18bd2": {
      "text": "If I fall, Darry\\nhas no defender...!",
      "status": "imported"
    },
    "voice_062:r_68f2dfab20a4a30e": {
      "text": "Waaaaaaah!!",
      "status": "imported"
    },
    "voice_062:r_9cedad8237480563": {
      "text": "I-I screwed up! They got me!",
      "status": "imported"
    },
    "voice_062:r_a03fabecba1508ca": {
      "text": "I'm sorry, Darry...!",
      "status": "imported"
    },
    "voice_062:r_5391b24a71eb10ae": {
      "text": "I'll back you up, Dayakka!",
      "status": "imported"
    },
    "voice_062:r_a554ceef5c87b972": {
      "text": "Oh! Here's my chance!",
      "status": "imported"
    },
    "voice_062:r_546c3d5937fbb7ee": {
      "text": "Did you see my barrier?!",
      "status": "imported"
    },
    "voice_062:r_1568ff6298b12b96": {
      "text": "You've gotta defend your own home!",
      "status": "imported"
    },
    "voice_062:r_2c9d94ba13c5fc50": {
      "text": "A huge Gunmarl can handle this much!",
      "status": "imported"
    },
    "voice_062:r_a77f4913375098d2": {
      "text": "More faces don't always\\nmean better!",
      "status": "imported"
    },
    "voice_062:r_428c2116ac3071b1": {
      "text": "You creeps make me sick!",
      "status": "imported"
    },
    "voice_062:r_3d32e86f8dc80909": {
      "text": "Focus our attacks and we'll win!",
      "status": "imported"
    },
    "voice_062:r_70451ffbabe2f876": {
      "text": "I aim straight for the center!",
      "status": "imported"
    },
    "voice_062:r_69dfa1659715e2fa": {
      "text": "I'll hold them here!",
      "status": "imported"
    },
    "voice_062:r_d996fd6d4ef5b329": {
      "text": "So you're my opponent!",
      "status": "imported"
    },
    "voice_062:r_8ab47a28f99ef565": {
      "text": "I can't waste all my time on you!",
      "status": "imported"
    },
    "voice_062:r_546de3fb6db156ea": {
      "text": "All right! Time to show my stuff!",
      "status": "imported"
    }
  }
}
