{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_033:r_479b340ccc6c572b": {
      "text": "Annalotta Stohls,\\nbeginning attack!",
      "status": "imported"
    },
    "voice_033:r_77949221bf58f862": {
      "text": "Initiating elimination at once!",
      "status": "imported"
    },
    "voice_033:r_70b9c4b9f1f37eff": {
      "text": "The plan stands. Begin combat!",
      "status": "imported"
    },
    "voice_033:r_9fcb3754cb1773c7": {
      "text": "The enemy must be eliminated!",
      "status": "imported"
    },
    "voice_033:r_3559d2fad32c2435": {
      "text": "Commencing the execution!",
      "status": "imported"
    },
    "voice_033:r_f7570547e9f80a64": {
      "text": "Your fate ends here!",
      "status": "imported"
    },
    "voice_033:r_cbab0f4720e1fcf1": {
      "text": "Lament your rotten luck!",
      "status": "imported"
    },
    "voice_033:r_0bbe0b4f5364e732": {
      "text": "We met in battle. Expect no mercy!",
      "status": "imported"
    },
    "voice_033:r_5dda5198137cb02a": {
      "text": "I've gathered ample data on you!",
      "status": "imported"
    },
    "voice_033:r_83ec59afbecdec14": {
      "text": "Success odds: 79.3%!\\nWe can do it!",
      "status": "imported"
    },
    "voice_033:r_e20bfd42ad95a3c9": {
      "text": "They're already caught in our trap!",
      "status": "imported"
    },
    "voice_033:r_0f58a8822381e57f": {
      "text": "Pitiful. You're cornered, unaware!",
      "status": "imported"
    },
    "voice_033:r_6dbcc507fb61b51d": {
      "text": "What in the world am I doing...!",
      "status": "imported"
    },
    "voice_033:r_b42ab697149a7c8a": {
      "text": "For now, I'll fight as one human!",
      "status": "imported"
    },
    "voice_033:r_4de4fcf3b440baf4": {
      "text": "I'll show you\\nhow Geminis fights!",
      "status": "imported"
    },
    "voice_033:r_0121a166c715cdff": {
      "text": "In Diosc,\\ndefeat is forbidden!",
      "status": "imported"
    },
    "voice_033:r_30fad37a42bd3ad3": {
      "text": "Geminis pride -\\nGeminaid grit!",
      "status": "imported"
    },
    "voice_033:r_80a0b2a84e05d81a": {
      "text": "Our dead homeworld's grief burns!",
      "status": "imported"
    },
    "voice_033:r_4a9ac1dff86506d9": {
      "text": "We've come too far\\nto turn back...!",
      "status": "imported"
    },
    "voice_033:r_bc8538e6af3d2577": {
      "text": "I'll win...! For this child too...!",
      "status": "imported"
    },
    "voice_033:r_924516c8de2b5342": {
      "text": "Call it spite -\\nwe chose this path!",
      "status": "imported"
    },
    "voice_033:r_da1174533722333f": {
      "text": "We fight to live!\\nCall us cruel!",
      "status": "imported"
    },
    "voice_033:r_fdeb8162976e72c1": {
      "text": "My attack isn't over yet!",
      "status": "imported"
    },
    "voice_033:r_0fadb5c26df92b42": {
      "text": "I won't waste my chance to strike!",
      "status": "imported"
    },
    "voice_033:r_6b15af9a0057cdc8": {
      "text": "That machine must not exist!",
      "status": "imported"
    },
    "voice_033:r_15b4a90140e8a33a": {
      "text": "Your very existence insults us!",
      "status": "imported"
    },
    "voice_033:r_af884a6b11dff121": {
      "text": "You defiled our pride. Die for it!",
      "status": "imported"
    },
    "voice_033:r_ac6fe7838e95647b": {
      "text": "I will personally bring you down!",
      "status": "imported"
    },
    "voice_033:r_77ca87eacd17ad52": {
      "text": "What in the world are you?!",
      "status": "imported"
    },
    "voice_033:r_bf3244994760e535": {
      "text": "Why do you insist on opposing us?!",
      "status": "imported"
    },
    "voice_033:r_aabfb21c9d069ce7": {
      "text": "You power-reliant lumbering fool!",
      "status": "imported"
    },
    "voice_033:r_02479dc8fe989560": {
      "text": "Brute power\\ncan't beat our tactics!",
      "status": "imported"
    },
    "voice_033:r_a2df00f91a9b0a9e": {
      "text": "A demon god imbued with light?!",
      "status": "imported"
    },
    "voice_033:r_48b60d6c48b9b142": {
      "text": "Getter Rays!\\nFrightening ignorance!",
      "status": "imported"
    },
    "voice_033:r_8927e6fb681aa809": {
      "text": "Blind to\\nwhat evolution brings!",
      "status": "imported"
    },
    "voice_033:r_a571eec59b258d11": {
      "text": "That man!\\nHis psyche rivals mine!",
      "status": "imported"
    },
    "voice_033:r_ddbe581c5ea9183d": {
      "text": "I face the fabled Machine Angel!",
      "status": "imported"
    },
    "voice_033:r_faae935cca0edc72": {
      "text": "A man's romance won't sway a woman!",
      "status": "imported"
    },
    "voice_033:r_d4430bf362340b32": {
      "text": "Naked aggression...!\\nLike a beast!",
      "status": "imported"
    },
    "voice_033:r_6ff1323b355593e0": {
      "text": "I sense evil from that machine!",
      "status": "imported"
    },
    "voice_033:r_b7b5625d7cd4282f": {
      "text": "So the fabled Gundam has come!",
      "status": "imported"
    },
    "voice_033:r_36133ad73a73ef98": {
      "text": "So many variations\\nin this series!",
      "status": "imported"
    },
    "voice_033:r_920740a0219c5085": {
      "text": "So this one bears evolution's seed!",
      "status": "imported"
    },
    "voice_033:r_3633df5b7b8f47fa": {
      "text": "Your presence\\nbrought Earth misery!",
      "status": "imported"
    },
    "voice_033:r_1b9b2aab5cb104da": {
      "text": "Stay off the battlefield, clown!",
      "status": "imported"
    },
    "voice_033:r_342044c706a2340f": {
      "text": "U-ugh... This is hard to fight...",
      "status": "imported"
    },
    "voice_033:r_cf41e8828a90cbdb": {
      "text": "I'll tear those wings from you!",
      "status": "imported"
    },
    "voice_033:r_719e897304ec42d4": {
      "text": "Proud of your aerial skill? But...!",
      "status": "imported"
    },
    "voice_033:r_d5e0a2317c40d322": {
      "text": "A well-trained soldier, it seems!",
      "status": "imported"
    },
    "voice_033:r_ec2ea17765052401": {
      "text": "Skilled indeed.\\nI'd recruit you.",
      "status": "imported"
    },
    "voice_033:r_f2d4255f1c2f7542": {
      "text": "Fine soldier. A pity to kill.",
      "status": "imported"
    },
    "voice_033:r_5d08ad19e2da125b": {
      "text": "Your tactics threaten our mission!",
      "status": "imported"
    },
    "voice_033:r_dc8701f6bcb9904f": {
      "text": "A commander is the textbook target!",
      "status": "imported"
    },
    "voice_033:r_d6bdd730f24f66eb": {
      "text": "A famed Geminis woman\\nwon't lose!",
      "status": "imported"
    },
    "voice_033:r_41997412868c48c4": {
      "text": "Ace against ace!\\nA worthy foe!",
      "status": "imported"
    },
    "voice_033:r_9e6cf4f389dae55c": {
      "text": "That mobility won't shake me off!",
      "status": "imported"
    },
    "voice_033:r_9e0c80ac7e33b459": {
      "text": "Naive!\\nSpeed won't confound me!",
      "status": "imported"
    },
    "voice_033:r_7432ef43ed3471dc": {
      "text": "Size alone\\ndoesn't decide battles!",
      "status": "imported"
    },
    "voice_033:r_065443f6ddfcf0d7": {
      "text": "Esm hunts puny Salda\\nat full force!",
      "status": "imported"
    },
    "voice_033:r_47d52a2839c71715": {
      "text": "Hit the bridge\\nto down a warship!",
      "status": "imported"
    },
    "voice_033:r_847f82e7f3eef651": {
      "text": "One core hit will sink a warship!",
      "status": "imported"
    },
    "voice_033:r_eb7ae28b53dc033c": {
      "text": "Light Particle Maser!",
      "status": "imported"
    },
    "voice_033:r_857c4a52ce8df0fd": {
      "text": "Particles focused! Take this!",
      "status": "imported"
    },
    "voice_033:r_55417493fce1d347": {
      "text": "Psychokinetic aim! Shoot!",
      "status": "imported"
    },
    "voice_033:r_8fdf5910927c9591": {
      "text": "I'll cut you down with this blade!",
      "status": "imported"
    },
    "voice_033:r_7d724dbcc4451e10": {
      "text": "Taste the blade of light!",
      "status": "imported"
    },
    "voice_033:r_93e25418a203cb8f": {
      "text": "This is no mere laser blade!",
      "status": "imported"
    },
    "voice_033:r_adeb0a29274d3d9b": {
      "text": "Behold Geminis combat perfected!",
      "status": "imported"
    },
    "voice_033:r_24cf161287ef9d5c": {
      "text": "You won't evade this!",
      "status": "imported"
    },
    "voice_033:r_8f60f6fc86db3107": {
      "text": "Haaaaaah!",
      "status": "imported"
    },
    "voice_033:r_b1de76a75a253c13": {
      "text": "Psy-Ctrl!",
      "status": "imported"
    },
    "voice_033:r_128c35bf3e0e394c": {
      "text": "Here we go, Diosc!",
      "status": "imported"
    },
    "voice_033:r_5213c17e13b23de0": {
      "text": "This is Geminis Arts!",
      "status": "imported"
    },
    "voice_033:r_38fdff9483e9245c": {
      "text": "Witness my hard-honed skill!",
      "status": "imported"
    },
    "voice_033:r_620fedec67706d7d": {
      "text": "Psy-Ctrl, full contact!",
      "status": "imported"
    },
    "voice_033:r_9680dcd0fddcfcc7": {
      "text": "Shatter them, Diosc!",
      "status": "imported"
    },
    "voice_033:r_7c796ba53bd7ea03": {
      "text": "You failed to down me. You lose!",
      "status": "imported"
    },
    "voice_033:r_fa944da4b6519006": {
      "text": "Initiating counterattack at once!",
      "status": "imported"
    },
    "voice_033:r_95d047bcc17fccc6": {
      "text": "I'll down whoever attacked first!",
      "status": "imported"
    },
    "voice_033:r_640327a12a559b31": {
      "text": "This counterattack was in my plan!",
      "status": "imported"
    },
    "voice_033:r_bdd38c584fa313d0": {
      "text": "Know that I lured you in!",
      "status": "imported"
    },
    "voice_033:r_3fd86c1027f317c8": {
      "text": "Don't think you can escape!",
      "status": "imported"
    },
    "voice_033:r_d0372a183d2007ad": {
      "text": "Attacking me sealed your fate!",
      "status": "imported"
    },
    "voice_033:r_217aa5e1d545b44d": {
      "text": "I, Annalotta,\\nshow foes no mercy!",
      "status": "imported"
    },
    "voice_033:r_381992c5d8224937": {
      "text": "Now, you'll take my attack!",
      "status": "imported"
    },
    "voice_033:r_f1e7ed9e5874aba5": {
      "text": "I commend your nerve in attacking!",
      "status": "imported"
    },
    "voice_033:r_fc25e66a86fc2c85": {
      "text": "I'll cover you!",
      "status": "imported"
    },
    "voice_033:r_5aeeb4917340c42d": {
      "text": "I'll lead the next attack!",
      "status": "imported"
    },
    "voice_033:r_b765659981b6516d": {
      "text": "Geminis teamwork will finish them!",
      "status": "imported"
    },
    "voice_033:r_0c427458bc00eb95": {
      "text": "Gadlight! Leave the rest to me!",
      "status": "imported"
    },
    "voice_033:r_774a9ab4d8fd5351": {
      "text": "Gadlight!\\nAre you just playing?!",
      "status": "imported"
    },
    "voice_033:r_d3f01de714c015bd": {
      "text": "I'll be the shield here!",
      "status": "imported"
    },
    "voice_033:r_7d2617c809fead70": {
      "text": "Don't worry. It's simply my nature.",
      "status": "imported"
    },
    "voice_033:r_ceb935ccbf830724": {
      "text": "Officers must protect their troops!",
      "status": "imported"
    },
    "voice_033:r_862ef7385bf2abd4": {
      "text": "I won't let them take Gadlight!",
      "status": "imported"
    },
    "voice_033:r_001cbec4d9a4283f": {
      "text": "Fine tactics. I'll learn from them.",
      "status": "imported"
    },
    "voice_033:r_8ad40afecd02b41e": {
      "text": "They blocked my counterattack...!?",
      "status": "imported"
    },
    "voice_033:r_26e5efec03c03d78": {
      "text": "I made\\nsuch a petty mistake...!",
      "status": "imported"
    },
    "voice_033:r_4ad81e88c7557a8b": {
      "text": "They judged our effective range...!",
      "status": "imported"
    },
    "voice_033:r_1f65a7af190e4674": {
      "text": "What a pathetic attack.",
      "status": "imported"
    },
    "voice_033:r_40c5a9358ed5bf29": {
      "text": "Your combat skill amounts to that?",
      "status": "imported"
    },
    "voice_033:r_f2e18dfdfe0c89ea": {
      "text": "You're unfit to stand against me.",
      "status": "imported"
    },
    "voice_033:r_cf7dbf49e96a5755": {
      "text": "I can see everything!",
      "status": "imported"
    },
    "voice_033:r_fa96676cc65bb509": {
      "text": "Slow-witted fool! Shame on you!",
      "status": "imported"
    },
    "voice_033:r_4e37f92e7d2fc62e": {
      "text": "Be ashamed of your incompetence!",
      "status": "imported"
    },
    "voice_033:r_66ab4cfe1557909d": {
      "text": "With Diosc, this is no surprise.",
      "status": "imported"
    },
    "voice_033:r_0bad405ee6ca63ba": {
      "text": "That's Diosc. Excellent response.",
      "status": "imported"
    },
    "voice_033:r_2072eaf71a260ae7": {
      "text": "With my psychic power and Diosc...!",
      "status": "imported"
    },
    "voice_033:r_6c13bbfd27a7799e": {
      "text": "A hollow imitation after all!",
      "status": "imported"
    },
    "voice_033:r_06f88dcbd3c9e738": {
      "text": "I won't let you of all foes do it!",
      "status": "imported"
    },
    "voice_033:r_b28faf9f71bc3598": {
      "text": "Our Geminaid hope?\\nNot even close!",
      "status": "imported"
    },
    "voice_033:r_e33693e5ba4665b0": {
      "text": "It seems we must change tactics.",
      "status": "imported"
    },
    "voice_033:r_72a21a1a489af001": {
      "text": "We must update the enemy's data.",
      "status": "imported"
    },
    "voice_033:r_eb643f8bf737a0ca": {
      "text": "The enemy is growing as well.",
      "status": "imported"
    },
    "voice_033:r_0a3fccb71ec6cf2a": {
      "text": "Minor damage. No change in tactics.",
      "status": "imported"
    },
    "voice_033:r_9b63cf1f3e0207ef": {
      "text": "All systems normal.\\nBarely damaged.",
      "status": "imported"
    },
    "voice_033:r_8356f4e3dcdff938": {
      "text": "This won't shake my focus.",
      "status": "imported"
    },
    "voice_033:r_1d6d784036ae0bd7": {
      "text": "They caught a fleeting opening...!",
      "status": "imported"
    },
    "voice_033:r_625664af02183c17": {
      "text": "That move wasn't in the data...!",
      "status": "imported"
    },
    "voice_033:r_3701cba361f80ea5": {
      "text": "Oh... You managed to hit Diosc.",
      "status": "imported"
    },
    "voice_033:r_63f429c5c68c0863": {
      "text": "The Psy-Ctrl was disrupted...!",
      "status": "imported"
    },
    "voice_033:r_38e4a434c91d8ef0": {
      "text": "Ugh...! That attack was unexpected!",
      "status": "imported"
    },
    "voice_033:r_98ed411352a3a6ac": {
      "text": "An attack far beyond our data!",
      "status": "imported"
    },
    "voice_033:r_4824bea6bab3af67": {
      "text": "They read my tactical patterns...?!",
      "status": "imported"
    },
    "voice_033:r_862b92e63adb9734": {
      "text": "I see... Beyond projections, then!",
      "status": "imported"
    },
    "voice_033:r_cb306ef55e49d107": {
      "text": "Damaged,\\nbut nowhere near fatal!",
      "status": "imported"
    },
    "voice_033:r_57b2bd2de8a1408d": {
      "text": "This hardly counts as a crisis yet!",
      "status": "imported"
    },
    "voice_033:r_76f080a4881e8ab5": {
      "text": "Not bad, Earthling! That's better!",
      "status": "imported"
    },
    "voice_033:r_288133bc5b573dae": {
      "text": "Frontier fools, I thought.\\nNot bad!",
      "status": "imported"
    },
    "voice_033:r_6f95653e548f8fcf": {
      "text": "They risk all\\nfor their world...!",
      "status": "imported"
    },
    "voice_033:r_d249d68bada91ab9": {
      "text": "For life,\\nboth sides fight all-out!",
      "status": "imported"
    },
    "voice_033:r_e9b3307e9eb69f11": {
      "text": "You surpassed Diosc's movement?!",
      "status": "imported"
    },
    "voice_033:r_03cdac73042343ee": {
      "text": "Even Diosc\\nwas driven this far?!",
      "status": "imported"
    },
    "voice_033:r_6026da5acbda7c69": {
      "text": "To think they held such power...!",
      "status": "imported"
    },
    "voice_033:r_981f8fedd5414fe5": {
      "text": "Earthlings are like us, after all!",
      "status": "imported"
    },
    "voice_033:r_96bb0dcde0c8c44a": {
      "text": "No analysis! What was that attack?!",
      "status": "imported"
    },
    "voice_033:r_641550a2f54cb456": {
      "text": "Out here,\\na foe has cornered me?!",
      "status": "imported"
    },
    "voice_033:r_a0f2074af8debbfa": {
      "text": "My psychokinesis is wavering...!",
      "status": "imported"
    },
    "voice_033:r_b5f5a97ed82acb0b": {
      "text": "Guh!\\nI can't maintain output!",
      "status": "imported"
    },
    "voice_033:r_d9cd2e4ded064396": {
      "text": "The odds are bad! But I'm not done!",
      "status": "imported"
    },
    "voice_033:r_99e6349431aaf23b": {
      "text": "No more despair!\\nI fight on!",
      "status": "imported"
    },
    "voice_033:r_ec1081caf845f56a": {
      "text": "N-no...!\\nI must protect this child!",
      "status": "imported"
    },
    "voice_033:r_2c5b7ee872c1ed7f": {
      "text": "Earthlings!\\nYou'd invite despair?!",
      "status": "imported"
    },
    "voice_033:r_76d1e51c8b494a60": {
      "text": "Gadlight...!\\nAt this rate, we...!",
      "status": "imported"
    },
    "voice_033:r_eb5f687fcd372ae7": {
      "text": "Diosc's Psy-Ctrl\\ncan't evade all!",
      "status": "imported"
    },
    "voice_033:r_2329428a6871d9fa": {
      "text": "Even Diosc\\ncan't defeat this foe?!",
      "status": "imported"
    },
    "voice_033:r_0e7466971bec4cc4": {
      "text": "No!\\nA fake drove me this far...!",
      "status": "imported"
    },
    "voice_033:r_efa71f7a4cc33ff3": {
      "text": "Defeat by you\\nis my worst shame!",
      "status": "imported"
    },
    "voice_033:r_3fc2e1186557e7a0": {
      "text": "This Geminaid\\nwon't lose to you!",
      "status": "imported"
    },
    "voice_033:r_fa6930340a545054": {
      "text": "This is Earth's super robot power?!",
      "status": "imported"
    },
    "voice_033:r_2332b9d56461d7ab": {
      "text": "Such power...\\nWhy out here?!",
      "status": "imported"
    },
    "voice_033:r_854aa0a91a3c80d1": {
      "text": "Overwhelming power...!\\nWhat is it?!",
      "status": "imported"
    },
    "voice_033:r_0bc8ae32a406ceab": {
      "text": "Guh...!\\nGundam's name is no bluff!",
      "status": "imported"
    },
    "voice_033:r_82c09f011d703b2c": {
      "text": "Fire-born machine -\\nGundam, indeed!",
      "status": "imported"
    },
    "voice_033:r_2b4d8818c77b6dca": {
      "text": "My psyche\\ncan't track that speed?!",
      "status": "imported"
    },
    "voice_033:r_087354f2db0a31e6": {
      "text": "Tiny frame -\\nsuch combat power?!",
      "status": "imported"
    },
    "voice_033:r_db02a2dec93dd263": {
      "text": "Strong...! And... adorable!",
      "status": "imported"
    },
    "voice_033:r_e54e2c99ef8297af": {
      "text": "Guh! Is this as far as I go?!",
      "status": "imported"
    },
    "voice_033:r_f16a3eb0bcaac082": {
      "text": "Damn! The machine can't hold out?!",
      "status": "imported"
    },
    "voice_033:r_10a408809e512df1": {
      "text": "For me to fail so disgracefully!",
      "status": "imported"
    },
    "voice_033:r_bc7b9e308b879dd4": {
      "text": "I'm sorry... Gadlight...",
      "status": "imported"
    },
    "voice_033:r_98902fd3143c393e": {
      "text": "Giving up? Pathetic Earthling grit.",
      "status": "imported"
    },
    "voice_033:r_d907fbd7bc1c4298": {
      "text": "Geminis beats it in a 3-day binge!",
      "status": "imported"
    },
    "voice_033:r_96b21e3a028dd074": {
      "text": "Show Earth's grit in-game. Rematch!",
      "status": "imported"
    },
    "voice_033:r_ce140b5d8e6b7310": {
      "text": "Kidding. Rest, enjoy, and fight on!",
      "status": "imported"
    },
    "voice_033:r_0e0335789c5396d7": {
      "text": "I won't miss!",
      "status": "imported"
    },
    "voice_033:r_a8e85bd950696403": {
      "text": "Direct hit! Got you!",
      "status": "imported"
    },
    "voice_033:r_772c8bc40ab6cb61": {
      "text": "Target locked! Shoot!",
      "status": "imported"
    },
    "voice_033:r_58dd2826a199ef51": {
      "text": "Close combat! Let's go!",
      "status": "imported"
    },
    "voice_033:r_aadc0b2442adb93b": {
      "text": "We'll fight at my range!",
      "status": "imported"
    },
    "voice_033:r_e7a8cd8ed5bc2d1b": {
      "text": "I'll dive inside your guard!",
      "status": "imported"
    },
    "voice_033:r_041dd920da4a7c17": {
      "text": "Close combat is what I want!",
      "status": "imported"
    },
    "voice_033:r_c7f4280cde4605b3": {
      "text": "I-impossible! That is...?!",
      "status": "imported"
    },
    "voice_033:r_689d0b123de71ae0": {
      "text": "Aaaaaaah!!",
      "status": "imported"
    },
    "voice_033:r_ce1a22dfe3a4d339": {
      "text": "Concentrate the attack!",
      "status": "imported"
    },
    "voice_033:r_240651adab81e145": {
      "text": "This won't end as a mere feint!",
      "status": "imported"
    },
    "voice_033:r_cff0deaae73c2858": {
      "text": "Leave this flank to me!",
      "status": "imported"
    },
    "voice_033:r_dca67f68a573fab7": {
      "text": "I'll be your opponent!",
      "status": "imported"
    }
  }
}
