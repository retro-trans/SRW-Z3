{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_187:r_ca4acbac57a2a35e": {
      "text": "What I can do now is...",
      "status": "imported"
    },
    "voice_187:r_77949221bf58f862": {
      "text": "All I have is fighting...",
      "status": "imported"
    },
    "voice_187:r_70b9c4b9f1f37eff": {
      "text": "Ghh...!",
      "status": "imported"
    },
    "voice_187:r_9fcb3754cb1773c7": {
      "text": "I have to do this!",
      "status": "imported"
    },
    "voice_187:r_3559d2fad32c2435": {
      "text": "Come on, hit!",
      "status": "imported"
    },
    "voice_187:r_f7570547e9f80a64": {
      "text": "I... I've had enough...!",
      "status": "imported"
    },
    "voice_187:r_cbab0f4720e1fcf1": {
      "text": "Damn it!",
      "status": "imported"
    },
    "voice_187:r_0bbe0b4f5364e732": {
      "text": "Out of my way!",
      "status": "imported"
    },
    "voice_187:r_5dda5198137cb02a": {
      "text": "I am... a soldier!",
      "status": "imported"
    },
    "voice_187:r_83ec59afbecdec14": {
      "text": "Fighting is my only choice...!",
      "status": "imported"
    },
    "voice_187:r_e20bfd42ad95a3c9": {
      "text": "I'm just back on my old mission...!",
      "status": "imported"
    },
    "voice_187:r_0f58a8822381e57f": {
      "text": "Focus on what's in front of me...!",
      "status": "imported"
    },
    "voice_187:r_6dbcc507fb61b51d": {
      "text": "Right now, think of nothing else!",
      "status": "imported"
    },
    "voice_187:r_b42ab697149a7c8a": {
      "text": "I have no choice but to do my duty!",
      "status": "imported"
    },
    "voice_187:r_4de4fcf3b440baf4": {
      "text": "Raaagh!",
      "status": "imported"
    },
    "voice_187:r_0121a166c715cdff": {
      "text": "So you're still alive...!",
      "status": "imported"
    },
    "voice_187:r_4a9ac1dff86506d9": {
      "text": "Don't worry about me...!",
      "status": "imported"
    },
    "voice_187:r_bc8538e6af3d2577": {
      "text": "If you're coming at me...!",
      "status": "imported"
    },
    "voice_187:r_924516c8de2b5342": {
      "text": "If you get in my way...!",
      "status": "imported"
    },
    "voice_187:r_da1174533722333f": {
      "text": "Don't think you can escape...!",
      "status": "imported"
    },
    "voice_187:r_fdeb8162976e72c1": {
      "text": "I'll lend a hand...!",
      "status": "imported"
    },
    "voice_187:r_0fadb5c26df92b42": {
      "text": "I'll handle this...!",
      "status": "imported"
    },
    "voice_187:r_af884a6b11dff121": {
      "text": "I... What am I doing?!",
      "status": "imported"
    },
    "voice_187:r_ac6fe7838e95647b": {
      "text": "I made such a basic mistake...!",
      "status": "imported"
    },
    "voice_187:r_77ca87eacd17ad52": {
      "text": "Ghh...!",
      "status": "imported"
    },
    "voice_187:r_bf3244994760e535": {
      "text": "Tch...!",
      "status": "imported"
    },
    "voice_187:r_aabfb21c9d069ce7": {
      "text": "Too slow...!",
      "status": "imported"
    },
    "voice_187:r_02479dc8fe989560": {
      "text": "You piece of trash...!",
      "status": "imported"
    },
    "voice_187:r_a2df00f91a9b0a9e": {
      "text": "Will my body still respond...?",
      "status": "imported"
    },
    "voice_187:r_48b60d6c48b9b142": {
      "text": "Don't get in my way...!",
      "status": "imported"
    },
    "voice_187:r_8927e6fb681aa809": {
      "text": "You're not even worth killing...!",
      "status": "imported"
    },
    "voice_187:r_665f01666859013b": {
      "text": "Is that all? You pathetic amateur!",
      "status": "imported"
    },
    "voice_187:r_a571eec59b258d11": {
      "text": "What a waste of effort...!",
      "status": "imported"
    },
    "voice_187:r_faae935cca0edc72": {
      "text": "Gah...!",
      "status": "imported"
    },
    "voice_187:r_d4430bf362340b32": {
      "text": "Tchhh...!",
      "status": "imported"
    },
    "voice_187:r_6ff1323b355593e0": {
      "text": "My reactions are too slow...!",
      "status": "imported"
    },
    "voice_187:r_b7b5625d7cd4282f": {
      "text": "What a disgrace...!",
      "status": "imported"
    },
    "voice_187:r_36133ad73a73ef98": {
      "text": "What am I even doing...?!",
      "status": "imported"
    },
    "voice_187:r_920740a0219c5085": {
      "text": "I... can't die yet...!",
      "status": "imported"
    },
    "voice_187:r_a8451712c57c1a72": {
      "text": "For now, I only need to survive...!",
      "status": "imported"
    },
    "voice_187:r_3633df5b7b8f47fa": {
      "text": "If I lose focus, I'll die...!",
      "status": "imported"
    },
    "voice_187:r_52dfc56b14b93551": {
      "text": "Chidori, I...!",
      "status": "imported"
    },
    "voice_187:r_1b9b2aab5cb104da": {
      "text": "I... What the hell am I doing?!",
      "status": "imported"
    },
    "voice_187:r_a5643cec86b18bd2": {
      "text": "Zaiedddddd!!",
      "status": "imported"
    }
  }
}
