{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_017:r_479b340ccc6c572b": {
      "text": "Eat this!",
      "status": "imported"
    },
    "voice_017:r_77949221bf58f862": {
      "text": "There!",
      "status": "imported"
    },
    "voice_017:r_70b9c4b9f1f37eff": {
      "text": "Got you!",
      "status": "imported"
    },
    "voice_017:r_9fcb3754cb1773c7": {
      "text": "You're going down!",
      "status": "imported"
    },
    "voice_017:r_3559d2fad32c2435": {
      "text": "Drop dead!",
      "status": "imported"
    },
    "voice_017:r_f7570547e9f80a64": {
      "text": "Too easy!",
      "status": "imported"
    },
    "voice_017:r_cbab0f4720e1fcf1": {
      "text": "Target confirmed... Attack!",
      "status": "imported"
    },
    "voice_017:r_0bbe0b4f5364e732": {
      "text": "Now, let's see what you've got...!",
      "status": "imported"
    },
    "voice_017:r_5dda5198137cb02a": {
      "text": "We already know what you can do...!",
      "status": "imported"
    },
    "voice_017:r_83ec59afbecdec14": {
      "text": "Just as we predicted...!",
      "status": "imported"
    },
    "voice_017:r_e20bfd42ad95a3c9": {
      "text": "It's just business...!",
      "status": "imported"
    },
    "voice_017:r_0f58a8822381e57f": {
      "text": "Everything's going to plan...!",
      "status": "imported"
    },
    "voice_017:r_6dbcc507fb61b51d": {
      "text": "Come on! Dance until you die!",
      "status": "imported"
    },
    "voice_017:r_b42ab697149a7c8a": {
      "text": "Looks like I've caught my prey!",
      "status": "imported"
    },
    "voice_017:r_4de4fcf3b440baf4": {
      "text": "Resisting is pointless!",
      "status": "imported"
    },
    "voice_017:r_0121a166c715cdff": {
      "text": "I've got your moves figured out!",
      "status": "imported"
    },
    "voice_017:r_30fad37a42bd3ad3": {
      "text": "Say goodbye to this world!",
      "status": "imported"
    },
    "voice_017:r_80a0b2a84e05d81a": {
      "text": "I've survived the battlefield!",
      "status": "imported"
    },
    "voice_017:r_4a9ac1dff86506d9": {
      "text": "This thing won't be easy to stop!",
      "status": "imported"
    },
    "voice_017:r_bc8538e6af3d2577": {
      "text": "This thing's power is no joke!",
      "status": "imported"
    },
    "voice_017:r_924516c8de2b5342": {
      "text": "I feel like a giant!",
      "status": "imported"
    },
    "voice_017:r_da1174533722333f": {
      "text": "I'll crush you with sheer force!",
      "status": "imported"
    },
    "voice_017:r_fdeb8162976e72c1": {
      "text": "I'll show you this thing's power!",
      "status": "imported"
    },
    "voice_017:r_0fadb5c26df92b42": {
      "text": "I'll master it...!",
      "status": "imported"
    },
    "voice_017:r_6b15af9a0057cdc8": {
      "text": "They trusted me with this new model!",
      "status": "imported"
    },
    "voice_017:r_15b4a90140e8a33a": {
      "text": "This isn't like my old machine...!",
      "status": "imported"
    },
    "voice_017:r_af884a6b11dff121": {
      "text": "Impressive,\\nthis Lambda Driver!",
      "status": "imported"
    },
    "voice_017:r_ac6fe7838e95647b": {
      "text": "With the Lambda Driver's power...!",
      "status": "imported"
    },
    "voice_017:r_77ca87eacd17ad52": {
      "text": "Stay nice and quiet!",
      "status": "imported"
    },
    "voice_017:r_bf3244994760e535": {
      "text": "I'll hit you dead-on!",
      "status": "imported"
    },
    "voice_017:r_aabfb21c9d069ce7": {
      "text": "At this range, this'll do it!",
      "status": "imported"
    },
    "voice_017:r_02479dc8fe989560": {
      "text": "Like I'd miss!",
      "status": "imported"
    },
    "voice_017:r_a2df00f91a9b0a9e": {
      "text": "You won't escape my sights!",
      "status": "imported"
    },
    "voice_017:r_48b60d6c48b9b142": {
      "text": "Target locked!",
      "status": "imported"
    },
    "voice_017:r_8927e6fb681aa809": {
      "text": "Engaging in close combat!",
      "status": "imported"
    },
    "voice_017:r_665f01666859013b": {
      "text": "Going in!",
      "status": "imported"
    },
    "voice_017:r_a571eec59b258d11": {
      "text": "Closing the distance!",
      "status": "imported"
    },
    "voice_017:r_ddbe581c5ea9183d": {
      "text": "Let's take this to close combat!",
      "status": "imported"
    },
    "voice_017:r_faae935cca0edc72": {
      "text": "This time, I'll finish you!",
      "status": "imported"
    },
    "voice_017:r_d4430bf362340b32": {
      "text": "Too bad!\\nMy attack isn't over yet!",
      "status": "imported"
    },
    "voice_017:r_6ff1323b355593e0": {
      "text": "Planning to play the hero?!",
      "status": "imported"
    },
    "voice_017:r_b7b5625d7cd4282f": {
      "text": "You're all eyesores...!",
      "status": "imported"
    },
    "voice_017:r_36133ad73a73ef98": {
      "text": "We're both merchants of war!",
      "status": "imported"
    },
    "voice_017:r_920740a0219c5085": {
      "text": "Your prized gear?\\nI'll scrap it!",
      "status": "imported"
    },
    "voice_017:r_a8451712c57c1a72": {
      "text": "So the rumored white one is here...!",
      "status": "imported"
    },
    "voice_017:r_3633df5b7b8f47fa": {
      "text": "How dangerous you are,\\nI've heard!",
      "status": "imported"
    },
    "voice_017:r_52dfc56b14b93551": {
      "text": "Sink it, and I get a special bonus!",
      "status": "imported"
    },
    "voice_017:r_1b9b2aab5cb104da": {
      "text": "I've heard!\\nThe rumored Toy Box!",
      "status": "imported"
    },
    "voice_017:r_342044c706a2340f": {
      "text": "What's with that fluffy thing?!",
      "status": "imported"
    },
    "voice_017:r_cf41e8828a90cbdb": {
      "text": "Absurd! Why's a mascot in battle?!",
      "status": "imported"
    },
    "voice_017:r_719e897304ec42d4": {
      "text": "A mouse?! A bear?! A UMA?!",
      "status": "imported"
    },
    "voice_017:r_d5e0a2317c40d322": {
      "text": "Lose your speed, and you're useless!",
      "status": "imported"
    },
    "voice_017:r_ec2ea17765052401": {
      "text": "A pricey custom toy is my opponent?!",
      "status": "imported"
    },
    "voice_017:r_f2d4255f1c2f7542": {
      "text": "Flashy machines make great targets!",
      "status": "imported"
    },
    "voice_017:r_5d08ad19e2da125b": {
      "text": "We're both scum. Let's get along!",
      "status": "imported"
    },
    "voice_017:r_a7246b52782a877e": {
      "text": "Don't think an AT can beat an AS!",
      "status": "imported"
    },
    "voice_017:r_dc8701f6bcb9904f": {
      "text": "Martial's\\nUntouchable One...!",
      "status": "imported"
    },
    "voice_017:r_d6bdd730f24f66eb": {
      "text": "A Gundam!\\nI've wanted this fight!",
      "status": "imported"
    },
    "voice_017:r_41997412868c48c4": {
      "text": "A Gundam kill will boost my name!",
      "status": "imported"
    },
    "voice_017:r_9e6cf4f389dae55c": {
      "text": "You're tougher than the rumors...!",
      "status": "imported"
    },
    "voice_017:r_9e0c80ac7e33b459": {
      "text": "A Gundam knockoff is my opponent?!",
      "status": "imported"
    },
    "voice_017:r_7432ef43ed3471dc": {
      "text": "The Federation's watchdog is here!",
      "status": "imported"
    },
    "voice_017:r_065443f6ddfcf0d7": {
      "text": "You've all\\nruined my business!",
      "status": "imported"
    },
    "voice_017:r_47d52a2839c71715": {
      "text": "Celestial Being has fallen low!",
      "status": "imported"
    },
    "voice_017:r_847f82e7f3eef651": {
      "text": "A terrorist\\nserving the Feds...!",
      "status": "imported"
    },
    "voice_017:r_857c4a52ce8df0fd": {
      "text": "So Preventer's Gundam is here!",
      "status": "imported"
    },
    "voice_017:r_55417493fce1d347": {
      "text": "Black Knights still survive?!",
      "status": "imported"
    },
    "voice_017:r_8fdf5910927c9591": {
      "text": "So I'm facing the infamous Zero...!",
      "status": "imported"
    },
    "voice_017:r_7d724dbcc4451e10": {
      "text": "I'll kill you before you scurry off!",
      "status": "imported"
    },
    "voice_017:r_93e25418a203cb8f": {
      "text": "Speed alone won't win this for you!",
      "status": "imported"
    },
    "voice_017:r_adeb0a29274d3d9b": {
      "text": "Should've stayed\\nat your desk!",
      "status": "imported"
    },
    "voice_017:r_b1de76a75a253c13": {
      "text": "So an amateur's wandered out here!",
      "status": "imported"
    },
    "voice_017:r_38fdff9483e9245c": {
      "text": "No deals left,\\nNegotiator!",
      "status": "imported"
    },
    "voice_017:r_620fedec67706d7d": {
      "text": "No remote-control doll can beat me!",
      "status": "imported"
    },
    "voice_017:r_9680dcd0fddcfcc7": {
      "text": "What is that...?!\\nA real machine?!",
      "status": "imported"
    },
    "voice_017:r_2a00f1044ad5cbaa": {
      "text": "Sink the battleship, and we win!",
      "status": "imported"
    },
    "voice_017:r_3dbeead1bd3164ef": {
      "text": "I'll hit the bridge dead-on!",
      "status": "imported"
    },
    "voice_017:r_98d15b8cc09bc915": {
      "text": "This thing won't be overpowered!",
      "status": "imported"
    },
    "voice_017:r_46e86d000250e137": {
      "text": "A true battle of giants!",
      "status": "imported"
    },
    "voice_017:r_ac341e7976e88f0b": {
      "text": "Tremble before overwhelming power!",
      "status": "imported"
    },
    "voice_017:r_b1f8ec192b9c083a": {
      "text": "Damn mouse! I'll stomp you flat!",
      "status": "imported"
    },
    "voice_017:r_de1213040856c089": {
      "text": "Our gear's equal! Skill decides it!",
      "status": "imported"
    },
    "voice_017:r_3304412ac41f47a6": {
      "text": "A clash between Lambda Drivers!",
      "status": "imported"
    },
    "voice_017:r_0c0775e051211840": {
      "text": "A mere AS can't beat this thing!",
      "status": "imported"
    },
    "voice_017:r_a2afffe1c396f0b3": {
      "text": "Stock machines aren't even a threat!",
      "status": "imported"
    },
    "voice_017:r_ec349c8ea9511a18": {
      "text": "From here on, it's my turn!",
      "status": "imported"
    },
    "voice_017:r_33236ffa3ea95b68": {
      "text": "Now, time to return the favor!",
      "status": "imported"
    },
    "voice_017:r_689d0b123de71ae0": {
      "text": "Time to turn the tide!",
      "status": "imported"
    },
    "voice_017:r_84883aa95f63ce32": {
      "text": "It's about time you shut up!",
      "status": "imported"
    },
    "voice_017:r_25493e978ce8ff16": {
      "text": "I've got the right to attack too!",
      "status": "imported"
    },
    "voice_017:r_7316666150e42960": {
      "text": "Hit them before they can withdraw!",
      "status": "imported"
    },
    "voice_017:r_c4f11aa93dc5b668": {
      "text": "I'm no fool who'd let you hit back!",
      "status": "imported"
    },
    "voice_017:r_ce1a22dfe3a4d339": {
      "text": "I won't let it end with me beaten!",
      "status": "imported"
    },
    "voice_017:r_240651adab81e145": {
      "text": "Now we're even!",
      "status": "imported"
    },
    "voice_017:r_cff0deaae73c2858": {
      "text": "Too bad. I'm still alive!",
      "status": "imported"
    },
    "voice_017:r_dca67f68a573fab7": {
      "text": "We'll finish them together!",
      "status": "imported"
    },
    "voice_017:r_a6630215fefaf294": {
      "text": "I'll deliver the finishing blow!",
      "status": "imported"
    },
    "voice_017:r_6f94566ad37f8ff8": {
      "text": "One slip in battle means death!",
      "status": "imported"
    },
    "voice_017:r_942ca03c9de80143": {
      "text": "As expected of you, Fe...!",
      "status": "imported"
    },
    "voice_017:r_d8c669c70659e18a": {
      "text": "Gates,\\nfall back, now!",
      "status": "imported"
    },
    "voice_017:r_8f5bade7ac2db78e": {
      "text": "I won't let you!",
      "status": "imported"
    },
    "voice_017:r_05ea490d2f522520": {
      "text": "I'll act as your shield!",
      "status": "imported"
    },
    "voice_017:r_f5658c702d91db7a": {
      "text": "Fall back while you still can!",
      "status": "imported"
    },
    "voice_017:r_686df329b50f195b": {
      "text": "I'll cover Fe!",
      "status": "imported"
    },
    "voice_017:r_25f0ab0fa3cf690c": {
      "text": "You're getting too cocky, Gates!",
      "status": "imported"
    },
    "voice_017:r_b708a1d959013dbf": {
      "text": "Tch! Nothing else I can do?!",
      "status": "imported"
    },
    "voice_017:r_59fca03e929366c1": {
      "text": "This will hinder the operation...!",
      "status": "imported"
    },
    "voice_017:r_0d65eb631dcb7514": {
      "text": "Did I fall into their trap...?",
      "status": "imported"
    },
    "voice_017:r_d03018a31e23f1e9": {
      "text": "You outwitted me. You're good...!",
      "status": "imported"
    },
    "voice_017:r_279da5f732aa8847": {
      "text": "What a surprisingly cheap trick...!",
      "status": "imported"
    },
    "voice_017:r_97f82e3cb6f70110": {
      "text": "I fell for such a basic tactic...!",
      "status": "imported"
    },
    "voice_017:r_c5611d8dd6def96b": {
      "text": "What a dull attack",
      "status": "imported"
    },
    "voice_017:r_6f12cc8ed2732eb5": {
      "text": "I don't owe you a hit",
      "status": "imported"
    },
    "voice_017:r_7abfc55f8fb62ba7": {
      "text": "Go ahead and stew over it",
      "status": "imported"
    },
    "voice_017:r_99e7a66c650b5892": {
      "text": "No need for wasted motion",
      "status": "imported"
    },
    "voice_017:r_5b2247b5cfbcd7b2": {
      "text": "That sloppy attack won't...!",
      "status": "imported"
    },
    "voice_017:r_2d7a9c06347582d9": {
      "text": "You move just like an amateur",
      "status": "imported"
    },
    "voice_017:r_bf953d64c3c7d9b7": {
      "text": "Whoa, that was a close one!",
      "status": "imported"
    },
    "voice_017:r_e09b933e3e706779": {
      "text": "I don't have time for your games!",
      "status": "imported"
    },
    "voice_017:r_66236eb99b676e5b": {
      "text": "That level of attack won't work!",
      "status": "imported"
    },
    "voice_017:r_9639a2dbcd2f58ed": {
      "text": "I can pull off tricks like this too!",
      "status": "imported"
    },
    "voice_017:r_aeea0893acb93d35": {
      "text": "I brought the proper equipment!",
      "status": "imported"
    },
    "voice_017:r_fa07d90fca62f593": {
      "text": "This is an invisible shield",
      "status": "imported"
    },
    "voice_017:r_a25bf2676ecf9d83": {
      "text": "We've got a Lambda Driver too!",
      "status": "imported"
    },
    "voice_017:r_237a0288b42dce20": {
      "text": "Quite useful,\\nthis Lambda Driver...!",
      "status": "imported"
    },
    "voice_017:r_0556e8a22779ea8e": {
      "text": "The difference in power is clear",
      "status": "imported"
    },
    "voice_017:r_09d377101a48d92a": {
      "text": "You're still going to defy me?",
      "status": "imported"
    },
    "voice_017:r_11517cc7b0494dbf": {
      "text": "You think that's enough to stop me?",
      "status": "imported"
    },
    "voice_017:r_b5864501463db244": {
      "text": "A direct hit and that's it. Pathetic",
      "status": "imported"
    },
    "voice_017:r_a88939ea84b4474d": {
      "text": "That attack did catch me by surprise",
      "status": "imported"
    },
    "voice_017:r_a870d0cf7cc11ec6": {
      "text": "The bilateral angle needs adjusting",
      "status": "imported"
    },
    "voice_017:r_03f6158ef83964f3": {
      "text": "What a pointless thing to do...!",
      "status": "imported"
    },
    "voice_017:r_2970a83693cdcc25": {
      "text": "Small fry...! Give up already!",
      "status": "imported"
    },
    "voice_017:r_be661448b85d0009": {
      "text": "The plan needs slight adjustment...",
      "status": "imported"
    },
    "voice_017:r_958a56c1151cab9e": {
      "text": "Not bad... Finally, interesting prey",
      "status": "imported"
    },
    "voice_017:r_8b18aa4cc69547df": {
      "text": "Easy... Never rush in battle",
      "status": "imported"
    },
    "voice_017:r_3e87f6fc3ea65aef": {
      "text": "Looks like I let my guard down",
      "status": "imported"
    },
    "voice_017:r_5508a7bfa9074eb9": {
      "text": "Right forearm, Class B damage?!",
      "status": "imported"
    },
    "voice_017:r_09a003e91f0d5dc7": {
      "text": "This is getting rather tiresome...",
      "status": "imported"
    },
    "voice_017:r_192447448ebd7bb5": {
      "text": "But your struggle ends here!",
      "status": "imported"
    },
    "voice_017:r_e92920ba4b301b9f": {
      "text": "I hate to admit I misjudged you...!",
      "status": "imported"
    },
    "voice_017:r_207b256d613bb896": {
      "text": "I'm breaking out in a cold sweat...!",
      "status": "imported"
    },
    "voice_017:r_a6fd676d8146501b": {
      "text": "I just can't keep my rhythm...!",
      "status": "imported"
    },
    "voice_017:r_94d35e5fa8e3a198": {
      "text": "That type gets scary\\nwhen cocky...!",
      "status": "imported"
    },
    "voice_017:r_b686510e636673f3": {
      "text": "As I thought,\\na cut above...!",
      "status": "imported"
    },
    "voice_017:r_59369bad143d4272": {
      "text": "Damn...! You're no ordinary soldier!",
      "status": "imported"
    },
    "voice_017:r_25f9b1e39dd8d366": {
      "text": "So they really did gather the best!",
      "status": "imported"
    },
    "voice_017:r_307477bedd148060": {
      "text": "You're not a hero\\njust for show!",
      "status": "imported"
    },
    "voice_017:r_09a780acca0eb4b0": {
      "text": "So it wasn't just an ordinary AS...!",
      "status": "imported"
    },
    "voice_017:r_af62f2ee466b5c8c": {
      "text": "Strong...!\\nBeyond the data!",
      "status": "imported"
    },
    "voice_017:r_20cfb719db02fafd": {
      "text": "You've read\\nour every move?!",
      "status": "imported"
    },
    "voice_017:r_570c1fdf72edb283": {
      "text": "That captain...! He's a demon!",
      "status": "imported"
    },
    "voice_017:r_23f0d87a5a6cfca1": {
      "text": "Am I... having a nightmare?!",
      "status": "imported"
    },
    "voice_017:r_60c94ea4eb7f7404": {
      "text": "Damn! Is the power gap this wide?!",
      "status": "imported"
    },
    "voice_017:r_727b2ee0277f9159": {
      "text": "It's not called a Super for nothing!",
      "status": "imported"
    },
    "voice_017:r_cff4d2eae8a939ed": {
      "text": "Damn Gundam!\\nNot just a name, then!",
      "status": "imported"
    },
    "voice_017:r_1428fe5f35a9427b": {
      "text": "Fearsome!\\nThat Gundam and its pilot!",
      "status": "imported"
    },
    "voice_017:r_96d39b8bdfa6f183": {
      "text": "Strong...! Truly untouchable!",
      "status": "imported"
    },
    "voice_017:r_0e4f9b8a2d26ebff": {
      "text": "Damn...!\\nHow many hells survived?!",
      "status": "imported"
    },
    "voice_017:r_79e0d542fe12bcf7": {
      "text": "Celestial Being!\\nDamn you all!",
      "status": "imported"
    },
    "voice_017:r_eff747ba39a55393": {
      "text": "Damn Preventer! Stubborn bastards!",
      "status": "imported"
    },
    "voice_017:r_b2dc77aa6dd77e69": {
      "text": "The Black Knights' legend lives on!",
      "status": "imported"
    },
    "voice_017:r_445d40d8b5d7092b": {
      "text": "A salaryman\\npushed me this far?!",
      "status": "imported"
    },
    "voice_017:r_964e07c5563a5508": {
      "text": "Damn! What the hell is going on?!",
      "status": "imported"
    },
    "voice_017:r_db54e717bff3e3b2": {
      "text": "Whoa! You're one hell of a monster!",
      "status": "imported"
    },
    "voice_017:r_fcab8d80aef7e9d8": {
      "text": "Looks like\\nmy time has come...!",
      "status": "imported"
    },
    "voice_017:r_2174bd0edc164171": {
      "text": "They're one step ahead of me...!",
      "status": "imported"
    },
    "voice_017:r_ad54419336b49578": {
      "text": "As expected, this won't be easy...!",
      "status": "imported"
    },
    "voice_017:r_63c353e1e05e8e39": {
      "text": "All our predictions\\nwere wrong...!",
      "status": "imported"
    },
    "voice_017:r_87646dd472438e88": {
      "text": "Tch! Where's the retreat order?!",
      "status": "imported"
    },
    "voice_017:r_4e32ac89cba02001": {
      "text": "A crisis, after all this time...!",
      "status": "imported"
    },
    "voice_017:r_02d24e5915bfa5b7": {
      "text": "Voltage unstable! I must hurry!",
      "status": "imported"
    },
    "voice_017:r_9331c2c2ef55c78f": {
      "text": "Last a little longer, you junker...!",
      "status": "imported"
    },
    "voice_017:r_49734bdb3507acf7": {
      "text": "One step short of a fatal blow!",
      "status": "imported"
    },
    "voice_017:r_2a730c9b4df0dca3": {
      "text": "If I die here,\\nmy reward is gone!",
      "status": "imported"
    },
    "voice_017:r_1e5842ba5dc3f705": {
      "text": "Time to steel myself once again...!",
      "status": "imported"
    },
    "voice_017:r_9747bd61ad23ecd3": {
      "text": "I admit you're strong. I won't quit!",
      "status": "imported"
    },
    "voice_017:r_6823f8abe05c4727": {
      "text": "A skilled soldier survives...!",
      "status": "imported"
    },
    "voice_017:r_b8ccfd8b8ac323ac": {
      "text": "Aaaaaaaaaargh...!",
      "status": "imported"
    },
    "voice_017:r_c885ff2097749991": {
      "text": "Impossible! I can't believe this...!",
      "status": "imported"
    },
    "voice_017:r_a8da7f8d8b705db0": {
      "text": "Damn it! The machine won't hold...!",
      "status": "imported"
    },
    "voice_017:r_02e1c5e19de5bd22": {
      "text": "No! The operation will be ruined...!",
      "status": "imported"
    },
    "voice_017:r_6fb823898811e210": {
      "text": "I'm losing an expensive machine...!",
      "status": "imported"
    },
    "voice_017:r_5dcbcf1682cc3ab8": {
      "text": "Eject! Staying alive comes first!",
      "status": "imported"
    },
    "voice_017:r_5a20988e743dc1d0": {
      "text": "That's no costume...! It's a demon!",
      "status": "imported"
    },
    "voice_017:r_197f05bf899b7697": {
      "text": "Fearsome, Bonta-kun!",
      "status": "imported"
    },
    "voice_017:r_623ee03bd91ab2a1": {
      "text": "I'm using the Lambda Driver!",
      "status": "imported"
    },
    "voice_017:r_c5c491f8761152f0": {
      "text": "Uoooh!",
      "status": "imported"
    },
    "voice_017:r_15042263763f11bb": {
      "text": "Lambda Driver, activate!",
      "status": "imported"
    },
    "voice_017:r_96b3a8f080aea8b4": {
      "text": "Hyaaah!",
      "status": "imported"
    },
    "voice_017:r_3d4fa015b8b31648": {
      "text": "I'll move ahead and attack!",
      "status": "imported"
    },
    "voice_017:r_c1f3167d7dd97543": {
      "text": "I'll draw the enemy's attention!",
      "status": "imported"
    },
    "voice_017:r_1ac46173650ffe13": {
      "text": "I'll handle the diversion!",
      "status": "imported"
    },
    "voice_017:r_53660d6bc7fe8513": {
      "text": "I'll provide the assist!",
      "status": "imported"
    },
    "voice_017:r_2e756557a1d92e8b": {
      "text": "We'll take them down one by one!",
      "status": "imported"
    },
    "voice_017:r_45d847e7b8d840e3": {
      "text": "So that's the target!",
      "status": "imported"
    },
    "voice_017:r_d2ebe8f28f2420cc": {
      "text": "If it's one-on-one!",
      "status": "imported"
    },
    "voice_017:r_3baa2292b050034a": {
      "text": "I can't afford to make a mistake!",
      "status": "imported"
    }
  }
}
