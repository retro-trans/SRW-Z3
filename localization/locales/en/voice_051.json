{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_051:r_479b340ccc6c572b": {
      "text": "Well then... Let's get to it...",
      "status": "imported"
    },
    "voice_051:r_ca4acbac57a2a35e": {
      "text": "This'll help me sober up...",
      "status": "imported"
    },
    "voice_051:r_77949221bf58f862": {
      "text": "Man... What a pain...",
      "status": "imported"
    },
    "voice_051:r_70b9c4b9f1f37eff": {
      "text": "Gotta get serious,\\nor Honey'll yell",
      "status": "imported"
    },
    "voice_051:r_9fcb3754cb1773c7": {
      "text": "Aw, man... Me on the front lines?",
      "status": "imported"
    },
    "voice_051:r_3559d2fad32c2435": {
      "text": "Well... At least it'll kill time.",
      "status": "imported"
    },
    "voice_051:r_f7570547e9f80a64": {
      "text": "Now then... Let me test you a bit.",
      "status": "imported"
    },
    "voice_051:r_cbab0f4720e1fcf1": {
      "text": "Calling me out\\nwas your mistake.",
      "status": "imported"
    },
    "voice_051:r_0bbe0b4f5364e732": {
      "text": "I'll teach you how pointless it is.",
      "status": "imported"
    },
    "voice_051:r_5dda5198137cb02a": {
      "text": "Want a glimpse of what I can do?",
      "status": "imported"
    },
    "voice_051:r_83ec59afbecdec14": {
      "text": "Work out now,\\nthen drink well later",
      "status": "imported"
    },
    "voice_051:r_e20bfd42ad95a3c9": {
      "text": "Should've wiped each other\\nout...",
      "status": "imported"
    },
    "voice_051:r_0f58a8822381e57f": {
      "text": "Sorry. I'm not done yet.",
      "status": "imported"
    },
    "voice_051:r_6dbcc507fb61b51d": {
      "text": "Whoa! This one's on the house!",
      "status": "imported"
    },
    "voice_051:r_b42ab697149a7c8a": {
      "text": "Still alive, huh...\\nTime to end it!",
      "status": "imported"
    },
    "voice_051:r_4de4fcf3b440baf4": {
      "text": "Good try, young boss!\\nYou're done!",
      "status": "imported"
    },
    "voice_051:r_0121a166c715cdff": {
      "text": "Sorry, kid.\\nI'll break your toy!",
      "status": "imported"
    },
    "voice_051:r_30fad37a42bd3ad3": {
      "text": "Show me that phony psychic power!",
      "status": "imported"
    },
    "voice_051:r_80a0b2a84e05d81a": {
      "text": "Think you can't die?\\nBig mistake.",
      "status": "imported"
    },
    "voice_051:r_4a9ac1dff86506d9": {
      "text": "Singularity!\\nBlame your fate!",
      "status": "imported"
    },
    "voice_051:r_bc8538e6af3d2577": {
      "text": "I see.\\nProof of Fire Civilization.",
      "status": "imported"
    },
    "voice_051:r_924516c8de2b5342": {
      "text": "Time to thin out the Gundams...!",
      "status": "imported"
    },
    "voice_051:r_da1174533722333f": {
      "text": "Tough...\\nSo that's a Newtype, huh?",
      "status": "imported"
    },
    "voice_051:r_fdeb8162976e72c1": {
      "text": "I see.\\nYou're the famed Innovator.",
      "status": "imported"
    },
    "voice_051:r_0fadb5c26df92b42": {
      "text": "SEED, huh... How interesting.",
      "status": "imported"
    },
    "voice_051:r_6b15af9a0057cdc8": {
      "text": "Heir of Beast's Blood...\\nAmuse me!",
      "status": "imported"
    },
    "voice_051:r_15b4a90140e8a33a": {
      "text": "Sing for me. Sing your song of life!",
      "status": "imported"
    },
    "voice_051:r_af884a6b11dff121": {
      "text": "Buzzing around\\nis so annoying...!",
      "status": "imported"
    },
    "voice_051:r_ac6fe7838e95647b": {
      "text": "God of Light... Bright, bright!",
      "status": "imported"
    },
    "voice_051:r_77ca87eacd17ad52": {
      "text": "Evolution's pointless.\\nLearn that.",
      "status": "imported"
    },
    "voice_051:r_bf3244994760e535": {
      "text": "A salaryman shows up\\nout here...!",
      "status": "imported"
    },
    "voice_051:r_aabfb21c9d069ce7": {
      "text": "No booze today.\\nI'll serve you this!",
      "status": "imported"
    },
    "voice_051:r_02479dc8fe989560": {
      "text": "Lesson one:\\nmiracles aren't real!",
      "status": "imported"
    },
    "voice_051:r_a2df00f91a9b0a9e": {
      "text": "Nice moves.\\nNot bad for a soldier!",
      "status": "imported"
    },
    "voice_051:r_48b60d6c48b9b142": {
      "text": "Water bonds fail,\\nMechanical Angel!",
      "status": "imported"
    },
    "voice_051:r_8927e6fb681aa809": {
      "text": "I'll douse that flame of yours!",
      "status": "imported"
    },
    "voice_051:r_665f01666859013b": {
      "text": "Spiral Man!\\nWind leads to despair!",
      "status": "imported"
    },
    "voice_051:r_a571eec59b258d11": {
      "text": "This is no toy\\nfor a child...!",
      "status": "imported"
    },
    "voice_051:r_ddbe581c5ea9183d": {
      "text": "I'll take you on,\\nImitation Boy!",
      "status": "imported"
    },
    "voice_051:r_faae935cca0edc72": {
      "text": "Learn the difference in power, kid!",
      "status": "imported"
    },
    "voice_051:r_d4430bf362340b32": {
      "text": "Meddling gets you hurt, pal!",
      "status": "imported"
    },
    "voice_051:r_6ff1323b355593e0": {
      "text": "You just\\nrub me the wrong way...!",
      "status": "imported"
    },
    "voice_051:r_b7b5625d7cd4282f": {
      "text": "This one's pretty damn vicious.",
      "status": "imported"
    },
    "voice_051:r_36133ad73a73ef98": {
      "text": "Here! A storm of light particles!",
      "status": "imported"
    },
    "voice_051:r_920740a0219c5085": {
      "text": "Let's go, Geminia!",
      "status": "imported"
    },
    "voice_051:r_a8451712c57c1a72": {
      "text": "Ha ha ha ha! Now disappear!",
      "status": "imported"
    },
    "voice_051:r_3633df5b7b8f47fa": {
      "text": "God's left hand, Devil's right...",
      "status": "imported"
    },
    "voice_051:r_52dfc56b14b93551": {
      "text": "Both are harbingers of ruin!",
      "status": "imported"
    },
    "voice_051:r_1b9b2aab5cb104da": {
      "text": "This is the peak of Geminai science.",
      "status": "imported"
    },
    "voice_051:r_342044c706a2340f": {
      "text": "One stroke, two pieces!",
      "status": "imported"
    },
    "voice_051:r_cf41e8828a90cbdb": {
      "text": "Vanish like dew before Formenia!",
      "status": "imported"
    },
    "voice_051:r_719e897304ec42d4": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_051:r_d5e0a2317c40d322": {
      "text": "Now... Time to cut down some trash.",
      "status": "imported"
    },
    "voice_051:r_ec2ea17765052401": {
      "text": "This'll split you clean in two!",
      "status": "imported"
    },
    "voice_051:r_f2d4255f1c2f7542": {
      "text": "My Sphere and\\nGeminis' master art!",
      "status": "imported"
    },
    "voice_051:r_5d08ad19e2da125b": {
      "text": "Here I goooo!",
      "status": "imported"
    },
    "voice_051:r_a7246b52782a877e": {
      "text": "Hah hah hah hah hah hah haaah!",
      "status": "imported"
    },
    "voice_051:r_dc8701f6bcb9904f": {
      "text": "This'll finish you off!!",
      "status": "imported"
    },
    "voice_051:r_d6bdd730f24f66eb": {
      "text": "Guess I'll get a little serious...!",
      "status": "imported"
    },
    "voice_051:r_41997412868c48c4": {
      "text": "A souvenir for the afterlife!",
      "status": "imported"
    },
    "voice_051:r_9e6cf4f389dae55c": {
      "text": "Ha ha ha ha ha! This is fun, huh!",
      "status": "imported"
    },
    "voice_051:r_9e0c80ac7e33b459": {
      "text": "See ya! Take care!",
      "status": "imported"
    },
    "voice_051:r_a03fabecba1508ca": {
      "text": "I see. So you want some payback.",
      "status": "imported"
    },
    "voice_051:r_5391b24a71eb10ae": {
      "text": "Believe it or not, I repay favors.",
      "status": "imported"
    },
    "voice_051:r_a554ceef5c87b972": {
      "text": "Too bad! Now I'm hitting back!",
      "status": "imported"
    },
    "voice_051:r_546c3d5937fbb7ee": {
      "text": "Thought you'd escape?\\nImpossible!",
      "status": "imported"
    },
    "voice_051:r_1568ff6298b12b96": {
      "text": "Then let's try a counterattack!",
      "status": "imported"
    },
    "voice_051:r_2c9d94ba13c5fc50": {
      "text": "Hey, hey! No hitting and running!",
      "status": "imported"
    },
    "voice_051:r_a77f4913375098d2": {
      "text": "No, no!\\nI'll show you a real attack!",
      "status": "imported"
    },
    "voice_051:r_428c2116ac3071b1": {
      "text": "I never forget a grudge. Not ever.",
      "status": "imported"
    },
    "voice_051:r_84c116267b79f540": {
      "text": "Well...\\nOutwitting me? You're sly.",
      "status": "imported"
    },
    "voice_051:r_dad38ee29af2df3a": {
      "text": "Well, I'm beat. I can't do a thing.",
      "status": "imported"
    },
    "voice_051:r_3d32e86f8dc80909": {
      "text": "Fine. I'll let you off this time.",
      "status": "imported"
    },
    "voice_051:r_70451ffbabe2f876": {
      "text": "Geminia...\\nOh, wait! My mistake!",
      "status": "imported"
    },
    "voice_051:r_69dfa1659715e2fa": {
      "text": "Ha ha ha! Over here, over here!",
      "status": "imported"
    },
    "voice_051:r_d996fd6d4ef5b329": {
      "text": "Whoops, not so fast! Too bad!",
      "status": "imported"
    },
    "voice_051:r_8ab47a28f99ef565": {
      "text": "Too bad! You missed by a mile!",
      "status": "imported"
    },
    "voice_051:r_546de3fb6db156ea": {
      "text": "Wait, are you an amateur?",
      "status": "imported"
    },
    "voice_051:r_ca85f87cee5e31f7": {
      "text": "Way too slow.\\nCan't yawn or fart.",
      "status": "imported"
    },
    "voice_051:r_9072ea7bc71df136": {
      "text": "I knew the result before we began.",
      "status": "imported"
    },
    "voice_051:r_04e815a8d425827d": {
      "text": "Ever heard of wasting your time?",
      "status": "imported"
    },
    "voice_051:r_d89011fe3e5d082a": {
      "text": "Come back.\\n100 tries won't help.",
      "status": "imported"
    },
    "voice_051:r_3c5b0c2ac812d5de": {
      "text": "See? I told you it was pointless.",
      "status": "imported"
    },
    "voice_051:r_7bea3023abbf8a94": {
      "text": "You forgot about my equipment.",
      "status": "imported"
    },
    "voice_051:r_dd01a4c0d1b36a8d": {
      "text": "That's Geminia's power too.",
      "status": "imported"
    },
    "voice_051:r_20920ad2eb3542db": {
      "text": "Oh? Oh, oh, oh, oh?",
      "status": "imported"
    },
    "voice_051:r_0ab7914877fd48ed": {
      "text": "Whoa! You actually hit me?",
      "status": "imported"
    },
    "voice_051:r_cb846feec748c2e3": {
      "text": "Well... You're pretty good, pal.",
      "status": "imported"
    },
    "voice_051:r_c958860b0676b1f5": {
      "text": "Hey, hey... Are you serious now?",
      "status": "imported"
    },
    "voice_051:r_5e2669b82ef75ce3": {
      "text": "Ugh... My hangover has me reeling.",
      "status": "imported"
    },
    "voice_051:r_7847e0ed7dc9282d": {
      "text": "Whoa... Did I mess around too much?",
      "status": "imported"
    },
    "voice_051:r_e42b52c7a987b906": {
      "text": "Aw, man... You scratched my armor.",
      "status": "imported"
    },
    "voice_051:r_6825fd1ff907bd22": {
      "text": "Sorry, Geminia.\\nI got too playful.",
      "status": "imported"
    },
    "voice_051:r_607f666f1563bc0d": {
      "text": "Not bad... I'll have to watch you.",
      "status": "imported"
    },
    "voice_051:r_97b7431eeb81e6b6": {
      "text": "Well... I expect at least this.",
      "status": "imported"
    },
    "voice_051:r_132f605d02975e71": {
      "text": "Hey... Did I take a direct hit?",
      "status": "imported"
    },
    "voice_051:r_9b9726b1872759d6": {
      "text": "Oh, no...\\nHoney'll scold me later.",
      "status": "imported"
    },
    "voice_051:r_1252db29683fefe0": {
      "text": "Ha ha ha, I'm in a real bind now.",
      "status": "imported"
    },
    "voice_051:r_ad3d538f1e909184": {
      "text": "You're doing a little better...",
      "status": "imported"
    },
    "voice_051:r_8c61c59a1c0aebbf": {
      "text": "So they marked you for good reason.",
      "status": "imported"
    },
    "voice_051:r_aba6a7662129d8ce": {
      "text": "You may be worth getting serious...",
      "status": "imported"
    },
    "voice_051:r_b84afafb8a33ec60": {
      "text": "A shame... If we'd met another way.",
      "status": "imported"
    },
    "voice_051:r_c8c59db85bf875e6": {
      "text": "Deep inside,\\nsomething's smoldering",
      "status": "imported"
    },
    "voice_051:r_f1e7ed9e5874aba5": {
      "text": "I give, I give!\\nYou win this round!",
      "status": "imported"
    },
    "voice_051:r_fc25e66a86fc2c85": {
      "text": "Aw, hell... I actually lost...",
      "status": "imported"
    },
    "voice_051:r_5aeeb4917340c42d": {
      "text": "Hey... You here too? Worn out, huh?",
      "status": "imported"
    },
    "voice_051:r_b765659981b6516d": {
      "text": "SRW: fave bots beat foes & woes!",
      "status": "imported"
    },
    "voice_051:r_0c427458bc00eb95": {
      "text": "Huh? You hate me? Heh, I'm honored.",
      "status": "imported"
    },
    "voice_051:r_774a9ab4d8fd5351": {
      "text": "Hate me? Play on. I'll exhaust you.",
      "status": "imported"
    },
    "voice_051:r_d3f01de714c015bd": {
      "text": "See ya. I'll be waiting.",
      "status": "imported"
    },
    "voice_051:r_7d2617c809fead70": {
      "text": "Like that could ever work on me!",
      "status": "imported"
    },
    "voice_051:r_8ad40afecd02b41e": {
      "text": "I'll take the glory for myself!",
      "status": "imported"
    },
    "voice_051:r_26e5efec03c03d78": {
      "text": "Hmm... Your finish was sloppy.",
      "status": "imported"
    },
    "voice_051:r_4ad81e88c7557a8b": {
      "text": "Just another captain's duty.",
      "status": "imported"
    },
    "voice_051:r_1f65a7af190e4674": {
      "text": "Ultimate Geminis Formation\\nLike so!",
      "status": "imported"
    },
    "voice_051:r_40c5a9358ed5bf29": {
      "text": "I'll give you a hand, Honey.",
      "status": "imported"
    },
    "voice_051:r_f2e18dfdfe0c89ea": {
      "text": "Let's make this our joint effort!",
      "status": "imported"
    },
    "voice_051:r_cf7dbf49e96a5755": {
      "text": "Well... This job's fine sometimes.",
      "status": "imported"
    },
    "voice_051:r_fa96676cc65bb509": {
      "text": "I'll take it head-on!",
      "status": "imported"
    },
    "voice_051:r_4e37f92e7d2fc62e": {
      "text": "I won't let you hurt Honey!",
      "status": "imported"
    },
    "voice_051:r_66ab4cfe1557909d": {
      "text": "Stand back, Annalotta!",
      "status": "imported"
    }
  }
}
