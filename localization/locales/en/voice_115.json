{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_115:r_479b340ccc6c572b": {
      "text": "I see. You look worth killing.",
      "status": "imported"
    },
    "voice_115:r_ca4acbac57a2a35e": {
      "text": "I'm nothing but a killer.",
      "status": "imported"
    },
    "voice_115:r_77949221bf58f862": {
      "text": "I don't give a damn about plans.",
      "status": "imported"
    },
    "voice_115:r_70b9c4b9f1f37eff": {
      "text": "Now then, let's have some fun!",
      "status": "imported"
    },
    "voice_115:r_9fcb3754cb1773c7": {
      "text": "I'll do whatever the hell I want!",
      "status": "imported"
    },
    "voice_115:r_3559d2fad32c2435": {
      "text": "Kill you...! Kill you...!\\nKill you!",
      "status": "imported"
    },
    "voice_115:r_f7570547e9f80a64": {
      "text": "Kooo...!",
      "status": "imported"
    },
    "voice_115:r_cbab0f4720e1fcf1": {
      "text": "Taaa...!",
      "status": "imported"
    },
    "voice_115:r_0bbe0b4f5364e732": {
      "text": "Hyah...!",
      "status": "imported"
    },
    "voice_115:r_5dda5198137cb02a": {
      "text": "This is the end!",
      "status": "imported"
    },
    "voice_115:r_83ec59afbecdec14": {
      "text": "Die!",
      "status": "imported"
    },
    "voice_115:r_e20bfd42ad95a3c9": {
      "text": "So long!",
      "status": "imported"
    },
    "voice_115:r_0f58a8822381e57f": {
      "text": "Time for you to disappear!",
      "status": "imported"
    },
    "voice_115:r_6dbcc507fb61b51d": {
      "text": "How do you like this!",
      "status": "imported"
    },
    "voice_115:r_b42ab697149a7c8a": {
      "text": "Try to last a little!",
      "status": "imported"
    },
    "voice_115:r_4de4fcf3b440baf4": {
      "text": "This ship is now\\npart of my body!",
      "status": "imported"
    },
    "voice_115:r_0121a166c715cdff": {
      "text": "Let the big battle begin...!",
      "status": "imported"
    },
    "voice_115:r_30fad37a42bd3ad3": {
      "text": "I'll crush you with this...!",
      "status": "imported"
    },
    "voice_115:r_80a0b2a84e05d81a": {
      "text": "This is no ordinary AT...!",
      "status": "imported"
    },
    "voice_115:r_4a9ac1dff86506d9": {
      "text": "Not for war or pay\\ndo I pilot an AT!",
      "status": "imported"
    },
    "voice_115:r_bc8538e6af3d2577": {
      "text": "This is plenty to kill you with!",
      "status": "imported"
    },
    "voice_115:r_924516c8de2b5342": {
      "text": "Go on, dance up a storm!",
      "status": "imported"
    },
    "voice_115:r_da1174533722333f": {
      "text": "I'll put some air holes in you!",
      "status": "imported"
    },
    "voice_115:r_fdeb8162976e72c1": {
      "text": "I won't miss!",
      "status": "imported"
    },
    "voice_115:r_0fadb5c26df92b42": {
      "text": "Rrrraaaaaagh!",
      "status": "imported"
    },
    "voice_115:r_6b15af9a0057cdc8": {
      "text": "Diiiieeeee!",
      "status": "imported"
    },
    "voice_115:r_15b4a90140e8a33a": {
      "text": "Haaa ha ha ha ha!",
      "status": "imported"
    },
    "voice_115:r_af884a6b11dff121": {
      "text": "You're making me work for it...!",
      "status": "imported"
    },
    "voice_115:r_ac6fe7838e95647b": {
      "text": "I can still enjoy the killing...!",
      "status": "imported"
    },
    "voice_115:r_77ca87eacd17ad52": {
      "text": "Die, Red Shoulder scum!",
      "status": "imported"
    },
    "voice_115:r_bf3244994760e535": {
      "text": "There you are, Red Shoulder!",
      "status": "imported"
    },
    "voice_115:r_aabfb21c9d069ce7": {
      "text": "A Red Shoulder!\\nThey can't live...!",
      "status": "imported"
    },
    "voice_115:r_02479dc8fe989560": {
      "text": "Orom's wastes:\\nRed Shoulder got me!",
      "status": "imported"
    },
    "voice_115:r_a2df00f91a9b0a9e": {
      "text": "A Quentian...! Interesting prey!",
      "status": "imported"
    },
    "voice_115:r_48b60d6c48b9b142": {
      "text": "That's one flashy machine!",
      "status": "imported"
    },
    "voice_115:r_8927e6fb681aa809": {
      "text": "Don't think size alone can win!",
      "status": "imported"
    },
    "voice_115:r_665f01666859013b": {
      "text": "I awaited this,\\nGundam...!",
      "status": "imported"
    },
    "voice_115:r_a571eec59b258d11": {
      "text": "A mere mobile suit\\ncan't beat me!",
      "status": "imported"
    },
    "voice_115:r_ddbe581c5ea9183d": {
      "text": "You've got the same stink as me...!",
      "status": "imported"
    },
    "voice_115:r_faae935cca0edc72": {
      "text": "So the latest AS is here!",
      "status": "imported"
    },
    "voice_115:r_d4430bf362340b32": {
      "text": "A pure-white AS? Worth crushing!",
      "status": "imported"
    },
    "voice_115:r_6ff1323b355593e0": {
      "text": "Looks like there's a fly here...!",
      "status": "imported"
    },
    "voice_115:r_b7b5625d7cd4282f": {
      "text": "Now this prey may put up a fight...!",
      "status": "imported"
    },
    "voice_115:r_36133ad73a73ef98": {
      "text": "I'll take the big one!",
      "status": "imported"
    },
    "voice_115:r_920740a0219c5085": {
      "text": "I'll smash your head in!",
      "status": "imported"
    },
    "voice_115:r_a8451712c57c1a72": {
      "text": "I'll snap that skinny waist in two!",
      "status": "imported"
    },
    "voice_115:r_98d15b8cc09bc915": {
      "text": "For maximum fun, this is the one!",
      "status": "imported"
    },
    "voice_115:r_46e86d000250e137": {
      "text": "I'll make good use of this!",
      "status": "imported"
    },
    "voice_115:r_ac341e7976e88f0b": {
      "text": "I'll crush you, pilot and all!",
      "status": "imported"
    },
    "voice_115:r_cdbd128a5b4127cc": {
      "text": "I'll twist you clean off...!",
      "status": "imported"
    },
    "voice_115:r_cfccaa1fbeda124c": {
      "text": "Become prey to my pincers!",
      "status": "imported"
    },
    "voice_115:r_b1f8ec192b9c083a": {
      "text": "I'll skewer you with this!",
      "status": "imported"
    },
    "voice_115:r_a007f9ab9cf048b3": {
      "text": "I'll pierce you, pilot and all!",
      "status": "imported"
    },
    "voice_115:r_ddafde4b065ced49": {
      "text": "I'll blast a hole in your gut!",
      "status": "imported"
    },
    "voice_115:r_c958860b0676b1f5": {
      "text": "I'll part your head from your body!",
      "status": "imported"
    },
    "voice_115:r_5e2669b82ef75ce3": {
      "text": "Haaah!",
      "status": "imported"
    },
    "voice_115:r_7847e0ed7dc9282d": {
      "text": "I'll slice you clean in two!",
      "status": "imported"
    },
    "voice_115:r_e42b52c7a987b906": {
      "text": "Kaaah!",
      "status": "imported"
    },
    "voice_115:r_6825fd1ff907bd22": {
      "text": "I'll snap you with this!",
      "status": "imported"
    },
    "voice_115:r_607f666f1563bc0d": {
      "text": "Shah!",
      "status": "imported"
    },
    "voice_115:r_fa96676cc65bb509": {
      "text": "My turn now!",
      "status": "imported"
    },
    "voice_115:r_4e37f92e7d2fc62e": {
      "text": "You're the one who started this...!",
      "status": "imported"
    },
    "voice_115:r_66ab4cfe1557909d": {
      "text": "Heh heh heh... You won't escape!",
      "status": "imported"
    },
    "voice_115:r_0bad405ee6ca63ba": {
      "text": "I'll crush anyone who defies me!",
      "status": "imported"
    },
    "voice_115:r_2072eaf71a260ae7": {
      "text": "I never turn down a fight!",
      "status": "imported"
    },
    "voice_115:r_6c13bbfd27a7799e": {
      "text": "Even kids know:\\nHit back when hit!",
      "status": "imported"
    },
    "voice_115:r_06f88dcbd3c9e738": {
      "text": "That one's my prey!",
      "status": "imported"
    },
    "voice_115:r_b28faf9f71bc3598": {
      "text": "Keep your hands off!",
      "status": "imported"
    },
    "voice_115:r_8a29278549f8e07a": {
      "text": "Earn your keep, Kan Yu!",
      "status": "imported"
    },
    "voice_115:r_7e6c573c26177f98": {
      "text": "Tch! What a pain you are!",
      "status": "imported"
    },
    "voice_115:r_45abf84f7757d6eb": {
      "text": "I can't let my meat shield die!",
      "status": "imported"
    },
    "voice_115:r_edd7a13ab8f06a14": {
      "text": "Kan Yu! Are you getting in my way!",
      "status": "imported"
    },
    "voice_115:r_8165e5b41f0124c4": {
      "text": "Damn it! I can't counterattack!",
      "status": "imported"
    },
    "voice_115:r_4e05581b7432cce8": {
      "text": "So I can't kill them right now?!",
      "status": "imported"
    },
    "voice_115:r_a60b107ea3c36a86": {
      "text": "What a petty little trick...!",
      "status": "imported"
    },
    "voice_115:r_e33693e5ba4665b0": {
      "text": "You managed to outsmart me...!",
      "status": "imported"
    },
    "voice_115:r_72a21a1a489af001": {
      "text": "Heh heh heh heh...!",
      "status": "imported"
    },
    "voice_115:r_eb643f8bf737a0ca": {
      "text": "Shah!",
      "status": "imported"
    },
    "voice_115:r_0a3fccb71ec6cf2a": {
      "text": "Haaah...!",
      "status": "imported"
    },
    "voice_115:r_9b63cf1f3e0207ef": {
      "text": "Hyah...!",
      "status": "imported"
    },
    "voice_115:r_8356f4e3dcdff938": {
      "text": "What rotten luck for you...",
      "status": "imported"
    },
    "voice_115:r_1d6d784036ae0bd7": {
      "text": "I chose to become what I am.",
      "status": "imported"
    },
    "voice_115:r_625664af02183c17": {
      "text": "Too slow...! Far too slow!",
      "status": "imported"
    },
    "voice_115:r_3701cba361f80ea5": {
      "text": "Heh, I'll toy with you some more!",
      "status": "imported"
    },
    "voice_115:r_63f429c5c68c0863": {
      "text": "Is that all, Red Shoulder?!",
      "status": "imported"
    },
    "voice_115:r_38e4a434c91d8ef0": {
      "text": "Don't make me laugh, Red Shoulder!",
      "status": "imported"
    },
    "voice_115:r_862b92e63adb9734": {
      "text": "Didn't even scratch me.",
      "status": "imported"
    },
    "voice_115:r_57b2bd2de8a1408d": {
      "text": "I've got tricks like this too.",
      "status": "imported"
    },
    "voice_115:r_76f080a4881e8ab5": {
      "text": "Hng!",
      "status": "imported"
    },
    "voice_115:r_288133bc5b573dae": {
      "text": "What?!",
      "status": "imported"
    },
    "voice_115:r_6f95653e548f8fcf": {
      "text": "Ghh...!",
      "status": "imported"
    },
    "voice_115:r_d249d68bada91ab9": {
      "text": "Damn you...!",
      "status": "imported"
    },
    "voice_115:r_e9b3307e9eb69f11": {
      "text": "Ngh...!",
      "status": "imported"
    },
    "voice_115:r_03cdac73042343ee": {
      "text": "Just a fluke...!?",
      "status": "imported"
    },
    "voice_115:r_6026da5acbda7c69": {
      "text": "You've got to be kidding...!",
      "status": "imported"
    },
    "voice_115:r_981f8fedd5414fe5": {
      "text": "You'd interfere with my killing...?!",
      "status": "imported"
    },
    "voice_115:r_96bb0dcde0c8c44a": {
      "text": "You look like premium prey...!",
      "status": "imported"
    },
    "voice_115:r_641550a2f54cb456": {
      "text": "Now you're really worth killing!",
      "status": "imported"
    },
    "voice_115:r_a0f2074af8debbfa": {
      "text": "Nnngh... I should be functioning!",
      "status": "imported"
    },
    "voice_115:r_b5f5a97ed82acb0b": {
      "text": "I'll kill you...! I'll do it myself!",
      "status": "imported"
    },
    "voice_115:r_d9cd2e4ded064396": {
      "text": "That one... They must not live...!",
      "status": "imported"
    },
    "voice_115:r_99e6349431aaf23b": {
      "text": "No mistake!\\nYou're a Red Shoulder!",
      "status": "imported"
    },
    "voice_115:r_ec1081caf845f56a": {
      "text": "Damn you, Red Shoulder!",
      "status": "imported"
    },
    "voice_115:r_2329428a6871d9fa": {
      "text": "Nooo... I don't want this...!",
      "status": "imported"
    },
    "voice_115:r_0e7466971bec4cc4": {
      "text": "Why I lived like this...\\nIt was...!",
      "status": "imported"
    },
    "voice_115:r_efa71f7a4cc33ff3": {
      "text": "I volunteered for this,\\nyet...!",
      "status": "imported"
    },
    "voice_115:r_3fc2e1186557e7a0": {
      "text": "Make no mistake, you will die...!",
      "status": "imported"
    },
    "voice_115:r_fa6930340a545054": {
      "text": "The best...! The best prey...!",
      "status": "imported"
    },
    "voice_115:r_2332b9d56461d7ab": {
      "text": "Like that one...!\\nYou can't live...!",
      "status": "imported"
    },
    "voice_115:r_854aa0a91a3c80d1": {
      "text": "Tch! Is this ship done for already?!",
      "status": "imported"
    },
    "voice_115:r_0bc8ae32a406ceab": {
      "text": "Damn it! The engine's been hit!",
      "status": "imported"
    },
    "voice_115:r_82c09f011d703b2c": {
      "text": "Then I'll ram the ship into them!",
      "status": "imported"
    },
    "voice_115:r_2b4d8818c77b6dca": {
      "text": "Next time, I'll be sure to kill you!",
      "status": "imported"
    },
    "voice_115:r_087354f2db0a31e6": {
      "text": "NOOO! NO! NO!\\nNOOOOO!!",
      "status": "imported"
    },
    "voice_115:r_db02a2dec93dd263": {
      "text": "Damn it! This ends in an AT!",
      "status": "imported"
    },
    "voice_115:r_d520c6d5298a848d": {
      "text": "I...! I...!\\nNrrrraaaaaagh!",
      "status": "imported"
    },
    "voice_115:r_099e2458cabf796f": {
      "text": "I refuse.",
      "status": "imported"
    },
    "voice_115:r_fd910d714be70870": {
      "text": "Nooooo...!",
      "status": "imported"
    },
    "voice_115:r_9736f29b11344ec3": {
      "text": "NOOO! NO! NO! NOOOOO!!",
      "status": "imported"
    },
    "voice_115:r_bece29562818acba": {
      "text": "No need to tell me. I'll go first.",
      "status": "imported"
    },
    "voice_115:r_494b5da92ed24ecb": {
      "text": "I stop them in their tracks, right?",
      "status": "imported"
    },
    "voice_115:r_a4a5a96f4bd58920": {
      "text": "So that's my prey.",
      "status": "imported"
    },
    "voice_115:r_b57d2d74233f889a": {
      "text": "Now that looks pretty tasty.",
      "status": "imported"
    }
  }
}
