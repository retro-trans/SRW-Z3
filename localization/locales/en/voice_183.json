{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_183:r_479b340ccc6c572b": {
      "text": "Target locked! Let's go, Nataku!!",
      "status": "imported"
    },
    "voice_183:r_ca4acbac57a2a35e": {
      "text": "No one can stop me!!",
      "status": "imported"
    },
    "voice_183:r_77949221bf58f862": {
      "text": "You can't defeat me...",
      "status": "imported"
    },
    "voice_183:r_70b9c4b9f1f37eff": {
      "text": "Don't revel in your own battle!!",
      "status": "imported"
    },
    "voice_183:r_9fcb3754cb1773c7": {
      "text": "Weaklings, stay out of my way!!",
      "status": "imported"
    },
    "voice_183:r_3559d2fad32c2435": {
      "text": "Don't take Nataku lightly!!",
      "status": "imported"
    },
    "voice_183:r_f7570547e9f80a64": {
      "text": "I decide what justice is!!",
      "status": "imported"
    },
    "voice_183:r_cbab0f4720e1fcf1": {
      "text": "Haaaaaaah!!",
      "status": "imported"
    },
    "voice_183:r_0bbe0b4f5364e732": {
      "text": "I will... uphold my own justice!",
      "status": "imported"
    },
    "voice_183:r_5dda5198137cb02a": {
      "text": "If you're right,\\nyou should beat me!",
      "status": "imported"
    },
    "voice_183:r_83ec59afbecdec14": {
      "text": "Now show me what you can do!",
      "status": "imported"
    },
    "voice_183:r_e20bfd42ad95a3c9": {
      "text": "Guh! Sorry, Nataku!",
      "status": "imported"
    },
    "voice_183:r_0f58a8822381e57f": {
      "text": "What!? Damn it!",
      "status": "imported"
    },
    "voice_183:r_6dbcc507fb61b51d": {
      "text": "Gah! Not like this...\\nI can't lose!!",
      "status": "imported"
    },
    "voice_183:r_b42ab697149a7c8a": {
      "text": "Ugh! Better than I thought...\\nBut!!",
      "status": "imported"
    },
    "voice_183:r_4de4fcf3b440baf4": {
      "text": "Rrgh! N-not yet!\\nThis isn't over!!",
      "status": "imported"
    },
    "voice_183:r_0121a166c715cdff": {
      "text": "Guh! I won't be beaten!!",
      "status": "imported"
    },
    "voice_183:r_30fad37a42bd3ad3": {
      "text": "Not yet!\\nThat won't take me down!!",
      "status": "imported"
    },
    "voice_183:r_80a0b2a84e05d81a": {
      "text": "Grr!\\nYou think that can defeat me?!",
      "status": "imported"
    },
    "voice_183:r_4a9ac1dff86506d9": {
      "text": "Ngh!\\nVery well... I'll take you on!",
      "status": "imported"
    },
    "voice_183:r_bc8538e6af3d2577": {
      "text": "The weak have no place in battle!!",
      "status": "imported"
    },
    "voice_183:r_924516c8de2b5342": {
      "text": "Weak... Far too weak!",
      "status": "imported"
    },
    "voice_183:r_da1174533722333f": {
      "text": "Is that all? You're no match for me!",
      "status": "imported"
    },
    "voice_183:r_fdeb8162976e72c1": {
      "text": "That's your best!? How pathetic...",
      "status": "imported"
    },
    "voice_183:r_0fadb5c26df92b42": {
      "text": "You won't hit me!!",
      "status": "imported"
    },
    "voice_183:r_6b15af9a0057cdc8": {
      "text": "You call that aiming?!",
      "status": "imported"
    },
    "voice_183:r_15b4a90140e8a33a": {
      "text": "Too naive!!",
      "status": "imported"
    },
    "voice_183:r_af884a6b11dff121": {
      "text": "You cannot defeat me!",
      "status": "imported"
    },
    "voice_183:r_ac6fe7838e95647b": {
      "text": "Hmph! What are you doing?!",
      "status": "imported"
    },
    "voice_183:r_77ca87eacd17ad52": {
      "text": "You think that trick will work?!",
      "status": "imported"
    },
    "voice_183:r_bf3244994760e535": {
      "text": "Your complacency led to this!",
      "status": "imported"
    },
    "voice_183:r_aabfb21c9d069ce7": {
      "text": "Don't falter! Keep fighting!!",
      "status": "imported"
    },
    "voice_183:r_02479dc8fe989560": {
      "text": "I'm right here!",
      "status": "imported"
    },
    "voice_183:r_a2df00f91a9b0a9e": {
      "text": "Don't underestimate Nataku!",
      "status": "imported"
    },
    "voice_183:r_48b60d6c48b9b142": {
      "text": "If you're weak, don't face me!",
      "status": "imported"
    },
    "voice_183:r_8927e6fb681aa809": {
      "text": "Don't take the field if that's all!",
      "status": "imported"
    },
    "voice_183:r_665f01666859013b": {
      "text": "Begone from my sight!!",
      "status": "imported"
    },
    "voice_183:r_a571eec59b258d11": {
      "text": "Come back when you're ready!",
      "status": "imported"
    },
    "voice_183:r_ddbe581c5ea9183d": {
      "text": "Move! Enough!\\nYou can't beat me!",
      "status": "imported"
    },
    "voice_183:r_faae935cca0edc72": {
      "text": "Why fight me\\nwhen you cannot win?!",
      "status": "imported"
    },
    "voice_183:r_d4430bf362340b32": {
      "text": "Nataku... You can still fight!!",
      "status": "imported"
    },
    "voice_183:r_6ff1323b355593e0": {
      "text": "Fine! Come at me with all you have!",
      "status": "imported"
    },
    "voice_183:r_b7b5625d7cd4282f": {
      "text": "Ngh!\\nNow's your one shot to beat me!",
      "status": "imported"
    },
    "voice_183:r_36133ad73a73ef98": {
      "text": "Propulsion fault,\\nleft arm offline!?",
      "status": "imported"
    },
    "voice_183:r_920740a0219c5085": {
      "text": "Grr! Nataku...\\nWe can't die yet!",
      "status": "imported"
    },
    "voice_183:r_3633df5b7b8f47fa": {
      "text": "I can tell! You are evil!!",
      "status": "imported"
    },
    "voice_183:r_52dfc56b14b93551": {
      "text": "I fight evil\\nbringing war to space!!",
      "status": "imported"
    },
    "voice_183:r_1b9b2aab5cb104da": {
      "text": "Coward... Face me fair and square!",
      "status": "imported"
    },
    "voice_183:r_342044c706a2340f": {
      "text": "Nobody can stop me!",
      "status": "imported"
    },
    "voice_183:r_cf41e8828a90cbdb": {
      "text": "There!",
      "status": "imported"
    },
    "voice_183:r_719e897304ec42d4": {
      "text": "Hmph! Too easy...!",
      "status": "imported"
    },
    "voice_183:r_d5e0a2317c40d322": {
      "text": "I'll settle this now!!",
      "status": "imported"
    },
    "voice_183:r_ec2ea17765052401": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_183:r_f2d4255f1c2f7542": {
      "text": "Next! Come and face me!",
      "status": "imported"
    },
    "voice_183:r_a7246b52782a877e": {
      "text": "Raaagh!",
      "status": "imported"
    },
    "voice_183:r_dc8701f6bcb9904f": {
      "text": "Get out of my sight!!",
      "status": "imported"
    },
    "voice_183:r_d6bdd730f24f66eb": {
      "text": "Move aside!",
      "status": "imported"
    },
    "voice_183:r_41997412868c48c4": {
      "text": "Raaaaaagh!!",
      "status": "imported"
    },
    "voice_183:r_9e0c80ac7e33b459": {
      "text": "Haaah!",
      "status": "imported"
    },
    "voice_183:r_7432ef43ed3471dc": {
      "text": "Get out of the waaay!!",
      "status": "imported"
    },
    "voice_183:r_065443f6ddfcf0d7": {
      "text": "You can't stop me!",
      "status": "imported"
    },
    "voice_183:r_47d52a2839c71715": {
      "text": "Mooove!!",
      "status": "imported"
    },
    "voice_183:r_857c4a52ce8df0fd": {
      "text": "I don't trust\\nturncoats!!",
      "status": "imported"
    },
    "voice_183:r_55417493fce1d347": {
      "text": "I've wanted to fight you!",
      "status": "imported"
    },
    "voice_183:r_8fdf5910927c9591": {
      "text": "This will finish you!",
      "status": "imported"
    },
    "voice_183:r_7d724dbcc4451e10": {
      "text": "Your guard was too lax! Your fault!",
      "status": "imported"
    },
    "voice_183:r_93e25418a203cb8f": {
      "text": "Heero, move aside!",
      "status": "imported"
    },
    "voice_183:r_adeb0a29274d3d9b": {
      "text": "Duo, I'll take it from here!",
      "status": "imported"
    },
    "voice_183:r_24cf161287ef9d5c": {
      "text": "Trowa! I'll take that one down!",
      "status": "imported"
    },
    "voice_183:r_8f60f6fc86db3107": {
      "text": "Quatre, I'll take it from here!",
      "status": "imported"
    },
    "voice_183:r_b1de76a75a253c13": {
      "text": "Heero! I'll handle this one!",
      "status": "imported"
    },
    "voice_183:r_128c35bf3e0e394c": {
      "text": "Fall back, Duo!",
      "status": "imported"
    },
    "voice_183:r_5213c17e13b23de0": {
      "text": "Trowa! Move aside!",
      "status": "imported"
    },
    "voice_183:r_38fdff9483e9245c": {
      "text": "Stay sharp, Quatre!",
      "status": "imported"
    },
    "voice_183:r_2a00f1044ad5cbaa": {
      "text": "You have no place in space!!",
      "status": "imported"
    },
    "voice_183:r_98d15b8cc09bc915": {
      "text": "I'll deliver the final blow!",
      "status": "imported"
    },
    "voice_183:r_46e86d000250e137": {
      "text": "Guh! By the likes of you!!",
      "status": "imported"
    },
    "voice_183:r_ac341e7976e88f0b": {
      "text": "Ngh! Just what I wanted!!",
      "status": "imported"
    },
    "voice_183:r_cdbd128a5b4127cc": {
      "text": "Not bad! But it's not over yet!!",
      "status": "imported"
    },
    "voice_183:r_cfccaa1fbeda124c": {
      "text": "I won't lose!",
      "status": "imported"
    },
    "voice_183:r_b1f8ec192b9c083a": {
      "text": "With no more power than that...",
      "status": "imported"
    },
    "voice_183:r_a007f9ab9cf048b3": {
      "text": "There you are!",
      "status": "imported"
    },
    "voice_183:r_ddafde4b065ced49": {
      "text": "You're no match for me!",
      "status": "imported"
    },
    "voice_183:r_de1213040856c089": {
      "text": "You'll face me!",
      "status": "imported"
    },
    "voice_183:r_d692f1d420460a47": {
      "text": "How's that!!",
      "status": "imported"
    },
    "voice_183:r_a5643cec86b18bd2": {
      "text": "Enough talk!!",
      "status": "imported"
    },
    "voice_183:r_2c9d94ba13c5fc50": {
      "text": "I'll erase\\nthose with evil intent!!",
      "status": "imported"
    },
    "voice_183:r_428c2116ac3071b1": {
      "text": "Feel this!",
      "status": "imported"
    },
    "voice_183:r_84c116267b79f540": {
      "text": "Fall!",
      "status": "imported"
    },
    "voice_183:r_dad38ee29af2df3a": {
      "text": "Hmph!",
      "status": "imported"
    },
    "voice_183:r_3d32e86f8dc80909": {
      "text": "Rrgh!",
      "status": "imported"
    },
    "voice_183:r_70451ffbabe2f876": {
      "text": "Leave it to me.",
      "status": "imported"
    },
    "voice_183:r_69dfa1659715e2fa": {
      "text": "Guh! Not yet!\\nThis isn't over!!",
      "status": "imported"
    },
    "voice_183:r_d996fd6d4ef5b329": {
      "text": "Grr!\\nAre you saying I have doubts?!",
      "status": "imported"
    },
    "voice_183:r_8ab47a28f99ef565": {
      "text": "That won't\\nstop Nataku and me!!",
      "status": "imported"
    },
    "voice_183:r_546de3fb6db156ea": {
      "text": "Grr... You're worthy\\nto face me.",
      "status": "imported"
    },
    "voice_183:r_ca85f87cee5e31f7": {
      "text": "Grr, I still have much to learn...!",
      "status": "imported"
    },
    "voice_183:r_9072ea7bc71df136": {
      "text": "Grr... Is this the end?!",
      "status": "imported"
    },
    "voice_183:r_04e815a8d425827d": {
      "text": "To think I must retreat here...!",
      "status": "imported"
    },
    "voice_183:r_d89011fe3e5d082a": {
      "text": "What are you trying to do?!",
      "status": "imported"
    },
    "voice_183:r_5b9e8897190892eb": {
      "text": "Evil god,\\nI'll erase you myself!!",
      "status": "imported"
    },
    "voice_183:r_dd01a4c0d1b36a8d": {
      "text": "I'll sweep these puppets aside!!",
      "status": "imported"
    },
    "voice_183:r_0ab7914877fd48ed": {
      "text": "Still want\\nthis pointless battle?!",
      "status": "imported"
    },
    "voice_183:r_c958860b0676b1f5": {
      "text": "Grr! How disgraceful I am!!",
      "status": "imported"
    },
    "voice_183:r_9b9726b1872759d6": {
      "text": "Are you really in the right?!",
      "status": "imported"
    },
    "voice_183:r_bdd38c584fa313d0": {
      "text": "I'll go on ahead!",
      "status": "imported"
    },
    "voice_183:r_3fd86c1027f317c8": {
      "text": "I'm going ahead.",
      "status": "imported"
    },
    "voice_183:r_d0372a183d2007ad": {
      "text": "Very well...!",
      "status": "imported"
    },
    "voice_183:r_217aa5e1d545b44d": {
      "text": "We'll do this our way.",
      "status": "imported"
    },
    "voice_183:r_381992c5d8224937": {
      "text": "I don't need you ordering me around!",
      "status": "imported"
    }
  }
}
