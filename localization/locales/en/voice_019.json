{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_019:r_479b340ccc6c572b": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_019:r_77949221bf58f862": {
      "text": "There!",
      "status": "imported"
    },
    "voice_019:r_70b9c4b9f1f37eff": {
      "text": "Got you!",
      "status": "imported"
    },
    "voice_019:r_9fcb3754cb1773c7": {
      "text": "I'll shoot you down!",
      "status": "imported"
    },
    "voice_019:r_3559d2fad32c2435": {
      "text": "Drop dead!",
      "status": "imported"
    },
    "voice_019:r_f7570547e9f80a64": {
      "text": "You're too naive!",
      "status": "imported"
    },
    "voice_019:r_cbab0f4720e1fcf1": {
      "text": "Target confirmed! Attack!",
      "status": "imported"
    },
    "voice_019:r_0bbe0b4f5364e732": {
      "text": "Now, let's see what you can do!",
      "status": "imported"
    },
    "voice_019:r_5dda5198137cb02a": {
      "text": "I've already assessed your forces!",
      "status": "imported"
    },
    "voice_019:r_83ec59afbecdec14": {
      "text": "Just as we anticipated!",
      "status": "imported"
    },
    "voice_019:r_e20bfd42ad95a3c9": {
      "text": "It's just business, you know!",
      "status": "imported"
    },
    "voice_019:r_0f58a8822381e57f": {
      "text": "Everything's going as planned!",
      "status": "imported"
    },
    "voice_019:r_6dbcc507fb61b51d": {
      "text": "Come on! Dance until you die!",
      "status": "imported"
    },
    "voice_019:r_b42ab697149a7c8a": {
      "text": "Looks like I caught some prey!",
      "status": "imported"
    },
    "voice_019:r_4de4fcf3b440baf4": {
      "text": "Resistance is futile!",
      "status": "imported"
    },
    "voice_019:r_0121a166c715cdff": {
      "text": "I can see your every move!",
      "status": "imported"
    },
    "voice_019:r_30fad37a42bd3ad3": {
      "text": "Say your goodbyes to this world!",
      "status": "imported"
    },
    "voice_019:r_80a0b2a84e05d81a": {
      "text": "I didn't last this long by luck!",
      "status": "imported"
    },
    "voice_019:r_4a9ac1dff86506d9": {
      "text": "This thing won't be stopped easily!",
      "status": "imported"
    },
    "voice_019:r_bc8538e6af3d2577": {
      "text": "This thing's power is no joke!",
      "status": "imported"
    },
    "voice_019:r_924516c8de2b5342": {
      "text": "I feel like a giant!",
      "status": "imported"
    },
    "voice_019:r_da1174533722333f": {
      "text": "I'll crush you with sheer force!",
      "status": "imported"
    },
    "voice_019:r_fdeb8162976e72c1": {
      "text": "Feel this thing's power!",
      "status": "imported"
    },
    "voice_019:r_0fadb5c26df92b42": {
      "text": "I'll make this thing obey me!",
      "status": "imported"
    },
    "voice_019:r_6b15af9a0057cdc8": {
      "text": "They gave me their latest machine!",
      "status": "imported"
    },
    "voice_019:r_15b4a90140e8a33a": {
      "text": "It really is unlike my old machine!",
      "status": "imported"
    },
    "voice_019:r_af884a6b11dff121": {
      "text": "Impressive,\\nthis Lambda Driver!",
      "status": "imported"
    },
    "voice_019:r_ac6fe7838e95647b": {
      "text": "With the Lambda Driver's power...!",
      "status": "imported"
    },
    "voice_019:r_77ca87eacd17ad52": {
      "text": "Playing the hero of justice?!",
      "status": "imported"
    },
    "voice_019:r_bf3244994760e535": {
      "text": "What an irritating bunch!",
      "status": "imported"
    },
    "voice_019:r_aabfb21c9d069ce7": {
      "text": "We're both just dogs of war!",
      "status": "imported"
    },
    "voice_019:r_02479dc8fe989560": {
      "text": "Your latest gear\\nwill be scrap!",
      "status": "imported"
    },
    "voice_019:r_a2df00f91a9b0a9e": {
      "text": "The famous white one's here...!",
      "status": "imported"
    },
    "voice_019:r_48b60d6c48b9b142": {
      "text": "I was warned\\nhow dangerous you are!",
      "status": "imported"
    },
    "voice_019:r_8927e6fb681aa809": {
      "text": "A special bonus if I sink that one!",
      "status": "imported"
    },
    "voice_019:r_665f01666859013b": {
      "text": "So you're\\nthe rumored Toy Box!",
      "status": "imported"
    },
    "voice_019:r_a571eec59b258d11": {
      "text": "What is that fluffy thing?!",
      "status": "imported"
    },
    "voice_019:r_ddbe581c5ea9183d": {
      "text": "Why is there a mascot at war?!",
      "status": "imported"
    },
    "voice_019:r_faae935cca0edc72": {
      "text": "A mouse?! A bear?! Is that a UMA?!",
      "status": "imported"
    },
    "voice_019:r_d4430bf362340b32": {
      "text": "Speed will make that hulk helpless!",
      "status": "imported"
    },
    "voice_019:r_6ff1323b355593e0": {
      "text": "An expensive one-off toy, huh?!",
      "status": "imported"
    },
    "voice_019:r_b7b5625d7cd4282f": {
      "text": "Flashy machines make easy targets!",
      "status": "imported"
    },
    "voice_019:r_36133ad73a73ef98": {
      "text": "We're both scum. Let's get along!",
      "status": "imported"
    },
    "voice_019:r_920740a0219c5085": {
      "text": "Don't think an AT can beat an AS!",
      "status": "imported"
    },
    "voice_019:r_a8451712c57c1a72": {
      "text": "Martial's so-called\\nUntouchable...!",
      "status": "imported"
    },
    "voice_019:r_3633df5b7b8f47fa": {
      "text": "A Gundam?!\\nI've wanted this fight!",
      "status": "imported"
    },
    "voice_019:r_52dfc56b14b93551": {
      "text": "Downing a Gundam will make my name!",
      "status": "imported"
    },
    "voice_019:r_1b9b2aab5cb104da": {
      "text": "More dangerous than the rumors...!",
      "status": "imported"
    },
    "voice_019:r_342044c706a2340f": {
      "text": "A Gundam knockoff is my opponent?!",
      "status": "imported"
    },
    "voice_019:r_cf41e8828a90cbdb": {
      "text": "The Earth Federation's watchdog!",
      "status": "imported"
    },
    "voice_019:r_719e897304ec42d4": {
      "text": "You've ruined\\ntoo many of my deals!",
      "status": "imported"
    },
    "voice_019:r_d5e0a2317c40d322": {
      "text": "Celestial Being has fallen so far!",
      "status": "imported"
    },
    "voice_019:r_ec2ea17765052401": {
      "text": "Terrorists,\\nnow Federation pawns!",
      "status": "imported"
    },
    "voice_019:r_5d08ad19e2da125b": {
      "text": "A Preventer Gundam is here!",
      "status": "imported"
    },
    "voice_019:r_a7246b52782a877e": {
      "text": "Another Black Knights survivor!",
      "status": "imported"
    },
    "voice_019:r_dc8701f6bcb9904f": {
      "text": "So I face the infamous Zero...!",
      "status": "imported"
    },
    "voice_019:r_d6bdd730f24f66eb": {
      "text": "I'll finish you before you dart!",
      "status": "imported"
    },
    "voice_019:r_41997412868c48c4": {
      "text": "Speed alone won't win this for you!",
      "status": "imported"
    },
    "voice_019:r_9e6cf4f389dae55c": {
      "text": "You should've stayed\\nbehind a desk!",
      "status": "imported"
    },
    "voice_019:r_065443f6ddfcf0d7": {
      "text": "A clueless amateur wandered in!",
      "status": "imported"
    },
    "voice_019:r_eb7ae28b53dc033c": {
      "text": "No more negotiating,\\nNegotiator!",
      "status": "imported"
    },
    "voice_019:r_857c4a52ce8df0fd": {
      "text": "A remote-controlled puppet...!",
      "status": "imported"
    },
    "voice_019:r_55417493fce1d347": {
      "text": "What is that?!\\nA real machine?!",
      "status": "imported"
    },
    "voice_019:r_8fdf5910927c9591": {
      "text": "Sink the battleship to decide this!",
      "status": "imported"
    },
    "voice_019:r_7d724dbcc4451e10": {
      "text": "I'll hit the bridge dead-on!",
      "status": "imported"
    },
    "voice_019:r_93e25418a203cb8f": {
      "text": "This thing won't be overpowered!",
      "status": "imported"
    },
    "voice_019:r_adeb0a29274d3d9b": {
      "text": "Now this is a battle of giants!",
      "status": "imported"
    },
    "voice_019:r_24cf161287ef9d5c": {
      "text": "Fear this overwhelming power!",
      "status": "imported"
    },
    "voice_019:r_128c35bf3e0e394c": {
      "text": "Damn rat! I'll crush you flat!",
      "status": "imported"
    },
    "voice_019:r_620fedec67706d7d": {
      "text": "Gear's even! Skill will decide it!",
      "status": "imported"
    },
    "voice_019:r_9680dcd0fddcfcc7": {
      "text": "A clash of Lambda Drivers!",
      "status": "imported"
    },
    "voice_019:r_2a00f1044ad5cbaa": {
      "text": "A mere AS can't defeat this thing!",
      "status": "imported"
    },
    "voice_019:r_3dbeead1bd3164ef": {
      "text": "Standard machines are no threat!",
      "status": "imported"
    },
    "voice_019:r_26e5efec03c03d78": {
      "text": "My turn starts now!",
      "status": "imported"
    },
    "voice_019:r_4ad81e88c7557a8b": {
      "text": "Now, let's return the favor!",
      "status": "imported"
    },
    "voice_019:r_1f65a7af190e4674": {
      "text": "I'll turn the tide!",
      "status": "imported"
    },
    "voice_019:r_40c5a9358ed5bf29": {
      "text": "It's about time you shut up!",
      "status": "imported"
    },
    "voice_019:r_f2e18dfdfe0c89ea": {
      "text": "I've got the right to attack too!",
      "status": "imported"
    },
    "voice_019:r_cf7dbf49e96a5755": {
      "text": "Hit them before they can escape!",
      "status": "imported"
    },
    "voice_019:r_fa96676cc65bb509": {
      "text": "I'm no fool who lets you counter!",
      "status": "imported"
    },
    "voice_019:r_4e37f92e7d2fc62e": {
      "text": "This beating won't go unanswered!",
      "status": "imported"
    },
    "voice_019:r_66ab4cfe1557909d": {
      "text": "Now we're even!",
      "status": "imported"
    },
    "voice_019:r_0bad405ee6ca63ba": {
      "text": "Too bad. I'm still alive!",
      "status": "imported"
    },
    "voice_019:r_2072eaf71a260ae7": {
      "text": "We'll finish them together!",
      "status": "imported"
    },
    "voice_019:r_6c13bbfd27a7799e": {
      "text": "I'll deliver the finishing blow!",
      "status": "imported"
    },
    "voice_019:r_06f88dcbd3c9e738": {
      "text": "One careless moment can mean death!",
      "status": "imported"
    },
    "voice_019:r_b28faf9f71bc3598": {
      "text": "As expected of you, Fe...!",
      "status": "imported"
    },
    "voice_019:r_8a29278549f8e07a": {
      "text": "Gates,\\nplease fall back at once!",
      "status": "imported"
    },
    "voice_019:r_7e6c573c26177f98": {
      "text": "This time I'll put you to rest!",
      "status": "imported"
    },
    "voice_019:r_45abf84f7757d6eb": {
      "text": "Too bad!\\nMy attack isn't over yet!",
      "status": "imported"
    },
    "voice_019:r_edd7a13ab8f06a14": {
      "text": "Aaaaaaaaargh...!",
      "status": "imported"
    },
    "voice_019:r_8165e5b41f0124c4": {
      "text": "Impossible! You're this strong...?!",
      "status": "imported"
    },
    "voice_019:r_4e05581b7432cce8": {
      "text": "No! This machine won't hold...!",
      "status": "imported"
    },
    "voice_019:r_a60b107ea3c36a86": {
      "text": "No! This ruins the operation...!",
      "status": "imported"
    },
    "voice_019:r_e33693e5ba4665b0": {
      "text": "To lose such a costly machine...!",
      "status": "imported"
    },
    "voice_019:r_72a21a1a489af001": {
      "text": "Eject! Survival takes priority!",
      "status": "imported"
    },
    "voice_019:r_eb643f8bf737a0ca": {
      "text": "It's no mascot...! It's a demon!",
      "status": "imported"
    },
    "voice_019:r_0a3fccb71ec6cf2a": {
      "text": "Bonta-kun is terrifying!",
      "status": "imported"
    },
    "voice_019:r_9b63cf1f3e0207ef": {
      "text": "Damn...! No ordinary soldier!",
      "status": "imported"
    },
    "voice_019:r_8356f4e3dcdff938": {
      "text": "No wonder they gathered such aces!",
      "status": "imported"
    },
    "voice_019:r_1d6d784036ae0bd7": {
      "text": "So you're a true hero,\\nnot a poser!",
      "status": "imported"
    },
    "voice_019:r_625664af02183c17": {
      "text": "As I thought, no ordinary AS...!",
      "status": "imported"
    },
    "voice_019:r_3701cba361f80ea5": {
      "text": "Strong...!\\nFar beyond my intel!",
      "status": "imported"
    },
    "voice_019:r_63f429c5c68c0863": {
      "text": "They've read all\\nof my moves?!",
      "status": "imported"
    },
    "voice_019:r_38e4a434c91d8ef0": {
      "text": "That captain...! What a demon!",
      "status": "imported"
    },
    "voice_019:r_98ed411352a3a6ac": {
      "text": "Am I...?! Is this some nightmare?!",
      "status": "imported"
    },
    "voice_019:r_4824bea6bab3af67": {
      "text": "Damn! Is the power gap too great?!",
      "status": "imported"
    },
    "voice_019:r_862b92e63adb9734": {
      "text": "It truly earns the name Super!",
      "status": "imported"
    },
    "voice_019:r_cb306ef55e49d107": {
      "text": "Damn Gundam!\\nMore than a name!",
      "status": "imported"
    },
    "voice_019:r_57b2bd2de8a1408d": {
      "text": "Fearsome!\\nThat Gundam and pilot!",
      "status": "imported"
    },
    "voice_019:r_76f080a4881e8ab5": {
      "text": "Strong...! Truly Untouchable!",
      "status": "imported"
    },
    "voice_019:r_288133bc5b573dae": {
      "text": "You...!\\nWhat hell did you survive?!",
      "status": "imported"
    },
    "voice_019:r_6f95653e548f8fcf": {
      "text": "Celestial Being!\\nYou damned pests!",
      "status": "imported"
    },
    "voice_019:r_d249d68bada91ab9": {
      "text": "Damn Preventer! Persistent scum!",
      "status": "imported"
    },
    "voice_019:r_e9b3307e9eb69f11": {
      "text": "The Black Knights' legend lives on!",
      "status": "imported"
    },
    "voice_019:r_03cdac73042343ee": {
      "text": "Some salaryman\\npushed me this far?!",
      "status": "imported"
    },
    "voice_019:r_96bb0dcde0c8c44a": {
      "text": "Damn! What the hell's going on?!",
      "status": "imported"
    },
    "voice_019:r_641550a2f54cb456": {
      "text": "Whoa! What a bastard!",
      "status": "imported"
    },
    "voice_019:r_a0f2074af8debbfa": {
      "text": "Looks like\\nmy number is up...!",
      "status": "imported"
    },
    "voice_019:r_b5f5a97ed82acb0b": {
      "text": "So you're one move ahead...!",
      "status": "imported"
    },
    "voice_019:r_d9cd2e4ded064396": {
      "text": "You won't go down easily, I see...!",
      "status": "imported"
    },
    "voice_019:r_99e6349431aaf23b": {
      "text": "My every read\\nmisses the mark...!",
      "status": "imported"
    },
    "voice_019:r_ec1081caf845f56a": {
      "text": "Tch! Still no retreat order?!",
      "status": "imported"
    },
    "voice_019:r_2c5b7ee872c1ed7f": {
      "text": "A deadly fight after all this time!",
      "status": "imported"
    },
    "voice_019:r_76d1e51c8b494a60": {
      "text": "Unstable voltage! I must hurry!",
      "status": "imported"
    },
    "voice_019:r_eb5f687fcd372ae7": {
      "text": "Hold on a little longer, junker...!",
      "status": "imported"
    },
    "voice_019:r_2329428a6871d9fa": {
      "text": "One step short of fatal damage!",
      "status": "imported"
    },
    "voice_019:r_0e7466971bec4cc4": {
      "text": "Die here,\\nlose my entire reward!",
      "status": "imported"
    },
    "voice_019:r_efa71f7a4cc33ff3": {
      "text": "Time to steel myself again...!",
      "status": "imported"
    },
    "voice_019:r_3fc2e1186557e7a0": {
      "text": "I admit your strength, not defeat!",
      "status": "imported"
    },
    "voice_019:r_fa6930340a545054": {
      "text": "Skilled soldiers always survive...!",
      "status": "imported"
    },
    "voice_019:r_10a408809e512df1": {
      "text": "The plan needs a slight revision...",
      "status": "imported"
    },
    "voice_019:r_bc7b9e308b879dd4": {
      "text": "Not bad... Worthy prey at last.",
      "status": "imported"
    },
    "voice_019:r_98902fd3143c393e": {
      "text": "Stay calm... Never rush in battle.",
      "status": "imported"
    },
    "voice_019:r_d907fbd7bc1c4298": {
      "text": "I let my guard down. How unlike me.",
      "status": "imported"
    },
    "voice_019:r_96b21e3a028dd074": {
      "text": "Class B damage, lower right arm?!",
      "status": "imported"
    },
    "voice_019:r_ce140b5d8e6b7310": {
      "text": "This is getting less interesting...",
      "status": "imported"
    },
    "voice_019:r_0e0335789c5396d7": {
      "text": "But your brave struggle ends here!",
      "status": "imported"
    },
    "voice_019:r_a8e85bd950696403": {
      "text": "Reluctantly, I'll reassess you...!",
      "status": "imported"
    },
    "voice_019:r_772c8bc40ab6cb61": {
      "text": "Now I'm breaking a cold sweat...!",
      "status": "imported"
    },
    "voice_019:r_58dd2826a199ef51": {
      "text": "You keep throwing off my rhythm...!",
      "status": "imported"
    },
    "voice_019:r_aadc0b2442adb93b": {
      "text": "Your kind is trouble\\nwhen cocky...!",
      "status": "imported"
    },
    "voice_019:r_e7a8cd8ed5bc2d1b": {
      "text": "I knew it.\\nYou're a cut above...!",
      "status": "imported"
    },
    "voice_019:r_041dd920da4a7c17": {
      "text": "The power gap is obvious.",
      "status": "imported"
    },
    "voice_019:r_c7f4280cde4605b3": {
      "text": "You still mean to oppose me?",
      "status": "imported"
    },
    "voice_019:r_ec349c8ea9511a18": {
      "text": "Think this is enough to stop me?",
      "status": "imported"
    },
    "voice_019:r_33236ffa3ea95b68": {
      "text": "A direct hit did that? Pathetic.",
      "status": "imported"
    },
    "voice_019:r_689d0b123de71ae0": {
      "text": "That was an unexpected attack.",
      "status": "imported"
    },
    "voice_019:r_84883aa95f63ce32": {
      "text": "Need to correct bilateral angle...",
      "status": "imported"
    },
    "voice_019:r_25493e978ce8ff16": {
      "text": "What a pointless thing to do...!",
      "status": "imported"
    },
    "voice_019:r_7316666150e42960": {
      "text": "You small fry...! Time to give up!",
      "status": "imported"
    },
    "voice_019:r_c4f11aa93dc5b668": {
      "text": "What a boring attack.",
      "status": "imported"
    },
    "voice_019:r_ce1a22dfe3a4d339": {
      "text": "I don't owe you a free hit.",
      "status": "imported"
    },
    "voice_019:r_240651adab81e145": {
      "text": "You can stew in frustration.",
      "status": "imported"
    },
    "voice_019:r_cff0deaae73c2858": {
      "text": "No unnecessary movement.",
      "status": "imported"
    },
    "voice_019:r_dca67f68a573fab7": {
      "text": "Such a sloppy attack won't hit...!",
      "status": "imported"
    },
    "voice_019:r_a6630215fefaf294": {
      "text": "You move like a complete amateur.",
      "status": "imported"
    },
    "voice_019:r_6f94566ad37f8ff8": {
      "text": "Whoa, that was a close one!",
      "status": "imported"
    },
    "voice_019:r_942ca03c9de80143": {
      "text": "I have no time to play your games!",
      "status": "imported"
    },
    "voice_019:r_d8c669c70659e18a": {
      "text": "That weak hit won't affect me!",
      "status": "imported"
    },
    "voice_019:r_8f5bade7ac2db78e": {
      "text": "I can pull off this trick too!",
      "status": "imported"
    },
    "voice_019:r_05ea490d2f522520": {
      "text": "I came prepared with decent gear!",
      "status": "imported"
    },
    "voice_019:r_b708a1d959013dbf": {
      "text": "They call this an unseen shield.",
      "status": "imported"
    },
    "voice_019:r_59fca03e929366c1": {
      "text": "I've got a Lambda Driver too!",
      "status": "imported"
    },
    "voice_019:r_0d65eb631dcb7514": {
      "text": "Quite handy,\\nthis Lambda Driver...!",
      "status": "imported"
    },
    "voice_019:r_d03018a31e23f1e9": {
      "text": "Tch! Have I run out of moves?!",
      "status": "imported"
    },
    "voice_019:r_279da5f732aa8847": {
      "text": "This will hinder the operation...!",
      "status": "imported"
    },
    "voice_019:r_97f82e3cb6f70110": {
      "text": "So I've fallen into your trap...",
      "status": "imported"
    },
    "voice_019:r_c5611d8dd6def96b": {
      "text": "You outwitted me. You're good...!",
      "status": "imported"
    },
    "voice_019:r_6f12cc8ed2732eb5": {
      "text": "Some surprisingly cheap tricks...!",
      "status": "imported"
    },
    "voice_019:r_7abfc55f8fb62ba7": {
      "text": "I fell for such a basic tactic...!",
      "status": "imported"
    },
    "voice_019:r_99e7a66c650b5892": {
      "text": "I won't let you!",
      "status": "imported"
    },
    "voice_019:r_5b2247b5cfbcd7b2": {
      "text": "I'll be your shield!",
      "status": "imported"
    },
    "voice_019:r_2d7a9c06347582d9": {
      "text": "Fall back while you still can!",
      "status": "imported"
    },
    "voice_019:r_bf953d64c3c7d9b7": {
      "text": "I'll support Fe!",
      "status": "imported"
    },
    "voice_019:r_e09b933e3e706779": {
      "text": "You're getting too cocky, Gates!",
      "status": "imported"
    },
    "voice_019:r_9747bd61ad23ecd3": {
      "text": "Stay right where you are!",
      "status": "imported"
    },
    "voice_019:r_6823f8abe05c4727": {
      "text": "I'll hit you dead-on!",
      "status": "imported"
    },
    "voice_019:r_b8ccfd8b8ac323ac": {
      "text": "At this range, this will do!",
      "status": "imported"
    },
    "voice_019:r_c885ff2097749991": {
      "text": "I won't miss!",
      "status": "imported"
    },
    "voice_019:r_a8da7f8d8b705db0": {
      "text": "You can't escape my sights!",
      "status": "imported"
    },
    "voice_019:r_02e1c5e19de5bd22": {
      "text": "Target locked!",
      "status": "imported"
    },
    "voice_019:r_6fb823898811e210": {
      "text": "Engaging at close range!",
      "status": "imported"
    },
    "voice_019:r_5dcbcf1682cc3ab8": {
      "text": "Diving in!",
      "status": "imported"
    },
    "voice_019:r_5a20988e743dc1d0": {
      "text": "Closing the distance!",
      "status": "imported"
    },
    "voice_019:r_197f05bf899b7697": {
      "text": "I'm taking this to melee range!",
      "status": "imported"
    },
    "voice_019:r_623ee03bd91ab2a1": {
      "text": "I'll use the Lambda Driver!",
      "status": "imported"
    },
    "voice_019:r_c5c491f8761152f0": {
      "text": "Raaaaagh!",
      "status": "imported"
    },
    "voice_019:r_15042263763f11bb": {
      "text": "Lambda Driver, activate!",
      "status": "imported"
    },
    "voice_019:r_96b3a8f080aea8b4": {
      "text": "Hyaaaah!",
      "status": "imported"
    },
    "voice_019:r_3d4fa015b8b31648": {
      "text": "I'll go ahead and engage!",
      "status": "imported"
    },
    "voice_019:r_c1f3167d7dd97543": {
      "text": "I'll draw their fire!",
      "status": "imported"
    },
    "voice_019:r_1ac46173650ffe13": {
      "text": "I'll handle the diversion!",
      "status": "imported"
    },
    "voice_019:r_53660d6bc7fe8513": {
      "text": "I'll provide support!",
      "status": "imported"
    },
    "voice_019:r_2e756557a1d92e8b": {
      "text": "We'll pick them off one by one!",
      "status": "imported"
    },
    "voice_019:r_45d847e7b8d840e3": {
      "text": "So that's the target!",
      "status": "imported"
    },
    "voice_019:r_d2ebe8f28f2420cc": {
      "text": "If it's one-on-one!",
      "status": "imported"
    },
    "voice_019:r_3baa2292b050034a": {
      "text": "I can't afford any mistakes!",
      "status": "imported"
    }
  }
}
