{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_190:r_479b340ccc6c572b": {
      "text": "We have a mission to fulfill!",
      "status": "imported"
    },
    "voice_190:r_77949221bf58f862": {
      "text": "Captain, let's clear his path!",
      "status": "imported"
    },
    "voice_190:r_70b9c4b9f1f37eff": {
      "text": "For the honor of the Guard!",
      "status": "imported"
    },
    "voice_190:r_9fcb3754cb1773c7": {
      "text": "Now witness the Guard's power!",
      "status": "imported"
    },
    "voice_190:r_3559d2fad32c2435": {
      "text": "I'll take down the Gundam!",
      "status": "imported"
    },
    "voice_190:r_f7570547e9f80a64": {
      "text": "Even Gundam is no match for us!",
      "status": "imported"
    },
    "voice_190:r_cbab0f4720e1fcf1": {
      "text": "The Guard will take on the Gundam!",
      "status": "imported"
    },
    "voice_190:r_0bbe0b4f5364e732": {
      "text": "That Gundam knockoff can't face me!",
      "status": "imported"
    },
    "voice_190:r_5dda5198137cb02a": {
      "text": "We'll seize the Box ourselves!",
      "status": "imported"
    },
    "voice_190:r_83ec59afbecdec14": {
      "text": "I just need to disable it!",
      "status": "imported"
    },
    "voice_190:r_e20bfd42ad95a3c9": {
      "text": "Pay for insulting our Colonel!",
      "status": "imported"
    },
    "voice_190:r_0f58a8822381e57f": {
      "text": "I'll silence Londo Bell!",
      "status": "imported"
    },
    "voice_190:r_6dbcc507fb61b51d": {
      "text": "Londo Bell!\\nAre you a match for us?!",
      "status": "imported"
    },
    "voice_190:r_b42ab697149a7c8a": {
      "text": "A Celestial Being Gundam!",
      "status": "imported"
    },
    "voice_190:r_4de4fcf3b440baf4": {
      "text": "A Gundam from the colonies!",
      "status": "imported"
    },
    "voice_190:r_30fad37a42bd3ad3": {
      "text": "Regret being a Federation lapdog!",
      "status": "imported"
    },
    "voice_190:r_bc8538e6af3d2577": {
      "text": "Traitors must be purged!",
      "status": "imported"
    },
    "voice_190:r_da1174533722333f": {
      "text": "I'll crush you to make an example!",
      "status": "imported"
    },
    "voice_190:r_0fadb5c26df92b42": {
      "text": "So much for your ideals, Red Comet!",
      "status": "imported"
    },
    "voice_190:r_6b15af9a0057cdc8": {
      "text": "I'll pierce that heavy armor!",
      "status": "imported"
    },
    "voice_190:r_15b4a90140e8a33a": {
      "text": "That huge frame is an easy target!",
      "status": "imported"
    },
    "voice_190:r_af884a6b11dff121": {
      "text": "Flee in terror, variable fighter!",
      "status": "imported"
    },
    "voice_190:r_ac6fe7838e95647b": {
      "text": "Without mobility, you're no threat!",
      "status": "imported"
    },
    "voice_190:r_77ca87eacd17ad52": {
      "text": "An AT dares challenge the Guard!",
      "status": "imported"
    },
    "voice_190:r_bf3244994760e535": {
      "text": "Don't think a mere AS can beat us!",
      "status": "imported"
    },
    "voice_190:r_aabfb21c9d069ce7": {
      "text": "Black Knights! Some of you survived!",
      "status": "imported"
    },
    "voice_190:r_02479dc8fe989560": {
      "text": "All that machine has is agility!",
      "status": "imported"
    },
    "voice_190:r_a2df00f91a9b0a9e": {
      "text": "No mercy, even for civilians!",
      "status": "imported"
    },
    "voice_190:r_665f01666859013b": {
      "text": "An amateur has no place in battle!",
      "status": "imported"
    },
    "voice_190:r_faae935cca0edc72": {
      "text": "Looks like you're a worthy opponent!",
      "status": "imported"
    },
    "voice_190:r_d4430bf362340b32": {
      "text": "Perfect chance to prove our power!",
      "status": "imported"
    },
    "voice_190:r_6ff1323b355593e0": {
      "text": "Commander unit spotted! Attack!",
      "status": "imported"
    },
    "voice_190:r_b7b5625d7cd4282f": {
      "text": "Concentrate fire on the mothership!",
      "status": "imported"
    },
    "voice_190:r_36133ad73a73ef98": {
      "text": "We'll destroy the bridge!",
      "status": "imported"
    },
    "voice_190:r_cfccaa1fbeda124c": {
      "text": "You'll pay for this!",
      "status": "imported"
    },
    "voice_190:r_b1f8ec192b9c083a": {
      "text": "I'll seize this opportunity!",
      "status": "imported"
    },
    "voice_190:r_a007f9ab9cf048b3": {
      "text": "Don't think you can escape!",
      "status": "imported"
    },
    "voice_190:r_ddafde4b065ced49": {
      "text": "I'll strike before I lose track!",
      "status": "imported"
    },
    "voice_190:r_de1213040856c089": {
      "text": "I've got the perfect position!",
      "status": "imported"
    },
    "voice_190:r_3304412ac41f47a6": {
      "text": "You underestimated the Guard!",
      "status": "imported"
    },
    "voice_190:r_0c0775e051211840": {
      "text": "Regret your foolishness!",
      "status": "imported"
    },
    "voice_190:r_a2afffe1c396f0b3": {
      "text": "Attack us and this is what you get!",
      "status": "imported"
    },
    "voice_190:r_13c25fbdfddc8a24": {
      "text": "Cover our allies!",
      "status": "imported"
    },
    "voice_190:r_42ba1ecb310b4bd7": {
      "text": "Following up with another attack!",
      "status": "imported"
    },
    "voice_190:r_d692f1d420460a47": {
      "text": "Behold the Guard's coordination!",
      "status": "imported"
    },
    "voice_190:r_a5643cec86b18bd2": {
      "text": "Captain Angelo, I'm joining in!",
      "status": "imported"
    },
    "voice_190:r_68f2dfab20a4a30e": {
      "text": "We mustn't trouble the Colonel!",
      "status": "imported"
    },
    "voice_190:r_9cedad8237480563": {
      "text": "Commander! I'll cover you!",
      "status": "imported"
    },
    "voice_190:r_a03fabecba1508ca": {
      "text": "Garencieres' crew?\\nIs that all?!",
      "status": "imported"
    },
    "voice_190:r_5391b24a71eb10ae": {
      "text": "All right! One more time!",
      "status": "imported"
    },
    "voice_190:r_a554ceef5c87b972": {
      "text": "It's too soon to take a breather!",
      "status": "imported"
    },
    "voice_190:r_546c3d5937fbb7ee": {
      "text": "W-Waaaaaah!!",
      "status": "imported"
    },
    "voice_190:r_1568ff6298b12b96": {
      "text": "M-my machine's going to explode!",
      "status": "imported"
    },
    "voice_190:r_2c9d94ba13c5fc50": {
      "text": "Eject! It can't hold much longer!",
      "status": "imported"
    },
    "voice_190:r_a77f4913375098d2": {
      "text": "N-no...! I can't be beaten...!",
      "status": "imported"
    },
    "voice_190:r_428c2116ac3071b1": {
      "text": "The Guard can't end here...!",
      "status": "imported"
    },
    "voice_190:r_84c116267b79f540": {
      "text": "Even if I fall... the Guard will...!",
      "status": "imported"
    },
    "voice_190:r_dad38ee29af2df3a": {
      "text": "F-forgive me, Captain Angelo!",
      "status": "imported"
    },
    "voice_190:r_3d32e86f8dc80909": {
      "text": "C-Captain Angelo...! Aaaagh!",
      "status": "imported"
    },
    "voice_190:r_70451ffbabe2f876": {
      "text": "Frontal, sir,\\nVictory to Neo Zeon!",
      "status": "imported"
    },
    "voice_190:r_69dfa1659715e2fa": {
      "text": "Gundam! You're as good as they say!",
      "status": "imported"
    },
    "voice_190:r_d996fd6d4ef5b329": {
      "text": "Fearsome:\\nGundam and its pilot...!",
      "status": "imported"
    },
    "voice_190:r_8ab47a28f99ef565": {
      "text": "If I hold back, I'm finished...!",
      "status": "imported"
    },
    "voice_190:r_546de3fb6db156ea": {
      "text": "That damned V-fin...!",
      "status": "imported"
    },
    "voice_190:r_ca85f87cee5e31f7": {
      "text": "S-so this is Londo Bell...!",
      "status": "imported"
    },
    "voice_190:r_9072ea7bc71df136": {
      "text": "The sound of bells is closing in...!",
      "status": "imported"
    },
    "voice_190:r_04e815a8d425827d": {
      "text": "You'll pay, Celestial Being!",
      "status": "imported"
    },
    "voice_190:r_d89011fe3e5d082a": {
      "text": "Colony Gundam! Don't get cocky!",
      "status": "imported"
    },
    "voice_190:r_5b9e8897190892eb": {
      "text": "I-I can't lose to a traitor...!",
      "status": "imported"
    },
    "voice_190:r_dd01a4c0d1b36a8d": {
      "text": "Fast...! So that's the Red Comet!",
      "status": "imported"
    },
    "voice_190:r_20920ad2eb3542db": {
      "text": "I-I can't win...!\\nA Newtype?!",
      "status": "imported"
    },
    "voice_190:r_0ab7914877fd48ed": {
      "text": "Damn, impossible!\\nA Newtype?!",
      "status": "imported"
    },
    "voice_190:r_cb846feec748c2e3": {
      "text": "Damn! That power is off the charts!",
      "status": "imported"
    },
    "voice_190:r_c958860b0676b1f5": {
      "text": "Overwhelming power...! Truly super!",
      "status": "imported"
    },
    "voice_190:r_5e2669b82ef75ce3": {
      "text": "Too fast! I can't keep up...!",
      "status": "imported"
    },
    "voice_190:r_7847e0ed7dc9282d": {
      "text": "That AT pilot is no ordinary foe!",
      "status": "imported"
    },
    "voice_190:r_e42b52c7a987b906": {
      "text": "A mere AS did this much damage?!",
      "status": "imported"
    },
    "voice_190:r_6825fd1ff907bd22": {
      "text": "Not to the fallen Black Knights...!",
      "status": "imported"
    },
    "voice_190:r_607f666f1563bc0d": {
      "text": "Civilians are outplaying the Guard?!",
      "status": "imported"
    },
    "voice_190:r_9b9726b1872759d6": {
      "text": "M-me...\\nOverpowered by some pilot?!",
      "status": "imported"
    },
    "voice_190:r_1252db29683fefe0": {
      "text": "Why?! Why?!",
      "status": "imported"
    },
    "voice_190:r_ad3d538f1e909184": {
      "text": "Waaah! Th-this is bad, really bad!",
      "status": "imported"
    },
    "voice_190:r_8c61c59a1c0aebbf": {
      "text": "Didn't expect a foe this strong...!",
      "status": "imported"
    },
    "voice_190:r_aba6a7662129d8ce": {
      "text": "Eject...!\\nNo, I can't do that...!",
      "status": "imported"
    },
    "voice_190:r_b84afafb8a33ec60": {
      "text": "Are almost all the monitors dead?!",
      "status": "imported"
    },
    "voice_190:r_c8c59db85bf875e6": {
      "text": "No! Output is dropping fast!",
      "status": "imported"
    },
    "voice_190:r_391aa56435d9dd6e": {
      "text": "No...! But I'm in the Guard...!",
      "status": "imported"
    },
    "voice_190:r_7c796ba53bd7ea03": {
      "text": "The Guard...\\nToyed with so easily?!",
      "status": "imported"
    },
    "voice_190:r_fa944da4b6519006": {
      "text": "This disgraces the Guard's name...!",
      "status": "imported"
    },
    "voice_190:r_95d047bcc17fccc6": {
      "text": "My pride!\\nI won't go down easy!",
      "status": "imported"
    },
    "voice_190:r_640327a12a559b31": {
      "text": "I can't fail before the Colonel...!",
      "status": "imported"
    },
    "voice_190:r_bdd38c584fa313d0": {
      "text": "Angelo, sir!\\nNo retreat order yet?!",
      "status": "imported"
    },
    "voice_190:r_66ab4cfe1557909d": {
      "text": "Damn! Next time won't go like this!",
      "status": "imported"
    },
    "voice_190:r_0bad405ee6ca63ba": {
      "text": "You just got lucky reading me...!",
      "status": "imported"
    },
    "voice_190:r_2072eaf71a260ae7": {
      "text": "Quite the clever trick...!",
      "status": "imported"
    },
    "voice_190:r_6c13bbfd27a7799e": {
      "text": "Armor only!\\nDrive system intact!",
      "status": "imported"
    },
    "voice_190:r_06f88dcbd3c9e738": {
      "text": "You matched me...! Not bad!",
      "status": "imported"
    },
    "voice_190:r_b28faf9f71bc3598": {
      "text": "This isn't all the Guard can do...!",
      "status": "imported"
    },
    "voice_190:r_8a29278549f8e07a": {
      "text": "The Guard gets serious from here on!",
      "status": "imported"
    },
    "voice_190:r_7e6c573c26177f98": {
      "text": "Gah!\\nI can't fail the Captain!",
      "status": "imported"
    },
    "voice_190:r_45abf84f7757d6eb": {
      "text": "Mock me, mock the Colonel!\\nNo mercy!",
      "status": "imported"
    },
    "voice_190:r_edd7a13ab8f06a14": {
      "text": "You're unworthy of the Gundam name!",
      "status": "imported"
    },
    "voice_190:r_8165e5b41f0124c4": {
      "text": "Gundam once won by name\\nNo more!",
      "status": "imported"
    },
    "voice_190:r_4e05581b7432cce8": {
      "text": "Even the latest model looks pitiful!",
      "status": "imported"
    },
    "voice_190:r_a60b107ea3c36a86": {
      "text": "Is that all Londo Bell can do?!",
      "status": "imported"
    },
    "voice_190:r_e33693e5ba4665b0": {
      "text": "You're just Federation watchdogs!",
      "status": "imported"
    },
    "voice_190:r_72a21a1a489af001": {
      "text": "You're nothing but tame lapdogs now!",
      "status": "imported"
    },
    "voice_190:r_9b63cf1f3e0207ef": {
      "text": "You've gone soft, traitor!",
      "status": "imported"
    },
    "voice_190:r_1d6d784036ae0bd7": {
      "text": "Red Comet belongs to the Colonel!",
      "status": "imported"
    },
    "voice_190:r_625664af02183c17": {
      "text": "A hollow mock-up full of hot air!",
      "status": "imported"
    },
    "voice_190:r_3701cba361f80ea5": {
      "text": "All of you is so shallow...!",
      "status": "imported"
    },
    "voice_190:r_63f429c5c68c0863": {
      "text": "Mere civilians\\nCan't face the Guard!",
      "status": "imported"
    },
    "voice_190:r_4824bea6bab3af67": {
      "text": "Gah, it grazed me...!",
      "status": "imported"
    },
    "voice_190:r_862b92e63adb9734": {
      "text": "What a pathetic attack!",
      "status": "imported"
    },
    "voice_190:r_cb306ef55e49d107": {
      "text": "That's no threat at all!",
      "status": "imported"
    },
    "voice_190:r_57b2bd2de8a1408d": {
      "text": "Damn it! I couldn't dodge it!",
      "status": "imported"
    },
    "voice_190:r_76f080a4881e8ab5": {
      "text": "You dare mock the Guard...!",
      "status": "imported"
    },
    "voice_190:r_288133bc5b573dae": {
      "text": "You think that'll defeat the Guard?!",
      "status": "imported"
    },
    "voice_190:r_6f95653e548f8fcf": {
      "text": "I scarred the machine I was granted!",
      "status": "imported"
    },
    "voice_190:r_d249d68bada91ab9": {
      "text": "Next time I'll dodge, Angelo, sir!",
      "status": "imported"
    },
    "voice_190:r_e9b3307e9eb69f11": {
      "text": "I'm no match for the Colonel...!",
      "status": "imported"
    },
    "voice_190:r_03cdac73042343ee": {
      "text": "It only hit my shield!",
      "status": "imported"
    },
    "voice_190:r_6026da5acbda7c69": {
      "text": "That shield saved my life...!",
      "status": "imported"
    },
    "voice_190:r_981f8fedd5414fe5": {
      "text": "Hmph... You seem rather flustered",
      "status": "imported"
    },
    "voice_190:r_96bb0dcde0c8c44a": {
      "text": "That attack was painfully obvious",
      "status": "imported"
    },
    "voice_190:r_641550a2f54cb456": {
      "text": "I knew you'd try that",
      "status": "imported"
    },
    "voice_190:r_a0f2074af8debbfa": {
      "text": "A maneuver like that is easy!",
      "status": "imported"
    },
    "voice_190:r_b5f5a97ed82acb0b": {
      "text": "Don't underestimate the Guard!",
      "status": "imported"
    },
    "voice_190:r_d9cd2e4ded064396": {
      "text": "This is the Guard's true power!",
      "status": "imported"
    },
    "voice_190:r_99e6349431aaf23b": {
      "text": "I won't tarnish the Guard's name!",
      "status": "imported"
    },
    "voice_190:r_ec1081caf845f56a": {
      "text": "I did it, Captain Angelo!",
      "status": "imported"
    },
    "voice_190:r_2c5b7ee872c1ed7f": {
      "text": "Did you see that, Colonel Frontal!",
      "status": "imported"
    },
    "voice_190:r_fd910d714be70870": {
      "text": "That won't work!",
      "status": "imported"
    },
    "voice_190:r_9736f29b11344ec3": {
      "text": "Not while I have this barrier!",
      "status": "imported"
    },
    "voice_190:r_bece29562818acba": {
      "text": "The I-Field will repel it!",
      "status": "imported"
    },
    "voice_190:r_494b5da92ed24ecb": {
      "text": "What?! I can't counterattack!",
      "status": "imported"
    },
    "voice_190:r_a4a5a96f4bd58920": {
      "text": "My means to counter are sealed...!",
      "status": "imported"
    },
    "voice_190:r_b57d2d74233f889a": {
      "text": "Damn! What a disgrace to the Guard!",
      "status": "imported"
    },
    "voice_190:r_cd06d0820d82524b": {
      "text": "Their weapons outperform ours...!",
      "status": "imported"
    },
    "voice_190:r_c94c6d04be583774": {
      "text": "Our range...\\nThey saw through it?!",
      "status": "imported"
    },
    "voice_190:r_e54e2c99ef8297af": {
      "text": "Output is below specifications...!",
      "status": "imported"
    },
    "voice_190:r_f16a3eb0bcaac082": {
      "text": "I won't let them kill an ally!",
      "status": "imported"
    },
    "voice_190:r_10a408809e512df1": {
      "text": "Hurry! Move in to cover them!",
      "status": "imported"
    },
    "voice_190:r_bc7b9e308b879dd4": {
      "text": "The Guard must not lose anyone!",
      "status": "imported"
    },
    "voice_190:r_98902fd3143c393e": {
      "text": "Captain Angelo, you're in danger!",
      "status": "imported"
    },
    "voice_190:r_d907fbd7bc1c4298": {
      "text": "My life for the Colonel...!",
      "status": "imported"
    },
    "voice_190:r_96b21e3a028dd074": {
      "text": "I have to cover the Commander...!",
      "status": "imported"
    },
    "voice_190:r_ce140b5d8e6b7310": {
      "text": "Cleaning up Garencieres' mess...!",
      "status": "imported"
    },
    "voice_190:r_0e0335789c5396d7": {
      "text": "There you are!",
      "status": "imported"
    },
    "voice_190:r_a8e85bd950696403": {
      "text": "Out of my way!",
      "status": "imported"
    },
    "voice_190:r_772c8bc40ab6cb61": {
      "text": "Time for you to disappear!",
      "status": "imported"
    },
    "voice_190:r_58dd2826a199ef51": {
      "text": "I'll take you down right here!",
      "status": "imported"
    },
    "voice_190:r_aadc0b2442adb93b": {
      "text": "Anyone who stands in my way...!",
      "status": "imported"
    },
    "voice_190:r_e7a8cd8ed5bc2d1b": {
      "text": "Will be swiftly eliminated!",
      "status": "imported"
    },
    "voice_190:r_041dd920da4a7c17": {
      "text": "I'll bring you down at any cost!",
      "status": "imported"
    },
    "voice_190:r_c7f4280cde4605b3": {
      "text": "I'll make you regret this!",
      "status": "imported"
    },
    "voice_190:r_ec349c8ea9511a18": {
      "text": "Underestimate me, and you'll suffer!",
      "status": "imported"
    },
    "voice_190:r_33236ffa3ea95b68": {
      "text": "I see an opening!",
      "status": "imported"
    },
    "voice_190:r_689d0b123de71ae0": {
      "text": "Get out of my way!",
      "status": "imported"
    },
    "voice_190:r_84883aa95f63ce32": {
      "text": "Slowpokes should stay out of this!",
      "status": "imported"
    },
    "voice_190:r_25493e978ce8ff16": {
      "text": "Our name isn't just for show!",
      "status": "imported"
    },
    "voice_190:r_7316666150e42960": {
      "text": "Can you read this attack?!",
      "status": "imported"
    },
    "voice_190:r_c4f11aa93dc5b668": {
      "text": "The Guard's name is well earned!",
      "status": "imported"
    },
    "voice_190:r_b5864501463db244": {
      "text": "I'm firing!",
      "status": "imported"
    },
    "voice_190:r_a88939ea84b4474d": {
      "text": "I've got you in my sights!",
      "status": "imported"
    },
    "voice_190:r_a870d0cf7cc11ec6": {
      "text": "Target locked!",
      "status": "imported"
    },
    "voice_190:r_03f6158ef83964f3": {
      "text": "Strike at a single point!",
      "status": "imported"
    },
    "voice_190:r_2970a83693cdcc25": {
      "text": "I'm closing in!",
      "status": "imported"
    },
    "voice_190:r_be661448b85d0009": {
      "text": "I'll engage at close range!",
      "status": "imported"
    },
    "voice_190:r_958a56c1151cab9e": {
      "text": "Careless of you to come so close!",
      "status": "imported"
    },
    "voice_190:r_8b18aa4cc69547df": {
      "text": "Focus your attacks!",
      "status": "imported"
    },
    "voice_190:r_3e87f6fc3ea65aef": {
      "text": "Focus all fire on one target!",
      "status": "imported"
    },
    "voice_190:r_5508a7bfa9074eb9": {
      "text": "I'll assist from here!",
      "status": "imported"
    },
    "voice_190:r_09a003e91f0d5dc7": {
      "text": "At least I can hold them back!",
      "status": "imported"
    },
    "voice_190:r_192447448ebd7bb5": {
      "text": "Follow my lead!",
      "status": "imported"
    },
    "voice_190:r_e92920ba4b301b9f": {
      "text": "I can't fail here!",
      "status": "imported"
    },
    "voice_190:r_207b256d613bb896": {
      "text": "I'll show you I can do it!",
      "status": "imported"
    },
    "voice_190:r_a6fd676d8146501b": {
      "text": "I must fulfill my duty!",
      "status": "imported"
    },
    "voice_190:r_94d35e5fa8e3a198": {
      "text": "I'll finish you at once!",
      "status": "imported"
    },
    "voice_190:r_b686510e636673f3": {
      "text": "We'll take the enemies one by one!",
      "status": "imported"
    }
  }
}
