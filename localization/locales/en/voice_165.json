{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_165:r_479b340ccc6c572b": {
      "text": "All right, class is in session!",
      "status": "imported"
    },
    "voice_165:r_77949221bf58f862": {
      "text": "I've got my own reason to fight...!",
      "status": "imported"
    },
    "voice_165:r_70b9c4b9f1f37eff": {
      "text": "I'll do this for those kids, too...!",
      "status": "imported"
    },
    "voice_165:r_9fcb3754cb1773c7": {
      "text": "Risking it all,\\njust like he did...!",
      "status": "imported"
    },
    "voice_165:r_3559d2fad32c2435": {
      "text": "Makeup class starts now!",
      "status": "imported"
    },
    "voice_165:r_f7570547e9f80a64": {
      "text": "It's time you left, Faceless!",
      "status": "imported"
    },
    "voice_165:r_cbab0f4720e1fcf1": {
      "text": "No face, but acting\\nhigh and mighty!",
      "status": "imported"
    },
    "voice_165:r_0bbe0b4f5364e732": {
      "text": "Anti-Spiral...!\\nJust defeat it!",
      "status": "imported"
    },
    "voice_165:r_5dda5198137cb02a": {
      "text": "Crush its head to win!\\nFinish it!",
      "status": "imported"
    },
    "voice_165:r_83ec59afbecdec14": {
      "text": "This is your final lesson!",
      "status": "imported"
    },
    "voice_165:r_e20bfd42ad95a3c9": {
      "text": "Beat you,\\nthen home to the kids!",
      "status": "imported"
    },
    "voice_165:r_0f58a8822381e57f": {
      "text": "My marksmanship's sharp as ever!",
      "status": "imported"
    },
    "voice_165:r_6dbcc507fb61b51d": {
      "text": "Run all you want... I'll shoot you!",
      "status": "imported"
    },
    "voice_165:r_b42ab697149a7c8a": {
      "text": "Kids who run wild are much worse...!",
      "status": "imported"
    },
    "voice_165:r_4de4fcf3b440baf4": {
      "text": "Island life made brawling easy!",
      "status": "imported"
    },
    "voice_165:r_0121a166c715cdff": {
      "text": "This isn't exactly tough love!",
      "status": "imported"
    },
    "voice_165:r_30fad37a42bd3ad3": {
      "text": "If words won't work, then this will!",
      "status": "imported"
    },
    "voice_165:r_ac6fe7838e95647b": {
      "text": "Things aren't that simple in life!",
      "status": "imported"
    },
    "voice_165:r_77ca87eacd17ad52": {
      "text": "Naughty kids need to be punished!",
      "status": "imported"
    },
    "voice_165:r_bf3244994760e535": {
      "text": "I'll teach you to respect others!",
      "status": "imported"
    },
    "voice_165:r_aabfb21c9d069ce7": {
      "text": "I can reach you from here, too!",
      "status": "imported"
    },
    "voice_165:r_02479dc8fe989560": {
      "text": "Let me lend a hand!",
      "status": "imported"
    },
    "voice_165:r_a2df00f91a9b0a9e": {
      "text": "Support's where M Tank shines!",
      "status": "imported"
    },
    "voice_165:r_48b60d6c48b9b142": {
      "text": "I'm no Simon, but I've got this!",
      "status": "imported"
    },
    "voice_165:r_8927e6fb681aa809": {
      "text": "Simon and Viral are incredible!",
      "status": "imported"
    },
    "voice_165:r_665f01666859013b": {
      "text": "That's more like you, Kittan!",
      "status": "imported"
    },
    "voice_165:r_a571eec59b258d11": {
      "text": "Not yet, Gimmy! We'll train later!",
      "status": "imported"
    },
    "voice_165:r_ddbe581c5ea9183d": {
      "text": "Yeah! Looking good, Darry!",
      "status": "imported"
    },
    "voice_165:r_faae935cca0edc72": {
      "text": "Get behind me!",
      "status": "imported"
    },
    "voice_165:r_d4430bf362340b32": {
      "text": "M Tank can be your shield!",
      "status": "imported"
    },
    "voice_165:r_6ff1323b355593e0": {
      "text": "If we lose Simon,\\nit's all over...!",
      "status": "imported"
    },
    "voice_165:r_b7b5625d7cd4282f": {
      "text": "All of you! Shape up!",
      "status": "imported"
    },
    "voice_165:r_36133ad73a73ef98": {
      "text": "Still charging in blind, Kittan!",
      "status": "imported"
    },
    "voice_165:r_920740a0219c5085": {
      "text": "Don't die and leave them, Dayakka!",
      "status": "imported"
    },
    "voice_165:r_a8451712c57c1a72": {
      "text": "You've got tunnel vision, Gimmy!",
      "status": "imported"
    },
    "voice_165:r_3633df5b7b8f47fa": {
      "text": "Leave this to me, Darry!",
      "status": "imported"
    },
    "voice_165:r_52dfc56b14b93551": {
      "text": "I can't deal with you right now...!",
      "status": "imported"
    },
    "voice_165:r_1b9b2aab5cb104da": {
      "text": "Our timing's\\na little off...!",
      "status": "imported"
    },
    "voice_165:r_342044c706a2340f": {
      "text": "Looks like I got carried away...!",
      "status": "imported"
    },
    "voice_165:r_cf41e8828a90cbdb": {
      "text": "That range... Am I rusty now...!",
      "status": "imported"
    },
    "voice_165:r_719e897304ec42d4": {
      "text": "That position...\\nYou studied well!",
      "status": "imported"
    },
    "voice_165:r_d5e0a2317c40d322": {
      "text": "Too bad! You'll have to resubmit!",
      "status": "imported"
    },
    "voice_165:r_ec2ea17765052401": {
      "text": "Wrong! Next time, stand in the hall!",
      "status": "imported"
    },
    "voice_165:r_f2d4255f1c2f7542": {
      "text": "Attack carelessly and this happens!",
      "status": "imported"
    },
    "voice_165:r_5d08ad19e2da125b": {
      "text": "Too slow...! Go train and come back!",
      "status": "imported"
    },
    "voice_165:r_a7246b52782a877e": {
      "text": "For your own good, stop this now!",
      "status": "imported"
    },
    "voice_165:r_d6bdd730f24f66eb": {
      "text": "So frail. Are you eating enough?",
      "status": "imported"
    },
    "voice_165:r_41997412868c48c4": {
      "text": "Whoa! That actually hit me!",
      "status": "imported"
    },
    "voice_165:r_9e6cf4f389dae55c": {
      "text": "My Gunmen is\\nbuilt tough, of course!",
      "status": "imported"
    },
    "voice_165:r_9e0c80ac7e33b459": {
      "text": "Surely that's not your full power!",
      "status": "imported"
    },
    "voice_165:r_7432ef43ed3471dc": {
      "text": "Ow...! I banged my chest...!",
      "status": "imported"
    },
    "voice_165:r_065443f6ddfcf0d7": {
      "text": "Not bad...!\\nI need to focus, too...!",
      "status": "imported"
    },
    "voice_165:r_47d52a2839c71715": {
      "text": "With that power,\\nuse it for good!",
      "status": "imported"
    },
    "voice_165:r_847f82e7f3eef651": {
      "text": "Not yet!\\nI have a teacher's pride!",
      "status": "imported"
    },
    "voice_165:r_eb7ae28b53dc033c": {
      "text": "It can't end here!\\nIt just can't...!",
      "status": "imported"
    },
    "voice_165:r_857c4a52ce8df0fd": {
      "text": "Direct hit!?\\nIf I can fire, I fight!",
      "status": "imported"
    },
    "voice_165:r_55417493fce1d347": {
      "text": "Promised the kids.\\nMust keep it...!",
      "status": "imported"
    },
    "voice_165:r_8fdf5910927c9591": {
      "text": "Sorry, Kamina.\\nMay see you soon...",
      "status": "imported"
    },
    "voice_165:r_7d724dbcc4451e10": {
      "text": "No...! I'm sorry, everyone...!",
      "status": "imported"
    },
    "voice_165:r_93e25418a203cb8f": {
      "text": "No...! The machine's giving out!",
      "status": "imported"
    },
    "voice_165:r_adeb0a29274d3d9b": {
      "text": "It'll be on the test. Remember it!",
      "status": "imported"
    },
    "voice_165:r_24cf161287ef9d5c": {
      "text": "...That's a failing grade.",
      "status": "imported"
    },
    "voice_165:r_8f60f6fc86db3107": {
      "text": "You must want private tutoring!",
      "status": "imported"
    },
    "voice_165:r_b1de76a75a253c13": {
      "text": "Now I'll teach you every step!",
      "status": "imported"
    },
    "voice_165:r_38fdff9483e9245c": {
      "text": "Don't get too full of yourself!",
      "status": "imported"
    },
    "voice_165:r_620fedec67706d7d": {
      "text": "It's punishment, so no getting away!",
      "status": "imported"
    },
    "voice_165:r_9680dcd0fddcfcc7": {
      "text": "That's Littner Village's Dayakka!",
      "status": "imported"
    },
    "voice_165:r_2a00f1044ad5cbaa": {
      "text": "One more shot! I can do this!",
      "status": "imported"
    },
    "voice_165:r_3dbeead1bd3164ef": {
      "text": "Already over!?\\nI'm still alive!!",
      "status": "imported"
    },
    "voice_165:r_98d15b8cc09bc915": {
      "text": "For Team Dai-Gurren!\\nI won't fall!!",
      "status": "imported"
    },
    "voice_165:r_46e86d000250e137": {
      "text": "Eek! You've got some skill...!",
      "status": "imported"
    },
    "voice_165:r_ac341e7976e88f0b": {
      "text": "I do my best work in a pinch!",
      "status": "imported"
    },
    "voice_165:r_cdbd128a5b4127cc": {
      "text": "What an adorable little prank!",
      "status": "imported"
    },
    "voice_165:r_cfccaa1fbeda124c": {
      "text": "I wouldn't aim there myself!",
      "status": "imported"
    },
    "voice_165:r_b1f8ec192b9c083a": {
      "text": "All right, you fail! Try harder!",
      "status": "imported"
    },
    "voice_165:r_a007f9ab9cf048b3": {
      "text": "No way I'll let that attack hit me!",
      "status": "imported"
    },
    "voice_165:r_ddafde4b065ced49": {
      "text": "Whoa! The barrier saved me!",
      "status": "imported"
    },
    "voice_165:r_de1213040856c089": {
      "text": "All our specs\\ndwarf what we had!",
      "status": "imported"
    },
    "voice_165:r_3304412ac41f47a6": {
      "text": "Sorry, I'm not into freak shows!",
      "status": "imported"
    },
    "voice_165:r_13c25fbdfddc8a24": {
      "text": "We'll finish with a bang!!",
      "status": "imported"
    },
    "voice_165:r_42ba1ecb310b4bd7": {
      "text": "Goooooooo!!",
      "status": "imported"
    },
    "voice_165:r_d692f1d420460a47": {
      "text": "I'll cut off your escape route!",
      "status": "imported"
    },
    "voice_165:r_a5643cec86b18bd2": {
      "text": "You need to learn teamwork!",
      "status": "imported"
    },
    "voice_165:r_68f2dfab20a4a30e": {
      "text": "I'm your homeroom teacher!",
      "status": "imported"
    },
    "voice_165:r_9cedad8237480563": {
      "text": "Now, aim carefully!",
      "status": "imported"
    }
  }
}
