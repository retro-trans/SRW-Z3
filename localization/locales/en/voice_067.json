{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_067:r_479b340ccc6c572b": {
      "text": "There you are!",
      "status": "imported"
    },
    "voice_067:r_ca4acbac57a2a35e": {
      "text": "Commence attack!",
      "status": "imported"
    },
    "voice_067:r_77949221bf58f862": {
      "text": "All right, here I go!",
      "status": "imported"
    },
    "voice_067:r_70b9c4b9f1f37eff": {
      "text": "I'll take you on!",
      "status": "imported"
    },
    "voice_067:r_9fcb3754cb1773c7": {
      "text": "All we can do is attack!",
      "status": "imported"
    },
    "voice_067:r_3559d2fad32c2435": {
      "text": "Don't think you can stop me!",
      "status": "imported"
    },
    "voice_067:r_f7570547e9f80a64": {
      "text": "Now, prepare yourself!",
      "status": "imported"
    },
    "voice_067:r_cbab0f4720e1fcf1": {
      "text": "Let's see what you're capable of!",
      "status": "imported"
    },
    "voice_067:r_0bbe0b4f5364e732": {
      "text": "I'll settle this!",
      "status": "imported"
    },
    "voice_067:r_5dda5198137cb02a": {
      "text": "This is as far as you go!",
      "status": "imported"
    },
    "voice_067:r_83ec59afbecdec14": {
      "text": "I'll sweep you aside!",
      "status": "imported"
    },
    "voice_067:r_e20bfd42ad95a3c9": {
      "text": "Witness my power!",
      "status": "imported"
    },
    "voice_067:r_0f58a8822381e57f": {
      "text": "All hands, prepare to attack!",
      "status": "imported"
    },
    "voice_067:r_6dbcc507fb61b51d": {
      "text": "Attack! Show them no mercy!",
      "status": "imported"
    },
    "voice_067:r_b42ab697149a7c8a": {
      "text": "In my name, I order you: attack!",
      "status": "imported"
    },
    "voice_067:r_4de4fcf3b440baf4": {
      "text": "Crush all who dare defy us!",
      "status": "imported"
    },
    "voice_067:r_0121a166c715cdff": {
      "text": "We must win! That is our mission!",
      "status": "imported"
    },
    "voice_067:r_30fad37a42bd3ad3": {
      "text": "This will be your grave!",
      "status": "imported"
    },
    "voice_067:r_80a0b2a84e05d81a": {
      "text": "I'll live up to your hopes, Father!",
      "status": "imported"
    },
    "voice_067:r_4a9ac1dff86506d9": {
      "text": "Gura King Jr.\\nis your opponent!",
      "status": "imported"
    },
    "voice_067:r_bc8538e6af3d2577": {
      "text": "You're still standing?!",
      "status": "imported"
    },
    "voice_067:r_924516c8de2b5342": {
      "text": "This time, I'll finish you!",
      "status": "imported"
    },
    "voice_067:r_da1174533722333f": {
      "text": "Prepare yourself, Shotaro!",
      "status": "imported"
    },
    "voice_067:r_fdeb8162976e72c1": {
      "text": "Let's settle this, Tetsujin!",
      "status": "imported"
    },
    "voice_067:r_0fadb5c26df92b42": {
      "text": "I'll knock Ox out of the sky!",
      "status": "imported"
    },
    "voice_067:r_6b15af9a0057cdc8": {
      "text": "Mars! So you'd stand in my way!",
      "status": "imported"
    },
    "voice_067:r_15b4a90140e8a33a": {
      "text": "Show me the power of Godmars!",
      "status": "imported"
    },
    "voice_067:r_af884a6b11dff121": {
      "text": "This machine... Forbidden power!",
      "status": "imported"
    },
    "voice_067:r_ac6fe7838e95647b": {
      "text": "Your demon god's power is useless!",
      "status": "imported"
    },
    "voice_067:r_77ca87eacd17ad52": {
      "text": "Apostle of Getter Rays, prepare!",
      "status": "imported"
    },
    "voice_067:r_bf3244994760e535": {
      "text": "Beasts submit only to force!",
      "status": "imported"
    },
    "voice_067:r_aabfb21c9d069ce7": {
      "text": "Your spiral leads only to despair!",
      "status": "imported"
    },
    "voice_067:r_02479dc8fe989560": {
      "text": "Mecha Angel! Perish here!",
      "status": "imported"
    },
    "voice_067:r_a2df00f91a9b0a9e": {
      "text": "Watta Takeo! You'll oppose me too?!",
      "status": "imported"
    },
    "voice_067:r_48b60d6c48b9b142": {
      "text": "Earthlings! You will evolve no more!",
      "status": "imported"
    },
    "voice_067:r_8927e6fb681aa809": {
      "text": "Love...\\nDarkness devours all!",
      "status": "imported"
    },
    "voice_067:r_ddbe581c5ea9183d": {
      "text": "Life itself\\nBlack Hole devours all!",
      "status": "imported"
    },
    "voice_067:r_d4430bf362340b32": {
      "text": "Clear the way, Demon General!",
      "status": "imported"
    },
    "voice_067:r_6ff1323b355593e0": {
      "text": "You lot!\\nDon't stand in my way!",
      "status": "imported"
    },
    "voice_067:r_b7b5625d7cd4282f": {
      "text": "Father! I swear I'll stop you!",
      "status": "imported"
    },
    "voice_067:r_36133ad73a73ef98": {
      "text": "Father! I will walk my chosen path!",
      "status": "imported"
    },
    "voice_067:r_cdbd128a5b4127cc": {
      "text": "Small Saucer, launch!",
      "status": "imported"
    },
    "voice_067:r_cfccaa1fbeda124c": {
      "text": "Deploy the attack saucers!",
      "status": "imported"
    },
    "voice_067:r_b1f8ec192b9c083a": {
      "text": "Attack saucer squadron, go!",
      "status": "imported"
    },
    "voice_067:r_a007f9ab9cf048b3": {
      "text": "Face Space Robo's attack!",
      "status": "imported"
    },
    "voice_067:r_ddafde4b065ced49": {
      "text": "Space Robo will crush you!",
      "status": "imported"
    },
    "voice_067:r_de1213040856c089": {
      "text": "Space Robo, full power!",
      "status": "imported"
    },
    "voice_067:r_3304412ac41f47a6": {
      "text": "Become rust upon my blade!",
      "status": "imported"
    },
    "voice_067:r_0c0775e051211840": {
      "text": "I'll cleave you clean in two!",
      "status": "imported"
    },
    "voice_067:r_a2afffe1c396f0b3": {
      "text": "Witness my swordsmanship!",
      "status": "imported"
    },
    "voice_067:r_13c25fbdfddc8a24": {
      "text": "Now, it's my turn to attack.",
      "status": "imported"
    },
    "voice_067:r_42ba1ecb310b4bd7": {
      "text": "You'll come to regret your deeds.",
      "status": "imported"
    },
    "voice_067:r_d692f1d420460a47": {
      "text": "You won't escape...!",
      "status": "imported"
    },
    "voice_067:r_a5643cec86b18bd2": {
      "text": "Regret your own foolishness!",
      "status": "imported"
    },
    "voice_067:r_68f2dfab20a4a30e": {
      "text": "No mercy if you bare your fangs!",
      "status": "imported"
    },
    "voice_067:r_9cedad8237480563": {
      "text": "Now you'll face my attack!",
      "status": "imported"
    },
    "voice_067:r_a03fabecba1508ca": {
      "text": "I'll repay every blow in full!",
      "status": "imported"
    },
    "voice_067:r_5391b24a71eb10ae": {
      "text": "You think\\nyou can escape from me?!",
      "status": "imported"
    },
    "voice_067:r_a554ceef5c87b972": {
      "text": "I won't let up my attack!",
      "status": "imported"
    },
    "voice_067:r_546c3d5937fbb7ee": {
      "text": "I'll take the front next!",
      "status": "imported"
    },
    "voice_067:r_1568ff6298b12b96": {
      "text": "You're going soft, Duncan!",
      "status": "imported"
    },
    "voice_067:r_2c9d94ba13c5fc50": {
      "text": "Now that's the Demon General!",
      "status": "imported"
    },
    "voice_067:r_a77f4913375098d2": {
      "text": "Leave the rest to me, Shotaro!",
      "status": "imported"
    },
    "voice_067:r_428c2116ac3071b1": {
      "text": "That's it! Keep it up, Ox!",
      "status": "imported"
    },
    "voice_067:r_84c116267b79f540": {
      "text": "Let me give you a hand, Mars!",
      "status": "imported"
    },
    "voice_067:r_dad38ee29af2df3a": {
      "text": "Sloppy finish, Watta!",
      "status": "imported"
    },
    "voice_067:r_3d32e86f8dc80909": {
      "text": "Shotaro! Pull Tetsujin back!",
      "status": "imported"
    },
    "voice_067:r_70451ffbabe2f876": {
      "text": "I won't let them hurt Ox...!",
      "status": "imported"
    },
    "voice_067:r_69dfa1659715e2fa": {
      "text": "Get a hold of yourself, Mars!",
      "status": "imported"
    },
    "voice_067:r_d996fd6d4ef5b329": {
      "text": "Stay back, Watta!",
      "status": "imported"
    },
    "voice_067:r_8ab47a28f99ef565": {
      "text": "I won't allow needless losses!",
      "status": "imported"
    },
    "voice_067:r_546de3fb6db156ea": {
      "text": "Leave this to me and fall back!",
      "status": "imported"
    },
    "voice_067:r_ca85f87cee5e31f7": {
      "text": "What are you doing, Duncan?!",
      "status": "imported"
    },
    "voice_067:r_9072ea7bc71df136": {
      "text": "What's wrong? Some Demon General!",
      "status": "imported"
    },
    "voice_067:r_04e815a8d425827d": {
      "text": "Disgraceful...! I failed to counter!",
      "status": "imported"
    },
    "voice_067:r_d89011fe3e5d082a": {
      "text": "I'll spare your life for now!",
      "status": "imported"
    },
    "voice_067:r_3c5b0c2ac812d5de": {
      "text": "Coward! Face me fair and square!",
      "status": "imported"
    },
    "voice_067:r_5b9e8897190892eb": {
      "text": "Impressive positioning, I'll admit!",
      "status": "imported"
    },
    "voice_067:r_7bea3023abbf8a94": {
      "text": "Gah! Why won't it move?!",
      "status": "imported"
    },
    "voice_067:r_dd01a4c0d1b36a8d": {
      "text": "This is child's play.",
      "status": "imported"
    },
    "voice_067:r_20920ad2eb3542db": {
      "text": "Fool... Was that a surprise attack?",
      "status": "imported"
    },
    "voice_067:r_0ab7914877fd48ed": {
      "text": "Where are you looking? Here I am.",
      "status": "imported"
    },
    "voice_067:r_cb846feec748c2e3": {
      "text": "You think you can touch me?!",
      "status": "imported"
    },
    "voice_067:r_c958860b0676b1f5": {
      "text": "Aim more carefully! Ha ha ha ha ha!",
      "status": "imported"
    },
    "voice_067:r_5e2669b82ef75ce3": {
      "text": "You could never hope to hit me!",
      "status": "imported"
    },
    "voice_067:r_7847e0ed7dc9282d": {
      "text": "Give up already, Shotaro!",
      "status": "imported"
    },
    "voice_067:r_e42b52c7a987b906": {
      "text": "Ha ha ha ha...! Tetsujin, what now?!",
      "status": "imported"
    },
    "voice_067:r_6825fd1ff907bd22": {
      "text": "Is that all, Black Ox?!",
      "status": "imported"
    },
    "voice_067:r_607f666f1563bc0d": {
      "text": "Mars!\\nIs that your psychic power?!",
      "status": "imported"
    },
    "voice_067:r_97b7431eeb81e6b6": {
      "text": "Please stop this, Father!",
      "status": "imported"
    },
    "voice_067:r_aba6a7662129d8ce": {
      "text": "Ha ha ha ha! What a waste!",
      "status": "imported"
    },
    "voice_067:r_b84afafb8a33ec60": {
      "text": "That attack\\nbreak my barrier? As if!",
      "status": "imported"
    },
    "voice_067:r_391aa56435d9dd6e": {
      "text": "What was that supposed to be?",
      "status": "imported"
    },
    "voice_067:r_7c796ba53bd7ea03": {
      "text": "Pathetic. You're not worth my time.",
      "status": "imported"
    },
    "voice_067:r_fa944da4b6519006": {
      "text": "Hmph! That was trivial.",
      "status": "imported"
    },
    "voice_067:r_95d047bcc17fccc6": {
      "text": "Try not to bore me too much.",
      "status": "imported"
    },
    "voice_067:r_640327a12a559b31": {
      "text": "No matter how often that hits me!",
      "status": "imported"
    },
    "voice_067:r_bdd38c584fa313d0": {
      "text": "That hardly counts as a scratch!",
      "status": "imported"
    },
    "voice_067:r_3fd86c1027f317c8": {
      "text": "Tch! You dare wound me?!",
      "status": "imported"
    },
    "voice_067:r_d0372a183d2007ad": {
      "text": "Back off! I have no time for you!",
      "status": "imported"
    },
    "voice_067:r_217aa5e1d545b44d": {
      "text": "Defeat Gura King Jr.\\nwith that?!",
      "status": "imported"
    },
    "voice_067:r_381992c5d8224937": {
      "text": "Ha ha ha ha ha!\\nThat's all?!",
      "status": "imported"
    },
    "voice_067:r_f1e7ed9e5874aba5": {
      "text": "Oh... You have some skill after all.",
      "status": "imported"
    },
    "voice_067:r_fc25e66a86fc2c85": {
      "text": "Interesting. This may be fun.",
      "status": "imported"
    },
    "voice_067:r_5aeeb4917340c42d": {
      "text": "Damn you! Persistent pest!",
      "status": "imported"
    },
    "voice_067:r_b765659981b6516d": {
      "text": "That won't be enough to faze me!",
      "status": "imported"
    },
    "voice_067:r_0c427458bc00eb95": {
      "text": "Hmph! You want me to get serious?!",
      "status": "imported"
    },
    "voice_067:r_774a9ab4d8fd5351": {
      "text": "Don't get cocky over a lucky hit!",
      "status": "imported"
    },
    "voice_067:r_d3f01de714c015bd": {
      "text": "Enjoy your triumph while it lasts!",
      "status": "imported"
    },
    "voice_067:r_7d2617c809fead70": {
      "text": "You have the strength\\nto face me!",
      "status": "imported"
    },
    "voice_067:r_ceb935ccbf830724": {
      "text": "Gah! How dare you, Shotaro!",
      "status": "imported"
    },
    "voice_067:r_862ef7385bf2abd4": {
      "text": "Mighty Tetsujin...! This is bad...!",
      "status": "imported"
    },
    "voice_067:r_001cbec4d9a4283f": {
      "text": "Damn you! You wretched Ox!",
      "status": "imported"
    },
    "voice_067:r_8ad40afecd02b41e": {
      "text": "Guh! This is Mars's psychic power?!",
      "status": "imported"
    },
    "voice_067:r_26e5efec03c03d78": {
      "text": "You got me, Watta Takeo!",
      "status": "imported"
    },
    "voice_067:r_4ad81e88c7557a8b": {
      "text": "That demon god's power... Fearsome!",
      "status": "imported"
    },
    "voice_067:r_1f65a7af190e4674": {
      "text": "Damn you, apostle of Getter Rays!",
      "status": "imported"
    },
    "voice_067:r_40c5a9358ed5bf29": {
      "text": "Power of ruin... Spiral Power!",
      "status": "imported"
    },
    "voice_067:r_f2e18dfdfe0c89ea": {
      "text": "I am\\nbested by primal power...?!",
      "status": "imported"
    },
    "voice_067:r_cf7dbf49e96a5755": {
      "text": "Mecha Angel's power\\nbottomless...?!",
      "status": "imported"
    },
    "voice_067:r_fa96676cc65bb509": {
      "text": "The Sphere's power...! Their power?!",
      "status": "imported"
    },
    "voice_067:r_4e37f92e7d2fc62e": {
      "text": "Earthling! You pursue evolution?!",
      "status": "imported"
    },
    "voice_067:r_0bad405ee6ca63ba": {
      "text": "Life's power...!\\nIt repels darkness!",
      "status": "imported"
    },
    "voice_067:r_2072eaf71a260ae7": {
      "text": "Impossible!\\nLove has such power?!",
      "status": "imported"
    },
    "voice_067:r_b28faf9f71bc3598": {
      "text": "Father's full power...?! What might!",
      "status": "imported"
    },
    "voice_067:r_8a29278549f8e07a": {
      "text": "I... won't... lose to darkness!",
      "status": "imported"
    },
    "voice_067:r_862b92e63adb9734": {
      "text": "Aah! I-I messed up!",
      "status": "imported"
    },
    "voice_067:r_cb306ef55e49d107": {
      "text": "Guhhh! Curse you!",
      "status": "imported"
    },
    "voice_067:r_57b2bd2de8a1408d": {
      "text": "No more disgracing myself...!",
      "status": "imported"
    },
    "voice_067:r_76f080a4881e8ab5": {
      "text": "I won't crawl home in disgrace!",
      "status": "imported"
    },
    "voice_067:r_288133bc5b573dae": {
      "text": "Very well!\\nWitness my full power!",
      "status": "imported"
    },
    "voice_067:r_6f95653e548f8fcf": {
      "text": "Guh!\\nI must never retreat...!",
      "status": "imported"
    },
    "voice_067:r_d249d68bada91ab9": {
      "text": "Their power...\\nbeyond my guess...?!",
      "status": "imported"
    },
    "voice_067:r_e9b3307e9eb69f11": {
      "text": "Not yet!\\nI won't retreat till I win!",
      "status": "imported"
    },
    "voice_067:r_03cdac73042343ee": {
      "text": "How dare you\\nharm Gura King Jr.?!",
      "status": "imported"
    },
    "voice_067:r_6026da5acbda7c69": {
      "text": "I'm Earth's prince! Is that all?!",
      "status": "imported"
    },
    "voice_067:r_981f8fedd5414fe5": {
      "text": "No! How disgraceful of me...!",
      "status": "imported"
    },
    "voice_067:r_96bb0dcde0c8c44a": {
      "text": "Evacuate! Detach the capsule!",
      "status": "imported"
    },
    "voice_067:r_641550a2f54cb456": {
      "text": "Tetsujin! Shotaro! This is yours!",
      "status": "imported"
    },
    "voice_067:r_a0f2074af8debbfa": {
      "text": "Wait, Father! I'll keep playing!",
      "status": "imported"
    },
    "voice_067:r_b5f5a97ed82acb0b": {
      "text": "I'll clear it! Let me keep going!",
      "status": "imported"
    },
    "voice_067:r_d9cd2e4ded064396": {
      "text": "Fine. Rest, Earthling. We meet again",
      "status": "imported"
    },
    "voice_067:r_99e6349431aaf23b": {
      "text": "What is this game...?",
      "status": "imported"
    },
    "voice_067:r_ec1081caf845f56a": {
      "text": "Earth games don't interest me.",
      "status": "imported"
    },
    "voice_067:r_2c5b7ee872c1ed7f": {
      "text": "I'll make the first move!",
      "status": "imported"
    },
    "voice_067:r_76d1e51c8b494a60": {
      "text": "I'll concentrate our attacks!",
      "status": "imported"
    },
    "voice_067:r_eb5f687fcd372ae7": {
      "text": "Don't think this is mere stalling!",
      "status": "imported"
    },
    "voice_067:r_2329428a6871d9fa": {
      "text": "It's a focused assault! Give up!",
      "status": "imported"
    },
    "voice_067:r_0e7466971bec4cc4": {
      "text": "One-on-one? Gladly!",
      "status": "imported"
    },
    "voice_067:r_efa71f7a4cc33ff3": {
      "text": "No need to interfere here!",
      "status": "imported"
    },
    "voice_067:r_3fc2e1186557e7a0": {
      "text": "I will fulfill my own duty!",
      "status": "imported"
    },
    "voice_067:r_fa6930340a545054": {
      "text": "Leave this to me!",
      "status": "imported"
    }
  }
}
