{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_201:r_479b340ccc6c572b": {
      "text": "There!",
      "status": "imported"
    },
    "voice_201:r_ca4acbac57a2a35e": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_201:r_77949221bf58f862": {
      "text": "All right, now!",
      "status": "imported"
    },
    "voice_201:r_70b9c4b9f1f37eff": {
      "text": "I won't show mercy!",
      "status": "imported"
    },
    "voice_201:r_9fcb3754cb1773c7": {
      "text": "You're mine!",
      "status": "imported"
    },
    "voice_201:r_3559d2fad32c2435": {
      "text": "Hope you're ready!",
      "status": "imported"
    },
    "voice_201:r_f7570547e9f80a64": {
      "text": "We won't be stopped!",
      "status": "imported"
    },
    "voice_201:r_cbab0f4720e1fcf1": {
      "text": "Kneel before my power!",
      "status": "imported"
    },
    "voice_201:r_0bbe0b4f5364e732": {
      "text": "You go no further!",
      "status": "imported"
    },
    "voice_201:r_5dda5198137cb02a": {
      "text": "Those who oppose us are evil!",
      "status": "imported"
    },
    "voice_201:r_83ec59afbecdec14": {
      "text": "We will change the world!",
      "status": "imported"
    },
    "voice_201:r_e20bfd42ad95a3c9": {
      "text": "For our noble ideal!",
      "status": "imported"
    },
    "voice_201:r_0f58a8822381e57f": {
      "text": "Reform demands sacrifice!",
      "status": "imported"
    },
    "voice_201:r_6dbcc507fb61b51d": {
      "text": "Now! Fire!",
      "status": "imported"
    },
    "voice_201:r_b42ab697149a7c8a": {
      "text": "I'll make this hit!",
      "status": "imported"
    },
    "voice_201:r_4de4fcf3b440baf4": {
      "text": "Take aim and fire!",
      "status": "imported"
    },
    "voice_201:r_0121a166c715cdff": {
      "text": "Bring them into close combat!",
      "status": "imported"
    },
    "voice_201:r_30fad37a42bd3ad3": {
      "text": "Charge!!",
      "status": "imported"
    },
    "voice_201:r_80a0b2a84e05d81a": {
      "text": "Get out of my way!",
      "status": "imported"
    },
    "voice_201:r_4a9ac1dff86506d9": {
      "text": "Hyaaaah!",
      "status": "imported"
    },
    "voice_201:r_bc8538e6af3d2577": {
      "text": "I'll hit you with one more blow!",
      "status": "imported"
    },
    "voice_201:r_924516c8de2b5342": {
      "text": "Gundam! You dare stand in our way!",
      "status": "imported"
    },
    "voice_201:r_da1174533722333f": {
      "text": "You came sniffing after war!",
      "status": "imported"
    },
    "voice_201:r_fdeb8162976e72c1": {
      "text": "Dancouga! You showed up here too!",
      "status": "imported"
    },
    "voice_201:r_0fadb5c26df92b42": {
      "text": "Civilians don't belong in battle!",
      "status": "imported"
    },
    "voice_201:r_15b4a90140e8a33a": {
      "text": "Sink the flagship, and we win!",
      "status": "imported"
    },
    "voice_201:r_af884a6b11dff121": {
      "text": "A direct hit beats any heavy armor!",
      "status": "imported"
    },
    "voice_201:r_ac6fe7838e95647b": {
      "text": "We'll overpower you!",
      "status": "imported"
    },
    "voice_201:r_77ca87eacd17ad52": {
      "text": "I won't let you escape!",
      "status": "imported"
    },
    "voice_201:r_bf3244994760e535": {
      "text": "Don't move!",
      "status": "imported"
    },
    "voice_201:r_aabfb21c9d069ce7": {
      "text": "You won't get away!",
      "status": "imported"
    },
    "voice_201:r_02479dc8fe989560": {
      "text": "Together, we strike!",
      "status": "imported"
    },
    "voice_201:r_a2df00f91a9b0a9e": {
      "text": "I'll follow up with an attack!",
      "status": "imported"
    },
    "voice_201:r_48b60d6c48b9b142": {
      "text": "We'll hold them here!",
      "status": "imported"
    },
    "voice_201:r_8927e6fb681aa809": {
      "text": "Damn, can't I do anything?!",
      "status": "imported"
    },
    "voice_201:r_665f01666859013b": {
      "text": "Damn it, I can't counterattack!",
      "status": "imported"
    },
    "voice_201:r_a571eec59b258d11": {
      "text": "A-at this rate, they'll crush me!",
      "status": "imported"
    },
    "voice_201:r_ddbe581c5ea9183d": {
      "text": "Damn it, where did they go?!",
      "status": "imported"
    },
    "voice_201:r_faae935cca0edc72": {
      "text": "Damn, I lost them!",
      "status": "imported"
    },
    "voice_201:r_d4430bf362340b32": {
      "text": "Tch! They moved to a tricky spot!",
      "status": "imported"
    },
    "voice_201:r_6ff1323b355593e0": {
      "text": "You think that'll hit me?!",
      "status": "imported"
    },
    "voice_201:r_b7b5625d7cd4282f": {
      "text": "Your aim is sloppy!",
      "status": "imported"
    },
    "voice_201:r_36133ad73a73ef98": {
      "text": "Your moves are too predictable!",
      "status": "imported"
    },
    "voice_201:r_920740a0219c5085": {
      "text": "An attack that misses is worthless!",
      "status": "imported"
    },
    "voice_201:r_a8451712c57c1a72": {
      "text": "Our power will change the world!",
      "status": "imported"
    },
    "voice_201:r_3633df5b7b8f47fa": {
      "text": "You cannot bend our will!",
      "status": "imported"
    },
    "voice_201:r_52dfc56b14b93551": {
      "text": "The weak cannot preach justice!",
      "status": "imported"
    },
    "voice_201:r_1b9b2aab5cb104da": {
      "text": "So this is all a Gundam can do!",
      "status": "imported"
    },
    "voice_201:r_342044c706a2340f": {
      "text": "You're too soft, Dancouga!",
      "status": "imported"
    },
    "voice_201:r_cf41e8828a90cbdb": {
      "text": "That won't work on me!",
      "status": "imported"
    },
    "voice_201:r_d5e0a2317c40d322": {
      "text": "I have a shield!",
      "status": "imported"
    },
    "voice_201:r_ec2ea17765052401": {
      "text": "It seems I overestimated them.",
      "status": "imported"
    },
    "voice_201:r_f2d4255f1c2f7542": {
      "text": "I can't let a scratch bother me!",
      "status": "imported"
    },
    "voice_201:r_5d08ad19e2da125b": {
      "text": "Hmph, it isn't fatal.",
      "status": "imported"
    },
    "voice_201:r_a7246b52782a877e": {
      "text": "You're hardly worth my time!",
      "status": "imported"
    },
    "voice_201:r_dc8701f6bcb9904f": {
      "text": "How feeble! Your will and power!",
      "status": "imported"
    },
    "voice_201:r_d6bdd730f24f66eb": {
      "text": "That can't shatter\\nour justice!",
      "status": "imported"
    },
    "voice_201:r_41997412868c48c4": {
      "text": "You can't decide the world's fate!",
      "status": "imported"
    },
    "voice_201:r_9e6cf4f389dae55c": {
      "text": "Even Gundam isn't so impressive!",
      "status": "imported"
    },
    "voice_201:r_9e0c80ac7e33b459": {
      "text": "Hmph! What of Dancouga?!",
      "status": "imported"
    },
    "voice_201:r_7432ef43ed3471dc": {
      "text": "Tch! You're no pushover!",
      "status": "imported"
    },
    "voice_201:r_065443f6ddfcf0d7": {
      "text": "Damn! I let my guard down!",
      "status": "imported"
    },
    "voice_201:r_47d52a2839c71715": {
      "text": "Ugh! What is this?!",
      "status": "imported"
    },
    "voice_201:r_847f82e7f3eef651": {
      "text": "I was prepared for this much!",
      "status": "imported"
    },
    "voice_201:r_eb7ae28b53dc033c": {
      "text": "You have some skill after all!",
      "status": "imported"
    },
    "voice_201:r_857c4a52ce8df0fd": {
      "text": "Guh! Brute force won't work!",
      "status": "imported"
    },
    "voice_201:r_55417493fce1d347": {
      "text": "Guh! This won't\\nshake our resolve!",
      "status": "imported"
    },
    "voice_201:r_8fdf5910927c9591": {
      "text": "Why not use that power for reform?!",
      "status": "imported"
    },
    "voice_201:r_7d724dbcc4451e10": {
      "text": "D-damn you, Gundam!",
      "status": "imported"
    },
    "voice_201:r_93e25418a203cb8f": {
      "text": "I-is this Dancouga's power?!",
      "status": "imported"
    },
    "voice_201:r_adeb0a29274d3d9b": {
      "text": "Such incredible power!",
      "status": "imported"
    },
    "voice_201:r_24cf161287ef9d5c": {
      "text": "This is bad! I can't take any more!",
      "status": "imported"
    },
    "voice_201:r_8f60f6fc86db3107": {
      "text": "W-what in the world did they do?!",
      "status": "imported"
    },
    "voice_201:r_b1de76a75a253c13": {
      "text": "I won't be overwhelmed like this!",
      "status": "imported"
    },
    "voice_201:r_128c35bf3e0e394c": {
      "text": "M-my spirit isn't broken yet!!",
      "status": "imported"
    },
    "voice_201:r_5213c17e13b23de0": {
      "text": "There must be a way to turn this!",
      "status": "imported"
    },
    "voice_201:r_38fdff9483e9245c": {
      "text": "N-no one can stop\\nour struggle!",
      "status": "imported"
    },
    "voice_201:r_620fedec67706d7d": {
      "text": "Kneeling won't change the world!",
      "status": "imported"
    },
    "voice_201:r_9680dcd0fddcfcc7": {
      "text": "The world-changing war goes on!",
      "status": "imported"
    },
    "voice_201:r_2a00f1044ad5cbaa": {
      "text": "I-is this the Gundam's power?!",
      "status": "imported"
    },
    "voice_201:r_3dbeead1bd3164ef": {
      "text": "Power beyond all rumor!\\nDancouga!",
      "status": "imported"
    },
    "voice_201:r_98d15b8cc09bc915": {
      "text": "Raaaaagh!",
      "status": "imported"
    },
    "voice_201:r_46e86d000250e137": {
      "text": "Damn it!!",
      "status": "imported"
    },
    "voice_201:r_ac341e7976e88f0b": {
      "text": "M-my machine!!",
      "status": "imported"
    },
    "voice_201:r_cdbd128a5b4127cc": {
      "text": "N-no... How vexing!!",
      "status": "imported"
    },
    "voice_201:r_e42b52c7a987b906": {
      "text": "Got you!",
      "status": "imported"
    },
    "voice_201:r_6825fd1ff907bd22": {
      "text": "Eat this!",
      "status": "imported"
    },
    "voice_201:r_607f666f1563bc0d": {
      "text": "This world needs us now!",
      "status": "imported"
    },
    "voice_201:r_97b7431eeb81e6b6": {
      "text": "We'll bring down this rotten world!",
      "status": "imported"
    },
    "voice_201:r_fa944da4b6519006": {
      "text": "I'll turn this back on you!",
      "status": "imported"
    },
    "voice_201:r_95d047bcc17fccc6": {
      "text": "I'll repay that debt at once!",
      "status": "imported"
    },
    "voice_201:r_640327a12a559b31": {
      "text": "We'll press the attack right here!",
      "status": "imported"
    },
    "voice_201:r_bdd38c584fa313d0": {
      "text": "Finishing blow!",
      "status": "imported"
    },
    "voice_201:r_3fd86c1027f317c8": {
      "text": "This will finish you!",
      "status": "imported"
    },
    "voice_201:r_d0372a183d2007ad": {
      "text": "I-is this as far as I go?!!",
      "status": "imported"
    },
    "voice_201:r_217aa5e1d545b44d": {
      "text": "D-daaaaamn!!",
      "status": "imported"
    },
    "voice_201:r_381992c5d8224937": {
      "text": "W-why is this so easy for them?!",
      "status": "imported"
    },
    "voice_201:r_f1e7ed9e5874aba5": {
      "text": "I-I'll stop them! At any cost!!",
      "status": "imported"
    },
    "voice_201:r_fc25e66a86fc2c85": {
      "text": "No! Was that a direct hit?!",
      "status": "imported"
    },
    "voice_201:r_5aeeb4917340c42d": {
      "text": "Guh! This battle isn't over yet!",
      "status": "imported"
    },
    "voice_201:r_b765659981b6516d": {
      "text": "What is that?",
      "status": "imported"
    },
    "voice_201:r_0c427458bc00eb95": {
      "text": "What? Is one hit all you've got?",
      "status": "imported"
    },
    "voice_201:r_774a9ab4d8fd5351": {
      "text": "You underestimated us!",
      "status": "imported"
    },
    "voice_201:r_d3f01de714c015bd": {
      "text": "I can't afford a direct hit!",
      "status": "imported"
    },
    "voice_201:r_7d2617c809fead70": {
      "text": "Where are you looking?!",
      "status": "imported"
    },
    "voice_201:r_ceb935ccbf830724": {
      "text": "What an obvious trick!",
      "status": "imported"
    },
    "voice_201:r_862ef7385bf2abd4": {
      "text": "That was pointless!",
      "status": "imported"
    },
    "voice_201:r_001cbec4d9a4283f": {
      "text": "You think that can hurt me?!",
      "status": "imported"
    },
    "voice_201:r_4ad81e88c7557a8b": {
      "text": "Damn, not from that position!",
      "status": "imported"
    },
    "voice_201:r_1f65a7af190e4674": {
      "text": "I won't let you!",
      "status": "imported"
    },
    "voice_201:r_40c5a9358ed5bf29": {
      "text": "Break away, now!",
      "status": "imported"
    },
    "voice_201:r_f2e18dfdfe0c89ea": {
      "text": "We'll have to withdraw for now!",
      "status": "imported"
    },
    "voice_201:r_cf7dbf49e96a5755": {
      "text": "We'll carry our cause through!",
      "status": "imported"
    },
    "voice_201:r_66ab4cfe1557909d": {
      "text": "This is impossible!!",
      "status": "imported"
    },
    "voice_201:r_0bad405ee6ca63ba": {
      "text": "Hah! Is that the best you can do?",
      "status": "imported"
    },
    "voice_201:r_2072eaf71a260ae7": {
      "text": "I'll keep them in check!",
      "status": "imported"
    },
    "voice_201:r_6c13bbfd27a7799e": {
      "text": "We'll strike first!",
      "status": "imported"
    },
    "voice_201:r_06f88dcbd3c9e738": {
      "text": "Roger! Commencing attack!",
      "status": "imported"
    },
    "voice_201:r_b28faf9f71bc3598": {
      "text": "I'm your opponent!",
      "status": "imported"
    }
  }
}
