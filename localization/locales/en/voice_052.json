{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_052:r_479b340ccc6c572b": {
      "text": "Damn it! Just who are they?!",
      "status": "imported"
    },
    "voice_052:r_ca4acbac57a2a35e": {
      "text": "I'll avenge the people's suffering!",
      "status": "imported"
    },
    "voice_052:r_77949221bf58f862": {
      "text": "To the end,\\nwe'll fight with pride!",
      "status": "imported"
    },
    "voice_052:r_70b9c4b9f1f37eff": {
      "text": "I'm Geminis' captain to the end!",
      "status": "imported"
    },
    "voice_052:r_9fcb3754cb1773c7": {
      "text": "Let's do this, Geminia!",
      "status": "imported"
    },
    "voice_052:r_3559d2fad32c2435": {
      "text": "While I live, Geminaids won't fall!",
      "status": "imported"
    },
    "voice_052:r_f7570547e9f80a64": {
      "text": "My attack won't end until you fall!",
      "status": "imported"
    },
    "voice_052:r_cbab0f4720e1fcf1": {
      "text": "I'll strike again whenever I can!",
      "status": "imported"
    },
    "voice_052:r_0bbe0b4f5364e732": {
      "text": "Light Particle Full Charge!",
      "status": "imported"
    },
    "voice_052:r_5dda5198137cb02a": {
      "text": "Fire!",
      "status": "imported"
    },
    "voice_052:r_83ec59afbecdec14": {
      "text": "Let's do this, Geminia!",
      "status": "imported"
    },
    "voice_052:r_e20bfd42ad95a3c9": {
      "text": "Light Particle Blast!",
      "status": "imported"
    },
    "voice_052:r_0f58a8822381e57f": {
      "text": "Charge Formenia!",
      "status": "imported"
    },
    "voice_052:r_6dbcc507fb61b51d": {
      "text": "Go!",
      "status": "imported"
    },
    "voice_052:r_b42ab697149a7c8a": {
      "text": "I'll cut down Geminai's enemies!",
      "status": "imported"
    },
    "voice_052:r_4de4fcf3b440baf4": {
      "text": "Lightbreaker Slash!",
      "status": "imported"
    },
    "voice_052:r_0121a166c715cdff": {
      "text": "Geminia, give it everything!",
      "status": "imported"
    },
    "voice_052:r_30fad37a42bd3ad3": {
      "text": "You won't escape!",
      "status": "imported"
    },
    "voice_052:r_80a0b2a84e05d81a": {
      "text": "Haaaaah!",
      "status": "imported"
    },
    "voice_052:r_4a9ac1dff86506d9": {
      "text": "This finishes you!!",
      "status": "imported"
    },
    "voice_052:r_bc8538e6af3d2577": {
      "text": "Answer me, Sphere!",
      "status": "imported"
    },
    "voice_052:r_924516c8de2b5342": {
      "text": "No one can stop us!",
      "status": "imported"
    },
    "voice_052:r_da1174533722333f": {
      "text": "Raaaaagh!",
      "status": "imported"
    },
    "voice_052:r_fdeb8162976e72c1": {
      "text": "Full Burst!!",
      "status": "imported"
    },
    "voice_052:r_bf3244994760e535": {
      "text": "Counterattack, now!",
      "status": "imported"
    },
    "voice_052:r_aabfb21c9d069ce7": {
      "text": "Are they within our range?!",
      "status": "imported"
    },
    "voice_052:r_02479dc8fe989560": {
      "text": "Like hell you'll escape!",
      "status": "imported"
    },
    "voice_052:r_a2df00f91a9b0a9e": {
      "text": "This counter will finish you!",
      "status": "imported"
    },
    "voice_052:r_48b60d6c48b9b142": {
      "text": "Leave this to me!",
      "status": "imported"
    },
    "voice_052:r_8927e6fb681aa809": {
      "text": "I'll give you a hand!",
      "status": "imported"
    },
    "voice_052:r_ddbe581c5ea9183d": {
      "text": "Damn! I can't counterattack?!",
      "status": "imported"
    },
    "voice_052:r_faae935cca0edc72": {
      "text": "I can't believe I made that mistake!",
      "status": "imported"
    },
    "voice_052:r_d4430bf362340b32": {
      "text": "Too slow!",
      "status": "imported"
    },
    "voice_052:r_6ff1323b355593e0": {
      "text": "You think that attack can hit me?!",
      "status": "imported"
    },
    "voice_052:r_b7b5625d7cd4282f": {
      "text": "I've read your trajectory!",
      "status": "imported"
    },
    "voice_052:r_36133ad73a73ef98": {
      "text": "Such a predictable attack won't...!",
      "status": "imported"
    },
    "voice_052:r_920740a0219c5085": {
      "text": "That won't work!",
      "status": "imported"
    },
    "voice_052:r_3633df5b7b8f47fa": {
      "text": "That attack can't pierce my field!",
      "status": "imported"
    },
    "voice_052:r_52dfc56b14b93551": {
      "text": "This much damage means nothing!",
      "status": "imported"
    },
    "voice_052:r_1b9b2aab5cb104da": {
      "text": "That didn't even hurt!",
      "status": "imported"
    },
    "voice_052:r_342044c706a2340f": {
      "text": "You still dare resist?!",
      "status": "imported"
    },
    "voice_052:r_cf41e8828a90cbdb": {
      "text": "No time to worry about a scratch!",
      "status": "imported"
    },
    "voice_052:r_719e897304ec42d4": {
      "text": "Not bad...! But...!",
      "status": "imported"
    },
    "voice_052:r_d5e0a2317c40d322": {
      "text": "Geminia can still fight!",
      "status": "imported"
    },
    "voice_052:r_ec2ea17765052401": {
      "text": "While my machine moves, I'll fight!",
      "status": "imported"
    },
    "voice_052:r_f2d4255f1c2f7542": {
      "text": "Right now, attacking comes first!",
      "status": "imported"
    },
    "voice_052:r_5d08ad19e2da125b": {
      "text": "It'll take more than this to get me!",
      "status": "imported"
    },
    "voice_052:r_a7246b52782a877e": {
      "text": "Geminaids have\\nsuffered far worse!",
      "status": "imported"
    },
    "voice_052:r_dc8701f6bcb9904f": {
      "text": "Till I avenge Geminaids,\\nI fight on!",
      "status": "imported"
    },
    "voice_052:r_d6bdd730f24f66eb": {
      "text": "Let's do this, Geminia!\\nTill I die!",
      "status": "imported"
    },
    "voice_052:r_41997412868c48c4": {
      "text": "Damn it! Damn iiiiiit!!",
      "status": "imported"
    },
    "voice_052:r_9e6cf4f389dae55c": {
      "text": "U-Uwaaaaaagh!!",
      "status": "imported"
    }
  }
}
