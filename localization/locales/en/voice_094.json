{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_094:r_479b340ccc6c572b": {
      "text": "Focus, all of you!",
      "status": "imported"
    },
    "voice_094:r_ca4acbac57a2a35e": {
      "text": "So the enemy's finally here!",
      "status": "imported"
    },
    "voice_094:r_77949221bf58f862": {
      "text": "Hurry up and lay down a barrage!",
      "status": "imported"
    },
    "voice_094:r_70b9c4b9f1f37eff": {
      "text": "Don't hit our allies!",
      "status": "imported"
    },
    "voice_094:r_9fcb3754cb1773c7": {
      "text": "Cut loose and let 'em have it!",
      "status": "imported"
    },
    "voice_094:r_3559d2fad32c2435": {
      "text": "Bring 'em down by any means!",
      "status": "imported"
    },
    "voice_094:r_f7570547e9f80a64": {
      "text": "Give 'em another one!",
      "status": "imported"
    },
    "voice_094:r_cbab0f4720e1fcf1": {
      "text": "Don't let up on the attack!",
      "status": "imported"
    },
    "voice_094:r_0bbe0b4f5364e732": {
      "text": "We're taking the Box back with us!",
      "status": "imported"
    },
    "voice_094:r_5dda5198137cb02a": {
      "text": "Laplace's Box key!\\nIt can't flee!",
      "status": "imported"
    },
    "voice_094:r_83ec59afbecdec14": {
      "text": "So you won't retreat, Banagher...!",
      "status": "imported"
    },
    "voice_094:r_e20bfd42ad95a3c9": {
      "text": "Knock Londo Bell out of the sky!",
      "status": "imported"
    },
    "voice_094:r_0f58a8822381e57f": {
      "text": "A Gundam's coming! Stay sharp!",
      "status": "imported"
    },
    "voice_094:r_6dbcc507fb61b51d": {
      "text": "So I'm fighting a Gundam again...!",
      "status": "imported"
    },
    "voice_094:r_b42ab697149a7c8a": {
      "text": "Zeon's fate:\\nto fight Gundams...!",
      "status": "imported"
    },
    "voice_094:r_4de4fcf3b440baf4": {
      "text": "Even fake Gundams...\\nDamn pests!",
      "status": "imported"
    },
    "voice_094:r_0121a166c715cdff": {
      "text": "Damn monster! Shoot it down!",
      "status": "imported"
    },
    "voice_094:r_30fad37a42bd3ad3": {
      "text": "Bring down that big target!",
      "status": "imported"
    },
    "voice_094:r_80a0b2a84e05d81a": {
      "text": "It moves around too damn much...!",
      "status": "imported"
    },
    "voice_094:r_4a9ac1dff86506d9": {
      "text": "Pretty gutsy for something so small!",
      "status": "imported"
    },
    "voice_094:r_bc8538e6af3d2577": {
      "text": "We can't let these things run wild!",
      "status": "imported"
    },
    "voice_094:r_924516c8de2b5342": {
      "text": "Time to hunt ourselves a monster!",
      "status": "imported"
    },
    "voice_094:r_da1174533722333f": {
      "text": "Stop it! That's all that matters!",
      "status": "imported"
    },
    "voice_094:r_fdeb8162976e72c1": {
      "text": "What's a kid doing out here...!",
      "status": "imported"
    },
    "voice_094:r_0fadb5c26df92b42": {
      "text": "A woman? You don't belong here...!",
      "status": "imported"
    },
    "voice_094:r_15b4a90140e8a33a": {
      "text": "Aim for the head. That's standard!",
      "status": "imported"
    },
    "voice_094:r_d5e0a2317c40d322": {
      "text": "Return fire!",
      "status": "imported"
    },
    "voice_094:r_ec2ea17765052401": {
      "text": "Turn us around! Don't let it escape!",
      "status": "imported"
    },
    "voice_094:r_f2d4255f1c2f7542": {
      "text": "Make 'em pay for attacking us!",
      "status": "imported"
    },
    "voice_094:r_5d08ad19e2da125b": {
      "text": "They hit us, we hit 'em back!",
      "status": "imported"
    },
    "voice_094:r_a7246b52782a877e": {
      "text": "Brush off any sparks that reach us!",
      "status": "imported"
    },
    "voice_094:r_dc8701f6bcb9904f": {
      "text": "Follow our allies in! Attack!",
      "status": "imported"
    },
    "voice_094:r_d6bdd730f24f66eb": {
      "text": "Garencieres, moving to support!",
      "status": "imported"
    },
    "voice_094:r_41997412868c48c4": {
      "text": "Follow the Commander!",
      "status": "imported"
    },
    "voice_094:r_9e6cf4f389dae55c": {
      "text": "Move in to support Frontal!",
      "status": "imported"
    },
    "voice_094:r_9e0c80ac7e33b459": {
      "text": "So the Personal Guard is no joke...!",
      "status": "imported"
    },
    "voice_094:r_7432ef43ed3471dc": {
      "text": "Nice work, Gilboa!",
      "status": "imported"
    },
    "voice_094:r_065443f6ddfcf0d7": {
      "text": "Don't push yourself, Marida!",
      "status": "imported"
    },
    "voice_094:r_47d52a2839c71715": {
      "text": "Banagher! We'll take it from here!",
      "status": "imported"
    },
    "voice_094:r_847f82e7f3eef651": {
      "text": "Coordinate with our allied ships!",
      "status": "imported"
    },
    "voice_094:r_eb7ae28b53dc033c": {
      "text": "Don't let them take down our allies!",
      "status": "imported"
    },
    "voice_094:r_857c4a52ce8df0fd": {
      "text": "Move Garencieres to the front!",
      "status": "imported"
    },
    "voice_094:r_55417493fce1d347": {
      "text": "Even the Red Comet is outmatched...!",
      "status": "imported"
    },
    "voice_094:r_7d724dbcc4451e10": {
      "text": "Protect the Red Comet!",
      "status": "imported"
    },
    "voice_094:r_adeb0a29274d3d9b": {
      "text": "Clean up after the Personal Guard!",
      "status": "imported"
    },
    "voice_094:r_24cf161287ef9d5c": {
      "text": "Tikva and the rest...\\nLive, Gilboa!",
      "status": "imported"
    },
    "voice_094:r_8f60f6fc86db3107": {
      "text": "I won't let them take Marida!",
      "status": "imported"
    },
    "voice_094:r_b1de76a75a253c13": {
      "text": "Do you want to die, Banagher?!",
      "status": "imported"
    },
    "voice_094:r_128c35bf3e0e394c": {
      "text": "Move in front of the allied ship!",
      "status": "imported"
    },
    "voice_094:r_5213c17e13b23de0": {
      "text": "We can't even counterattack...!",
      "status": "imported"
    },
    "voice_094:r_38fdff9483e9245c": {
      "text": "Garencieres, a target.\\nPathetic...!",
      "status": "imported"
    },
    "voice_094:r_620fedec67706d7d": {
      "text": "Damn...! We can't raise the output?!",
      "status": "imported"
    },
    "voice_094:r_9680dcd0fddcfcc7": {
      "text": "We can't reach that position...!",
      "status": "imported"
    },
    "voice_094:r_2a00f1044ad5cbaa": {
      "text": "Nice moves. They're no amateur.",
      "status": "imported"
    },
    "voice_094:r_3dbeead1bd3164ef": {
      "text": "Hmph. That gave me a scare.",
      "status": "imported"
    },
    "voice_094:r_98d15b8cc09bc915": {
      "text": "I saw that attack coming long ago!",
      "status": "imported"
    },
    "voice_094:r_46e86d000250e137": {
      "text": "Looks like luck is on our side!",
      "status": "imported"
    },
    "voice_094:r_ac341e7976e88f0b": {
      "text": "Good! Maintain our current speed!",
      "status": "imported"
    },
    "voice_094:r_cdbd128a5b4127cc": {
      "text": "Good. Keep the enemy away!",
      "status": "imported"
    },
    "voice_094:r_cfccaa1fbeda124c": {
      "text": "One hit would've been a disaster!",
      "status": "imported"
    },
    "voice_094:r_b1f8ec192b9c083a": {
      "text": "Their pilot's a total rookie!",
      "status": "imported"
    },
    "voice_094:r_a007f9ab9cf048b3": {
      "text": "I don't need your concern, Banagher!",
      "status": "imported"
    },
    "voice_094:r_ddafde4b065ced49": {
      "text": "You're nothing special, Londo Bell!",
      "status": "imported"
    },
    "voice_094:r_de1213040856c089": {
      "text": "Is the Gundam name all you have?!",
      "status": "imported"
    },
    "voice_094:r_3304412ac41f47a6": {
      "text": "I don't want to kill a kid...!",
      "status": "imported"
    },
    "voice_094:r_0c0775e051211840": {
      "text": "Go back home quietly. Trust me.",
      "status": "imported"
    },
    "voice_094:r_5391b24a71eb10ae": {
      "text": "I could do without this pestering.",
      "status": "imported"
    },
    "voice_094:r_a554ceef5c87b972": {
      "text": "It hit the cargo hold...!",
      "status": "imported"
    },
    "voice_094:r_546c3d5937fbb7ee": {
      "text": "Whoa! We're rocking a little!",
      "status": "imported"
    },
    "voice_094:r_1568ff6298b12b96": {
      "text": "Tch! Just a glancing hit, huh...!",
      "status": "imported"
    },
    "voice_094:r_2c9d94ba13c5fc50": {
      "text": "Don't worry! It only grazed us!",
      "status": "imported"
    },
    "voice_094:r_a77f4913375098d2": {
      "text": "They underestimate Garencieres!",
      "status": "imported"
    },
    "voice_094:r_428c2116ac3071b1": {
      "text": "That kind of thing won't work!!",
      "status": "imported"
    },
    "voice_094:r_dad38ee29af2df3a": {
      "text": "Our equipment saved us!",
      "status": "imported"
    },
    "voice_094:r_3d32e86f8dc80909": {
      "text": "Can't always have it our way...!",
      "status": "imported"
    },
    "voice_094:r_70451ffbabe2f876": {
      "text": "Looks like luck's on their side...!",
      "status": "imported"
    },
    "voice_094:r_69dfa1659715e2fa": {
      "text": "Tch! Trouble when they latch on!",
      "status": "imported"
    },
    "voice_094:r_d996fd6d4ef5b329": {
      "text": "They really want our attention!",
      "status": "imported"
    },
    "voice_094:r_8ab47a28f99ef565": {
      "text": "They've latched on! Shake 'em off!",
      "status": "imported"
    },
    "voice_094:r_546de3fb6db156ea": {
      "text": "Damage report later!\\nGet it off us!",
      "status": "imported"
    },
    "voice_094:r_ca85f87cee5e31f7": {
      "text": "Damn...!\\nIt's not just the Box key!",
      "status": "imported"
    },
    "voice_094:r_9072ea7bc71df136": {
      "text": "We're not going down yet, Banagher!",
      "status": "imported"
    },
    "voice_094:r_04e815a8d425827d": {
      "text": "Impressive as ever,\\nLondo Bell...!",
      "status": "imported"
    },
    "voice_094:r_d89011fe3e5d082a": {
      "text": "Damn Gundam...! How I hate it!",
      "status": "imported"
    },
    "voice_094:r_3c5b0c2ac812d5de": {
      "text": "Tch!\\nGundams are a damn plague!",
      "status": "imported"
    },
    "voice_094:r_5b9e8897190892eb": {
      "text": "Kid...!\\nWant to fight that badly?!",
      "status": "imported"
    },
    "voice_094:r_7bea3023abbf8a94": {
      "text": "Damn!\\nUsing youth as a weapon...!",
      "status": "imported"
    },
    "voice_094:r_dd01a4c0d1b36a8d": {
      "text": "Not bad for a woman...!",
      "status": "imported"
    },
    "voice_094:r_132f605d02975e71": {
      "text": "Don't sink on me, Garencieres...!",
      "status": "imported"
    },
    "voice_094:r_9b9726b1872759d6": {
      "text": "I won't sit here and take it...!",
      "status": "imported"
    },
    "voice_094:r_1252db29683fefe0": {
      "text": "Has luck abandoned us completely?!",
      "status": "imported"
    },
    "voice_094:r_ad3d538f1e909184": {
      "text": "Damn it!\\nA direct hit at last...!",
      "status": "imported"
    },
    "voice_094:r_8c61c59a1c0aebbf": {
      "text": "So it's time to face the end...!",
      "status": "imported"
    },
    "voice_094:r_aba6a7662129d8ce": {
      "text": "All hands, abandon ship! Stay alive!",
      "status": "imported"
    },
    "voice_094:r_b84afafb8a33ec60": {
      "text": "Is this the end for Garencieres...?!",
      "status": "imported"
    },
    "voice_094:r_c8c59db85bf875e6": {
      "text": "All hands, prepare for battle!",
      "status": "imported"
    },
    "voice_094:r_391aa56435d9dd6e": {
      "text": "Ready whenever you are, Captain!",
      "status": "imported"
    },
    "voice_094:r_7c796ba53bd7ea03": {
      "text": "Notify the gun crews!",
      "status": "imported"
    },
    "voice_094:r_fa944da4b6519006": {
      "text": "One big shot, right? Roger that!",
      "status": "imported"
    },
    "voice_094:r_95d047bcc17fccc6": {
      "text": "Enemy unit in range!",
      "status": "imported"
    },
    "voice_094:r_640327a12a559b31": {
      "text": "Shoot it down, now!",
      "status": "imported"
    },
    "voice_094:r_bdd38c584fa313d0": {
      "text": "Time to make our move, Captain!",
      "status": "imported"
    },
    "voice_094:r_3fd86c1027f317c8": {
      "text": "All right! Commence attack!",
      "status": "imported"
    },
    "voice_094:r_d0372a183d2007ad": {
      "text": "All set! Ready anytime!",
      "status": "imported"
    },
    "voice_094:r_217aa5e1d545b44d": {
      "text": "Well then, let's do this!",
      "status": "imported"
    },
    "voice_094:r_381992c5d8224937": {
      "text": "Hope this works out in our favor!",
      "status": "imported"
    },
    "voice_094:r_f1e7ed9e5874aba5": {
      "text": "Time to show 'em what I can do!",
      "status": "imported"
    },
    "voice_094:r_fc25e66a86fc2c85": {
      "text": "That one...! Orders, Captain?!",
      "status": "imported"
    },
    "voice_094:r_5aeeb4917340c42d": {
      "text": "The boy's out here! Shoot him down!",
      "status": "imported"
    },
    "voice_094:r_b765659981b6516d": {
      "text": "Captain! It's Londo Bell!",
      "status": "imported"
    },
    "voice_094:r_0c427458bc00eb95": {
      "text": "No need to hold back! Crush 'em!",
      "status": "imported"
    },
    "voice_094:r_774a9ab4d8fd5351": {
      "text": "A Gundam's here...!",
      "status": "imported"
    },
    "voice_094:r_d3f01de714c015bd": {
      "text": "Now we've gotta steel ourselves!",
      "status": "imported"
    },
    "voice_094:r_b28faf9f71bc3598": {
      "text": "We're done at this rate! Damn it...!",
      "status": "imported"
    },
    "voice_094:r_8a29278549f8e07a": {
      "text": "Damn it! We can't move...!",
      "status": "imported"
    },
    "voice_094:r_7e6c573c26177f98": {
      "text": "That position is our blind spot...!",
      "status": "imported"
    },
    "voice_094:r_45abf84f7757d6eb": {
      "text": "Nice work, Flaste!",
      "status": "imported"
    },
    "voice_094:r_edd7a13ab8f06a14": {
      "text": "This is a piece of cake for me!",
      "status": "imported"
    },
    "voice_094:r_8165e5b41f0124c4": {
      "text": "Whoa! That was close!",
      "status": "imported"
    },
    "voice_094:r_4e05581b7432cce8": {
      "text": "That last one was way too close!",
      "status": "imported"
    },
    "voice_094:r_a60b107ea3c36a86": {
      "text": "Hell yeah! It worked!",
      "status": "imported"
    },
    "voice_094:r_e33693e5ba4665b0": {
      "text": "The enemy pilot's a real amateur!",
      "status": "imported"
    },
    "voice_094:r_72a21a1a489af001": {
      "text": "I've been through hell and back!",
      "status": "imported"
    },
    "voice_094:r_eb643f8bf737a0ca": {
      "text": "The barrier's doing its job.",
      "status": "imported"
    },
    "voice_094:r_0a3fccb71ec6cf2a": {
      "text": "Don't get cocky, Flaste.",
      "status": "imported"
    },
    "voice_094:r_9b63cf1f3e0207ef": {
      "text": "Damage check! Are you all right?!",
      "status": "imported"
    },
    "voice_094:r_8356f4e3dcdff938": {
      "text": "I'm fine! No problems here!",
      "status": "imported"
    },
    "voice_094:r_1d6d784036ae0bd7": {
      "text": "Tch! Nothing's going our way!",
      "status": "imported"
    },
    "voice_094:r_625664af02183c17": {
      "text": "Forget the miss! Next one's coming!",
      "status": "imported"
    },
    "voice_094:r_3701cba361f80ea5": {
      "text": "Flaste!",
      "status": "imported"
    },
    "voice_094:r_63f429c5c68c0863": {
      "text": "I'm fine!\\nIt's nothing serious!",
      "status": "imported"
    },
    "voice_094:r_38e4a434c91d8ef0": {
      "text": "I can handle a little hit!",
      "status": "imported"
    },
    "voice_094:r_98ed411352a3a6ac": {
      "text": "Garencieres won't go down easy...!",
      "status": "imported"
    },
    "voice_094:r_4824bea6bab3af67": {
      "text": "No serious damage, it seems...!",
      "status": "imported"
    },
    "voice_094:r_862b92e63adb9734": {
      "text": "Flaste! Can you shake 'em?!",
      "status": "imported"
    },
    "voice_094:r_cb306ef55e49d107": {
      "text": "If it has to be done, we'll do it!",
      "status": "imported"
    },
    "voice_094:r_57b2bd2de8a1408d": {
      "text": "Damn it! They've caught us!",
      "status": "imported"
    },
    "voice_094:r_76f080a4881e8ab5": {
      "text": "We can still go! Stay calm, Flaste!",
      "status": "imported"
    },
    "voice_094:r_288133bc5b573dae": {
      "text": "Recall the mobile suit team!",
      "status": "imported"
    },
    "voice_094:r_6f95653e548f8fcf": {
      "text": "Not in this situation!",
      "status": "imported"
    },
    "voice_094:r_d249d68bada91ab9": {
      "text": "They just keep landing hits...!",
      "status": "imported"
    },
    "voice_094:r_e9b3307e9eb69f11": {
      "text": "Damn, aren't you good!",
      "status": "imported"
    },
    "voice_094:r_03cdac73042343ee": {
      "text": "A nasty turn...\\nWe're stuck in it!",
      "status": "imported"
    },
    "voice_094:r_6026da5acbda7c69": {
      "text": "I'll take the rest! You all get out!",
      "status": "imported"
    },
    "voice_094:r_981f8fedd5414fe5": {
      "text": "This is no time for a lousy joke!",
      "status": "imported"
    },
    "voice_094:r_96bb0dcde0c8c44a": {
      "text": "We can take one more hit at most!",
      "status": "imported"
    },
    "voice_094:r_641550a2f54cb456": {
      "text": "Then we just won't take that hit!",
      "status": "imported"
    },
    "voice_094:r_a0f2074af8debbfa": {
      "text": "Damn...!\\nThe whole ship's screaming!",
      "status": "imported"
    },
    "voice_094:r_b5f5a97ed82acb0b": {
      "text": "But just a bit longer...\\nHold on!",
      "status": "imported"
    },
    "voice_094:r_d9cd2e4ded064396": {
      "text": "Please...! Don't go down yet!",
      "status": "imported"
    },
    "voice_094:r_99e6349431aaf23b": {
      "text": "Damn it!\\nGarencieres can't last...!",
      "status": "imported"
    },
    "voice_094:r_ec1081caf845f56a": {
      "text": "Bastard! You're damn persistent!",
      "status": "imported"
    },
    "voice_094:r_2c5b7ee872c1ed7f": {
      "text": "Sorry, Captain...!",
      "status": "imported"
    },
    "voice_094:r_76d1e51c8b494a60": {
      "text": "Later! Evacuation comes first!",
      "status": "imported"
    },
    "voice_094:r_eb5f687fcd372ae7": {
      "text": "Aw, hell... We're in bad shape.",
      "status": "imported"
    },
    "voice_094:r_2329428a6871d9fa": {
