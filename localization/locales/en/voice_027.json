{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_027:r_479b340ccc6c572b": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_027:r_ca4acbac57a2a35e": {
      "text": "Target locked!",
      "status": "imported"
    },
    "voice_027:r_77949221bf58f862": {
      "text": "Got you!",
      "status": "imported"
    },
    "voice_027:r_70b9c4b9f1f37eff": {
      "text": "Go!",
      "status": "imported"
    },
    "voice_027:r_9fcb3754cb1773c7": {
      "text": "You're not getting away!",
      "status": "imported"
    },
    "voice_027:r_3559d2fad32c2435": {
      "text": "Skull 4! Commencing combat!",
      "status": "imported"
    },
    "voice_027:r_f7570547e9f80a64": {
      "text": "I'll keep this one occupied!",
      "status": "imported"
    },
    "voice_027:r_cbab0f4720e1fcf1": {
      "text": "Just give up already!",
      "status": "imported"
    },
    "voice_027:r_0bbe0b4f5364e732": {
      "text": "Too slow! Got you now!",
      "status": "imported"
    },
    "voice_027:r_5dda5198137cb02a": {
      "text": "Let's cut to the chase!",
      "status": "imported"
    },
    "voice_027:r_83ec59afbecdec14": {
      "text": "I won't let you do as you please!",
      "status": "imported"
    },
    "voice_027:r_e20bfd42ad95a3c9": {
      "text": "At this range, I can do it!",
      "status": "imported"
    },
    "voice_027:r_0f58a8822381e57f": {
      "text": "However many times it takes, I will!",
      "status": "imported"
    },
    "voice_027:r_6dbcc507fb61b51d": {
      "text": "Why, you! You're so persistent!",
      "status": "imported"
    },
    "voice_027:r_b42ab697149a7c8a": {
      "text": "Vajra acquired! Attacking!",
      "status": "imported"
    },
    "voice_027:r_4de4fcf3b440baf4": {
      "text": "I'll make short work of the Vajra!",
      "status": "imported"
    },
    "voice_027:r_0121a166c715cdff": {
      "text": "That flying of yours is pathetic!",
      "status": "imported"
    },
    "voice_027:r_80a0b2a84e05d81a": {
      "text": "Like the Vajra...\\nI can take them!",
      "status": "imported"
    },
    "voice_027:r_4a9ac1dff86506d9": {
      "text": "I won't let you rule the skies!",
      "status": "imported"
    },
    "voice_027:r_bc8538e6af3d2577": {
      "text": "The top dog's here! I'll crush you!",
      "status": "imported"
    },
    "voice_027:r_77ca87eacd17ad52": {
      "text": "There!",
      "status": "imported"
    },
    "voice_027:r_3dbeead1bd3164ef": {
      "text": "Even at close range!",
      "status": "imported"
    },
    "voice_027:r_46e86d000250e137": {
      "text": "You've left yourself wide open!",
      "status": "imported"
    },
    "voice_027:r_cdbd128a5b4127cc": {
      "text": "An opening! Got you!!",
      "status": "imported"
    },
    "voice_027:r_cfccaa1fbeda124c": {
      "text": "I'll outmaneuver and confuse you!",
      "status": "imported"
    },
    "voice_027:r_b1f8ec192b9c083a": {
      "text": "Where're you looking? I'm over here!",
      "status": "imported"
    },
    "voice_027:r_a007f9ab9cf048b3": {
      "text": "Raaaaaaaagh!!",
      "status": "imported"
    },
    "voice_027:r_ddafde4b065ced49": {
      "text": "Enemy shot down!",
      "status": "imported"
    },
    "voice_027:r_de1213040856c089": {
      "text": "Let's settle this with speed!",
      "status": "imported"
    },
    "voice_027:r_3304412ac41f47a6": {
      "text": "You can't catch this thing!!",
      "status": "imported"
    },
    "voice_027:r_0c0775e051211840": {
      "text": "There you aaaaaare!!",
      "status": "imported"
    },
    "voice_027:r_a2afffe1c396f0b3": {
      "text": "All right, got one!",
      "status": "imported"
    },
    "voice_027:r_13c25fbdfddc8a24": {
      "text": "I'll stop you before you even start!",
      "status": "imported"
    },
    "voice_027:r_42ba1ecb310b4bd7": {
      "text": "I won't give you time to counter!",
      "status": "imported"
    },
    "voice_027:r_d692f1d420460a47": {
      "text": "This'll do it...!",
      "status": "imported"
    },
    "voice_027:r_a5643cec86b18bd2": {
      "text": "It's oveeer!",
      "status": "imported"
    },
    "voice_027:r_68f2dfab20a4a30e": {
      "text": "Enemy unit destroyed!",
      "status": "imported"
    },
    "voice_027:r_9cedad8237480563": {
      "text": "The Tornado owns high speed combat!",
      "status": "imported"
    },
    "voice_027:r_a03fabecba1508ca": {
      "text": "Raaaaaagh!",
      "status": "imported"
    },
    "voice_027:r_5391b24a71eb10ae": {
      "text": "This is the end...!",
      "status": "imported"
    },
    "voice_027:r_a554ceef5c87b972": {
      "text": "Take thiiiiis!",
      "status": "imported"
    },
    "voice_027:r_546c3d5937fbb7ee": {
      "text": "Did I get them...?!",
      "status": "imported"
    },
    "voice_027:r_70451ffbabe2f876": {
      "text": "I won't let you escape!",
      "status": "imported"
    },
    "voice_027:r_69dfa1659715e2fa": {
      "text": "You've had your way long enough!",
      "status": "imported"
    },
    "voice_027:r_d996fd6d4ef5b329": {
      "text": "I can't waste all my time on you!",
      "status": "imported"
    },
    "voice_027:r_8ab47a28f99ef565": {
      "text": "Don't think I'll take it quietly!",
      "status": "imported"
    },
    "voice_027:r_546de3fb6db156ea": {
      "text": "You hit me, I hit back!",
      "status": "imported"
    },
    "voice_027:r_ca85f87cee5e31f7": {
      "text": "I won't go down without a fight!",
      "status": "imported"
    },
    "voice_027:r_9072ea7bc71df136": {
      "text": "I'll lend you a hand!",
      "status": "imported"
    },
    "voice_027:r_04e815a8d425827d": {
      "text": "Skull 4 here! Moving to assist!",
      "status": "imported"
    },
    "voice_027:r_d89011fe3e5d082a": {
      "text": "I'm still here!",
      "status": "imported"
    },
    "voice_027:r_3c5b0c2ac812d5de": {
      "text": "I'll prove my skill to the captain!",
      "status": "imported"
    },
    "voice_027:r_5b9e8897190892eb": {
      "text": "Leave the finish to me, Michel!",
      "status": "imported"
    },
    "voice_027:r_7bea3023abbf8a94": {
      "text": "All right! Looking good, Luca!",
      "status": "imported"
    },
    "voice_027:r_dd01a4c0d1b36a8d": {
      "text": "Captain Klan! I'll handle the rest!",
      "status": "imported"
    },
    "voice_027:r_20920ad2eb3542db": {
      "text": "While they're focused on the Koenig!",
      "status": "imported"
    },
    "voice_027:r_0ab7914877fd48ed": {
      "text": "Follow the Quarter!",
      "status": "imported"
    },
    "voice_027:r_cb846feec748c2e3": {
      "text": "Fall back while you can!",
      "status": "imported"
    },
    "voice_027:r_c958860b0676b1f5": {
      "text": "No ally will fall before my eyes...!",
      "status": "imported"
    },
    "voice_027:r_5e2669b82ef75ce3": {
      "text": "I won't let you make Ranka cry!",
      "status": "imported"
    },
    "voice_027:r_7847e0ed7dc9282d": {
      "text": "I won't let you take Michel down!",
      "status": "imported"
    },
    "voice_027:r_e42b52c7a987b906": {
      "text": "Let your senior shine for once!",
      "status": "imported"
    },
    "voice_027:r_6825fd1ff907bd22": {
      "text": "Fall back, Captain Klan!",
      "status": "imported"
    },
    "voice_027:r_607f666f1563bc0d": {
      "text": "It's headed straight for the Koenig!",
      "status": "imported"
    },
    "voice_027:r_97b7431eeb81e6b6": {
      "text": "Captain! That position's dangerous!",
      "status": "imported"
    },
    "voice_027:r_132f605d02975e71": {
      "text": "For now, I just have to hold out...!",
      "status": "imported"
    },
    "voice_027:r_9b9726b1872759d6": {
      "text": "Counterattack...! Damn, I can't!",
      "status": "imported"
    },
    "voice_027:r_1252db29683fefe0": {
      "text": "Like this,\\nI can barely fly...!",
      "status": "imported"
    },
    "voice_027:r_ad3d538f1e909184": {
      "text": "This position is terrible...!",
      "status": "imported"
    },
    "voice_027:r_8c61c59a1c0aebbf": {
      "text": "Tch! That was a dirty trick!",
      "status": "imported"
    },
    "voice_027:r_aba6a7662129d8ce": {
      "text": "Ngh...! That was close!",
      "status": "imported"
    },
    "voice_027:r_b84afafb8a33ec60": {
      "text": "Like I'll let that hit me!",
      "status": "imported"
    },
    "voice_027:r_c8c59db85bf875e6": {
      "text": "I knew you'd try that!",
      "status": "imported"
    },
    "voice_027:r_391aa56435d9dd6e": {
      "text": "Where do you think you're aiming?!",
      "status": "imported"
    },
    "voice_027:r_7c796ba53bd7ea03": {
      "text": "Dodge with the smallest movement...!",
      "status": "imported"
    },
    "voice_027:r_fa944da4b6519006": {
      "text": "Once I read the trajectory, easy!",
      "status": "imported"
    },
    "voice_027:r_95d047bcc17fccc6": {
      "text": "I see it...! I can see your moves!",
      "status": "imported"
    },
    "voice_027:r_640327a12a559b31": {
      "text": "Even the simulator was much harder!",
      "status": "imported"
    },
    "voice_027:r_bdd38c584fa313d0": {
      "text": "Like I'd let some Vajra beat me!",
      "status": "imported"
    },
    "voice_027:r_3fd86c1027f317c8": {
      "text": "You think that'll work on me?!",
      "status": "imported"
    },
    "voice_027:r_217aa5e1d545b44d": {
      "text": "My barrier can stop that much!",
      "status": "imported"
    },
    "voice_027:r_381992c5d8224937": {
      "text": "Ngh...! Are they better than me?!",
      "status": "imported"
    },
    "voice_027:r_f1e7ed9e5874aba5": {
      "text": "This is nothing but a scratch!",
      "status": "imported"
    },
    "voice_027:r_fc25e66a86fc2c85": {
      "text": "Focus...! I'll dodge the next one!",
      "status": "imported"
    },
    "voice_027:r_5aeeb4917340c42d": {
      "text": "Tch! They exploited my mistake!",
      "status": "imported"
    },
    "voice_027:r_b765659981b6516d": {
      "text": "What a laughingstock I'll be...!",
      "status": "imported"
    },
    "voice_027:r_0c427458bc00eb95": {
      "text": "Do you think this is a game...?!",
      "status": "imported"
    },
    "voice_027:r_774a9ab4d8fd5351": {
      "text": "I hate relying on\\nTornado armor...!",
      "status": "imported"
    },
    "voice_027:r_d3f01de714c015bd": {
      "text": "So that's all the Vajra have got?!",
      "status": "imported"
    },
    "voice_027:r_7d2617c809fead70": {
      "text": "Don't think this means you've won!",
      "status": "imported"
    },
    "voice_027:r_ceb935ccbf830724": {
      "text": "Ngh! They're targeting me...!",
      "status": "imported"
    },
    "voice_027:r_862ef7385bf2abd4": {
      "text": "A direct hit! This is bad...!",
      "status": "imported"
    },
    "voice_027:r_001cbec4d9a4283f": {
      "text": "The price for moving too wildly...!",
      "status": "imported"
    },
    "voice_027:r_8ad40afecd02b41e": {
      "text": "They pierced my armor?! Damn you!",
      "status": "imported"
    },
    "voice_027:r_26e5efec03c03d78": {
      "text": "Enough already! You're persistent!",
      "status": "imported"
    },
    "voice_027:r_4ad81e88c7557a8b": {
      "text": "The Tornado couldn't shake them...!",
      "status": "imported"
    },
    "voice_027:r_1f65a7af190e4674": {
      "text": "I let the Vajra run wild...!",
      "status": "imported"
    },
    "voice_027:r_40c5a9358ed5bf29": {
      "text": "I can't let it end without acting!!",
      "status": "imported"
    },
    "voice_027:r_f2e18dfdfe0c89ea": {
      "text": "I won't give up...! I refuse to!!",
      "status": "imported"
    },
    "voice_027:r_cf7dbf49e96a5755": {
      "text": "I'm not dying in a place like this!!",
      "status": "imported"
    },
    "voice_027:r_fa96676cc65bb509": {
      "text": "I haven't flown the true sky yet...!",
      "status": "imported"
    },
    "voice_027:r_4e37f92e7d2fc62e": {
      "text": "Is this... as far as I go...?!",
      "status": "imported"
    },
    "voice_027:r_66ab4cfe1557909d": {
      "text": "Damn! If it still moves, I'll fight!",
      "status": "imported"
    },
    "voice_027:r_0bad405ee6ca63ba": {
      "text": "Like this,\\nTornado's wasted...!",
      "status": "imported"
    },
    "voice_027:r_2072eaf71a260ae7": {
      "text": "Am I going down... to the Vajra...?!",
      "status": "imported"
    },
    "voice_027:r_6c13bbfd27a7799e": {
      "text": "Ngh...! Daaaaamn iiiit!!",
      "status": "imported"
    },
    "voice_027:r_06f88dcbd3c9e738": {
      "text": "No good...! Skull 4, retreating...!",
      "status": "imported"
    },
    "voice_027:r_b28faf9f71bc3598": {
      "text": "Ranka...!",
      "status": "imported"
    },
    "voice_027:r_8a29278549f8e07a": {
      "text": "Sheryl...!",
      "status": "imported"
    },
    "voice_027:r_7e6c573c26177f98": {
      "text": "Unthought blooms. Thought does not.",
      "status": "imported"
    },
    "voice_027:r_45abf84f7757d6eb": {
      "text": "Following my feelings... I'll fly!",
      "status": "imported"
    },
    "voice_027:r_edd7a13ab8f06a14": {
      "text": "I'll strike before it sends word!",
      "status": "imported"
    },
    "voice_027:r_8165e5b41f0124c4": {
      "text": "Captain Gamlin! Leave this to me!",
      "status": "imported"
    },
    "voice_027:r_4e05581b7432cce8": {
      "text": "After Fire Bomber, it's my turn!",
      "status": "imported"
    },
    "voice_027:r_a60b107ea3c36a86": {
      "text": "Fall back, Captain Gamlin!",
      "status": "imported"
    },
    "voice_027:r_e33693e5ba4665b0": {
      "text": "I'll protect the song!",
      "status": "imported"
    },
    "voice_027:r_72a21a1a489af001": {
      "text": "We've got a Pinpoint Barrier!",
      "status": "imported"
    },
    "voice_027:r_6026da5acbda7c69": {
      "text": "There's no time to hesitate!",
      "status": "imported"
    },
    "voice_027:r_96bb0dcde0c8c44a": {
      "text": "Let's go!",
      "status": "imported"
    },
    "voice_027:r_641550a2f54cb456": {
      "text": "There you are!",
      "status": "imported"
    },
    "voice_027:r_a0f2074af8debbfa": {
      "text": "I'm ready for this!",
      "status": "imported"
    },
    "voice_027:r_b5f5a97ed82acb0b": {
      "text": "It all comes down to one shot!",
      "status": "imported"
    },
    "voice_027:r_d9cd2e4ded064396": {
      "text": "Before that thing can move!",
      "status": "imported"
    },
    "voice_027:r_99e6349431aaf23b": {
      "text": "I joined S.M.S.\\nto protect someone!",
      "status": "imported"
    },
    "voice_027:r_ec1081caf845f56a": {
      "text": "I'll fly, even through a sky at war!",
      "status": "imported"
    },
    "voice_027:r_2c5b7ee872c1ed7f": {
      "text": "All I ever do is fly flat out!",
      "status": "imported"
    },
    "voice_027:r_76d1e51c8b494a60": {
      "text": "If I take out the turret!",
      "status": "imported"
    },
    "voice_027:r_eb5f687fcd372ae7": {
      "text": "Ghost or whatever you are!",
      "status": "imported"
    },
    "voice_027:r_2329428a6871d9fa": {
      "text": "Even against a V-9!",
      "status": "imported"
    },
    "voice_027:r_0e7466971bec4cc4": {
      "text": "You're just like the Vajra!",
      "status": "imported"
    },
    "voice_027:r_efa71f7a4cc33ff3": {
      "text": "Drop dead, monster!",
      "status": "imported"
    },
    "voice_027:r_3fc2e1186557e7a0": {
      "text": "There are so many...! But still!",
      "status": "imported"
    },
    "voice_027:r_fa6930340a545054": {
      "text": "Not all will follow your script...!",
      "status": "imported"
    },
    "voice_027:r_2332b9d56461d7ab": {
      "text": "I'll defy any fate I don't like!",
      "status": "imported"
    },
    "voice_027:r_854aa0a91a3c80d1": {
      "text": "I fled once...!\\nNow I must stand!",
      "status": "imported"
    },
    "voice_027:r_0bc8ae32a406ceab": {
      "text": "Not a single wasted movement...!",
      "status": "imported"
    },
    "voice_027:r_82c09f011d703b2c": {
      "text": "It traces\\ntheir own footwork?!",
      "status": "imported"
    },
    "voice_027:r_2b4d8818c77b6dca": {
      "text": "You won't take our world\\nor our sky!",
      "status": "imported"
    },
    "voice_027:r_087354f2db0a31e6": {
      "text": "All I've lived, I fly!\\nFor tomorrow!",
      "status": "imported"
    },
    "voice_027:r_c4f11aa93dc5b668": {
      "text": "Reaction Missile!",
      "status": "imported"
    },
    "voice_027:r_ce1a22dfe3a4d339": {
      "text": "Skull 4 here. Enemy destroyed!",
      "status": "imported"
    },
    "voice_027:r_240651adab81e145": {
      "text": "All right, permission granted...!",
      "status": "imported"
    },
    "voice_027:r_cff0deaae73c2858": {
      "text": "...Did it work?",
      "status": "imported"
    },
    "voice_027:r_dca67f68a573fab7": {
      "text": "Reaction Missile, fire!",
      "status": "imported"
    },
    "voice_027:r_6f94566ad37f8ff8": {
      "text": "With this thing's output!",
      "status": "imported"
    },
    "voice_027:r_942ca03c9de80143": {
      "text": "Right heeeeere!",
      "status": "imported"
    },
    "voice_027:r_d8c669c70659e18a": {
      "text": "All right...!",
      "status": "imported"
    },
    "voice_027:r_8f5bade7ac2db78e": {
      "text": "I'll finish you with one shot!",
      "status": "imported"
    },
    "voice_027:r_05ea490d2f522520": {
      "text": "Take thiiiiis!",
      "status": "imported"
    },
    "voice_027:r_f5658c702d91db7a": {
      "text": "That's one down!",
      "status": "imported"
    },
    "voice_027:r_686df329b50f195b": {
      "text": "Once I know where you are!",
      "status": "imported"
    },
    "voice_027:r_25f0ab0fa3cf690c": {
      "text": "I'll catch up to you!",
      "status": "imported"
    },
    "voice_027:r_b708a1d959013dbf": {
      "text": "You fell for the bait...!",
      "status": "imported"
    },
    "voice_027:r_59fca03e929366c1": {
      "text": "We're not doing this for fun either!",
      "status": "imported"
    },
    "voice_027:r_0d65eb631dcb7514": {
      "text": "I can't allow any more damage!",
      "status": "imported"
    },
    "voice_027:r_d03018a31e23f1e9": {
      "text": "It's still too soon to launch!",
      "status": "imported"
    },
    "voice_027:r_279da5f732aa8847": {
      "text": "Good position, Michel!",
      "status": "imported"
    },
    "voice_027:r_97f82e3cb6f70110": {
      "text": "Skull 4 to Quarter. I'll take it!",
      "status": "imported"
    },
    "voice_027:r_c5611d8dd6def96b": {
      "text": "So that's how a Zentran fights...!",
      "status": "imported"
    },
    "voice_027:r_6f12cc8ed2732eb5": {
      "text": "I'll go!",
      "status": "imported"
    },
    "voice_027:r_7abfc55f8fb62ba7": {
      "text": "Leave the handoff to me!",
      "status": "imported"
    },
    "voice_027:r_99e7a66c650b5892": {
      "text": "Hold still! I'll stop that attack!",
      "status": "imported"
    },
    "voice_027:r_5b2247b5cfbcd7b2": {
      "text": "Wake up! The enemy's coming!",
      "status": "imported"
    },
    "voice_027:r_2d7a9c06347582d9": {
      "text": "Captain falls, morale will suffer!",
      "status": "imported"
    },
    "voice_027:r_bf953d64c3c7d9b7": {
      "text": "A sniper's eyes are their lifeline!",
      "status": "imported"
    },
    "voice_027:r_e09b933e3e706779": {
      "text": "Luca! That was reckless!",
      "status": "imported"
    },
    "voice_027:r_66236eb99b676e5b": {
      "text": "Doesn't your Zentran blood cry out?!",
      "status": "imported"
    },
    "voice_027:r_9639a2dbcd2f58ed": {
      "text": "I won't let you take the Quarter!",
      "status": "imported"
    },
    "voice_027:r_aeea0893acb93d35": {
      "text": "Damn! What the hell is going on...?!",
      "status": "imported"
    },
    "voice_027:r_b31568654e53487b": {
      "text": "Do I have to let it go?!",
      "status": "imported"
    },
    "voice_027:r_2502132569141ea3": {
      "text": "Of all the times...!",
      "status": "imported"
    },
    "voice_027:r_1ff312798a52c8eb": {
      "text": "I can't aim from here...!",
      "status": "imported"
    },
    "voice_027:r_fa07d90fca62f593": {
      "text": "So you've come!",
      "status": "imported"
    },
    "voice_027:r_a25bf2676ecf9d83": {
      "text": "Like I'd screw this up!",
      "status": "imported"
    },
    "voice_027:r_237a0288b42dce20": {
      "text": "That's not gonna happen!",
      "status": "imported"
    },
    "voice_027:r_0556e8a22779ea8e": {
      "text": "You dare make a fool of me...!",
      "status": "imported"
    },
    "voice_027:r_09d377101a48d92a": {
      "text": "Don't underestimate a flying pro!",
      "status": "imported"
    },
    "voice_027:r_11517cc7b0494dbf": {
      "text": "Practice beats theory!",
      "status": "imported"
    },
    "voice_027:r_b5864501463db244": {
      "text": "Don't think... Just feel it!",
      "status": "imported"
    },
    "voice_027:r_a88939ea84b4474d": {
      "text": "Wow!\\nCaptain was right. It's great!",
      "status": "imported"
    },
    "voice_027:r_a870d0cf7cc11ec6": {
      "text": "I've got to master the new model...!",
      "status": "imported"
    },
    "voice_027:r_03f6158ef83964f3": {
      "text": "Damn it! That Vajra...!",
      "status": "imported"
    },
    "voice_027:r_2970a83693cdcc25": {
      "text": "Adding that gear was the right call!",
      "status": "imported"
    },
    "voice_027:r_be661448b85d0009": {
      "text": "With this on my side!",
      "status": "imported"
    },
    "voice_027:r_958a56c1151cab9e": {
      "text": "If I can use the Pinpoint Barrier!",
      "status": "imported"
    },
    "voice_027:r_8b18aa4cc69547df": {
      "text": "Tch! You bastard!",
      "status": "imported"
    },
    "voice_027:r_3e87f6fc3ea65aef": {
      "text": "That was nothing!",
      "status": "imported"
    },
    "voice_027:r_5508a7bfa9074eb9": {
      "text": "I'll definitely dodge the next one!",
      "status": "imported"
    },
    "voice_027:r_09a003e91f0d5dc7": {
      "text": "Is that all you've got?!",
      "status": "imported"
    },
    "voice_027:r_192447448ebd7bb5": {
      "text": "This is\\nits boosted shield power...!",
      "status": "imported"
    },
    "voice_027:r_e92920ba4b301b9f": {
      "text": "Ngh! Damn iiit!",
      "status": "imported"
    },
    "voice_027:r_207b256d613bb896": {
      "text": "Guh! What the hell was that...?!",
      "status": "imported"
    },
    "voice_027:r_a6fd676d8146501b": {
      "text": "Checking all systems... I can go on!",
      "status": "imported"
    },
    "voice_027:r_94d35e5fa8e3a198": {
      "text": "They aimed right where it hurts...!",
      "status": "imported"
    },
    "voice_027:r_b686510e636673f3": {
      "text": "Like I'd tire out from that!",
      "status": "imported"
    },
    "voice_027:r_59369bad143d4272": {
      "text": "Damn...!\\nMy skill's not enough?!",
      "status": "imported"
    },
    "voice_027:r_25f9b1e39dd8d366": {
      "text": "Even this can't shake them...?!",
      "status": "imported"
    },
    "voice_027:r_307477bedd148060": {
      "text": "Ugh!\\nI won't lose the new model!",
      "status": "imported"
    },
    "voice_027:r_09a780acca0eb4b0": {
      "text": "However bad things get,\\nI won't run!",
      "status": "imported"
    },
    "voice_027:r_af62f2ee466b5c8c": {
      "text": "Guh...!\\nMy wings aren't broken...!",
      "status": "imported"
    },
    "voice_027:r_20cfb719db02fafd": {
      "text": "Not yet! I can still fly!",
      "status": "imported"
    },
    "voice_027:r_570c1fdf72edb283": {
      "text": "Damn...!\\nI can barely stay level!",
      "status": "imported"
    },
    "voice_027:r_23f0d87a5a6cfca1": {
      "text": "Engine's alive.\\nI'll find a way...!",
      "status": "imported"
    },
    "voice_027:r_60c94ea4eb7f7404": {
      "text": "Can't I handle this thing...?!",
      "status": "imported"
    },
    "voice_027:r_727b2ee0277f9159": {
      "text": "Gah! Damn...\\nNot the new model...!",
      "status": "imported"
    },
    "voice_027:r_cff4d2eae8a939ed": {
      "text": "Ngh! Damn you, Vajraaa!",
      "status": "imported"
    },
    "voice_027:r_1428fe5f35a9427b": {
      "text": "This is it...! Everyone, forgive me!",
      "status": "imported"
    },
    "voice_027:r_96d39b8bdfa6f183": {
      "text": "This is bad...! Ejecting!",
      "status": "imported"
    },
    "voice_027:r_0e4f9b8a2d26ebff": {
      "text": "You can't match\\nTornado's mobility!",
      "status": "imported"
    },
    "voice_027:r_79e0d542fe12bcf7": {
      "text": "I'll unlock the Tornado's power!",
      "status": "imported"
    },
    "voice_027:r_eff747ba39a55393": {
      "text": "They entrusted me with new gear...!",
      "status": "imported"
    },
    "voice_027:r_b2dc77aa6dd77e69": {
      "text": "Tornado Pack...! Not bad!",
      "status": "imported"
    },
    "voice_027:r_445d40d8b5d7092b": {
      "text": "YF-29...! I can win with this!",
      "status": "imported"
    },
    "voice_027:r_bbb633cb5e8e6daf": {
      "text": "This machine...! It suits me!",
      "status": "imported"
    },
    "voice_027:r_0abd8b6c713ccdac": {
      "text": "I'll draw out all of its power!",
      "status": "imported"
    },
    "voice_027:r_f4ff463b2fda1b86": {
      "text": "Captain Quattro!\\nWhat's your goal?!",
      "status": "imported"
    },
    "voice_027:r_4e63c037d3cb8a3d": {
      "text": "I won't hold back, Red Comet!",
      "status": "imported"
    },
    "voice_027:r_9ca8d188ae805e3a": {
      "text": "Even against a Gundam, I'll win!",
      "status": "imported"
    },
    "voice_027:r_795ed21f3e28e1f5": {
      "text": "Another seeks\\nto surpass humanity?!",
      "status": "imported"
    },
    "voice_027:r_141415c1def5ab2d": {
      "text": "Why fight\\nat a time like this...!",
      "status": "imported"
    },
    "voice_027:r_79b1abf5fc86483c": {
      "text": "Fighting among humans is obsolete!",
      "status": "imported"
    },
    "voice_027:r_d52bece55796f599": {
      "text": "Earth won't become a dead world!",
      "status": "imported"
    },
    "voice_027:r_358fe5a50bbee1df": {
      "text": "I have to avoid the vital points...!",
      "status": "imported"
    },
    "voice_027:r_638834e16724002f": {
      "text": "I'm desperate too...! Don't hate me!",
      "status": "imported"
    },
    "voice_027:r_b02fca1590ac1210": {
      "text": "You thugs abduct women by force...!",
      "status": "imported"
    },
    "voice_027:r_f0344d2fbaa9db77": {
      "text": "Mikage! I'll defeat you myself!",
      "status": "imported"
    },
    "voice_027:r_3328eef766ff2c2c": {
      "text": "I won't listen to a word you say!",
      "status": "imported"
    },
    "voice_027:r_23b037cf6ccc695c": {
      "text": "I'm used to\\nthis nonsense...!",
      "status": "imported"
    },
    "voice_027:r_883ad1128d340c5e": {
      "text": "I won't lose, no matter who I face!",
      "status": "imported"
    },
    "voice_027:r_a9e6ed99025a703b": {
      "text": "The Root of Calamity... Baal?!",
      "status": "imported"
    },
    "voice_027:r_cd4893b409472e97": {
      "text": "Humanity always overcomes despair!",
      "status": "imported"
    },
    "voice_027:r_964e07c5563a5508": {
      "text": "Why won't you hear the song?!",
      "status": "imported"
    },
    "voice_027:r_db54e717bff3e3b2": {
      "text": "Why can't they\\nunderstand us?!",
      "status": "imported"
    },
    "voice_027:r_fcab8d80aef7e9d8": {
      "text": "Can we never\\nunderstand Vajra...?!",
      "status": "imported"
    },
    "voice_027:r_2174bd0edc164171": {
      "text": "I won't lose a contest of speed!",
      "status": "imported"
    },
    "voice_027:r_ad54419336b49578": {
      "text": "I won't lag behind in aerial combat!",
      "status": "imported"
    },
    "voice_027:r_63c353e1e05e8e39": {
      "text": "I'm sick of your lofty lectures!",
      "status": "imported"
    },
    "voice_027:r_87646dd472438e88": {
      "text": "Brute force\\nwon't solve a thing...!",
      "status": "imported"
    },
    "voice_027:r_4e32ac89cba02001": {
      "text": "It's the last fight...! Full power!",
      "status": "imported"
    },
    "voice_027:r_9331c2c2ef55c78f": {
      "text": "Your cowardly tactics end here!",
      "status": "imported"
    },
    "voice_027:r_49734bdb3507acf7": {
      "text": "You'll pay\\nfor watching from above!",
      "status": "imported"
    },
    "voice_027:r_cdfaf9cd1fd55c77": {
      "text": "Same club...! I'll lend a hand!",
      "status": "imported"
    },
    "voice_027:r_3d2454ac7a0fed22": {
      "text": "This counts as volunteer work too!",
      "status": "imported"
    },
    "voice_027:r_437f5e90c3bb0592": {
      "text": "Amata! Get it together!",
      "status": "imported"
    },
    "voice_027:r_cf9a2e6954ba3564": {
      "text": "Major Graham, I'll cover you!",
      "status": "imported"
    },
    "voice_027:r_a9474d20d8dd3193": {
      "text": "That pilot...! We're in sync!",
      "status": "imported"
    },
    "voice_027:r_d1b635ea0c0c2d67": {
      "text": "I won't abandon a clubmate...!",
      "status": "imported"
    },
    "voice_027:r_b8b0c93fd828bea6": {
      "text": "This is the spirit of service...!",
      "status": "imported"
    },
    "voice_027:r_eb6326b22b74aaf5": {
      "text": "Stop drifting around, Amata!",
      "status": "imported"
    },
    "voice_027:r_4561a1a3695f1597": {
      "text": "I can't let them take you down!",
      "status": "imported"
    },
    "voice_027:r_e756cef3d5de51e9": {
      "text": "Whew... Today's battle was rough...",
      "status": "imported"
    },
    "voice_027:r_e65d29f740ec5a07": {
      "text": "...",
      "status": "imported"
    },
    "voice_027:r_25b3885e2565f90b": {
      "text": "I never knew solitude felt lonely...",
      "status": "imported"
    },
    "voice_027:r_96858669715407f1": {
      "text": "But the game has friends - you too.",
      "status": "imported"
    },
    "voice_027:r_2bb2a166baa517b9": {
      "text": "I'll wait to fly Z3 with you again!",
      "status": "imported"
    },
    "voice_027:r_34be00b434b42bea": {
      "text": "Thank you, Major Graham.",
      "status": "imported"
    },
    "voice_027:r_5b9baad61908571a": {
      "text": "Beside you, I feel we're twin wings.",
      "status": "imported"
    },
    "voice_027:r_7eedcce1036b4f4a": {
      "text": "That would be...!",
      "status": "imported"
    },
    "voice_027:r_e016bd611281c0a6": {
      "text": "I-I think I'll pass, thank you!",
      "status": "imported"
    },
    "voice_027:r_aa211e3c1f473e51": {
      "text": "Who the hell are you?!",
      "status": "imported"
    },
    "voice_027:r_c07813b8d06a7217": {
      "text": "Just so you know, I'm a man!",
      "status": "imported"
    },
    "voice_027:r_81a6bca77bc301c0": {
      "text": "Y-you! Help! Get back in-game now!",
      "status": "imported"
    },
    "voice_027:r_56edc0d4b579afd1": {
      "text": "Sheryl...! Ranka...!",
      "status": "imported"
    },
    "voice_027:r_2a8d41aa8f4749ec": {
      "text": "Skull 4, taking point!",
      "status": "imported"
    },
    "voice_027:r_01c80710474b30ae": {
      "text": "I'll make the first move!",
      "status": "imported"
    },
    "voice_027:r_870a7c766b4e2144": {
      "text": "If we concentrate our attacks...!",
      "status": "imported"
    },
    "voice_027:r_a9f39df34c38f5b3": {
      "text": "I'll play the supporting role...!",
      "status": "imported"
    },
    "voice_027:r_c9f83672cc4c8866": {
      "text": "Skull 4, roger!",
      "status": "imported"
    },
    "voice_027:r_19631c3492e99773": {
      "text": "Don't worry about me!",
      "status": "imported"
    },
    "voice_027:r_a49cb27d62c078ed": {
      "text": "I'm the one you're fighting!",
      "status": "imported"
    },
    "voice_027:r_aa6642a8b00c07f9": {
      "text": "You don't have time to look away!",
      "status": "imported"
    },
    "voice_027:r_b6a1f76ff2f0b93d": {
      "text": "I won't settle for stalling you!",
      "status": "imported"
    },
    "voice_027:r_16669b320b466ffb": {
      "text": "I'm aiming dead center!",
      "status": "imported"
    },
    "voice_027:r_50c7272601f9608b": {
      "text": "As if I'd ever screw up!",
      "status": "imported"
    },
    "voice_027:r_9783be4881baaf30": {
      "text": "That's the one. All right!",
      "status": "imported"
    },
    "voice_027:r_7a533f3a77a702e3": {
      "text": "I'll draw out its full performance!",
      "status": "imported"
    },
    "voice_027:r_f13d4928e70aad04": {
      "text": "Raaaaagh!",
      "status": "imported"
    },
    "voice_027:r_bf8c22ddf5e5ebc4": {
      "text": "Guuuuh...!",
      "status": "imported"
    },
    "voice_027:r_323506822dc933d1": {
      "text": "Enemy unit, destroyed!",
      "status": "imported"
    },
    "voice_027:r_a60677a64d47d57d": {
      "text": "I can do this! I'm a pilot!",
      "status": "imported"
    },
    "voice_027:r_d99d6b303b9eca7a": {
      "text": "This one too...!",
      "status": "imported"
    },
    "voice_027:r_46e646d7ceafbf12": {
      "text": "Take this with you!",
      "status": "imported"
    },
    "voice_027:r_2f49681a2d6f9e2b": {
      "text": "All right, withdrawing!",
      "status": "imported"
    },
    "voice_027:r_645e1e5c1c16c791": {
      "text": "With this thing's speed!",
      "status": "imported"
    },
    "voice_027:r_f8ed7cb3cc3d3275": {
      "text": "Bring on any high speed battle!",
      "status": "imported"
    },
    "voice_027:r_497ecb7603305283": {
      "text": "I'll finish this in one go!",
      "status": "imported"
    },
    "voice_027:r_4ae43494550cddb4": {
      "text": "Operation complete!",
      "status": "imported"
    }
  }
}
