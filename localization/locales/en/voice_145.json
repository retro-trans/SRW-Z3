{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_145:r_479b340ccc6c572b": {
      "text": "Got it!",
      "status": "imported"
    },
    "voice_145:r_ca4acbac57a2a35e": {
      "text": "One shot, coming right up!",
      "status": "imported"
    },
    "voice_145:r_77949221bf58f862": {
      "text": "I'll nail you head-on!!",
      "status": "imported"
    },
    "voice_145:r_70b9c4b9f1f37eff": {
      "text": "Witness a genius Beck miracle!",
      "status": "imported"
    },
    "voice_145:r_9fcb3754cb1773c7": {
      "text": "Get ready!\\nNow you can't escape!",
      "status": "imported"
    },
    "voice_145:r_3559d2fad32c2435": {
      "text": "Hahaha! This one's mine!",
      "status": "imported"
    },
    "voice_145:r_f7570547e9f80a64": {
      "text": "My memory of you\\nvanishes now!",
      "status": "imported"
    },
    "voice_145:r_cbab0f4720e1fcf1": {
      "text": "This is the end!",
      "status": "imported"
    },
    "voice_145:r_0bbe0b4f5364e732": {
      "text": "No rage or grief!\\nThe sun's enough!!",
      "status": "imported"
    },
    "voice_145:r_5dda5198137cb02a": {
      "text": "No time to run!",
      "status": "imported"
    },
    "voice_145:r_83ec59afbecdec14": {
      "text": "Useless, useless!\\nNo escape works!",
      "status": "imported"
    },
    "voice_145:r_e20bfd42ad95a3c9": {
      "text": "What? You're still way over there?",
      "status": "imported"
    },
    "voice_145:r_0f58a8822381e57f": {
      "text": "Boss! This is our chance!",
      "status": "imported"
    },
    "voice_145:r_6dbcc507fb61b51d": {
      "text": "Now it's our turn!",
      "status": "imported"
    },
    "voice_145:r_b42ab697149a7c8a": {
      "text": "Time to make a huge splash!",
      "status": "imported"
    },
    "voice_145:r_4de4fcf3b440baf4": {
      "text": "The great Beck will finish you!",
      "status": "imported"
    },
    "voice_145:r_0121a166c715cdff": {
      "text": "What the heck are you doing?!",
      "status": "imported"
    },
    "voice_145:r_30fad37a42bd3ad3": {
      "text": "Bad luck!\\nYou drew the great me!",
      "status": "imported"
    },
    "voice_145:r_80a0b2a84e05d81a": {
      "text": "Thanks for my chance to shine!",
      "status": "imported"
    },
    "voice_145:r_4a9ac1dff86506d9": {
      "text": "My turn!\\nI'll steal the whole show!",
      "status": "imported"
    },
    "voice_145:r_bc8538e6af3d2577": {
      "text": "See that?! A genius dodge!",
      "status": "imported"
    },
    "voice_145:r_924516c8de2b5342": {
      "text": "I'm just so smooth!",
      "status": "imported"
    },
    "voice_145:r_da1174533722333f": {
      "text": "I can see your attack coming!",
      "status": "imported"
    },
    "voice_145:r_fdeb8162976e72c1": {
      "text": "Are you even aiming, crow bastard?!",
      "status": "imported"
    },
    "voice_145:r_0fadb5c26df92b42": {
      "text": "Pathetic!\\nParadigm's ace negotiator!",
      "status": "imported"
    },
    "voice_145:r_6b15af9a0057cdc8": {
      "text": "See that? My robot's the best!",
      "status": "imported"
    },
    "voice_145:r_15b4a90140e8a33a": {
      "text": "Useless, useless! Quit attacking!",
      "status": "imported"
    },
    "voice_145:r_af884a6b11dff121": {
      "text": "Sheesh, can't you do it smoothly?",
      "status": "imported"
    },
    "voice_145:r_ac6fe7838e95647b": {
      "text": "What? Are you even trying?",
      "status": "imported"
    },
    "voice_145:r_77ca87eacd17ad52": {
      "text": "Weak, weak!\\nWhat a pathetic attack!",
      "status": "imported"
    },
    "voice_145:r_bf3244994760e535": {
      "text": "What's up, crow bastard?!\\nOff today?",
      "status": "imported"
    },
    "voice_145:r_aabfb21c9d069ce7": {
      "text": "Hah! You're all talk,\\nnegotiator!",
      "status": "imported"
    },
    "voice_145:r_02479dc8fe989560": {
      "text": "Damn fool! You'll pay for that!",
      "status": "imported"
    },
    "voice_145:r_a2df00f91a9b0a9e": {
      "text": "That hurt, you bastard!",
      "status": "imported"
    },
    "voice_145:r_48b60d6c48b9b142": {
      "text": "Attack me,\\nget the worst sentence!",
      "status": "imported"
    },
    "voice_145:r_8927e6fb681aa809": {
      "text": "W-What the hell?!\\nWhat's going on?!",
      "status": "imported"
    },
    "voice_145:r_665f01666859013b": {
      "text": "Too close!\\nOne hit and I'd be dead!",
      "status": "imported"
    },
    "voice_145:r_a571eec59b258d11": {
      "text": "Again and again,\\nyou won't catch me!",
      "status": "imported"
    },
    "voice_145:r_ddbe581c5ea9183d": {
      "text": "Roger!\\nYou scratched my robot!",
      "status": "imported"
    },
    "voice_145:r_faae935cca0edc72": {
      "text": "I-I'm in biiiiig trouble!!",
      "status": "imported"
    },
    "voice_145:r_d4430bf362340b32": {
      "text": "Damn you, idiot!!\\nEnough already!",
      "status": "imported"
    },
    "voice_145:r_6ff1323b355593e0": {
      "text": "No! They're\\noutdoing even me...?!",
      "status": "imported"
    },
    "voice_145:r_b7b5625d7cd4282f": {
      "text": "What?!\\nMy robot's falling apart!!",
      "status": "imported"
    },
    "voice_145:r_36133ad73a73ef98": {
      "text": "Close! Sideburns...\\nNo, forget it!",
      "status": "imported"
    },
    "voice_145:r_920740a0219c5085": {
      "text": "Damn!!\\nNot enough units combined?!",
      "status": "imported"
    },
    "voice_145:r_a8451712c57c1a72": {
      "text": "Megadeus...!\\nHow strong is it?!",
      "status": "imported"
    },
    "voice_145:r_3633df5b7b8f47fa": {
      "text": "Damn crow bastard!\\nYou got me good!",
      "status": "imported"
    },
    "voice_145:r_52dfc56b14b93551": {
      "text": "Damn... My... robot...",
      "status": "imported"
    },
    "voice_145:r_1b9b2aab5cb104da": {
      "text": "Damn it! I'm the blasted fool here!",
      "status": "imported"
    },
    "voice_145:r_342044c706a2340f": {
      "text": "Crow bastard!\\nYou're finished too!",
      "status": "imported"
    },
    "voice_145:r_cf41e8828a90cbdb": {
      "text": "Show me your skill,\\nnegotiator!",
      "status": "imported"
    },
    "voice_145:r_719e897304ec42d4": {
      "text": "I hate anything black!",
      "status": "imported"
    },
    "voice_145:r_d5e0a2317c40d322": {
      "text": "Black bastards\\nreally tick me off!",
      "status": "imported"
    },
    "voice_145:r_065443f6ddfcf0d7": {
      "text": "Bro, the enemy's over there!",
      "status": "imported"
    },
    "voice_145:r_47d52a2839c71715": {
      "text": "Heh! They're in the perfect spot!",
      "status": "imported"
    },
    "voice_145:r_847f82e7f3eef651": {
      "text": "All right, let's go crush them!",
      "status": "imported"
    },
    "voice_145:r_857c4a52ce8df0fd": {
      "text": "All right! Charge straight in!!",
      "status": "imported"
    },
    "voice_145:r_55417493fce1d347": {
      "text": "Aye aye, sir!",
      "status": "imported"
    },
    "voice_145:r_8fdf5910927c9591": {
      "text": "Let's do it! We'll smash them flat!",
      "status": "imported"
    },
    "voice_145:r_7d724dbcc4451e10": {
      "text": "Okaaay!",
      "status": "imported"
    },
    "voice_145:r_93e25418a203cb8f": {
      "text": "Bro, we're in real trouble now...",
      "status": "imported"
    },
    "voice_145:r_adeb0a29274d3d9b": {
      "text": "I know!\\nJust keep looking ahead!",
      "status": "imported"
    },
    "voice_145:r_24cf161287ef9d5c": {
      "text": "What do we do, Bro?!",
      "status": "imported"
    },
    "voice_145:r_8f60f6fc86db3107": {
      "text": "Enough!\\nDon't sound so pathetic!",
      "status": "imported"
    },
    "voice_145:r_b1de76a75a253c13": {
      "text": "B-Boss, what do we do?!",
      "status": "imported"
    },
    "voice_145:r_128c35bf3e0e394c": {
      "text": "Idiots!!\\nGet ready to run!",
      "status": "imported"
    },
    "voice_145:r_5213c17e13b23de0": {
      "text": "I won't go down like this!",
      "status": "imported"
    },
    "voice_145:r_38fdff9483e9245c": {
      "text": "Focus, Dove!\\nWe're okay. Maybe...",
      "status": "imported"
    },
    "voice_145:r_620fedec67706d7d": {
      "text": "Oh no! The armor's full of dents!",
      "status": "imported"
    },
    "voice_145:r_9680dcd0fddcfcc7": {
      "text": "Damn!\\nThis could be bad...!",
      "status": "imported"
    },
    "voice_145:r_2a00f1044ad5cbaa": {
      "text": "Tch! They're\\nbattle-hardened...!",
      "status": "imported"
    },
    "voice_145:r_3dbeead1bd3164ef": {
      "text": "Can we beat someone like that?",
      "status": "imported"
    },
    "voice_145:r_98d15b8cc09bc915": {
      "text": "Whew. Glad that was all it did.",
      "status": "imported"
    },
    "voice_145:r_46e86d000250e137": {
      "text": "Well, now you see the skill gap.",
      "status": "imported"
    },
    "voice_145:r_ac341e7976e88f0b": {
      "text": "Keh! Don't mess with us!",
      "status": "imported"
    },
    "voice_145:r_cdbd128a5b4127cc": {
      "text": "They really are making fools of us.",
      "status": "imported"
    },
    "voice_145:r_cfccaa1fbeda124c": {
      "text": "Huh?\\nT-Bone, did that hit us?",
      "status": "imported"
    },
    "voice_145:r_b1f8ec192b9c083a": {
      "text": "Nothing to worry about, Boss.",
      "status": "imported"
    },
    "voice_145:r_a007f9ab9cf048b3": {
      "text": "Evasion successful!",
      "status": "imported"
    },
    "voice_145:r_ddafde4b065ced49": {
      "text": "You're way too cool, Bro!",
      "status": "imported"
    },
    "voice_145:r_de1213040856c089": {
      "text": "This is our true strength!",
      "status": "imported"
    },
    "voice_145:r_3304412ac41f47a6": {
      "text": "All right!\\nLet's keep this going!",
      "status": "imported"
    },
    "voice_145:r_0c0775e051211840": {
      "text": "Tch! We're sunk at this rate!",
      "status": "imported"
    },
    "voice_145:r_a2afffe1c396f0b3": {
      "text": "I don't want that! No, no!",
      "status": "imported"
    },
    "voice_145:r_13c25fbdfddc8a24": {
      "text": "You bastard! Fight fair and square!",
      "status": "imported"
    },
    "voice_145:r_42ba1ecb310b4bd7": {
      "text": "That's rich,\\ncoming from us...",
      "status": "imported"
    },
    "voice_145:r_d692f1d420460a47": {
      "text": "Did we fire too much...?!",
      "status": "imported"
    },
    "voice_145:r_a5643cec86b18bd2": {
      "text": "So, how should we resupply?",
      "status": "imported"
    },
    "voice_145:r_68f2dfab20a4a30e": {
      "text": "B-Boss! We're out of energy!",
      "status": "imported"
    },
    "voice_145:r_9cedad8237480563": {
      "text": "What?!\\nThen we're sitting ducks!",
      "status": "imported"
    },
    "voice_145:r_dad38ee29af2df3a": {
      "text": "Ugh! Now we can't do anything!",
      "status": "imported"
    },
    "voice_145:r_3d32e86f8dc80909": {
      "text": "Dove!\\nQuit griping and get to work!",
      "status": "imported"
    },
    "voice_145:r_d996fd6d4ef5b329": {
      "text": "Dove! T-Bone!\\nFinal Together, now!",
      "status": "imported"
    },
    "voice_145:r_8ab47a28f99ef565": {
      "text": "We haven't even practiced once...!",
      "status": "imported"
    },
    "voice_145:r_546de3fb6db156ea": {
      "text": "That's right. Let's show them!",
      "status": "imported"
    },
    "voice_145:r_ca85f87cee5e31f7": {
      "text": "Let's do this nice and smooth!",
      "status": "imported"
    },
    "voice_145:r_9072ea7bc71df136": {
      "text": "Here I come, crow bastard!",
      "status": "imported"
    },
    "voice_145:r_3c5b0c2ac812d5de": {
      "text": "And now, the star takes the stage!",
      "status": "imported"
    },
    "voice_145:r_5b9e8897190892eb": {
      "text": "W-We're finished, Boss!",
      "status": "imported"
    },
    "voice_145:r_7bea3023abbf8a94": {
      "text": "Damn it all! You'll pay for this!",
      "status": "imported"
    },
    "voice_145:r_dd01a4c0d1b36a8d": {
      "text": "Damn it!\\nAt this point... Eject!!",
      "status": "imported"
    },
    "voice_145:r_20920ad2eb3542db": {
      "text": "I-I knew it?!",
      "status": "imported"
    },
    "voice_145:r_0ab7914877fd48ed": {
      "text": "W-What is it?!\\nWhat the hell?!",
      "status": "imported"
    },
    "voice_145:r_cb846feec748c2e3": {
      "text": "Damn it, you two!\\nGet to work!",
      "status": "imported"
    },
    "voice_145:r_c958860b0676b1f5": {
      "text": "E-Even if you say that...",
      "status": "imported"
    },
    "voice_145:r_5e2669b82ef75ce3": {
      "text": "You've really done it now!",
      "status": "imported"
    },
    "voice_145:r_7847e0ed7dc9282d": {
      "text": "Cool pose, and this?!\\nHow lame...!",
      "status": "imported"
    },
    "voice_145:r_e42b52c7a987b906": {
      "text": "Why must a genius like me suffer?!",
      "status": "imported"
    },
    "voice_145:r_6825fd1ff907bd22": {
      "text": "They're jealous of your genius, Bro.",
      "status": "imported"
    },
    "voice_145:r_607f666f1563bc0d": {
      "text": "Shut up, you small fry!",
      "status": "imported"
    },
    "voice_145:r_97b7431eeb81e6b6": {
      "text": "Amazing! It did nothing!",
      "status": "imported"
    },
    "voice_145:r_132f605d02975e71": {
      "text": "Of course!\\nIt's my robot, after all!",
      "status": "imported"
    },
    "voice_145:r_9b9726b1872759d6": {
      "text": "Up we go! And a little hop!",
      "status": "imported"
    },
    "voice_145:r_1252db29683fefe0": {
      "text": "My brain's in a different league!",
      "status": "imported"
    },
    "voice_145:r_ad3d538f1e909184": {
      "text": "Don't compare it to my old machine!",
      "status": "imported"
    },
    "voice_145:r_8c61c59a1c0aebbf": {
      "text": "The world has stuff like this!",
      "status": "imported"
    },
    "voice_145:r_aba6a7662129d8ce": {
      "text": "Hehehe! This'll come in handy!",
      "status": "imported"
    },
    "voice_145:r_391aa56435d9dd6e": {
      "text": "Yahoo!",
      "status": "imported"
    },
    "voice_145:r_fa944da4b6519006": {
      "text": "Defy me?\\nYou've got guts!",
      "status": "imported"
    },
    "voice_145:r_95d047bcc17fccc6": {
      "text": "Hehe! All according to my plan!",
      "status": "imported"
    },
    "voice_145:r_640327a12a559b31": {
      "text": "Finishing move!\\nFingeeeer Beeeeam!",
      "status": "imported"
    },
    "voice_145:r_bdd38c584fa313d0": {
      "text": "A little flick from my fingertip!",
      "status": "imported"
    },
    "voice_145:r_3fd86c1027f317c8": {
      "text": "Boss! We're ready!",
      "status": "imported"
    },
    "voice_145:r_d0372a183d2007ad": {
      "text": "Take this!\\nUltimate Finger Attack!!",
      "status": "imported"
    },
    "voice_145:r_217aa5e1d545b44d": {
      "text": "Finger Attack!!",
      "status": "imported"
    },
    "voice_145:r_381992c5d8224937": {
      "text": "Here I go!",
      "status": "imported"
    },
    "voice_145:r_f1e7ed9e5874aba5": {
      "text": "You'll die exactly as you deserve!",
      "status": "imported"
    },
    "voice_145:r_fc25e66a86fc2c85": {
      "text": "I'm running! Or so you thought...!",
      "status": "imported"
    },
    "voice_145:r_5aeeb4917340c42d": {
      "text": "I'm about to teach you a lesson!",
      "status": "imported"
    },
    "voice_145:r_b765659981b6516d": {
      "text": "Show us how pathetic you are!",
      "status": "imported"
    },
    "voice_145:r_0c427458bc00eb95": {
      "text": "To hell with a 723-year sentence!",
      "status": "imported"
    },
    "voice_145:r_774a9ab4d8fd5351": {
      "text": "Last time I'll ever see that mug!",
      "status": "imported"
    },
    "voice_145:r_d3f01de714c015bd": {
      "text": "Defy me,\\ndefy a god!",
      "status": "imported"
    },
    "voice_145:r_7d2617c809fead70": {
      "text": "Whoa there, don't move!",
      "status": "imported"
    },
    "voice_145:r_ceb935ccbf830724": {
      "text": "Your life\\nis mine to take right now!",
      "status": "imported"
    },
    "voice_145:r_862ef7385bf2abd4": {
      "text": "Let's do this,\\nBeck Victory Deluxe!",
      "status": "imported"
    },
    "voice_145:r_001cbec4d9a4283f": {
      "text": "Straight to hell you go!",
      "status": "imported"
    },
    "voice_145:r_8ad40afecd02b41e": {
      "text": "I'll hit you time and again!",
      "status": "imported"
    },
    "voice_145:r_26e5efec03c03d78": {
      "text": "A surly android.\\nThen Roger Smith!",
      "status": "imported"
    },
    "voice_145:r_4ad81e88c7557a8b": {
      "text": "Let's end this now,\\nnegotiator!",
      "status": "imported"
    },
    "voice_145:r_1f65a7af190e4674": {
      "text": "I can't stand any of you!",
      "status": "imported"
    },
    "voice_145:r_40c5a9358ed5bf29": {
      "text": "Goodbye forever, crow bastard!",
      "status": "imported"
    },
    "voice_145:r_f2e18dfdfe0c89ea": {
      "text": "There it is, a Megadeus...!",
      "status": "imported"
    },
    "voice_145:r_cf7dbf49e96a5755": {
      "text": "Who cares if it's a Megadeus?!",
      "status": "imported"
    },
    "voice_145:r_fa96676cc65bb509": {
      "text": "Scrap-metal doll, disappear!",
      "status": "imported"
    },
    "voice_145:r_4e37f92e7d2fc62e": {
      "text": "You're just an oversized doll!",
      "status": "imported"
    },
    "voice_145:r_66ab4cfe1557909d": {
      "text": "The great Beck won't fear a prop!",
      "status": "imported"
    },
    "voice_145:r_0bad405ee6ca63ba": {
      "text": "Gundam or Dumb-dam,\\nwhatever it is!",
      "status": "imported"
    },
    "voice_145:r_2072eaf71a260ae7": {
      "text": "Dialogue lovers\\nmake my skin crawl!",
      "status": "imported"
    },
    "voice_145:r_6c13bbfd27a7799e": {
      "text": "Only your ass needs splitting!",
      "status": "imported"
    },
    "voice_145:r_06f88dcbd3c9e738": {
      "text": "Nice work flying that mobile coffin!",
      "status": "imported"
    },
    "voice_145:r_b28faf9f71bc3598": {
      "text": "Well, well! I'm fighting real scum?!",
      "status": "imported"
    },
    "voice_145:r_8a29278549f8e07a": {
      "text": "I'll finish you for Kan Yu!",
      "status": "imported"
    },
    "voice_145:r_7e6c573c26177f98": {
      "text": "Huh? This isn't a damn zoo!",
      "status": "imported"
    },
    "voice_145:r_edd7a13ab8f06a14": {
      "text": "Quit transforming every which way!",
      "status": "imported"
    },
    "voice_145:r_8165e5b41f0124c4": {
      "text": "Shut up...!\\nSing karaoke elsewhere!",
      "status": "imported"
    },
    "voice_145:r_4e05581b7432cce8": {
      "text": "I'll put your energy\\nto good use!",
      "status": "imported"
    },
    "voice_145:r_72a21a1a489af001": {
      "text": "Leave your pay and get lost!",
      "status": "imported"
    },
    "voice_145:r_9b63cf1f3e0207ef": {
      "text": "Hey! Cut out the flirting!",
      "status": "imported"
    },
    "voice_145:r_8356f4e3dcdff938": {
      "text": "Well, the master swindler appears!",
      "status": "imported"
    },
    "voice_145:r_1d6d784036ae0bd7": {
      "text": "Black smooth-talkers\\nmake me sick!",
      "status": "imported"
    },
    "voice_145:r_625664af02183c17": {
      "text": "Only dig your own grave!",
      "status": "imported"
    },
    "voice_145:r_3701cba361f80ea5": {
      "text": "Viral! You ungrateful bastard!",
      "status": "imported"
    },
    "voice_145:r_63f429c5c68c0863": {
      "text": "My memory\\nsays this one's dangerous!",
      "status": "imported"
    },
    "voice_145:r_38e4a434c91d8ef0": {
      "text": "Your Lambda-whatever is cheating!",
      "status": "imported"
    },
    "voice_145:r_98ed411352a3a6ac": {
      "text": "I'm aiming for the top of crime too!",
      "status": "imported"
    },
    "voice_145:r_4824bea6bab3af67": {
      "text": "Enough!\\nI'm sick of your faces!",
      "status": "imported"
    },
    "voice_145:r_862b92e63adb9734": {
      "text": "You've humiliated me plenty too!",
      "status": "imported"
    },
    "voice_145:r_cb306ef55e49d107": {
      "text": "Fire the Missile!",
      "status": "imported"
    },
    "voice_145:r_57b2bd2de8a1408d": {
      "text": "Take this Missile!",
      "status": "imported"
    },
    "voice_145:r_76f080a4881e8ab5": {
      "text": "Just push the button!",
      "status": "imported"
    },
    "voice_145:r_288133bc5b573dae": {
      "text": "Here you go!",
      "status": "imported"
    },
    "voice_145:r_6f95653e548f8fcf": {
      "text": "There!",
      "status": "imported"
    },
    "voice_145:r_d249d68bada91ab9": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_145:r_e9b3307e9eb69f11": {
      "text": "All mine!",
      "status": "imported"
    },
    "voice_145:r_03cdac73042343ee": {
      "text": "Die!",
      "status": "imported"
    },
    "voice_145:r_6026da5acbda7c69": {
      "text": "Drop dead!",
      "status": "imported"
    },
    "voice_145:r_58dd2826a199ef51": {
      "text": "I know exactly where you are!",
      "status": "imported"
    },
    "voice_145:r_aadc0b2442adb93b": {
      "text": "You won't get away that easily!",
      "status": "imported"
    },
    "voice_145:r_e7a8cd8ed5bc2d1b": {
      "text": "Time for some payback! Lots of it!",
      "status": "imported"
    },
    "voice_145:r_041dd920da4a7c17": {
      "text": "Want mercy? Have money ready!",
      "status": "imported"
    },
    "voice_145:r_c7f4280cde4605b3": {
      "text": "Good, time to counter as planned!",
      "status": "imported"
    },
    "voice_145:r_ec349c8ea9511a18": {
      "text": "Now it's your turn to be humiliated!",
      "status": "imported"
    },
    "voice_145:r_33236ffa3ea95b68": {
      "text": "I've got your back, partner!",
      "status": "imported"
    },
    "voice_145:r_689d0b123de71ae0": {
      "text": "Out of the way, Kan Yu!",
      "status": "imported"
    },
    "voice_145:r_84883aa95f63ce32": {
      "text": "Hold it! You won't hurt my partner!",
      "status": "imported"
    },
    "voice_145:r_25493e978ce8ff16": {
      "text": "We're in this together!",
      "status": "imported"
    },
    "voice_145:r_c4f11aa93dc5b668": {
      "text": "Fine. This too was in my plan!",
      "status": "imported"
    },
    "voice_145:r_ce1a22dfe3a4d339": {
      "text": "Fine!\\nI'll spare you just this once!",
      "status": "imported"
    },
    "voice_145:r_240651adab81e145": {
      "text": "That didn't do a thing!",
      "status": "imported"
    },
    "voice_145:r_dca67f68a573fab7": {
      "text": "See?\\nSuper Gorgeous Barrier's power!",
      "status": "imported"
    },
    "voice_145:r_a6630215fefaf294": {
      "text": "You don't have enough guts! Guts!!",
      "status": "imported"
    },
    "voice_145:r_6f94566ad37f8ff8": {
      "text": "Pathetic! Go home and sleep!",
      "status": "imported"
    },
    "voice_145:r_942ca03c9de80143": {
      "text": "Keh! You're not even worth fighting.",
      "status": "imported"
    },
    "voice_145:r_d8c669c70659e18a": {
      "text": "Tch! What a ridiculous attack!",
      "status": "imported"
    },
    "voice_145:r_8f5bade7ac2db78e": {
      "text": "Such attacks\\nprove you're scum!",
      "status": "imported"
    },
    "voice_145:r_05ea490d2f522520": {
      "text": "What now?!\\nYou scratched my armor!",
      "status": "imported"
    },
    "voice_145:r_f5658c702d91db7a": {
      "text": "You idiot! You went way too far!",
      "status": "imported"
    },
    "voice_145:r_686df329b50f195b": {
      "text": "The genius Beck\\nis being cornered?!",
      "status": "imported"
    },
    "voice_145:r_25f0ab0fa3cf690c": {
      "text": "W-Wait just a second!\\nI said wait!",
      "status": "imported"
    },
    "voice_145:r_b708a1d959013dbf": {
      "text": "Damn!\\nThis must be a mistake!",
      "status": "imported"
    },
    "voice_145:r_59fca03e929366c1": {
      "text": "Damn!\\nWhat dirty trick was that?!",
      "status": "imported"
    },
    "voice_145:r_0d65eb631dcb7514": {
      "text": "Next time,\\nI'll humiliate you!",
      "status": "imported"
    },
    "voice_145:r_d03018a31e23f1e9": {
      "text": "Damn... I... lost again...",
      "status": "imported"
    },
    "voice_145:r_279da5f732aa8847": {
      "text": "All right! First one here!",
      "status": "imported"
    },
    "voice_145:r_97f82e3cb6f70110": {
      "text": "You're using me as a distraction?!",
      "status": "imported"
    },
    "voice_145:r_c5611d8dd6def96b": {
      "text": "You really work me to the bone!",
      "status": "imported"
    },
    "voice_145:r_6f12cc8ed2732eb5": {
      "text": "Sheesh, making me your errand boy!",
      "status": "imported"
    },
    "voice_145:r_7abfc55f8fb62ba7": {
      "text": "I'm taking my full share of the cut!",
      "status": "imported"
    },
    "voice_145:r_99e7a66c650b5892": {
      "text": "Like I'd lose one-on-one!",
      "status": "imported"
    },
    "voice_145:r_5b2247b5cfbcd7b2": {
      "text": "You got it! I'll take them on!",
      "status": "imported"
    },
    "voice_145:r_2d7a9c06347582d9": {
      "text": "Too bad! You're fighting me!",
      "status": "imported"
    }
  }
}
