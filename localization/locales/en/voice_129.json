{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_129:r_479b340ccc6c572b": {
      "text": "An enemy...!",
      "status": "imported"
    },
    "voice_129:r_ca4acbac57a2a35e": {
      "text": "If I have to fight...!",
      "status": "imported"
    },
    "voice_129:r_77949221bf58f862": {
      "text": "A contact? It's getting closer...!",
      "status": "imported"
    },
    "voice_129:r_70b9c4b9f1f37eff": {
      "text": "I won't say it had to be,\\nbut...!",
      "status": "imported"
    },
    "voice_129:r_9fcb3754cb1773c7": {
      "text": "There...!",
      "status": "imported"
    },
    "voice_129:r_3559d2fad32c2435": {
      "text": "Come on, hit!",
      "status": "imported"
    },
    "voice_129:r_f7570547e9f80a64": {
      "text": "If that's how you want it!",
      "status": "imported"
    },
    "voice_129:r_cbab0f4720e1fcf1": {
      "text": "This is my only choice for now...!",
      "status": "imported"
    },
    "voice_129:r_0bbe0b4f5364e732": {
      "text": "I don't want to do this either!",
      "status": "imported"
    },
    "voice_129:r_5dda5198137cb02a": {
      "text": "I should be able to... No, I will!",
      "status": "imported"
    },
    "voice_129:r_83ec59afbecdec14": {
      "text": "There must be a way\\nwithout this!",
      "status": "imported"
    },
    "voice_129:r_e20bfd42ad95a3c9": {
      "text": "I dread dying,\\nand killing too...!",
      "status": "imported"
    },
    "voice_129:r_0f58a8822381e57f": {
      "text": "I'm firing...!",
      "status": "imported"
    },
    "voice_129:r_6dbcc507fb61b51d": {
      "text": "If only this hits...!",
      "status": "imported"
    },
    "voice_129:r_b42ab697149a7c8a": {
      "text": "Lock... complete!",
      "status": "imported"
    },
    "voice_129:r_4de4fcf3b440baf4": {
      "text": "Please don't make me shoot you!",
      "status": "imported"
    },
    "voice_129:r_0121a166c715cdff": {
      "text": "Please get away!",
      "status": "imported"
    },
    "voice_129:r_30fad37a42bd3ad3": {
      "text": "So it's close combat...!",
      "status": "imported"
    },
    "voice_129:r_80a0b2a84e05d81a": {
      "text": "I've got no choice but to charge!",
      "status": "imported"
    },
    "voice_129:r_4a9ac1dff86506d9": {
      "text": "I have to do it!",
      "status": "imported"
    },
    "voice_129:r_bc8538e6af3d2577": {
      "text": "There!!",
      "status": "imported"
    },
    "voice_129:r_924516c8de2b5342": {
      "text": "S-somehow...",
      "status": "imported"
    },
    "voice_129:r_da1174533722333f": {
      "text": "With this!",
      "status": "imported"
    },
    "voice_129:r_fdeb8162976e72c1": {
      "text": "Please go down!",
      "status": "imported"
    },
    "voice_129:r_0fadb5c26df92b42": {
      "text": "Did I do that...?!",
      "status": "imported"
    },
    "voice_129:r_6b15af9a0057cdc8": {
      "text": "Now!",
      "status": "imported"
    },
    "voice_129:r_ac6fe7838e95647b": {
      "text": "I've got no choice but to go again!",
      "status": "imported"
    },
    "voice_129:r_77ca87eacd17ad52": {
      "text": "I'm not going down yet...!",
      "status": "imported"
    },
    "voice_129:r_bf3244994760e535": {
      "text": "A red mobile suit...!",
      "status": "imported"
    },
    "voice_129:r_aabfb21c9d069ce7": {
      "text": "This one's unlike the others...!",
      "status": "imported"
    },
    "voice_129:r_02479dc8fe989560": {
      "text": "NT-D...?!",
      "status": "imported"
    },
    "voice_129:r_a2df00f91a9b0a9e": {
      "text": "I can see it...!",
      "status": "imported"
    },
    "voice_129:r_48b60d6c48b9b142": {
      "text": "Go down!",
      "status": "imported"
    },
    "voice_129:r_8927e6fb681aa809": {
      "text": "So this is... a Gundam...!",
      "status": "imported"
    },
    "voice_129:r_665f01666859013b": {
      "text": "Audrey...!",
      "status": "imported"
    },
    "voice_129:r_a571eec59b258d11": {
      "text": "Raaaaagh!",
      "status": "imported"
    },
    "voice_129:r_ddbe581c5ea9183d": {
      "text": "Aaaaaagh!",
      "status": "imported"
    },
    "voice_129:r_faae935cca0edc72": {
      "text": "D-did I do it...?!",
      "status": "imported"
    },
    "voice_129:r_3633df5b7b8f47fa": {
      "text": "I've got to counterattack...!",
      "status": "imported"
    },
    "voice_129:r_52dfc56b14b93551": {
      "text": "For now, this is my only choice...!",
      "status": "imported"
    },
    "voice_129:r_1b9b2aab5cb104da": {
      "text": "You should've gotten away sooner...!",
      "status": "imported"
    },
    "voice_129:r_342044c706a2340f": {
      "text": "Please, just go somewhere else!",
      "status": "imported"
    },
    "voice_129:r_cf41e8828a90cbdb": {
      "text": "I'm following up...!",
      "status": "imported"
    },
    "voice_129:r_719e897304ec42d4": {
      "text": "I can at least lend a hand...!",
      "status": "imported"
    },
    "voice_129:r_d5e0a2317c40d322": {
      "text": "I won't let it happen before me!",
      "status": "imported"
    },
    "voice_129:r_ec2ea17765052401": {
      "text": "Forget about me and get away!",
      "status": "imported"
    },
    "voice_129:r_f2d4255f1c2f7542": {
      "text": "What am I supposed to do now...?!",
      "status": "imported"
    },
    "voice_129:r_5d08ad19e2da125b": {
      "text": "Is there no way to do anything...?!",
      "status": "imported"
    },
    "voice_129:r_a7246b52782a877e": {
      "text": "Look out!",
      "status": "imported"
    },
    "voice_129:r_dc8701f6bcb9904f": {
      "text": "I-I dodged it...!",
      "status": "imported"
    },
    "voice_129:r_d6bdd730f24f66eb": {
      "text": "Was I just lucky...?!",
      "status": "imported"
    },
    "voice_129:r_41997412868c48c4": {
      "text": "Will it move for me...?!",
      "status": "imported"
    },
    "voice_129:r_9e6cf4f389dae55c": {
      "text": "I have to act while I still can...!",
      "status": "imported"
    },
    "voice_129:r_9e0c80ac7e33b459": {
      "text": "This thing's incredible...!",
      "status": "imported"
    },
    "voice_129:r_7432ef43ed3471dc": {
      "text": "I can see how they're moving...!",
      "status": "imported"
    },
    "voice_129:r_065443f6ddfcf0d7": {
      "text": "Red mobile suit or not...!",
      "status": "imported"
    },
    "voice_129:r_847f82e7f3eef651": {
      "text": "Good, it didn't work...!",
      "status": "imported"
    },
    "voice_129:r_eb7ae28b53dc033c": {
      "text": "An I-Field...!",
      "status": "imported"
    },
    "voice_129:r_55417493fce1d347": {
      "text": "I've got a shield...!",
      "status": "imported"
    },
    "voice_129:r_8fdf5910927c9591": {
      "text": "They hit me...?!",
      "status": "imported"
    },
    "voice_129:r_7d724dbcc4451e10": {
      "text": "The armor saved me...!",
      "status": "imported"
    },
    "voice_129:r_93e25418a203cb8f": {
      "text": "I'm still okay... Still...!",
      "status": "imported"
    },
    "voice_129:r_adeb0a29274d3d9b": {
      "text": "I got lucky with where it hit...!",
      "status": "imported"
    },
    "voice_129:r_24cf161287ef9d5c": {
      "text": "That'd wreck a Petit Mobile Suit!",
      "status": "imported"
    },
    "voice_129:r_8f60f6fc86db3107": {
      "text": "Can only this machine take it...?!",
      "status": "imported"
    },
    "voice_129:r_b1de76a75a253c13": {
      "text": "Damn...! I can't just do nothing...!",
      "status": "imported"
    },
    "voice_129:r_128c35bf3e0e394c": {
      "text": "Damage?! That's bad...!",
      "status": "imported"
    },
    "voice_129:r_5213c17e13b23de0": {
      "text": "Not yet...! I can keep going...!",
      "status": "imported"
    },
    "voice_129:r_38fdff9483e9245c": {
      "text": "Targeted...! I've got to shake them!",
      "status": "imported"
    },
    "voice_129:r_620fedec67706d7d": {
      "text": "Somehow, I have to right myself...!",
      "status": "imported"
    },
    "voice_129:r_9680dcd0fddcfcc7": {
      "text": "What do I do...?! What do I do...?!",
      "status": "imported"
    },
    "voice_129:r_2a00f1044ad5cbaa": {
      "text": "What is that red mobile suit...?!",
      "status": "imported"
    },
    "voice_129:r_98d15b8cc09bc915": {
      "text": "Can't I do anything...?!",
      "status": "imported"
    },
    "voice_129:r_46e86d000250e137": {
      "text": "Damn...! Don't go down on me...!",
      "status": "imported"
    },
    "voice_129:r_ac341e7976e88f0b": {
      "text": "It wasn't fatal,\\nbut this is bad...!",
      "status": "imported"
    },
    "voice_129:r_cdbd128a5b4127cc": {
      "text": "Calm down...! Stay calm...!",
      "status": "imported"
    },
    "voice_129:r_cfccaa1fbeda124c": {
      "text": "Why am I in the Unicorn?\\nWhy...!",
      "status": "imported"
    },
    "voice_129:r_b1f8ec192b9c083a": {
      "text": "I could die... This is war...!",
      "status": "imported"
    },
    "voice_129:r_a007f9ab9cf048b3": {
      "text": "I couldn't... do anything!",
      "status": "imported"
    },
    "voice_129:r_ddafde4b065ced49": {
      "text": "My... potential...! Aaaaaagh!",
      "status": "imported"
    },
    "voice_129:r_de1213040856c089": {
      "text": "I'm sorry... Audrey...",
      "status": "imported"
    },
    "voice_129:r_0c0775e051211840": {
      "text": "From here...!\\nGet out of here!!",
      "status": "imported"
    },
    "voice_129:r_a2afffe1c396f0b3": {
      "text": "If I can hold them here...!",
      "status": "imported"
    },
    "voice_129:r_13c25fbdfddc8a24": {
      "text": "Fine, I'll do it...!",
      "status": "imported"
    },
    "voice_129:r_42ba1ecb310b4bd7": {
      "text": "You want me to go on ahead...?!",
      "status": "imported"
    },
    "voice_129:r_d692f1d420460a47": {
      "text": "I can at least hold them off...!",
      "status": "imported"
    },
    "voice_129:r_a5643cec86b18bd2": {
      "text": "They left it to me. I have to...!",
      "status": "imported"
    },
    "voice_129:r_68f2dfab20a4a30e": {
      "text": "I'll do everything I can...!",
      "status": "imported"
    },
    "voice_129:r_9cedad8237480563": {
      "text": "Mom, I'm sorry...! I...!",
      "status": "imported"
    },
    "voice_129:r_a03fabecba1508ca": {
      "text": "A four-winged mobile suit...!",
      "status": "imported"
    },
    "voice_129:r_5391b24a71eb10ae": {
      "text": "You're all too direct,\\nMarida...!",
      "status": "imported"
    },
    "voice_129:r_a554ceef5c87b972": {
      "text": "Gilboa...! Please fall back!",
      "status": "imported"
    },
    "voice_129:r_546c3d5937fbb7ee": {
      "text": "The Red Comet...!",
      "status": "imported"
    },
    "voice_129:r_2c9d94ba13c5fc50": {
      "text": "So these are the Guard...!",
      "status": "imported"
    },
    "voice_129:r_a77f4913375098d2": {
      "text": "So what if you're the Guard...?!",
      "status": "imported"
    },
    "voice_129:r_428c2116ac3071b1": {
      "text": "Even if I'm facing Char Aznable!",
      "status": "imported"
    },
    "voice_129:r_84c116267b79f540": {
      "text": "This isn't Full Frontal...?!",
      "status": "imported"
    },
    "voice_129:r_dad38ee29af2df3a": {
      "text": "If Haman Karn is here...!",
      "status": "imported"
    },
    "voice_129:r_3d32e86f8dc80909": {
      "text": "Why would Neo Zeon do this...?!",
      "status": "imported"
    },
    "voice_129:r_70451ffbabe2f876": {
      "text": "There has to be another way!",
      "status": "imported"
    },
    "voice_129:r_69dfa1659715e2fa": {
      "text": "I understand your point...! But!",
      "status": "imported"
    },
    "voice_129:r_d996fd6d4ef5b329": {
      "text": "War is no way\\nto make things right!",
      "status": "imported"
    },
    "voice_129:r_8ab47a28f99ef565": {
      "text": "Those moves...!\\nEnhanced Human...?!",
      "status": "imported"
    },
    "voice_129:r_546de3fb6db156ea": {
      "text": "What...?! An awful pressure...!",
      "status": "imported"
    },
    "voice_129:r_9072ea7bc71df136": {
      "text": "That old machine?! Trying to die?!",
      "status": "imported"
    },
    "voice_129:r_04e815a8d425827d": {
      "text": "Just hate returned with hate...!",
      "status": "imported"
    },
    "voice_129:r_d89011fe3e5d082a": {
      "text": "I can't let that land a direct hit!",
      "status": "imported"
    },
    "voice_129:r_3c5b0c2ac812d5de": {
      "text": "I have to stop their movement...!",
      "status": "imported"
    },
    "voice_129:r_5b9e8897190892eb": {
      "text": "Does this battle mean anything...?!",
      "status": "imported"
    },
    "voice_129:r_7bea3023abbf8a94": {
      "text": "They've brought a Gundam too...!",
      "status": "imported"
    },
    "voice_129:r_dd01a4c0d1b36a8d": {
      "text": "A Gundam doesn't make it okay...!",
      "status": "imported"
    },
    "voice_129:r_20920ad2eb3542db": {
      "text": "If they're here to invade Earth...!",
      "status": "imported"
    },
    "voice_129:r_0ab7914877fd48ed": {
      "text": "If that's why you came to Earth...!",
      "status": "imported"
    },
    "voice_129:r_cb846feec748c2e3": {
      "text": "I won't watch\\nthe world be ruined!",
      "status": "imported"
    },
    "voice_129:r_c958860b0676b1f5": {
      "text": "I can't let this monster through...!",
      "status": "imported"
    },
    "voice_129:r_5e2669b82ef75ce3": {
      "text": "If they only seek destruction...!",
      "status": "imported"
    },
    "voice_129:r_7847e0ed7dc9282d": {
      "text": "We won't\\njust let you destroy us!",
      "status": "imported"
    },
    "voice_129:r_6825fd1ff907bd22": {
      "text": "What in the world is this thing...!",
      "status": "imported"
    },
    "voice_129:r_607f666f1563bc0d": {
      "text": "What are these things after...?!",
      "status": "imported"
    },
    "voice_129:r_97b7431eeb81e6b6": {
      "text": "Taking out the head should do it...!",
      "status": "imported"
    },
    "voice_129:r_132f605d02975e71": {
      "text": "If you're the commander, then...!",
      "status": "imported"
    },
    "voice_129:r_9b9726b1872759d6": {
      "text": "Your way is\\nfar too one-sided!",
      "status": "imported"
    },
    "voice_129:r_1252db29683fefe0": {
      "text": "It won't work!\\nYou can't force it!",
      "status": "imported"
    },
    "voice_129:r_2072eaf71a260ae7": {
      "text": "Why won't you understand,\\nMarida?!",
      "status": "imported"
    },
    "voice_129:r_6c13bbfd27a7799e": {
      "text": "Gilboa...!\\nI don't intend to die!",
      "status": "imported"
    },
    "voice_129:r_06f88dcbd3c9e738": {
      "text": "Red Comet's pressure is taking me?!",
      "status": "imported"
    },
    "voice_129:r_b28faf9f71bc3598": {
      "text": "Can't I stop the Red Comet...?!",
      "status": "imported"
    },
    "voice_129:r_8a29278549f8e07a": {
      "text": "Their pressure's overwhelming me...!",
      "status": "imported"
    },
    "voice_129:r_7e6c573c26177f98": {
      "text": "The Guard...!\\nNo ordinary skill...!",
      "status": "imported"
    },
    "voice_129:r_45abf84f7757d6eb": {
      "text": "Changing the world, even so...!",
      "status": "imported"
    },
    "voice_129:r_edd7a13ab8f06a14": {
      "text": "Am I yielding to their resolve...?!",
      "status": "imported"
    },
    "voice_129:r_8165e5b41f0124c4": {
      "text": "They mean to die...?!\\nThis is...!",
      "status": "imported"
    },
    "voice_129:r_625664af02183c17": {
      "text": "An attack from those four wings...!",
      "status": "imported"
    },
    "voice_129:r_3701cba361f80ea5": {
      "text": "Please understand, Marida!",
      "status": "imported"
    },
    "voice_129:r_63f429c5c68c0863": {
      "text": "Gilboa...!\\nDo we have to fight?!",
      "status": "imported"
    },
    "voice_129:r_38e4a434c91d8ef0": {
      "text": "Char Aznable...!\\nJust watching...?!",
      "status": "imported"
    },
    "voice_129:r_98ed411352a3a6ac": {
      "text": "Can't last against the Red Comet...!",
      "status": "imported"
    },
    "voice_129:r_4824bea6bab3af67": {
      "text": "Guard or not, you won't beat me!",
      "status": "imported"
    },
    "voice_129:r_862b92e63adb9734": {
      "text": "If it's futile,\\nplease fall back!",
      "status": "imported"
    },
    "voice_129:r_cb306ef55e49d107": {
      "text": "You can't fix the world\\nthis way!",
      "status": "imported"
    },
    "voice_129:r_57b2bd2de8a1408d": {
      "text": "Your machine can't do this!\\nSee it!",
      "status": "imported"
    },
    "voice_129:r_76f080a4881e8ab5": {
      "text": "Keep this up,\\nnothing comes of it!",
      "status": "imported"
    },
    "voice_129:r_ec1081caf845f56a": {
      "text": "Unicorn...! Let's go!",
      "status": "imported"
    }
  }
}
