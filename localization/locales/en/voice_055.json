{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_055:r_479b340ccc6c572b": {
      "text": "Rabbit 1, engaging!",
      "status": "imported"
    },
    "voice_055:r_77949221bf58f862": {
      "text": "Canaria's unit, commencing attack.",
      "status": "imported"
    },
    "voice_055:r_70b9c4b9f1f37eff": {
      "text": "No one can match my firepower!",
      "status": "imported"
    },
    "voice_055:r_9fcb3754cb1773c7": {
      "text": "Clear the way...!",
      "status": "imported"
    },
    "voice_055:r_3559d2fad32c2435": {
      "text": "My firepower makes up for my speed!",
      "status": "imported"
    },
    "voice_055:r_f7570547e9f80a64": {
      "text": "Attack is the only way!",
      "status": "imported"
    },
    "voice_055:r_cbab0f4720e1fcf1": {
      "text": "Dead ahead! Direct hit!",
      "status": "imported"
    },
    "voice_055:r_0bbe0b4f5364e732": {
      "text": "I'll keep firing till you drop!",
      "status": "imported"
    },
    "voice_055:r_5dda5198137cb02a": {
      "text": "Target: Vajra! Wipe them out!",
      "status": "imported"
    },
    "voice_055:r_83ec59afbecdec14": {
      "text": "Drop dead, you monsters!",
      "status": "imported"
    },
    "voice_055:r_e20bfd42ad95a3c9": {
      "text": "Plenty of monsters besides Vajra!",
      "status": "imported"
    },
    "voice_055:r_0f58a8822381e57f": {
      "text": "You're their leader! Face me!",
      "status": "imported"
    },
    "voice_055:r_6dbcc507fb61b51d": {
      "text": "Last fight!\\nEddie, lend me power!",
      "status": "imported"
    },
    "voice_055:r_0fadb5c26df92b42": {
      "text": "Target acquired!",
      "status": "imported"
    },
    "voice_055:r_6b15af9a0057cdc8": {
      "text": "Here I go!",
      "status": "imported"
    },
    "voice_055:r_15b4a90140e8a33a": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_055:r_af884a6b11dff121": {
      "text": "This ends now!",
      "status": "imported"
    },
    "voice_055:r_ac6fe7838e95647b": {
      "text": "Want to live? Get out of my sight!",
      "status": "imported"
    },
    "voice_055:r_77ca87eacd17ad52": {
      "text": "Uooooooh!!",
      "status": "imported"
    },
    "voice_055:r_aabfb21c9d069ce7": {
      "text": "Yooooou!!",
      "status": "imported"
    },
    "voice_055:r_02479dc8fe989560": {
      "text": "Full barrage! Allies, fall back!",
      "status": "imported"
    },
    "voice_055:r_a2df00f91a9b0a9e": {
      "text": "Taaaaake this!!",
      "status": "imported"
    },
    "voice_055:r_48b60d6c48b9b142": {
      "text": "I still owe you some payback!",
      "status": "imported"
    },
    "voice_055:r_8927e6fb681aa809": {
      "text": "Not slow enough to let you escape!",
      "status": "imported"
    },
    "voice_055:r_665f01666859013b": {
      "text": "This is my answer!",
      "status": "imported"
    },
    "voice_055:r_a571eec59b258d11": {
      "text": "You gave away your position!",
      "status": "imported"
    },
    "voice_055:r_ddbe581c5ea9183d": {
      "text": "You showed yourself - you lose!",
      "status": "imported"
    },
    "voice_055:r_faae935cca0edc72": {
      "text": "I'll answer with all I've got!",
      "status": "imported"
    },
    "voice_055:r_d4430bf362340b32": {
      "text": "Rabbit 1, moving to support!",
      "status": "imported"
    },
    "voice_055:r_6ff1323b355593e0": {
      "text": "Canaria here! I'll lend a hand!",
      "status": "imported"
    },
    "voice_055:r_b7b5625d7cd4282f": {
      "text": "That's the Ozma I know.",
      "status": "imported"
    },
    "voice_055:r_36133ad73a73ef98": {
      "text": "Leave the rest to me, Michel.",
      "status": "imported"
    },
    "voice_055:r_920740a0219c5085": {
      "text": "Don't push yourself too hard, Luca.",
      "status": "imported"
    },
    "voice_055:r_a8451712c57c1a72": {
      "text": "Captain, let's show\\nwomen's mettle!",
      "status": "imported"
    },
    "voice_055:r_3633df5b7b8f47fa": {
      "text": "Captain! I'll cover you!",
      "status": "imported"
    },
    "voice_055:r_52dfc56b14b93551": {
      "text": "Get behind me!",
      "status": "imported"
    },
    "voice_055:r_1b9b2aab5cb104da": {
      "text": "Trust this machine's armor...!",
      "status": "imported"
    },
    "voice_055:r_342044c706a2340f": {
      "text": "Ozma! Do you want Ranka to cry?!",
      "status": "imported"
    },
    "voice_055:r_cf41e8828a90cbdb": {
      "text": "Your eyes are sharp, right, Michel?",
      "status": "imported"
    },
    "voice_055:r_719e897304ec42d4": {
      "text": "Gather data farther back, Luca!",
      "status": "imported"
    },
    "voice_055:r_d5e0a2317c40d322": {
      "text": "Captain! Let the Konig shield you!",
      "status": "imported"
    },
    "voice_055:r_ec2ea17765052401": {
      "text": "I won't let you harm the Quarter!",
      "status": "imported"
    },
    "voice_055:r_f2d4255f1c2f7542": {
      "text": "Ngh...! I won't just take this!",
      "status": "imported"
    },
    "voice_055:r_5d08ad19e2da125b": {
      "text": "There's nothing I can do...!",
      "status": "imported"
    },
    "voice_055:r_a7246b52782a877e": {
      "text": "Big as it is, it guzzles fuel...!",
      "status": "imported"
    },
    "voice_055:r_dc8701f6bcb9904f": {
      "text": "Tch, the range is all wrong...!",
      "status": "imported"
    },
    "voice_055:r_d6bdd730f24f66eb": {
      "text": "Good positioning for an enemy...!",
      "status": "imported"
    },
    "voice_055:r_41997412868c48c4": {
      "text": "You can't even hit the Konig!",
      "status": "imported"
    },
    "voice_055:r_9e6cf4f389dae55c": {
      "text": "What's wrong? I'm right here!",
      "status": "imported"
    },
    "voice_055:r_9e0c80ac7e33b459": {
      "text": "Did you think I'd just sit still?",
      "status": "imported"
    },
    "voice_055:r_7432ef43ed3471dc": {
      "text": "I've already read your moves...!",
      "status": "imported"
    },
    "voice_055:r_065443f6ddfcf0d7": {
      "text": "Slow or not, I can manage this!",
      "status": "imported"
    },
    "voice_055:r_47d52a2839c71715": {
      "text": "That was close...",
      "status": "imported"
    },
    "voice_055:r_847f82e7f3eef651": {
      "text": "That won't work!",
      "status": "imported"
    },
    "voice_055:r_55417493fce1d347": {
      "text": "A few hits won't stop me!",
      "status": "imported"
    },
    "voice_055:r_8fdf5910927c9591": {
      "text": "Can't dodge every shot...!",
      "status": "imported"
    },
    "voice_055:r_7d724dbcc4451e10": {
      "text": "This machine's built to take a hit!",
      "status": "imported"
    },
    "voice_055:r_93e25418a203cb8f": {
      "text": "Like that could hurt this Konig!",
      "status": "imported"
    },
    "voice_055:r_adeb0a29274d3d9b": {
      "text": "No problem. I can still fight...!",
      "status": "imported"
    },
    "voice_055:r_24cf161287ef9d5c": {
      "text": "Can't shake them in this thing...!",
      "status": "imported"
    },
    "voice_055:r_8f60f6fc86db3107": {
      "text": "I can still fight! I'll prove it!",
      "status": "imported"
    },
    "voice_055:r_b1de76a75a253c13": {
      "text": "Even Konig's armor can't hold...!",
      "status": "imported"
    },
    "voice_055:r_128c35bf3e0e394c": {
      "text": "Not yet, not yet!!",
      "status": "imported"
    },
    "voice_055:r_5213c17e13b23de0": {
      "text": "The damage is building up...!",
      "status": "imported"
    },
    "voice_055:r_38fdff9483e9245c": {
      "text": "Hold together, Konig...!",
      "status": "imported"
    },
    "voice_055:r_620fedec67706d7d": {
      "text": "Ungh! What is this?!",
      "status": "imported"
    },
    "voice_055:r_9680dcd0fddcfcc7": {
      "text": "Eddie...! Give Mom strength...!",
      "status": "imported"
    },
    "voice_055:r_2a00f1044ad5cbaa": {
      "text": "Ngh!\\nI can't die here!!",
      "status": "imported"
    },
    "voice_055:r_3dbeead1bd3164ef": {
      "text": "I'll return alive!\\nThey're waiting!",
      "status": "imported"
    },
    "voice_055:r_98d15b8cc09bc915": {
      "text": "Such power!\\nIt battered Konig!!",
      "status": "imported"
    },
    "voice_055:r_46e86d000250e137": {
      "text": "Work remains...!\\nI won't go down!!",
      "status": "imported"
    },
    "voice_055:r_ac341e7976e88f0b": {
      "text": "No good! Rabbit 1, retreating!",
      "status": "imported"
    },
    "voice_055:r_cdbd128a5b4127cc": {
      "text": "Ngh! Konig's been shot down!",
      "status": "imported"
    },
    "voice_055:r_a007f9ab9cf048b3": {
      "text": "I'll do this as often as it takes!",
      "status": "imported"
    },
    "voice_055:r_ddafde4b065ced49": {
      "text": "Hmph. That won't do a thing...",
      "status": "imported"
    },
    "voice_055:r_de1213040856c089": {
      "text": "I've got a barrier!",
      "status": "imported"
    },
    "voice_055:r_3304412ac41f47a6": {
      "text": "Warship? This one's made for it!",
      "status": "imported"
    },
    "voice_055:r_0c0775e051211840": {
      "text": "Let any monster come at us!",
      "status": "imported"
    },
    "voice_055:r_a2afffe1c396f0b3": {
      "text": "The last prey is mine!",
      "status": "imported"
    },
    "voice_055:r_13c25fbdfddc8a24": {
      "text": "Came this far!\\nYou won't erase it!",
      "status": "imported"
    },
    "voice_055:r_9cedad8237480563": {
      "text": "You won't escape!",
      "status": "imported"
    },
    "voice_055:r_a03fabecba1508ca": {
      "text": "I said you won't escape!",
      "status": "imported"
    },
    "voice_055:r_5391b24a71eb10ae": {
      "text": "This should do it...!",
      "status": "imported"
    },
    "voice_055:r_a554ceef5c87b972": {
      "text": "I've read that move!",
      "status": "imported"
    },
    "voice_055:r_546c3d5937fbb7ee": {
      "text": "Your opponent is...!",
      "status": "imported"
    },
    "voice_055:r_1568ff6298b12b96": {
      "text": "I'll do it with this one!",
      "status": "imported"
    },
    "voice_055:r_2c9d94ba13c5fc50": {
      "text": "Don't rush, Alto.",
      "status": "imported"
    },
    "voice_055:r_a77f4913375098d2": {
      "text": "We can match the YF-29's firepower!",
      "status": "imported"
    },
    "voice_055:r_428c2116ac3071b1": {
      "text": "Supporting the Pixie Squadron!",
      "status": "imported"
    },
    "voice_055:r_84c116267b79f540": {
      "text": "Don't fight alone, Alto!",
      "status": "imported"
    },
    "voice_055:r_dad38ee29af2df3a": {
      "text": "That unit...\\nWhy'd Ozma entrust it?",
      "status": "imported"
    },
    "voice_055:r_3d32e86f8dc80909": {
      "text": "Pixie Squadron, fall back!",
      "status": "imported"
    },
    "voice_055:r_70451ffbabe2f876": {
      "text": "I can't let that man be shot down!",
      "status": "imported"
    },
    "voice_055:r_69dfa1659715e2fa": {
      "text": "Cut off their escape route!",
      "status": "imported"
    },
    "voice_055:r_d996fd6d4ef5b329": {
      "text": "Focus everything on one point!",
      "status": "imported"
    },
    "voice_055:r_8ab47a28f99ef565": {
      "text": "I'll fulfill the role I was given!",
      "status": "imported"
    },
    "voice_055:r_546de3fb6db156ea": {
      "text": "I'll be your opponent...!",
      "status": "imported"
    }
  }
}
