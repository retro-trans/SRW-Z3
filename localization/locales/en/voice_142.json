{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_142:r_479b340ccc6c572b": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_142:r_ca4acbac57a2a35e": {
      "text": "Go to hell!",
      "status": "imported"
    },
    "voice_142:r_77949221bf58f862": {
      "text": "Drop dead!",
      "status": "imported"
    },
    "voice_142:r_70b9c4b9f1f37eff": {
      "text": "This is the end!",
      "status": "imported"
    },
    "voice_142:r_9fcb3754cb1773c7": {
      "text": "Resistance is futile!",
      "status": "imported"
    },
    "voice_142:r_3559d2fad32c2435": {
      "text": "You think you can get away?!",
      "status": "imported"
    },
    "voice_142:r_f7570547e9f80a64": {
      "text": "Ha ha ha! There you are!",
      "status": "imported"
    },
    "voice_142:r_cbab0f4720e1fcf1": {
      "text": "Ha ha ha! You won't escape!",
      "status": "imported"
    },
    "voice_142:r_0bbe0b4f5364e732": {
      "text": "I'll show you the gulf in power!",
      "status": "imported"
    },
    "voice_142:r_5dda5198137cb02a": {
      "text": "Regret this in the afterlife!",
      "status": "imported"
    },
    "voice_142:r_83ec59afbecdec14": {
      "text": "This is how the Robot Mafia fights!",
      "status": "imported"
    },
    "voice_142:r_e20bfd42ad95a3c9": {
      "text": "So you dare defy the Robot Mafia!",
      "status": "imported"
    },
    "voice_142:r_0f58a8822381e57f": {
      "text": "I'll take you on myself!",
      "status": "imported"
    },
    "voice_142:r_6dbcc507fb61b51d": {
      "text": "We'll crush anyone who defies us!",
      "status": "imported"
    },
    "voice_142:r_b42ab697149a7c8a": {
      "text": "You can't beat a Branch Robot!",
      "status": "imported"
    },
    "voice_142:r_4de4fcf3b440baf4": {
      "text": "With this Branch Robot...!",
      "status": "imported"
    },
    "voice_142:r_0121a166c715cdff": {
      "text": "Behold the Branch Robot's power!",
      "status": "imported"
    },
    "voice_142:r_30fad37a42bd3ad3": {
      "text": "Can you withstand this, Tetsujin?!",
      "status": "imported"
    },
    "voice_142:r_80a0b2a84e05d81a": {
      "text": "Tetsujin! I'll turn you into scrap!",
      "status": "imported"
    },
    "voice_142:r_4a9ac1dff86506d9": {
      "text": "Tetsujin! Pay for what you've done!",
      "status": "imported"
    },
    "voice_142:r_bc8538e6af3d2577": {
      "text": "Got you, Black Ox!",
      "status": "imported"
    },
    "voice_142:r_924516c8de2b5342": {
      "text": "Black Ox! You accursed wretch!",
      "status": "imported"
    },
    "voice_142:r_da1174533722333f": {
      "text": "So I'm facing the famous Gundam!",
      "status": "imported"
    },
    "voice_142:r_fdeb8162976e72c1": {
      "text": "There's a Gundam here too?!",
      "status": "imported"
    },
    "voice_142:r_0fadb5c26df92b42": {
      "text": "Beat a Gundam,\\nmake a name for us!",
      "status": "imported"
    },
    "voice_142:r_6b15af9a0057cdc8": {
      "text": "Otsuka's lackeys!\\nIn our way again?!",
      "status": "imported"
    },
    "voice_142:r_af884a6b11dff121": {
      "text": "We won't lose to Otsuka's lackeys!",
      "status": "imported"
    },
    "voice_142:r_77ca87eacd17ad52": {
      "text": "Fear the Robot Mafia,\\ncommoners!",
      "status": "imported"
    },
    "voice_142:r_aabfb21c9d069ce7": {
      "text": "So the office drone joins the fray!",
      "status": "imported"
    },
    "voice_142:r_a2df00f91a9b0a9e": {
      "text": "So a Super Robot has appeared!",
      "status": "imported"
    },
    "voice_142:r_48b60d6c48b9b142": {
      "text": "In power,\\nwe rival Super Robots!",
      "status": "imported"
    },
    "voice_142:r_8927e6fb681aa809": {
      "text": "A combiner!\\nI'll tear you apart!",
      "status": "imported"
    },
    "voice_142:r_665f01666859013b": {
      "text": "Our teamwork is second to none!",
      "status": "imported"
    },
    "voice_142:r_a571eec59b258d11": {
      "text": "That drill won't bring you victory!",
      "status": "imported"
    },
    "voice_142:r_ddbe581c5ea9183d": {
      "text": "Ha ha ha! Time to hunt a wild beast!",
      "status": "imported"
    },
    "voice_142:r_faae935cca0edc72": {
      "text": "You irritating little pest!",
      "status": "imported"
    },
    "voice_142:r_6ff1323b355593e0": {
      "text": "I'll swat you down, you little gnat!",
      "status": "imported"
    },
    "voice_142:r_b7b5625d7cd4282f": {
      "text": "Damn you! You're no ordinary pilot!",
      "status": "imported"
    },
    "voice_142:r_36133ad73a73ef98": {
      "text": "I'll shoot down that battleship!",
      "status": "imported"
    },
    "voice_142:r_920740a0219c5085": {
      "text": "Sink the battleship, and we win!",
      "status": "imported"
    },
    "voice_142:r_a8451712c57c1a72": {
      "text": "One more time! Let's go!",
      "status": "imported"
    },
    "voice_142:r_3633df5b7b8f47fa": {
      "text": "Missile, fire!",
      "status": "imported"
    },
    "voice_142:r_b1de76a75a253c13": {
      "text": "Here's some payback!",
      "status": "imported"
    },
    "voice_142:r_128c35bf3e0e394c": {
      "text": "I'll pay you back double!",
      "status": "imported"
    },
    "voice_142:r_5213c17e13b23de0": {
      "text": "How dare you!",
      "status": "imported"
    },
    "voice_142:r_38fdff9483e9245c": {
      "text": "I won't let you escape!",
      "status": "imported"
    },
    "voice_142:r_620fedec67706d7d": {
      "text": "Now it's our turn!",
      "status": "imported"
    },
    "voice_142:r_9680dcd0fddcfcc7": {
      "text": "Don't think you can escape!",
      "status": "imported"
    },
    "voice_142:r_2a00f1044ad5cbaa": {
      "text": "Hit us, and we'll hit back!",
      "status": "imported"
    },
    "voice_142:r_3dbeead1bd3164ef": {
      "text": "An eye for an eye!",
      "status": "imported"
    },
    "voice_142:r_98d15b8cc09bc915": {
      "text": "Come at us and I'll shoot you down!",
      "status": "imported"
    },
    "voice_142:r_46e86d000250e137": {
      "text": "A wave attack!",
      "status": "imported"
    },
    "voice_142:r_ac341e7976e88f0b": {
      "text": "I'll finish you in one stroke!",
      "status": "imported"
    },
    "voice_142:r_cdbd128a5b4127cc": {
      "text": "Behold the Robot Mafia's teamwork!",
      "status": "imported"
    },
    "voice_142:r_cfccaa1fbeda124c": {
      "text": "Use me as your shield!",
      "status": "imported"
    },
    "voice_142:r_b1f8ec192b9c083a": {
      "text": "Damn! I can't counterattack!",
      "status": "imported"
    },
    "voice_142:r_a007f9ab9cf048b3": {
      "text": "I have to let this one go...!",
      "status": "imported"
    },
    "voice_142:r_ddafde4b065ced49": {
      "text": "Damn it! I'm completely helpless!",
      "status": "imported"
    },
    "voice_142:r_de1213040856c089": {
      "text": "Damn it! Why can't I counterattack?!",
      "status": "imported"
    },
    "voice_142:r_3304412ac41f47a6": {
      "text": "Damn! We're out of energy!",
      "status": "imported"
    },
    "voice_142:r_0c0775e051211840": {
      "text": "Attacking from that position...?!",
      "status": "imported"
    },
    "voice_142:r_a2afffe1c396f0b3": {
      "text": "Tch! They're in a nasty position!",
      "status": "imported"
    },
    "voice_142:r_13c25fbdfddc8a24": {
      "text": "Too slow!",
      "status": "imported"
    },
    "voice_142:r_42ba1ecb310b4bd7": {
      "text": "You couldn't be further off target!",
      "status": "imported"
    },
    "voice_142:r_d692f1d420460a47": {
      "text": "Random attacks won't hit me!",
      "status": "imported"
    },
    "voice_142:r_a5643cec86b18bd2": {
      "text": "I know how to handle a robot!",
      "status": "imported"
    },
    "voice_142:r_68f2dfab20a4a30e": {
      "text": "Give up, for your own good!",
      "status": "imported"
    },
    "voice_142:r_9cedad8237480563": {
      "text": "Is that all, Shotaro Kaneda?!",
      "status": "imported"
    },
    "voice_142:r_a03fabecba1508ca": {
      "text": "Hand over the controller already!",
      "status": "imported"
    },
    "voice_142:r_5391b24a71eb10ae": {
      "text": "Don't make me laugh, Black Ox!",
      "status": "imported"
    },
    "voice_142:r_a554ceef5c87b972": {
      "text": "And you call that a Super Robot?!",
      "status": "imported"
    },
    "voice_142:r_546c3d5937fbb7ee": {
      "text": "Just a flashy facade, Super Robot?!",
      "status": "imported"
    },
    "voice_142:r_dad38ee29af2df3a": {
      "text": "Don't think that attack will work!",
      "status": "imported"
    },
    "voice_142:r_70451ffbabe2f876": {
      "text": "Ha ha ha! Useless! Useless!",
      "status": "imported"
    },
    "voice_142:r_69dfa1659715e2fa": {
      "text": "An attack like that won't work!",
      "status": "imported"
    },
    "voice_142:r_d996fd6d4ef5b329": {
      "text": "That didn't even tickle!",
      "status": "imported"
    },
    "voice_142:r_8ab47a28f99ef565": {
      "text": "That won't defeat a Branch Robot!",
      "status": "imported"
    },
    "voice_142:r_546de3fb6db156ea": {
      "text": "You underestimated our robot!",
      "status": "imported"
    },
    "voice_142:r_ca85f87cee5e31f7": {
      "text": "That attack isn't worth dodging!",
      "status": "imported"
    },
    "voice_142:r_9072ea7bc71df136": {
      "text": "W-What?! What just happened?!",
      "status": "imported"
    },
    "voice_142:r_04e815a8d425827d": {
      "text": "Damn! I took that one head-on!",
      "status": "imported"
    },
    "voice_142:r_d89011fe3e5d082a": {
      "text": "Whoa! What incredible power!",
      "status": "imported"
    },
    "voice_142:r_3c5b0c2ac812d5de": {
      "text": "Damn! I can't let my guard down!",
      "status": "imported"
    },
    "voice_142:r_5b9e8897190892eb": {
      "text": "That's quite a capable robot...!",
      "status": "imported"
    },
    "voice_142:r_7bea3023abbf8a94": {
      "text": "What a blunder! This much damage?!",
      "status": "imported"
    },
    "voice_142:r_dd01a4c0d1b36a8d": {
      "text": "This will shame\\nthe Robot Mafia!",
      "status": "imported"
    },
    "voice_142:r_20920ad2eb3542db": {
      "text": "They didn't miss our opening...!",
      "status": "imported"
    },
    "voice_142:r_0ab7914877fd48ed": {
      "text": "You'll keep\\ngetting in our way...!",
      "status": "imported"
    },
    "voice_142:r_cb846feec748c2e3": {
      "text": "Our robot, beaten so easily...?!",
      "status": "imported"
    },
    "voice_142:r_c958860b0676b1f5": {
      "text": "You'll pay for that, Tetsujin!",
      "status": "imported"
    },
    "voice_142:r_5e2669b82ef75ce3": {
      "text": "S-So this is Tetsujin's power?!",
      "status": "imported"
    },
    "voice_142:r_7847e0ed7dc9282d": {
      "text": "Fearsome indeed, Black Ox!",
      "status": "imported"
    },
    "voice_142:r_e42b52c7a987b906": {
      "text": "Black Ox! How dare you!!",
      "status": "imported"
    },
    "voice_142:r_6825fd1ff907bd22": {
      "text": "Curse you! Otsuka's lackeys!",
      "status": "imported"
    },
    "voice_142:r_97b7431eeb81e6b6": {
      "text": "Mafia lose to\\nan office drone?!",
      "status": "imported"
    },
    "voice_142:r_9b9726b1872759d6": {
      "text": "A-As expected of a Super Robot!",
      "status": "imported"
    },
    "voice_142:r_1252db29683fefe0": {
      "text": "Such power...!\\nThe name Super fits!",
      "status": "imported"
    },
    "voice_142:r_bdd38c584fa313d0": {
      "text": "No! We'll lose at this rate!",
      "status": "imported"
    },
    "voice_142:r_3fd86c1027f317c8": {
      "text": "Damn! We can't win like this!",
      "status": "imported"
    },
    "voice_142:r_d0372a183d2007ad": {
      "text": "Impossible! This wasn't in the plan!",
      "status": "imported"
    },
    "voice_142:r_217aa5e1d545b44d": {
      "text": "The damage far exceeds projections!",
      "status": "imported"
    },
    "voice_142:r_381992c5d8224937": {
      "text": "N-Neither sensors nor radar work!",
      "status": "imported"
    },
    "voice_142:r_f1e7ed9e5874aba5": {
      "text": "Even the cockpit is sparking!",
      "status": "imported"
    },
    "voice_142:r_fc25e66a86fc2c85": {
      "text": "T-The joints are screaming!",
      "status": "imported"
    },
    "voice_142:r_5aeeb4917340c42d": {
      "text": "Damn! Is this the gap in specs...?!",
      "status": "imported"
    },
    "voice_142:r_b765659981b6516d": {
      "text": "We can't hold out! Send help, now!",
      "status": "imported"
    },
    "voice_142:r_0c427458bc00eb95": {
      "text": "Waaaaaaaaah!!",
      "status": "imported"
    },
    "voice_142:r_774a9ab4d8fd5351": {
      "text": "N-No! The robot's about to explode!",
      "status": "imported"
    },
    "voice_142:r_d3f01de714c015bd": {
      "text": "D-Damn! My robot...!",
      "status": "imported"
    },
    "voice_142:r_7d2617c809fead70": {
      "text": "W-Whoa! This is the limit!!",
      "status": "imported"
    },
    "voice_142:r_ceb935ccbf830724": {
      "text": "Master Branch! Please forgive me!!",
      "status": "imported"
    },
    "voice_142:r_862ef7385bf2abd4": {
      "text": "The Branch Robot...! Aaaaaah!",
      "status": "imported"
    },
    "voice_142:r_7e6c573c26177f98": {
      "text": "I'll crush you flat!",
      "status": "imported"
    },
    "voice_142:r_45abf84f7757d6eb": {
      "text": "Robot Mafia's terror -\\nlearn it!",
      "status": "imported"
    },
    "voice_142:r_edd7a13ab8f06a14": {
      "text": "Fight with a Branch member's pride!",
      "status": "imported"
    },
    "voice_142:r_8165e5b41f0124c4": {
      "text": "Let's do this, Branch Robot!",
      "status": "imported"
    },
    "voice_142:r_0a3fccb71ec6cf2a": {
      "text": "I'll follow up on that attack!",
      "status": "imported"
    },
    "voice_142:r_9b63cf1f3e0207ef": {
      "text": "Waaah! I-I'm done for!",
      "status": "imported"
    },
    "voice_142:r_8356f4e3dcdff938": {
      "text": "Damn! They hit the power unit!",
      "status": "imported"
    },
    "voice_142:r_1d6d784036ae0bd7": {
      "text": "Now it starts! Time to get serious!",
      "status": "imported"
    },
    "voice_142:r_625664af02183c17": {
      "text": "Oops! Looks like you hit me!",
      "status": "imported"
    },
    "voice_142:r_3701cba361f80ea5": {
      "text": "I'll bounce it off my armor!",
      "status": "imported"
    },
    "voice_142:r_63f429c5c68c0863": {
      "text": "What a lousy shot!",
      "status": "imported"
    },
    "voice_142:r_38e4a434c91d8ef0": {
      "text": "That's the difference in our robots!",
      "status": "imported"
    },
    "voice_142:r_98ed411352a3a6ac": {
      "text": "Thank goodness for that barrier!",
      "status": "imported"
    },
    "voice_142:r_4824bea6bab3af67": {
      "text": "I'll block the attack here!",
      "status": "imported"
    },
    "voice_142:r_862b92e63adb9734": {
      "text": "Commence the attack!",
      "status": "imported"
    },
    "voice_142:r_cb306ef55e49d107": {
      "text": "We'll do whatever we want!",
      "status": "imported"
    },
    "voice_142:r_288133bc5b573dae": {
      "text": "Counterattack!",
      "status": "imported"
    },
    "voice_142:r_6f95653e548f8fcf": {
      "text": "You're no match for the Robot Mafia!",
      "status": "imported"
    },
    "voice_142:r_d249d68bada91ab9": {
      "text": "Fall back while you still can!",
      "status": "imported"
    },
    "voice_142:r_e9b3307e9eb69f11": {
      "text": "Why, you!",
      "status": "imported"
    },
    "voice_142:r_03cdac73042343ee": {
      "text": "Deyah!",
      "status": "imported"
    },
    "voice_142:r_6026da5acbda7c69": {
      "text": "Hah!",
      "status": "imported"
    },
    "voice_142:r_981f8fedd5414fe5": {
      "text": "We'll keep them pinned down!",
      "status": "imported"
    },
    "voice_142:r_96bb0dcde0c8c44a": {
      "text": "We must draw all their fire!",
      "status": "imported"
    },
    "voice_142:r_641550a2f54cb456": {
      "text": "Leave this side to us!",
      "status": "imported"
    },
    "voice_142:r_a0f2074af8debbfa": {
      "text": "I've identified the target!",
      "status": "imported"
    }
  }
}
