{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_167:r_479b340ccc6c572b": {
      "text": "Skull 3, heading out!",
      "status": "imported"
    },
    "voice_167:r_ca4acbac57a2a35e": {
      "text": "This is Skull 3. Commencing attack!",
      "status": "imported"
    },
    "voice_167:r_77949221bf58f862": {
      "text": "Electronic warfare isn't all I do!",
      "status": "imported"
    },
    "voice_167:r_70b9c4b9f1f37eff": {
      "text": "I'll make this hit!",
      "status": "imported"
    },
    "voice_167:r_9fcb3754cb1773c7": {
      "text": "I won't let you escape!",
      "status": "imported"
    },
    "voice_167:r_3559d2fad32c2435": {
      "text": "Enemy data loaded! This should work!",
      "status": "imported"
    },
    "voice_167:r_f7570547e9f80a64": {
      "text": "If you won't back down...!",
      "status": "imported"
    },
    "voice_167:r_cbab0f4720e1fcf1": {
      "text": "All systems normal! This'll work!",
      "status": "imported"
    },
    "voice_167:r_0bbe0b4f5364e732": {
      "text": "No matter how many times, I must!",
      "status": "imported"
    },
    "voice_167:r_5dda5198137cb02a": {
      "text": "I have to gather data on the Vajra!",
      "status": "imported"
    },
    "voice_167:r_6dbcc507fb61b51d": {
      "text": "There!",
      "status": "imported"
    },
    "voice_167:r_80a0b2a84e05d81a": {
      "text": "If I don't get them, they'll get me!",
      "status": "imported"
    },
    "voice_167:r_924516c8de2b5342": {
      "text": "I can do it too! I can...!",
      "status": "imported"
    },
    "voice_167:r_da1174533722333f": {
      "text": "Go! Simon, John, Pete!",
      "status": "imported"
    },
    "voice_167:r_fdeb8162976e72c1": {
      "text": "Thanks, everyone!",
      "status": "imported"
    },
    "voice_167:r_0fadb5c26df92b42": {
      "text": "Simon, John, Pete!",
      "status": "imported"
    },
    "voice_167:r_6b15af9a0057cdc8": {
      "text": "Goooo!!",
      "status": "imported"
    },
    "voice_167:r_15b4a90140e8a33a": {
      "text": "Welcome back, everyone!",
      "status": "imported"
    },
    "voice_167:r_665f01666859013b": {
      "text": "I can't let them escape!",
      "status": "imported"
    },
    "voice_167:r_a571eec59b258d11": {
      "text": "I'll return fire too!",
      "status": "imported"
    },
    "voice_167:r_ddbe581c5ea9183d": {
      "text": "Before they get out of range...!",
      "status": "imported"
    },
    "voice_167:r_faae935cca0edc72": {
      "text": "If their attack can reach us...!",
      "status": "imported"
    },
    "voice_167:r_d4430bf362340b32": {
      "text": "Electronic warfare isn't all I have!",
      "status": "imported"
    },
    "voice_167:r_6ff1323b355593e0": {
      "text": "I can help too!",
      "status": "imported"
    },
    "voice_167:r_b7b5625d7cd4282f": {
      "text": "This is Skull 3! I'll cover you!",
      "status": "imported"
    },
    "voice_167:r_36133ad73a73ef98": {
      "text": "Captain Ozma! I'm coming too!",
      "status": "imported"
    },
    "voice_167:r_920740a0219c5085": {
      "text": "I'll use the opening Michel made!",
      "status": "imported"
    },
    "voice_167:r_a8451712c57c1a72": {
      "text": "Alto, I'll cover you!",
      "status": "imported"
    },
    "voice_167:r_3633df5b7b8f47fa": {
      "text": "I'll cover you, Canaria!",
      "status": "imported"
    },
    "voice_167:r_52dfc56b14b93551": {
      "text": "Captain Klan! Let me help too!",
      "status": "imported"
    },
    "voice_167:r_1b9b2aab5cb104da": {
      "text": "I'll finish what the Quarter missed!",
      "status": "imported"
    },
    "voice_167:r_342044c706a2340f": {
      "text": "I have to protect them!",
      "status": "imported"
    },
    "voice_167:r_cf41e8828a90cbdb": {
      "text": "I'll draw the enemy to me!",
      "status": "imported"
    },
    "voice_167:r_719e897304ec42d4": {
      "text": "Look out, Captain!",
      "status": "imported"
    },
    "voice_167:r_d5e0a2317c40d322": {
      "text": "They're targeting you, Michel!",
      "status": "imported"
    },
    "voice_167:r_ec2ea17765052401": {
      "text": "That's too reckless, Alto!",
      "status": "imported"
    },
    "voice_167:r_f2d4255f1c2f7542": {
      "text": "Canaria! Please fall back!",
      "status": "imported"
    },
    "voice_167:r_5d08ad19e2da125b": {
      "text": "Captain Klan! Leave this to me!",
      "status": "imported"
    },
    "voice_167:r_a7246b52782a877e": {
      "text": "They won't sink\\nMacross Quarter!",
      "status": "imported"
    },
    "voice_167:r_dc8701f6bcb9904f": {
      "text": "I-I can't counterattack...!",
      "status": "imported"
    },
    "voice_167:r_d6bdd730f24f66eb": {
      "text": "I can't do a thing...!",
      "status": "imported"
    },
    "voice_167:r_41997412868c48c4": {
      "text": "I'm barely staying airborne...!",
      "status": "imported"
    },
    "voice_167:r_9e6cf4f389dae55c": {
      "text": "Only Michel\\ncould pull that off!",
      "status": "imported"
    },
    "voice_167:r_9e0c80ac7e33b459": {
      "text": "Damn, they got in my blind spot...!?",
      "status": "imported"
    },
    "voice_167:r_7432ef43ed3471dc": {
      "text": "Even I can handle this much!",
      "status": "imported"
    },
    "voice_167:r_065443f6ddfcf0d7": {
      "text": "That won't hit me!",
      "status": "imported"
    },
    "voice_167:r_47d52a2839c71715": {
      "text": "Good, I dodged it!",
      "status": "imported"
    },
    "voice_167:r_847f82e7f3eef651": {
      "text": "Just as predicted by the data...!",
      "status": "imported"
    },
    "voice_167:r_eb7ae28b53dc033c": {
      "text": "All units! Sending attack data now!",
      "status": "imported"
    },
    "voice_167:r_857c4a52ce8df0fd": {
      "text": "With the barrier, I'll be fine!",
      "status": "imported"
    },
    "voice_167:r_55417493fce1d347": {
      "text": "My Valkyrie's been scratched...!",
      "status": "imported"
    },
    "voice_167:r_8fdf5910927c9591": {
      "text": "The radome may be heavy, but...!",
      "status": "imported"
    },
    "voice_167:r_7d724dbcc4451e10": {
      "text": "Damage is minor! Continuing combat!",
      "status": "imported"
    },
    "voice_167:r_93e25418a203cb8f": {
      "text": "Whoa! Too focused on gathering data!",
      "status": "imported"
    },
    "voice_167:r_adeb0a29274d3d9b": {
      "text": "Does their power exceed the data?!",
      "status": "imported"
    },
    "voice_167:r_24cf161287ef9d5c": {
      "text": "If I retreat,\\nI can't help them...!",
      "status": "imported"
    },
    "voice_167:r_8f60f6fc86db3107": {
      "text": "Ugh! I need to update their data...!",
      "status": "imported"
    },
    "voice_167:r_b1de76a75a253c13": {
      "text": "I need to gain some distance!",
      "status": "imported"
    },
    "voice_167:r_128c35bf3e0e394c": {
      "text": "I won't go down that easily!",
      "status": "imported"
    },
    "voice_167:r_5213c17e13b23de0": {
      "text": "A direct hit? No way!",
      "status": "imported"
    },
    "voice_167:r_38fdff9483e9245c": {
      "text": "N-Nanase...!",
      "status": "imported"
    },
    "voice_167:r_620fedec67706d7d": {
      "text": "Damn!\\nI can't run away now!",
      "status": "imported"
    },
    "voice_167:r_9680dcd0fddcfcc7": {
      "text": "Did I miscalculate?!",
      "status": "imported"
    },
    "voice_167:r_2a00f1044ad5cbaa": {
      "text": "A-At least I can get its data...!",
      "status": "imported"
    },
    "voice_167:r_3dbeead1bd3164ef": {
      "text": "They got me...! Ejecting!",
      "status": "imported"
    },
    "voice_167:r_98d15b8cc09bc915": {
      "text": "I'm sorry! Skull 3 is withdrawing!",
      "status": "imported"
    },
    "voice_167:r_ac341e7976e88f0b": {
      "text": "To bring this battle to an end...!",
      "status": "imported"
    },
    "voice_167:r_cdbd128a5b4127cc": {
      "text": "Pinpoint Barrier!",
      "status": "imported"
    },
    "voice_167:r_cfccaa1fbeda124c": {
      "text": "I won't let you get away!",
      "status": "imported"
    },
    "voice_167:r_b1f8ec192b9c083a": {
      "text": "Hiiit!!",
      "status": "imported"
    },
    "voice_167:r_a007f9ab9cf048b3": {
      "text": "If you won't back down!",
      "status": "imported"
    },
    "voice_167:r_ddafde4b065ced49": {
      "text": "Target locked!",
      "status": "imported"
    },
    "voice_167:r_de1213040856c089": {
      "text": "Skull 3, commencing attack!",
      "status": "imported"
    },
    "voice_167:r_3304412ac41f47a6": {
      "text": "This should work!",
      "status": "imported"
    },
    "voice_167:r_0c0775e051211840": {
      "text": "I'll pull it off!",
      "status": "imported"
    },
    "voice_167:r_a2afffe1c396f0b3": {
      "text": "The Vajra...! No matter what!",
      "status": "imported"
    },
    "voice_167:r_13c25fbdfddc8a24": {
      "text": "I'll stop the Vajra here!",
      "status": "imported"
    },
    "voice_167:r_a77f4913375098d2": {
      "text": "You won't escape...!",
      "status": "imported"
    },
    "voice_167:r_428c2116ac3071b1": {
      "text": "I have to take them down here!",
      "status": "imported"
    },
    "voice_167:r_84c116267b79f540": {
      "text": "Even if you try to flee my range!",
      "status": "imported"
    },
    "voice_167:r_dad38ee29af2df3a": {
      "text": "I need to counterattack at once!",
      "status": "imported"
    },
    "voice_167:r_3d32e86f8dc80909": {
      "text": "Now it's my turn!",
      "status": "imported"
    },
    "voice_167:r_70451ffbabe2f876": {
      "text": "Skull 3, providing cover!",
      "status": "imported"
    },
    "voice_167:r_69dfa1659715e2fa": {
      "text": "I can still attack!",
      "status": "imported"
    },
    "voice_167:r_d996fd6d4ef5b329": {
      "text": "One more hit!",
      "status": "imported"
    },
    "voice_167:r_8ab47a28f99ef565": {
      "text": "Tracking the target!",
      "status": "imported"
    },
    "voice_167:r_546de3fb6db156ea": {
      "text": "If you missed your chance to escape!",
      "status": "imported"
    },
    "voice_167:r_ca85f87cee5e31f7": {
      "text": "I'm...! I'm such a pathetic man...!",
      "status": "imported"
    },
    "voice_167:r_9072ea7bc71df136": {
      "text": "Nanase...! I...!",
      "status": "imported"
    },
    "voice_167:r_04e815a8d425827d": {
      "text": "I have to hold on...! More enemies!",
      "status": "imported"
    },
    "voice_167:r_d89011fe3e5d082a": {
      "text": "If I fall,\\nI can't face Nanase...!",
      "status": "imported"
    },
    "voice_167:r_3c5b0c2ac812d5de": {
      "text": "Urgh!\\nI have to make it home!",
      "status": "imported"
    },
    "voice_167:r_5b9e8897190892eb": {
      "text": "I can't fall here all by myself!",
      "status": "imported"
    },
    "voice_167:r_7bea3023abbf8a94": {
      "text": "Damn it! I'll turn this around!",
      "status": "imported"
    },
    "voice_167:r_dd01a4c0d1b36a8d": {
      "text": "Systems check...! I can still go!",
      "status": "imported"
    },
    "voice_167:r_20920ad2eb3542db": {
      "text": "Hit dead-on...?\\nI can't retreat!",
      "status": "imported"
    },
    "voice_167:r_0ab7914877fd48ed": {
      "text": "Ugh! They forced their way in?!",
      "status": "imported"
    },
    "voice_167:r_cb846feec748c2e3": {
      "text": "Even a bad hit won't stop me!",
      "status": "imported"
    },
    "voice_167:r_c958860b0676b1f5": {
      "text": "I can still fly! I can still fight!",
      "status": "imported"
    },
    "voice_167:r_5e2669b82ef75ce3": {
      "text": "That won't work on me!",
      "status": "imported"
    },
    "voice_167:r_7847e0ed7dc9282d": {
      "text": "That was nothing...!",
      "status": "imported"
    },
    "voice_167:r_e42b52c7a987b906": {
      "text": "I can handle this much!",
      "status": "imported"
    },
    "voice_167:r_6825fd1ff907bd22": {
      "text": "I have to move faster!",
      "status": "imported"
    },
    "voice_167:r_607f666f1563bc0d": {
      "text": "Urgh! I can't stop here!",
      "status": "imported"
    },
    "voice_167:r_97b7431eeb81e6b6": {
      "text": "I knew you'd come at me that way!",
      "status": "imported"
    },
    "voice_167:r_132f605d02975e71": {
      "text": "Good! Just as I thought!",
      "status": "imported"
    },
    "voice_167:r_9b9726b1872759d6": {
      "text": "I know your attack pattern!",
      "status": "imported"
    },
    "voice_167:r_1252db29683fefe0": {
      "text": "It won't be that easy!",
      "status": "imported"
    },
    "voice_167:r_aba6a7662129d8ce": {
      "text": "I can't do anything...!",
      "status": "imported"
    },
    "voice_167:r_b84afafb8a33ec60": {
      "text": "Please withdraw immediately!",
      "status": "imported"
    },
    "voice_167:r_c8c59db85bf875e6": {
      "text": "I won't let you die!",
      "status": "imported"
    },
    "voice_167:r_f1e7ed9e5874aba5": {
      "text": "Simon, John, Pete...!",
      "status": "imported"
    },
    "voice_167:r_fc25e66a86fc2c85": {
      "text": "Don't hold back! Do it!!",
      "status": "imported"
    },
    "voice_167:r_5aeeb4917340c42d": {
      "text": "This is the power of Ghost!",
      "status": "imported"
    },
    "voice_167:r_b765659981b6516d": {
      "text": "We'll crush the Vajra completely...!",
      "status": "imported"
    },
    "voice_167:r_0c427458bc00eb95": {
      "text": "Go, Simon! John! Pete!!",
      "status": "imported"
    },
    "voice_167:r_774a9ab4d8fd5351": {
      "text": "We won!",
      "status": "imported"
    },
    "voice_167:r_d3f01de714c015bd": {
      "text": "Even I can do it if I try...!",
      "status": "imported"
    },
    "voice_167:r_7d2617c809fead70": {
      "text": "Stay back! Stay back!",
      "status": "imported"
    },
    "voice_167:r_ceb935ccbf830724": {
      "text": "I'm sorry! I'm firing!",
      "status": "imported"
    },
    "voice_167:r_26e5efec03c03d78": {
      "text": "Fight back...! I have to fight back!",
      "status": "imported"
    },
    "voice_167:r_4ad81e88c7557a8b": {
      "text": "I can manage one more time!",
      "status": "imported"
    },
    "voice_167:r_1f65a7af190e4674": {
      "text": "I-I can't burden everyone here!",
      "status": "imported"
    },
    "voice_167:r_40c5a9358ed5bf29": {
      "text": "Damn!\\nDamage check... I can fight!",
      "status": "imported"
    },
    "voice_167:r_f2e18dfdfe0c89ea": {
      "text": "Th-That won't work on me!",
      "status": "imported"
    },
    "voice_167:r_cf7dbf49e96a5755": {
      "text": "N-Next time, I'll dodge it properly!",
      "status": "imported"
    },
    "voice_167:r_fa96676cc65bb509": {
      "text": "Th-That was close...",
      "status": "imported"
    },
    "voice_167:r_4e37f92e7d2fc62e": {
      "text": "Yes! I dodged it!",
      "status": "imported"
    },
    "voice_167:r_8a29278549f8e07a": {
      "text": "What?! I thought I dodged that!",
      "status": "imported"
    },
    "voice_167:r_7e6c573c26177f98": {
      "text": "I'll handle the Ghost!",
      "status": "imported"
    },
    "voice_167:r_45abf84f7757d6eb": {
      "text": "I know the V-9's capabilities!",
      "status": "imported"
    },
    "voice_167:r_edd7a13ab8f06a14": {
      "text": "I'll gather data on that monster!",
      "status": "imported"
    },
    "voice_167:r_8165e5b41f0124c4": {
      "text": "Fight and see\\nhow much they vary...!",
      "status": "imported"
    },
    "voice_167:r_4e05581b7432cce8": {
      "text": "For now,\\nUse biology as a guide...!",
      "status": "imported"
    },
    "voice_167:r_a60b107ea3c36a86": {
      "text": "This is our final battle!",
      "status": "imported"
    },
    "voice_167:r_cb306ef55e49d107": {
      "text": "If we use a Reaction Missile!",
      "status": "imported"
    },
    "voice_167:r_57b2bd2de8a1408d": {
      "text": "Skull 3, enemy down confirmed!",
      "status": "imported"
    },
    "voice_167:r_76f080a4881e8ab5": {
      "text": "Reaction Missile authorized?! Good!",
      "status": "imported"
    },
    "voice_167:r_288133bc5b573dae": {
      "text": "Skull 3 to Delta 1!\\nMission success!",
      "status": "imported"
    },
    "voice_167:r_6f95653e548f8fcf": {
      "text": "Normal warheads? You're dead wrong!",
      "status": "imported"
    },
    "voice_167:r_d249d68bada91ab9": {
      "text": "Okay, remaining hostile signals...!",
      "status": "imported"
    },
    "voice_167:r_e9b3307e9eb69f11": {
      "text": "Amazing, Alto!\\nSuch VF-25 mastery!",
      "status": "imported"
    },
    "voice_167:r_03cdac73042343ee": {
      "text": "They handle the YF-29 that well...!",
      "status": "imported"
    },
    "voice_167:r_6026da5acbda7c69": {
      "text": "I won't let them destroy the YF-29!",
      "status": "imported"
    },
    "voice_167:r_981f8fedd5414fe5": {
      "text": "If I can help even a little...!",
      "status": "imported"
    },
    "voice_167:r_96bb0dcde0c8c44a": {
      "text": "If we concentrate our attacks!",
      "status": "imported"
    },
    "voice_167:r_641550a2f54cb456": {
      "text": "I'll find a way!",
      "status": "imported"
    },
    "voice_167:r_b5f5a97ed82acb0b": {
      "text": "I'm not confident... but I'll try!",
      "status": "imported"
    },
    "voice_167:r_d9cd2e4ded064396": {
      "text": "I mustn't become a burden...!",
      "status": "imported"
    },
    "voice_167:r_99e6349431aaf23b": {
      "text": "Against one enemy, even I can do it!",
      "status": "imported"
    }
  }
}
