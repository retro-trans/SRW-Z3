{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_204:r_479b340ccc6c572b": {
      "text": "Let's go!",
      "status": "imported"
    },
    "voice_204:r_77949221bf58f862": {
      "text": "Eat this!",
      "status": "imported"
    },
    "voice_204:r_70b9c4b9f1f37eff": {
      "text": "Here you go!",
      "status": "imported"
    },
    "voice_204:r_9fcb3754cb1773c7": {
      "text": "Got you!",
      "status": "imported"
    },
    "voice_204:r_3559d2fad32c2435": {
      "text": "See ya!",
      "status": "imported"
    },
    "voice_204:r_f7570547e9f80a64": {
      "text": "Die!",
      "status": "imported"
    },
    "voice_204:r_cbab0f4720e1fcf1": {
      "text": "This'll hurt!",
      "status": "imported"
    },
    "voice_204:r_0bbe0b4f5364e732": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_204:r_5dda5198137cb02a": {
      "text": "You're finished!",
      "status": "imported"
    },
    "voice_204:r_83ec59afbecdec14": {
      "text": "Let's say hello!",
      "status": "imported"
    },
    "voice_204:r_e20bfd42ad95a3c9": {
      "text": "Time to get to work!",
      "status": "imported"
    },
    "voice_204:r_0f58a8822381e57f": {
      "text": "Let's get this over with!",
      "status": "imported"
    },
    "voice_204:r_6dbcc507fb61b51d": {
      "text": "This mission's a cakewalk!",
      "status": "imported"
    },
    "voice_204:r_b42ab697149a7c8a": {
      "text": "I've gotta earn my pay!",
      "status": "imported"
    },
    "voice_204:r_4de4fcf3b440baf4": {
      "text": "Just gotta carry out the mission!",
      "status": "imported"
    },
    "voice_204:r_0121a166c715cdff": {
      "text": "A little risk makes it more fun!",
      "status": "imported"
    },
    "voice_204:r_30fad37a42bd3ad3": {
      "text": "Tough luck, pal!",
      "status": "imported"
    },
    "voice_204:r_80a0b2a84e05d81a": {
      "text": "Move and you'll only hurt worse!",
      "status": "imported"
    },
    "voice_204:r_4a9ac1dff86506d9": {
      "text": "I'll hit you dead-on!",
      "status": "imported"
    },
    "voice_204:r_bc8538e6af3d2577": {
      "text": "Running won't do you any good!",
      "status": "imported"
    },
    "voice_204:r_924516c8de2b5342": {
      "text": "I've got you in my sights!",
      "status": "imported"
    },
    "voice_204:r_da1174533722333f": {
      "text": "Target locked!",
      "status": "imported"
    },
    "voice_204:r_fdeb8162976e72c1": {
      "text": "At this range, this'll do...!",
      "status": "imported"
    },
    "voice_204:r_0fadb5c26df92b42": {
      "text": "Taking this to a grapple!",
      "status": "imported"
    },
    "voice_204:r_6b15af9a0057cdc8": {
      "text": "I'll crush your cockpit!",
      "status": "imported"
    },
    "voice_204:r_15b4a90140e8a33a": {
      "text": "I'll finish you in close combat!",
      "status": "imported"
    },
    "voice_204:r_af884a6b11dff121": {
      "text": "Hah!",
      "status": "imported"
    },
    "voice_204:r_ac6fe7838e95647b": {
      "text": "Here you go!",
      "status": "imported"
    },
    "voice_204:r_77ca87eacd17ad52": {
      "text": "There!",
      "status": "imported"
    },
    "voice_204:r_bf3244994760e535": {
      "text": "Raaagh!",
      "status": "imported"
    },
    "voice_204:r_aabfb21c9d069ce7": {
      "text": "Haaaaah!",
      "status": "imported"
    },
    "voice_204:r_02479dc8fe989560": {
      "text": "Hyaaah!",
      "status": "imported"
    },
    "voice_204:r_a2df00f91a9b0a9e": {
      "text": "Finishing blow!",
      "status": "imported"
    },
    "voice_204:r_48b60d6c48b9b142": {
      "text": "It's over!",
      "status": "imported"
    },
    "voice_204:r_8927e6fb681aa809": {
      "text": "No time to waste! Going all in!",
      "status": "imported"
    },
    "voice_204:r_665f01666859013b": {
      "text": "About time you went down!",
      "status": "imported"
    },
    "voice_204:r_a571eec59b258d11": {
      "text": "That's some nice gear you've got...!",
      "status": "imported"
    },
    "voice_204:r_ddbe581c5ea9183d": {
      "text": "So the elusive mercs show up!",
      "status": "imported"
    },
    "voice_204:r_faae935cca0edc72": {
      "text": "You think you're heroes?!",
      "status": "imported"
    },
    "voice_204:r_d4430bf362340b32": {
      "text": "I've got a score to settle with you!",
      "status": "imported"
    },
    "voice_204:r_6ff1323b355593e0": {
      "text": "That's one flashy machine...!",
      "status": "imported"
    },
    "voice_204:r_b7b5625d7cd4282f": {
      "text": "A one-off AS! Worth wrecking",
      "status": "imported"
    },
    "voice_204:r_36133ad73a73ef98": {
      "text": "This ain't a zoo or dreamland!",
      "status": "imported"
    },
    "voice_204:r_920740a0219c5085": {
      "text": "Quit screwing around already!!",
      "status": "imported"
    },
    "voice_204:r_a8451712c57c1a72": {
      "text": "I'll crush their commander!",
      "status": "imported"
    },
    "voice_204:r_3633df5b7b8f47fa": {
      "text": "I'll crush the head and end this!",
      "status": "imported"
    },
    "voice_204:r_52dfc56b14b93551": {
      "text": "Quit scurrying around, you rat...!",
      "status": "imported"
    },
    "voice_204:r_1b9b2aab5cb104da": {
      "text": "A towering pile of crap!",
      "status": "imported"
    },
    "voice_204:r_342044c706a2340f": {
      "text": "Beat a Gundam and I'll make my name!",
      "status": "imported"
    },
    "voice_204:r_cf41e8828a90cbdb": {
      "text": "Me, fighting a Gundam?\\nWho knew...!",
      "status": "imported"
    },
    "voice_204:r_719e897304ec42d4": {
      "text": "I'm up against the latest MS!",
      "status": "imported"
    },
    "voice_204:r_d5e0a2317c40d322": {
      "text": "That notorious colony Gundam, huh!",
      "status": "imported"
    },
    "voice_204:r_ec2ea17765052401": {
      "text": "Celestial Being!\\nA long-held grudge!",
      "status": "imported"
    },
    "voice_204:r_f2d4255f1c2f7542": {
      "text": "Black Knights survivors, huh!",
      "status": "imported"
    },
    "voice_204:r_5d08ad19e2da125b": {
      "text": "I'll smash that mask to pieces!",
      "status": "imported"
    },
    "voice_204:r_a7246b52782a877e": {
      "text": "We're both just dogs of war!",
      "status": "imported"
    },
    "voice_204:r_dc8701f6bcb9904f": {
      "text": "That guy...! A Red Shoulder?!",
      "status": "imported"
    },
    "voice_204:r_d6bdd730f24f66eb": {
      "text": "A Quent, bought off for money?!",
      "status": "imported"
    },
    "voice_204:r_41997412868c48c4": {
      "text": "Both hired guns! Let's get along!",
      "status": "imported"
    },
    "voice_204:r_9e0c80ac7e33b459": {
      "text": "I won't spare civilians either!",
      "status": "imported"
    },
    "voice_204:r_47d52a2839c71715": {
      "text": "You big lug...! Don't get cocky!",
      "status": "imported"
    },
    "voice_204:r_847f82e7f3eef651": {
      "text": "If power fails,\\nspeed will do it!",
      "status": "imported"
    },
    "voice_204:r_eb7ae28b53dc033c": {
      "text": "Drop your rare loot! I want a bonus!",
      "status": "imported"
    },
    "voice_204:r_857c4a52ce8df0fd": {
      "text": "Damn! I can't match that speed!",
      "status": "imported"
    },
    "voice_204:r_55417493fce1d347": {
      "text": "Scurrying around in my face...!",
      "status": "imported"
    },
    "voice_204:r_8fdf5910927c9591": {
      "text": "This guy...! He's lost his mind!",
      "status": "imported"
    },
    "voice_204:r_7d724dbcc4451e10": {
      "text": "Sink the ship and I get a bonus!",
      "status": "imported"
    },
    "voice_204:r_93e25418a203cb8f": {
      "text": "One hit on the bridge ends this!",
      "status": "imported"
    },
    "voice_204:r_b28faf9f71bc3598": {
      "text": "You'll pay for that!",
      "status": "imported"
    },
    "voice_204:r_8a29278549f8e07a": {
      "text": "Now it's my turn to strike back!",
      "status": "imported"
    },
    "voice_204:r_7e6c573c26177f98": {
      "text": "I'm a man who repays his debts!",
      "status": "imported"
    },
    "voice_204:r_45abf84f7757d6eb": {
      "text": "Payback starts at double!",
      "status": "imported"
    },
    "voice_204:r_edd7a13ab8f06a14": {
      "text": "You won't make it home alive!",
      "status": "imported"
    },
    "voice_204:r_8165e5b41f0124c4": {
      "text": "You're not getting away!",
      "status": "imported"
    },
    "voice_204:r_4e05581b7432cce8": {
      "text": "Now take one of mine!",
      "status": "imported"
    },
    "voice_204:r_a60b107ea3c36a86": {
      "text": "Here's your payback! Take it!",
      "status": "imported"
    },
    "voice_204:r_e33693e5ba4665b0": {
      "text": "I never forget a grudge!",
      "status": "imported"
    },
    "voice_204:r_72a21a1a489af001": {
      "text": "Careless attacks get you this!",
      "status": "imported"
    },
    "voice_204:r_eb643f8bf737a0ca": {
      "text": "Time for some teamwork!",
      "status": "imported"
    },
    "voice_204:r_0a3fccb71ec6cf2a": {
      "text": "Let me in on this!",
      "status": "imported"
    },
    "voice_204:r_9b63cf1f3e0207ef": {
      "text": "I'm taking the finishing blow!",
      "status": "imported"
    },
    "voice_204:r_8356f4e3dcdff938": {
      "text": "I'll handle this!",
      "status": "imported"
    },
    "voice_204:r_1d6d784036ae0bd7": {
      "text": "You owe me one for this!",
      "status": "imported"
    },
    "voice_204:r_625664af02183c17": {
      "text": "Stay back!",
      "status": "imported"
    },
    "voice_204:r_3701cba361f80ea5": {
      "text": "You can't counter?! Get it together!",
      "status": "imported"
    },
    "voice_204:r_63f429c5c68c0863": {
      "text": "Damn! I can only watch them go?!",
      "status": "imported"
    },
    "voice_204:r_38e4a434c91d8ef0": {
      "text": "Tch! They're one step ahead...!",
      "status": "imported"
    },
    "voice_204:r_98ed411352a3a6ac": {
      "text": "They completely outmaneuvered me...!",
      "status": "imported"
    },
    "voice_204:r_4824bea6bab3af67": {
      "text": "Remember this! I'll pay back double!",
      "status": "imported"
    },
    "voice_204:r_862b92e63adb9734": {
      "text": "Damn! They've blocked my counter!",
      "status": "imported"
    },
    "voice_204:r_cb306ef55e49d107": {
      "text": "Not happening!",
      "status": "imported"
    },
    "voice_204:r_57b2bd2de8a1408d": {
      "text": "All right! Just as planned!",
      "status": "imported"
    },
    "voice_204:r_76f080a4881e8ab5": {
      "text": "You've seriously underestimated me!",
      "status": "imported"
    },
    "voice_204:r_288133bc5b573dae": {
      "text": "You got a total amateur in there?",
      "status": "imported"
    },
    "voice_204:r_6f95653e548f8fcf": {
      "text": "A textbook attack...!",
      "status": "imported"
    },
    "voice_204:r_d249d68bada91ab9": {
      "text": "What a sloppy attack...!",
      "status": "imported"
    },
    "voice_204:r_e9b3307e9eb69f11": {
      "text": "Go on and stew over it!",
      "status": "imported"
    },
    "voice_204:r_03cdac73042343ee": {
      "text": "The world's never that simple!",
      "status": "imported"
    },
    "voice_204:r_6026da5acbda7c69": {
      "text": "Get it through your head: Futile!",
      "status": "imported"
    },
    "voice_204:r_96bb0dcde0c8c44a": {
      "text": "Sorry...! I've got gear for that!",
      "status": "imported"
    },
    "voice_204:r_641550a2f54cb456": {
      "text": "Your attack's too weak...!",
      "status": "imported"
    },
    "voice_204:r_a0f2074af8debbfa": {
      "text": "Whoa! Got a little carried away!",
      "status": "imported"
    },
    "voice_204:r_b5f5a97ed82acb0b": {
      "text": "Understand the gap between us...!",
      "status": "imported"
    },
    "voice_204:r_d9cd2e4ded064396": {
      "text": "I've got no use for small fry!",
      "status": "imported"
    },
    "voice_204:r_99e6349431aaf23b": {
      "text": "Try being a little more creative!",
      "status": "imported"
    },
    "voice_204:r_ec1081caf845f56a": {
      "text": "Damn! You just won't go down!",
      "status": "imported"
    },
    "voice_204:r_2c5b7ee872c1ed7f": {
      "text": "My armor knocked that away...!",
      "status": "imported"
    },
    "voice_204:r_76d1e51c8b494a60": {
      "text": "No need to worry about this much...!",
      "status": "imported"
    },
    "voice_204:r_eb5f687fcd372ae7": {
      "text": "Looks like you've got some skill...!",
      "status": "imported"
    },
    "voice_204:r_2329428a6871d9fa": {
      "text": "Damn, you're one persistent bastard!",
      "status": "imported"
    },
    "voice_204:r_0e7466971bec4cc4": {
      "text": "Didn't think you'd hang on so long!",
      "status": "imported"
    },
    "voice_204:r_efa71f7a4cc33ff3": {
      "text": "So this job won't be that easy...!",
      "status": "imported"
    },
    "voice_204:r_3fc2e1186557e7a0": {
      "text": "Class B damage to the legs...!?",
      "status": "imported"
    },
    "voice_204:r_fa6930340a545054": {
      "text": "Bastard...! Better than I thought!",
      "status": "imported"
    },
    "voice_204:r_2332b9d56461d7ab": {
      "text": "Things are taking an ugly turn...!",
      "status": "imported"
    },
    "voice_204:r_854aa0a91a3c80d1": {
      "text": "Tch...! Raise my pay,\\nor I'm done!",
      "status": "imported"
    },
    "voice_204:r_0bc8ae32a406ceab": {
      "text": "This is bad...! The tide's turning!",
      "status": "imported"
    },
    "voice_204:r_82c09f011d703b2c": {
      "text": "How long since a mess like this...?!",
      "status": "imported"
    },
    "voice_204:r_2b4d8818c77b6dca": {
      "text": "They've taken complete control...!",
      "status": "imported"
    },
    "voice_204:r_087354f2db0a31e6": {
      "text": "Damn! You've been cocky long enough!",
      "status": "imported"
    },
    "voice_204:r_db02a2dec93dd263": {
      "text": "That latest gear's no mere show!",
      "status": "imported"
    },
    "voice_204:r_d520c6d5298a848d": {
      "text": "They beat any ordinary army!",
      "status": "imported"
    },
    "voice_204:r_099e2458cabf796f": {
      "text": "Tch! What a bunch of busybodies!",
      "status": "imported"
    },
    "voice_204:r_fd910d714be70870": {
      "text": "That movement...! No ordinary AS!",
      "status": "imported"
    },
    "voice_204:r_9736f29b11344ec3": {
      "text": "What the hell is that white AS?!",
      "status": "imported"
    },
    "voice_204:r_fcd05582aa5c6068": {
      "text": "This is a dream...! A nightmare!",
      "status": "imported"
    },
    "voice_204:r_bece29562818acba": {
      "text": "Cute! And strong!",
      "status": "imported"
    },
    "voice_204:r_494b5da92ed24ecb": {
      "text": "What is that overwhelming power?!",
      "status": "imported"
    },
    "voice_204:r_a4a5a96f4bd58920": {
      "text": "Damn!\\nSo this is Super Robot power!",
      "status": "imported"
    },
    "voice_204:r_b57d2d74233f889a": {
      "text": "Not bad, Gundam!",
      "status": "imported"
    },
    "voice_204:r_cd06d0820d82524b": {
      "text": "Gundam, and\\nits pilot... Monsters!",
      "status": "imported"
    },
    "voice_204:r_c94c6d04be583774": {
      "text": "That guy...! No ordinary AT pilot!",
      "status": "imported"
    },
    "voice_204:r_e54e2c99ef8297af": {
      "text": "Not the mech...!\\nPilot skill?!",
      "status": "imported"
    },
    "voice_204:r_f16a3eb0bcaac082": {
      "text": "Celestial Being...\\nIn my way again?!",
      "status": "imported"
    },
    "voice_204:r_10a408809e512df1": {
      "text": "Damn persistent Black Knights!",
      "status": "imported"
    },
    "voice_204:r_bc7b9e308b879dd4": {
      "text": "If a salaryman beats me, I retire!",
      "status": "imported"
    },
    "voice_204:r_240651adab81e145": {
      "text": "Guaaagh! What power!",
      "status": "imported"
    },
    "voice_204:r_cff0deaae73c2858": {
      "text": "Bastard! You're way too strong!",
      "status": "imported"
    },
    "voice_204:r_dca67f68a573fab7": {
      "text": "This is bad! A direct hit!",
      "status": "imported"
    },
    "voice_204:r_a6630215fefaf294": {
      "text": "Everything I do backfires!",
      "status": "imported"
    },
    "voice_204:r_6f94566ad37f8ff8": {
      "text": "Is this the end of the line for me?!",
      "status": "imported"
    },
    "voice_204:r_942ca03c9de80143": {
      "text": "I won't go down without a fight!",
      "status": "imported"
    },
    "voice_204:r_d8c669c70659e18a": {
      "text": "A system error?! You cheap junk!",
      "status": "imported"
    },
    "voice_204:r_8f5bade7ac2db78e": {
      "text": "It's shorting out everywhere!",
      "status": "imported"
    },
    "voice_204:r_05ea490d2f522520": {
      "text": "Lured by cash,\\nstraight into hell!",
      "status": "imported"
    },
    "voice_204:r_f5658c702d91db7a": {
      "text": "Damn! This job wasn't worth it!",
      "status": "imported"
    },
    "voice_204:r_686df329b50f195b": {
      "text": "My gut says this is real bad...!",
      "status": "imported"
    },
    "voice_204:r_25f0ab0fa3cf690c": {
      "text": "Move, you junk!\\nThis isn't over yet!",
      "status": "imported"
    },
    "voice_204:r_b708a1d959013dbf": {
      "text": "Damn! Is this it for me?!",
      "status": "imported"
    },
    "voice_204:r_59fca03e929366c1": {
      "text": "Am I having a bad dream...?!",
      "status": "imported"
    },
    "voice_204:r_0d65eb631dcb7514": {
      "text": "See ya! I'll wait for you in hell!",
      "status": "imported"
    },
    "voice_204:r_d03018a31e23f1e9": {
      "text": "You bastaaaaard...!",
      "status": "imported"
    },
    "voice_204:r_279da5f732aa8847": {
      "text": "Aaaaaaaaagh!",
      "status": "imported"
    },
    "voice_204:r_97f82e3cb6f70110": {
      "text": "Damn! I'm abandoning the machine!",
      "status": "imported"
    },
    "voice_204:r_c5611d8dd6def96b": {
      "text": "There goes my whole payday!",
      "status": "imported"
    },
    "voice_204:r_6f12cc8ed2732eb5": {
      "text": "Remember this! I'm one stubborn man!",
      "status": "imported"
    },
    "voice_204:r_7abfc55f8fb62ba7": {
      "text": "Lost to a costume...!\\nI retire!",
      "status": "imported"
    },
    "voice_204:r_99e7a66c650b5892": {
      "text": "Bonta-kun beat me...\\nNo regrets...!",
      "status": "imported"
    },
    "voice_204:r_5b2247b5cfbcd7b2": {
