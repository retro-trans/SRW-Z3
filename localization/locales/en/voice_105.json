{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_105:r_479b340ccc6c572b": {
      "text": "Now!",
      "status": "imported"
    },
    "voice_105:r_ca4acbac57a2a35e": {
      "text": "Let's go!",
      "status": "imported"
    },
    "voice_105:r_77949221bf58f862": {
      "text": "Why, you!",
      "status": "imported"
    },
    "voice_105:r_70b9c4b9f1f37eff": {
      "text": "So you've shown yourself...!",
      "status": "imported"
    },
    "voice_105:r_9fcb3754cb1773c7": {
      "text": "I won't hesitate...!",
      "status": "imported"
    },
    "voice_105:r_3559d2fad32c2435": {
      "text": "If I'm to protect peace...!",
      "status": "imported"
    },
    "voice_105:r_f7570547e9f80a64": {
      "text": "All right! Full power!",
      "status": "imported"
    },
    "voice_105:r_cbab0f4720e1fcf1": {
      "text": "I'll use my power for what's right!",
      "status": "imported"
    },
    "voice_105:r_0bbe0b4f5364e732": {
      "text": "If my power can help everyone...!",
      "status": "imported"
    },
    "voice_105:r_5dda5198137cb02a": {
      "text": "I'll protect Earth!",
      "status": "imported"
    },
    "voice_105:r_83ec59afbecdec14": {
      "text": "I'll protect Earth, my second home!",
      "status": "imported"
    },
    "voice_105:r_e20bfd42ad95a3c9": {
      "text": "Let's do this, Godmars!",
      "status": "imported"
    },
    "voice_105:r_0f58a8822381e57f": {
      "text": "I'll show you Godmars' power!",
      "status": "imported"
    },
    "voice_105:r_6dbcc507fb61b51d": {
      "text": "With Godmars' power!",
      "status": "imported"
    },
    "voice_105:r_b42ab697149a7c8a": {
      "text": "One more attack!",
      "status": "imported"
    },
    "voice_105:r_4de4fcf3b440baf4": {
      "text": "Here's our chance! Hit 'em hard!",
      "status": "imported"
    },
    "voice_105:r_0121a166c715cdff": {
      "text": "Same planet,\\nyet we still fight...!",
      "status": "imported"
    },
    "voice_105:r_30fad37a42bd3ad3": {
      "text": "Blind followers\\nare everywhere...!",
      "status": "imported"
    },
    "voice_105:r_bc8538e6af3d2577": {
      "text": "Monster! I won't let you go on!",
      "status": "imported"
    },
    "voice_105:r_924516c8de2b5342": {
      "text": "If you only run amok,\\nno mercy!",
      "status": "imported"
    },
    "voice_105:r_da1174533722333f": {
      "text": "For peace and happiness,\\nI'll fight!",
      "status": "imported"
    },
    "voice_105:r_fdeb8162976e72c1": {
      "text": "A tough foe...! But I can't lose!",
      "status": "imported"
    },
    "voice_105:r_0fadb5c26df92b42": {
      "text": "I'll defeat you and end this fight!",
      "status": "imported"
    },
    "voice_105:r_6b15af9a0057cdc8": {
      "text": "Hah!",
      "status": "imported"
    },
    "voice_105:r_15b4a90140e8a33a": {
      "text": "Sei!",
      "status": "imported"
    },
    "voice_105:r_af884a6b11dff121": {
      "text": "Yah!",
      "status": "imported"
    },
    "voice_105:r_ac6fe7838e95647b": {
      "text": "Hyah!",
      "status": "imported"
    },
    "voice_105:r_77ca87eacd17ad52": {
      "text": "Hmph!",
      "status": "imported"
    },
    "voice_105:r_bf3244994760e535": {
      "text": "Hyaaah!",
      "status": "imported"
    },
    "voice_105:r_aabfb21c9d069ce7": {
      "text": "There!",
      "status": "imported"
    },
    "voice_105:r_02479dc8fe989560": {
      "text": "Raaah!",
      "status": "imported"
    },
    "voice_105:r_a2df00f91a9b0a9e": {
      "text": "God Fire!",
      "status": "imported"
    },
    "voice_105:r_48b60d6c48b9b142": {
      "text": "God\\nFire!!",
      "status": "imported"
    },
    "voice_105:r_8927e6fb681aa809": {
      "text": "Mars Flash!",
      "status": "imported"
    },
    "voice_105:r_665f01666859013b": {
      "text": "Mars Flash!!",
      "status": "imported"
    },
    "voice_105:r_a571eec59b258d11": {
      "text": "God Fire!",
      "status": "imported"
    },
    "voice_105:r_ddbe581c5ea9183d": {
      "text": "Mars Flash!",
      "status": "imported"
    },
    "voice_105:r_faae935cca0edc72": {
      "text": "Final Godmars!!",
      "status": "imported"
    },
    "voice_105:r_b7b5625d7cd4282f": {
      "text": "Final! Godmars!!",
      "status": "imported"
    },
    "voice_105:r_eb7ae28b53dc033c": {
      "text": "You won't get away!",
      "status": "imported"
    },
    "voice_105:r_857c4a52ce8df0fd": {
      "text": "Now it's my turn!",
      "status": "imported"
    },
    "voice_105:r_55417493fce1d347": {
      "text": "I can sense you...! There!!",
      "status": "imported"
    },
    "voice_105:r_8fdf5910927c9591": {
      "text": "You think this is how I'll end?!",
      "status": "imported"
    },
    "voice_105:r_7d724dbcc4451e10": {
      "text": "Time to return the favor!",
      "status": "imported"
    },
    "voice_105:r_93e25418a203cb8f": {
      "text": "If you escape,\\nsomeone else dies...!",
      "status": "imported"
    },
    "voice_105:r_adeb0a29274d3d9b": {
      "text": "Counterattack, Godmars!",
      "status": "imported"
    },
    "voice_105:r_24cf161287ef9d5c": {
      "text": "I'll lend a hand too!",
      "status": "imported"
    },
    "voice_105:r_8f60f6fc86db3107": {
      "text": "This is Takeru! I'm following!",
      "status": "imported"
    },
    "voice_105:r_b1de76a75a253c13": {
      "text": "Captain! I'm right behind you!",
      "status": "imported"
    },
    "voice_105:r_128c35bf3e0e394c": {
      "text": "Leave this to me!",
      "status": "imported"
    },
    "voice_105:r_5213c17e13b23de0": {
      "text": "Get away while you can!",
      "status": "imported"
    },
    "voice_105:r_38fdff9483e9245c": {
      "text": "I won't let you hit Cosmo Crusher!",
      "status": "imported"
    },
    "voice_105:r_620fedec67706d7d": {
      "text": "Damn it...! I can't counterattack!",
      "status": "imported"
    },
    "voice_105:r_9680dcd0fddcfcc7": {
      "text": "Ugh...!\\nPsychic power overuse...!?",
      "status": "imported"
    },
    "voice_105:r_98d15b8cc09bc915": {
      "text": "Damn! Did I push myself too hard...!",
      "status": "imported"
    },
    "voice_105:r_46e86d000250e137": {
      "text": "No! My energy...!",
      "status": "imported"
    },
    "voice_105:r_ac341e7976e88f0b": {
      "text": "From that far away...!?",
      "status": "imported"
    },
    "voice_105:r_cdbd128a5b4127cc": {
      "text": "There's no way I can reach that far!",
      "status": "imported"
    },
    "voice_105:r_cfccaa1fbeda124c": {
      "text": "I can read it...! Their attack!",
      "status": "imported"
    },
    "voice_105:r_b1f8ec192b9c083a": {
      "text": "I can't let that hit me!",
      "status": "imported"
    },
    "voice_105:r_a007f9ab9cf048b3": {
      "text": "If I can keep dodging like this...!",
      "status": "imported"
    },
    "voice_105:r_ddafde4b065ced49": {
      "text": "I sensed hostility and moved...!",
      "status": "imported"
    },
    "voice_105:r_de1213040856c089": {
      "text": "What's wrong?! I'm right here!",
      "status": "imported"
    },
    "voice_105:r_3304412ac41f47a6": {
      "text": "That attack won't work on me!",
      "status": "imported"
    },
    "voice_105:r_a2afffe1c396f0b3": {
      "text": "All right! The barrier will hold!",
      "status": "imported"
    },
    "voice_105:r_13c25fbdfddc8a24": {
      "text": "I won't lose! Never!",
      "status": "imported"
    },
    "voice_105:r_42ba1ecb310b4bd7": {
      "text": "Stop this! You have to stop!",
      "status": "imported"
    },
    "voice_105:r_d692f1d420460a47": {
      "text": "All right! I can handle this much!",
      "status": "imported"
    },
    "voice_105:r_a5643cec86b18bd2": {
      "text": "My heart won't waver\\nfrom that!",
      "status": "imported"
    },
    "voice_105:r_68f2dfab20a4a30e": {
      "text": "A strong heart can weather this!",
      "status": "imported"
    },
    "voice_105:r_9cedad8237480563": {
      "text": "I have to avoid a direct hit...!",
      "status": "imported"
    },
    "voice_105:r_a03fabecba1508ca": {
      "text": "Godmars won't be beaten\\nthat easily!",
      "status": "imported"
    },
    "voice_105:r_5391b24a71eb10ae": {
      "text": "You...! What incredible power!?",
      "status": "imported"
    },
    "voice_105:r_a554ceef5c87b972": {
      "text": "Pushed back...!\\nMore power...!",
      "status": "imported"
    },
    "voice_105:r_546c3d5937fbb7ee": {
      "text": "Not yet! I won't lose!",
      "status": "imported"
    },
    "voice_105:r_1568ff6298b12b96": {
      "text": "I won't break...! I can still fight!",
      "status": "imported"
    },
    "voice_105:r_2c9d94ba13c5fc50": {
      "text": "Not yet!\\nToo much still rides on me!",
      "status": "imported"
    },
    "voice_105:r_a77f4913375098d2": {
      "text": "To protect Earth, this is nothing!",
      "status": "imported"
    },
    "voice_105:r_428c2116ac3071b1": {
      "text": "Godmars' armor!?\\nSuch power!",
      "status": "imported"
    },
    "voice_105:r_84c116267b79f540": {
      "text": "I...! I can't afford to lose!!",
      "status": "imported"
    },
    "voice_105:r_dad38ee29af2df3a": {
      "text": "Ngh! I won't quit till the end...!",
      "status": "imported"
    },
    "voice_105:r_3d32e86f8dc80909": {
      "text": "Use every last bit!\\nI won't die!",
      "status": "imported"
    },
    "voice_105:r_70451ffbabe2f876": {
      "text": "My life isn't mine alone!",
      "status": "imported"
    },
    "voice_105:r_69dfa1659715e2fa": {
      "text": "Not yet!\\nHold together, Godmars!",
      "status": "imported"
    },
    "voice_105:r_d996fd6d4ef5b329": {
      "text": "Marg...!\\nI can't join you yet...!",
      "status": "imported"
    },
    "voice_105:r_8ab47a28f99ef565": {
      "text": "Rise! Godmars!!",
      "status": "imported"
    },
    "voice_105:r_546de3fb6db156ea": {
      "text": "Six-God Combination!",
      "status": "imported"
    },
    "voice_105:r_ca85f87cee5e31f7": {
      "text": "Gaiyar! Take him down!",
      "status": "imported"
    },
    "voice_105:r_9072ea7bc71df136": {
      "text": "Crusher Team attacks\\naren't over!",
      "status": "imported"
    },
    "voice_105:r_04e815a8d425827d": {
      "text": "Raise the power higher than before!",
      "status": "imported"
    },
    "voice_105:r_d89011fe3e5d082a": {
      "text": "At this rate...! I'm finished!?",
      "status": "imported"
    },
    "voice_105:r_3c5b0c2ac812d5de": {
      "text": "That pathetic attack?!",
      "status": "imported"
    },
    "voice_105:r_5b9e8897190892eb": {
      "text": "Captain! Don't push it - fall back!",
      "status": "imported"
    },
    "voice_105:r_7bea3023abbf8a94": {
      "text": "I'll fight with my brother's spirit!",
      "status": "imported"
    },
    "voice_105:r_dd01a4c0d1b36a8d": {
      "text": "Keep watching, Marg...!",
      "status": "imported"
    },
    "voice_105:r_20920ad2eb3542db": {
      "text": "My psychic power\\nis rising too...!",
      "status": "imported"
    },
    "voice_105:r_0ab7914877fd48ed": {
      "text": "I won't hesitate to protect peace!",
      "status": "imported"
    },
    "voice_105:r_cb846feec748c2e3": {
      "text": "If I must fight\\nto protect them...!",
      "status": "imported"
    },
    "voice_105:r_c958860b0676b1f5": {
      "text": "I'll put my life on the line too...!",
      "status": "imported"
    },
    "voice_105:r_5e2669b82ef75ce3": {
      "text": "Use psychic power for evil?\\nFace me!",
      "status": "imported"
    },
    "voice_105:r_7847e0ed7dc9282d": {
      "text": "Face me, Space Demon King!",
      "status": "imported"
    },
    "voice_105:r_e42b52c7a987b906": {
      "text": "Beat the Demon General; sow chaos!",
      "status": "imported"
    },
    "voice_105:r_6825fd1ff907bd22": {
      "text": "Minion of Space Demon King! Done!",
      "status": "imported"
    },
    "voice_105:r_607f666f1563bc0d": {
      "text": "I have to stop Gura for Shotaro!",
      "status": "imported"
    },
    "voice_105:r_97b7431eeb81e6b6": {
      "text": "Gura! Open your heart to me!",
      "status": "imported"
    },
    "voice_105:r_132f605d02975e71": {
      "text": "Why do people resort to war...!",
      "status": "imported"
    },
    "voice_105:r_9b9726b1872759d6": {
      "text": "Fight like this,\\ncan peace come...!",
      "status": "imported"
    },
    "voice_105:r_1252db29683fefe0": {
      "text": "I hate fighting...! But now...!",
      "status": "imported"
    },
    "voice_105:r_ad3d538f1e909184": {
      "text": "I'll stop your machine! Hold on!",
      "status": "imported"
    },
    "voice_105:r_8c61c59a1c0aebbf": {
      "text": "I must strip its combat ability...!",
      "status": "imported"
    },
    "voice_105:r_aba6a7662129d8ce": {
      "text": "Telepathy fails...!\\nWhat is it?!",
      "status": "imported"
    },
    "voice_105:r_b84afafb8a33ec60": {
      "text": "An eerie foe...!\\nBut I can't lose!",
      "status": "imported"
    },
    "voice_105:r_c8c59db85bf875e6": {
      "text": "Primal calamity...! Baal, our bane!",
      "status": "imported"
    },
    "voice_105:r_7c796ba53bd7ea03": {
      "text": "Their breakthrough will doom Earth!",
      "status": "imported"
    },
    "voice_105:r_fa944da4b6519006": {
      "text": "I sense a will inside it...!?",
      "status": "imported"
    },
    "voice_105:r_95d047bcc17fccc6": {
      "text": "Can't communicate,\\nso I fight...!",
      "status": "imported"
    },
    "voice_105:r_640327a12a559b31": {
      "text": "You're evil gods, just like Zul!",
      "status": "imported"
    },
    "voice_105:r_bdd38c584fa313d0": {
      "text": "Call yourselves gods - evil is evil!",
      "status": "imported"
    },
    "voice_105:r_3fd86c1027f317c8": {
      "text": "Their heart is full of sorrow...!",
      "status": "imported"
    },
    "voice_105:r_d0372a183d2007ad": {
      "text": "No matter how huge, I won't flinch!",
      "status": "imported"
    },
    "voice_105:r_217aa5e1d545b44d": {
      "text": "Godmars will shatter that giant!",
      "status": "imported"
    },
    "voice_105:r_381992c5d8224937": {
      "text": "I'll sever the source of this war!",
      "status": "imported"
    },
    "voice_105:r_f1e7ed9e5874aba5": {
      "text": "A mighty foe...! But I won't lose!",
      "status": "imported"
    },
    "voice_105:r_fc25e66a86fc2c85": {
      "text": "It's time to end all conflict...!",
      "status": "imported"
    },
    "voice_105:r_5aeeb4917340c42d": {
      "text": "Godmars, spacefaring king, goes!",
      "status": "imported"
    },
    "voice_105:r_b765659981b6516d": {
      "text": "Scheming malice...! This ends here!",
      "status": "imported"
    },
    "voice_105:r_0c427458bc00eb95": {
      "text": "Your vile plot...! I'll crush it!",
      "status": "imported"
    },
    "voice_105:r_774a9ab4d8fd5351": {
      "text": "If Tetsujin and I join forces!",
      "status": "imported"
    },
    "voice_105:r_d3f01de714c015bd": {
      "text": "I'll help you, Ox!",
      "status": "imported"
    },
    "voice_105:r_7d2617c809fead70": {
      "text": "That's the spirit, Gura!",
      "status": "imported"
    },
    "voice_105:r_ceb935ccbf830724": {
      "text": "Pull Tetsujin back, Shotaro!",
      "status": "imported"
    },
    "voice_105:r_862ef7385bf2abd4": {
      "text": "Don't overdo it, Ox!",
      "status": "imported"
    },
    "voice_105:r_001cbec4d9a4283f": {
      "text": "Gura! Don't let your guard down!",
      "status": "imported"
    },
    "voice_105:r_8ad40afecd02b41e": {
      "text": "If I read their hostility...!",
      "status": "imported"
    },
    "voice_105:r_26e5efec03c03d78": {
      "text": "I'll dodge with minimal movement!",
      "status": "imported"
    },
    "voice_105:r_4ad81e88c7557a8b": {
      "text": "No unnecessary movement!",
      "status": "imported"
    },
    "voice_105:r_1f65a7af190e4674": {
      "text": "Your psychic power can't beat me!",
      "status": "imported"
    },
    "voice_105:r_40c5a9358ed5bf29": {
      "text": "Your Black Hole\\nwon't swallow me!",
      "status": "imported"
    },
    "voice_105:r_f2e18dfdfe0c89ea": {
      "text": "Space Demon King minion! You lose!",
      "status": "imported"
    },
    "voice_105:r_cf7dbf49e96a5755": {
      "text": "Gura, stop!\\nI hate fighting you!",
      "status": "imported"
    },
    "voice_105:r_2072eaf71a260ae7": {
      "text": "Give up already! This is pointless!",
      "status": "imported"
    },
    "voice_105:r_6c13bbfd27a7799e": {
      "text": "This will stop me...\\nstop Godmars?!",
      "status": "imported"
    },
    "voice_105:r_06f88dcbd3c9e738": {
      "text": "A weak attack\\ncan't shake Godmars!",
      "status": "imported"
    },
    "voice_105:r_b28faf9f71bc3598": {
      "text": "Hold on, Godmars!",
      "status": "imported"
    },
    "voice_105:r_8a29278549f8e07a": {
      "text": "My fighting spirit still burns!",
      "status": "imported"
    },
    "voice_105:r_7e6c573c26177f98": {
      "text": "Now the real fight begins! Let's go!",
      "status": "imported"
    },
    "voice_105:r_45abf84f7757d6eb": {
      "text": "Ngh...! Their psychic power beat me!",
      "status": "imported"
    },
    "voice_105:r_edd7a13ab8f06a14": {
      "text": "The Space Demon King's Black Hole?!",
      "status": "imported"
    },
    "voice_105:r_8165e5b41f0124c4": {
      "text": "Space Demon King minion!\\nYou'll pay!",
      "status": "imported"
    },
    "voice_105:r_4e05581b7432cce8": {
      "text": "Gura...!\\nFeel what Shotaro feels!",
      "status": "imported"
    },
    "voice_105:r_0a3fccb71ec6cf2a": {
      "text": "Marg...! Lend me your strength...!",
      "status": "imported"
    },
    "voice_105:r_9b63cf1f3e0207ef": {
      "text": "Is my psychic power weakening...!?",
      "status": "imported"
    },
    "voice_105:r_8356f4e3dcdff938": {
      "text": "Won't lose...!\\nTill space has peace!",
      "status": "imported"
    },
    "voice_105:r_1d6d784036ae0bd7": {
      "text": "Aaaaaaaagh!!",
      "status": "imported"
    },
    "voice_105:r_625664af02183c17": {
      "text": "I'm sorry, everyone...!",
      "status": "imported"
    },
    "voice_105:r_3701cba361f80ea5": {
      "text": "Godmars can't fall here...!",
      "status": "imported"
    },
    "voice_105:r_63f429c5c68c0863": {
      "text": "Good work! Did you overdo the game?",
      "status": "imported"
    },
    "voice_105:r_38e4a434c91d8ef0": {
      "text": "Overuse: aches/pulse/nausea/vertigo.",
      "status": "imported"
    },
    "voice_105:r_98ed411352a3a6ac": {
      "text": "Evil targets Earth; I can't whine.",
      "status": "imported"
    },
    "voice_105:r_4824bea6bab3af67": {
      "text": "So rest, then fight with me again.",
      "status": "imported"
    },
    "voice_105:r_862b92e63adb9734": {
      "text": "Until we meet again!",
      "status": "imported"
    },
    "voice_105:r_6f95653e548f8fcf": {
      "text": "I'll stop the enemy's movements!",
      "status": "imported"
    },
    "voice_105:r_d249d68bada91ab9": {
      "text": "Godmars will lead the way!",
      "status": "imported"
    },
    "voice_105:r_e9b3307e9eb69f11": {
      "text": "Let's fight in tandem!",
      "status": "imported"
    },
    "voice_105:r_03cdac73042343ee": {
      "text": "If we focus both our attacks...!",
      "status": "imported"
    },
    "voice_105:r_6026da5acbda7c69": {
      "text": "Leave that one to me!",
      "status": "imported"
    },
    "voice_105:r_981f8fedd5414fe5": {
      "text": "Godmars will handle this side!",
      "status": "imported"
    },
    "voice_105:r_96bb0dcde0c8c44a": {
      "text": "I'm your opponent!",
      "status": "imported"
    },
    "voice_105:r_641550a2f54cb456": {
      "text": "Come on! Let's fight one-on-one!",
      "status": "imported"
    }
  }
}
