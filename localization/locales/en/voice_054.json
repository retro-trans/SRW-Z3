{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_054:r_479b340ccc6c572b": {
      "text": "The enemy's... a Gundam...!?",
      "status": "imported"
    },
    "voice_054:r_ca4acbac57a2a35e": {
      "text": "I'll return the favor!",
      "status": "imported"
    },
    "voice_054:r_77949221bf58f862": {
      "text": "I can still go...!",
      "status": "imported"
    },
    "voice_054:r_70b9c4b9f1f37eff": {
      "text": "Heero, I'll cover you!",
      "status": "imported"
    },
    "voice_054:r_9fcb3754cb1773c7": {
      "text": "Duo, leave the rest to me!",
      "status": "imported"
    },
    "voice_054:r_3559d2fad32c2435": {
      "text": "Trowa, leave this to me!",
      "status": "imported"
    },
    "voice_054:r_f7570547e9f80a64": {
      "text": "Wufei, I'll follow you!",
      "status": "imported"
    },
    "voice_054:r_cbab0f4720e1fcf1": {
      "text": "Please leave this to me!",
      "status": "imported"
    },
    "voice_054:r_0bbe0b4f5364e732": {
      "text": "I'll protect you!",
      "status": "imported"
    },
    "voice_054:r_5dda5198137cb02a": {
      "text": "We made it just in time!",
      "status": "imported"
    },
    "voice_054:r_83ec59afbecdec14": {
      "text": "Are you all right, Heero?",
      "status": "imported"
    },
    "voice_054:r_e20bfd42ad95a3c9": {
      "text": "Duo, don't overdo it!",
      "status": "imported"
    },
    "voice_054:r_0f58a8822381e57f": {
      "text": "Trowa, I'll protect you!",
      "status": "imported"
    },
    "voice_054:r_6dbcc507fb61b51d": {
      "text": "Stay back, Wufei!",
      "status": "imported"
    },
    "voice_054:r_b42ab697149a7c8a": {
      "text": "That's nothing!",
      "status": "imported"
    },
    "voice_054:r_4de4fcf3b440baf4": {
      "text": "Thank you, Sandrock.",
      "status": "imported"
    },
    "voice_054:r_0121a166c715cdff": {
      "text": "Dodged...!\\nBut I must stay alert.",
      "status": "imported"
    },
    "voice_054:r_30fad37a42bd3ad3": {
      "text": "Sorry, but you won't hit me!",
      "status": "imported"
    },
    "voice_054:r_80a0b2a84e05d81a": {
      "text": "I won't let you pass!",
      "status": "imported"
    },
    "voice_054:r_4a9ac1dff86506d9": {
      "text": "I'll take care of that enemy!",
      "status": "imported"
    },
    "voice_054:r_bc8538e6af3d2577": {
      "text": "We shouldn't\\nbe fighting now...!",
      "status": "imported"
    },
    "voice_054:r_924516c8de2b5342": {
      "text": "You can't stop me!",
      "status": "imported"
    },
    "voice_054:r_da1174533722333f": {
      "text": "I must've grown complacent...",
      "status": "imported"
    },
    "voice_054:r_fdeb8162976e72c1": {
      "text": "I can't let everyone down!",
      "status": "imported"
    },
    "voice_054:r_0fadb5c26df92b42": {
      "text": "They'll pick me off like this...!?",
      "status": "imported"
    },
    "voice_054:r_6b15af9a0057cdc8": {
      "text": "Guh! Sorry, Sandrock...!",
      "status": "imported"
    },
    "voice_054:r_15b4a90140e8a33a": {
      "text": "No! A direct hit!?",
      "status": "imported"
    },
    "voice_054:r_af884a6b11dff121": {
      "text": "I expected\\nat least this much!",
      "status": "imported"
    },
    "voice_054:r_ac6fe7838e95647b": {
      "text": "Ugh!\\nI have no intention of running!",
      "status": "imported"
    },
    "voice_054:r_77ca87eacd17ad52": {
      "text": "A-am I... truly powerless...?",
      "status": "imported"
    },
    "voice_054:r_bf3244994760e535": {
      "text": "Shot down...? I-I have to eject...",
      "status": "imported"
    },
    "voice_054:r_aabfb21c9d069ce7": {
      "text": "I-is this the end of my fight!?",
      "status": "imported"
    },
    "voice_054:r_02479dc8fe989560": {
      "text": "Guh! I...\\nI can't afford to lose!",
      "status": "imported"
    },
    "voice_054:r_a2df00f91a9b0a9e": {
      "text": "Amazing! But I can do that too...!",
      "status": "imported"
    },
    "voice_054:r_48b60d6c48b9b142": {
      "text": "You're good... but it's not over!!",
      "status": "imported"
    },
    "voice_054:r_8927e6fb681aa809": {
      "text": "Damage report?\\nI can take this!",
      "status": "imported"
    },
    "voice_054:r_665f01666859013b": {
      "text": "What!? That should've hit...",
      "status": "imported"
    },
    "voice_054:r_a571eec59b258d11": {
      "text": "Is that all your attack can do?",
      "status": "imported"
    },
    "voice_054:r_ddbe581c5ea9183d": {
      "text": "I see it!!",
      "status": "imported"
    },
    "voice_054:r_faae935cca0edc72": {
      "text": "You... protected me.",
      "status": "imported"
    },
    "voice_054:r_d4430bf362340b32": {
      "text": "That attack won't work on me.",
      "status": "imported"
    },
    "voice_054:r_6ff1323b355593e0": {
      "text": "Is my suit no match for you...?",
      "status": "imported"
    },
    "voice_054:r_b7b5625d7cd4282f": {
      "text": "Rise, Sandrock!\\nWe can't fall yet!!",
      "status": "imported"
    },
    "voice_054:r_36133ad73a73ef98": {
      "text": "No! I can't do anything...",
      "status": "imported"
    },
    "voice_054:r_920740a0219c5085": {
      "text": "Defeat you...\\nand end this battle!",
      "status": "imported"
    },
    "voice_054:r_a8451712c57c1a72": {
      "text": "I'll stop you, no matter what!",
      "status": "imported"
    },
    "voice_054:r_3633df5b7b8f47fa": {
      "text": "It worked...!",
      "status": "imported"
    },
    "voice_054:r_52dfc56b14b93551": {
      "text": "Why am I crying?\\nI'm not even sad.",
      "status": "imported"
    },
    "voice_054:r_1b9b2aab5cb104da": {
      "text": "Key's ours.\\nMust\\nget every Gundam.",
      "status": "imported"
    },
    "voice_054:r_342044c706a2340f": {
      "text": "Are you prepared...?",
      "status": "imported"
    },
    "voice_054:r_cf41e8828a90cbdb": {
      "text": "This'll do it!",
      "status": "imported"
    },
    "voice_054:r_719e897304ec42d4": {
      "text": "I'm sorry... But...",
      "status": "imported"
    },
    "voice_054:r_ec2ea17765052401": {
      "text": "Gooooooo!!",
      "status": "imported"
    },
    "voice_054:r_f2d4255f1c2f7542": {
      "text": "So we managed to disable it...",
      "status": "imported"
    },
    "voice_054:r_a7246b52782a877e": {
      "text": "This will end it!",
      "status": "imported"
    },
    "voice_054:r_dc8701f6bcb9904f": {
      "text": "They held back...?",
      "status": "imported"
    },
    "voice_054:r_d6bdd730f24f66eb": {
      "text": "We made it through safely somehow.",
      "status": "imported"
    },
    "voice_054:r_41997412868c48c4": {
      "text": "How careless!",
      "status": "imported"
    },
    "voice_054:r_9e6cf4f389dae55c": {
      "text": "Why, you!!",
      "status": "imported"
    },
    "voice_054:r_9e0c80ac7e33b459": {
      "text": "Don't get in my way!",
      "status": "imported"
    },
    "voice_054:r_7432ef43ed3471dc": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_054:r_065443f6ddfcf0d7": {
      "text": "Here I go!",
      "status": "imported"
    },
    "voice_054:r_47d52a2839c71715": {
      "text": "Interfere, and I won't hold back!",
      "status": "imported"
    },
    "voice_054:r_847f82e7f3eef651": {
      "text": "I'm coming for you!",
      "status": "imported"
    },
    "voice_054:r_eb7ae28b53dc033c": {
      "text": "I'm going in!!",
      "status": "imported"
    },
    "voice_054:r_857c4a52ce8df0fd": {
      "text": "I'm sorry, but I can't hold back!",
      "status": "imported"
    },
    "voice_054:r_55417493fce1d347": {
      "text": "If you stand in my way!",
      "status": "imported"
    },
    "voice_054:r_8fdf5910927c9591": {
      "text": "If you're going to run, do it now!",
      "status": "imported"
    },
    "voice_054:r_7d724dbcc4451e10": {
      "text": "You go no farther...!",
      "status": "imported"
    },
    "voice_054:r_93e25418a203cb8f": {
      "text": "Some risk can't be avoided...!",
      "status": "imported"
    },
    "voice_054:r_adeb0a29274d3d9b": {
      "text": "I'm fighting of my own free will!",
      "status": "imported"
    },
    "voice_054:r_24cf161287ef9d5c": {
      "text": "Now... fighting is my only choice!",
      "status": "imported"
    },
    "voice_054:r_b1de76a75a253c13": {
      "text": "I'm counting on you, my Sandrock...!",
      "status": "imported"
    },
    "voice_054:r_38fdff9483e9245c": {
      "text": "Let's go, Sandrock!",
      "status": "imported"
    },
    "voice_054:r_620fedec67706d7d": {
      "text": "Wufei...\\nMust we really fight!?",
      "status": "imported"
    },
    "voice_054:r_9680dcd0fddcfcc7": {
      "text": "So be it.\\nI'm coming, Wufei!",
      "status": "imported"
    },
    "voice_054:r_2a00f1044ad5cbaa": {
      "text": "I won't let you go any farther!",
      "status": "imported"
    },
    "voice_054:r_3dbeead1bd3164ef": {
      "text": "I'll break through here!",
      "status": "imported"
    },
    "voice_054:r_13c25fbdfddc8a24": {
      "text": "I can't retreat now!",
      "status": "imported"
    },
    "voice_054:r_42ba1ecb310b4bd7": {
      "text": "Guh!\\nWe still fight, Sandrock...!",
      "status": "imported"
    },
    "voice_054:r_d692f1d420460a47": {
      "text": "I won't let them overwhelm me!",
      "status": "imported"
    },
    "voice_054:r_a5643cec86b18bd2": {
      "text": "I-is this the end...!?",
      "status": "imported"
    },
    "voice_054:r_68f2dfab20a4a30e": {
      "text": "I'm sorry, I have to withdraw!",
      "status": "imported"
    },
    "voice_054:r_9cedad8237480563": {
      "text": "Can't you move anymore, Sandrock...?",
      "status": "imported"
    },
    "voice_054:r_a03fabecba1508ca": {
      "text": "Duo! Are you all right!?",
      "status": "imported"
    },
    "voice_054:r_5391b24a71eb10ae": {
      "text": "Trowa! Fall back right now!",
      "status": "imported"
    },
    "voice_054:r_a554ceef5c87b972": {
      "text": "Wufei! Please don't be reckless!",
      "status": "imported"
    },
    "voice_054:r_1568ff6298b12b96": {
      "text": "If this is our only recourse...!",
      "status": "imported"
    },
    "voice_054:r_2c9d94ba13c5fc50": {
      "text": "So the hope called peace won't die!",
      "status": "imported"
    },
    "voice_054:r_a77f4913375098d2": {
      "text": "This fight\\nis my atonement to space!",
      "status": "imported"
    },
    "voice_054:r_428c2116ac3071b1": {
      "text": "What must be done here and now...!",
      "status": "imported"
    },
    "voice_054:r_69dfa1659715e2fa": {
      "text": "Not a chance!",
      "status": "imported"
    },
    "voice_054:r_d996fd6d4ef5b329": {
      "text": "I'll break through!",
      "status": "imported"
    },
    "voice_054:r_8ab47a28f99ef565": {
      "text": "You won't get through here!",
      "status": "imported"
    },
    "voice_054:r_546de3fb6db156ea": {
      "text": "I'll be your shield!",
      "status": "imported"
    },
    "voice_054:r_ca85f87cee5e31f7": {
      "text": "We'll become the shield of peace!",
      "status": "imported"
    },
    "voice_054:r_9072ea7bc71df136": {
      "text": "I'll do everything I can!",
      "status": "imported"
    },
    "voice_054:r_04e815a8d425827d": {
      "text": "To bring this battle to an end...!",
      "status": "imported"
    },
    "voice_054:r_d89011fe3e5d082a": {
      "text": "Those who bring everyone sorrow...!",
      "status": "imported"
    },
    "voice_054:r_3c5b0c2ac812d5de": {
      "text": "There's a battle only I can fight!",
      "status": "imported"
    },
    "voice_054:r_5b9e8897190892eb": {
      "text": "I'll close the distance!",
      "status": "imported"
    },
    "voice_054:r_7bea3023abbf8a94": {
      "text": "You left yourself open!",
      "status": "imported"
    },
    "voice_054:r_dd01a4c0d1b36a8d": {
      "text": "I'll catch them by surprise!",
      "status": "imported"
    },
    "voice_054:r_20920ad2eb3542db": {
      "text": "I'll make certain of it!",
      "status": "imported"
    },
    "voice_054:r_0ab7914877fd48ed": {
      "text": "Hit!",
      "status": "imported"
    },
    "voice_054:r_cb846feec748c2e3": {
      "text": "You can't dodge this!",
      "status": "imported"
    },
    "voice_054:r_c958860b0676b1f5": {
      "text": "Read where they're moving...!",
      "status": "imported"
    },
    "voice_054:r_5e2669b82ef75ce3": {
      "text": "You're in range!",
      "status": "imported"
    },
    "voice_054:r_7847e0ed7dc9282d": {
      "text": "Yah!",
      "status": "imported"
    },
    "voice_054:r_e42b52c7a987b906": {
      "text": "I'll rush them!",
      "status": "imported"
    },
    "voice_054:r_6825fd1ff907bd22": {
      "text": "Dah!",
      "status": "imported"
    },
    "voice_054:r_607f666f1563bc0d": {
      "text": "This will finish it!",
      "status": "imported"
    },
    "voice_054:r_97b7431eeb81e6b6": {
      "text": "With this!",
      "status": "imported"
    },
    "voice_054:r_9b9726b1872759d6": {
      "text": "Rrrah!",
      "status": "imported"
    },
    "voice_054:r_ad3d538f1e909184": {
      "text": "Hah!",
      "status": "imported"
    },
    "voice_054:r_8c61c59a1c0aebbf": {
      "text": "Not yet!",
      "status": "imported"
    },
    "voice_054:r_aba6a7662129d8ce": {
      "text": "Yaaaaa!",
      "status": "imported"
    },
    "voice_054:r_95d047bcc17fccc6": {
      "text": "This ends iiiit!",
      "status": "imported"
    },
    "voice_054:r_640327a12a559b31": {
      "text": "Yaa!",
      "status": "imported"
    },
    "voice_054:r_774a9ab4d8fd5351": {
      "text": "Because this is my battle.",
      "status": "imported"
    },
    "voice_054:r_d3f01de714c015bd": {
      "text": "I won't let this chance slip away!",
      "status": "imported"
    },
    "voice_054:r_7d2617c809fead70": {
      "text": "They're quite formidable...! But!",
      "status": "imported"
    },
    "voice_054:r_ceb935ccbf830724": {
      "text": "How long will you repeat this...!",
      "status": "imported"
    },
    "voice_054:r_862ef7385bf2abd4": {
      "text": "Being used,\\nyet still unaware...!",
      "status": "imported"
    },
    "voice_054:r_001cbec4d9a4283f": {
      "text": "This won't\\nhelp the colonies...!",
      "status": "imported"
    },
    "voice_054:r_8ad40afecd02b41e": {
      "text": "Sorrow is filling space...!",
      "status": "imported"
    },
    "voice_054:r_26e5efec03c03d78": {
      "text": "Kind souls abound\\nYou'd raze Earth!?",
      "status": "imported"
    },
    "voice_054:r_4ad81e88c7557a8b": {
      "text": "So you've made your decision...!",
      "status": "imported"
    },
    "voice_054:r_1f65a7af190e4674": {
      "text": "Their sorrow keeps spreading...!",
      "status": "imported"
    },
    "voice_054:r_40c5a9358ed5bf29": {
      "text": "The machine is controlling them...!",
      "status": "imported"
    },
    "voice_054:r_f2e18dfdfe0c89ea": {
      "text": "Their presence... feels wrong...!",
      "status": "imported"
    },
    "voice_054:r_cf7dbf49e96a5755": {
      "text": "Now,\\nall you think of is yourself!?",
      "status": "imported"
    },
    "voice_054:r_fa96676cc65bb509": {
      "text": "If destruction is all you desire...!",
      "status": "imported"
    },
    "voice_054:r_4e37f92e7d2fc62e": {
      "text": "As long as I can move, I'll resist!",
      "status": "imported"
    },
    "voice_054:r_2072eaf71a260ae7": {
      "text": "I chose to trust human potential!",
      "status": "imported"
    },
    "voice_054:r_6c13bbfd27a7799e": {
      "text": "I won't let extinction happen!",
      "status": "imported"
    },
    "voice_054:r_06f88dcbd3c9e738": {
      "text": "Now it's my turn to save someone!",
      "status": "imported"
    },
    "voice_054:r_b28faf9f71bc3598": {
      "text": "Their leader's defeat will favor us!",
      "status": "imported"
    },
    "voice_054:r_8a29278549f8e07a": {
      "text": "This foe looks troublesome...!",
      "status": "imported"
    },
    "voice_054:r_7e6c573c26177f98": {
      "text": "Sink their ship,\\nand the tide turns!",
      "status": "imported"
    },
    "voice_054:r_45abf84f7757d6eb": {
      "text": "I fight those who would take lives!",
      "status": "imported"
    },
    "voice_054:r_edd7a13ab8f06a14": {
      "text": "You're kinder than even I am...!",
      "status": "imported"
    },
    "voice_054:r_8165e5b41f0124c4": {
      "text": "Earth, colonies\\nYou won't rule them!",
      "status": "imported"
    },
    "voice_054:r_4e05581b7432cce8": {
      "text": "Peace tops war.\\nI trust its seekers!",
      "status": "imported"
    },
    "voice_054:r_a60b107ea3c36a86": {
      "text": "Your very existence creates war!",
      "status": "imported"
    },
    "voice_054:r_e33693e5ba4665b0": {
      "text": "I won't forgive warmongers...!",
      "status": "imported"
    },
    "voice_054:r_0a3fccb71ec6cf2a": {
      "text": "Final battle...!\\nLet's go, Sandrock!",
      "status": "imported"
    },
    "voice_054:r_689d0b123de71ae0": {
      "text": "It's my turn!",
      "status": "imported"
    },
    "voice_054:r_84883aa95f63ce32": {
      "text": "Sorry, I won't suffer in silence!",
      "status": "imported"
    },
    "voice_054:r_25493e978ce8ff16": {
      "text": "I can't let them withdraw!",
      "status": "imported"
    },
    "voice_054:r_7316666150e42960": {
      "text": "I have to hold them here!",
      "status": "imported"
    },
    "voice_054:r_c4f11aa93dc5b668": {
      "text": "That told me where you are...!",
      "status": "imported"
    },
    "voice_054:r_ce1a22dfe3a4d339": {
      "text": "They're about to attack...!",
      "status": "imported"
    },
    "voice_054:r_240651adab81e145": {
      "text": "This is our chance to coordinate!",
      "status": "imported"
    },
    "voice_054:r_cff0deaae73c2858": {
      "text": "I'll follow up!",
      "status": "imported"
    },
    "voice_054:r_dca67f68a573fab7": {
      "text": "Just as impressive as ever!",
      "status": "imported"
    },
    "voice_054:r_6f94566ad37f8ff8": {
      "text": "I won't let you!",
      "status": "imported"
    },
    "voice_054:r_942ca03c9de80143": {
      "text": "Nothing matters more than life...!",
      "status": "imported"
    },
    "voice_054:r_d8c669c70659e18a": {
      "text": "No...! I can't counterattack...!",
      "status": "imported"
    },
    "voice_054:r_8f5bade7ac2db78e": {
      "text": "I can't keep fighting like this...!",
      "status": "imported"
    },
    "voice_054:r_05ea490d2f522520": {
      "text": "Did they read our range...!?",
      "status": "imported"
    },
    "voice_054:r_f5658c702d91db7a": {
      "text": "Sorry, but it's no use!",
      "status": "imported"
    },
    "voice_054:r_686df329b50f195b": {
      "text": "It won't work on me!",
      "status": "imported"
    },
    "voice_054:r_25f0ab0fa3cf690c": {
      "text": "Lost battles are familiar...!\\nBut!",
      "status": "imported"
    },
    "voice_054:r_b708a1d959013dbf": {
      "text": "Guh...!\\nBut I haven't lost yet!",
      "status": "imported"
    },
    "voice_054:r_59fca03e929366c1": {
      "text": "I can still act.\\nI'll give my all!",
      "status": "imported"
    },
    "voice_054:r_0d65eb631dcb7514": {
      "text": "Heart hurts more.\\nThis is nothing!",
      "status": "imported"
    },
    "voice_054:r_d03018a31e23f1e9": {
      "text": "No! My mobile suit can't take more!",
      "status": "imported"
    },
    "voice_054:r_279da5f732aa8847": {
      "text": "Is this the end...!? I'm ejecting!",
      "status": "imported"
    },
    "voice_054:r_97f82e3cb6f70110": {
      "text": "I'm sorry, Sandrock...!",
      "status": "imported"
    },
    "voice_054:r_c5611d8dd6def96b": {
      "text": "Pausing the game? A wise choice.",
      "status": "imported"
    },
    "voice_054:r_6f12cc8ed2732eb5": {
      "text": "Don't lose heart from battle.",
      "status": "imported"
    },
    "voice_054:r_7abfc55f8fb62ba7": {
      "text": "I'd never allow such a thing...",
      "status": "imported"
    },
    "voice_054:r_99e7a66c650b5892": {
      "text": "Rest. Be yourself again. See you!",
      "status": "imported"
    },
    "voice_054:r_0556e8a22779ea8e": {
      "text": "Then I'll go first!",
      "status": "imported"
    },
    "voice_054:r_09d377101a48d92a": {
      "text": "I'll draw the enemy's attention...!",
      "status": "imported"
    },
    "voice_054:r_11517cc7b0494dbf": {
      "text": "The finishing blow is yours!",
      "status": "imported"
    },
    "voice_054:r_b5864501463db244": {
      "text": "I know what my role is!",
      "status": "imported"
    },
    "voice_054:r_a88939ea84b4474d": {
      "text": "That's my enemy...!",
      "status": "imported"
    },
    "voice_054:r_a870d0cf7cc11ec6": {
      "text": "So this is one-on-one!",
      "status": "imported"
    },
    "voice_054:r_03f6158ef83964f3": {
      "text": "I must meet your expectations...!",
      "status": "imported"
    },
    "voice_054:r_2970a83693cdcc25": {
      "text": "May we both fight well!",
      "status": "imported"
    }
  }
}
