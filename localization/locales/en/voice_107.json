{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_107:r_479b340ccc6c572b": {
      "text": "Let's clean this up, Darry!",
      "status": "imported"
    },
    "voice_107:r_ca4acbac57a2a35e": {
      "text": "Right! But don't get reckless!",
      "status": "imported"
    },
    "voice_107:r_77949221bf58f862": {
      "text": "I know! Take this!",
      "status": "imported"
    },
    "voice_107:r_70b9c4b9f1f37eff": {
      "text": "You don't get it at all, Gimmy!",
      "status": "imported"
    },
    "voice_107:r_9fcb3754cb1773c7": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_107:r_3559d2fad32c2435": {
      "text": "It's over!",
      "status": "imported"
    },
    "voice_107:r_f7570547e9f80a64": {
      "text": "Heh heh! That was easy!",
      "status": "imported"
    },
    "voice_107:r_cbab0f4720e1fcf1": {
      "text": "Honestly, he gets carried away...",
      "status": "imported"
    },
    "voice_107:r_0bbe0b4f5364e732": {
      "text": "Gimmy! Let's use our combo!",
      "status": "imported"
    },
    "voice_107:r_5dda5198137cb02a": {
      "text": "I've been waiting! All right...",
      "status": "imported"
    },
    "voice_107:r_83ec59afbecdec14": {
      "text": "Here I gooooo!!",
      "status": "imported"
    },
    "voice_107:r_e20bfd42ad95a3c9": {
      "text": "Honestly! You always rush ahead!",
      "status": "imported"
    },
    "voice_107:r_0f58a8822381e57f": {
      "text": "Time to finish it!",
      "status": "imported"
    },
    "voice_107:r_6dbcc507fb61b51d": {
      "text": "Let's combine our strength!",
      "status": "imported"
    },
    "voice_107:r_b42ab697149a7c8a": {
      "text": "Gimmy! Lucky we beat it, but...!",
      "status": "imported"
    },
    "voice_107:r_4de4fcf3b440baf4": {
      "text": "Great. Another lecture from Darry...",
      "status": "imported"
    },
    "voice_107:r_0121a166c715cdff": {
      "text": "Darry! Let's do a sibling fusion!",
      "status": "imported"
    },
    "voice_107:r_30fad37a42bd3ad3": {
      "text": "Come on! Don't say stupid things!",
      "status": "imported"
    },
    "voice_107:r_80a0b2a84e05d81a": {
      "text": "I'm joking! Now let's go!",
      "status": "imported"
    },
    "voice_107:r_4a9ac1dff86506d9": {
      "text": "We can't fuse, but we can team up!",
      "status": "imported"
    },
    "voice_107:r_0fadb5c26df92b42": {
      "text": "I'm ready!",
      "status": "imported"
    },
    "voice_107:r_6b15af9a0057cdc8": {
      "text": "I'll attack first!",
      "status": "imported"
    },
    "voice_107:r_15b4a90140e8a33a": {
      "text": "Watch me, Simon!",
      "status": "imported"
    },
    "voice_107:r_af884a6b11dff121": {
      "text": "Darry Adai, moving out!",
      "status": "imported"
    },
    "voice_107:r_ac6fe7838e95647b": {
      "text": "I can't leave it all to Gimmy!",
      "status": "imported"
    },
    "voice_107:r_77ca87eacd17ad52": {
      "text": "We have to finish them for sure!",
      "status": "imported"
    },
    "voice_107:r_bf3244994760e535": {
      "text": "I don't just need protection\\nnow...!",
      "status": "imported"
    },
    "voice_107:r_aabfb21c9d069ce7": {
      "text": "I'll fulfill my defense corps duty!",
      "status": "imported"
    },
    "voice_107:r_02479dc8fe989560": {
      "text": "I'll go again...!",
      "status": "imported"
    },
    "voice_107:r_a2df00f91a9b0a9e": {
      "text": "Mugann...! You won't have your way!",
      "status": "imported"
    },
    "voice_107:r_48b60d6c48b9b142": {
      "text": "I won't lose to a faceless mech...!",
      "status": "imported"
    },
    "voice_107:r_8927e6fb681aa809": {
      "text": "I'll take you on, Anti-Spiral!",
      "status": "imported"
    },
    "voice_107:r_665f01666859013b": {
      "text": "I'll stop that monster right here!",
      "status": "imported"
    },
    "voice_107:r_a571eec59b258d11": {
      "text": "I'll destroy this dangerous monster!",
      "status": "imported"
    },
    "voice_107:r_ddbe581c5ea9183d": {
      "text": "I'll beat their leader and end this!",
      "status": "imported"
    },
    "voice_107:r_faae935cca0edc72": {
      "text": "This is it...! I have to win!",
      "status": "imported"
    },
    "voice_107:r_d4430bf362340b32": {
      "text": "I'm confident in my shooting!",
      "status": "imported"
    },
    "voice_107:r_6ff1323b355593e0": {
      "text": "At this range, I can't miss!",
      "status": "imported"
    },
    "voice_107:r_b7b5625d7cd4282f": {
      "text": "I'll shoot just like Yoko!",
      "status": "imported"
    },
    "voice_107:r_36133ad73a73ef98": {
      "text": "I'm better at shooting, though...!",
      "status": "imported"
    },
    "voice_107:r_920740a0219c5085": {
      "text": "If I do it like Gimmy...!",
      "status": "imported"
    },
    "voice_107:r_a8451712c57c1a72": {
      "text": "I'll brace myself and charge in!",
      "status": "imported"
    },
    "voice_107:r_3633df5b7b8f47fa": {
      "text": "Engaging in close combat!",
      "status": "imported"
    },
    "voice_107:r_f2d4255f1c2f7542": {
      "text": "Full speed, Gunmarl!",
      "status": "imported"
    },
    "voice_107:r_7432ef43ed3471dc": {
      "text": "Counterattacking!",
      "status": "imported"
    },
    "voice_107:r_065443f6ddfcf0d7": {
      "text": "How dare you do that to me!",
      "status": "imported"
    },
    "voice_107:r_47d52a2839c71715": {
      "text": "I'll add payback for that last hit!",
      "status": "imported"
    },
    "voice_107:r_847f82e7f3eef651": {
      "text": "If they hit us, we hit back!",
      "status": "imported"
    },
    "voice_107:r_eb7ae28b53dc033c": {
      "text": "Don't underestimate me!",
      "status": "imported"
    },
    "voice_107:r_857c4a52ce8df0fd": {
      "text": "I'm not a kid who'll suffer quietly!",
      "status": "imported"
    },
    "voice_107:r_55417493fce1d347": {
      "text": "Please let me help too!",
      "status": "imported"
    },
    "voice_107:r_8fdf5910927c9591": {
      "text": "I'm used to providing support!",
      "status": "imported"
    },
    "voice_107:r_7d724dbcc4451e10": {
      "text": "Don't charge out alone, Gimmy!",
      "status": "imported"
    },
    "voice_107:r_93e25418a203cb8f": {
      "text": "Gurren Lagann really is amazing...!",
      "status": "imported"
    },
    "voice_107:r_adeb0a29274d3d9b": {
      "text": "I'll back you up, Simon!",
      "status": "imported"
    },
    "voice_107:r_24cf161287ef9d5c": {
      "text": "You're amazing as ever, Yoko!",
      "status": "imported"
    },
    "voice_107:r_8f60f6fc86db3107": {
      "text": "Kittan's even wilder than Gimmy...!",
      "status": "imported"
    },
    "voice_107:r_b1de76a75a253c13": {
      "text": "We can't rely on Gunmen\\nforever...!",
      "status": "imported"
    },
    "voice_107:r_5213c17e13b23de0": {
      "text": "Please fall back, now!",
      "status": "imported"
    },
    "voice_107:r_38fdff9483e9245c": {
      "text": "I'll draw the enemy away!",
      "status": "imported"
    },
    "voice_107:r_620fedec67706d7d": {
      "text": "I said don't be reckless,\\nGimmy!",
      "status": "imported"
    },
    "voice_107:r_9680dcd0fddcfcc7": {
      "text": "We have to back up\\nGurren Lagann!",
      "status": "imported"
    },
    "voice_107:r_2a00f1044ad5cbaa": {
      "text": "Go on ahead, Simon!",
      "status": "imported"
    },
    "voice_107:r_3dbeead1bd3164ef": {
      "text": "This time, I'll protect Yoko!",
      "status": "imported"
    },
    "voice_107:r_98d15b8cc09bc915": {
      "text": "You're charging too hard, Kittan!",
      "status": "imported"
    },
    "voice_107:r_46e86d000250e137": {
      "text": "We'll protect the Gunmen!",
      "status": "imported"
    },
    "voice_107:r_cdbd128a5b4127cc": {
      "text": "I managed to dodge it...!",
      "status": "imported"
    },
    "voice_107:r_cfccaa1fbeda124c": {
      "text": "I can handle this much too!",
      "status": "imported"
    },
    "voice_107:r_b1f8ec192b9c083a": {
      "text": "I can dodge that with ease!",
      "status": "imported"
    },
    "voice_107:r_a007f9ab9cf048b3": {
      "text": "That one... was a little close.",
      "status": "imported"
    },
    "voice_107:r_ddafde4b065ced49": {
      "text": "Even Gunmarl can dodge that much!",
      "status": "imported"
    },
    "voice_107:r_de1213040856c089": {
      "text": "That won't work on me!",
      "status": "imported"
    },
    "voice_107:r_0c0775e051211840": {
      "text": "Thank goodness it hit the shield...!",
      "status": "imported"
    },
    "voice_107:r_a2afffe1c396f0b3": {
      "text": "I messed up a little...",
      "status": "imported"
    },
    "voice_107:r_13c25fbdfddc8a24": {
      "text": "It doesn't hurt...! It doesn't hurt!",
      "status": "imported"
    },
    "voice_107:r_42ba1ecb310b4bd7": {
      "text": "Eek! It hit me!",
      "status": "imported"
    },
    "voice_107:r_d692f1d420460a47": {
      "text": "I have to dodge a little sooner...!",
      "status": "imported"
    },
    "voice_107:r_a5643cec86b18bd2": {
      "text": "Good... They're no real threat.",
      "status": "imported"
    },
    "voice_107:r_68f2dfab20a4a30e": {
      "text": "Gunmarl's as sturdy as it is big!",
      "status": "imported"
    },
    "voice_107:r_9cedad8237480563": {
      "text": "I can still take a hit like that!",
      "status": "imported"
    },
    "voice_107:r_a03fabecba1508ca": {
      "text": "It's dangerous if I don't focus...!",
      "status": "imported"
    },
    "voice_107:r_5391b24a71eb10ae": {
      "text": "So strong...! But I won't lose...!",
      "status": "imported"
    },
    "voice_107:r_a554ceef5c87b972": {
      "text": "Y-You'd use a trick like that...!",
      "status": "imported"
    },
    "voice_107:r_546c3d5937fbb7ee": {
      "text": "This pain is nothing!",
      "status": "imported"
    },
    "voice_107:r_1568ff6298b12b96": {
      "text": "I can't let them overwhelm me!",
      "status": "imported"
    },
    "voice_107:r_2c9d94ba13c5fc50": {
      "text": "This size makes me easy to hit...!",
      "status": "imported"
    },
    "voice_107:r_a77f4913375098d2": {
      "text": "At this rate, they'll get me!\\nAct!",
      "status": "imported"
    },
    "voice_107:r_428c2116ac3071b1": {
      "text": "Still alive...! I can still fight!",
      "status": "imported"
    },
    "voice_107:r_84c116267b79f540": {
      "text": "One way left!\\nI'll turn this around!",
      "status": "imported"
    },
    "voice_107:r_dad38ee29af2df3a": {
      "text": "This crisis...\\nThey'd breeze past!",
      "status": "imported"
    },
    "voice_107:r_3d32e86f8dc80909": {
      "text": "W-What was that attack!?",
      "status": "imported"
    },
    "voice_107:r_70451ffbabe2f876": {
      "text": "Can't die! Gimmy will\\nget reckless!",
      "status": "imported"
    },
    "voice_107:r_69dfa1659715e2fa": {
      "text": "Urgh...! Hold on, Gunmarl!",
      "status": "imported"
    },
    "voice_107:r_d996fd6d4ef5b329": {
      "text": "Aaaah! I-I can't end here!",
      "status": "imported"
    },
    "voice_107:r_8ab47a28f99ef565": {
      "text": "I'm sorry, Gimmy...!",
      "status": "imported"
    },
    "voice_107:r_546de3fb6db156ea": {
      "text": "I'm getting completely crushed...!",
      "status": "imported"
    },
    "voice_107:r_ca85f87cee5e31f7": {
      "text": "Can't act rashly...!\\nI have to wait!",
      "status": "imported"
    },
    "voice_107:r_9072ea7bc71df136": {
      "text": "The battery can't take any more...!",
      "status": "imported"
    },
    "voice_107:r_04e815a8d425827d": {
      "text": "They took the worst position...!",
      "status": "imported"
    },
    "voice_107:r_d89011fe3e5d082a": {
      "text": "I can't counter with these weapons!?",
      "status": "imported"
    },
    "voice_107:r_3c5b0c2ac812d5de": {
      "text": "I have to help Dayakka's team!",
      "status": "imported"
    },
    "voice_107:r_5b9e8897190892eb": {
      "text": "I've got a shield too!",
      "status": "imported"
    },
    "voice_107:r_7bea3023abbf8a94": {
      "text": "I'll be fine with this barrier!",
      "status": "imported"
    },
    "voice_107:r_dd01a4c0d1b36a8d": {
      "text": "I'll protect our... everyone's home!",
      "status": "imported"
    },
    "voice_107:r_0ab7914877fd48ed": {
      "text": "No time to be creeped out...!",
      "status": "imported"
    },
    "voice_107:r_c958860b0676b1f5": {
      "text": "I'll make the first move!",
      "status": "imported"
    },
    "voice_107:r_5e2669b82ef75ce3": {
      "text": "I'll stop them with my attack!",
      "status": "imported"
    },
    "voice_107:r_7847e0ed7dc9282d": {
      "text": "I'll handle the support!",
      "status": "imported"
    },
    "voice_107:r_e42b52c7a987b906": {
      "text": "I'm a full-fledged pilot too!",
      "status": "imported"
    },
    "voice_107:r_6825fd1ff907bd22": {
      "text": "They chose me, so I'll do my best!",
      "status": "imported"
    },
    "voice_107:r_607f666f1563bc0d": {
      "text": "I'll fight alongside you too!",
      "status": "imported"
    }
  }
}
