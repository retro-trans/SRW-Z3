{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_114:r_479b340ccc6c572b": {
      "text": "I'll take it.",
      "status": "imported"
    },
    "voice_114:r_ca4acbac57a2a35e": {
      "text": "In my way? I won't hold back.",
      "status": "imported"
    },
    "voice_114:r_77949221bf58f862": {
      "text": "Careless moves will get you killed.",
      "status": "imported"
    },
    "voice_114:r_70b9c4b9f1f37eff": {
      "text": "You're slow.",
      "status": "imported"
    },
    "voice_114:r_9fcb3754cb1773c7": {
      "text": "Shall we begin?",
      "status": "imported"
    },
    "voice_114:r_3559d2fad32c2435": {
      "text": "You noticed me too late.",
      "status": "imported"
    },
    "voice_114:r_f7570547e9f80a64": {
      "text": "Commencing attack.",
      "status": "imported"
    },
    "voice_114:r_cbab0f4720e1fcf1": {
      "text": "Tactically, you chose right.\\nBut...",
      "status": "imported"
    },
    "voice_114:r_0bbe0b4f5364e732": {
      "text": "Ngh!\\nYou do have some power.",
      "status": "imported"
    },
    "voice_114:r_5dda5198137cb02a": {
      "text": "I'll hold on to hope till the end.",
      "status": "imported"
    },
    "voice_114:r_83ec59afbecdec14": {
      "text": "I see... That attack was precise.",
      "status": "imported"
    },
    "voice_114:r_e20bfd42ad95a3c9": {
      "text": "You should've gauged\\nour strength.",
      "status": "imported"
    },
    "voice_114:r_0f58a8822381e57f": {
      "text": "Is that all...?",
      "status": "imported"
    },
    "voice_114:r_6dbcc507fb61b51d": {
      "text": "A useless attack on every level.",
      "status": "imported"
    },
    "voice_114:r_b42ab697149a7c8a": {
      "text": "Too simple... I've read the pattern.",
      "status": "imported"
    },
    "voice_114:r_4de4fcf3b440baf4": {
      "text": "You're too far away from here.",
      "status": "imported"
    },
    "voice_114:r_0121a166c715cdff": {
      "text": "Just the Mobile Suit?\\nI'll manage.",
      "status": "imported"
    },
    "voice_114:r_30fad37a42bd3ad3": {
      "text": "I seem deeply tied to Gundams.",
      "status": "imported"
    },
    "voice_114:r_80a0b2a84e05d81a": {
      "text": "Final target, locked.",
      "status": "imported"
    },
    "voice_114:r_4a9ac1dff86506d9": {
      "text": "My final performance...",
      "status": "imported"
    },
    "voice_114:r_bc8538e6af3d2577": {
      "text": "Switching to support.",
      "status": "imported"
    },
    "voice_114:r_924516c8de2b5342": {
      "text": "I'll cover you.",
      "status": "imported"
    },
    "voice_114:r_da1174533722333f": {
      "text": "Continuing the attack.",
      "status": "imported"
    },
    "voice_114:r_fdeb8162976e72c1": {
      "text": "Heero, I'll cover you.",
      "status": "imported"
    },
    "voice_114:r_0fadb5c26df92b42": {
      "text": "Duo, I'll attack from here too.",
      "status": "imported"
    },
    "voice_114:r_6b15af9a0057cdc8": {
      "text": "Quatre, leave the rest to me.",
      "status": "imported"
    },
    "voice_114:r_15b4a90140e8a33a": {
      "text": "Wufei, I'll cover you.",
      "status": "imported"
    },
    "voice_114:r_af884a6b11dff121": {
      "text": "Leave this to me.",
      "status": "imported"
    },
    "voice_114:r_ac6fe7838e95647b": {
      "text": "Let me at least handle this.",
      "status": "imported"
    },
    "voice_114:r_77ca87eacd17ad52": {
      "text": "Fall back, Heero.",
      "status": "imported"
    },
    "voice_114:r_bf3244994760e535": {
      "text": "That was careless, Duo.",
      "status": "imported"
    },
    "voice_114:r_aabfb21c9d069ce7": {
      "text": "Quatre, don't overdo it.",
      "status": "imported"
    },
    "voice_114:r_02479dc8fe989560": {
      "text": "Fall back, Wufei.",
      "status": "imported"
    },
    "voice_114:r_a2df00f91a9b0a9e": {
      "text": "That was pointless.",
      "status": "imported"
    },
    "voice_114:r_48b60d6c48b9b142": {
      "text": "Just as predicted.",
      "status": "imported"
    },
    "voice_114:r_8927e6fb681aa809": {
      "text": "I see.",
      "status": "imported"
    },
    "voice_114:r_665f01666859013b": {
      "text": "Evasion complete. Moving on.",
      "status": "imported"
    },
    "voice_114:r_a571eec59b258d11": {
      "text": "Your assessment was lacking.",
      "status": "imported"
    },
    "voice_114:r_ddbe581c5ea9183d": {
      "text": "Your tactics are wrong.",
      "status": "imported"
    },
    "voice_114:r_faae935cca0edc72": {
      "text": "Nothing to worry about.",
      "status": "imported"
    },
    "voice_114:r_d4430bf362340b32": {
      "text": "Seems you chose the wrong tactics.",
      "status": "imported"
    },
    "voice_114:r_6ff1323b355593e0": {
      "text": "That was futile against this unit.",
      "status": "imported"
    },
    "voice_114:r_b7b5625d7cd4282f": {
      "text": "Was my assessment too lax?",
      "status": "imported"
    },
    "voice_114:r_36133ad73a73ef98": {
      "text": "The mission is still unaffected.",
      "status": "imported"
    },
    "voice_114:r_920740a0219c5085": {
      "text": "Leg damage... Still operational.",
      "status": "imported"
    },
    "voice_114:r_a8451712c57c1a72": {
      "text": "This will be a difficult battle...",
      "status": "imported"
    },
    "voice_114:r_3633df5b7b8f47fa": {
      "text": "Direct hit. I can't take much more.",
      "status": "imported"
    },
    "voice_114:r_52dfc56b14b93551": {
      "text": "Kill me if you wish.\\nI may resist.",
      "status": "imported"
    },
    "voice_114:r_1b9b2aab5cb104da": {
      "text": "A failure...?",
      "status": "imported"
    },
    "voice_114:r_342044c706a2340f": {
      "text": "Is this as far as I go?",
      "status": "imported"
    },
    "voice_114:r_cf41e8828a90cbdb": {
      "text": "I won't hold back.",
      "status": "imported"
    },
    "voice_114:r_719e897304ec42d4": {
      "text": "Got you.",
      "status": "imported"
    },
    "voice_114:r_d5e0a2317c40d322": {
      "text": "I'll destroy you.",
      "status": "imported"
    },
    "voice_114:r_ec2ea17765052401": {
      "text": "There you are.",
      "status": "imported"
    },
    "voice_114:r_f2d4255f1c2f7542": {
      "text": "Go easy...\\non Quatre,\\nHeero...",
      "status": "imported"
    },
    "voice_114:r_5d08ad19e2da125b": {
      "text": "Hm?\\nWhat's this...?\\nMy... tears...?",
      "status": "imported"
    },
    "voice_114:r_a7246b52782a877e": {
      "text": "Target, locked.",
      "status": "imported"
    },
    "voice_114:r_dc8701f6bcb9904f": {
      "text": "I'll annihilate the enemy.",
      "status": "imported"
    },
    "voice_114:r_d6bdd730f24f66eb": {
      "text": "Enemy unit destruction confirmed.",
      "status": "imported"
    },
    "voice_114:r_9e6cf4f389dae55c": {
      "text": "I'll erase everything.",
      "status": "imported"
    },
    "voice_114:r_9e0c80ac7e33b459": {
      "text": "Target destroyed.",
      "status": "imported"
    },
    "voice_114:r_8fdf5910927c9591": {
      "text": "I'll destroy every last enemy!",
      "status": "imported"
    },
    "voice_114:r_7d724dbcc4451e10": {
      "text": "I won't hold back.",
      "status": "imported"
    },
    "voice_114:r_98d15b8cc09bc915": {
      "text": "I'll fight anything in my way.",
      "status": "imported"
    },
    "voice_114:r_46e86d000250e137": {
      "text": "I'll fight anyone in my way.",
      "status": "imported"
    },
    "voice_114:r_b1f8ec192b9c083a": {
      "text": "Not bad... but your finish was weak.",
      "status": "imported"
    },
    "voice_114:r_a007f9ab9cf048b3": {
      "text": "Ngh!\\nOperational. Continue mission.",
      "status": "imported"
    },
    "voice_114:r_ddafde4b065ced49": {
      "text": "Is that all?",
      "status": "imported"
    },
    "voice_114:r_de1213040856c089": {
      "text": "I'll manage somehow.",
      "status": "imported"
    },
    "voice_114:r_a2afffe1c396f0b3": {
      "text": "Target acquired... I'll destroy it.",
      "status": "imported"
    },
    "voice_114:r_a5643cec86b18bd2": {
      "text": "Move aside, would you?",
      "status": "imported"
    },
    "voice_114:r_70451ffbabe2f876": {
      "text": "I can withstand this much.",
      "status": "imported"
    },
    "voice_114:r_69dfa1659715e2fa": {
      "text": "Damage check... No mission impact.",
      "status": "imported"
    },
    "voice_114:r_d996fd6d4ef5b329": {
      "text": "Trowa here. Leaving combat briefly.",
      "status": "imported"
    },
    "voice_114:r_8ab47a28f99ef565": {
      "text": "So this is it. I'm withdrawing.",
      "status": "imported"
    },
    "voice_114:r_546de3fb6db156ea": {
      "text": "The odds are against us...",
      "status": "imported"
    },
    "voice_114:r_ca85f87cee5e31f7": {
      "text": "No usable weapons...?",
      "status": "imported"
    },
    "voice_114:r_97b7431eeb81e6b6": {
      "text": "Understood. I'll cover you.",
      "status": "imported"
    },
    "voice_114:r_132f605d02975e71": {
      "text": "Roger. Moving to support you.",
      "status": "imported"
    },
    "voice_114:r_9b9726b1872759d6": {
      "text": "Trowa here. Mission understood.",
      "status": "imported"
    }
  }
}
