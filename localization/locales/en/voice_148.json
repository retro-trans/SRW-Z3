{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_148:r_479b340ccc6c572b": {
      "text": "End it!",
      "status": "imported"
    },
    "voice_148:r_77949221bf58f862": {
      "text": "Mine!",
      "status": "imported"
    },
    "voice_148:r_70b9c4b9f1f37eff": {
      "text": "Brace",
      "status": "imported"
    },
    "voice_148:r_9fcb3754cb1773c7": {
      "text": "Take it",
      "status": "imported"
    },
    "voice_148:r_3559d2fad32c2435": {
      "text": "Ends!",
      "status": "imported"
    },
    "voice_148:r_f7570547e9f80a64": {
      "text": "Now!",
      "status": "imported"
    },
    "voice_148:r_cbab0f4720e1fcf1": {
      "text": "Learn",
      "status": "imported"
    },
    "voice_148:r_0bbe0b4f5364e732": {
      "text": "As planned",
      "status": "imported"
    },
    "voice_148:r_5dda5198137cb02a": {
      "text": "You pay!",
      "status": "imported"
    },
    "voice_148:r_83ec59afbecdec14": {
      "text": "Judged!",
      "status": "imported"
    },
    "voice_148:r_e20bfd42ad95a3c9": {
      "text": "No defeat",
      "status": "imported"
    },
    "voice_148:r_0f58a8822381e57f": {
      "text": "Doctrine!",
      "status": "imported"
    },
    "voice_148:r_6dbcc507fb61b51d": {
      "text": "To our god!",
      "status": "imported"
    },
    "voice_148:r_b42ab697149a7c8a": {
      "text": "Not permitted",
      "status": "imported"
    },
    "voice_148:r_4de4fcf3b440baf4": {
      "text": "War is our creed!",
      "status": "imported"
    },
    "voice_148:r_0121a166c715cdff": {
      "text": "Allegium glory!",
      "status": "imported"
    },
    "voice_148:r_30fad37a42bd3ad3": {
      "text": "War=peace",
      "status": "imported"
    },
    "voice_148:r_80a0b2a84e05d81a": {
      "text": "War seeks God",
      "status": "imported"
    },
    "voice_148:r_4a9ac1dff86506d9": {
      "text": "Arms unite!",
      "status": "imported"
    },
    "voice_148:r_bc8538e6af3d2577": {
      "text": "Arms unite",
      "status": "imported"
    },
    "voice_148:r_924516c8de2b5342": {
      "text": "No passage!",
      "status": "imported"
    },
    "voice_148:r_da1174533722333f": {
      "text": "Guard them",
      "status": "imported"
    },
    "voice_148:r_fdeb8162976e72c1": {
      "text": "You profane it!",
      "status": "imported"
    },
    "voice_148:r_0fadb5c26df92b42": {
      "text": "They got inside!",
      "status": "imported"
    },
    "voice_148:r_6b15af9a0057cdc8": {
      "text": "They got in?!",
      "status": "imported"
    },
    "voice_148:r_15b4a90140e8a33a": {
      "text": "Purge them now!",
      "status": "imported"
    },
    "voice_148:r_af884a6b11dff121": {
      "text": "Lock!",
      "status": "imported"
    },
    "voice_148:r_ac6fe7838e95647b": {
      "text": "Taken",
      "status": "imported"
    },
    "voice_148:r_77ca87eacd17ad52": {
      "text": "Point blank!",
      "status": "imported"
    },
    "voice_148:r_bf3244994760e535": {
      "text": "Closing",
      "status": "imported"
    },
    "voice_148:r_aabfb21c9d069ce7": {
      "text": "Close in!",
      "status": "imported"
    },
    "voice_148:r_02479dc8fe989560": {
      "text": "In close!",
      "status": "imported"
    },
    "voice_148:r_a2df00f91a9b0a9e": {
      "text": "Not over!",
      "status": "imported"
    },
    "voice_148:r_48b60d6c48b9b142": {
      "text": "Finish you!",
      "status": "imported"
    },
    "voice_148:r_8927e6fb681aa809": {
      "text": "I'll stop you!",
      "status": "imported"
    },
    "voice_148:r_665f01666859013b": {
      "text": "No Untouchables!",
      "status": "imported"
    },
    "voice_148:r_a571eec59b258d11": {
      "text": "Mutants must go!",
      "status": "imported"
    },
    "voice_148:r_ddbe581c5ea9183d": {
      "text": "Godslayer!",
      "status": "imported"
    },
    "voice_148:r_faae935cca0edc72": {
      "text": "Quent merc?",
      "status": "imported"
    },
    "voice_148:r_d4430bf362340b32": {
      "text": "Outmaneuver!",
      "status": "imported"
    },
    "voice_148:r_6ff1323b355593e0": {
      "text": "Aim at weak spot",
      "status": "imported"
    },
    "voice_148:r_b7b5625d7cd4282f": {
      "text": "My skill wins!",
      "status": "imported"
    },
    "voice_148:r_36133ad73a73ef98": {
      "text": "Heard, Gundam!",
      "status": "imported"
    },
    "voice_148:r_920740a0219c5085": {
      "text": "Gundam for God!",
      "status": "imported"
    },
    "voice_148:r_a8451712c57c1a72": {
      "text": "Mobile target",
      "status": "imported"
    },
    "voice_148:r_3633df5b7b8f47fa": {
      "text": "AS negates size!",
      "status": "imported"
    },
    "voice_148:r_52dfc56b14b93551": {
      "text": "Beat Mithril!",
      "status": "imported"
    },
    "voice_148:r_1b9b2aab5cb104da": {
      "text": "KMF foe!",
      "status": "imported"
    },
    "voice_148:r_342044c706a2340f": {
      "text": "Black Knights?!",
      "status": "imported"
    },
    "voice_148:r_cf41e8828a90cbdb": {
      "text": "Mech?! Giant?!",
      "status": "imported"
    },
    "voice_148:r_719e897304ec42d4": {
      "text": "Close in to win!",
      "status": "imported"
    },
    "voice_148:r_d5e0a2317c40d322": {
      "text": "Sink ship!",
      "status": "imported"
    },
    "voice_148:r_ec2ea17765052401": {
      "text": "Ace pilot!",
      "status": "imported"
    },
    "voice_148:r_f2d4255f1c2f7542": {
      "text": "Strike command!",
      "status": "imported"
    },
    "voice_148:r_640327a12a559b31": {
      "text": "They hit!",
      "status": "imported"
    },
    "voice_148:r_bdd38c584fa313d0": {
      "text": "Our attack!",
      "status": "imported"
    },
    "voice_148:r_3fd86c1027f317c8": {
      "text": "So you defy us!",
      "status": "imported"
    },
    "voice_148:r_d0372a183d2007ad": {
      "text": "Now counter!",
      "status": "imported"
    },
    "voice_148:r_217aa5e1d545b44d": {
      "text": "No exit",
      "status": "imported"
    },
    "voice_148:r_381992c5d8224937": {
      "text": "Martial creed!",
      "status": "imported"
    },
    "voice_148:r_f1e7ed9e5874aba5": {
      "text": "God's wrath!",
      "status": "imported"
    },
    "voice_148:r_fc25e66a86fc2c85": {
      "text": "We strike!",
      "status": "imported"
    },
    "voice_148:r_5aeeb4917340c42d": {
      "text": "We submit?!",
      "status": "imported"
    },
    "voice_148:r_b765659981b6516d": {
      "text": "God wills it!",
      "status": "imported"
    },
    "voice_148:r_0c427458bc00eb95": {
      "text": "My turn!",
      "status": "imported"
    },
    "voice_148:r_774a9ab4d8fd5351": {
      "text": "Covering!",
      "status": "imported"
    },
    "voice_148:r_d3f01de714c015bd": {
      "text": "Our turn!",
      "status": "imported"
    },
    "voice_148:r_7d2617c809fead70": {
      "text": "Follow!",
      "status": "imported"
    },
    "voice_148:r_ceb935ccbf830724": {
      "text": "Teitania, I assist!",
      "status": "imported"
    },
    "voice_148:r_862ef7385bf2abd4": {
      "text": "I cover!",
      "status": "imported"
    },
    "voice_148:r_001cbec4d9a4283f": {
      "text": "Move! Now!",
      "status": "imported"
    },
    "voice_148:r_8ad40afecd02b41e": {
      "text": "Back! Move!",
      "status": "imported"
    },
    "voice_148:r_26e5efec03c03d78": {
      "text": "Guard Order!",
      "status": "imported"
    },
    "voice_148:r_4ad81e88c7557a8b": {
      "text": "Teitania, back!",
      "status": "imported"
    },
    "voice_148:r_1f65a7af190e4674": {
      "text": "Why?! No counter!",
      "status": "imported"
    },
    "voice_148:r_40c5a9358ed5bf29": {
      "text": "They fled! Shame",
      "status": "imported"
    },
    "voice_148:r_f2e18dfdfe0c89ea": {
      "text": "Let them escape?!",
      "status": "imported"
    },
    "voice_148:r_cf7dbf49e96a5755": {
      "text": "Tch! No attack!",
      "status": "imported"
    },
    "voice_148:r_fa96676cc65bb509": {
      "text": "Damn! No move!",
      "status": "imported"
    },
    "voice_148:r_4e37f92e7d2fc62e": {
      "text": "Where?! Where?!",
      "status": "imported"
    },
    "voice_148:r_66ab4cfe1557909d": {
      "text": "God, forgive me!",
      "status": "imported"
    },
    "voice_148:r_0bad405ee6ca63ba": {
      "text": "Guh! They're better",
      "status": "imported"
    },
    "voice_148:r_2072eaf71a260ae7": {
      "text": "Fool!",
      "status": "imported"
    },
    "voice_148:r_6c13bbfd27a7799e": {
      "text": "No big deal!",
      "status": "imported"
    },
    "voice_148:r_06f88dcbd3c9e738": {
      "text": "Slow fool",
      "status": "imported"
    },
    "voice_148:r_b28faf9f71bc3598": {
      "text": "We're quicker!",
      "status": "imported"
    },
    "voice_148:r_8a29278549f8e07a": {
      "text": "Leave now!",
      "status": "imported"
    },
    "voice_148:r_7e6c573c26177f98": {
      "text": "Simple work!",
      "status": "imported"
    },
    "voice_148:r_45abf84f7757d6eb": {
      "text": "Futile! More?",
      "status": "imported"
    },
    "voice_148:r_edd7a13ab8f06a14": {
      "text": "God, we won!",
      "status": "imported"
    },
    "voice_148:r_8165e5b41f0124c4": {
      "text": "So gifted?!",
      "status": "imported"
    },
    "voice_148:r_4e05581b7432cce8": {
      "text": "Untouchable myth!",
      "status": "imported"
    },
    "voice_148:r_a60b107ea3c36a86": {
      "text": "Quent fool!",
      "status": "imported"
    },
    "voice_148:r_e33693e5ba4665b0": {
      "text": "Hollow idol!",
      "status": "imported"
    },
    "voice_148:r_72a21a1a489af001": {
      "text": "Size never wins!",
      "status": "imported"
    },
    "voice_148:r_eb643f8bf737a0ca": {
      "text": "Gundam is weak!",
      "status": "imported"
    },
    "voice_148:r_0a3fccb71ec6cf2a": {
      "text": "No fear of mercs",
      "status": "imported"
    },
    "voice_148:r_98ed411352a3a6ac": {
      "text": "A lapse!",
      "status": "imported"
    },
    "voice_148:r_4824bea6bab3af67": {
      "text": "Light hit",
      "status": "imported"
    },
    "voice_148:r_862b92e63adb9734": {
      "text": "Armor held!",
      "status": "imported"
    },
    "voice_148:r_cb306ef55e49d107": {
      "text": "Feeble!",
      "status": "imported"
    },
    "voice_148:r_57b2bd2de8a1408d": {
      "text": "Iron faith!",
      "status": "imported"
    },
    "voice_148:r_76f080a4881e8ab5": {
      "text": "A lucky hit!",
      "status": "imported"
    },
    "voice_148:r_288133bc5b573dae": {
      "text": "Only good aim",
      "status": "imported"
    },
    "voice_148:r_6f95653e548f8fcf": {
      "text": "Just that?",
      "status": "imported"
    },
    "voice_148:r_d249d68bada91ab9": {
      "text": "God guards",
      "status": "imported"
    },
    "voice_148:r_e9b3307e9eb69f11": {
      "text": "Our faith\\nwon't break!",
      "status": "imported"
    },
    "voice_148:r_03cdac73042343ee": {
      "text": "Pushed?!",
      "status": "imported"
    },
    "voice_148:r_6026da5acbda7c69": {
      "text": "Ugh! Late!",
      "status": "imported"
    },
    "voice_148:r_981f8fedd5414fe5": {
      "text": "This defies God!",
      "status": "imported"
    },
    "voice_148:r_96bb0dcde0c8c44a": {
      "text": "Damn you, fiends",
      "status": "imported"
    },
    "voice_148:r_641550a2f54cb456": {
      "text": "Reset stance!",
      "status": "imported"
    },
    "voice_148:r_a0f2074af8debbfa": {
      "text": "No... No defeat!",
      "status": "imported"
    },
    "voice_148:r_b5f5a97ed82acb0b": {
      "text": "Damn! Why?!",
      "status": "imported"
    },
    "voice_148:r_d9cd2e4ded064396": {
      "text": "No common foe!",
      "status": "imported"
    },
    "voice_148:r_99e6349431aaf23b": {
      "text": "Martial stands!",
      "status": "imported"
    },
    "voice_148:r_ec1081caf845f56a": {
      "text": "Faith tested?!",
      "status": "imported"
    },
    "voice_148:r_2c5b7ee872c1ed7f": {
      "text": "Th-this is\\nChirico Cuvie!",
      "status": "imported"
    },
    "voice_148:r_76d1e51c8b494a60": {
      "text": "No! They are taboo",
      "status": "imported"
    },
    "voice_148:r_eb5f687fcd372ae7": {
      "text": "Quent!\\nNo easy foe!",
      "status": "imported"
    },
    "voice_148:r_2329428a6871d9fa": {
      "text": "No! Such power!",
      "status": "imported"
    },
    "voice_148:r_0e7466971bec4cc4": {
      "text": "Giant god!",
      "status": "imported"
    },
    "voice_148:r_efa71f7a4cc33ff3": {
      "text": "Th-the taboo one!",
      "status": "imported"
    },
    "voice_148:r_fa6930340a545054": {
      "text": "Past the taboo?!",
      "status": "imported"
    },
    "voice_148:r_854aa0a91a3c80d1": {
      "text": "Strong Gundam!",
      "status": "imported"
    },
    "voice_148:r_0bc8ae32a406ceab": {
      "text": "Helpless vs air!",
      "status": "imported"
    },
    "voice_148:r_82c09f011d703b2c": {
      "text": "Strong...\\nTrue mercs?!",
      "status": "imported"
    },
    "voice_148:r_2b4d8818c77b6dca": {
      "text": "Black wraiths!",
      "status": "imported"
    },
    "voice_148:r_e54e2c99ef8297af": {
      "text": "Monster?",
      "status": "imported"
    },
    "voice_148:r_f16a3eb0bcaac082": {
      "text": "Guh! No armor!",
      "status": "imported"
    },
    "voice_148:r_10a408809e512df1": {
      "text": "Why?! Am I losing?!",
      "status": "imported"
    },
    "voice_148:r_bc7b9e308b879dd4": {
      "text": "No! Machine...!",
      "status": "imported"
    },
    "voice_148:r_98902fd3143c393e": {
      "text": "Never lose!",
      "status": "imported"
    },
    "voice_148:r_d907fbd7bc1c4298": {
      "text": "War is my faith!",
      "status": "imported"
    },
    "voice_148:r_96b21e3a028dd074": {
      "text": "I will pass trial!",
      "status": "imported"
    },
    "voice_148:r_ce140b5d8e6b7310": {
      "text": "God's plan too?!",
      "status": "imported"
    },
    "voice_148:r_0e0335789c5396d7": {
      "text": "Duty isn't done!",
      "status": "imported"
    },
    "voice_148:r_a8e85bd950696403": {
      "text": "I'll ram them!",
      "status": "imported"
    },
    "voice_148:r_772c8bc40ab6cb61": {
      "text": "While it moves\\nI fight!",
      "status": "imported"
    },
    "voice_148:r_58dd2826a199ef51": {
      "text": "Martial fights on!",
      "status": "imported"
    },
    "voice_148:r_aadc0b2442adb93b": {
      "text": "N-no! Aaaaaah!",
      "status": "imported"
    },
    "voice_148:r_e7a8cd8ed5bc2d1b": {
      "text": "Eject now!",
      "status": "imported"
    },
    "voice_148:r_041dd920da4a7c17": {
      "text": "I can't win!",
      "status": "imported"
    },
    "voice_148:r_c7f4280cde4605b3": {
      "text": "I-I abandon it!",
      "status": "imported"
    },
    "voice_148:r_ec349c8ea9511a18": {
      "text": "G-God tests me...",
      "status": "imported"
    },
    "voice_148:r_33236ffa3ea95b68": {
      "text": "Martial glory!",
      "status": "imported"
    },
    "voice_148:r_689d0b123de71ae0": {
      "text": "Pope forgive me",
      "status": "imported"
    },
    "voice_148:r_84883aa95f63ce32": {
      "text": "I live to fight!",
      "status": "imported"
    },
    "voice_148:r_25493e978ce8ff16": {
      "text": "Aptly named?!",
      "status": "imported"
    },
    "voice_148:r_7316666150e42960": {
      "text": "The Untouchable!",
      "status": "imported"
    },
    "voice_148:r_c4f11aa93dc5b668": {
      "text": "Think again...",
      "status": "imported"
    },
    "voice_148:r_ce1a22dfe3a4d339": {
      "text": "God reigns",
      "status": "imported"
    },
    "voice_148:r_240651adab81e145": {
      "text": "Can't you see?!",
      "status": "imported"
    },
    "voice_148:r_a6630215fefaf294": {
      "text": "I lead!",
      "status": "imported"
    },
    "voice_148:r_6f94566ad37f8ff8": {
      "text": "I halt!",
      "status": "imported"
    },
    "voice_148:r_942ca03c9de80143": {
      "text": "Feint!",
      "status": "imported"
    },
    "voice_148:r_d8c669c70659e18a": {
      "text": "Focus fire!",
      "status": "imported"
    },
    "voice_148:r_8f5bade7ac2db78e": {
      "text": "Preempt!",
      "status": "imported"
    },
    "voice_148:r_05ea490d2f522520": {
      "text": "Seen!",
      "status": "imported"
    },
    "voice_148:r_f5658c702d91db7a": {
      "text": "Worthy foe!",
      "status": "imported"
    },
    "voice_148:r_686df329b50f195b": {
      "text": "1 on 1!",
      "status": "imported"
    },
    "voice_148:r_25f0ab0fa3cf690c": {
      "text": "I hold line",
      "status": "imported"
    },
    "voice_148:r_b708a1d959013dbf": {
      "text": "I duel",
      "status": "imported"
    }
  }
}
