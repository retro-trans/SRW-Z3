{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_138:r_479b340ccc6c572b": {
      "text": "There!",
      "status": "imported"
    },
    "voice_138:r_ca4acbac57a2a35e": {
      "text": "I'll make this hit!",
      "status": "imported"
    },
    "voice_138:r_77949221bf58f862": {
      "text": "This should do it!",
      "status": "imported"
    },
    "voice_138:r_70b9c4b9f1f37eff": {
      "text": "Go!",
      "status": "imported"
    },
    "voice_138:r_9fcb3754cb1773c7": {
      "text": "I'll finish this in one blow!",
      "status": "imported"
    },
    "voice_138:r_3559d2fad32c2435": {
      "text": "I'll do it!",
      "status": "imported"
    },
    "voice_138:r_f7570547e9f80a64": {
      "text": "For Kamille and everyone else!",
      "status": "imported"
    },
    "voice_138:r_cbab0f4720e1fcf1": {
      "text": "For everyone who saved me!",
      "status": "imported"
    },
    "voice_138:r_0bbe0b4f5364e732": {
      "text": "I'm going in!",
      "status": "imported"
    },
    "voice_138:r_5dda5198137cb02a": {
      "text": "At this range, you're mine!",
      "status": "imported"
    },
    "voice_138:r_83ec59afbecdec14": {
      "text": "You're in my range... Now!",
      "status": "imported"
    },
    "voice_138:r_e20bfd42ad95a3c9": {
      "text": "If you want distance, take this!",
      "status": "imported"
    },
    "voice_138:r_0f58a8822381e57f": {
      "text": "One more time!",
      "status": "imported"
    },
    "voice_138:r_6dbcc507fb61b51d": {
      "text": "If you won't go down!",
      "status": "imported"
    },
    "voice_138:r_b42ab697149a7c8a": {
      "text": "Funnel!!",
      "status": "imported"
    },
    "voice_138:r_0121a166c715cdff": {
      "text": "Funnel! Go!",
      "status": "imported"
    },
    "voice_138:r_4a9ac1dff86506d9": {
      "text": "Fin Funnel!",
      "status": "imported"
    },
    "voice_138:r_924516c8de2b5342": {
      "text": "Go! Fin Funnel!",
      "status": "imported"
    },
    "voice_138:r_da1174533722333f": {
      "text": "I won't let you do as you please!",
      "status": "imported"
    },
    "voice_138:r_fdeb8162976e72c1": {
      "text": "Now it's my turn!",
      "status": "imported"
    },
    "voice_138:r_0fadb5c26df92b42": {
      "text": "I can still fight!",
      "status": "imported"
    },
    "voice_138:r_6b15af9a0057cdc8": {
      "text": "I can cover you now!",
      "status": "imported"
    },
    "voice_138:r_15b4a90140e8a33a": {
      "text": "Same spot! We can take it down!",
      "status": "imported"
    },
    "voice_138:r_af884a6b11dff121": {
      "text": "I won't let you!",
      "status": "imported"
    },
    "voice_138:r_ac6fe7838e95647b": {
      "text": "I'll protect you!",
      "status": "imported"
    },
    "voice_138:r_77ca87eacd17ad52": {
      "text": "Roger! I'll attack separately!",
      "status": "imported"
    },
    "voice_138:r_bf3244994760e535": {
      "text": "So you're my opponent!",
      "status": "imported"
    },
    "voice_138:r_aabfb21c9d069ce7": {
      "text": "Roger! I'll coordinate my attack!",
      "status": "imported"
    },
    "voice_138:r_02479dc8fe989560": {
      "text": "If we focus our attacks...!",
      "status": "imported"
    },
    "voice_138:r_a2df00f91a9b0a9e": {
      "text": "I can't do anything...!",
      "status": "imported"
    },
    "voice_138:r_48b60d6c48b9b142": {
      "text": "They got away...!",
      "status": "imported"
    },
    "voice_138:r_8927e6fb681aa809": {
      "text": "I won't let you do it that easily!",
      "status": "imported"
    },
    "voice_138:r_665f01666859013b": {
      "text": "You won't hit me!",
      "status": "imported"
    },
    "voice_138:r_a571eec59b258d11": {
      "text": "I can see it...!",
      "status": "imported"
    },
    "voice_138:r_ddbe581c5ea9183d": {
      "text": "I know exactly how you'll move!",
      "status": "imported"
    },
    "voice_138:r_faae935cca0edc72": {
      "text": "I can't stay here\\nwasting time!",
      "status": "imported"
    },
    "voice_138:r_d4430bf362340b32": {
      "text": "That won't work!",
      "status": "imported"
    },
    "voice_138:r_6ff1323b355593e0": {
      "text": "This is nothing!",
      "status": "imported"
    },
    "voice_138:r_b7b5625d7cd4282f": {
      "text": "That hit me!? But that's all!",
      "status": "imported"
    },
    "voice_138:r_36133ad73a73ef98": {
      "text": "I'm okay...!\\nNothing serious...!",
      "status": "imported"
    },
    "voice_138:r_920740a0219c5085": {
      "text": "This damage is nothing!",
      "status": "imported"
    },
    "voice_138:r_a8451712c57c1a72": {
      "text": "I was careless...! But next time!",
      "status": "imported"
    },
    "voice_138:r_3633df5b7b8f47fa": {
      "text": "You're good...! But...!",
      "status": "imported"
    },
    "voice_138:r_52dfc56b14b93551": {
      "text": "They read my movements...!? No...!",
      "status": "imported"
    },
    "voice_138:r_1b9b2aab5cb104da": {
      "text": "Next time won't be like this!",
      "status": "imported"
    },
    "voice_138:r_342044c706a2340f": {
      "text": "Strong...!\\nBut no further!",
      "status": "imported"
    },
    "voice_138:r_cf41e8828a90cbdb": {
      "text": "Heavy damage...! I can't go on!",
      "status": "imported"
    },
    "voice_138:r_719e897304ec42d4": {
      "text": "I-I managed to hold out...!",
      "status": "imported"
    },
    "voice_138:r_d5e0a2317c40d322": {
      "text": "Ngh! The drive system's damaged!",
      "status": "imported"
    },
    "voice_138:r_ec2ea17765052401": {
      "text": "N-not this!\\nI can't help Kamille!",
      "status": "imported"
    },
    "voice_138:r_f2d4255f1c2f7542": {
      "text": "Ngh! Damn it!!",
      "status": "imported"
    },
    "voice_138:r_5d08ad19e2da125b": {
      "text": "K-Kamille!!",
      "status": "imported"
    },
    "voice_138:r_8f60f6fc86db3107": {
      "text": "Go down!!",
      "status": "imported"
    },
    "voice_138:r_5213c17e13b23de0": {
      "text": "Goooo!!",
      "status": "imported"
    },
    "voice_138:r_46e86d000250e137": {
      "text": "Don't get in my way!",
      "status": "imported"
    },
    "voice_138:r_cdbd128a5b4127cc": {
      "text": "Ngh! A direct hit!",
      "status": "imported"
    },
    "voice_138:r_cfccaa1fbeda124c": {
      "text": "Ngh! I won't go down here...!",
      "status": "imported"
    },
    "voice_138:r_b1f8ec192b9c083a": {
      "text": "Ngh! I couldn't dodge it!?",
      "status": "imported"
    },
    "voice_138:r_d692f1d420460a47": {
      "text": "I can pilot the Zeta Gundam too!",
      "status": "imported"
    },
    "voice_138:r_a5643cec86b18bd2": {
      "text": "The Psycommu... I'll master it!",
      "status": "imported"
    },
    "voice_138:r_68f2dfab20a4a30e": {
      "text": "This machine can harness my power!",
      "status": "imported"
    },
    "voice_138:r_9cedad8237480563": {
      "text": "I know this feeling...\\nThis is...!?",
      "status": "imported"
    },
    "voice_138:r_a03fabecba1508ca": {
      "text": "The pressure is coming...!",
      "status": "imported"
    },
    "voice_138:r_5391b24a71eb10ae": {
      "text": "That kid... They're just like me...!",
      "status": "imported"
    },
    "voice_138:r_a554ceef5c87b972": {
      "text": "How many lives will your ego\\nruin!?",
      "status": "imported"
    },
    "voice_138:r_546c3d5937fbb7ee": {
      "text": "You won't take our future from us!",
      "status": "imported"
    },
    "voice_138:r_546de3fb6db156ea": {
      "text": "Kamille, fall back!",
      "status": "imported"
    },
    "voice_138:r_ca85f87cee5e31f7": {
      "text": "Kamille is guiding me...!",
      "status": "imported"
    },
    "voice_138:r_9072ea7bc71df136": {
      "text": "I won't let you harm Kamille!",
      "status": "imported"
    },
    "voice_138:r_04e815a8d425827d": {
      "text": "This time, I'll protect Kamille...!",
      "status": "imported"
    },
    "voice_138:r_3c5b0c2ac812d5de": {
      "text": "That pressure can't\\ndrag me along!",
      "status": "imported"
    },
    "voice_138:r_c958860b0676b1f5": {
      "text": "I know this feeling.\\nSame as me...!",
      "status": "imported"
    },
    "voice_138:r_7847e0ed7dc9282d": {
      "text": "Ugh...!\\nThat pilot disgusts me!",
      "status": "imported"
    },
    "voice_138:r_6825fd1ff907bd22": {
      "text": "M-my head...!\\nThis pressure...!",
      "status": "imported"
    },
    "voice_138:r_97b7431eeb81e6b6": {
      "text": "We're not tools of war!",
      "status": "imported"
    },
    "voice_138:r_132f605d02975e71": {
      "text": "Kamille's machine shows his power!",
      "status": "imported"
    }
  }
}
