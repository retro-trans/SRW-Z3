{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_096:r_479b340ccc6c572b": {
      "text": "I have to...! I have to!",
      "status": "imported"
    },
    "voice_096:r_ca4acbac57a2a35e": {
      "text": "Genion, lend me your power...!",
      "status": "imported"
    },
    "voice_096:r_77949221bf58f862": {
      "text": "I'll do what I can...!",
      "status": "imported"
    },
    "voice_096:r_70b9c4b9f1f37eff": {
      "text": "I'm alone! I can't rely on anyone!",
      "status": "imported"
    },
    "voice_096:r_9fcb3754cb1773c7": {
      "text": "Once more! Here I go!",
      "status": "imported"
    },
    "voice_096:r_3559d2fad32c2435": {
      "text": "With the Nitro Pike!",
      "status": "imported"
    },
    "voice_096:r_f7570547e9f80a64": {
      "text": "Hit the mark, Nitro Pike!",
      "status": "imported"
    },
    "voice_096:r_cbab0f4720e1fcf1": {
      "text": "Impact Dagger, set!",
      "status": "imported"
    },
    "voice_096:r_0bbe0b4f5364e732": {
      "text": "Hyaah!",
      "status": "imported"
    },
    "voice_096:r_5dda5198137cb02a": {
      "text": "Please, stay away!",
      "status": "imported"
    },
    "voice_096:r_83ec59afbecdec14": {
      "text": "Stay away!!",
      "status": "imported"
    },
    "voice_096:r_e20bfd42ad95a3c9": {
      "text": "Punisher, set!",
      "status": "imported"
    },
    "voice_096:r_0f58a8822381e57f": {
      "text": "If I fire enough shots...!",
      "status": "imported"
    },
    "voice_096:r_6dbcc507fb61b51d": {
      "text": "Please, let this hit!",
      "status": "imported"
    },
    "voice_096:r_b42ab697149a7c8a": {
      "text": "TS-DEMON, activate!",
      "status": "imported"
    },
    "voice_096:r_4de4fcf3b440baf4": {
      "text": "At least one shot should hit!",
      "status": "imported"
    },
    "voice_096:r_0121a166c715cdff": {
      "text": "Hit!!",
      "status": "imported"
    },
    "voice_096:r_30fad37a42bd3ad3": {
      "text": "Glaive, set!",
      "status": "imported"
    },
    "voice_096:r_80a0b2a84e05d81a": {
      "text": "C-Charge!",
      "status": "imported"
    },
    "voice_096:r_4a9ac1dff86506d9": {
      "text": "TS-DEMON, blade on!",
      "status": "imported"
    },
    "voice_096:r_bc8538e6af3d2577": {
      "text": "I've just got to go all out!",
      "status": "imported"
    },
    "voice_096:r_6b15af9a0057cdc8": {
      "text": "Counterattack...! I have to counter!",
      "status": "imported"
    },
    "voice_096:r_15b4a90140e8a33a": {
      "text": "I have to attack them too...!",
      "status": "imported"
    },
    "voice_096:r_af884a6b11dff121": {
      "text": "I can't just cower here...!",
      "status": "imported"
    },
    "voice_096:r_ac6fe7838e95647b": {
      "text": "I can't let them get away...!",
      "status": "imported"
    },
    "voice_096:r_77ca87eacd17ad52": {
      "text": "I'll cover you from here!",
      "status": "imported"
    },
    "voice_096:r_bf3244994760e535": {
      "text": "I-I'll take the hit!",
      "status": "imported"
    },
    "voice_096:r_aabfb21c9d069ce7": {
      "text": "Huh...! What!? I can't counter!",
      "status": "imported"
    },
    "voice_096:r_02479dc8fe989560": {
      "text": "A-At this rate,\\nI'm a sitting duck!",
      "status": "imported"
    },
    "voice_096:r_a2df00f91a9b0a9e": {
      "text": "I did it! I dodged it!",
      "status": "imported"
    },
    "voice_096:r_48b60d6c48b9b142": {
      "text": "If I look closely, I can dodge!",
      "status": "imported"
    },
    "voice_096:r_8927e6fb681aa809": {
      "text": "As long as I don't shut my eyes...!",
      "status": "imported"
    },
    "voice_096:r_665f01666859013b": {
      "text": "Genion's dodge program\\nkicked in...",
      "status": "imported"
    },
    "voice_096:r_ddbe581c5ea9183d": {
      "text": "I-I have a barrier!",
      "status": "imported"
    },
    "voice_096:r_faae935cca0edc72": {
      "text": "As long as I have D-Fault...!",
      "status": "imported"
    },
    "voice_096:r_d4430bf362340b32": {
      "text": "It only hit me! It only hit me!",
      "status": "imported"
    },
    "voice_096:r_6ff1323b355593e0": {
      "text": "I-I can't dodge it!",
      "status": "imported"
    },
    "voice_096:r_b7b5625d7cd4282f": {
      "text": "But I thought I dodged...!",
      "status": "imported"
    },
    "voice_096:r_36133ad73a73ef98": {
      "text": "Just a scratch,\\nbut at this rate...!",
      "status": "imported"
    },
    "voice_096:r_920740a0219c5085": {
      "text": "Aah!",
      "status": "imported"
    },
    "voice_096:r_a8451712c57c1a72": {
      "text": "I'm sorry, Genion. I'm sorry...",
      "status": "imported"
    },
    "voice_096:r_3633df5b7b8f47fa": {
      "text": "I-I knew it. I can't do this...!",
      "status": "imported"
    },
    "voice_096:r_52dfc56b14b93551": {
      "text": "The damage keeps piling up...!",
      "status": "imported"
    },
    "voice_096:r_1b9b2aab5cb104da": {
      "text": "It's no use! I can't hold out!",
      "status": "imported"
    },
    "voice_096:r_342044c706a2340f": {
      "text": "Genion is... going down...!",
      "status": "imported"
    },
    "voice_096:r_cf41e8828a90cbdb": {
      "text": "Protect...!\\nAt least protect Genion!",
      "status": "imported"
    },
    "voice_096:r_719e897304ec42d4": {
      "text": "Even if it costs my life, Genion...!",
      "status": "imported"
    },
    "voice_096:r_d5e0a2317c40d322": {
      "text": "Aaaaaaaah!!",
      "status": "imported"
    },
    "voice_096:r_ec2ea17765052401": {
      "text": "I'm sorry, Hibiki...",
      "status": "imported"
    },
    "voice_096:r_f2d4255f1c2f7542": {
      "text": "I'm sorry, Knight...",
      "status": "imported"
    }
  }
}
