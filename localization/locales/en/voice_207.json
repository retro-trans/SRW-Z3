{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_207:r_479b340ccc6c572b": {
      "text": "Prepare yourself!",
      "status": "imported"
    },
    "voice_207:r_ca4acbac57a2a35e": {
      "text": "You're wide open!",
      "status": "imported"
    },
    "voice_207:r_77949221bf58f862": {
      "text": "I'll finish you with my own hands!",
      "status": "imported"
    },
    "voice_207:r_70b9c4b9f1f37eff": {
      "text": "My blood's boiling!",
      "status": "imported"
    },
    "voice_207:r_9fcb3754cb1773c7": {
      "text": "I'll beat you senseless!",
      "status": "imported"
    },
    "voice_207:r_3559d2fad32c2435": {
      "text": "How do you like this?!",
      "status": "imported"
    },
    "voice_207:r_f7570547e9f80a64": {
      "text": "Outta my way!",
      "status": "imported"
    },
    "voice_207:r_cbab0f4720e1fcf1": {
      "text": "I'll show you a real fight!",
      "status": "imported"
    },
    "voice_207:r_0bbe0b4f5364e732": {
      "text": "You can't stop me or Getter!",
      "status": "imported"
    },
    "voice_207:r_5dda5198137cb02a": {
      "text": "I'll show you Getter's power!",
      "status": "imported"
    },
    "voice_207:r_83ec59afbecdec14": {
      "text": "Let's go, Shin Getter!",
      "status": "imported"
    },
    "voice_207:r_e20bfd42ad95a3c9": {
      "text": "Behold the power of Shin Getter!",
      "status": "imported"
    },
    "voice_207:r_0f58a8822381e57f": {
      "text": "This isn't over yet!",
      "status": "imported"
    },
    "voice_207:r_6dbcc507fb61b51d": {
      "text": "This time, I'll finish you!",
      "status": "imported"
    },
    "voice_207:r_b42ab697149a7c8a": {
      "text": "Drop dead, Invader scum!",
      "status": "imported"
    },
    "voice_207:r_4de4fcf3b440baf4": {
      "text": "The Invader hunt starts now!",
      "status": "imported"
    },
    "voice_207:r_0121a166c715cdff": {
      "text": "Invader scum!\\nI'll wipe you all out!",
      "status": "imported"
    },
    "voice_207:r_30fad37a42bd3ad3": {
      "text": "Move if you don't wanna die!",
      "status": "imported"
    },
    "voice_207:r_80a0b2a84e05d81a": {
      "text": "Attack me and\\nI won't spare humans!",
      "status": "imported"
    },
    "voice_207:r_4a9ac1dff86506d9": {
      "text": "A mechanical beast? Interesting!",
      "status": "imported"
    },
    "voice_207:r_bc8538e6af3d2577": {
      "text": "Flesh, I kill!\\nMechs, I smash!",
      "status": "imported"
    },
    "voice_207:r_924516c8de2b5342": {
      "text": "The star is here!\\nA worthy opponent!",
      "status": "imported"
    },
    "voice_207:r_da1174533722333f": {
      "text": "You'd challenge Getter in the air?!",
      "status": "imported"
    },
    "voice_207:r_fdeb8162976e72c1": {
      "text": "Getter Tomahawk!",
      "status": "imported"
    },
    "voice_207:r_0fadb5c26df92b42": {
      "text": "Boomerang!",
      "status": "imported"
    },
    "voice_207:r_6b15af9a0057cdc8": {
      "text": "Tomahaaawk!",
      "status": "imported"
    },
    "voice_207:r_15b4a90140e8a33a": {
      "text": "Boooomerang!",
      "status": "imported"
    },
    "voice_207:r_af884a6b11dff121": {
      "text": "Getter Tomahaaawk!",
      "status": "imported"
    },
    "voice_207:r_ac6fe7838e95647b": {
      "text": "Booooooooomerang!",
      "status": "imported"
    },
    "voice_207:r_bf3244994760e535": {
      "text": "I'll split you in two!",
      "status": "imported"
    },
    "voice_207:r_aabfb21c9d069ce7": {
      "text": "Got you!",
      "status": "imported"
    },
    "voice_207:r_a2df00f91a9b0a9e": {
      "text": "I'll slice you apart!",
      "status": "imported"
    },
    "voice_207:r_48b60d6c48b9b142": {
      "text": "Raaaaaaaagh!",
      "status": "imported"
    },
    "voice_207:r_665f01666859013b": {
      "text": "I'll carve your guts out!",
      "status": "imported"
    },
    "voice_207:r_a571eec59b258d11": {
      "text": "Uoooooryaaaaaah!",
      "status": "imported"
    },
    "voice_207:r_ddbe581c5ea9183d": {
      "text": "Gettaaa!",
      "status": "imported"
    },
    "voice_207:r_faae935cca0edc72": {
      "text": "Beeeam!",
      "status": "imported"
    },
    "voice_207:r_d4430bf362340b32": {
      "text": "Gettaaaaaaa!!",
      "status": "imported"
    },
    "voice_207:r_6ff1323b355593e0": {
      "text": "Beeeeeeeeam!!",
      "status": "imported"
    },
    "voice_207:r_b7b5625d7cd4282f": {
      "text": "Gettaaa Beeeeeam!",
      "status": "imported"
    },
    "voice_207:r_36133ad73a73ef98": {
      "text": "Gettaaaaaaa\\nBeeeeeeeeam!",
      "status": "imported"
    },
    "voice_207:r_920740a0219c5085": {
      "text": "Getter Battle Wing!",
      "status": "imported"
    },
    "voice_207:r_a8451712c57c1a72": {
      "text": "Haaaaaaah!",
      "status": "imported"
    },
    "voice_207:r_3633df5b7b8f47fa": {
      "text": "Battle Wing!!",
      "status": "imported"
    },
    "voice_207:r_52dfc56b14b93551": {
      "text": "You're not getting away!",
      "status": "imported"
    },
    "voice_207:r_1b9b2aab5cb104da": {
      "text": "Battle Wing!",
      "status": "imported"
    },
    "voice_207:r_cf41e8828a90cbdb": {
      "text": "Gettaaaaa!\\nBattle Wing!",
      "status": "imported"
    },
    "voice_207:r_5d08ad19e2da125b": {
      "text": "Here I go!",
      "status": "imported"
    },
    "voice_207:r_dc8701f6bcb9904f": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_207:r_620fedec67706d7d": {
      "text": "Time to pay you back in full!",
      "status": "imported"
    },
    "voice_207:r_9680dcd0fddcfcc7": {
      "text": "This is how you launch an attack!",
      "status": "imported"
    },
    "voice_207:r_2a00f1044ad5cbaa": {
      "text": "Time to settle the score!",
      "status": "imported"
    },
    "voice_207:r_3dbeead1bd3164ef": {
      "text": "Don't get carried away!",
      "status": "imported"
    },
    "voice_207:r_98d15b8cc09bc915": {
      "text": "Don't think you'll make it home!",
      "status": "imported"
    },
    "voice_207:r_46e86d000250e137": {
      "text": "Move! I'll handle this!",
      "status": "imported"
    },
    "voice_207:r_ac341e7976e88f0b": {
      "text": "Stay sharp! Here comes another!",
      "status": "imported"
    },
    "voice_207:r_cdbd128a5b4127cc": {
      "text": "Fall back, Kouji! I'll take over!",
      "status": "imported"
    },
    "voice_207:r_cfccaa1fbeda124c": {
      "text": "Simon! I'll lend you a hand!",
      "status": "imported"
    },
    "voice_207:r_b1f8ec192b9c083a": {
      "text": "You're in my way! Move!",
      "status": "imported"
    },
    "voice_207:r_a007f9ab9cf048b3": {
      "text": "You sure know how to make me work!",
      "status": "imported"
    },
    "voice_207:r_ddafde4b065ced49": {
      "text": "Quit spacing out, Kouji!",
      "status": "imported"
    },
    "voice_207:r_de1213040856c089": {
      "text": "Simon, come on!\\nKamina will laugh!",
      "status": "imported"
    },
    "voice_207:r_3304412ac41f47a6": {
      "text": "What?! I can't counterattack?!",
      "status": "imported"
    },
    "voice_207:r_0c0775e051211840": {
      "text": "Remember! I'll repay you double!",
      "status": "imported"
    },
    "voice_207:r_a2afffe1c396f0b3": {
      "text": "Damn!\\nDid I use too much energy?!",
      "status": "imported"
    },
    "voice_207:r_13c25fbdfddc8a24": {
      "text": "Where are you?! Where'd you hide?!",
      "status": "imported"
    },
    "voice_207:r_42ba1ecb310b4bd7": {
      "text": "Too slow!",
      "status": "imported"
    },
    "voice_207:r_d692f1d420460a47": {
      "text": "What a huge letdown!",
      "status": "imported"
    },
    "voice_207:r_a5643cec86b18bd2": {
      "text": "A fly could've landed on you!",
      "status": "imported"
    },
    "voice_207:r_68f2dfab20a4a30e": {
      "text": "Like that'll hit me, slowpoke!",
      "status": "imported"
    },
    "voice_207:r_9cedad8237480563": {
      "text": "Serves you right! Come back later!",
      "status": "imported"
    },
    "voice_207:r_a03fabecba1508ca": {
      "text": "Don't underestimate Getter!",
      "status": "imported"
    },
    "voice_207:r_5391b24a71eb10ae": {
      "text": "Damn! Shin Getter's output...!",
      "status": "imported"
    },
    "voice_207:r_a554ceef5c87b972": {
      "text": "Invaders!\\nYou won't have your way!",
      "status": "imported"
    },
    "voice_207:r_546c3d5937fbb7ee": {
      "text": "Remember this! Getter can do it all!",
      "status": "imported"
    },
    "voice_207:r_1568ff6298b12b96": {
      "text": "Damn! My eyes are swimming!",
      "status": "imported"
    },
    "voice_207:r_a77f4913375098d2": {
      "text": "This damage doesn't mean a thing!",
      "status": "imported"
    },
    "voice_207:r_428c2116ac3071b1": {
      "text": "Hey...\\nDon't say that's all!",
      "status": "imported"
    },
    "voice_207:r_84c116267b79f540": {
      "text": "Isn't there anyone worth fighting?!",
      "status": "imported"
    },
    "voice_207:r_dad38ee29af2df3a": {
      "text": "You think that attack can kill us?!",
      "status": "imported"
    },
    "voice_207:r_3d32e86f8dc80909": {
      "text": "Beat Getter with that?\\nWhat a joke!",
      "status": "imported"
    },
    "voice_207:r_70451ffbabe2f876": {
      "text": "An attack like that won't faze me!",
      "status": "imported"
    },
    "voice_207:r_69dfa1659715e2fa": {
      "text": "That won't work, Invader scum!",
      "status": "imported"
    },
    "voice_207:r_d996fd6d4ef5b329": {
      "text": "Useless! Get back to space!",
      "status": "imported"
    },
    "voice_207:r_8ab47a28f99ef565": {
      "text": "Now this is getting interesting!",
      "status": "imported"
    },
    "voice_207:r_546de3fb6db156ea": {
      "text": "To beat us,\\nyou need more power!",
      "status": "imported"
    },
    "voice_207:r_ca85f87cee5e31f7": {
      "text": "You bastard... Now I'm fired up!",
      "status": "imported"
    },
    "voice_207:r_9072ea7bc71df136": {
      "text": "Heh! Don't get cocky over that!",
      "status": "imported"
    },
    "voice_207:r_04e815a8d425827d": {
      "text": "Screw you!\\nI won't die so easily!",
      "status": "imported"
    },
    "voice_207:r_d89011fe3e5d082a": {
      "text": "Damn! Did I take that head-on?!",
      "status": "imported"
    },
    "voice_207:r_3c5b0c2ac812d5de": {
      "text": "Whoa!\\nNot bad for an Invader!",
      "status": "imported"
    },
    "voice_207:r_5b9e8897190892eb": {
      "text": "Don't get carried awaaaay!",
      "status": "imported"
    },
    "voice_207:r_7bea3023abbf8a94": {
      "text": "Damn!\\nWe'll fall apart at this rate!",
      "status": "imported"
    },
    "voice_207:r_dd01a4c0d1b36a8d": {
      "text": "Damn!\\nWhat the hell's happening?!",
      "status": "imported"
    },
    "voice_207:r_20920ad2eb3542db": {
      "text": "Damn! This is getting dangerous!",
      "status": "imported"
    },
    "voice_207:r_0ab7914877fd48ed": {
      "text": "Heh... Danger only fires me up!",
      "status": "imported"
    },
    "voice_207:r_cb846feec748c2e3": {
      "text": "Getter!\\nThen take my life!",
      "status": "imported"
    },
    "voice_207:r_c958860b0676b1f5": {
      "text": "What insane power!",
      "status": "imported"
    },
    "voice_207:r_5e2669b82ef75ce3": {
      "text": "N-No way! Getter is...",
      "status": "imported"
    },
    "voice_207:r_7847e0ed7dc9282d": {
      "text": "Daaaaaaaamn!!",
      "status": "imported"
    },
    "voice_207:r_e42b52c7a987b906": {
      "text": "Chaaange! Gettaaaa 1!",
      "status": "imported"
    },
    "voice_207:r_6825fd1ff907bd22": {
      "text": "This is... Shin Getter!",
      "status": "imported"
    },
    "voice_207:r_607f666f1563bc0d": {
      "text": "Change, Getter 1!",
      "status": "imported"
    },
    "voice_207:r_97b7431eeb81e6b6": {
      "text": "Chaaange! Gettaaaa 1! Switch on!",
      "status": "imported"
    },
    "voice_207:r_5aeeb4917340c42d": {
      "text": "I'll show you hell too!",
      "status": "imported"
    },
    "voice_207:r_b765659981b6516d": {
      "text": "Black Getter will\\nsend you to hell!",
      "status": "imported"
    },
    "voice_207:r_d3f01de714c015bd": {
      "text": "Ryouma! Looks like they're ready!",
      "status": "imported"
    },
    "voice_207:r_7d2617c809fead70": {
      "text": "Now this is fun! I'll crush them!",
      "status": "imported"
    },
    "voice_207:r_ceb935ccbf830724": {
      "text": "Strategy doesn't suit you! Go wild!",
      "status": "imported"
    },
    "voice_207:r_862ef7385bf2abd4": {
      "text": "Gladly, Hayato!",
      "status": "imported"
    },
    "voice_207:r_001cbec4d9a4283f": {
      "text": "Let them have it, Ryouma!",
      "status": "imported"
    },
    "voice_207:r_8ad40afecd02b41e": {
      "text": "I was gonna do that anyway!",
      "status": "imported"
    },
    "voice_207:r_26e5efec03c03d78": {
      "text": "Heh. Same as ever.",
      "status": "imported"
    },
    "voice_207:r_4ad81e88c7557a8b": {
      "text": "We're weak in water! Switch with me!",
      "status": "imported"
    },
    "voice_207:r_1f65a7af190e4674": {
      "text": "Shut up! So what?!",
      "status": "imported"
    },
    "voice_207:r_40c5a9358ed5bf29": {
      "text": "You'll never catch them! I'll do it!",
      "status": "imported"
    },
    "voice_207:r_f2e18dfdfe0c89ea": {
      "text": "Hands off!\\nThis one's my prey!",
      "status": "imported"
    },
    "voice_207:r_cf7dbf49e96a5755": {
      "text": "Ryouma! Ground combat is mine!",
      "status": "imported"
    },
    "voice_207:r_fa96676cc65bb509": {
      "text": "I don't care where the enemy is!",
      "status": "imported"
    },
    "voice_207:r_cb306ef55e49d107": {
      "text": "This'll finish it!",
      "status": "imported"
    },
    "voice_207:r_57b2bd2de8a1408d": {
      "text": "Uoooooryaah!",
      "status": "imported"
    },
    "voice_207:r_76f080a4881e8ab5": {
      "text": "No restraint! I'll fire every shot!",
      "status": "imported"
    },
    "voice_207:r_288133bc5b573dae": {
      "text": "Drop deaaad!",
      "status": "imported"
    },
    "voice_207:r_6f95653e548f8fcf": {
      "text": "Drop dead already!",
      "status": "imported"
    },
    "voice_207:r_d249d68bada91ab9": {
      "text": "Deyaaaaah!",
      "status": "imported"
    },
    "voice_207:r_e9b3307e9eb69f11": {
      "text": "Don't think you can escape this!",
      "status": "imported"
    },
    "voice_207:r_03cdac73042343ee": {
      "text": "Raaaaaaaaagh!",
      "status": "imported"
    },
    "voice_207:r_6026da5acbda7c69": {
      "text": "Ryouma! Use Stoner Sunshine!",
      "status": "imported"
    },
    "voice_207:r_981f8fedd5414fe5": {
      "text": "Finish it in one shot!",
      "status": "imported"
    },
    "voice_207:r_96bb0dcde0c8c44a": {
      "text": "My... Our will\\npowers Getter!",
      "status": "imported"
    },
    "voice_207:r_641550a2f54cb456": {
      "text": "Oooooryaaaah!!",
      "status": "imported"
    },
    "voice_207:r_a0f2074af8debbfa": {
      "text": "Stoneeeer!\\nSuuuunshiiine!!",
      "status": "imported"
    },
    "voice_207:r_b5f5a97ed82acb0b": {
      "text": "Go, Ryoumaaa!!",
      "status": "imported"
    },
    "voice_207:r_d9cd2e4ded064396": {
      "text": "We must unite our hearts...!",
      "status": "imported"
    },
    "voice_207:r_99e6349431aaf23b": {
      "text": "Let's do it! Stoner Sunshine!",
      "status": "imported"
    },
    "voice_207:r_ec1081caf845f56a": {
      "text": "Gwoooooooh!!",
      "status": "imported"
    },
    "voice_207:r_2c5b7ee872c1ed7f": {
      "text": "Stoner Suuuuunshiiine!!",
      "status": "imported"
    },
    "voice_207:r_76d1e51c8b494a60": {
      "text": "I feel it... Getter's power!",
      "status": "imported"
    },
    "voice_207:r_eb5f687fcd372ae7": {
      "text": "Three hearts becoming one...",
      "status": "imported"
    },
    "voice_207:r_3fc2e1186557e7a0": {
      "text": "You don't know how to handle Getter!",
      "status": "imported"
    },
    "voice_207:r_fa6930340a545054": {
      "text": "Getter Team, you?!\\nCan't watch this!",
      "status": "imported"
    },
    "voice_207:r_2332b9d56461d7ab": {
      "text": "How boring. Is it over already?",
      "status": "imported"
    },
    "voice_207:r_854aa0a91a3c80d1": {
      "text": "Heh. You're no challenge at all.",
      "status": "imported"
    },
    "voice_207:r_0bc8ae32a406ceab": {
      "text": "That's it? You're nothing special.",
      "status": "imported"
    },
    "voice_207:r_82c09f011d703b2c": {
      "text": "Don't underestimate us or Getter!",
      "status": "imported"
    },
    "voice_207:r_2b4d8818c77b6dca": {
      "text": "As expected of our leader.",
      "status": "imported"
    },
    "voice_207:r_087354f2db0a31e6": {
      "text": "Heh... Don't flatter me!",
      "status": "imported"
    },
    "voice_207:r_db02a2dec93dd263": {
      "text": "Damn! Did that graze me?!",
      "status": "imported"
    },
    "voice_207:r_d520c6d5298a848d": {
      "text": "Attack and dodging both need focus!",
      "status": "imported"
    },
    "voice_207:r_099e2458cabf796f": {
      "text": "You still haven't fixed that habit.",
      "status": "imported"
    },
    "voice_207:r_fd910d714be70870": {
      "text": "Shut up... Just watch me!",
      "status": "imported"
    },
    "voice_207:r_9736f29b11344ec3": {
      "text": "Hey, Ryouma! That one hit us!",
      "status": "imported"
    },
    "voice_207:r_fcd05582aa5c6068": {
      "text": "Quit whining over a scratch!",
      "status": "imported"
    },
    "voice_207:r_bece29562818acba": {
      "text": "This is nothing serious!",
      "status": "imported"
    },
    "voice_207:r_494b5da92ed24ecb": {
      "text": "Yeah! That's Getter for you!",
      "status": "imported"
    },
    "voice_207:r_a4a5a96f4bd58920": {
      "text": "Damn it! What the hell's going on?!",
      "status": "imported"
    },
    "voice_207:r_b57d2d74233f889a": {
      "text": "Calm down, Ryouma! Focus!",
      "status": "imported"
    },
    "voice_207:r_cd06d0820d82524b": {
      "text": "This enemy's seriously strong...!",
      "status": "imported"
    },
    "voice_207:r_c94c6d04be583774": {
      "text": "Yeah! Now that's a worthy opponent!",
      "status": "imported"
    },
    "voice_207:r_e54e2c99ef8297af": {
      "text": "Hang in there, Ryouma! It's shallow!",
      "status": "imported"
    },
    "voice_207:r_f16a3eb0bcaac082": {
      "text": "Don't worry! We're just starting!",
      "status": "imported"
    },
    "voice_207:r_10a408809e512df1": {
      "text": "Ryouma! We're in deep trouble!",
      "status": "imported"
    },
    "voice_207:r_bc7b9e308b879dd4": {
      "text": "Comebacks are\\nGetter Team's way!",
      "status": "imported"
    },
    "voice_207:r_98902fd3143c393e": {
      "text": "Ryouma, what now?!\\nWe're overrun!",
      "status": "imported"
    },
    "voice_207:r_d907fbd7bc1c4298": {
      "text": "Shut up!\\nI know that already!!",
      "status": "imported"
    },
    "voice_207:r_96b21e3a028dd074": {
      "text": "Sorry, you two,\\nbut stay to the end!",
      "status": "imported"
    },
    "voice_207:r_ce140b5d8e6b7310": {
      "text": "Heh. We knew that from the start.",
      "status": "imported"
    },
    "voice_207:r_0e0335789c5396d7": {
      "text": "Ryouma! Can't you do something?!",
      "status": "imported"
    },
    "voice_207:r_a8e85bd950696403": {
      "text": "If I could, I would've done it!",
      "status": "imported"
    },
    "voice_207:r_772c8bc40ab6cb61": {
      "text": "What now? There's no way back!",
      "status": "imported"
    },
    "voice_207:r_58dd2826a199ef51": {
      "text": "Obviously! We fight to the death!",
      "status": "imported"
    },
    "voice_207:r_aadc0b2442adb93b": {
      "text": "Here they come! Hayato, Benkei, go!",
      "status": "imported"
    },
    "voice_207:r_e7a8cd8ed5bc2d1b": {
      "text": "Yeah!",
      "status": "imported"
    },
    "voice_207:r_ec349c8ea9511a18": {
      "text": "So that's the cause of all this...!",
      "status": "imported"
    },
    "voice_207:r_33236ffa3ea95b68": {
      "text": "It's time to settle this!",
      "status": "imported"
    },
    "voice_207:r_689d0b123de71ae0": {
      "text": "Let's go!\\nOur hands will finish you!",
      "status": "imported"
    },
    "voice_207:r_cff0deaae73c2858": {
      "text": "Sorry... This ends here!",
      "status": "imported"
    },
    "voice_207:r_dca67f68a573fab7": {
      "text": "Don't underestimate Ryouma!",
      "status": "imported"
    },
    "voice_207:r_8f5bade7ac2db78e": {
      "text": "Time to repay that debt...!",
      "status": "imported"
    },
    "voice_207:r_05ea490d2f522520": {
      "text": "I'll make you regret this!",
      "status": "imported"
    },
    "voice_207:r_f5658c702d91db7a": {
      "text": "Not bad! Here's one in return!",
      "status": "imported"
    },
    "voice_207:r_686df329b50f195b": {
      "text": "Let me take the next one!",
      "status": "imported"
    },
    "voice_207:r_25f0ab0fa3cf690c": {
      "text": "That wasn't enough! One more!",
      "status": "imported"
    },
    "voice_207:r_b708a1d959013dbf": {
      "text": "N-No way!",
      "status": "imported"
    },
    "voice_207:r_59fca03e929366c1": {
      "text": "As long as I can move, I won't lose!",
      "status": "imported"
    },
    "voice_207:r_0d65eb631dcb7514": {
      "text": "You sure made me work for it!",
      "status": "imported"
    },
    "voice_207:r_d03018a31e23f1e9": {
      "text": "Damn! This damage is nothing!",
      "status": "imported"
    },
    "voice_207:r_279da5f732aa8847": {
      "text": "That won't work!",
      "status": "imported"
    },
    "voice_207:r_97f82e3cb6f70110": {
      "text": "Heh... Thought I felt a breeze!",
      "status": "imported"
    },
    "voice_207:r_c5611d8dd6def96b": {
      "text": "Heh! That was a piece of cake!",
      "status": "imported"
    },
    "voice_207:r_6f12cc8ed2732eb5": {
      "text": "What was that? You missed!",
      "status": "imported"
    },
    "voice_207:r_7abfc55f8fb62ba7": {
      "text": "Too bad!\\nI've got this gear too!",
      "status": "imported"
    },
    "voice_207:r_99e7a66c650b5892": {
      "text": "Fine! Fall back!",
      "status": "imported"
    },
    "voice_207:r_5b2247b5cfbcd7b2": {
      "text": "If it's a mech, I just smash it!",
      "status": "imported"
    },
    "voice_207:r_e09b933e3e706779": {
      "text": "Take this from me!",
      "status": "imported"
    },
    "voice_207:r_66236eb99b676e5b": {
      "text": "I'll deal with you first!",
      "status": "imported"
    },
    "voice_207:r_9639a2dbcd2f58ed": {
      "text": "I don't care who I'm fighting!",
      "status": "imported"
    },
    "voice_207:r_aeea0893acb93d35": {
      "text": "I'll crush whoever's closest!",
      "status": "imported"
    },
    "voice_207:r_b31568654e53487b": {
      "text": "Don't you move from that spot!",
      "status": "imported"
    },
    "voice_207:r_2502132569141ea3": {
      "text": "Getter will take you on!",
      "status": "imported"
    },
    "voice_207:r_1ff312798a52c8eb": {
      "text": "This Getter's built my way!",
      "status": "imported"
    },
    "voice_207:r_fa07d90fca62f593": {
      "text": "Black Getter will finish you!",
      "status": "imported"
    },
    "voice_207:r_a25bf2676ecf9d83": {
      "text": "Let's go, Black Getter!",
      "status": "imported"
    },
    "voice_207:r_237a0288b42dce20": {
      "text": "I'll take you on with Shin Getter!",
      "status": "imported"
    },
    "voice_207:r_0556e8a22779ea8e": {
      "text": "Nothing can stop Shin Getter!",
      "status": "imported"
    },
    "voice_207:r_09d377101a48d92a": {
      "text": "Let's finish this, Shin Getter!",
      "status": "imported"
    },
    "voice_207:r_11517cc7b0494dbf": {
      "text": "Ryouma, give them your hardest shot.",
      "status": "imported"
    },
    "voice_207:r_b5864501463db244": {
      "text": "Right! I'm going all out!",
      "status": "imported"
    },
    "voice_207:r_a88939ea84b4474d": {
      "text": "Ryouma, the enemy's dead ahead!",
      "status": "imported"
    },
    "voice_207:r_a870d0cf7cc11ec6": {
      "text": "Standing before me takes guts!",
      "status": "imported"
    },
    "voice_207:r_03f6158ef83964f3": {
      "text": "Now! Let them have it!",
      "status": "imported"
    },
    "voice_207:r_2970a83693cdcc25": {
      "text": "That's my specialty!",
      "status": "imported"
    },
    "voice_207:r_be661448b85d0009": {
      "text": "Hayato, Benkei! You ready?!",
      "status": "imported"
    },
    "voice_207:r_8b18aa4cc69547df": {
      "text": "Keep coming.\\nYou'll never beat me!",
      "status": "imported"
    },
    "voice_207:r_3e87f6fc3ea65aef": {
      "text": "This time, I'll wipe you all out!",
      "status": "imported"
    },
    "voice_207:r_5508a7bfa9074eb9": {
      "text": "I won't fall behind some machine!",
      "status": "imported"
    },
    "voice_207:r_09a003e91f0d5dc7": {
      "text": "You think mechs can stop us?!",
      "status": "imported"
    },
    "voice_207:r_192447448ebd7bb5": {
      "text": "I've got no time for small fry!",
      "status": "imported"
    },
    "voice_207:r_e92920ba4b301b9f": {
      "text": "Run home before you get hurt!",
      "status": "imported"
    },
    "voice_207:r_207b256d613bb896": {
      "text": "I won't spare anyone who attacks!",
      "status": "imported"
    },
    "voice_207:r_a6fd676d8146501b": {
      "text": "A Gundam? You're a worthy opponent!",
      "status": "imported"
    },
    "voice_207:r_94d35e5fa8e3a198": {
      "text": "Heh! I get to fight a Gundam!",
      "status": "imported"
    },
    "voice_207:r_b686510e636673f3": {
      "text": "The bigger they are, the better!",
      "status": "imported"
    },
    "voice_207:r_59369bad143d4272": {
      "text": "This is a head-on contest of power!",
      "status": "imported"
    },
    "voice_207:r_25f9b1e39dd8d366": {
      "text": "Fast, but you're no Hayato!",
      "status": "imported"
    },
    "voice_207:r_307477bedd148060": {
      "text": "Getter demands\\na tougher machine!",
      "status": "imported"
    },
    "voice_207:r_09a780acca0eb4b0": {
      "text": "I'll scrap you in a single blow!",
      "status": "imported"
    },
    "voice_207:r_af62f2ee466b5c8c": {
      "text": "Small machine or not, no mercy!",
      "status": "imported"
    },
    "voice_207:r_20cfb719db02fafd": {
      "text": "Don't get cocky, you freaks!",
      "status": "imported"
    },
    "voice_207:r_570c1fdf72edb283": {
      "text": "I know your kind.\\nThanks, Invaders!",
      "status": "imported"
    },
    "voice_207:r_23f0d87a5a6cfca1": {
      "text": "Your kind or us-\\nwho goes extinct?!",
      "status": "imported"
    },
    "voice_207:r_727b2ee0277f9159": {
      "text": "Space Monsters!\\nI'll crush you all!",
      "status": "imported"
    },
    "voice_207:r_cff4d2eae8a939ed": {
      "text": "Your proud field\\nI'll punch through!",
      "status": "imported"
    },
    "voice_207:r_1428fe5f35a9427b": {
      "text": "Attack our Earth?\\nYou've got guts!",
      "status": "imported"
    },
    "voice_207:r_96d39b8bdfa6f183": {
      "text": "Get the hell off Earth already!",
      "status": "imported"
    },
    "voice_207:r_0e4f9b8a2d26ebff": {
      "text": "The world won't give you a do-over!",
      "status": "imported"
    },
    "voice_207:r_79e0d542fe12bcf7": {
      "text": "Don't bore me, Mycenae!",
      "status": "imported"
    },
    "voice_207:r_eff747ba39a55393": {
      "text": "Bullslayer? No, godslayer!",
      "status": "imported"
    },
    "voice_207:r_b2dc77aa6dd77e69": {
      "text": "Hades! I'll snap those horns off!",
      "status": "imported"
    },
    "voice_207:r_445d40d8b5d7092b": {
      "text": "You're the one who'll burn in hell!",
      "status": "imported"
    },
    "voice_207:r_bbb633cb5e8e6daf": {
      "text": "I'll turn the Red Comet to stardust!",
      "status": "imported"
    },
    "voice_207:r_f4ff463b2fda1b86": {
      "text": "You're my enemy now, so no mercy!",
      "status": "imported"
    },
    "voice_207:r_4e63c037d3cb8a3d": {
      "text": "Want a woman?\\nMake her fall for you!",
      "status": "imported"
    },
    "voice_207:r_9ca8d188ae805e3a": {
      "text": "I won't hold back on a kidnapper!",
      "status": "imported"
    },
    "voice_207:r_795ed21f3e28e1f5": {
      "text": "I'll spare you from death, barely!",
      "status": "imported"
    },
    "voice_207:r_141415c1def5ab2d": {
      "text": "I'm doing this to save you! Bear it!",
      "status": "imported"
    },
    "voice_207:r_c894e35becf35a03": {
      "text": "Let's go, Kouji!",
      "status": "imported"
    },
    "voice_207:r_79b1abf5fc86483c": {
      "text": "Kouji! Come at me for real!",
      "status": "imported"
    },
    "voice_207:r_e9a11621911acb19": {
      "text": "Show me how far you can go, Kouji!",
      "status": "imported"
    },
    "voice_207:r_d52bece55796f599": {
      "text": "I'll sink the big one!",
      "status": "imported"
    },
    "voice_207:r_358fe5a50bbee1df": {
      "text": "A warship is no match for Getter!",
      "status": "imported"
    },
    "voice_207:r_638834e16724002f": {
      "text": "Looks like you've got some backbone!",
      "status": "imported"
    },
    "voice_207:r_b02fca1590ac1210": {
      "text": "I feel it... Someone strong is near!",
      "status": "imported"
    },
    "voice_207:r_f0344d2fbaa9db77": {
      "text": "Enough talk now, big shot!",
      "status": "imported"
    },
    "voice_207:r_3328eef766ff2c2c": {
      "text": "Selfish ideals?\\nLike I give a damn!",
      "status": "imported"
    },
    "voice_207:r_23b037cf6ccc695c": {
      "text": "We won't give Earth up so easily!",
      "status": "imported"
    },
    "voice_207:r_883ad1128d340c5e": {
      "text": "You want brute force?\\nThen face me!",
      "status": "imported"
    },
    "voice_207:r_a9e6ed99025a703b": {
      "text": "I'll crush your stupid scheme too!",
      "status": "imported"
    },
    "voice_207:r_b0d1459d6daeebbe": {
      "text": "I'll rip off\\nyour false faces!",
      "status": "imported"
    },
    "voice_207:r_cd4893b409472e97": {
      "text": "Aliens get an Earth-style greeting!",
      "status": "imported"
    },
    "voice_207:r_5691cc71770ffdde": {
      "text": "All right, Ryouma. Do it your way!",
      "status": "imported"
    },
    "voice_207:r_964e07c5563a5508": {
      "text": "Ryouma! Don't dismiss its healing!",
      "status": "imported"
    },
    "voice_207:r_db54e717bff3e3b2": {
      "text": "Then\\nI'll just hit even harder!",
      "status": "imported"
    },
    "voice_207:r_fcab8d80aef7e9d8": {
      "text": "At last, a foe\\nwho may fight back!",
      "status": "imported"
    },
    "voice_207:r_2174bd0edc164171": {
      "text": "Don't let your guard down, Ryouma!",
      "status": "imported"
    },
    "voice_207:r_ad54419336b49578": {
      "text": "Want a taste of Getter's power?!",
      "status": "imported"
    },
    "voice_207:r_63c353e1e05e8e39": {
      "text": "Yeah! Don't hold anything back!",
      "status": "imported"
    },
    "voice_207:r_87646dd472438e88": {
      "text": "Ryouma, don't miss a warship!",
      "status": "imported"
    },
    "voice_207:r_4e32ac89cba02001": {
      "text": "There's no need to worry about me!",
      "status": "imported"
    },
    "voice_207:r_02d24e5915bfa5b7": {
      "text": "Don't think you'll get away clean!",
      "status": "imported"
    },
    "voice_207:r_9331c2c2ef55c78f": {
      "text": "I'll pay you back twice over!",
      "status": "imported"
    },
    "voice_207:r_49734bdb3507acf7": {
      "text": "Don't get so full of yourself!",
      "status": "imported"
    },
    "voice_207:r_2a730c9b4df0dca3": {
      "text": "I'll turn the tables on you!",
      "status": "imported"
    },
    "voice_207:r_1e5842ba5dc3f705": {
      "text": "Get back on your feet, Kouji!",
      "status": "imported"
    },
    "voice_207:r_9747bd61ad23ecd3": {
      "text": "Kouji! Think of a one-shot finish!",
      "status": "imported"
    },
    "voice_207:r_6823f8abe05c4727": {
      "text": "Sorry, Kouji! This finish is mine!",
      "status": "imported"
    },
    "voice_207:r_b8ccfd8b8ac323ac": {
      "text": "I'm following up, Kouji!",
      "status": "imported"
    },
    "voice_207:r_c885ff2097749991": {
      "text": "Shinji! This is how you attack!",
      "status": "imported"
    },
    "voice_207:r_a8da7f8d8b705db0": {
      "text": "Stay back, Shinji! I'll take them!",
      "status": "imported"
    },
    "voice_207:r_02e1c5e19de5bd22": {
      "text": "Kittan! You aim for the next one!",
      "status": "imported"
    },
    "voice_207:r_6fb823898811e210": {
      "text": "I can't believe you missed one!",
      "status": "imported"
    },
    "voice_207:r_5dcbcf1682cc3ab8": {
      "text": "That's Team Dai-Gurren for you!",
      "status": "imported"
    },
    "voice_207:r_5a20988e743dc1d0": {
      "text": "I can't watch this, Kouji!",
      "status": "imported"
    },
    "voice_207:r_197f05bf899b7697": {
      "text": "Kouji!\\nDon't trust Mazinger's armor!",
      "status": "imported"
    },
    "voice_207:r_623ee03bd91ab2a1": {
      "text": "Shinji! Keep your eyes on attacks!",
      "status": "imported"
    },
    "voice_207:r_c5c491f8761152f0": {
      "text": "Babysitting kids is an adult's job!",
      "status": "imported"
    },
    "voice_207:r_15042263763f11bb": {
      "text": "They're pushing you back, Kittan!",
      "status": "imported"
    },
    "voice_207:r_96b3a8f080aea8b4": {
      "text": "Snipers should stay in the rear!",
      "status": "imported"
    },
    "voice_207:r_3d4fa015b8b31648": {
      "text": "Like Kamina, none of you can defend!",
      "status": "imported"
    },
    "voice_207:r_c1f3167d7dd97543": {
      "text": "Kouji! What are you aiming at?!",
      "status": "imported"
    },
    "voice_207:r_1ac46173650ffe13": {
      "text": "Is that all Mycenae's gods have?!",
      "status": "imported"
    },
    "voice_207:r_53660d6bc7fe8513": {
      "text": "Damn you, Hades...!\\nToying with us?!",
      "status": "imported"
    },
    "voice_207:r_2e756557a1d92e8b": {
      "text": "Good aim, but not enough spirit!",
      "status": "imported"
    },
    "voice_207:r_45d847e7b8d840e3": {
      "text": "What's wrong?! Finished already?!",
      "status": "imported"
    },
    "voice_207:r_d2ebe8f28f2420cc": {
      "text": "Tricks won't work on me! Go all out!",
      "status": "imported"
    },
    "voice_207:r_3baa2292b050034a": {
      "text": "A god at this level?\\nWhat a joke!",
      "status": "imported"
    },
    "voice_207:r_8a303240a87b1c7d": {
      "text": "Looks like that grazed us, Ryouma.",
      "status": "imported"
    },
    "voice_207:r_69d009696527fa68": {
      "text": "That attack wasn't worth dodging!",
      "status": "imported"
    },
    "voice_207:r_aeb9079d86e2a924": {
      "text": "Not yet, Kouji! Come to defeat me!",
      "status": "imported"
    },
    "voice_207:r_bc4658630f8e40a9": {
      "text": "That wasn't bad, Kouji!",
      "status": "imported"
    },
    "voice_207:r_92816afa2ba8a8c9": {
      "text": "Take this handicap,\\nMycenae!",
      "status": "imported"
    },
    "voice_207:r_a29f58ecde5f7ddd": {
      "text": "Damn! That's Mycenae's boss for you!",
      "status": "imported"
    },
    "voice_207:r_4069f7e9517c47e8": {
      "text": "Damn!\\nGetter's slowing down!",
      "status": "imported"
    },
    "voice_207:r_2835a8af1c41be9b": {
      "text": "Don't laugh. You're the slow one.",
      "status": "imported"
    },
    "voice_207:r_cd84325a7c1a820f": {
      "text": "You're pretty good!",
      "status": "imported"
    },
    "voice_207:r_0465f74c0488ad70": {
      "text": "See?\\nAll that training paid off!",
      "status": "imported"
    },
    "voice_207:r_a30c8238b5208470": {
      "text": "Kouji! Stay sharp till they're done!",
      "status": "imported"
    },
    "voice_207:r_64bf1c63c7c1ebdd": {
      "text": "That hurt!\\nMazinger Z's power, huh?!",
      "status": "imported"
    },
    "voice_207:r_f6d5042f671118fa": {
      "text": "So you aren't just playing god!",
      "status": "imported"
    },
    "voice_207:r_0be18539fac21ba4": {
      "text": "Damn!\\nHades is pushing us back!",
      "status": "imported"
    },
    "voice_207:r_c05bd0cf089d667f": {
      "text": "Ngh! So we're facing certain death!",
      "status": "imported"
    },
    "voice_207:r_f69a0e1d0d67fd0e": {
      "text": "We've been here more than once!",
      "status": "imported"
    },
    "voice_207:r_c4e734ceafabd82c": {
      "text": "Right! We'll survive this time too!",
      "status": "imported"
    },
    "voice_207:r_62f1de6cdfb87024": {
      "text": "Ryouma, this is nearly the endgame.",
      "status": "imported"
    },
    "voice_207:r_7ecfe7ddfa4cdb6a": {
      "text": "Yeah. Let's see what training did!",
      "status": "imported"
    },
    "voice_207:r_d1be92a2ad355176": {
      "text": "Heh... Not bad, Kouji!",
      "status": "imported"
    },
    "voice_207:r_e0022ae8da32f998": {
      "text": "Gou... Any words for the player?",
      "status": "imported"
    },
    "voice_207:r_0ef83b6a1e87f6fd": {
      "text": "Heh... Good work, for you.",
      "status": "imported"
    },
    "voice_207:r_a8f0666c4d6d24a0": {
      "text": "Gou waits for you, and so do I.",
      "status": "imported"
    },
    "voice_207:r_3ec7c6e48027a853": {
      "text": "Show your training, Gou. Finish it.",
      "status": "imported"
    },
    "voice_207:r_953824ba6b607e1f": {
      "text": "Not bad, Gou. Speech drills worked.",
      "status": "imported"
    },
    "voice_207:r_d6c7a401f55ee42f": {
      "text": "Nice, Kouji. Love drills paid off.",
      "status": "imported"
    },
    "voice_207:r_7bce428a8c95c22c": {
      "text": "Yeah, looks that way.",
      "status": "imported"
    },
    "voice_207:r_c564bb4a57113de9": {
      "text": "Let's do this, Hayato, Benkei!",
      "status": "imported"
    },
    "voice_207:r_35d7693142bfac0c": {
      "text": "Open, Get!",
      "status": "imported"
    },
    "voice_207:r_a8ba71836345ee71": {
      "text": "Change, Getter 2!",
      "status": "imported"
    },
    "voice_207:r_bbce9cc348b5fec2": {
      "text": "Drill Hurricane!",
      "status": "imported"
    },
    "voice_207:r_6a33536cdb9e9c32": {
      "text": "Open Get!",
      "status": "imported"
    },
    "voice_207:r_93b13f545db4d55e": {
      "text": "Change, Getter 3!",
      "status": "imported"
    },
    "voice_207:r_49f278326a3ba3df": {
      "text": "Daisetsuzan Oroshiiii!",
      "status": "imported"
    },
    "voice_207:r_00d67eda0ca8bcac": {
      "text": "Open, Get!",
      "status": "imported"
    },
    "voice_207:r_cb6f5f32c512bd06": {
      "text": "Chaaange, Getter 1!",
      "status": "imported"
    },
    "voice_207:r_299353f629fec323": {
      "text": "Hayato! Benkei!\\nRemember, right?!",
      "status": "imported"
    },
    "voice_207:r_91cf32ef70b44e2d": {
      "text": "Heh...! Don't make me laugh!",
      "status": "imported"
    },
    "voice_207:r_1f7722403476a2d4": {
      "text": "Drill Hurricane!!",
      "status": "imported"
    },
    "voice_207:r_bb64cc3e79718d28": {
      "text": "Heh! My body's not forgotten!",
      "status": "imported"
    },
    "voice_207:r_01bbbb8099a5450a": {
      "text": "I'll make the first move!",
      "status": "imported"
    },
    "voice_207:r_7189bf28fe615b57": {
      "text": "I'll leave the final blow to you!",
      "status": "imported"
    },
    "voice_207:r_81088f48a48ca279": {
      "text": "My attack comes first!",
      "status": "imported"
    },
    "voice_207:r_b0eb4d47a01d2cc8": {
      "text": "Follow my lead and attack!",
      "status": "imported"
    },
    "voice_207:r_9de00ef7821f5fe6": {
      "text": "Leave this one to me!",
      "status": "imported"
    },
    "voice_207:r_811a3798e25c8ef3": {
      "text": "So you're my opponent!",
      "status": "imported"
    },
    "voice_207:r_c9e4c68bc52c16b8": {
      "text": "One-on-one? Just what I wanted!",
      "status": "imported"
    },
    "voice_207:r_31dedad2deed010c": {
      "text": "You're going to fight me!",
      "status": "imported"
    },
    "voice_207:r_68b64fdd6d26b6b1": {
      "text": "This one's mine!",
      "status": "imported"
    },
    "voice_207:r_7c53987b5bb3c03a": {
      "text": "I'll crush you first!",
      "status": "imported"
    },
    "voice_207:r_c2a98d67a013c156": {
      "text": "Let's settle this one-on-one!",
      "status": "imported"
    },
    "voice_207:r_6614839e46b17859": {
      "text": "I'll cut loose however I want!",
      "status": "imported"
    },
    "voice_207:r_20c452a7646f03eb": {
      "text": "I'll go first!",
      "status": "imported"
    }
  }
}
