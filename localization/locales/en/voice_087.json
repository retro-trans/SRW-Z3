{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_087:r_479b340ccc6c572b": {
      "text": "This is where I make my move...!",
      "status": "imported"
    },
    "voice_087:r_ca4acbac57a2a35e": {
      "text": "There must be a way...!",
      "status": "imported"
    },
    "voice_087:r_77949221bf58f862": {
      "text": "My senses are sharpening...!",
      "status": "imported"
    },
    "voice_087:r_70b9c4b9f1f37eff": {
      "text": "So hostility comes from there...!",
      "status": "imported"
    },
    "voice_087:r_9fcb3754cb1773c7": {
      "text": "I've made my own resolve!",
      "status": "imported"
    },
    "voice_087:r_3559d2fad32c2435": {
      "text": "I, Char Aznable, shall purge you!",
      "status": "imported"
    },
    "voice_087:r_f7570547e9f80a64": {
      "text": "The Earth can endure no longer!",
      "status": "imported"
    },
    "voice_087:r_cbab0f4720e1fcf1": {
      "text": "You gravity-bound fools...!",
      "status": "imported"
    },
    "voice_087:r_0bbe0b4f5364e732": {
      "text": "Why protect those ignorant fools?!",
      "status": "imported"
    },
    "voice_087:r_5dda5198137cb02a": {
      "text": "Earth's humans: fleas!\\nStill blind?!",
      "status": "imported"
    },
    "voice_087:r_83ec59afbecdec14": {
      "text": "I follow my own path! That is all!",
      "status": "imported"
    },
    "voice_087:r_e20bfd42ad95a3c9": {
      "text": "I believe people evolve in space!",
      "status": "imported"
    },
    "voice_087:r_0f58a8822381e57f": {
      "text": "Someone must bear\\nhumanity's sins!",
      "status": "imported"
    },
    "voice_087:r_6dbcc507fb61b51d": {
      "text": "An inherited will lives within me!",
      "status": "imported"
    },
    "voice_087:r_b42ab697149a7c8a": {
      "text": "We must eliminate the source of war!",
      "status": "imported"
    },
    "voice_087:r_4de4fcf3b440baf4": {
      "text": "If we refuse to change,\\nwar repeats!",
      "status": "imported"
    },
    "voice_087:r_0121a166c715cdff": {
      "text": "This machine and I still fight...!",
      "status": "imported"
    },
    "voice_087:r_30fad37a42bd3ad3": {
      "text": "We are both witnesses to war...!",
      "status": "imported"
    },
    "voice_087:r_80a0b2a84e05d81a": {
      "text": "An antique,\\nbut still battle-ready!",
      "status": "imported"
    },
    "voice_087:r_4a9ac1dff86506d9": {
      "text": "I'll settle this with my own hands!",
      "status": "imported"
    },
    "voice_087:r_bc8538e6af3d2577": {
      "text": "There's no time for repentance!",
      "status": "imported"
    },
    "voice_087:r_924516c8de2b5342": {
      "text": "Now, I believe humanity can evolve!",
      "status": "imported"
    },
    "voice_087:r_da1174533722333f": {
      "text": "I've cast aside all hesitation...!",
      "status": "imported"
    },
    "voice_087:r_fdeb8162976e72c1": {
      "text": "Cut strife's source! Then begin!",
      "status": "imported"
    },
    "voice_087:r_0fadb5c26df92b42": {
      "text": "If I still have a role to play...!",
      "status": "imported"
    },
    "voice_087:r_6b15af9a0057cdc8": {
      "text": "Even if they scorn me as a clown...!",
      "status": "imported"
    },
    "voice_087:r_15b4a90140e8a33a": {
      "text": "I'll simply do all I can right now!",
      "status": "imported"
    },
    "voice_087:r_af884a6b11dff121": {
      "text": "I trust the light in every heart!",
      "status": "imported"
    },
    "voice_087:r_ac6fe7838e95647b": {
      "text": "It's time to settle everything!",
      "status": "imported"
    },
    "voice_087:r_77ca87eacd17ad52": {
      "text": "This is the surest choice here!",
      "status": "imported"
    },
    "voice_087:r_bf3244994760e535": {
      "text": "Don't think you can dodge this!",
      "status": "imported"
    },
    "voice_087:r_aabfb21c9d069ce7": {
      "text": "We have the advantage in power!",
      "status": "imported"
    },
    "voice_087:r_a2df00f91a9b0a9e": {
      "text": "Hit!",
      "status": "imported"
    },
    "voice_087:r_8927e6fb681aa809": {
      "text": "Found you!!",
      "status": "imported"
    },
    "voice_087:r_a571eec59b258d11": {
      "text": "I won't let you!!",
      "status": "imported"
    },
    "voice_087:r_faae935cca0edc72": {
      "text": "You're mine!!",
      "status": "imported"
    },
    "voice_087:r_6ff1323b355593e0": {
      "text": "There!",
      "status": "imported"
    },
    "voice_087:r_36133ad73a73ef98": {
      "text": "Sink!!",
      "status": "imported"
    },
    "voice_087:r_a8451712c57c1a72": {
      "text": "Too slow!!",
      "status": "imported"
    },
    "voice_087:r_52dfc56b14b93551": {
      "text": "I'll land a direct hit!!",
      "status": "imported"
    },
    "voice_087:r_342044c706a2340f": {
      "text": "Don't interfere!",
      "status": "imported"
    },
    "voice_087:r_719e897304ec42d4": {
      "text": "Come on, hit!",
      "status": "imported"
    },
    "voice_087:r_5d08ad19e2da125b": {
      "text": "You're too soft!!",
      "status": "imported"
    },
    "voice_087:r_847f82e7f3eef651": {
      "text": "Right there!!",
      "status": "imported"
    },
    "voice_087:r_857c4a52ce8df0fd": {
      "text": "Not a chance!",
      "status": "imported"
    },
    "voice_087:r_8fdf5910927c9591": {
      "text": "I won't allow it!",
      "status": "imported"
    },
    "voice_087:r_b1de76a75a253c13": {
      "text": "Not yet!",
      "status": "imported"
    },
    "voice_087:r_128c35bf3e0e394c": {
      "text": "Siiink!!",
      "status": "imported"
    },
    "voice_087:r_620fedec67706d7d": {
      "text": "Let me finish this!",
      "status": "imported"
    },
    "voice_087:r_3dbeead1bd3164ef": {
      "text": "This ends now!!",
      "status": "imported"
    },
    "voice_087:r_46e86d000250e137": {
      "text": "It's not over yet!",
      "status": "imported"
    },
    "voice_087:r_ac341e7976e88f0b": {
      "text": "This will finish you!",
      "status": "imported"
    },
    "voice_087:r_cfccaa1fbeda124c": {
      "text": "Press the attack!",
      "status": "imported"
    },
    "voice_087:r_b1f8ec192b9c083a": {
      "text": "It's over!",
      "status": "imported"
    },
    "voice_087:r_de1213040856c089": {
      "text": "Sink now!!",
      "status": "imported"
    },
    "voice_087:r_1252db29683fefe0": {
      "text": "It seems you noticed too late...!",
      "status": "imported"
    },
    "voice_087:r_ad3d538f1e909184": {
      "text": "Survived that...!\\nThen take this!",
      "status": "imported"
    },
    "voice_087:r_8c61c59a1c0aebbf": {
      "text": "Amuro!",
      "status": "imported"
    },
    "voice_087:r_aba6a7662129d8ce": {
      "text": "Grant every fool\\nyour wisdom now!",
      "status": "imported"
    },
    "voice_087:r_b84afafb8a33ec60": {
      "text": "Lalah's death agony!\\nRecall it all!",
      "status": "imported"
    },
    "voice_087:r_c8c59db85bf875e6": {
      "text": "Wasting that power,\\ncan't you see?!",
      "status": "imported"
    },
    "voice_087:r_391aa56435d9dd6e": {
      "text": "Ra Cailum...! I'll send you down!",
      "status": "imported"
    },
    "voice_087:r_7c796ba53bd7ea03": {
      "text": "We both know what the other can do!",
      "status": "imported"
    },
    "voice_087:r_fa944da4b6519006": {
      "text": "Bright...! You read my movements?!",
      "status": "imported"
    },
    "voice_087:r_95d047bcc17fccc6": {
      "text": "You're too slow, Londo Bell!",
      "status": "imported"
    },
    "voice_087:r_640327a12a559b31": {
      "text": "Not the corrupt Earth Federation...!",
      "status": "imported"
    },
    "voice_087:r_bdd38c584fa313d0": {
      "text": "I won't allow that machine to exist!",
      "status": "imported"
    },
    "voice_087:r_3fd86c1027f317c8": {
      "text": "I won't be manipulated by Laplace!",
      "status": "imported"
    },
    "voice_087:r_d0372a183d2007ad": {
      "text": "I believed in potential once. But!",
      "status": "imported"
    },
    "voice_087:r_217aa5e1d545b44d": {
      "text": "So another one came from a lab?!",
      "status": "imported"
    },
    "voice_087:r_381992c5d8224937": {
      "text": "I am no longer the one you knew!",
      "status": "imported"
    },
    "voice_087:r_f1e7ed9e5874aba5": {
      "text": "If you can, try to stop me,\\nKamille!",
      "status": "imported"
    },
    "voice_087:r_fc25e66a86fc2c85": {
      "text": "Show the potential I saw,\\nKamille!",
      "status": "imported"
    },
    "voice_087:r_5aeeb4917340c42d": {
      "text": "Quattro Bajeena is\\nno more!",
      "status": "imported"
    },
    "voice_087:r_b765659981b6516d": {
      "text": "Lieutenant Emma...! If you attack!",
      "status": "imported"
    },
    "voice_087:r_0c427458bc00eb95": {
      "text": "Kats, stay back!",
      "status": "imported"
    },
    "voice_087:r_774a9ab4d8fd5351": {
      "text": "Haman!\\nWe too must settle this!",
      "status": "imported"
    },
    "voice_087:r_d3f01de714c015bd": {
      "text": "I still\\ncannot fall to you!",
      "status": "imported"
    },
    "voice_087:r_7d2617c809fead70": {
      "text": "My resolve is greater than yours!",
      "status": "imported"
    },
    "voice_087:r_ceb935ccbf830724": {
      "text": "If tragedy repeats,\\nthen stop me!",
      "status": "imported"
    },
    "voice_087:r_8ad40afecd02b41e": {
      "text": "So those too alike end up as foes.",
      "status": "imported"
    },
    "voice_087:r_26e5efec03c03d78": {
      "text": "I cannot allow you to exist!",
      "status": "imported"
    },
    "voice_087:r_4ad81e88c7557a8b": {
      "text": "I'll settle things with you myself!",
      "status": "imported"
    },
    "voice_087:r_1f65a7af190e4674": {
      "text": "Gyunei! Learn to discern the truth!",
      "status": "imported"
    },
    "voice_087:r_40c5a9358ed5bf29": {
      "text": "Blind faith in Frontal led to this?!",
      "status": "imported"
    },
    "voice_087:r_f2e18dfdfe0c89ea": {
      "text": "I am to blame\\nfor trapping you...!",
      "status": "imported"
    },
    "voice_087:r_cf7dbf49e96a5755": {
      "text": "Swayed by Frontal's delusions...!",
      "status": "imported"
    },
    "voice_087:r_fa96676cc65bb509": {
      "text": "Blind to events,\\nyou go extreme...!",
      "status": "imported"
    },
    "voice_087:r_4e37f92e7d2fc62e": {
      "text": "So you stand in my way, Gundam...!",
      "status": "imported"
    },
    "voice_087:r_66ab4cfe1557909d": {
      "text": "That machine...\\nI sense a bond...!",
      "status": "imported"
    },
    "voice_087:r_0bad405ee6ca63ba": {
      "text": "Some kind of improved Hyaku Shiki?!",
      "status": "imported"
    },
    "voice_087:r_2072eaf71a260ae7": {
      "text": "Why does it disturb my mind so...?",
      "status": "imported"
    },
    "voice_087:r_6c13bbfd27a7799e": {
      "text": "Understanding is why people fight!",
      "status": "imported"
    },
    "voice_087:r_06f88dcbd3c9e738": {
      "text": "Show all humanity evolution's power!",
      "status": "imported"
    },
    "voice_087:r_b28faf9f71bc3598": {
      "text": "To evolve, destroy the old order!",
      "status": "imported"
    },
    "voice_087:r_45abf84f7757d6eb": {
      "text": "Hope remains!\\nHumanity endures!",
      "status": "imported"
    },
    "voice_087:r_8165e5b41f0124c4": {
      "text": "Humanity can stand against disaster!",
      "status": "imported"
    },
    "voice_087:r_a60b107ea3c36a86": {
      "text": "I fight all who stifle evolution!",
      "status": "imported"
    },
    "voice_087:r_e33693e5ba4665b0": {
      "text": "Witness the end of rule by force!",
      "status": "imported"
    },
    "voice_087:r_72a21a1a489af001": {
      "text": "World's rot.\\nChar Aznable purges it!",
      "status": "imported"
    },
    "voice_087:r_eb643f8bf737a0ca": {
      "text": "Lalah, guide me...!",
      "status": "imported"
    },
    "voice_087:r_0a3fccb71ec6cf2a": {
      "text": "New age creator:\\nneither you nor I!",
      "status": "imported"
    },
    "voice_087:r_9b63cf1f3e0207ef": {
      "text": "You will all\\nanswer for this war!",
      "status": "imported"
    },
    "voice_087:r_8356f4e3dcdff938": {
      "text": "Future chosen.\\nNow I purge you!",
      "status": "imported"
    },
    "voice_087:r_1d6d784036ae0bd7": {
      "text": "Use Beam Confuse!",
      "status": "imported"
    },
    "voice_087:r_625664af02183c17": {
      "text": "Go! Funnel!!",
      "status": "imported"
    },
    "voice_087:r_63f429c5c68c0863": {
      "text": "Funnel!!",
      "status": "imported"
    },
    "voice_087:r_98ed411352a3a6ac": {
      "text": "Can you do it?!",
      "status": "imported"
    },
    "voice_087:r_4824bea6bab3af67": {
      "text": "Go! Fin Funnel!!",
      "status": "imported"
    },
    "voice_087:r_cb306ef55e49d107": {
      "text": "I won't allow any more!",
      "status": "imported"
    },
    "voice_087:r_57b2bd2de8a1408d": {
      "text": "Fin Funnel!!",
      "status": "imported"
    },
    "voice_087:r_0bc8ae32a406ceab": {
      "text": "The wills gathered through Zeta...!",
      "status": "imported"
    },
    "voice_087:r_82c09f011d703b2c": {
      "text": "That power!!",
      "status": "imported"
    },
    "voice_087:r_b57d2d74233f889a": {
      "text": "I'll finish you with my saber!",
      "status": "imported"
    },
    "voice_087:r_e09b933e3e706779": {
      "text": "I won't just accept our destruction!",
      "status": "imported"
    },
    "voice_087:r_a25bf2676ecf9d83": {
      "text": "You will not escape!",
      "status": "imported"
    },
    "voice_087:r_237a0288b42dce20": {
      "text": "Coming to me was a mistake!",
      "status": "imported"
    },
    "voice_087:r_0556e8a22779ea8e": {
      "text": "Bold of you to attack, but...!",
      "status": "imported"
    },
    "voice_087:r_09d377101a48d92a": {
      "text": "Allow me to counterattack!",
      "status": "imported"
    },
    "voice_087:r_11517cc7b0494dbf": {
      "text": "You should've quietly withdrawn...!",
      "status": "imported"
    },
    "voice_087:r_b5864501463db244": {
      "text": "You started this. I'll face you!",
      "status": "imported"
    },
    "voice_087:r_a88939ea84b4474d": {
      "text": "I've seen what you can do.",
      "status": "imported"
    },
    "voice_087:r_a870d0cf7cc11ec6": {
      "text": "You're doing fine work.",
      "status": "imported"
    },
    "voice_087:r_03f6158ef83964f3": {
      "text": "Just like that girl...",
      "status": "imported"
    },
    "voice_087:r_2970a83693cdcc25": {
      "text": "Good girl, Quess.",
      "status": "imported"
    },
    "voice_087:r_be661448b85d0009": {
      "text": "Well done, Gyunei.",
      "status": "imported"
    },
    "voice_087:r_958a56c1151cab9e": {
      "text": "It's like looking at myself...",
      "status": "imported"
    },
    "voice_087:r_8b18aa4cc69547df": {
      "text": "You have good instincts, Banagher.",
      "status": "imported"
    },
    "voice_087:r_3e87f6fc3ea65aef": {
      "text": "Captain Otto, I'll cover you.",
      "status": "imported"
    },
    "voice_087:r_5508a7bfa9074eb9": {
      "text": "Your resolve alone is enough.",
      "status": "imported"
    },
    "voice_087:r_09a003e91f0d5dc7": {
      "text": "I'll take care of things here.",
      "status": "imported"
    },
    "voice_087:r_192447448ebd7bb5": {
      "text": "Weren't you going to protect me?",
      "status": "imported"
    },
    "voice_087:r_e92920ba4b301b9f": {
      "text": "Stay back, Quess.",
      "status": "imported"
    },
    "voice_087:r_207b256d613bb896": {
      "text": "That's enough, Gyunei.",
      "status": "imported"
    },
    "voice_087:r_a6fd676d8146501b": {
      "text": "You are needed by Neo Zeon.",
      "status": "imported"
    },
    "voice_087:r_94d35e5fa8e3a198": {
      "text": "You guard Mineva. I'll guard you.",
      "status": "imported"
    },
    "voice_087:r_b686510e636673f3": {
      "text": "Captain! Get Nahel Argama back!",
      "status": "imported"
    },
    "voice_087:r_59369bad143d4272": {
      "text": "You're too costly\\nto let die.",
      "status": "imported"
    },
    "voice_087:r_25f9b1e39dd8d366": {
      "text": "I will not let them take Rewloola.",
      "status": "imported"
    },
    "voice_087:r_307477bedd148060": {
      "text": "Can't counter... This is a problem.",
      "status": "imported"
    },
    "voice_087:r_09a780acca0eb4b0": {
      "text": "You read the flow of battle well...!",
      "status": "imported"
    },
    "voice_087:r_af62f2ee466b5c8c": {
      "text": "Evade and lure them\\ninto our range!",
      "status": "imported"
    },
    "voice_087:r_20cfb719db02fafd": {
      "text": "That will not be enough...!",
      "status": "imported"
    },
    "voice_087:r_570c1fdf72edb283": {
      "text": "Battlefield jokes are not amusing.",
      "status": "imported"
    },
    "voice_087:r_23f0d87a5a6cfca1": {
      "text": "It seems you've underestimated me.",
      "status": "imported"
    },
    "voice_087:r_60c94ea4eb7f7404": {
      "text": "You hardly seem an amateur.",
      "status": "imported"
    },
    "voice_087:r_727b2ee0277f9159": {
      "text": "I won't let this go as you planned.",
      "status": "imported"
    },
    "voice_087:r_cff4d2eae8a939ed": {
      "text": "A petty attack, just like you.",
      "status": "imported"
    },
    "voice_087:r_1428fe5f35a9427b": {
      "text": "How young...!",
      "status": "imported"
    },
    "voice_087:r_96d39b8bdfa6f183": {
      "text": "If only you weren't here...!",
      "status": "imported"
    },
    "voice_087:r_0e4f9b8a2d26ebff": {
      "text": "Haman! I cannot fall to you...!",
      "status": "imported"
    },
    "voice_087:r_79e0d542fe12bcf7": {
      "text": "I believe I know your every move!",
      "status": "imported"
    },
    "voice_087:r_eff747ba39a55393": {
      "text": "Exactly the attack I expected...!",
      "status": "imported"
    },
    "voice_087:r_b2dc77aa6dd77e69": {
      "text": "Stop resisting!\\nThis is pointless!",
      "status": "imported"
    },
    "voice_087:r_445d40d8b5d7092b": {
      "text": "Seeking release\\nfor old hatred...!?",
      "status": "imported"
    },
    "voice_087:r_c894e35becf35a03": {
      "text": "It is futile.",
      "status": "imported"
    },
    "voice_087:r_e9a11621911acb19": {
      "text": "So you must rely on equipment...!",
      "status": "imported"
    },
    "voice_087:r_d52bece55796f599": {
      "text": "That will not stop me.",
      "status": "imported"
    },
    "voice_087:r_358fe5a50bbee1df": {
      "text": "The machine shows no sign of damage.",
      "status": "imported"
    },
    "voice_087:r_638834e16724002f": {
      "text": "Which is pathetic, machine or pilot?",
      "status": "imported"
    },
    "voice_087:r_b02fca1590ac1210": {
      "text": "I've become nothing but a clown...!",
      "status": "imported"
    },
    "voice_087:r_f0344d2fbaa9db77": {
      "text": "Momentum alone won't be enough...!",
      "status": "imported"
    },
    "voice_087:r_3328eef766ff2c2c": {
      "text": "No direct hit means no problem...!",
      "status": "imported"
    },
    "voice_087:r_23b037cf6ccc695c": {
      "text": "Impressive. Better than I expected.",
      "status": "imported"
    },
    "voice_087:r_883ad1128d340c5e": {
      "text": "Quite an intriguing attack, but...!",
      "status": "imported"
    },
    "voice_087:r_a9e6ed99025a703b": {
      "text": "You're as desperate as we are...!",
      "status": "imported"
    },
    "voice_087:r_b0d1459d6daeebbe": {
      "text": "Such a mistake, this late...!",
      "status": "imported"
    },
    "voice_087:r_cd4893b409472e97": {
      "text": "Damn...! Was my reaction too slow?!",
      "status": "imported"
    },
    "voice_087:r_5691cc71770ffdde": {
      "text": "Tch...! You read my movements...!",
      "status": "imported"
    },
    "voice_087:r_964e07c5563a5508": {
      "text": "Is this the privilege of youth...!?",
      "status": "imported"
    },
    "voice_087:r_db54e717bff3e3b2": {
      "text": "Amuro, I won't allow any more!",
      "status": "imported"
    },
    "voice_087:r_fcab8d80aef7e9d8": {
      "text": "Impressive, Bright...!",
      "status": "imported"
    },
    "voice_087:r_2174bd0edc164171": {
      "text": "Kamille...! Beyond my expectations?!",
      "status": "imported"
    },
    "voice_087:r_ad54419336b49578": {
      "text": "You show me a new possibility...!",
      "status": "imported"
    },
    "voice_087:r_63c353e1e05e8e39": {
      "text": "So this is Haman's pressure...!",
      "status": "imported"
    },
    "voice_087:r_87646dd472438e88": {
      "text": "So that's it...!\\nMy other self!",
      "status": "imported"
    },
    "voice_087:r_4e32ac89cba02001": {
      "text": "Am I also a target for purging...!?",
      "status": "imported"
    },
    "voice_087:r_02d24e5915bfa5b7": {
      "text": "Frontal manipulated me this far...!",
      "status": "imported"
    },
    "voice_087:r_02e1c5e19de5bd22": {
      "text": "Else I came here for nothing...!",
      "status": "imported"
    },
    "voice_087:r_6fb823898811e210": {
      "text": "I knew you'd be the main obstacle!",
      "status": "imported"
    },
    "voice_087:r_5dcbcf1682cc3ab8": {
      "text": "My power won't increase...!?",
      "status": "imported"
    },
    "voice_087:r_5a20988e743dc1d0": {
      "text": "A direct hit?! What are you doing?!",
      "status": "imported"
    },
    "voice_087:r_197f05bf899b7697": {
      "text": "I must grasp the exact situation...!",
      "status": "imported"
    },
    "voice_087:r_623ee03bd91ab2a1": {
      "text": "So they're desperate too...!",
      "status": "imported"
    },
    "voice_087:r_c5c491f8761152f0": {
      "text": "This power...!\\nIt can stop even me?!",
      "status": "imported"
    },
    "voice_087:r_15042263763f11bb": {
      "text": "Grief spreads,\\ncrushing the Earth!",
      "status": "imported"
    },
    "voice_087:r_96b3a8f080aea8b4": {
      "text": "I must judge myself\\nand atone...!",
      "status": "imported"
    },
    "voice_087:r_cdfaf9cd1fd55c77": {
      "text": "This much... I'll withdraw for now!",
      "status": "imported"
    },
    "voice_087:r_3d2454ac7a0fed22": {
      "text": "Damn! This accomplishes nothing!",
      "status": "imported"
    },
    "voice_087:r_437f5e90c3bb0592": {
      "text": "Not yet...!\\nMy duty isn't done!",
      "status": "imported"
    },
    "voice_087:r_cf9a2e6954ba3564": {
      "text": "Youthful mistakes are hard to admit.",
      "status": "imported"
    },
    "voice_087:r_a9474d20d8dd3193": {
      "text": "That man grew up, and he changed.",
      "status": "imported"
    },
    "voice_087:r_d1b635ea0c0c2d67": {
      "text": "But some things remain eternal.",
      "status": "imported"
    },
    "voice_087:r_b8b0c93fd828bea6": {
      "text": "Super Robot Wars: player passion...",
      "status": "imported"
    },
    "voice_087:r_eb6326b22b74aaf5": {
      "text": "I believe their passion saves Earth.",
      "status": "imported"
    },
    "voice_087:r_4561a1a3695f1597": {
      "text": "And so, new trials await them there.",
      "status": "imported"
    },
    "voice_087:r_e756cef3d5de51e9": {
      "text": "Meet again in Super Robot Wars Z3.",
      "status": "imported"
    },
    "voice_087:r_2bb2a166baa517b9": {
      "text": "I'll bring this into close combat!",
      "status": "imported"
    },
    "voice_087:r_34be00b434b42bea": {
      "text": "Allow me to end this now!",
      "status": "imported"
    },
    "voice_087:r_5b9baad61908571a": {
      "text": "I'll launch a direct attack!",
      "status": "imported"
    },
    "voice_087:r_7eedcce1036b4f4a": {
      "text": "Ooooh!",
      "status": "imported"
    },
    "voice_087:r_81a6bca77bc301c0": {
      "text": "Our firepower\\nsinks them in one hit!",
      "status": "imported"
    },
    "voice_087:r_febe65de885f155a": {
      "text": "That's what makes you my rival!",
      "status": "imported"
    },
    "voice_087:r_c081014541c22ae4": {
      "text": "As expected of you, Kamille...!",
      "status": "imported"
    },
    "voice_087:r_3840c01b1a9bf34b": {
      "text": "Lieutenant Emma, don't overdo it!",
      "status": "imported"
    },
    "voice_087:r_f03ef5034d024e8e": {
      "text": "I'll aid you once more, Haman!",
      "status": "imported"
    },
    "voice_087:r_bc1a77b291081b0f": {
      "text": "Too slow, Amuro!",
      "status": "imported"
    },
    "voice_087:r_94089c60b94d9a81": {
      "text": "Get some distance, Kamille!",
      "status": "imported"
    },
    "voice_087:r_56edc0d4b579afd1": {
      "text": "Lieutenant Emma, fall back for now!",
      "status": "imported"
    },
    "voice_087:r_42c897bd608f37fd": {
      "text": "A careless lapse, unlike you, Haman!",
      "status": "imported"
    },
    "voice_087:r_689700a088dc2f5b": {
      "text": "I'll keep them in check!",
      "status": "imported"
    },
    "voice_087:r_5a1e097aa0ec9859": {
      "text": "Concentrate our attacks!",
      "status": "imported"
    },
    "voice_087:r_2a8d41aa8f4749ec": {
      "text": "Follow my lead!",
      "status": "imported"
    },
    "voice_087:r_01c80710474b30ae": {
      "text": "We'll attack in tandem!",
      "status": "imported"
    },
    "voice_087:r_870a7c766b4e2144": {
      "text": "I'll force a one-on-one fight!",
      "status": "imported"
    },
    "voice_087:r_a9f39df34c38f5b3": {
      "text": "Break up the enemy's teamwork!",
      "status": "imported"
    },
    "voice_087:r_c9f83672cc4c8866": {
      "text": "For now, I'll fulfill my role!",
      "status": "imported"
    },
    "voice_087:r_19631c3492e99773": {
      "text": "Cut that enemy away from its unit!",
      "status": "imported"
    }
  }
}
