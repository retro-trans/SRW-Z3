{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_209:r_479b340ccc6c572b": {
      "text": "...",
      "status": "imported"
    },
    "voice_209:r_ca4acbac57a2a35e": {
      "text": "I'll carry out my orders.",
      "status": "imported"
    },
    "voice_209:r_77949221bf58f862": {
      "text": "You're out of luck.",
      "status": "imported"
    },
    "voice_209:r_70b9c4b9f1f37eff": {
      "text": "This is my duty.",
      "status": "imported"
    },
    "voice_209:r_9fcb3754cb1773c7": {
      "text": "I'll finish this.",
      "status": "imported"
    },
    "voice_209:r_3559d2fad32c2435": {
      "text": "I'll take your soul.",
      "status": "imported"
    },
    "voice_209:r_f7570547e9f80a64": {
      "text": "Do not resist.",
      "status": "imported"
    },
    "voice_209:r_cbab0f4720e1fcf1": {
      "text": "I won't drag this out.",
      "status": "imported"
    },
    "voice_209:r_0bbe0b4f5364e732": {
      "text": "You've gone too far.",
      "status": "imported"
    },
    "voice_209:r_5dda5198137cb02a": {
      "text": "Not yet.",
      "status": "imported"
    },
    "voice_209:r_83ec59afbecdec14": {
      "text": "Then how about this?",
      "status": "imported"
    },
    "voice_209:r_0f58a8822381e57f": {
      "text": "You're the new\\nfeuding twin Reactor",
      "status": "imported"
    },
    "voice_209:r_6dbcc507fb61b51d": {
      "text": "Strange... What are you?",
      "status": "imported"
    },
    "voice_209:r_b42ab697149a7c8a": {
      "text": "I see. So that's how it is...",
      "status": "imported"
    },
    "voice_209:r_0121a166c715cdff": {
      "text": "You entered forbidden territory...",
      "status": "imported"
    },
    "voice_209:r_80a0b2a84e05d81a": {
      "text": "Beasts' blood...",
      "status": "imported"
    },
    "voice_209:r_4a9ac1dff86506d9": {
      "text": "Mingling waters...",
      "status": "imported"
    },
    "voice_209:r_bc8538e6af3d2577": {
      "text": "The wind's path...",
      "status": "imported"
    },
    "voice_209:r_924516c8de2b5342": {
      "text": "Civilization's fire...",
      "status": "imported"
    },
    "voice_209:r_fdeb8162976e72c1": {
      "text": "The god of light sides with you.",
      "status": "imported"
    },
    "voice_209:r_0fadb5c26df92b42": {
      "text": "Getter Rays, of all things...",
      "status": "imported"
    },
    "voice_209:r_15b4a90140e8a33a": {
      "text": "Steal!",
      "status": "imported"
    },
    "voice_209:r_af884a6b11dff121": {
      "text": "This is the last light you'll see.",
      "status": "imported"
    },
    "voice_209:r_ac6fe7838e95647b": {
      "text": "Vanish into the light.",
      "status": "imported"
    },
    "voice_209:r_77ca87eacd17ad52": {
      "text": "This is the gate of death.",
      "status": "imported"
    },
    "voice_209:r_bf3244994760e535": {
      "text": "Depart for eternity.",
      "status": "imported"
    },
    "voice_209:r_aabfb21c9d069ce7": {
      "text": "Open, Shigokumon!",
      "status": "imported"
    },
    "voice_209:r_a7246b52782a877e": {
      "text": "Then...",
      "status": "imported"
    },
    "voice_209:r_dc8701f6bcb9904f": {
      "text": "Is it my turn?",
      "status": "imported"
    },
    "voice_209:r_d6bdd730f24f66eb": {
      "text": "Switch with me.",
      "status": "imported"
    },
    "voice_209:r_41997412868c48c4": {
      "text": "This is the natural order.",
      "status": "imported"
    },
    "voice_209:r_9e6cf4f389dae55c": {
      "text": "Move.",
      "status": "imported"
    },
    "voice_209:r_9e0c80ac7e33b459": {
      "text": "Don't make this difficult.",
      "status": "imported"
    },
    "voice_209:r_47d52a2839c71715": {
      "text": "Have you given up...?",
      "status": "imported"
    },
    "voice_209:r_847f82e7f3eef651": {
      "text": "So such things can happen.",
      "status": "imported"
    },
    "voice_209:r_eb7ae28b53dc033c": {
      "text": "It's pointless.",
      "status": "imported"
    },
    "voice_209:r_857c4a52ce8df0fd": {
      "text": "Just as I thought.",
      "status": "imported"
    },
    "voice_209:r_55417493fce1d347": {
      "text": "How feeble.",
      "status": "imported"
    },
    "voice_209:r_8fdf5910927c9591": {
      "text": "Give it up.",
      "status": "imported"
    },
    "voice_209:r_7d724dbcc4451e10": {
      "text": "That's enough.",
      "status": "imported"
    },
    "voice_209:r_93e25418a203cb8f": {
      "text": "Understood.",
      "status": "imported"
    },
    "voice_209:r_adeb0a29274d3d9b": {
      "text": "Accept the outcome.",
      "status": "imported"
    },
    "voice_209:r_24cf161287ef9d5c": {
      "text": "Do you understand now?",
      "status": "imported"
    },
    "voice_209:r_8f60f6fc86db3107": {
      "text": "You still have a long way to go.",
      "status": "imported"
    },
    "voice_209:r_b1de76a75a253c13": {
      "text": "This won't get you recruited.",
      "status": "imported"
    },
    "voice_209:r_cdbd128a5b4127cc": {
      "text": "It's pointless.",
      "status": "imported"
    },
    "voice_209:r_cfccaa1fbeda124c": {
      "text": "How feeble.",
      "status": "imported"
    },
    "voice_209:r_b1f8ec192b9c083a": {
      "text": "Accept the outcome.",
      "status": "imported"
    },
    "voice_209:r_3304412ac41f47a6": {
      "text": "I see...",
      "status": "imported"
    },
    "voice_209:r_0c0775e051211840": {
      "text": "Now I understand.",
      "status": "imported"
    },
    "voice_209:r_a2afffe1c396f0b3": {
      "text": "So close.",
      "status": "imported"
    },
    "voice_209:r_13c25fbdfddc8a24": {
      "text": "That was a good attack.",
      "status": "imported"
    },
    "voice_209:r_42ba1ecb310b4bd7": {
      "text": "Do you wish for death?",
      "status": "imported"
    },
    "voice_209:r_d692f1d420460a47": {
      "text": "There's no turning back now...",
      "status": "imported"
    },
    "voice_209:r_a5643cec86b18bd2": {
      "text": "You have no future.",
      "status": "imported"
    },
    "voice_209:r_68f2dfab20a4a30e": {
      "text": "So this is the answer...",
      "status": "imported"
    },
    "voice_209:r_9cedad8237480563": {
      "text": "You seem to be a work in progress.",
      "status": "imported"
    },
    "voice_209:r_a03fabecba1508ca": {
      "text": "I see... Hope and despair...",
      "status": "imported"
    },
    "voice_209:r_70451ffbabe2f876": {
      "text": "With this, my work is finished.",
      "status": "imported"
    },
    "voice_209:r_69dfa1659715e2fa": {
      "text": "So this is how things turned out.",
      "status": "imported"
    }
  }
}
