{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_088:r_479b340ccc6c572b": {
      "text": "...",
      "status": "imported"
    },
    "voice_088:r_ca4acbac57a2a35e": {
      "text": "A sensor contact.",
      "status": "imported"
    },
    "voice_088:r_77949221bf58f862": {
      "text": "Something smells off.",
      "status": "imported"
    },
    "voice_088:r_70b9c4b9f1f37eff": {
      "text": "I'll take you down here.",
      "status": "imported"
    },
    "voice_088:r_9fcb3754cb1773c7": {
      "text": "I see you.",
      "status": "imported"
    },
    "voice_088:r_3559d2fad32c2435": {
      "text": "I'm going in.",
      "status": "imported"
    },
    "voice_088:r_f7570547e9f80a64": {
      "text": "Time to use brute force.",
      "status": "imported"
    },
    "voice_088:r_cbab0f4720e1fcf1": {
      "text": "So that's where you are.",
      "status": "imported"
    },
    "voice_088:r_0bbe0b4f5364e732": {
      "text": "One more time.",
      "status": "imported"
    },
    "voice_088:r_5dda5198137cb02a": {
      "text": "You're human garbage.",
      "status": "imported"
    },
    "voice_088:r_83ec59afbecdec14": {
      "text": "You're like a sand mole.",
      "status": "imported"
    },
    "voice_088:r_e20bfd42ad95a3c9": {
      "text": "As a Quent,\\nI won't allow it.",
      "status": "imported"
    },
    "voice_088:r_0fadb5c26df92b42": {
      "text": "Hah!",
      "status": "imported"
    },
    "voice_088:r_6b15af9a0057cdc8": {
      "text": "Hnng!",
      "status": "imported"
    },
    "voice_088:r_15b4a90140e8a33a": {
      "text": "Hmph!",
      "status": "imported"
    },
    "voice_088:r_af884a6b11dff121": {
      "text": "Taaah!",
      "status": "imported"
    },
    "voice_088:r_faae935cca0edc72": {
      "text": "You're too slow to withdraw.",
      "status": "imported"
    },
    "voice_088:r_d4430bf362340b32": {
      "text": "I'll counterattack.",
      "status": "imported"
    },
    "voice_088:r_6ff1323b355593e0": {
      "text": "You won't escape!",
      "status": "imported"
    },
    "voice_088:r_b7b5625d7cd4282f": {
      "text": "It's my turn.",
      "status": "imported"
    },
    "voice_088:r_36133ad73a73ef98": {
      "text": "I'll handle it.",
      "status": "imported"
    },
    "voice_088:r_920740a0219c5085": {
      "text": "I'll cover you.",
      "status": "imported"
    },
    "voice_088:r_a8451712c57c1a72": {
      "text": "Chirico, leave the rest to me.",
      "status": "imported"
    },
    "voice_088:r_3633df5b7b8f47fa": {
      "text": "Take cover behind me.",
      "status": "imported"
    },
    "voice_088:r_52dfc56b14b93551": {
      "text": "I can at least take their fire.",
      "status": "imported"
    },
    "voice_088:r_1b9b2aab5cb104da": {
      "text": "Fall back, Chirico.",
      "status": "imported"
    },
    "voice_088:r_342044c706a2340f": {
      "text": "Unable to attack, huh.",
      "status": "imported"
    },
    "voice_088:r_cf41e8828a90cbdb": {
      "text": "This doesn't look good.",
      "status": "imported"
    },
    "voice_088:r_d5e0a2317c40d322": {
      "text": "Too slow.",
      "status": "imported"
    },
    "voice_088:r_ec2ea17765052401": {
      "text": "So that's your move.",
      "status": "imported"
    },
    "voice_088:r_f2d4255f1c2f7542": {
      "text": "Thanks to this Quent-made sensor.",
      "status": "imported"
    },
    "voice_088:r_5d08ad19e2da125b": {
      "text": "No problem at all.",
      "status": "imported"
    },
    "voice_088:r_41997412868c48c4": {
      "text": "You're weak.",
      "status": "imported"
    },
    "voice_088:r_9e6cf4f389dae55c": {
      "text": "Did that hit?",
      "status": "imported"
    },
    "voice_088:r_9e0c80ac7e33b459": {
      "text": "Is that all?",
      "status": "imported"
    },
    "voice_088:r_7432ef43ed3471dc": {
      "text": "Not even worth worrying about.",
      "status": "imported"
    },
    "voice_088:r_47d52a2839c71715": {
      "text": "Ungh...!",
      "status": "imported"
    },
    "voice_088:r_847f82e7f3eef651": {
      "text": "Not bad.",
      "status": "imported"
    },
    "voice_088:r_eb7ae28b53dc033c": {
      "text": "I'm still all right.",
      "status": "imported"
    },
    "voice_088:r_857c4a52ce8df0fd": {
      "text": "I can't let my guard down.",
      "status": "imported"
    },
    "voice_088:r_8fdf5910927c9591": {
      "text": "Ngh...!",
      "status": "imported"
    },
    "voice_088:r_7d724dbcc4451e10": {
      "text": "What...!?",
      "status": "imported"
    },
    "voice_088:r_93e25418a203cb8f": {
      "text": "This is bad...",
      "status": "imported"
    },
    "voice_088:r_adeb0a29274d3d9b": {
      "text": "The machine can still move.",
      "status": "imported"
    },
    "voice_088:r_24cf161287ef9d5c": {
      "text": "I'm ejecting.",
      "status": "imported"
    },
    "voice_088:r_8f60f6fc86db3107": {
      "text": "I can't go any further...",
      "status": "imported"
    },
    "voice_088:r_b1de76a75a253c13": {
      "text": "I'll go.",
      "status": "imported"
    },
    "voice_088:r_38fdff9483e9245c": {
      "text": "So you haven't fled yet.",
      "status": "imported"
    },
    "voice_088:r_620fedec67706d7d": {
      "text": "I can see right through you.",
      "status": "imported"
    },
    "voice_088:r_9680dcd0fddcfcc7": {
      "text": "I'll go on ahead.",
      "status": "imported"
    },
    "voice_088:r_2a00f1044ad5cbaa": {
      "text": "Understood.",
      "status": "imported"
    },
    "voice_088:r_3dbeead1bd3164ef": {
      "text": "Target confirmed.",
      "status": "imported"
    },
    "voice_088:r_98d15b8cc09bc915": {
      "text": "Ru Shako, roger.",
      "status": "imported"
    },
    "voice_088:r_46e86d000250e137": {
      "text": "Got it.",
      "status": "imported"
    }
  }
}
