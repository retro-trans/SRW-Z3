{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_196:r_479b340ccc6c572b": {
      "text": "There!",
      "status": "imported"
    },
    "voice_196:r_77949221bf58f862": {
      "text": "How's that!",
      "status": "imported"
    },
    "voice_196:r_70b9c4b9f1f37eff": {
      "text": "I'll smash you into the ground!",
      "status": "imported"
    },
    "voice_196:r_9fcb3754cb1773c7": {
      "text": "Your life is mine!",
      "status": "imported"
    },
    "voice_196:r_3559d2fad32c2435": {
      "text": "This is where you'll meet your end!",
      "status": "imported"
    },
    "voice_196:r_f7570547e9f80a64": {
      "text": "Fool! You're wide open!",
      "status": "imported"
    },
    "voice_196:r_cbab0f4720e1fcf1": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_196:r_0bbe0b4f5364e732": {
      "text": "My psychic power will crush you!",
      "status": "imported"
    },
    "voice_196:r_5dda5198137cb02a": {
      "text": "I can sense what's in your heart!",
      "status": "imported"
    },
    "voice_196:r_83ec59afbecdec14": {
      "text": "Behold my psychic power!",
      "status": "imported"
    },
    "voice_196:r_e20bfd42ad95a3c9": {
      "text": "Know the terror of a psychic!",
      "status": "imported"
    },
    "voice_196:r_0f58a8822381e57f": {
      "text": "Prepare yourself, Mars!",
      "status": "imported"
    },
    "voice_196:r_6dbcc507fb61b51d": {
      "text": "If Mars falls, Earth is finished!",
      "status": "imported"
    },
    "voice_196:r_b42ab697149a7c8a": {
      "text": "Mars! You are destined to die!",
      "status": "imported"
    },
    "voice_196:r_4de4fcf3b440baf4": {
      "text": "If Godmars falls, victory is ours!",
      "status": "imported"
    },
    "voice_196:r_0121a166c715cdff": {
      "text": "I'll dispose of Mars's allies first!",
      "status": "imported"
    },
    "voice_196:r_30fad37a42bd3ad3": {
      "text": "Roze! You wretched traitor!",
      "status": "imported"
    },
    "voice_196:r_80a0b2a84e05d81a": {
      "text": "Let's settle this, Gundam!",
      "status": "imported"
    },
    "voice_196:r_4a9ac1dff86506d9": {
      "text": "I'll scatter you puny little mechs!",
      "status": "imported"
    },
    "voice_196:r_bc8538e6af3d2577": {
      "text": "Damn you, buzzing around like flies!",
      "status": "imported"
    },
    "voice_196:r_924516c8de2b5342": {
      "text": "Another combiner like Godmars?!",
      "status": "imported"
    },
    "voice_196:r_da1174533722333f": {
      "text": "Here I go! Counterattack!",
      "status": "imported"
    },
    "voice_196:r_fdeb8162976e72c1": {
      "text": "You hit me, so I'll hit you back!",
      "status": "imported"
    },
    "voice_196:r_0fadb5c26df92b42": {
      "text": "This is payback for earlier!",
      "status": "imported"
    },
    "voice_196:r_6b15af9a0057cdc8": {
      "text": "You won't escape!",
      "status": "imported"
    },
    "voice_196:r_15b4a90140e8a33a": {
      "text": "Still hanging around there?!",
      "status": "imported"
    },
    "voice_196:r_af884a6b11dff121": {
      "text": "This will finish you!",
      "status": "imported"
    },
    "voice_196:r_ac6fe7838e95647b": {
      "text": "Don't think you'll return safely!",
      "status": "imported"
    },
    "voice_196:r_77ca87eacd17ad52": {
      "text": "One more strike!",
      "status": "imported"
    },
    "voice_196:r_bf3244994760e535": {
      "text": "I can still fight!",
      "status": "imported"
    },
    "voice_196:r_aabfb21c9d069ce7": {
      "text": "I'll cover you!",
      "status": "imported"
    },
    "voice_196:r_02479dc8fe989560": {
      "text": "Then I'll attack from here too!",
      "status": "imported"
    },
    "voice_196:r_a2df00f91a9b0a9e": {
      "text": "Withdraw while you still can!",
      "status": "imported"
    },
    "voice_196:r_48b60d6c48b9b142": {
      "text": "I'll draw the enemy away!",
      "status": "imported"
    },
    "voice_196:r_8927e6fb681aa809": {
      "text": "I'll block it!",
      "status": "imported"
    },
    "voice_196:r_665f01666859013b": {
      "text": "Damn it! I can't counterattack?!",
      "status": "imported"
    },
    "voice_196:r_a571eec59b258d11": {
      "text": "I can't do anything like this!",
      "status": "imported"
    },
    "voice_196:r_ddbe581c5ea9183d": {
      "text": "I'm defenseless at this rate!",
      "status": "imported"
    },
    "voice_196:r_faae935cca0edc72": {
      "text": "Damn, my energy!",
      "status": "imported"
    },
    "voice_196:r_d4430bf362340b32": {
      "text": "I can't counter from this position!",
      "status": "imported"
    },
    "voice_196:r_6ff1323b355593e0": {
      "text": "I'm at a disadvantage at this range!",
      "status": "imported"
    },
    "voice_196:r_b7b5625d7cd4282f": {
      "text": "Too bad for you!",
      "status": "imported"
    },
    "voice_196:r_36133ad73a73ef98": {
      "text": "You missed!",
      "status": "imported"
    },
    "voice_196:r_920740a0219c5085": {
      "text": "What are you aiming at?!",
      "status": "imported"
    },
    "voice_196:r_a8451712c57c1a72": {
      "text": "I'm right here!",
      "status": "imported"
    },
    "voice_196:r_3633df5b7b8f47fa": {
      "text": "I see right through your thoughts!",
      "status": "imported"
    },
    "voice_196:r_52dfc56b14b93551": {
      "text": "This too is my psychic power!",
      "status": "imported"
    },
    "voice_196:r_1b9b2aab5cb104da": {
      "text": "Heh! I can sense your panic!",
      "status": "imported"
    },
    "voice_196:r_342044c706a2340f": {
      "text": "You're too naive, Mars!",
      "status": "imported"
    },
    "voice_196:r_cf41e8828a90cbdb": {
      "text": "A traitor's attack means nothing!",
      "status": "imported"
    },
    "voice_196:r_719e897304ec42d4": {
      "text": "Is that all?!",
      "status": "imported"
    },
    "voice_196:r_ec2ea17765052401": {
      "text": "Hmph. How feeble.",
      "status": "imported"
    },
    "voice_196:r_f2d4255f1c2f7542": {
      "text": "Damn! It grazed me?!",
      "status": "imported"
    },
    "voice_196:r_5d08ad19e2da125b": {
      "text": "Don't celebrate just for hitting me!",
      "status": "imported"
    },
    "voice_196:r_a7246b52782a877e": {
      "text": "That was nothing!",
      "status": "imported"
    },
    "voice_196:r_dc8701f6bcb9904f": {
      "text": "That won't faze a Fighting Mecha!",
      "status": "imported"
    },
    "voice_196:r_d6bdd730f24f66eb": {
      "text": "Don't take a Fighting Mecha lightly!",
      "status": "imported"
    },
    "voice_196:r_41997412868c48c4": {
      "text": "Is that all you've got, Mars?!",
      "status": "imported"
    },
    "voice_196:r_9e6cf4f389dae55c": {
      "text": "Mars! Is that your psychic power?!",
      "status": "imported"
    },
    "voice_196:r_9e0c80ac7e33b459": {
      "text": "I took a direct hit?!",
      "status": "imported"
    },
    "voice_196:r_7432ef43ed3471dc": {
      "text": "Damn! Where did that hit me?!",
      "status": "imported"
    },
    "voice_196:r_065443f6ddfcf0d7": {
      "text": "Grr! This is getting dangerous!",
      "status": "imported"
    },
    "voice_196:r_47d52a2839c71715": {
      "text": "Ggh! You'll pay for that!",
      "status": "imported"
    },
    "voice_196:r_847f82e7f3eef651": {
      "text": "How dare you hit my Fighting Mecha!",
      "status": "imported"
    },
    "voice_196:r_eb7ae28b53dc033c": {
      "text": "Ggh! Don't take this mecha lightly!",
      "status": "imported"
    },
    "voice_196:r_857c4a52ce8df0fd": {
      "text": "Damn you, Mars!",
      "status": "imported"
    },
    "voice_196:r_55417493fce1d347": {
      "text": "Mars! You of all people!",
      "status": "imported"
    },
    "voice_196:r_8fdf5910927c9591": {
      "text": "Tch! Impressive as ever, Mars!",
      "status": "imported"
    },
    "voice_196:r_7d724dbcc4451e10": {
      "text": "I can't retreat yet!",
      "status": "imported"
    },
    "voice_196:r_93e25418a203cb8f": {
      "text": "This can't go on!",
      "status": "imported"
    },
    "voice_196:r_adeb0a29274d3d9b": {
      "text": "Ggh! Is this a fatal wound?!",
      "status": "imported"
    },
    "voice_196:r_24cf161287ef9d5c": {
      "text": "So strong! What incredible strength!",
      "status": "imported"
    },
    "voice_196:r_8f60f6fc86db3107": {
      "text": "Gwaaagh! I-I'm done for!",
      "status": "imported"
    },
    "voice_196:r_b1de76a75a253c13": {
      "text": "Damn it! Don't get cocky!!",
      "status": "imported"
    },
    "voice_196:r_128c35bf3e0e394c": {
      "text": "Damn!\\nThey've cornered my mecha?!",
      "status": "imported"
    },
    "voice_196:r_5213c17e13b23de0": {
      "text": "Impossible! My Fighting Mecha!",
      "status": "imported"
    },
    "voice_196:r_38fdff9483e9245c": {
      "text": "Mars! Not until I've defeated you!",
      "status": "imported"
    },
    "voice_196:r_620fedec67706d7d": {
      "text": "Th-This is Super-A psychic power?!",
      "status": "imported"
    },
    "voice_196:r_9680dcd0fddcfcc7": {
      "text": "I-Impossible!!",
      "status": "imported"
    },
    "voice_196:r_2a00f1044ad5cbaa": {
      "text": "Uwaaaagh!!",
      "status": "imported"
    },
    "voice_196:r_3dbeead1bd3164ef": {
      "text": "D-Damn you!!",
      "status": "imported"
    },
    "voice_196:r_98d15b8cc09bc915": {
      "text": "D-Daaamn!!",
      "status": "imported"
    },
    "voice_196:r_46e86d000250e137": {
      "text": "Damn it! Uwaaaagh!!",
      "status": "imported"
    },
    "voice_196:r_ac341e7976e88f0b": {
      "text": "You too shall taste death's power!",
      "status": "imported"
    },
    "voice_196:r_cdbd128a5b4127cc": {
      "text": "Go to the world of darkness!",
      "status": "imported"
    },
    "voice_196:r_cfccaa1fbeda124c": {
      "text": "I'll teach you what despair means!",
      "status": "imported"
    },
    "voice_196:r_b1f8ec192b9c083a": {
      "text": "Bid farewell to this world!",
      "status": "imported"
    },
    "voice_196:r_a007f9ab9cf048b3": {
      "text": "Vanish into the dark world, Godmars!",
      "status": "imported"
    },
    "voice_196:r_ddafde4b065ced49": {
      "text": "This is Daedalos's dark power!",
      "status": "imported"
    },
    "voice_196:r_de1213040856c089": {
      "text": "Buffle sends you to death's realm!",
      "status": "imported"
    },
    "voice_196:r_3304412ac41f47a6": {
      "text": "Zedfiner, bury them!",
      "status": "imported"
    },
    "voice_196:r_5b9e8897190892eb": {
      "text": "Drop dead!",
      "status": "imported"
    },
    "voice_196:r_7bea3023abbf8a94": {
      "text": "I won't fall to the likes of you!",
      "status": "imported"
    },
    "voice_196:r_dd01a4c0d1b36a8d": {
      "text": "You are a blight upon the galaxy!",
      "status": "imported"
    },
    "voice_196:r_7847e0ed7dc9282d": {
      "text": "Coordinated attack!",
      "status": "imported"
    },
    "voice_196:r_e42b52c7a987b906": {
      "text": "This time, I'll finish you off!",
      "status": "imported"
    },
    "voice_196:r_6825fd1ff907bd22": {
      "text": "I-I've been beaten!!",
      "status": "imported"
    },
    "voice_196:r_607f666f1563bc0d": {
      "text": "I won't be defeated here!",
      "status": "imported"
    },
    "voice_196:r_97b7431eeb81e6b6": {
      "text": "Damn you! You loathsome wretch!",
      "status": "imported"
    },
    "voice_196:r_132f605d02975e71": {
      "text": "What's wrong? Is that all?",
      "status": "imported"
    },
    "voice_196:r_9b9726b1872759d6": {
      "text": "That barely counts as a scratch!",
      "status": "imported"
    },
    "voice_196:r_1252db29683fefe0": {
      "text": "Like that'll hit me!",
      "status": "imported"
    },
    "voice_196:r_ad3d538f1e909184": {
      "text": "You imbecile!",
      "status": "imported"
    },
    "voice_196:r_8c61c59a1c0aebbf": {
      "text": "Useless!",
      "status": "imported"
    },
    "voice_196:r_aba6a7662129d8ce": {
      "text": "As if that could work!",
      "status": "imported"
    },
    "voice_196:r_391aa56435d9dd6e": {
      "text": "I'll see you dead!",
      "status": "imported"
    },
    "voice_196:r_fa944da4b6519006": {
      "text": "I'll pay you back double!",
      "status": "imported"
    },
    "voice_196:r_95d047bcc17fccc6": {
      "text": "Leave this to me!",
      "status": "imported"
    },
    "voice_196:r_640327a12a559b31": {
      "text": "Leave it to me!",
      "status": "imported"
    },
    "voice_196:r_bdd38c584fa313d0": {
      "text": "Roger! Commencing attack!",
      "status": "imported"
    },
    "voice_196:r_3fd86c1027f317c8": {
      "text": "All right, let's go!",
      "status": "imported"
    },
    "voice_196:r_d0372a183d2007ad": {
      "text": "Roger! I'll give it everything!",
      "status": "imported"
    }
  }
}
