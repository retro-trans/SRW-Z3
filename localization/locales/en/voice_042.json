{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_042:r_479b340ccc6c572b": {
      "text": "I just want to go back...",
      "status": "imported"
    },
    "voice_042:r_77949221bf58f862": {
      "text": "Everything... back to that time...",
      "status": "imported"
    },
    "voice_042:r_70b9c4b9f1f37eff": {
      "text": "This world... is a piece of me...",
      "status": "imported"
    },
    "voice_042:r_9fcb3754cb1773c7": {
      "text": "Hazy memories\\nIt's Memory. It's me",
      "status": "imported"
    },
    "voice_042:r_3559d2fad32c2435": {
      "text": "I have no need for the present...",
      "status": "imported"
    },
    "voice_042:r_f7570547e9f80a64": {
      "text": "Do you believe\\nin this very world?",
      "status": "imported"
    },
    "voice_042:r_cbab0f4720e1fcf1": {
      "text": "I will... make the choice...",
      "status": "imported"
    },
    "voice_042:r_0bbe0b4f5364e732": {
      "text": "I will... reset the world...",
      "status": "imported"
    },
    "voice_042:r_5dda5198137cb02a": {
      "text": "I... learned the truth...",
      "status": "imported"
    },
    "voice_042:r_83ec59afbecdec14": {
      "text": "In this world... I...",
      "status": "imported"
    },
    "voice_042:r_e20bfd42ad95a3c9": {
      "text": "There's no place left for me...",
      "status": "imported"
    },
    "voice_042:r_0f58a8822381e57f": {
      "text": "There's nothing more to grieve...",
      "status": "imported"
    },
    "voice_042:r_6dbcc507fb61b51d": {
      "text": "Over and over... Over and over...",
      "status": "imported"
    },
    "voice_042:r_b42ab697149a7c8a": {
      "text": "Let's meet again, Roger...",
      "status": "imported"
    },
    "voice_042:r_4de4fcf3b440baf4": {
      "text": "Roger... what do you wish for?",
      "status": "imported"
    },
    "voice_042:r_0121a166c715cdff": {
      "text": "Yes... so you're an angel too...",
      "status": "imported"
    },
    "voice_042:r_30fad37a42bd3ad3": {
      "text": "You're the same... as Big Venus...",
      "status": "imported"
    },
    "voice_042:r_80a0b2a84e05d81a": {
      "text": "Humans evolve\\nEven without Memory",
      "status": "imported"
    },
    "voice_042:r_4a9ac1dff86506d9": {
      "text": "You see? I'm empty now...",
      "status": "imported"
    },
    "voice_042:r_bc8538e6af3d2577": {
      "text": "Let's go back before sorrow begins.",
      "status": "imported"
    },
    "voice_042:r_7432ef43ed3471dc": {
      "text": "Even this moment can be redone!",
      "status": "imported"
    },
    "voice_042:r_065443f6ddfcf0d7": {
      "text": "Forget everything and start over...",
      "status": "imported"
    },
    "voice_042:r_47d52a2839c71715": {
      "text": "So... that is your role...",
      "status": "imported"
    },
    "voice_042:r_847f82e7f3eef651": {
      "text": "Let's... go back together...",
      "status": "imported"
    },
    "voice_042:r_eb7ae28b53dc033c": {
      "text": "This story offers no escape...",
      "status": "imported"
    },
    "voice_042:r_857c4a52ce8df0fd": {
      "text": "Why... do you refuse?",
      "status": "imported"
    },
    "voice_042:r_55417493fce1d347": {
      "text": "You... reject me too...",
      "status": "imported"
    },
    "voice_042:r_8fdf5910927c9591": {
      "text": "I see... It can't be helped...",
      "status": "imported"
    },
    "voice_042:r_7d724dbcc4451e10": {
      "text": "Wait for me... I'll come to you...",
      "status": "imported"
    },
    "voice_042:r_93e25418a203cb8f": {
      "text": "You too... Come with me...",
      "status": "imported"
    },
    "voice_042:r_adeb0a29274d3d9b": {
      "text": "Let's go home... together...",
      "status": "imported"
    },
    "voice_042:r_b1de76a75a253c13": {
      "text": "This is reality...",
      "status": "imported"
    },
    "voice_042:r_128c35bf3e0e394c": {
      "text": "Big Venus cannot be stopped...",
      "status": "imported"
    },
    "voice_042:r_5213c17e13b23de0": {
      "text": "Let's stop this now, Roger...",
      "status": "imported"
    },
    "voice_042:r_38fdff9483e9245c": {
      "text": "You're so kind, Roger Smith...",
      "status": "imported"
    },
    "voice_042:r_620fedec67706d7d": {
      "text": "It's no use...",
      "status": "imported"
    },
    "voice_042:r_9680dcd0fddcfcc7": {
      "text": "Protect me...",
      "status": "imported"
    },
    "voice_042:r_ac341e7976e88f0b": {
      "text": "Accept... the past...",
      "status": "imported"
    },
    "voice_042:r_cdbd128a5b4127cc": {
      "text": "You aren't this story's lead...",
      "status": "imported"
    },
    "voice_042:r_cfccaa1fbeda124c": {
      "text": "Even so... you'll keep fighting...",
      "status": "imported"
    },
    "voice_042:r_b1f8ec192b9c083a": {
      "text": "Just as the script says...",
      "status": "imported"
    },
    "voice_042:r_a007f9ab9cf048b3": {
      "text": "You are... merely a spectator...",
      "status": "imported"
    },
    "voice_042:r_ddafde4b065ced49": {
      "text": "Big Venus walks on to the finale...",
      "status": "imported"
    },
    "voice_042:r_de1213040856c089": {
      "text": "Did I... choose this too...?",
      "status": "imported"
    },
    "voice_042:r_3304412ac41f47a6": {
      "text": "Is your role... to stop me...?",
      "status": "imported"
    },
    "voice_042:r_0c0775e051211840": {
      "text": "We would only walk a new path...",
      "status": "imported"
    },
    "voice_042:r_a2afffe1c396f0b3": {
      "text": "You... don't wish for this...",
      "status": "imported"
    },
    "voice_042:r_13c25fbdfddc8a24": {
      "text": "It's pointless to keep this up...",
      "status": "imported"
    },
    "voice_042:r_42ba1ecb310b4bd7": {
      "text": "I won't miss this world of tricks...",
      "status": "imported"
    },
    "voice_042:r_d692f1d420460a47": {
      "text": "This is who I truly am, Roger...",
      "status": "imported"
    },
    "voice_042:r_a5643cec86b18bd2": {
      "text": "So this is your choice, Roger...",
      "status": "imported"
    },
    "voice_042:r_a03fabecba1508ca": {
      "text": "Memories you hold dear\\nare yours...",
      "status": "imported"
    },
    "voice_042:r_5391b24a71eb10ae": {
      "text": "The finale... is drawing near...",
      "status": "imported"
    },
    "voice_042:r_a554ceef5c87b972": {
      "text": "If you'll accept... this world...",
      "status": "imported"
    },
    "voice_042:r_546c3d5937fbb7ee": {
      "text": "Fine... I am Memory, after all...",
      "status": "imported"
    },
    "voice_042:r_1568ff6298b12b96": {
      "text": "I learned... what my role is...",
      "status": "imported"
    },
    "voice_042:r_2c9d94ba13c5fc50": {
      "text": "I only wanted... memories...",
      "status": "imported"
    },
    "voice_042:r_a77f4913375098d2": {
      "text": "This ending... may not be so bad.",
      "status": "imported"
    },
    "voice_042:r_428c2116ac3071b1": {
      "text": "So in the end... it is you...",
      "status": "imported"
    },
    "voice_042:r_84c116267b79f540": {
      "text": "Thank you, Roger Smith...",
      "status": "imported"
    },
    "voice_042:r_dad38ee29af2df3a": {
      "text": "Well done, players. I'll rest too.",
      "status": "imported"
    },
    "voice_042:r_3d32e86f8dc80909": {
      "text": "Gladly, but an android glares?",
      "status": "imported"
    },
    "voice_042:r_70451ffbabe2f876": {
      "text": "Heh. Roger's busy. Rest with me.",
      "status": "imported"
    },
    "voice_042:r_69dfa1659715e2fa": {
      "text": "Gladly, but...",
      "status": "imported"
    }
  }
}
