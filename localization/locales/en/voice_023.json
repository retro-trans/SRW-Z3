{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_023:r_479b340ccc6c572b": {
      "text": "This attack will finish it!",
      "status": "imported"
    },
    "voice_023:r_77949221bf58f862": {
      "text": "I've got you!",
      "status": "imported"
    },
    "voice_023:r_70b9c4b9f1f37eff": {
      "text": "Fall...! Fall!",
      "status": "imported"
    },
    "voice_023:r_9fcb3754cb1773c7": {
      "text": "Trying to run is useless!",
      "status": "imported"
    },
    "voice_023:r_3559d2fad32c2435": {
      "text": "I've got no choice but to fight!",
      "status": "imported"
    },
    "voice_023:r_f7570547e9f80a64": {
      "text": "We are the chosen warriors!",
      "status": "imported"
    },
    "voice_023:r_cbab0f4720e1fcf1": {
      "text": "Behold the pride of Altair!",
      "status": "imported"
    },
    "voice_023:r_0bbe0b4f5364e732": {
      "text": "Everything is for Altair!",
      "status": "imported"
    },
    "voice_023:r_5dda5198137cb02a": {
      "text": "We must capture the $$レア・イグラー$$!",
      "status": "translated"
    },
    "voice_023:r_83ec59afbecdec14": {
      "text": "Complete the mission swiftly!",
      "status": "imported"
    },
    "voice_023:r_e20bfd42ad95a3c9": {
      "text": "We have a reason we must fight!",
      "status": "imported"
    },
    "voice_023:r_0f58a8822381e57f": {
      "text": "Altair's future!\\nNo hesitation!",
      "status": "imported"
    },
    "voice_023:r_6dbcc507fb61b51d": {
      "text": "Our resolve is unwavering!",
      "status": "imported"
    },
    "voice_023:r_b42ab697149a7c8a": {
      "text": "No one can stop us!",
      "status": "imported"
    },
    "voice_023:r_4de4fcf3b440baf4": {
      "text": "Until we obtain the true Eve...!",
      "status": "imported"
    },
    "voice_023:r_0121a166c715cdff": {
      "text": "An invader from Vega?!",
      "status": "imported"
    },
    "voice_023:r_30fad37a42bd3ad3": {
      "text": "Damn you, Vega scum!",
      "status": "imported"
    },
    "voice_023:r_80a0b2a84e05d81a": {
      "text": "To think they invaded Altair...!",
      "status": "imported"
    },
    "voice_023:r_4a9ac1dff86506d9": {
      "text": "Damn you, Machine Angel...!",
      "status": "imported"
    },
    "voice_023:r_bc8538e6af3d2577": {
      "text": "In our way, Machine Angel!",
      "status": "imported"
    },
    "voice_023:r_924516c8de2b5342": {
      "text": "I will end the legend myself!",
      "status": "imported"
    },
    "voice_023:r_da1174533722333f": {
      "text": "The legendary Wings of the Sun?!",
      "status": "imported"
    },
    "voice_023:r_fdeb8162976e72c1": {
      "text": "A new Machine Angel form...?!",
      "status": "imported"
    },
    "voice_023:r_6b15af9a0057cdc8": {
      "text": "A long-range Machine Angel?!",
      "status": "imported"
    },
    "voice_023:r_15b4a90140e8a33a": {
      "text": "It seems built for close combat!",
      "status": "imported"
    },
    "voice_023:r_af884a6b11dff121": {
      "text": "$$レア・イグラー$$ signal detected!",
      "status": "translated"
    },
    "voice_023:r_ac6fe7838e95647b": {
      "text": "We will now capture the $$レア・イグラー$$!",
      "status": "translated"
    },
    "voice_023:r_77ca87eacd17ad52": {
      "text": "Likely the true Eve...!",
      "status": "imported"
    },
    "voice_023:r_bf3244994760e535": {
      "text": "This signal...!\\nA $$レア・イグラー$$?!",
      "status": "translated"
    },
    "voice_023:r_02479dc8fe989560": {
      "text": "We have no use for men!",
      "status": "imported"
    },
    "voice_023:r_a2df00f91a9b0a9e": {
      "text": "Guard the $$レア・イグラー$$ and be crushed!",
      "status": "translated"
    },
    "voice_023:r_48b60d6c48b9b142": {
      "text": "Vega's vaunted\\nSuper Robot, is it?!",
      "status": "imported"
    },
    "voice_023:r_8927e6fb681aa809": {
      "text": "Strong and armored,\\nbut is it fast?!",
      "status": "imported"
    },
    "voice_023:r_665f01666859013b": {
      "text": "Vega giants\\nare no match for Gunis!",
      "status": "imported"
    },
    "voice_023:r_a571eec59b258d11": {
      "text": "A tiny machine,\\nchallenging me?!",
      "status": "imported"
    },
    "voice_023:r_ddbe581c5ea9183d": {
      "text": "It may be small, but no pushover...!",
      "status": "imported"
    },
    "voice_023:r_faae935cca0edc72": {
      "text": "Gundam's name\\nis known on Altair!",
      "status": "imported"
    },
    "voice_023:r_d4430bf362340b32": {
      "text": "Let's see your power, Gundam!",
      "status": "imported"
    },
    "voice_023:r_6ff1323b355593e0": {
      "text": "That ferocity recalls Kagura...!",
      "status": "imported"
    },
    "voice_023:r_b7b5625d7cd4282f": {
      "text": "A beast...?!",
      "status": "imported"
    },
    "voice_023:r_36133ad73a73ef98": {
      "text": "What is that...?! A war god?!",
      "status": "imported"
    },
    "voice_023:r_920740a0219c5085": {
      "text": "That song is shaking my soul...?!",
      "status": "imported"
    },
    "voice_023:r_a8451712c57c1a72": {
      "text": "What is that?!\\nBeyond reason!",
      "status": "imported"
    },
    "voice_023:r_3633df5b7b8f47fa": {
      "text": "Speed means nothing if I read ahead!",
      "status": "imported"
    },
    "voice_023:r_52dfc56b14b93551": {
      "text": "What is that?! Its size is unreal!",
      "status": "imported"
    },
    "voice_023:r_1b9b2aab5cb104da": {
      "text": "You must be a Vega ace! Face me!",
      "status": "imported"
    },
    "voice_023:r_342044c706a2340f": {
      "text": "Target the commander first!",
      "status": "imported"
    },
    "voice_023:r_cf41e8828a90cbdb": {
      "text": "I'll down them and turn the tide!",
      "status": "imported"
    },
    "voice_023:r_719e897304ec42d4": {
      "text": "I'm attacking the enemy ship!",
      "status": "imported"
    },
    "voice_023:r_d5e0a2317c40d322": {
      "text": "I'll sink the battleship myself!",
      "status": "imported"
    },
    "voice_023:r_ec2ea17765052401": {
      "text": "Capture target confirmed! Act now!",
      "status": "imported"
    },
    "voice_023:r_5d08ad19e2da125b": {
      "text": "Destroy it, then capture the pilot!",
      "status": "imported"
    },
    "voice_023:r_dc8701f6bcb9904f": {
      "text": "I'll take you back to Altair!",
      "status": "imported"
    },
    "voice_023:r_ca85f87cee5e31f7": {
      "text": "Now we launch our counterattack!",
      "status": "imported"
    },
    "voice_023:r_9072ea7bc71df136": {
      "text": "Thanks for revealing your position!",
      "status": "imported"
    },
    "voice_023:r_04e815a8d425827d": {
      "text": "I won't let you escape!",
      "status": "imported"
    },
    "voice_023:r_d89011fe3e5d082a": {
      "text": "Don't think you'll make it home!",
      "status": "imported"
    },
    "voice_023:r_3c5b0c2ac812d5de": {
      "text": "If you're still within my range...!",
      "status": "imported"
    },
    "voice_023:r_5b9e8897190892eb": {
      "text": "Now it's our turn!",
      "status": "imported"
    },
    "voice_023:r_7bea3023abbf8a94": {
      "text": "Your mistake was leaving me alive!",
      "status": "imported"
    },
    "voice_023:r_dd01a4c0d1b36a8d": {
      "text": "I won't let you withdraw!",
      "status": "imported"
    },
    "voice_023:r_20920ad2eb3542db": {
      "text": "This counterattack will finish you!",
      "status": "imported"
    },
    "voice_023:r_0ab7914877fd48ed": {
      "text": "Have some payback!",
      "status": "imported"
    },
    "voice_023:r_cb846feec748c2e3": {
      "text": "My attack isn't over yet!",
      "status": "imported"
    },
    "voice_023:r_c958860b0676b1f5": {
      "text": "I'll follow you in!",
      "status": "imported"
    },
    "voice_023:r_5e2669b82ef75ce3": {
      "text": "For Izumo and Altair...!",
      "status": "imported"
    },
    "voice_023:r_7847e0ed7dc9282d": {
      "text": "Kagura, I'll cover you!",
      "status": "imported"
    },
    "voice_023:r_e42b52c7a987b906": {
      "text": "I must support Jin...!",
      "status": "imported"
    },
    "voice_023:r_6825fd1ff907bd22": {
      "text": "Fool! You left yourself open!",
      "status": "imported"
    },
    "voice_023:r_607f666f1563bc0d": {
      "text": "This time, I'll finish you!",
      "status": "imported"
    },
    "voice_023:r_97b7431eeb81e6b6": {
      "text": "N-No... Aaaaaaargh!",
      "status": "imported"
    },
    "voice_023:r_132f605d02975e71": {
      "text": "Glory to Altair!",
      "status": "imported"
    },
    "voice_023:r_9b9726b1872759d6": {
      "text": "N-No! It's going to explode!!",
      "status": "imported"
    },
    "voice_023:r_1252db29683fefe0": {
      "text": "My apologies, Izumo!",
      "status": "imported"
    },
    "voice_023:r_ad3d538f1e909184": {
      "text": "Mission failed! Repeat, mission...!",
      "status": "imported"
    },
    "voice_023:r_8c61c59a1c0aebbf": {
      "text": "Eject! Abandon the machine!",
      "status": "imported"
    },
    "voice_023:r_aba6a7662129d8ce": {
      "text": "Damn! $$レア・イグラー$$\\nslipped away...!",
      "status": "translated"
    },
    "voice_023:r_b84afafb8a33ec60": {
      "text": "Comrades, find the true Eve!\\nAargh!",
      "status": "imported"
    },
    "voice_023:r_c8c59db85bf875e6": {
      "text": "The Machine Angel's true power...!",
      "status": "imported"
    },
    "voice_023:r_391aa56435d9dd6e": {
      "text": "It lives up to the legends...!",
      "status": "imported"
    },
    "voice_023:r_7c796ba53bd7ea03": {
      "text": "The demon that will doom Altair...?!",
      "status": "imported"
    },
    "voice_023:r_fa944da4b6519006": {
      "text": "So it is the Wings of the Sun...?!",
      "status": "imported"
    },
    "voice_023:r_95d047bcc17fccc6": {
      "text": "This power...! A true $$レア・イグラー$$!",
      "status": "translated"
    },
    "voice_023:r_bdd38c584fa313d0": {
      "text": "Worthy to become the true Eve...!",
      "status": "imported"
    },
    "voice_023:r_d0372a183d2007ad": {
      "text": "Such power...!\\nTake them to Altair!",
      "status": "imported"
    },
    "voice_023:r_381992c5d8224937": {
      "text": "This power may\\nbreak Eve's curse!",
      "status": "imported"
    },
    "voice_023:r_fc25e66a86fc2c85": {
      "text": "Vega mechanical giant!\\nSuch power!",
      "status": "imported"
    },
    "voice_023:r_5aeeb4917340c42d": {
      "text": "Now I see why it's a\\nSuper Robot!",
      "status": "imported"
    },
    "voice_023:r_b765659981b6516d": {
      "text": "Gundam...! Stronger than I heard!",
      "status": "imported"
    },
    "voice_023:r_0c427458bc00eb95": {
      "text": "Small, yet still a dangerous foe...!",
      "status": "imported"
    },
    "voice_023:r_774a9ab4d8fd5351": {
      "text": "No! I can't keep up with that speed!",
      "status": "imported"
    },
    "voice_023:r_d3f01de714c015bd": {
      "text": "Gwaaaagh!",
      "status": "imported"
    },
    "voice_023:r_7d2617c809fead70": {
      "text": "It's strong...! Far too strong!",
      "status": "imported"
    },
    "voice_023:r_ceb935ccbf830724": {
      "text": "W-What?! What's happening?!",
      "status": "imported"
    },
    "voice_023:r_862ef7385bf2abd4": {
      "text": "The machine can't hold much longer!",
      "status": "imported"
    },
    "voice_023:r_001cbec4d9a4283f": {
      "text": "Send help! The enemy is too strong!",
      "status": "imported"
    },
    "voice_023:r_8ad40afecd02b41e": {
      "text": "Damage rising!\\nLimit in minutes!",
      "status": "imported"
    },
    "voice_023:r_26e5efec03c03d78": {
      "text": "No!\\nThey'll tear it apart!",
      "status": "imported"
    },
    "voice_023:r_4ad81e88c7557a8b": {
      "text": "Systems failing!\\nAt this rate...!",
      "status": "imported"
    },
    "voice_023:r_1f65a7af190e4674": {
      "text": "Even if my machine is destroyed...!",
      "status": "imported"
    },
    "voice_023:r_40c5a9358ed5bf29": {
      "text": "Our mission permits no retreat!",
      "status": "imported"
    },
    "voice_023:r_f2e18dfdfe0c89ea": {
      "text": "Not yet! Till the true Eve is ours!",
      "status": "imported"
    },
    "voice_023:r_cf7dbf49e96a5755": {
      "text": "Can't lose!\\nFor Altair's future...!",
      "status": "imported"
    },
    "voice_023:r_eb643f8bf737a0ca": {
      "text": "What...?!",
      "status": "imported"
    },
    "voice_023:r_0a3fccb71ec6cf2a": {
      "text": "Ugh! A direct hit?!",
      "status": "imported"
    },
    "voice_023:r_9b63cf1f3e0207ef": {
      "text": "I can't dodge it...!",
      "status": "imported"
    },
    "voice_023:r_8356f4e3dcdff938": {
      "text": "That wasn't just luck...?!",
      "status": "imported"
    },
    "voice_023:r_1d6d784036ae0bd7": {
      "text": "Not bad, warrior of Vega...!",
      "status": "imported"
    },
    "voice_023:r_625664af02183c17": {
      "text": "They hit my thrusters...!",
      "status": "imported"
    },
    "voice_023:r_3701cba361f80ea5": {
      "text": "Damn it! Some sensors are dead!",
      "status": "imported"
    },
    "voice_023:r_63f429c5c68c0863": {
      "text": "That power exceeds all our data...!",
      "status": "imported"
    },
    "voice_023:r_38e4a434c91d8ef0": {
      "text": "Vega's forces are no pushovers...!",
      "status": "imported"
    },
    "voice_023:r_98ed411352a3a6ac": {
      "text": "They've completely read my moves...!",
      "status": "imported"
    },
    "voice_023:r_4824bea6bab3af67": {
      "text": "Damn! This is just what they want!",
      "status": "imported"
    },
    "voice_023:r_862b92e63adb9734": {
      "text": "I won't meekly retreat\\nover this...!",
      "status": "imported"
    },
    "voice_023:r_cb306ef55e49d107": {
      "text": "Is that all, Machine Angel?!",
      "status": "imported"
    },
    "voice_023:r_57b2bd2de8a1408d": {
      "text": "You shame the name Machine Angel!",
      "status": "imported"
    },
    "voice_023:r_76f080a4881e8ab5": {
      "text": "Ngh! You...!",
      "status": "imported"
    },
    "voice_023:r_288133bc5b573dae": {
      "text": "A plate or two means nothing...!",
      "status": "imported"
    },
    "voice_023:r_6f95653e548f8fcf": {
      "text": "So that's the best you can do...!",
      "status": "imported"
    },
    "voice_023:r_d249d68bada91ab9": {
      "text": "You're all show, it seems!",
      "status": "imported"
    },
    "voice_023:r_e9b3307e9eb69f11": {
      "text": "This won't hinder me in battle...!",
      "status": "imported"
    },
    "voice_023:r_03cdac73042343ee": {
      "text": "This won't make me flinch!",
      "status": "imported"
    },
    "voice_023:r_6026da5acbda7c69": {
      "text": "An attack from Vega can't hurt me!",
      "status": "imported"
    },
    "voice_023:r_981f8fedd5414fe5": {
      "text": "You're no match for my Gunis!",
      "status": "imported"
    },
    "voice_023:r_96bb0dcde0c8c44a": {
      "text": "Too slow!",
      "status": "imported"
    },
    "voice_023:r_641550a2f54cb456": {
      "text": "You didn't think this through!",
      "status": "imported"
    },
    "voice_023:r_a0f2074af8debbfa": {
      "text": "I won't let you!",
      "status": "imported"
    },
    "voice_023:r_b5f5a97ed82acb0b": {
      "text": "I cannot afford to be hit!",
      "status": "imported"
    },
    "voice_023:r_d9cd2e4ded064396": {
      "text": "Hmph, just as I predicted...!",
      "status": "imported"
    },
    "voice_023:r_99e6349431aaf23b": {
      "text": "Your every move is obvious!",
      "status": "imported"
    },
    "voice_023:r_ec1081caf845f56a": {
      "text": "Your targeting is inaccurate!",
      "status": "imported"
    },
    "voice_023:r_2c5b7ee872c1ed7f": {
      "text": "This is the speed of a Gunis!",
      "status": "imported"
    },
    "voice_023:r_2329428a6871d9fa": {
      "text": "That won't work on me!",
      "status": "imported"
    },
    "voice_023:r_0e7466971bec4cc4": {
      "text": "What a waste of effort!",
      "status": "imported"
    },
    "voice_023:r_fa6930340a545054": {
      "text": "I have a barrier!",
      "status": "imported"
    },
    "voice_023:r_2332b9d56461d7ab": {
      "text": "Defense system, activate!",
      "status": "imported"
    },
    "voice_023:r_854aa0a91a3c80d1": {
      "text": "Why can't I attack?!",
      "status": "imported"
    },
    "voice_023:r_0bc8ae32a406ceab": {
      "text": "I can't do anything...!",
      "status": "imported"
    },
    "voice_023:r_82c09f011d703b2c": {
      "text": "All weapons are disabled...?!",
      "status": "imported"
    },
    "voice_023:r_2b4d8818c77b6dca": {
      "text": "I lost the enemy?! What a disgrace!",
      "status": "imported"
    },
    "voice_023:r_087354f2db0a31e6": {
      "text": "I can't attack from here...!",
      "status": "imported"
    },
    "voice_023:r_db02a2dec93dd263": {
      "text": "Too much wear on the machine...!",
      "status": "imported"
    },
    "voice_023:r_d520c6d5298a848d": {
      "text": "I won't ignore a comrade in danger!",
      "status": "imported"
    },
    "voice_023:r_099e2458cabf796f": {
      "text": "I'll be the shield!",
      "status": "imported"
    },
    "voice_023:r_fd910d714be70870": {
      "text": "We cannot lose Izumo!",
      "status": "imported"
    },
    "voice_023:r_9736f29b11344ec3": {
      "text": "Kagura, please don't be reckless!",
      "status": "imported"
    },
    "voice_023:r_fcd05582aa5c6068": {
      "text": "I won't let them get Jin!",
      "status": "imported"
    },
    "voice_023:r_bece29562818acba": {
      "text": "Target acquired!",
      "status": "imported"
    },
    "voice_023:r_494b5da92ed24ecb": {
      "text": "Perfect range!",
      "status": "imported"
    },
    "voice_023:r_a4a5a96f4bd58920": {
      "text": "This will be a direct hit!",
      "status": "imported"
    },
    "voice_023:r_b57d2d74233f889a": {
      "text": "I'll shoot right through you!",
      "status": "imported"
    },
    "voice_023:r_cd06d0820d82524b": {
      "text": "Missile, fire!",
      "status": "imported"
    },
    "voice_023:r_c94c6d04be583774": {
      "text": "Missile, fire all rounds!",
      "status": "imported"
    },
    "voice_023:r_e54e2c99ef8297af": {
      "text": "Every round will hit!",
      "status": "imported"
    },
    "voice_023:r_f16a3eb0bcaac082": {
      "text": "If this hits them directly...!",
      "status": "imported"
    },
    "voice_023:r_10a408809e512df1": {
      "text": "Volley Fire will finish you!",
      "status": "imported"
    },
    "voice_023:r_bc7b9e308b879dd4": {
      "text": "I'll hit you with all my power!",
      "status": "imported"
    },
    "voice_023:r_98902fd3143c393e": {
      "text": "Now face our power!",
      "status": "imported"
    },
    "voice_023:r_d907fbd7bc1c4298": {
      "text": "This is Altair's power!",
      "status": "imported"
    },
    "voice_023:r_96b21e3a028dd074": {
      "text": "Danger!\\nPlease stand back, Izumo!",
      "status": "imported"
    },
    "voice_023:r_ce140b5d8e6b7310": {
      "text": "We'll take the lead!",
      "status": "imported"
    },
    "voice_023:r_0e0335789c5396d7": {
      "text": "Concentrate all attacks!",
      "status": "imported"
    },
    "voice_023:r_a8e85bd950696403": {
      "text": "I'll draw the enemy's attention!",
      "status": "imported"
    },
    "voice_023:r_772c8bc40ab6cb61": {
      "text": "The finishing blow is yours!",
      "status": "imported"
    },
    "voice_023:r_58dd2826a199ef51": {
      "text": "At least I must hold them back...!",
      "status": "imported"
    },
    "voice_023:r_aadc0b2442adb93b": {
      "text": "So that's my target!",
      "status": "imported"
    },
    "voice_023:r_e7a8cd8ed5bc2d1b": {
      "text": "One-on-one, then!",
      "status": "imported"
    },
    "voice_023:r_041dd920da4a7c17": {
      "text": "I'll cut them off from the squad!",
      "status": "imported"
    },
    "voice_023:r_c7f4280cde4605b3": {
      "text": "One kill each, is it...?",
      "status": "imported"
    }
  }
