{
  "schema": 1,
  "language": "en",
  "messages": {
    "narration_0001a:r_479b340ccc6c572b": {
      "text": "Many worlds, many",
      "status": "imported"
    },
    "narration_0001a:r_ca4acbac57a2a35e": {
      "text": "universes, set apart in",
      "status": "imported"
    },
    "narration_0001a:r_77949221bf58f862": {
      "text": "spacetimes never to meet.",
      "status": "imported"
    },
    "narration_0001a:r_70b9c4b9f1f37eff": {
      "text": "Until that day came.",
      "status": "imported"
    },
    "narration_0001a:r_9fcb3754cb1773c7": {
      "text": "The $$大時空震動$$...",
      "status": "imported"
    },
    "narration_0001a:r_1aedb5f4821b916f": {
      "text": "The Great Spacequake...",
      "status": "imported"
    },
    "narration_0001a:r_3559d2fad32c2435": {
      "text": "A $$時空震動$$ in one world",
      "status": "imported"
    },
    "narration_0001a:r_f2363a00c7c74bc8": {
      "text": "A Spacequake in one world",
      "status": "imported"
    },
    "narration_0001a:r_f7570547e9f80a64": {
      "text": "broke the walls between",
      "status": "imported"
    },
    "narration_0001a:r_cbab0f4720e1fcf1": {
      "text": "worlds. They intermingled,",
      "status": "imported"
    },
    "narration_0001a:r_0bbe0b4f5364e732": {
      "text": "and many new worlds rose.",
      "status": "imported"
    },
    "narration_0001a:r_5dda5198137cb02a": {
      "text": "The multiverse was born.",
      "status": "imported"
    },
    "narration_0001a:r_83ec59afbecdec14": {
      "text": "New worlds brought new",
      "status": "imported"
    },
    "narration_0001a:r_e20bfd42ad95a3c9": {
      "text": "meetings, and new wars.",
      "status": "imported"
    },
    "narration_0001a:r_0f58a8822381e57f": {
      "text": "Chaos reigned for an age.",
      "status": "imported"
    },
    "narration_0001a:r_6dbcc507fb61b51d": {
      "text": "Yet in some, a new order",
      "status": "imported"
    },
    "narration_0001a:r_b42ab697149a7c8a": {
      "text": "slowly came into being.",
      "status": "imported"
    },
    "narration_0001a:r_4de4fcf3b440baf4": {
      "text": "In the world later called",
      "status": "imported"
    },
    "narration_0001a:r_0121a166c715cdff": {
      "text": "UCW: the $$多元戦争$$.",
      "status": "imported"
    },
    "narration_0001a:r_f8aa21035c04a004": {
      "text": "UCW: the Multiverse War.",
      "status": "imported"
    },
    "narration_0001a:r_30fad37a42bd3ad3": {
      "text": "$$ＺＥＵＴＨ$$, who ended that war,",
      "status": "imported"
    },
    "narration_0001a:r_ee347fdb2053d257": {
      "text": "ZEUTH, who ended that war,",
      "status": "imported"
    },
    "narration_0001a:r_80a0b2a84e05d81a": {
      "text": "was flung by a $$時空震動$$",
      "status": "imported"
    },
    "narration_0001a:r_466f33dc7195602a": {
      "text": "was flung by a Spacequake",
      "status": "imported"
    },
    "narration_0001a:r_4a9ac1dff86506d9": {
      "text": "into the world called ADW",
      "status": "imported"
    },
    "narration_0001a:r_bc8538e6af3d2577": {
      "text": "(2nd Super Robot Wars Z).",
      "status": "imported"
    },
    "narration_0001a:r_924516c8de2b5342": {
      "text": "There, with new comrades,",
      "status": "imported"
    },
    "narration_0001a:r_da1174533722333f": {
      "text": "they formed $$ＺＥＸＩＳ$$ and won",
      "status": "imported"
    },
    "narration_0001a:r_6b1535bd0c1decfe": {
      "text": "they formed ZEXIS and won",
      "status": "imported"
    },
    "narration_0001a:r_fdeb8162976e72c1": {
      "text": "through two great wars.",
      "status": "imported"
    },
    "narration_0001a:r_0fadb5c26df92b42": {
      "text": "The $$ＺＥＵＴＨ$$ who gave ADW",
      "status": "imported"
    },
    "narration_0001a:r_1ab0bac0d152f274": {
      "text": "The ZEUTH who gave ADW",
      "status": "imported"
    },
    "narration_0001a:r_6b15af9a0057cdc8": {
      "text": "peace were bound home to",
      "status": "imported"
    },
    "narration_0001a:r_15b4a90140e8a33a": {
      "text": "UCW through the $$アビス$$,",
      "status": "imported"
    },
    "narration_0001a:r_6f6e5524a5cb0b90": {
      "text": "UCW through the Abyss,",
      "status": "imported"
    },
    "narration_0001a:r_af884a6b11dff121": {
      "text": "unaware of what waited...",
      "status": "imported"
    }
  }
}
