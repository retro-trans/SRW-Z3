{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_197:r_479b340ccc6c572b": {
      "text": "This punk's nothing.\\nGet a move on!",
      "status": "imported"
    },
    "voice_197:r_ca4acbac57a2a35e": {
      "text": "This tension isn't bad...!",
      "status": "imported"
    },
    "voice_197:r_77949221bf58f862": {
      "text": "My body remembers the feeling...!",
      "status": "imported"
    },
    "voice_197:r_70b9c4b9f1f37eff": {
      "text": "I won't let you have your way...!",
      "status": "imported"
    },
    "voice_197:r_9fcb3754cb1773c7": {
      "text": "My blood's finally racing again...!",
      "status": "imported"
    },
    "voice_197:r_3559d2fad32c2435": {
      "text": "Lend me your power again, Getter!",
      "status": "imported"
    },
    "voice_197:r_cbab0f4720e1fcf1": {
      "text": "Heh... Adults don't rush things!",
      "status": "imported"
    },
    "voice_197:r_0bbe0b4f5364e732": {
      "text": "Hayato! If you fight, finish them!",
      "status": "imported"
    },
    "voice_197:r_5dda5198137cb02a": {
      "text": "Been ages since I heard that line.",
      "status": "imported"
    },
    "voice_197:r_83ec59afbecdec14": {
      "text": "They're coming, Hayato! Front left!",
      "status": "imported"
    },
    "voice_197:r_e20bfd42ad95a3c9": {
      "text": "To me, you're standing still!",
      "status": "imported"
    },
    "voice_197:r_0f58a8822381e57f": {
      "text": "Hayato! Don't miss!",
      "status": "imported"
    },
    "voice_197:r_6dbcc507fb61b51d": {
      "text": "If you can't handle it, tag me in!",
      "status": "imported"
    },
    "voice_197:r_b42ab697149a7c8a": {
      "text": "That's rich,\\ncoming from a charger!",
      "status": "imported"
    },
    "voice_197:r_4de4fcf3b440baf4": {
      "text": "Ryoma, Benkei! You're ready, right!",
      "status": "imported"
    },
    "voice_197:r_0121a166c715cdff": {
      "text": "Yeah!",
      "status": "imported"
    },
    "voice_197:r_30fad37a42bd3ad3": {
      "text": "Too late to notice now...!",
      "status": "imported"
    },
    "voice_197:r_80a0b2a84e05d81a": {
      "text": "Your dullness brought this on...!",
      "status": "imported"
    },
    "voice_197:r_4a9ac1dff86506d9": {
      "text": "Show the Invaders\\nhumanity's power!",
      "status": "imported"
    },
    "voice_197:r_bc8538e6af3d2577": {
      "text": "We won't hold back against you...!",
      "status": "imported"
    },
    "voice_197:r_924516c8de2b5342": {
      "text": "We'll forge the future with Getter!",
      "status": "imported"
    },
    "voice_197:r_da1174533722333f": {
      "text": "Hayato! Leave the fliers to me!",
      "status": "imported"
    },
    "voice_197:r_fdeb8162976e72c1": {
      "text": "Say that after you see me fight!",
      "status": "imported"
    },
    "voice_197:r_0fadb5c26df92b42": {
      "text": "Tag me in for underwater combat!",
      "status": "imported"
    },
    "voice_197:r_6b15af9a0057cdc8": {
      "text": "I can handle small fry like that!",
      "status": "imported"
    },
    "voice_197:r_15b4a90140e8a33a": {
      "text": "So they're behind all of this...!",
      "status": "imported"
    },
    "voice_197:r_af884a6b11dff121": {
      "text": "The time has come to settle this!",
      "status": "imported"
    },
    "voice_197:r_ac6fe7838e95647b": {
      "text": "Let's go!\\nWe'll put them to rest!",
      "status": "imported"
    },
    "voice_197:r_5d08ad19e2da125b": {
      "text": "Drill Missile!",
      "status": "imported"
    },
    "voice_197:r_a7246b52782a877e": {
      "text": "Drill Missile, fire!",
      "status": "imported"
    },
    "voice_197:r_dc8701f6bcb9904f": {
      "text": "Plasma Drill! Hurricane!",
      "status": "imported"
    },
    "voice_197:r_d6bdd730f24f66eb": {
      "text": "Plasma Drill! Hurricaaaane!",
      "status": "imported"
    },
    "voice_197:r_41997412868c48c4": {
      "text": "You chose me.\\nReady to pay for it?",
      "status": "imported"
    },
    "voice_197:r_9e6cf4f389dae55c": {
      "text": "You won't get away that easily...!",
      "status": "imported"
    },
    "voice_197:r_9e0c80ac7e33b459": {
      "text": "Take this with you too!",
      "status": "imported"
    },
    "voice_197:r_7432ef43ed3471dc": {
      "text": "I'm going in next!",
      "status": "imported"
    },
    "voice_197:r_065443f6ddfcf0d7": {
      "text": "Not bad, for you lot.",
      "status": "imported"
    },
    "voice_197:r_47d52a2839c71715": {
      "text": "You're being targeted! Fall back!",
      "status": "imported"
    },
    "voice_197:r_847f82e7f3eef651": {
      "text": "Always making me look after you...!",
      "status": "imported"
    },
    "voice_197:r_eb7ae28b53dc033c": {
      "text": "Watching kids is an adult's job...!",
      "status": "imported"
    },
    "voice_197:r_857c4a52ce8df0fd": {
      "text": "Tch...! I can't counter now...!",
      "status": "imported"
    },
    "voice_197:r_55417493fce1d347": {
      "text": "Tch...!\\nGetter Rays won't power up!",
      "status": "imported"
    },
    "voice_197:r_8fdf5910927c9591": {
      "text": "You read our range...\\nNot bad!",
      "status": "imported"
    },
    "voice_197:r_7d724dbcc4451e10": {
      "text": "I've survived more hell than you.",
      "status": "imported"
    },
    "voice_197:r_93e25418a203cb8f": {
      "text": "Remember: this is Getter's speed.",
      "status": "imported"
    },
    "voice_197:r_adeb0a29274d3d9b": {
      "text": "With that aim, you'll never hit.",
      "status": "imported"
    },
    "voice_197:r_24cf161287ef9d5c": {
      "text": "Heh! Not bad, Hayato!",
      "status": "imported"
    },
    "voice_197:r_8f60f6fc86db3107": {
      "text": "I didn't get this old for nothing.",
      "status": "imported"
    },
    "voice_197:r_b1de76a75a253c13": {
      "text": "Switch, Ryoma. They're beneath me.",
      "status": "imported"
    },
    "voice_197:r_128c35bf3e0e394c": {
      "text": "Don't mock me!\\nKill that runt!",
      "status": "imported"
    },
    "voice_197:r_5213c17e13b23de0": {
      "text": "That was close, Hayato!",
      "status": "imported"
    },
    "voice_197:r_38fdff9483e9245c": {
      "text": "I'm getting old.\\nNo wasted motion.",
      "status": "imported"
    },
    "voice_197:r_620fedec67706d7d": {
      "text": "If you're attacking, aim properly!",
      "status": "imported"
    },
    "voice_197:r_9680dcd0fddcfcc7": {
      "text": "Not that I plan on getting hit.",
      "status": "imported"
    },
    "voice_197:r_2a00f1044ad5cbaa": {
      "text": "We're prepared for anything.",
      "status": "imported"
    },
    "voice_197:r_98d15b8cc09bc915": {
      "text": "Damn. I had to rely on the barrier.",
      "status": "imported"
    },
    "voice_197:r_46e86d000250e137": {
      "text": "You think that's enough for Getter?",
      "status": "imported"
    },
    "voice_197:r_ac341e7976e88f0b": {
      "text": "Heh... You underestimated me.",
      "status": "imported"
    },
    "voice_197:r_cdbd128a5b4127cc": {
      "text": "What a pathetic attack. Go home.",
      "status": "imported"
    },
    "voice_197:r_cfccaa1fbeda124c": {
      "text": "If you can't dodge, tag me in!",
      "status": "imported"
    },
    "voice_197:r_b1f8ec192b9c083a": {
      "text": "Give me a break. That was a fluke.",
      "status": "imported"
    },
    "voice_197:r_a007f9ab9cf048b3": {
      "text": "Hayato!\\nQuit taking every hit!",
      "status": "imported"
    },
    "voice_197:r_ddafde4b065ced49": {
      "text": "Hmph. Shut up and watch.",
      "status": "imported"
    },
    "voice_197:r_de1213040856c089": {
      "text": "A pathetic attempt to stop me.",
      "status": "imported"
    },
    "voice_197:r_3304412ac41f47a6": {
      "text": "Well, it can't be helped.",
      "status": "imported"
    },
    "voice_197:r_0c0775e051211840": {
      "text": "My blood's heating up again...!",
      "status": "imported"
    },
    "voice_197:r_a2afffe1c396f0b3": {
      "text": "Ten years on,\\nI must get serious!",
      "status": "imported"
    },
    "voice_197:r_13c25fbdfddc8a24": {
      "text": "Hayato, beware!\\nThat's no pushover!",
      "status": "imported"
    },
    "voice_197:r_42ba1ecb310b4bd7": {
      "text": "I know that without being told!",
      "status": "imported"
    },
    "voice_197:r_d692f1d420460a47": {
      "text": "Ngh!\\nThey're outpacing us?!",
      "status": "imported"
    },
    "voice_197:r_a5643cec86b18bd2": {
      "text": "What's wrong?! Unlike you, Hayato!",
      "status": "imported"
    },
    "voice_197:r_68f2dfab20a4a30e": {
      "text": "Can't you do something, Hayato?!",
      "status": "imported"
    },
    "voice_197:r_9cedad8237480563": {
      "text": "I know their moves. No more hits!",
      "status": "imported"
    },
    "voice_197:r_a03fabecba1508ca": {
      "text": "Heh, a worthy foe at long last...!",
      "status": "imported"
    },
    "voice_197:r_5391b24a71eb10ae": {
      "text": "Don't praise the enemy right now!",
      "status": "imported"
    },
    "voice_197:r_a554ceef5c87b972": {
      "text": "Getter's speed can't shake them!",
      "status": "imported"
    },
    "voice_197:r_546c3d5937fbb7ee": {
      "text": "Don't scoff...!\\nI've escaped worse!",
      "status": "imported"
    },
    "voice_197:r_1568ff6298b12b96": {
      "text": "I can't take it anymore! Tag me in!",
      "status": "imported"
    },
    "voice_197:r_2c9d94ba13c5fc50": {
      "text": "Shut up and watch!\\nMy mess, my fix!",
      "status": "imported"
    },
    "voice_197:r_a77f4913375098d2": {
      "text": "Damn it!\\nDon't make them cockier!",
      "status": "imported"
    },
    "voice_197:r_428c2116ac3071b1": {
      "text": "Now!\\nShow them our true strength!",
      "status": "imported"
    },
    "voice_197:r_84c116267b79f540": {
      "text": "What are you planning, Hayato?!",
      "status": "imported"
    },
    "voice_197:r_dad38ee29af2df3a": {
      "text": "Explanations later! Leave it to me!",
      "status": "imported"
    },
    "voice_197:r_3d32e86f8dc80909": {
      "text": "Getter and I\\nare cornered...?!",
      "status": "imported"
    },
    "voice_197:r_70451ffbabe2f876": {
      "text": "Hayato, focus!\\nOur lives are yours!",
      "status": "imported"
    },
    "voice_197:r_69dfa1659715e2fa": {
      "text": "Ngh! To think we'd lose Getter...!",
      "status": "imported"
    },
    "voice_197:r_d996fd6d4ef5b329": {
      "text": "Gah!\\nAm I losing my touch too...?!",
      "status": "imported"
    },
    "voice_197:r_8ab47a28f99ef565": {
      "text": "Chaaaange! Getter 2!",
      "status": "imported"
    },
    "voice_197:r_546de3fb6db156ea": {
      "text": "Leave this one to me...!",
      "status": "imported"
    },
    "voice_197:r_ca85f87cee5e31f7": {
      "text": "Let's do this, Getter...!",
      "status": "imported"
    },
    "voice_197:r_d89011fe3e5d082a": {
      "text": "I'll pay this debt back fast...!",
      "status": "imported"
    },
    "voice_197:r_3c5b0c2ac812d5de": {
      "text": "Now take my attack!",
      "status": "imported"
    },
    "voice_197:r_5b9e8897190892eb": {
      "text": "Think! How do we turn this around?!",
      "status": "imported"
    },
    "voice_197:r_7bea3023abbf8a94": {
      "text": "Tch!\\nIt's too soon to meet my end!",
      "status": "imported"
    },
    "voice_197:r_dd01a4c0d1b36a8d": {
      "text": "Good. Now it's interesting...!",
      "status": "imported"
    },
    "voice_197:r_20920ad2eb3542db": {
      "text": "Tch! Fell for a cheap trick...!",
      "status": "imported"
    },
    "voice_197:r_0ab7914877fd48ed": {
      "text": "That hardly even counts.",
      "status": "imported"
    },
    "voice_197:r_cb846feec748c2e3": {
      "text": "Heh... I've got more experience.",
      "status": "imported"
    },
    "voice_197:r_c958860b0676b1f5": {
      "text": "As if!",
      "status": "imported"
    },
    "voice_197:r_7847e0ed7dc9282d": {
      "text": "This is the moment I waited for...!",
      "status": "imported"
    },
    "voice_197:r_e42b52c7a987b906": {
      "text": "Bad luck getting targeted by me...!",
      "status": "imported"
    },
    "voice_197:r_6825fd1ff907bd22": {
      "text": "Tower? No.\\nThis suits me better...!",
      "status": "imported"
    },
    "voice_197:r_607f666f1563bc0d": {
      "text": "Blame your bad luck and give up!",
      "status": "imported"
    },
    "voice_197:r_97b7431eeb81e6b6": {
      "text": "Shin Getter and I'll finish you!",
      "status": "imported"
    },
    "voice_197:r_132f605d02975e71": {
      "text": "Shin Getter 2 will take you on!",
      "status": "imported"
    },
    "voice_197:r_9b9726b1872759d6": {
      "text": "Hayato!\\nQuit stalling. Finish it!",
      "status": "imported"
    },
    "voice_197:r_1252db29683fefe0": {
      "text": "It'll end in a flash. Stay put!",
      "status": "imported"
    },
    "voice_197:r_ad3d538f1e909184": {
      "text": "Now! Let them have it!",
      "status": "imported"
    },
    "voice_197:r_8c61c59a1c0aebbf": {
      "text": "It's not my style,\\nbut I'll do it!",
      "status": "imported"
    },
    "voice_197:r_aba6a7662129d8ce": {
      "text": "Ryoma, Benkei!\\nFollow my timing!",
      "status": "imported"
    },
    "voice_197:r_c8c59db85bf875e6": {
      "text": "One slip can cost you your life...!",
      "status": "imported"
    },
    "voice_197:r_391aa56435d9dd6e": {
      "text": "Got you! This was the real attack!",
      "status": "imported"
    },
    "voice_197:r_7c796ba53bd7ea03": {
      "text": "Know the power of humanity!",
      "status": "imported"
    },
    "voice_197:r_fa944da4b6519006": {
      "text": "If you want to live, stay back!",
      "status": "imported"
    },
    "voice_197:r_95d047bcc17fccc6": {
      "text": "We can't back down.\\nNo grudges!",
      "status": "imported"
    },
    "voice_197:r_640327a12a559b31": {
      "text": "I'll use speed to foil your power!",
      "status": "imported"
    },
    "voice_197:r_bdd38c584fa313d0": {
      "text": "My drill will pierce that armor!",
      "status": "imported"
    },
    "voice_197:r_3fd86c1027f317c8": {
      "text": "Getter's speed can catch up to you!",
      "status": "imported"
    },
    "voice_197:r_d0372a183d2007ad": {
      "text": "You're moving in slow motion!",
      "status": "imported"
    },
    "voice_197:r_217aa5e1d545b44d": {
      "text": "Speedsters, quit\\nor be humiliated!",
      "status": "imported"
    },
    "voice_197:r_381992c5d8224937": {
      "text": "We'll sink them and turn the tide!",
      "status": "imported"
    },
    "voice_197:r_f1e7ed9e5874aba5": {
      "text": "You lot never learn, do you...!",
      "status": "imported"
    },
    "voice_197:r_fc25e66a86fc2c85": {
      "text": "If they pass, the world ends!",
      "status": "imported"
    },
    "voice_197:r_5aeeb4917340c42d": {
      "text": "They're the primordial calamity?!",
      "status": "imported"
    },
    "voice_197:r_0c427458bc00eb95": {
      "text": "Baal...! Humanity's natural enemy!",
      "status": "imported"
    },
    "voice_197:r_d3f01de714c015bd": {
      "text": "Words won't work.\\nThis will!",
      "status": "imported"
    },
    "voice_197:r_7d2617c809fead70": {
      "text": "Invaders alone\\nare already enough!",
      "status": "imported"
    },
    "voice_197:r_ceb935ccbf830724": {
      "text": "Earth draws\\nfar too many villains!",
      "status": "imported"
    },
    "voice_197:r_862ef7385bf2abd4": {
      "text": "So an invader would play god...!",
      "status": "imported"
    },
    "voice_197:r_001cbec4d9a4283f": {
      "text": "You're doomed anyway. Wait in hell!",
      "status": "imported"
    },
    "voice_197:r_8ad40afecd02b41e": {
      "text": "I'll spare your vitals! Don't move!",
      "status": "imported"
    },
    "voice_197:r_26e5efec03c03d78": {
      "text": "We have no option but to fight...!",
      "status": "imported"
    },
    "voice_197:r_4ad81e88c7557a8b": {
      "text": "Your dogma poisons the world!",
      "status": "imported"
    },
    "voice_197:r_1f65a7af190e4674": {
      "text": "You egotist!\\nEarth won't be yours!",
      "status": "imported"
    },
    "voice_197:r_40c5a9358ed5bf29": {
      "text": "Can you keep up with me, Koji!",
      "status": "imported"
    },
    "voice_197:r_f2e18dfdfe0c89ea": {
      "text": "Koji!\\nRead ahead before you attack!",
      "status": "imported"
    },
    "voice_197:r_cf7dbf49e96a5755": {
      "text": "It's time this vile fraud left!",
      "status": "imported"
    },
    "voice_197:r_96bb0dcde0c8c44a": {
      "text": "You monster! Will you never quit?!",
      "status": "imported"
    },
    "voice_197:r_641550a2f54cb456": {
      "text": "Them or us... We will survive!",
      "status": "imported"
    },
    "voice_197:r_a0f2074af8debbfa": {
      "text": "Hayato! Let me handle this one!",
      "status": "imported"
    },
    "voice_197:r_b5f5a97ed82acb0b": {
      "text": "If even you can fight,\\nI'll change!",
      "status": "imported"
    },
    "voice_197:r_76d1e51c8b494a60": {
      "text": "That saves me choosing a target...!",
      "status": "imported"
    },
    "voice_197:r_eb5f687fcd372ae7": {
      "text": "Falling behind changes nothing...!",
      "status": "imported"
    },
    "voice_197:r_2329428a6871d9fa": {
      "text": "Might as well\\nask me to attack...!",
      "status": "imported"
    },
    "voice_197:r_0e7466971bec4cc4": {
      "text": "Where do you think you're running?!",
      "status": "imported"
    },
    "voice_197:r_efa71f7a4cc33ff3": {
      "text": "Defying Getter sealed your fate...!",
      "status": "imported"
    },
    "voice_197:r_3fc2e1186557e7a0": {
      "text": "Koji! Expect their counterattack!",
      "status": "imported"
    },
    "voice_197:r_fa6930340a545054": {
      "text": "I'll be your opponent...!",
      "status": "imported"
    },
    "voice_197:r_2332b9d56461d7ab": {
      "text": "You're wide open, Koji!",
      "status": "imported"
    },
    "voice_197:r_854aa0a91a3c80d1": {
      "text": "Don't rush to your death, Kittan!",
      "status": "imported"
    },
    "voice_197:r_0bc8ae32a406ceab": {
      "text": "You're wide open, Darry!",
      "status": "imported"
    },
    "voice_197:r_d520c6d5298a848d": {
      "text": "Don't get cocky, Gimmy!",
      "status": "imported"
    },
    "voice_197:r_fd910d714be70870": {
      "text": "Koji, don't track them by sight!",
      "status": "imported"
    },
    "voice_197:r_9736f29b11344ec3": {
      "text": "Koji! You're getting predictable!",
      "status": "imported"
    },
    "voice_197:r_fcd05582aa5c6068": {
      "text": "And you dare call yourself a god?!",
      "status": "imported"
    },
    "voice_197:r_bece29562818acba": {
      "text": "That's the King of the Underworld?!",
      "status": "imported"
    },
    "voice_197:r_494b5da92ed24ecb": {
      "text": "Not bad...! But you've far to go!",
      "status": "imported"
    },
    "voice_197:r_a4a5a96f4bd58920": {
      "text": "Draw out more of Mazinger's power!",
      "status": "imported"
    },
    "voice_197:r_b57d2d74233f889a": {
      "text": "Tracking me takes all you've got.",
      "status": "imported"
    },
    "voice_197:r_f16a3eb0bcaac082": {
      "text": "Heh... You've learned the trick...!",
      "status": "imported"
    },
    "voice_197:r_10a408809e512df1": {
      "text": "Koji, don't forget that timing!",
      "status": "imported"
    },
    "voice_197:r_bc7b9e308b879dd4": {
      "text": "Tch!\\nPower fit for that arrogance?!",
      "status": "imported"
    },
    "voice_197:r_98902fd3143c393e": {
      "text": "Hades, King of the Dead...! Strong!",
      "status": "imported"
    },
    "voice_197:r_d907fbd7bc1c4298": {
      "text": "They've adapted to Getter's speed.",
      "status": "imported"
    },
    "voice_197:r_96b21e3a028dd074": {
      "text": "Raise our speed now\\nto 100%.",
      "status": "imported"
    },
    "voice_197:r_a8e85bd950696403": {
      "text": "Yes! Hot heart, cool head!",
      "status": "imported"
    },
    "voice_197:r_772c8bc40ab6cb61": {
      "text": "Koji, don't miss your opening!",
      "status": "imported"
    },
    "voice_197:r_58dd2826a199ef51": {
      "text": "I blew it.\\nMycenae got this far?!",
      "status": "imported"
    },
    "voice_197:r_aadc0b2442adb93b": {
      "text": "Ngh! They'll drag us down to hell?!",
      "status": "imported"
    },
    "voice_197:r_e7a8cd8ed5bc2d1b": {
      "text": "What now? There's no way back!",
      "status": "imported"
    },
    "voice_197:r_041dd920da4a7c17": {
      "text": "Heh... You've exceeded my hopes.",
      "status": "imported"
    },
    "voice_197:r_c7f4280cde4605b3": {
      "text": "Well done, Koji. You pass.",
      "status": "imported"
    },
    "voice_197:r_ec349c8ea9511a18": {
      "text": "You taught Koji? Such a novice...!",
      "status": "imported"
    },
    "voice_197:r_84883aa95f63ce32": {
      "text": "This is combat beyond Mach 1!",
      "status": "imported"
    },
    "voice_197:r_25493e978ce8ff16": {
      "text": "Drill Hurricane!",
      "status": "imported"
    },
    "voice_197:r_7316666150e42960": {
      "text": "There!",
      "status": "imported"
    },
    "voice_197:r_ce1a22dfe3a4d339": {
      "text": "Drill! Hurricaaaaane!",
      "status": "imported"
    },
    "voice_197:r_240651adab81e145": {
      "text": "Raaaaagh!",
      "status": "imported"
    },
    "voice_197:r_cff0deaae73c2858": {
      "text": "I'll use speed to throw them off!",
      "status": "imported"
    },
    "voice_197:r_dca67f68a573fab7": {
      "text": "I'll create an opening!",
      "status": "imported"
    },
    "voice_197:r_a6630215fefaf294": {
      "text": "The finishing blow is yours!",
      "status": "imported"
    },
    "voice_197:r_6f94566ad37f8ff8": {
      "text": "I'll draw their attention to me!",
      "status": "imported"
    },
    "voice_197:r_942ca03c9de80143": {
      "text": "I'll split the enemy with speed!",
      "status": "imported"
    },
    "voice_197:r_d8c669c70659e18a": {
      "text": "Think you're fit to face me?",
      "status": "imported"
    },
    "voice_197:r_8f5bade7ac2db78e": {
      "text": "You can't dodge me by watching!",
      "status": "imported"
    },
    "voice_197:r_05ea490d2f522520": {
      "text": "I'll leave the other one to you!",
      "status": "imported"
    }
  }
}
