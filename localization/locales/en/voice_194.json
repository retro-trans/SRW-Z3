{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_194:r_479b340ccc6c572b": {
      "text": "Eat this!",
      "status": "imported"
    },
    "voice_194:r_ca4acbac57a2a35e": {
      "text": "You're mine!!",
      "status": "imported"
    },
    "voice_194:r_77949221bf58f862": {
      "text": "I'll destroy the target!",
      "status": "imported"
    },
    "voice_194:r_70b9c4b9f1f37eff": {
      "text": "I'm going in!",
      "status": "imported"
    },
    "voice_194:r_9fcb3754cb1773c7": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_194:r_3559d2fad32c2435": {
      "text": "You won't get away!",
      "status": "imported"
    },
    "voice_194:r_f7570547e9f80a64": {
      "text": "I'll knock you out of the sky!",
      "status": "imported"
    },
    "voice_194:r_cbab0f4720e1fcf1": {
      "text": "I'll hit you!",
      "status": "imported"
    },
    "voice_194:r_0bbe0b4f5364e732": {
      "text": "I've got you in my sights!",
      "status": "imported"
    },
    "voice_194:r_5dda5198137cb02a": {
      "text": "I won't miss!",
      "status": "imported"
    },
    "voice_194:r_83ec59afbecdec14": {
      "text": "There!",
      "status": "imported"
    },
    "voice_194:r_e20bfd42ad95a3c9": {
      "text": "I'll finish you off!",
      "status": "imported"
    },
    "voice_194:r_0f58a8822381e57f": {
      "text": "If we shoot Gundam down!",
      "status": "imported"
    },
    "voice_194:r_6dbcc507fb61b51d": {
      "text": "I won't let Gundam have its way!",
      "status": "imported"
    },
    "voice_194:r_b42ab697149a7c8a": {
      "text": "Monster! I won't let you prevail!",
      "status": "imported"
    },
    "voice_194:r_4de4fcf3b440baf4": {
      "text": "We'll protect Earth ourselves!",
      "status": "imported"
    },
    "voice_194:r_0121a166c715cdff": {
      "text": "I'll cover you!",
      "status": "imported"
    },
    "voice_194:r_30fad37a42bd3ad3": {
      "text": "Follow it up with another attack!",
      "status": "imported"
    },
    "voice_194:r_80a0b2a84e05d81a": {
      "text": "I won't let you!",
      "status": "imported"
    },
    "voice_194:r_4a9ac1dff86506d9": {
      "text": "Leave this to me!",
      "status": "imported"
    },
    "voice_194:r_bc8538e6af3d2577": {
      "text": "Damn, I can't counterattack!",
      "status": "imported"
    },
    "voice_194:r_924516c8de2b5342": {
      "text": "This is a bad situation!",
      "status": "imported"
    },
    "voice_194:r_da1174533722333f": {
      "text": "I can't counterattack?!",
      "status": "imported"
    },
    "voice_194:r_fdeb8162976e72c1": {
      "text": "Like I'd let that hit me!",
      "status": "imported"
    },
    "voice_194:r_0fadb5c26df92b42": {
      "text": "What are you aiming at?!",
      "status": "imported"
    },
    "voice_194:r_6b15af9a0057cdc8": {
      "text": "All right, I dodged it!",
      "status": "imported"
    },
    "voice_194:r_15b4a90140e8a33a": {
      "text": "That's nothing!",
      "status": "imported"
    },
    "voice_194:r_ac6fe7838e95647b": {
      "text": "All right, I blocked it!",
      "status": "imported"
    },
    "voice_194:r_77ca87eacd17ad52": {
      "text": "It hit my shield!",
      "status": "imported"
    },
    "voice_194:r_bf3244994760e535": {
      "text": "Damn! Was my movement too direct?!",
      "status": "imported"
    },
    "voice_194:r_aabfb21c9d069ce7": {
      "text": "Damage this minor is no concern!",
      "status": "imported"
    },
    "voice_194:r_02479dc8fe989560": {
      "text": "Damn, I couldn't dodge it all!",
      "status": "imported"
    },
    "voice_194:r_a2df00f91a9b0a9e": {
      "text": "Hmph, is that all?!",
      "status": "imported"
    },
    "voice_194:r_48b60d6c48b9b142": {
      "text": "Gundam!\\nYour era is over!",
      "status": "imported"
    },
    "voice_194:r_8927e6fb681aa809": {
      "text": "Gundam, still getting in our way?!",
      "status": "imported"
    },
    "voice_194:r_665f01666859013b": {
      "text": "Ngh! You just won't give up!",
      "status": "imported"
    },
    "voice_194:r_a571eec59b258d11": {
      "text": "I-I can't be shot down here!",
      "status": "imported"
    },
    "voice_194:r_ddbe581c5ea9183d": {
      "text": "Damn you all! Still resisting?!",
      "status": "imported"
    },
    "voice_194:r_faae935cca0edc72": {
      "text": "Gundam! You never learn!!",
      "status": "imported"
    },
    "voice_194:r_d4430bf362340b32": {
      "text": "G-Gundam is a threat after all!!",
      "status": "imported"
    },
    "voice_194:r_6ff1323b355593e0": {
      "text": "I-I can't hold out any longer!!",
      "status": "imported"
    },
    "voice_194:r_b7b5625d7cd4282f": {
      "text": "You failed to finish me off!",
      "status": "imported"
    },
    "voice_194:r_36133ad73a73ef98": {
      "text": "Urgh!\\nI can't let it end here!",
      "status": "imported"
    },
    "voice_194:r_920740a0219c5085": {
      "text": "Gaaah! Th-this damage!",
      "status": "imported"
    },
    "voice_194:r_a8451712c57c1a72": {
      "text": "C-Can't we defeat Gundam?!",
      "status": "imported"
    },
    "voice_194:r_3633df5b7b8f47fa": {
      "text": "S-So this is Gundam's power!",
      "status": "imported"
    },
    "voice_194:r_52dfc56b14b93551": {
      "text": "Aaaaaagh!!",
      "status": "imported"
    },
    "voice_194:r_1b9b2aab5cb104da": {
      "text": "Gah! Impossible!!",
      "status": "imported"
    },
    "voice_194:r_342044c706a2340f": {
      "text": "E-Eject!!",
      "status": "imported"
    },
    "voice_194:r_cf41e8828a90cbdb": {
      "text": "D-Damn it!!",
      "status": "imported"
    },
    "voice_194:r_55417493fce1d347": {
      "text": "Here I come, Gundam!",
      "status": "imported"
    },
    "voice_194:r_24cf161287ef9d5c": {
      "text": "Now it's payback!",
      "status": "imported"
    },
    "voice_194:r_8f60f6fc86db3107": {
      "text": "I can still fight!",
      "status": "imported"
    },
    "voice_194:r_b1de76a75a253c13": {
      "text": "Now! Finish them off!",
      "status": "imported"
    },
    "voice_194:r_128c35bf3e0e394c": {
      "text": "Not yet! I can still fight!",
      "status": "imported"
    },
    "voice_194:r_5213c17e13b23de0": {
      "text": "A-A direct hit?!",
      "status": "imported"
    },
    "voice_194:r_38fdff9483e9245c": {
      "text": "I can't afford another hit!",
      "status": "imported"
    },
    "voice_194:r_620fedec67706d7d": {
      "text": "Your aim is sloppy!",
      "status": "imported"
    },
    "voice_194:r_9680dcd0fddcfcc7": {
      "text": "It's no use!",
      "status": "imported"
    },
    "voice_194:r_2a00f1044ad5cbaa": {
      "text": "That won't work on me!",
      "status": "imported"
    },
    "voice_194:r_46e86d000250e137": {
      "text": "So I'm out of options?!",
      "status": "imported"
    },
    "voice_194:r_ac341e7976e88f0b": {
      "text": "Is retreat my only option?!",
      "status": "imported"
    },
    "voice_194:r_cdbd128a5b4127cc": {
      "text": "This'll do it!",
      "status": "imported"
    },
    "voice_194:r_cfccaa1fbeda124c": {
      "text": "Raaagh!",
      "status": "imported"
    },
    "voice_194:r_b1f8ec192b9c083a": {
      "text": "Fall!",
      "status": "imported"
    }
  }
}
