{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_173:r_479b340ccc6c572b": {
      "text": "How's that!",
      "status": "imported"
    },
    "voice_173:r_ca4acbac57a2a35e": {
      "text": "All right! Now!",
      "status": "imported"
    },
    "voice_173:r_77949221bf58f862": {
      "text": "There you are! You won't get away!",
      "status": "imported"
    },
    "voice_173:r_70b9c4b9f1f37eff": {
      "text": "I'll teach you a lesson!",
      "status": "imported"
    },
    "voice_173:r_9fcb3754cb1773c7": {
      "text": "Here I go! Take this!",
      "status": "imported"
    },
    "voice_173:r_3559d2fad32c2435": {
      "text": "I'll show you Trider's power!",
      "status": "imported"
    },
    "voice_173:r_f7570547e9f80a64": {
      "text": "Mieko Sensei, watch me!",
      "status": "imported"
    },
    "voice_173:r_cbab0f4720e1fcf1": {
      "text": "This'll settle it!",
      "status": "imported"
    },
    "voice_173:r_0bbe0b4f5364e732": {
      "text": "Why, you... Just you watch!",
      "status": "imported"
    },
    "voice_173:r_80a0b2a84e05d81a": {
      "text": "Trider Cutter!",
      "status": "imported"
    },
    "voice_173:r_4a9ac1dff86506d9": {
      "text": "Take this! Trider Cutter!",
      "status": "imported"
    },
    "voice_173:r_bc8538e6af3d2577": {
      "text": "Trider Missile!",
      "status": "imported"
    },
    "voice_173:r_924516c8de2b5342": {
      "text": "Missile attack!",
      "status": "imported"
    },
    "voice_173:r_da1174533722333f": {
      "text": "This time, it's my turn!",
      "status": "imported"
    },
    "voice_173:r_fdeb8162976e72c1": {
      "text": "All right, leave it to Trider!",
      "status": "imported"
    },
    "voice_173:r_0fadb5c26df92b42": {
      "text": "Wait! Keep your hands off my crew!",
      "status": "imported"
    },
    "voice_173:r_6b15af9a0057cdc8": {
      "text": "What the... I can't do a thing!",
      "status": "imported"
    },
    "voice_173:r_15b4a90140e8a33a": {
      "text": "W-Why can't I counterattack?",
      "status": "imported"
    },
    "voice_173:r_aabfb21c9d069ce7": {
      "text": "Whoa there!",
      "status": "imported"
    },
    "voice_173:r_02479dc8fe989560": {
      "text": "And... hup!",
      "status": "imported"
    },
    "voice_173:r_a2df00f91a9b0a9e": {
      "text": "Heh, pipe down on the sidelines!",
      "status": "imported"
    },
    "voice_173:r_48b60d6c48b9b142": {
      "text": "That was close! What're you doing?!",
      "status": "imported"
    },
    "voice_173:r_8927e6fb681aa809": {
      "text": "Like I'd let that hit me!",
      "status": "imported"
    },
    "voice_173:r_665f01666859013b": {
      "text": "This is easy! Easy!",
      "status": "imported"
    },
    "voice_173:r_a571eec59b258d11": {
      "text": "So what?!",
      "status": "imported"
    },
    "voice_173:r_ddbe581c5ea9183d": {
      "text": "That's Tetsu for you! Nice work!",
      "status": "imported"
    },
    "voice_173:r_d4430bf362340b32": {
      "text": "This is nothing!",
      "status": "imported"
    },
    "voice_173:r_6ff1323b355593e0": {
      "text": "You got me!",
      "status": "imported"
    },
    "voice_173:r_b7b5625d7cd4282f": {
      "text": "Nngh! Fight! Fight!",
      "status": "imported"
    },
    "voice_173:r_36133ad73a73ef98": {
      "text": "That attack?\\nWatta Takeo's a man!",
      "status": "imported"
    },
    "voice_173:r_920740a0219c5085": {
      "text": "This much is nothing!",
      "status": "imported"
    },
    "voice_173:r_a8451712c57c1a72": {
      "text": "Tetsu tuned Trider!\\nIt won't budge!",
      "status": "imported"
    },
    "voice_173:r_3633df5b7b8f47fa": {
      "text": "What's a scratch like this?!",
      "status": "imported"
    },
    "voice_173:r_52dfc56b14b93551": {
      "text": "You won't beat me!",
      "status": "imported"
    },
    "voice_173:r_1b9b2aab5cb104da": {
      "text": "This is nothing! I'm fine!",
      "status": "imported"
    },
    "voice_173:r_342044c706a2340f": {
      "text": "Damn, that was slick... You'll pay!",
      "status": "imported"
    },
    "voice_173:r_cf41e8828a90cbdb": {
      "text": "Why, you! I'll knock you flat!",
      "status": "imported"
    },
    "voice_173:r_719e897304ec42d4": {
      "text": "Not bad! Trider\\nwon't lose to this!",
      "status": "imported"
    },
    "voice_173:r_d5e0a2317c40d322": {
      "text": "How dare you!\\nNo forgiveness!",
      "status": "imported"
    },
    "voice_173:r_ec2ea17765052401": {
      "text": "Damn, you got me!\\nThanks a lot!",
      "status": "imported"
    },
    "voice_173:r_f2d4255f1c2f7542": {
      "text": "Oww!\\nQuit it or I'll get really mad!",
      "status": "imported"
    },
    "voice_173:r_5d08ad19e2da125b": {
      "text": "Whoa! You got me!",
      "status": "imported"
    },
    "voice_173:r_a7246b52782a877e": {
      "text": "W-What a monster!",
      "status": "imported"
    },
    "voice_173:r_dc8701f6bcb9904f": {
      "text": "Why, you! Who'll repair all this?!",
      "status": "imported"
    },
    "voice_173:r_d6bdd730f24f66eb": {
      "text": "All or nothing, huh... All right!",
      "status": "imported"
    },
    "voice_173:r_41997412868c48c4": {
      "text": "Damn! What incredible power!",
      "status": "imported"
    },
    "voice_173:r_9e6cf4f389dae55c": {
      "text": "For my whole crew...\\nI won't lose!",
      "status": "imported"
    },
    "voice_173:r_9e0c80ac7e33b459": {
      "text": "Dad's Trider...\\nIt won't lose!",
      "status": "imported"
    },
    "voice_173:r_7432ef43ed3471dc": {
      "text": "Damn you!\\nI won't quit here!",
      "status": "imported"
    },
    "voice_173:r_065443f6ddfcf0d7": {
      "text": "I'm cornered...\\nTime for a comeback!",
      "status": "imported"
    },
    "voice_173:r_47d52a2839c71715": {
      "text": "Gwaaah! Why, you!",
      "status": "imported"
    },
    "voice_173:r_847f82e7f3eef651": {
      "text": "Aaaaagh!",
      "status": "imported"
    },
    "voice_173:r_eb7ae28b53dc033c": {
      "text": "D-Damn it!",
      "status": "imported"
    },
    "voice_173:r_857c4a52ce8df0fd": {
      "text": "It's no use...",
      "status": "imported"
    },
    "voice_173:r_55417493fce1d347": {
      "text": "Aaaaaaaaagh!",
      "status": "imported"
    },
    "voice_173:r_8fdf5910927c9591": {
      "text": "S-Sorry, Tetsu!\\nI wrecked Trider!",
      "status": "imported"
    },
    "voice_173:r_7d724dbcc4451e10": {
      "text": "Safety check!",
      "status": "imported"
    },
    "voice_173:r_93e25418a203cb8f": {
      "text": "Launch!",
      "status": "imported"
    },
    "voice_173:r_adeb0a29274d3d9b": {
      "text": "Safety check! Launch!",
      "status": "imported"
    },
    "voice_173:r_24cf161287ef9d5c": {
      "text": "Trider Biiird...\\nAttaaack!",
      "status": "imported"
    },
    "voice_173:r_8f60f6fc86db3107": {
      "text": "Let's go, Trider!",
      "status": "imported"
    },
    "voice_173:r_b1de76a75a253c13": {
      "text": "Now, the great Watta will face you!",
      "status": "imported"
    },
    "voice_173:r_128c35bf3e0e394c": {
      "text": "I won't go easy on you!",
      "status": "imported"
    },
    "voice_173:r_5213c17e13b23de0": {
      "text": "Boarding G7 again today! Hup!",
      "status": "imported"
    },
    "voice_173:r_38fdff9483e9245c": {
      "text": "Our company is prompt and thorough!",
      "status": "imported"
    },
    "voice_173:r_620fedec67706d7d": {
      "text": "Space is my yard!\\nHere I go!",
      "status": "imported"
    },
    "voice_173:r_9680dcd0fddcfcc7": {
      "text": "Let's wrap this up and do homework!",
      "status": "imported"
    },
    "voice_173:r_2a00f1044ad5cbaa": {
      "text": "Back now,\\nor Daimon Sensei erupts!",
      "status": "imported"
    },
    "voice_173:r_3dbeead1bd3164ef": {
      "text": "Wait, Mieko Sensei!\\nI'll be back!",
      "status": "imported"
    },
    "voice_173:r_98d15b8cc09bc915": {
      "text": "Once I get close, I've got you!",
      "status": "imported"
    },
    "voice_173:r_46e86d000250e137": {
      "text": "Only one thing left-charge!",
      "status": "imported"
    },
    "voice_173:r_ac341e7976e88f0b": {
      "text": "Not yet!\\nThat wasn't the end!",
      "status": "imported"
    },
    "voice_173:r_cdbd128a5b4127cc": {
      "text": "Damn it! You stubborn fool!",
      "status": "imported"
    },
    "voice_173:r_b1f8ec192b9c083a": {
      "text": "Gotta avoid hitting the cockpit!",
      "status": "imported"
    },
    "voice_173:r_ddafde4b065ced49": {
      "text": "I won't lose to someone on orders!",
      "status": "imported"
    },
    "voice_173:r_3304412ac41f47a6": {
      "text": "Soldiers fight\\nfor a living, but...!",
      "status": "imported"
    },
    "voice_173:r_a2afffe1c396f0b3": {
      "text": "Super robot showdown!\\nI can't lose!",
      "status": "imported"
    },
    "voice_173:r_13c25fbdfddc8a24": {
      "text": "Let's fight, Mechanical Beast!",
      "status": "imported"
    },
    "voice_173:r_42ba1ecb310b4bd7": {
      "text": "Down, Mechanical Beast!",
      "status": "imported"
    },
    "voice_173:r_d692f1d420460a47": {
      "text": "Here I come, Heterodyne!",
      "status": "imported"
    },
    "voice_173:r_a5643cec86b18bd2": {
      "text": "Heterodynes...\\nI can't read them...",
      "status": "imported"
    },
    "voice_173:r_68f2dfab20a4a30e": {
      "text": "For ships,\\nour Shuttle's the best!",
      "status": "imported"
    },
    "voice_173:r_9cedad8237480563": {
      "text": "Don't think size alone wins fights!",
      "status": "imported"
    },
    "voice_173:r_a03fabecba1508ca": {
      "text": "Watta never flinches from monsters!",
      "status": "imported"
    },
    "voice_173:r_5391b24a71eb10ae": {
      "text": "Time for Trider to hunt monsters!",
      "status": "imported"
    },
    "voice_173:r_a554ceef5c87b972": {
      "text": "Leave monster extermination to us!",
      "status": "imported"
    },
    "voice_173:r_546c3d5937fbb7ee": {
      "text": "So that's the big boss! All right!",
      "status": "imported"
    },
    "voice_173:r_1568ff6298b12b96": {
      "text": "Evil boss!\\nI'll punish you! Brace!",
      "status": "imported"
    },
    "voice_173:r_2c9d94ba13c5fc50": {
      "text": "Last battle!\\nI'll end it by winning!",
      "status": "imported"
    },
    "voice_173:r_a77f4913375098d2": {
      "text": "Final bout!\\nForget the expenses!",
      "status": "imported"
    },
    "voice_173:r_8a29278549f8e07a": {
      "text": "Try catching my miracle pitch!",
      "status": "imported"
    },
    "voice_173:r_7e6c573c26177f98": {
      "text": "Trider Saber!",
      "status": "imported"
    },
    "voice_173:r_45abf84f7757d6eb": {
      "text": "Heeere I go!",
      "status": "imported"
    },
    "voice_173:r_edd7a13ab8f06a14": {
      "text": "This settles it!",
      "status": "imported"
    },
    "voice_173:r_8165e5b41f0124c4": {
      "text": "All right! Time for the Saber!",
      "status": "imported"
    },
    "voice_173:r_4e05581b7432cce8": {
      "text": "I'll fillet you into three pieces!",
      "status": "imported"
    },
    "voice_173:r_a60b107ea3c36a86": {
      "text": "And that's another order served!",
      "status": "imported"
    },
    "voice_173:r_e33693e5ba4665b0": {
      "text": "I learned kendo from Daimon Sensei!",
      "status": "imported"
    },
    "voice_173:r_72a21a1a489af001": {
      "text": "Wrist! Torso! Heeead!!",
      "status": "imported"
    },
    "voice_173:r_eb643f8bf737a0ca": {
      "text": "One more for good measure! Torsooo!",
      "status": "imported"
    },
    "voice_173:r_0a3fccb71ec6cf2a": {
      "text": "Trider Beam Cannon!",
      "status": "imported"
    },
    "voice_173:r_9b63cf1f3e0207ef": {
      "text": "Take that! And that! And thaaat!",
      "status": "imported"
    },
    "voice_173:r_8356f4e3dcdff938": {
      "text": "Hit 'em!",
      "status": "imported"
    },
    "voice_173:r_1d6d784036ae0bd7": {
      "text": "I'll aim with the Beam Cannon!",
      "status": "imported"
    },
    "voice_173:r_625664af02183c17": {
      "text": "Hope every shot hits!",
      "status": "imported"
    },
    "voice_173:r_3701cba361f80ea5": {
      "text": "Hyaa! How's that!",
      "status": "imported"
    },
    "voice_173:r_63f429c5c68c0863": {
      "text": "That western!\\nIt was so cool!",
      "status": "imported"
    },
    "voice_173:r_38e4a434c91d8ef0": {
      "text": "Pew! Pew! Pew!",
      "status": "imported"
    },
    "voice_173:r_98ed411352a3a6ac": {
      "text": "Peeeew!",
      "status": "imported"
    },
    "voice_173:r_4824bea6bab3af67": {
      "text": "Trider Javelin!",
      "status": "imported"
    },
    "voice_173:r_862b92e63adb9734": {
      "text": "Hyaaaah!",
      "status": "imported"
    },
    "voice_173:r_cb306ef55e49d107": {
      "text": "Hah! Horyaaaa!",
      "status": "imported"
    },
    "voice_173:r_57b2bd2de8a1408d": {
      "text": "See the great Watta's spear skills!",
      "status": "imported"
    },
    "voice_173:r_76f080a4881e8ab5": {
      "text": "Take thaaat!!",
      "status": "imported"
    },
    "voice_173:r_288133bc5b573dae": {
      "text": "Trider Javelin!!",
      "status": "imported"
    },
    "voice_173:r_6f95653e548f8fcf": {
      "text": "Come out, Javelin!",
      "status": "imported"
    },
    "voice_173:r_d249d68bada91ab9": {
      "text": "Haaaaah!",
      "status": "imported"
    },
    "voice_173:r_e9b3307e9eb69f11": {
      "text": "Take that! Had enough?!",
      "status": "imported"
    },
    "voice_173:r_03cdac73042343ee": {
      "text": "Finishing blow!",
      "status": "imported"
    },
    "voice_173:r_981f8fedd5414fe5": {
      "text": "I'll show you my ace in the hole!!",
      "status": "imported"
    },
    "voice_173:r_641550a2f54cb456": {
      "text": "Trider's finishing move!",
      "status": "imported"
    },
    "voice_173:r_b5f5a97ed82acb0b": {
      "text": "Why, you! Here's some payback!",
      "status": "imported"
    },
    "voice_173:r_d9cd2e4ded064396": {
      "text": "How dare you do that!",
      "status": "imported"
    },
    "voice_173:r_99e6349431aaf23b": {
      "text": "Next time, I'll attack first!",
      "status": "imported"
    },
    "voice_173:r_ec1081caf845f56a": {
      "text": "You punk! A hit for a hit!",
      "status": "imported"
    },
    "voice_173:r_2c5b7ee872c1ed7f": {
      "text": "Watta won't end\\nwithout payback!!",
      "status": "imported"
    },
    "voice_173:r_76d1e51c8b494a60": {
      "text": "Here's your change!",
      "status": "imported"
    },
    "voice_173:r_eb5f687fcd372ae7": {
      "text": "Don't forget the great Watta!",
      "status": "imported"
    },
    "voice_173:r_2329428a6871d9fa": {
      "text": "Here's a bonus! Take this too!",
      "status": "imported"
    },
    "voice_173:r_0e7466971bec4cc4": {
      "text": "Way to go, Director! Nice assist!",
      "status": "imported"
    },
    "voice_173:r_efa71f7a4cc33ff3": {
      "text": "That's Tetsu for you! So dependable!",
      "status": "imported"
    },
    "voice_173:r_3fc2e1186557e7a0": {
      "text": "Kinoshita!\\nDirector hates waste!",
      "status": "imported"
    },
    "voice_173:r_fa6930340a545054": {
      "text": "Watch me in action, Ikue!",
      "status": "imported"
    },
    "voice_173:r_2332b9d56461d7ab": {
      "text": "Leave the rest to the president!",
      "status": "imported"
    },
    "voice_173:r_854aa0a91a3c80d1": {
      "text": "A super robot!\\nWhat power!",
      "status": "imported"
    },
    "voice_173:r_0bc8ae32a406ceab": {
      "text": "Our rival company is an ally now!",
      "status": "imported"
    },
    "voice_173:r_82c09f011d703b2c": {
      "text": "Gundam, then Trider!\\nCommon sense!",
      "status": "imported"
    },
    "voice_173:r_2b4d8818c77b6dca": {
      "text": "The cavalry's here!",
      "status": "imported"
    },
    "voice_173:r_087354f2db0a31e6": {
      "text": "Director gets too fired up!",
      "status": "imported"
    },
    "voice_173:r_db02a2dec93dd263": {
      "text": "Get out while you can, Tetsu!",
      "status": "imported"
    },
    "voice_173:r_d520c6d5298a848d": {
      "text": "What're you doing, Kinoshita?!",
      "status": "imported"
    },
    "voice_173:r_099e2458cabf796f": {
      "text": "I won't let you hurt Ikue!!",
      "status": "imported"
    },
    "voice_173:r_fd910d714be70870": {
      "text": "A president guards his staff!\\nHyaa!",
      "status": "imported"
    },
    "voice_173:r_9736f29b11344ec3": {
      "text": "Salarymen have to help each other!",
      "status": "imported"
    },
    "voice_173:r_fcd05582aa5c6068": {
      "text": "Grrrr... I'll let you off this time!",
      "status": "imported"
    },
    "voice_173:r_bece29562818acba": {
      "text": "Damn! I can't attack?!",
      "status": "imported"
    },
    "voice_173:r_494b5da92ed24ecb": {
      "text": "Cut costs now? You gotta be kidding!",
      "status": "imported"
    },
    "voice_173:r_a4a5a96f4bd58920": {
      "text": "Damn it! Come over here and fight!",
      "status": "imported"
    },
    "voice_173:r_b57d2d74233f889a": {
      "text": "Where'd that punk disappear to?!",
      "status": "imported"
    },
    "voice_173:r_cd06d0820d82524b": {
      "text": "Piece of cake!",
      "status": "imported"
    },
    "voice_173:r_c94c6d04be583774": {
      "text": "Hey! That's Trider! What a stud!",
      "status": "imported"
    },
    "voice_173:r_e54e2c99ef8297af": {
      "text": "Swing and a miss! You're out!",
      "status": "imported"
    },
    "voice_173:r_f16a3eb0bcaac082": {
      "text": "Mechanical Beasts\\nAll bark, no bite!",
      "status": "imported"
    },
    "voice_173:r_10a408809e512df1": {
      "text": "Serves you right, Mechanical Beast!",
      "status": "imported"
    },
    "voice_173:r_bc7b9e308b879dd4": {
      "text": "Heterodynes are a piece of cake!",
      "status": "imported"
    },
    "voice_173:r_98902fd3143c393e": {
      "text": "Trider won't lose\\nto a Heterodyne!",
      "status": "imported"
    },
    "voice_173:r_d907fbd7bc1c4298": {
      "text": "Looks gross,\\nbut isn't so tough.",
      "status": "imported"
    },
    "voice_173:r_96b21e3a028dd074": {
      "text": "Like I'd let a monster catch me!",
      "status": "imported"
    },
    "voice_173:r_ce140b5d8e6b7310": {
      "text": "Monsters don't scare me!",
      "status": "imported"
    },
    "voice_173:r_0e0335789c5396d7": {
      "text": "Remember!\\nEarth has Trider!",
      "status": "imported"
    },
    "voice_173:r_a8e85bd950696403": {
      "text": "Heh, psychic?\\nGo bend spoons!",
      "status": "imported"
    },
    "voice_173:r_772c8bc40ab6cb61": {
      "text": "So big, yet so pathetic!",
      "status": "imported"
    },
    "voice_173:r_58dd2826a199ef51": {
      "text": "Small fry can swarm,\\nTrider wins!",
      "status": "imported"
    },
    "voice_173:r_e7a8cd8ed5bc2d1b": {
      "text": "Damn!\\nMore repair costs!",
      "status": "imported"
    },
    "voice_173:r_041dd920da4a7c17": {
      "text": "That's Trider!\\nNo effect!",
      "status": "imported"
    },
    "voice_173:r_c7f4280cde4605b3": {
      "text": "No dirt!\\nTrider's too handsome!",
      "status": "imported"
    },
    "voice_173:r_ec349c8ea9511a18": {
      "text": "Damn Mechanical Beast!",
      "status": "imported"
    },
    "voice_173:r_33236ffa3ea95b68": {
      "text": "Mechanical Beast, what'd you do?!",
      "status": "imported"
    },
    "voice_173:r_689d0b123de71ae0": {
      "text": "Damn you, Heterodyne!",
      "status": "imported"
    },
    "voice_173:r_84883aa95f63ce32": {
      "text": "I won't let some monster eat me!",
      "status": "imported"
    },
    "voice_173:r_25493e978ce8ff16": {
      "text": "Ugh, it's grosser up close...",
      "status": "imported"
    },
    "voice_173:r_7316666150e42960": {
      "text": "Heh! Big deal if you're psychic!",
      "status": "imported"
    },
    "voice_173:r_c4f11aa93dc5b668": {
      "text": "Big body, puny attacks!",
      "status": "imported"
    },
    "voice_173:r_ce1a22dfe3a4d339": {
      "text": "Swarming like bugs!\\nSo annoying!",
      "status": "imported"
    },
    "voice_173:r_cff0deaae73c2858": {
      "text": "Tch! Heterodyne\\ncan't be billed.",
      "status": "imported"
    },
    "voice_173:r_dca67f68a573fab7": {
      "text": "Come on!\\nDirector will nag me!",
      "status": "imported"
    },
    "voice_173:r_a6630215fefaf294": {
      "text": "Tougher foes fire me up even more!",
      "status": "imported"
    },
    "voice_173:r_6f94566ad37f8ff8": {
      "text": "No Mechanical Beast will beat me!",
      "status": "imported"
    },
    "voice_173:r_942ca03c9de80143": {
      "text": "That Mechanical Beast is tough!",
      "status": "imported"
    },
    "voice_173:r_d8c669c70659e18a": {
      "text": "Heterodyne,\\nrunning wild!",
      "status": "imported"
    },
    "voice_173:r_8f5bade7ac2db78e": {
      "text": "Ngh!\\nI must stop the Heterodyne...!",
      "status": "imported"
    },
    "voice_173:r_05ea490d2f522520": {
      "text": "No more monster rampages!",
      "status": "imported"
    },
    "voice_173:r_f5658c702d91db7a": {
      "text": "Whoa!\\nThe hunter can't get hunted!",
      "status": "imported"
    },
    "voice_173:r_686df329b50f195b": {
      "text": "Hey! You! Settle down!!",
      "status": "imported"
    },
    "voice_173:r_25f0ab0fa3cf690c": {
      "text": "Repair bill:\\nmailed to your planet!",
      "status": "imported"
    },
    "voice_173:r_b708a1d959013dbf": {
      "text": "Great super robot!\\nBut Trider wins!",
      "status": "imported"
    },
    "voice_173:r_59fca03e929366c1": {
      "text": "Trider's invincible!\\nIt won't fall!!",
      "status": "imported"
    },
    "voice_173:r_0d65eb631dcb7514": {
      "text": "Can't lose! Pay... No!\\nWorld peace!",
      "status": "imported"
    },
    "voice_173:r_d03018a31e23f1e9": {
      "text": "Mechanical Beast...\\nDid all this?!",
      "status": "imported"
    },
    "voice_173:r_279da5f732aa8847": {
      "text": "Damn!\\nWhat did that Heterodyne do?!",
      "status": "imported"
    },
    "voice_173:r_97f82e3cb6f70110": {
      "text": "Damn!\\nLooks and power-monster class!",
      "status": "imported"
    },
    "voice_173:r_c5611d8dd6def96b": {
      "text": "Damn!\\nNo time to be grossed out!",
      "status": "imported"
    },
    "voice_173:r_6f12cc8ed2732eb5": {
      "text": "Aaaaagh!! Everyone, I'm sorry!!",
      "status": "imported"
    },
    "voice_173:r_7abfc55f8fb62ba7": {
      "text": "President! We have work! President!",
      "status": "imported"
    },
    "voice_173:r_99e7a66c650b5892": {
      "text": "Do your best!",
      "status": "imported"
    },
    "voice_173:r_5b2247b5cfbcd7b2": {
      "text": "Young President!",
      "status": "imported"
    },
    "voice_173:r_2d7a9c06347582d9": {
      "text": "Like it? Next: Earth in peril again!",
      "status": "imported"
    },
    "voice_173:r_bf953d64c3c7d9b7": {
      "text": "Our strongest, vilest foe appears!",
      "status": "imported"
    },
    "voice_173:r_e09b933e3e706779": {
      "text": "Trider and I have to save the day!",
      "status": "imported"
    },
    "voice_173:r_66236eb99b676e5b": {
      "text": "Next SRW Z3: Save Earth, Young Boss!",
      "status": "imported"
    },
    "voice_173:r_9639a2dbcd2f58ed": {
      "text": "Be sure to play it!",
      "status": "imported"
    },
    "voice_173:r_aeea0893acb93d35": {
      "text": "Hey! Like it? I'm next week's star!",
      "status": "imported"
    },
    "voice_173:r_b31568654e53487b": {
      "text": "Earth's in peril! Our firm too!",
      "status": "imported"
    },
    "voice_173:r_2502132569141ea3": {
      "text": "But Trider and I never give up!",
      "status": "imported"
    },
    "voice_173:r_1ff312798a52c8eb": {
      "text": "Next SRW Z3: Beat Slumps and Foes!",
      "status": "imported"
    },
    "voice_173:r_fa07d90fca62f593": {
      "text": "I know! Give us one to fire us up!",
      "status": "imported"
    },
    "voice_173:r_a25bf2676ecf9d83": {
      "text": "Leave it to me!",
      "status": "imported"
    },
    "voice_173:r_237a0288b42dce20": {
      "text": "Let's go! Trider!",
      "status": "imported"
    },
    "voice_173:r_0556e8a22779ea8e": {
      "text": "Gotta finish this job fast!",
      "status": "imported"
    },
    "voice_173:r_09d377101a48d92a": {
      "text": "Let's do this all at once!",
      "status": "imported"
    },
    "voice_173:r_11517cc7b0494dbf": {
      "text": "Mechanical Beast, prepare yourself!",
      "status": "imported"
    },
    "voice_173:r_2970a83693cdcc25": {
      "text": "I won't let you escape!",
      "status": "imported"
    },
    "voice_173:r_be661448b85d0009": {
      "text": "Now it's our turn!",
      "status": "imported"
    },
    "voice_173:r_958a56c1151cab9e": {
      "text": "Hah! One more!",
      "status": "imported"
    },
    "voice_173:r_8b18aa4cc69547df": {
      "text": "You can still go, Trider!",
      "status": "imported"
    },
    "voice_173:r_3e87f6fc3ea65aef": {
      "text": "You hurt my crew!\\nThanks a lot!",
      "status": "imported"
    },
    "voice_173:r_5508a7bfa9074eb9": {
      "text": "Our chance!\\nI won't waste it!",
      "status": "imported"
    },
    "voice_173:r_09a003e91f0d5dc7": {
      "text": "You think one shot is all I have?",
      "status": "imported"
    },
    "voice_173:r_192447448ebd7bb5": {
      "text": "I-I'm done for! Ejecting!",
      "status": "imported"
    },
    "voice_173:r_e92920ba4b301b9f": {
      "text": "Waaah! D-Dad...!",
      "status": "imported"
    },
    "voice_173:r_207b256d613bb896": {
      "text": "Gah! N-No good...\\nD-Daaamn it!",
      "status": "imported"
    },
    "voice_173:r_a6fd676d8146501b": {
      "text": "D-Damn it...!",
      "status": "imported"
    },
    "voice_173:r_94d35e5fa8e3a198": {
      "text": "Dad's Trider!\\nI won't let it break!",
      "status": "imported"
    },
    "voice_173:r_b686510e636673f3": {
      "text": "How dare you do that!",
      "status": "imported"
    },
    "voice_173:r_59369bad143d4272": {
      "text": "Waaah! Somebody do something!",
      "status": "imported"
    },
    "voice_173:r_25f9b1e39dd8d366": {
      "text": "Y-You blew Trider away...?!",
      "status": "imported"
    },
    "voice_173:r_307477bedd148060": {
      "text": "Goddamn it!",
      "status": "imported"
    },
    "voice_173:r_09a780acca0eb4b0": {
      "text": "Cut me some slack!\\nI'm just a kid!",
      "status": "imported"
    },
    "voice_173:r_af62f2ee466b5c8c": {
      "text": "Hmph! It only grazed me!",
      "status": "imported"
    },
    "voice_173:r_20cfb719db02fafd": {
      "text": "Sorry, Tetsu. I got hit...",
      "status": "imported"
    },
    "voice_173:r_570c1fdf72edb283": {
      "text": "We did it, Trider!",
      "status": "imported"
    },
    "voice_173:r_23f0d87a5a6cfca1": {
      "text": "Heh heh! You can't hit me!",
      "status": "imported"
    },
    "voice_173:r_60c94ea4eb7f7404": {
      "text": "How do you like that!",
      "status": "imported"
    },
    "voice_173:r_727b2ee0277f9159": {
      "text": "Didn't hurt one bit!",
      "status": "imported"
    },
    "voice_173:r_1428fe5f35a9427b": {
      "text": "Not a chance!",
      "status": "imported"
    },
    "voice_173:r_96d39b8bdfa6f183": {
      "text": "Trider will be your shield!",
      "status": "imported"
    },
    "voice_173:r_0e4f9b8a2d26ebff": {
      "text": "I'm president!\\nI'll guard my staff!",
      "status": "imported"
    },
    "voice_173:r_79e0d542fe12bcf7": {
      "text": "Trider and I are flying today!",
      "status": "imported"
    },
    "voice_173:r_eff747ba39a55393": {
      "text": "Counting on you today too, G7! Hup!",
      "status": "imported"
    },
    "voice_173:r_b2dc77aa6dd77e69": {
      "text": "Time to show off a little!",
      "status": "imported"
    },
    "voice_173:r_445d40d8b5d7092b": {
      "text": "Here I come, Akagi!",
      "status": "imported"
    },
    "voice_173:r_bbb633cb5e8e6daf": {
      "text": "Sorry, Akagi's crew,\\nbut I'll win!",
      "status": "imported"
    },
    "voice_173:r_0abd8b6c713ccdac": {
      "text": "21st Century Security\\nwon't beat us!",
      "status": "imported"
    },
    "voice_173:r_f4ff463b2fda1b86": {
      "text": "Trider or Dai-Guard:\\nWhich is best?!",
      "status": "imported"
    },
    "voice_173:r_4e63c037d3cb8a3d": {
      "text": "Gura!\\nThink about how Shotaro feels!",
      "status": "imported"
    },
    "voice_173:r_9ca8d188ae805e3a": {
      "text": "I get wanting Dad's praise,\\nbut...!",
      "status": "imported"
    },
    "voice_173:r_795ed21f3e28e1f5": {
      "text": "Space Demon King-sorry Gura\\nI'm up!",
      "status": "imported"
    },
    "voice_173:r_141415c1def5ab2d": {
      "text": "A Black Hole\\ncan't swallow Trider!",
      "status": "imported"
    },
    "voice_173:r_c894e35becf35a03": {
      "text": "Won't listen to us?\\nThen no choice!",
      "status": "imported"
    },
    "voice_173:r_79b1abf5fc86483c": {
      "text": "Don't hit me anywhere weird...!",
      "status": "imported"
    },
    "voice_173:r_e9a11621911acb19": {
      "text": "I really don't want to do this...!",
      "status": "imported"
    },
    "voice_173:r_d52bece55796f599": {
      "text": "Even against Gundam, I'll do it!",
      "status": "imported"
    },
    "voice_173:r_358fe5a50bbee1df": {
      "text": "Trider\\nwon't lose even to Gundam!",
      "status": "imported"
    },
    "voice_173:r_638834e16724002f": {
      "text": "Evil profiteers\\nget no mercy!",
      "status": "imported"
    },
    "voice_173:r_b02fca1590ac1210": {
      "text": "Won't work honestly?\\nNo mercy!",
      "status": "imported"
    },
    "voice_173:r_f0344d2fbaa9db77": {
      "text": "Pack up,\\nreturn to your planet!",
      "status": "imported"
    },
    "voice_173:r_3328eef766ff2c2c": {
      "text": "I'll take down every evil alien!",
      "status": "imported"
    },
    "voice_173:r_23b037cf6ccc695c": {
      "text": "Whoever you are,\\nI won't lose!",
      "status": "imported"
    },
    "voice_173:r_883ad1128d340c5e": {
      "text": "Caught!\\nMy new science project!",
      "status": "imported"
    },
    "voice_173:r_a9e6ed99025a703b": {
      "text": "If they pass,\\nEarth gets wrecked...!",
      "status": "imported"
    },
    "voice_173:r_b0d1459d6daeebbe": {
      "text": "Space monsters\\ncan't roam free!",
      "status": "imported"
    },
    "voice_173:r_cd4893b409472e97": {
      "text": "Beat it,\\nour firm gains fame!",
      "status": "imported"
    },
    "voice_173:r_964e07c5563a5508": {
      "text": "Enough talk!\\nMake everyone happy!",
      "status": "imported"
    },
    "voice_173:r_db54e717bff3e3b2": {
      "text": "I won't let some tinpot tyrant win!",
      "status": "imported"
    },
    "voice_173:r_fcab8d80aef7e9d8": {
      "text": "It's the finale! Time to go all out!",
      "status": "imported"
    },
    "voice_173:r_2174bd0edc164171": {
      "text": "All your evil\\nTrider will crush!",
      "status": "imported"
    },
    "voice_173:r_ad54419336b49578": {
      "text": "Always scheming!\\nNo forgiveness!",
      "status": "imported"
    },
    "voice_173:r_69d009696527fa68": {
      "text": "Pitcher, Watta Takeo! First pitch!",
      "status": "imported"
    },
    "voice_173:r_aeb9079d86e2a924": {
      "text": "Behold my baseball-trained control!",
      "status": "imported"
    },
    "voice_173:r_bc4658630f8e40a9": {
      "text": "With Dai-Guard and Trider together!",
      "status": "imported"
    },
    "voice_173:r_92816afa2ba8a8c9": {
      "text": "You withstood Tetsujin's attack!",
      "status": "imported"
    },
    "voice_173:r_a29f58ecde5f7ddd": {
      "text": "You did great, Ox!",
      "status": "imported"
    },
    "voice_173:r_4069f7e9517c47e8": {
      "text": "Gura! Leave the rest to me!",
      "status": "imported"
    },
    "voice_173:r_2835a8af1c41be9b": {
      "text": "This counts as volunteer work!",
      "status": "imported"
    },
    "voice_173:r_cd84325a7c1a820f": {
      "text": "You're charging in too far, Akagi!",
      "status": "imported"
    },
    "voice_173:r_0465f74c0488ad70": {
      "text": "Shotaro! Tetsujin's in danger!",
      "status": "imported"
    },
    "voice_173:r_a30c8238b5208470": {
      "text": "Don't be reckless, Ox!",
      "status": "imported"
    },
    "voice_173:r_64bf1c63c7c1ebdd": {
      "text": "I can't abandon a friend!",
      "status": "imported"
    },
    "voice_173:r_f6d5042f671118fa": {
      "text": "Let's show some volunteer spirit!",
      "status": "imported"
    },
    "voice_173:r_0be18539fac21ba4": {
      "text": "Akagi! You don't have to hold back!",
      "status": "imported"
    },
    "voice_173:r_c05bd0cf089d667f": {
      "text": "Heh heh!\\nI know your style, Akagi!",
      "status": "imported"
    },
    "voice_173:r_f69a0e1d0d67fd0e": {
      "text": "Rough job, huh, Ibuki and Aoyama!",
      "status": "imported"
    },
    "voice_173:r_c4e734ceafabd82c": {
      "text": "So Trider\\nbeats Dai-Guard!",
      "status": "imported"
    },
    "voice_173:r_62f1de6cdfb87024": {
      "text": "Is that all a Black Hole can do?!",
      "status": "imported"
    },
    "voice_173:r_7ecfe7ddfa4cdb6a": {
      "text": "Gura! So timid,\\nyou can't beat me!",
      "status": "imported"
    },
    "voice_173:r_d6c7a401f55ee42f": {
      "text": "Hup!\\nEase up a bit, Akagi!",
      "status": "imported"
    },
    "voice_173:r_7bce428a8c95c22c": {
      "text": "Whoa?! That's so immature, Akagi!",
      "status": "imported"
    },
    "voice_173:r_97b5fedc5b19e6af": {
      "text": "Takeo General:\\nReputation ruined!",
      "status": "imported"
    },
    "voice_173:r_111aa50202ff773f": {
      "text": "Trider...!\\nLose to Dai-Guard?!",
      "status": "imported"
    },
    "voice_173:r_10cb1d3f8f325f52": {
      "text": "Whoa!\\nWorthy of Space Demon King!",
      "status": "imported"
    },
    "voice_173:r_ed69cbf9ff3779a7": {
      "text": "Gura! You blockhead!",
      "status": "imported"
    },
    "voice_173:r_82e0a318411dcbf7": {
      "text": "Aw, Trider lost...!",
      "status": "imported"
    },
    "voice_173:r_36c402609f13ec14": {
      "text": "S-So much for our contract...!",
      "status": "imported"
    },
    "voice_173:r_3840c01b1a9bf34b": {
      "text": "Well then, I'll go on ahead!",
      "status": "imported"
    },
    "voice_173:r_f03ef5034d024e8e": {
      "text": "Trider will go first!",
      "status": "imported"
    },
    "voice_173:r_bc1a77b291081b0f": {
      "text": "Let's combine our strength!",
      "status": "imported"
    },
    "voice_173:r_94089c60b94d9a81": {
      "text": "There! Now you can't escape!",
      "status": "imported"
    },
    "voice_173:r_56edc0d4b579afd1": {
      "text": "I'll handle things over here!",
      "status": "imported"
    },
    "voice_173:r_42c897bd608f37fd": {
      "text": "Leave it to Trider!",
      "status": "imported"
    },
    "voice_173:r_689700a088dc2f5b": {
      "text": "The great Watta is your opponent!",
      "status": "imported"
    },
    "voice_173:r_5a1e097aa0ec9859": {
      "text": "I'll show you a president's skills!",
      "status": "imported"
    },
    "voice_173:r_2a8d41aa8f4749ec": {
      "text": "OK, leave it to me!",
      "status": "imported"
    },
    "voice_173:r_01c80710474b30ae": {
      "text": "Roger! Leave it to Trider!",
      "status": "imported"
    },
    "voice_173:r_870a7c766b4e2144": {
      "text": "I'll take care of things here!",
      "status": "imported"
    },
    "voice_173:r_a9f39df34c38f5b3": {
      "text": "That one's my opponent!",
      "status": "imported"
    }
  }
}
