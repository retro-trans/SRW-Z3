{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_120:r_479b340ccc6c572b": {
      "text": "I won't let you!",
      "status": "imported"
    },
    "voice_120:r_ca4acbac57a2a35e": {
      "text": "Even if it costs me my life!!",
      "status": "imported"
    },
    "voice_120:r_77949221bf58f862": {
      "text": "There!",
      "status": "imported"
    },
    "voice_120:r_70b9c4b9f1f37eff": {
      "text": "Got you!!",
      "status": "imported"
    },
    "voice_120:r_9fcb3754cb1773c7": {
      "text": "How careless!",
      "status": "imported"
    },
    "voice_120:r_3559d2fad32c2435": {
      "text": "This is the end!",
      "status": "imported"
    },
    "voice_120:r_f7570547e9f80a64": {
      "text": "Your guard is sloppy!",
      "status": "imported"
    },
    "voice_120:r_cbab0f4720e1fcf1": {
      "text": "Prepare yourself!",
      "status": "imported"
    },
    "voice_120:r_0bbe0b4f5364e732": {
      "text": "Guh! Zechs...",
      "status": "imported"
    },
    "voice_120:r_5dda5198137cb02a": {
      "text": "I-Is this it...?",
      "status": "imported"
    },
    "voice_120:r_83ec59afbecdec14": {
      "text": "Not yet!\\nI'm not beaten yet!",
      "status": "imported"
    },
    "voice_120:r_e20bfd42ad95a3c9": {
      "text": "Tch!\\nThis could be dangerous...!?",
      "status": "imported"
    },
    "voice_120:r_0f58a8822381e57f": {
      "text": "Ghh!\\nI won't go down quietly...",
      "status": "imported"
    },
    "voice_120:r_6dbcc507fb61b51d": {
      "text": "Not yet! I can still fight!",
      "status": "imported"
    },
    "voice_120:r_b42ab697149a7c8a": {
      "text": "Ugh!! Th-This may be too much...",
      "status": "imported"
    },
    "voice_120:r_4de4fcf3b440baf4": {
      "text": "Damn, it hit me!?",
      "status": "imported"
    },
    "voice_120:r_0121a166c715cdff": {
      "text": "Not yet, not yet! This is nothing!!",
      "status": "imported"
    },
    "voice_120:r_30fad37a42bd3ad3": {
      "text": "That won't hurt me!",
      "status": "imported"
    },
    "voice_120:r_80a0b2a84e05d81a": {
      "text": "A mere hit! That's nothing!",
      "status": "imported"
    },
    "voice_120:r_4a9ac1dff86506d9": {
      "text": "That attack won't bring me down!",
      "status": "imported"
    },
    "voice_120:r_bc8538e6af3d2577": {
      "text": "Damage is minor. I can continue!!",
      "status": "imported"
    },
    "voice_120:r_924516c8de2b5342": {
      "text": "As if I'd let that hit me!!",
      "status": "imported"
    },
    "voice_120:r_da1174533722333f": {
      "text": "Not a chance!",
      "status": "imported"
    },
    "voice_120:r_fdeb8162976e72c1": {
      "text": "Hmph... What an amateur!",
      "status": "imported"
    },
    "voice_120:r_0fadb5c26df92b42": {
      "text": "I saw through you!",
      "status": "imported"
    },
    "voice_120:r_6b15af9a0057cdc8": {
      "text": "Tch,\\nI'm helpless at this range...",
      "status": "imported"
    },
    "voice_120:r_15b4a90140e8a33a": {
      "text": "I'll stop you here!",
      "status": "imported"
    },
    "voice_120:r_af884a6b11dff121": {
      "text": "Punch through the center!",
      "status": "imported"
    },
    "voice_120:r_ac6fe7838e95647b": {
      "text": "You won't get past me!",
      "status": "imported"
    },
    "voice_120:r_77ca87eacd17ad52": {
      "text": "Too slow on the dodge!",
      "status": "imported"
    },
    "voice_120:r_bf3244994760e535": {
      "text": "Now it's my turn...!",
      "status": "imported"
    },
    "voice_120:r_aabfb21c9d069ce7": {
      "text": "I'll attack as well!",
      "status": "imported"
    },
    "voice_120:r_02479dc8fe989560": {
      "text": "One more hit!",
      "status": "imported"
    },
    "voice_120:r_a2df00f91a9b0a9e": {
      "text": "I'll make it in time!",
      "status": "imported"
    },
    "voice_120:r_48b60d6c48b9b142": {
      "text": "I'll draw the enemy's attention!",
      "status": "imported"
    },
    "voice_120:r_8927e6fb681aa809": {
      "text": "That trick won't work twice.",
      "status": "imported"
    },
    "voice_120:r_665f01666859013b": {
      "text": "I know that pattern!",
      "status": "imported"
    },
    "voice_120:r_a571eec59b258d11": {
      "text": "I can read how this will unfold...!",
      "status": "imported"
    },
    "voice_120:r_ddbe581c5ea9183d": {
      "text": "Go back and start from scratch!",
      "status": "imported"
    },
    "voice_120:r_d4430bf362340b32": {
      "text": "Your attack lacks force!",
      "status": "imported"
    },
    "voice_120:r_6ff1323b355593e0": {
      "text": "Those skills won't keep you alive!",
      "status": "imported"
    },
    "voice_120:r_b7b5625d7cd4282f": {
      "text": "Was I too slow to evade!?",
      "status": "imported"
    },
    "voice_120:r_36133ad73a73ef98": {
      "text": "I can't let you break through here!",
      "status": "imported"
    },
    "voice_120:r_920740a0219c5085": {
      "text": "Guh! I wasn't careless, but...!",
      "status": "imported"
    },
    "voice_120:r_a8451712c57c1a72": {
      "text": "While I have a move,\\nI won't quit!!",
      "status": "imported"
    },
    "voice_120:r_3633df5b7b8f47fa": {
      "text": "Was my judgment\\nreally that naive!?",
      "status": "imported"
    },
    "voice_120:r_719e897304ec42d4": {
      "text": "This will finish you!",
      "status": "imported"
    },
    "voice_120:r_41997412868c48c4": {
      "text": "I'll annihilate you!",
      "status": "imported"
    },
    "voice_120:r_7432ef43ed3471dc": {
      "text": "Go down!!",
      "status": "imported"
    },
    "voice_120:r_8f60f6fc86db3107": {
      "text": "Yes...\\nZechs, a year and two days.",
      "status": "imported"
    },
    "voice_120:r_b1de76a75a253c13": {
      "text": "Zechs... Even if\\nI must defeat you!",
      "status": "imported"
    },
    "voice_120:r_2a00f1044ad5cbaa": {
      "text": "Too slow on the dodge!",
      "status": "imported"
    },
    "voice_120:r_cfccaa1fbeda124c": {
      "text": "You can't escape!",
      "status": "imported"
    },
    "voice_120:r_70451ffbabe2f876": {
      "text": "This works better than I expected.",
      "status": "imported"
    },
    "voice_120:r_69dfa1659715e2fa": {
      "text": "You bastard!",
      "status": "imported"
    },
    "voice_120:r_d996fd6d4ef5b329": {
      "text": "Don't fight dirty!",
      "status": "imported"
    },
    "voice_120:r_8ab47a28f99ef565": {
      "text": "Stop right there!",
      "status": "imported"
    },
    "voice_120:r_20920ad2eb3542db": {
      "text": "I'll cover you!",
      "status": "imported"
    },
    "voice_120:r_0ab7914877fd48ed": {
      "text": "I said I'd never\\nleave your side!",
      "status": "imported"
    },
    "voice_120:r_cb846feec748c2e3": {
      "text": "Agh! Wh-What power!?",
      "status": "imported"
    },
    "voice_120:r_c958860b0676b1f5": {
      "text": "Urgh!\\nNo two-rank promotion for me!",
      "status": "imported"
    },
    "voice_120:r_5e2669b82ef75ce3": {
      "text": "Tch! Not bad... but I'm not done!!",
      "status": "imported"
    },
    "voice_120:r_7847e0ed7dc9282d": {
      "text": "Agh!! I-I won't let you!",
      "status": "imported"
    },
    "voice_120:r_e42b52c7a987b906": {
      "text": "It's still too soon to retreat...!",
      "status": "imported"
    },
    "voice_120:r_6825fd1ff907bd22": {
      "text": "This is nothing!!",
      "status": "imported"
    },
    "voice_120:r_607f666f1563bc0d": {
      "text": "Too slow!",
      "status": "imported"
    },
    "voice_120:r_97b7431eeb81e6b6": {
      "text": "Far too naive!!",
      "status": "imported"
    },
    "voice_120:r_9b9726b1872759d6": {
      "text": "I'm pulling out for now!",
      "status": "imported"
    }
  }
}
