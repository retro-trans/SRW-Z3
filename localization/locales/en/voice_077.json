{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_077:r_479b340ccc6c572b": {
      "text": "Crusher Team, commence battle!",
      "status": "imported"
    },
    "voice_077:r_ca4acbac57a2a35e": {
      "text": "Cosmo Crusher, begin the attack!",
      "status": "imported"
    },
    "voice_077:r_77949221bf58f862": {
      "text": "Naoto! You ready?",
      "status": "imported"
    },
    "voice_077:r_70b9c4b9f1f37eff": {
      "text": "All set, Captain!",
      "status": "imported"
    },
    "voice_077:r_9fcb3754cb1773c7": {
      "text": "Begin the attack, Naoto!",
      "status": "imported"
    },
    "voice_077:r_3559d2fad32c2435": {
      "text": "Roger! Leave it to me!",
      "status": "imported"
    },
    "voice_077:r_f7570547e9f80a64": {
      "text": "Straight ahead, Captain!",
      "status": "imported"
    },
    "voice_077:r_cbab0f4720e1fcf1": {
      "text": "Got it! We'll strike from here!",
      "status": "imported"
    },
    "voice_077:r_0bbe0b4f5364e732": {
      "text": "Akira, watch your distance!",
      "status": "imported"
    },
    "voice_077:r_5dda5198137cb02a": {
      "text": "I know, I know!",
      "status": "imported"
    },
    "voice_077:r_83ec59afbecdec14": {
      "text": "Mika! Range to the enemy!?",
      "status": "imported"
    },
    "voice_077:r_e20bfd42ad95a3c9": {
      "text": "In range! We can attack!",
      "status": "imported"
    },
    "voice_077:r_0f58a8822381e57f": {
      "text": "You can do it, Roze!",
      "status": "imported"
    },
    "voice_077:r_6dbcc507fb61b51d": {
      "text": "Yes, I'm all right!",
      "status": "imported"
    },
    "voice_077:r_b42ab697149a7c8a": {
      "text": "I'm counting on you, Roze!",
      "status": "imported"
    },
    "voice_077:r_4de4fcf3b440baf4": {
      "text": "I'm part of the Crusher Team now!",
      "status": "imported"
    },
    "voice_077:r_ac6fe7838e95647b": {
      "text": "All hands! We'll attack again!",
      "status": "imported"
    },
    "voice_077:r_77ca87eacd17ad52": {
      "text": "They're reeling! Finish them off!",
      "status": "imported"
    },
    "voice_077:r_bf3244994760e535": {
      "text": "Target ahead! A Gishin machine!",
      "status": "imported"
    },
    "voice_077:r_aabfb21c9d069ce7": {
      "text": "Anyone who threatens people's peace!",
      "status": "imported"
    },
    "voice_077:r_02479dc8fe989560": {
      "text": "Enemy commander! All hands, attack!",
      "status": "imported"
    },
    "voice_077:r_665f01666859013b": {
      "text": "All hands!\\nTriple Laser, stand by!",
      "status": "imported"
    },
    "voice_077:r_a571eec59b258d11": {
      "text": "Enemy sighted! Naoto, Akira, now!",
      "status": "imported"
    },
    "voice_077:r_ddbe581c5ea9183d": {
      "text": "Roger that!",
      "status": "imported"
    },
    "voice_077:r_faae935cca0edc72": {
      "text": "Triple split!\\nAkira 2, Naoto 3!",
      "status": "imported"
    },
    "voice_077:r_d4430bf362340b32": {
      "text": "I'm counting on you, Naoto!",
      "status": "imported"
    },
    "voice_077:r_6ff1323b355593e0": {
      "text": "Yeah, you can count on me!",
      "status": "imported"
    },
    "voice_077:r_b7b5625d7cd4282f": {
      "text": "Akira, Naoto!\\nTriple Laser attack!",
      "status": "imported"
    },
    "voice_077:r_36133ad73a73ef98": {
      "text": "Everyone, do your best!",
      "status": "imported"
    },
    "voice_077:r_a8451712c57c1a72": {
      "text": "Captain, let me join the triple!",
      "status": "imported"
    },
    "voice_077:r_3633df5b7b8f47fa": {
      "text": "Do it! Naoto, move to support!",
      "status": "imported"
    },
    "voice_077:r_52dfc56b14b93551": {
      "text": "Watch me, Mars!",
      "status": "imported"
    },
    "voice_077:r_1b9b2aab5cb104da": {
      "text": "The Triple Laser is our move\\nhere!",
      "status": "imported"
    },
    "voice_077:r_342044c706a2340f": {
      "text": "All right! Everyone, take position!",
      "status": "imported"
    },
    "voice_077:r_cf41e8828a90cbdb": {
      "text": "Okay, here we go!",
      "status": "imported"
    },
    "voice_077:r_719e897304ec42d4": {
      "text": "I won't let this chance slip by!",
      "status": "imported"
    },
    "voice_077:r_d5e0a2317c40d322": {
      "text": "Don't let them escape, Naoto!",
      "status": "imported"
    },
    "voice_077:r_ec2ea17765052401": {
      "text": "You're a pain!\\nI'll shoot you down!",
      "status": "imported"
    },
    "voice_077:r_f2d4255f1c2f7542": {
      "text": "Counterattack! Akira, turn fast!",
      "status": "imported"
    },
    "voice_077:r_5d08ad19e2da125b": {
      "text": "Leave it to me, Captain!",
      "status": "imported"
    },
    "voice_077:r_a7246b52782a877e": {
      "text": "Range calculated! We can counter!",
      "status": "imported"
    },
    "voice_077:r_dc8701f6bcb9904f": {
      "text": "All right! Let's do this!",
      "status": "imported"
    },
    "voice_077:r_d6bdd730f24f66eb": {
      "text": "Crusher Team here! We'll cover you!",
      "status": "imported"
    },
    "voice_077:r_41997412868c48c4": {
      "text": "Support them with Cosmo Crusher!",
      "status": "imported"
    },
    "voice_077:r_9e6cf4f389dae55c": {
      "text": "Takeru! We'll cause a diversion!",
      "status": "imported"
    },
    "voice_077:r_9e0c80ac7e33b459": {
      "text": "The Crusher Team will cover you!",
      "status": "imported"
    },
    "voice_077:r_7432ef43ed3471dc": {
      "text": "Hang in there, Cosmo Crusher!",
      "status": "imported"
    },
    "voice_077:r_065443f6ddfcf0d7": {
      "text": "Takeru! Don't charge too far ahead!",
      "status": "imported"
    },
    "voice_077:r_47d52a2839c71715": {
      "text": "We can't counter... What a blunder!",
      "status": "imported"
    },
    "voice_077:r_847f82e7f3eef651": {
      "text": "At this range, we're helpless...!",
      "status": "imported"
    },
    "voice_077:r_eb7ae28b53dc033c": {
      "text": "Akira!\\nGet us within attack range!",
      "status": "imported"
    },
    "voice_077:r_857c4a52ce8df0fd": {
      "text": "It's dangerous, but I'll try!",
      "status": "imported"
    },
    "voice_077:r_55417493fce1d347": {
      "text": "All right, keep drawing them in!",
      "status": "imported"
    },
    "voice_077:r_8fdf5910927c9591": {
      "text": "Cosmo Crusher has the speed!",
      "status": "imported"
    },
    "voice_077:r_7d724dbcc4451e10": {
      "text": "Hey! Over here, over here!",
      "status": "imported"
    },
    "voice_077:r_93e25418a203cb8f": {
      "text": "Stay sharp, Akira!",
      "status": "imported"
    },
    "voice_077:r_adeb0a29274d3d9b": {
      "text": "Their attack missed us!",
      "status": "imported"
    },
    "voice_077:r_24cf161287ef9d5c": {
      "text": "All right! Don't waste this chance!",
      "status": "imported"
    },
    "voice_077:r_8f60f6fc86db3107": {
      "text": "That won't do a thing!",
      "status": "imported"
    },
    "voice_077:r_5213c17e13b23de0": {
      "text": "Mika! Barrier status!",
      "status": "imported"
    },
    "voice_077:r_38fdff9483e9245c": {
      "text": "Normal! We won't have any problems!",
      "status": "imported"
    },
    "voice_077:r_620fedec67706d7d": {
      "text": "Ngh! Did that graze us?",
      "status": "imported"
    },
    "voice_077:r_9680dcd0fddcfcc7": {
      "text": "Damn! The shaking's ruining my aim!",
      "status": "imported"
    },
    "voice_077:r_2a00f1044ad5cbaa": {
      "text": "Wait for your next chance, Naoto!",
      "status": "imported"
    },
    "voice_077:r_3dbeead1bd3164ef": {
      "text": "Damn, I couldn't dodge it!",
      "status": "imported"
    },
    "voice_077:r_98d15b8cc09bc915": {
      "text": "No, you avoided a clean hit, Akira!",
      "status": "imported"
    },
    "voice_077:r_46e86d000250e137": {
      "text": "Did it hit us!? Mika!",
      "status": "imported"
    },
    "voice_077:r_ac341e7976e88f0b": {
      "text": "Underside grazed!\\nNo combat impact!",
      "status": "imported"
    },
    "voice_077:r_cdbd128a5b4127cc": {
      "text": "Cosmo Crusher can still fight!",
      "status": "imported"
    },
    "voice_077:r_cfccaa1fbeda124c": {
      "text": "A hit! But we're not done yet!",
      "status": "imported"
    },
    "voice_077:r_b1f8ec192b9c083a": {
      "text": "Damn! We've got to hit back fast!",
      "status": "imported"
    },
    "voice_077:r_a007f9ab9cf048b3": {
      "text": "Don't panic, Naoto! Stay calm!",
      "status": "imported"
    },
    "voice_077:r_ddafde4b065ced49": {
      "text": "S-such a precise attack!",
      "status": "imported"
    },
    "voice_077:r_de1213040856c089": {
      "text": "Calm down, Akira! Dodge the next!",
      "status": "imported"
    },
    "voice_077:r_3304412ac41f47a6": {
      "text": "Mika, damage report!",
      "status": "imported"
    },
    "voice_077:r_0c0775e051211840": {
      "text": "Center tail hit! Rudder won't move!",
      "status": "imported"
    },
    "voice_077:r_a2afffe1c396f0b3": {
      "text": "We can't take any more!",
      "status": "imported"
    },
    "voice_077:r_13c25fbdfddc8a24": {
      "text": "Not yet! See our Crusher spirit!",
      "status": "imported"
    },
    "voice_077:r_42ba1ecb310b4bd7": {
      "text": "Naoto!\\nNext hit may be our last!",
      "status": "imported"
    },
    "voice_077:r_d692f1d420460a47": {
      "text": "Heh... One shot is all I need!",
      "status": "imported"
    },
    "voice_077:r_a5643cec86b18bd2": {
      "text": "Aaaah! At this rate...!",
      "status": "imported"
    },
    "voice_077:r_68f2dfab20a4a30e": {
      "text": "No whining, Akira!",
      "status": "imported"
    },
    "voice_077:r_9cedad8237480563": {
      "text": "Engine power down! We can't go on!",
      "status": "imported"
    },
    "voice_077:r_a03fabecba1508ca": {
      "text": "Keep it running somehow, Mika!",
      "status": "imported"
    },
    "voice_077:r_5391b24a71eb10ae": {
      "text": "No good! We're falling back!",
      "status": "imported"
    },
    "voice_077:r_5b9e8897190892eb": {
      "text": "Roze! You can hit them from there!",
      "status": "imported"
    },
    "voice_077:r_7bea3023abbf8a94": {
      "text": "Thanks! Take this!",
      "status": "imported"
    },
    "voice_077:r_dd01a4c0d1b36a8d": {
      "text": "Roze! Let's race to shoot one down!",
      "status": "imported"
    },
    "voice_077:r_20920ad2eb3542db": {
      "text": "A contest? You're on!",
      "status": "imported"
    },
    "voice_077:r_0ab7914877fd48ed": {
      "text": "Let's see what you've got, Roze!",
      "status": "imported"
    },
    "voice_077:r_cb846feec748c2e3": {
      "text": "Leave it to me, Naoto!",
      "status": "imported"
    },
    "voice_077:r_c958860b0676b1f5": {
      "text": "We'll charge in all at once!",
      "status": "imported"
    },
    "voice_077:r_5e2669b82ef75ce3": {
      "text": "Roger! We'll attack together!",
      "status": "imported"
    },
    "voice_077:r_7847e0ed7dc9282d": {
      "text": "Leave the controls to me!",
      "status": "imported"
    },
    "voice_077:r_e42b52c7a987b906": {
      "text": "I'm counting on you, Akira!",
      "status": "imported"
    },
    "voice_077:r_fc25e66a86fc2c85": {
      "text": "Out of energy!? This is bad...!",
      "status": "imported"
    },
    "voice_077:r_5aeeb4917340c42d": {
      "text": "Damn! We're out of energy!",
      "status": "imported"
    },
    "voice_077:r_b765659981b6516d": {
      "text": "We pressed our attack. So be it...!",
      "status": "imported"
    },
    "voice_077:r_774a9ab4d8fd5351": {
      "text": "Unless they're as good as me, though",
      "status": "imported"
    },
    "voice_077:r_7d2617c809fead70": {
      "text": "Roger!",
      "status": "imported"
    },
    "voice_077:r_ceb935ccbf830724": {
      "text": "There!",
      "status": "imported"
    },
    "voice_077:r_862ef7385bf2abd4": {
      "text": "Captain! Enemy incoming!",
      "status": "imported"
    },
    "voice_077:r_001cbec4d9a4283f": {
      "text": "All right! We'll intercept!",
      "status": "imported"
    },
    "voice_077:r_8ad40afecd02b41e": {
      "text": "Range and line of fire, all clear!",
      "status": "imported"
    },
    "voice_077:r_26e5efec03c03d78": {
      "text": "We'll attack the enemy up ahead!",
      "status": "imported"
    },
    "voice_077:r_0bad405ee6ca63ba": {
      "text": "Chief Otsuka! Forgive me!",
      "status": "imported"
    },
    "voice_077:r_2072eaf71a260ae7": {
      "text": "Don't sell the Crusher Team short!",
      "status": "imported"
    },
    "voice_077:r_6c13bbfd27a7799e": {
      "text": "Don't sell the Crusher Team short!",
      "status": "imported"
    },
    "voice_077:r_06f88dcbd3c9e738": {
      "text": "So all we can do now is endure...!",
      "status": "imported"
    },
    "voice_077:r_b28faf9f71bc3598": {
      "text": "Concentrate fire on them!",
      "status": "imported"
    },
    "voice_077:r_8a29278549f8e07a": {
      "text": "Got it! Leave it to me!",
      "status": "imported"
    },
    "voice_077:r_7e6c573c26177f98": {
      "text": "All right! Target the enemy ahead!",
      "status": "imported"
    }
  }
}
