{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_144:r_479b340ccc6c572b": {
      "text": "Fair and square!\\nFair and square...!",
      "status": "imported"
    },
    "voice_144:r_ca4acbac57a2a35e": {
      "text": "Now then...! How shall I cook you?",
      "status": "imported"
    },
    "voice_144:r_77949221bf58f862": {
      "text": "Beg for your life?\\nI won't listen!",
      "status": "imported"
    },
    "voice_144:r_70b9c4b9f1f37eff": {
      "text": "Don't worry. You'll die instantly!",
      "status": "imported"
    },
    "voice_144:r_9fcb3754cb1773c7": {
      "text": "For my master Dr. Hell's dream!",
      "status": "imported"
    },
    "voice_144:r_3559d2fad32c2435": {
      "text": "Count Brocken,\\none of five chiefs!",
      "status": "imported"
    },
    "voice_144:r_f7570547e9f80a64": {
      "text": "World conquest starts:\\nAtami burns!",
      "status": "imported"
    },
    "voice_144:r_cbab0f4720e1fcf1": {
      "text": "These skies belong to my Ghoul!",
      "status": "imported"
    },
    "voice_144:r_0bbe0b4f5364e732": {
      "text": "Demon beast!\\nFlying Fortress Ghoul!",
      "status": "imported"
    },
    "voice_144:r_5dda5198137cb02a": {
      "text": "Damn you, you just won't give up!",
      "status": "imported"
    },
    "voice_144:r_83ec59afbecdec14": {
      "text": "My target is Mazinger Z!",
      "status": "imported"
    },
    "voice_144:r_e20bfd42ad95a3c9": {
      "text": "Kouji Kabuto! Die for Dr. Hell!",
      "status": "imported"
    },
    "voice_144:r_0f58a8822381e57f": {
      "text": "Ignore the small fry!\\nGet Mazinger!",
      "status": "imported"
    },
    "voice_144:r_6dbcc507fb61b51d": {
      "text": "Now then,\\nhow shall I punish you?",
      "status": "imported"
    },
    "voice_144:r_b42ab697149a7c8a": {
      "text": "You're nothing but a junk robot!",
      "status": "imported"
    },
    "voice_144:r_4de4fcf3b440baf4": {
      "text": "Just Kouji Kabuto's lackey!",
      "status": "imported"
    },
    "voice_144:r_30fad37a42bd3ad3": {
      "text": "A bit player should stay backstage!",
      "status": "imported"
    },
    "voice_144:r_80a0b2a84e05d81a": {
      "text": "Commence the air strike!",
      "status": "imported"
    },
    "voice_144:r_4a9ac1dff86506d9": {
      "text": "Begin carpet bombing!",
      "status": "imported"
    },
    "voice_144:r_bc8538e6af3d2577": {
      "text": "Fwahahahaha! Flee in terror!",
      "status": "imported"
    },
    "voice_144:r_924516c8de2b5342": {
      "text": "I don't care! Burn this whole area!",
      "status": "imported"
    },
    "voice_144:r_da1174533722333f": {
      "text": "Blow them away with Ghoul's bombs!",
      "status": "imported"
    },
    "voice_144:r_fdeb8162976e72c1": {
      "text": "Fwahahahaha! This'll hurt!",
      "status": "imported"
    },
    "voice_144:r_0fadb5c26df92b42": {
      "text": "Now! Give them a taste of lightning!",
      "status": "imported"
    },
    "voice_144:r_6b15af9a0057cdc8": {
      "text": "I'll blow you to bits right here!",
      "status": "imported"
    },
    "voice_144:r_15b4a90140e8a33a": {
      "text": "Maximum output! Begin discharge!",
      "status": "imported"
    },
    "voice_144:r_920740a0219c5085": {
      "text": "You offer me your life? Admirable!",
      "status": "imported"
    },
    "voice_144:r_a8451712c57c1a72": {
      "text": "I'll repay you handsomely!",
      "status": "imported"
    },
    "voice_144:r_3633df5b7b8f47fa": {
      "text": "Now you're the one in my sights!",
      "status": "imported"
    },
    "voice_144:r_52dfc56b14b93551": {
      "text": "Ha ha! Don't think you can escape!",
      "status": "imported"
    },
    "voice_144:r_1b9b2aab5cb104da": {
      "text": "Don't let them flee! Chase! Chase!",
      "status": "imported"
    },
    "voice_144:r_342044c706a2340f": {
      "text": "Our chance! Aim for their back!",
      "status": "imported"
    },
    "voice_144:r_cf41e8828a90cbdb": {
      "text": "Let's make doubly sure...!",
      "status": "imported"
    },
    "voice_144:r_719e897304ec42d4": {
      "text": "You fool! What a blunder...!",
      "status": "imported"
    },
    "voice_144:r_d5e0a2317c40d322": {
      "text": "A one-sided attack...!\\nYou savage!",
      "status": "imported"
    },
    "voice_144:r_ec2ea17765052401": {
      "text": "Very well. Enjoy it while you can!",
      "status": "imported"
    },
    "voice_144:r_f2d4255f1c2f7542": {
      "text": "What!? We're out of energy!?",
      "status": "imported"
    },
    "voice_144:r_5d08ad19e2da125b": {
      "text": "What are you doing at this moment!",
      "status": "imported"
    },
    "voice_144:r_a7246b52782a877e": {
      "text": "What!?\\nAn attack from up there...!?",
      "status": "imported"
    },
    "voice_144:r_dc8701f6bcb9904f": {
      "text": "Damn it! Search! Find them!",
      "status": "imported"
    },
    "voice_144:r_d6bdd730f24f66eb": {
      "text": "Not so fast!",
      "status": "imported"
    },
    "voice_144:r_41997412868c48c4": {
      "text": "What!? They missed on their own!",
      "status": "imported"
    },
    "voice_144:r_9e6cf4f389dae55c": {
      "text": "Hmph, that was close!",
      "status": "imported"
    },
    "voice_144:r_9e0c80ac7e33b459": {
      "text": "We can win!\\nWe can beat Mazinger Z!",
      "status": "imported"
    },
    "voice_144:r_7432ef43ed3471dc": {
      "text": "Nuhahaha!\\nMazinger Z is no threat!",
      "status": "imported"
    },
    "voice_144:r_065443f6ddfcf0d7": {
      "text": "Young lady,\\nthat's quite enough...!",
      "status": "imported"
    },
    "voice_144:r_47d52a2839c71715": {
      "text": "You wreck...!\\nWhat are you doing?!",
      "status": "imported"
    },
    "voice_144:r_847f82e7f3eef651": {
      "text": "Excellent! Well done!",
      "status": "imported"
    },
    "voice_144:r_eb7ae28b53dc033c": {
      "text": "Well done...!\\nBut stay on guard!",
      "status": "imported"
    },
    "voice_144:r_93e25418a203cb8f": {
      "text": "It won't work! It won't work!",
      "status": "imported"
    },
    "voice_144:r_24cf161287ef9d5c": {
      "text": "You fool! Fighting with no chance!",
      "status": "imported"
    },
    "voice_144:r_8f60f6fc86db3107": {
      "text": "Do you grasp your weakness now?",
      "status": "imported"
    },
    "voice_144:r_b1de76a75a253c13": {
      "text": "Hmph! Small fry have no place here!",
      "status": "imported"
    },
    "voice_144:r_128c35bf3e0e394c": {
      "text": "Guh! Insolent wretch!",
      "status": "imported"
    },
    "voice_144:r_5213c17e13b23de0": {
      "text": "This won't bring down my Ghoul!",
      "status": "imported"
    },
    "voice_144:r_38fdff9483e9245c": {
      "text": "Careless against mere small fry!",
      "status": "imported"
    },
    "voice_144:r_620fedec67706d7d": {
      "text": "Heh heh heh heh heh!\\nHeating up!",
      "status": "imported"
    },
    "voice_144:r_9680dcd0fddcfcc7": {
      "text": "Damn you! Don't get cocky!",
      "status": "imported"
    },
    "voice_144:r_2a00f1044ad5cbaa": {
      "text": "N-no! Where is my body!?",
      "status": "imported"
    },
    "voice_144:r_3dbeead1bd3164ef": {
      "text": "Enough!\\nNow I'll show no mercy!",
      "status": "imported"
    },
    "voice_144:r_98d15b8cc09bc915": {
      "text": "Mazinger Z is\\ntoo great a threat!",
      "status": "imported"
    },
    "voice_144:r_46e86d000250e137": {
      "text": "Damn!\\nOutdone by a mere girl!",
      "status": "imported"
    },
    "voice_144:r_ac341e7976e88f0b": {
      "text": "Grrr! I underestimated that wreck!",
      "status": "imported"
    },
    "voice_144:r_cdbd128a5b4127cc": {
      "text": "Ghoul falls here,\\nall is lost...!",
      "status": "imported"
    },
    "voice_144:r_cfccaa1fbeda124c": {
      "text": "What are you doing, useless fools!",
      "status": "imported"
    },
    "voice_144:r_de1213040856c089": {
      "text": "What's happening!?\\nA nightmare!?",
      "status": "imported"
    },
    "voice_144:r_3304412ac41f47a6": {
      "text": "Y-you...!\\nI'm immortal, you'll see!",
      "status": "imported"
    },
    "voice_144:r_0c0775e051211840": {
      "text": "Dr. Hell gave me life!\\nNot for you!",
      "status": "imported"
    },
    "voice_144:r_a2afffe1c396f0b3": {
      "text": "Pain?\\nDr. Hell punished me worse!",
      "status": "imported"
    },
    "voice_144:r_13c25fbdfddc8a24": {
      "text": "Evade!\\nNext time, you must evade!",
      "status": "imported"
    },
    "voice_144:r_42ba1ecb310b4bd7": {
      "text": "Absurd...\\nGhoul took such damage...!",
      "status": "imported"
    },
    "voice_144:r_d692f1d420460a47": {
      "text": "What!? Me, like this!?\\nLike this!?",
      "status": "imported"
    },
    "voice_144:r_a5643cec86b18bd2": {
      "text": "Damn! My plan is ruined!\\nRetreat!",
      "status": "imported"
    },
    "voice_144:r_68f2dfab20a4a30e": {
      "text": "I'll utterly crush you!",
      "status": "imported"
    },
    "voice_144:r_9cedad8237480563": {
      "text": "To conquer the world,\\nvanish here!",
      "status": "imported"
    },
    "voice_144:r_a03fabecba1508ca": {
      "text": "Even Mazinger Z:\\nHit the Pilder!",
      "status": "imported"
    },
    "voice_144:r_1568ff6298b12b96": {
      "text": "Curse you! You won't escape!",
      "status": "imported"
    },
    "voice_144:r_2c9d94ba13c5fc50": {
      "text": "I never said this was one-on-one!",
      "status": "imported"
    },
    "voice_144:r_a77f4913375098d2": {
      "text": "Absurd...! This must be a mistake!",
      "status": "imported"
    },
    "voice_144:r_428c2116ac3071b1": {
      "text": "Grr!\\nCan't return to Bardos Island!",
      "status": "imported"
    },
    "voice_144:r_84c116267b79f540": {
      "text": "Grrr! You'll pay for that!",
      "status": "imported"
    },
    "voice_144:r_dad38ee29af2df3a": {
      "text": "Is that all!? How disappointing!",
      "status": "imported"
    },
    "voice_144:r_3d32e86f8dc80909": {
      "text": "Guh! What an eyesore!",
      "status": "imported"
    },
    "voice_144:r_70451ffbabe2f876": {
      "text": "Soft! Far too soft!",
      "status": "imported"
    },
    "voice_144:r_69dfa1659715e2fa": {
      "text": "Your aim and skill both need work!",
      "status": "imported"
    },
    "voice_144:r_d996fd6d4ef5b329": {
      "text": "We have a barrier on our side!",
      "status": "imported"
    },
    "voice_144:r_8ab47a28f99ef565": {
      "text": "Playtime is over! Brace yourself!",
      "status": "imported"
    },
    "voice_144:r_546de3fb6db156ea": {
      "text": "Gaaah! B-but evil never dies!",
      "status": "imported"
    },
    "voice_144:r_ca85f87cee5e31f7": {
      "text": "Heh heh heh heh... Just as planned!",
      "status": "imported"
    },
    "voice_144:r_9072ea7bc71df136": {
      "text": "M-my deepest apologies, Dr. Hell!",
      "status": "imported"
    }
  }
}
