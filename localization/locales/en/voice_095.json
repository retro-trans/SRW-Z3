{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_095:r_479b340ccc6c572b": {
      "text": "I'll be the one to stop you!",
      "status": "imported"
    },
    "voice_095:r_ca4acbac57a2a35e": {
      "text": "For the future Euphie dreamed of!",
      "status": "imported"
    },
    "voice_095:r_77949221bf58f862": {
      "text": "I won't let another tragedy happen!",
      "status": "imported"
    },
    "voice_095:r_70b9c4b9f1f37eff": {
      "text": "With the Lancelot Albion, I can!",
      "status": "imported"
    },
    "voice_095:r_9fcb3754cb1773c7": {
      "text": "I won't stop!\\nTo see tomorrow!",
      "status": "imported"
    },
    "voice_095:r_3559d2fad32c2435": {
      "text": "I'll live on! That's how I'll atone!",
      "status": "imported"
    },
    "voice_095:r_f7570547e9f80a64": {
      "text": "Watch over me, Euphie!",
      "status": "imported"
    },
    "voice_095:r_cbab0f4720e1fcf1": {
      "text": "If I can bring this to close combat!",
      "status": "imported"
    },
    "voice_095:r_0bbe0b4f5364e732": {
      "text": "Are you prepared?!",
      "status": "imported"
    },
    "voice_095:r_5dda5198137cb02a": {
      "text": "If you're still set on fighting!",
      "status": "imported"
    },
    "voice_095:r_83ec59afbecdec14": {
      "text": "This time, I'll end it!",
      "status": "imported"
    },
    "voice_095:r_e20bfd42ad95a3c9": {
      "text": "No matter why, I won't allow this!",
      "status": "imported"
    },
    "voice_095:r_0f58a8822381e57f": {
      "text": "I won't let the world be destroyed!",
      "status": "imported"
    },
    "voice_095:r_6dbcc507fb61b51d": {
      "text": "A monster that attacks people...!",
      "status": "imported"
    },
    "voice_095:r_b42ab697149a7c8a": {
      "text": "Euphie's gentle world\\nrejects you!",
      "status": "imported"
    },
    "voice_095:r_4de4fcf3b440baf4": {
      "text": "I'll cut off the source of conflict!",
      "status": "imported"
    },
    "voice_095:r_ac6fe7838e95647b": {
      "text": "You think you can dodge?!",
      "status": "imported"
    },
    "voice_095:r_77ca87eacd17ad52": {
      "text": "This will work!",
      "status": "imported"
    },
    "voice_095:r_aabfb21c9d069ce7": {
      "text": "Switching modes!",
      "status": "imported"
    },
    "voice_095:r_02479dc8fe989560": {
      "text": "This will finish it!",
      "status": "imported"
    },
    "voice_095:r_a2df00f91a9b0a9e": {
      "text": "All right, Hadron Mode!",
      "status": "imported"
    },
    "voice_095:r_48b60d6c48b9b142": {
      "text": "It's over!",
      "status": "imported"
    },
    "voice_095:r_8927e6fb681aa809": {
      "text": "I'll land a direct hit!",
      "status": "imported"
    },
    "voice_095:r_665f01666859013b": {
      "text": "I won't let this go any further!",
      "status": "imported"
    },
    "voice_095:r_a571eec59b258d11": {
      "text": "Varis, switch to Hadron Mode!",
      "status": "imported"
    },
    "voice_095:r_ddbe581c5ea9183d": {
      "text": "To end this here, I'll have to...!",
      "status": "imported"
    },
    "voice_095:r_faae935cca0edc72": {
      "text": "Haaaaah!",
      "status": "imported"
    },
    "voice_095:r_d4430bf362340b32": {
      "text": "Goooo!!",
      "status": "imported"
    },
    "voice_095:r_6ff1323b355593e0": {
      "text": "I'm going all out!",
      "status": "imported"
    },
    "voice_095:r_b7b5625d7cd4282f": {
      "text": "Raaah!",
      "status": "imported"
    },
    "voice_095:r_36133ad73a73ef98": {
      "text": "Haaaaaaaaah!!",
      "status": "imported"
    },
    "voice_095:r_920740a0219c5085": {
      "text": "I won't hold back!",
      "status": "imported"
    },
    "voice_095:r_a8451712c57c1a72": {
      "text": "Yaaah!",
      "status": "imported"
    },
    "voice_095:r_3633df5b7b8f47fa": {
      "text": "Wooooooaaah!!",
      "status": "imported"
    },
    "voice_095:r_41997412868c48c4": {
      "text": "I won't let you off!",
      "status": "imported"
    },
    "voice_095:r_9e6cf4f389dae55c": {
      "text": "I won't let you escape!",
      "status": "imported"
    },
    "voice_095:r_9e0c80ac7e33b459": {
      "text": "Then I'm up next!",
      "status": "imported"
    },
    "voice_095:r_7432ef43ed3471dc": {
      "text": "I have something I won't give up!",
      "status": "imported"
    },
    "voice_095:r_065443f6ddfcf0d7": {
      "text": "I won't just stand here and take it!",
      "status": "imported"
    },
    "voice_095:r_47d52a2839c71715": {
      "text": "I can still move!",
      "status": "imported"
    },
    "voice_095:r_847f82e7f3eef651": {
      "text": "I won't let that opening go!",
      "status": "imported"
    },
    "voice_095:r_eb7ae28b53dc033c": {
      "text": "I'll deliver the finishing blow!",
      "status": "imported"
    },
    "voice_095:r_857c4a52ce8df0fd": {
      "text": "Lelouch, leave the rest to me!",
      "status": "imported"
    },
    "voice_095:r_55417493fce1d347": {
      "text": "Let's combine our strength, Kallen!",
      "status": "imported"
    },
    "voice_095:r_8fdf5910927c9591": {
      "text": "I'll protect you! I swear I will!",
      "status": "imported"
    },
    "voice_095:r_7d724dbcc4451e10": {
      "text": "I won't let that happen!",
      "status": "imported"
    },
    "voice_095:r_93e25418a203cb8f": {
      "text": "Seems I'm always saving you, Lelouch",
      "status": "imported"
    },
    "voice_095:r_adeb0a29274d3d9b": {
      "text": "I won't let them hurt Kallen!",
      "status": "imported"
    },
    "voice_095:r_24cf161287ef9d5c": {
      "text": "Protecting someone needs no reason!",
      "status": "imported"
    },
    "voice_095:r_8f60f6fc86db3107": {
      "text": "Damn it! I can't attack...!",
      "status": "imported"
    },
    "voice_095:r_b1de76a75a253c13": {
      "text": "I can't afford to stop now...!",
      "status": "imported"
    },
    "voice_095:r_128c35bf3e0e394c": {
      "text": "Quickly,\\nreplace the Energy Filler!",
      "status": "imported"
    },
    "voice_095:r_5213c17e13b23de0": {
      "text": "Even Lancelot can't do it...?!",
      "status": "imported"
    },
    "voice_095:r_38fdff9483e9245c": {
      "text": "Try all you want, same result!",
      "status": "imported"
    },
    "voice_095:r_620fedec67706d7d": {
      "text": "Our resolve is what sets us apart!",
      "status": "imported"
    },
    "voice_095:r_9680dcd0fddcfcc7": {
      "text": "That won't work on Lancelot!",
      "status": "imported"
    },
    "voice_095:r_2a00f1044ad5cbaa": {
      "text": "Why can't you see it's pointless?!",
      "status": "imported"
    },
    "voice_095:r_3dbeead1bd3164ef": {
      "text": "I can't protect anyone like this!",
      "status": "imported"
    },
    "voice_095:r_98d15b8cc09bc915": {
      "text": "I... will live...!",
      "status": "imported"
    },
    "voice_095:r_46e86d000250e137": {
      "text": "The curse of Geass...!",
      "status": "imported"
    },
    "voice_095:r_ac341e7976e88f0b": {
      "text": "I... won't die...!",
      "status": "imported"
    },
    "voice_095:r_cdbd128a5b4127cc": {
      "text": "I've already planned for that!",
      "status": "imported"
    },
    "voice_095:r_b1f8ec192b9c083a": {
      "text": "Blaze Luminous!",
      "status": "imported"
    },
    "voice_095:r_a007f9ab9cf048b3": {
      "text": "Only minor damage! Then...!",
      "status": "imported"
    },
    "voice_095:r_ddafde4b065ced49": {
      "text": "You can hardly call this damage!",
      "status": "imported"
    },
    "voice_095:r_de1213040856c089": {
      "text": "No time to regret taking that hit!",
      "status": "imported"
    },
    "voice_095:r_3304412ac41f47a6": {
      "text": "I'll keep moving forward!",
      "status": "imported"
    },
    "voice_095:r_0c0775e051211840": {
      "text": "My resolve will never waver!",
      "status": "imported"
    },
    "voice_095:r_a2afffe1c396f0b3": {
      "text": "I'm not allowed to lose...!",
      "status": "imported"
    },
    "voice_095:r_13c25fbdfddc8a24": {
      "text": "That won't make me flinch!",
      "status": "imported"
    },
    "voice_095:r_42ba1ecb310b4bd7": {
      "text": "I was prepared for this much!",
      "status": "imported"
    },
    "voice_095:r_d692f1d420460a47": {
      "text": "This battle isn't over yet!",
      "status": "imported"
    },
    "voice_095:r_a5643cec86b18bd2": {
      "text": "I'll turn this around! Starting now!",
      "status": "imported"
    },
    "voice_095:r_68f2dfab20a4a30e": {
      "text": "Yggdrasil Drive\\nshould be better...!",
      "status": "imported"
    },
    "voice_095:r_9cedad8237480563": {
      "text": "Not yet! I won't quit till the end!",
      "status": "imported"
    },
    "voice_095:r_a03fabecba1508ca": {
      "text": "Call me a fool,\\nI must keep going!",
      "status": "imported"
    },
    "voice_095:r_5391b24a71eb10ae": {
      "text": "I won't lose!",
      "status": "imported"
    },
    "voice_095:r_a554ceef5c87b972": {
      "text": "Damn! I have to retreat for now...!",
      "status": "imported"
    },
    "voice_095:r_546c3d5937fbb7ee": {
      "text": "Sorry! Lancelot, we're pulling out!",
      "status": "imported"
    },
    "voice_095:r_1568ff6298b12b96": {
      "text": "Even if you're a match for Albion!",
      "status": "imported"
    },
    "voice_095:r_2c9d94ba13c5fc50": {
      "text": "With the Energy Wing's speed!",
      "status": "imported"
    },
    "voice_095:r_a77f4913375098d2": {
      "text": "Let's work together, C.C.!",
      "status": "imported"
    },
    "voice_095:r_428c2116ac3071b1": {
      "text": "You protect Lelouch!",
      "status": "imported"
    },
    "voice_095:r_84c116267b79f540": {
      "text": "Our speed is evenly matched... but!",
      "status": "imported"
    },
    "voice_095:r_dad38ee29af2df3a": {
      "text": "It's only a scratch!",
      "status": "imported"
    },
    "voice_095:r_3d32e86f8dc80909": {
      "text": "Something like that can't hit me!",
      "status": "imported"
    },
    "voice_095:r_70451ffbabe2f876": {
      "text": "That won't work!",
      "status": "imported"
    },
    "voice_095:r_d996fd6d4ef5b329": {
      "text": "If I can just sink the flagship!",
      "status": "imported"
    },
    "voice_095:r_8ab47a28f99ef565": {
      "text": "Don't you see how arrogant that is?!",
      "status": "imported"
    },
    "voice_095:r_d89011fe3e5d082a": {
      "text": "I'll get inside your guard!",
      "status": "imported"
    },
    "voice_095:r_3c5b0c2ac812d5de": {
      "text": "Close in and finish it in one go!",
      "status": "imported"
    },
    "voice_095:r_5b9e8897190892eb": {
      "text": "I'll close the gap!",
      "status": "imported"
    },
    "voice_095:r_dd01a4c0d1b36a8d": {
      "text": "You're the commander, aren't you?!",
      "status": "imported"
    },
    "voice_095:r_20920ad2eb3542db": {
      "text": "You spread the war needlessly!",
      "status": "imported"
    },
    "voice_095:r_c958860b0676b1f5": {
      "text": "Why is this the only way you know?!",
      "status": "imported"
    },
    "voice_095:r_5e2669b82ef75ce3": {
      "text": "There has to be another way!",
      "status": "imported"
    },
    "voice_095:r_7847e0ed7dc9282d": {
      "text": "Whatever your reasons, right now!",
      "status": "imported"
    },
    "voice_095:r_8c61c59a1c0aebbf": {
      "text": "Get out of the way, Kallen!",
      "status": "imported"
    },
    "voice_095:r_aba6a7662129d8ce": {
      "text": "Lancelot Albion, launch!",
      "status": "imported"
    },
    "voice_095:r_b84afafb8a33ec60": {
      "text": "That Geass... I've received it!",
      "status": "imported"
    },
    "voice_095:r_fa944da4b6519006": {
      "text": "Then I'll go first!",
      "status": "imported"
    },
    "voice_095:r_95d047bcc17fccc6": {
      "text": "I'll draw the enemy's attention!",
      "status": "imported"
    },
    "voice_095:r_640327a12a559b31": {
      "text": "Then I'll do it!",
      "status": "imported"
    },
    "voice_095:r_bdd38c584fa313d0": {
      "text": "I'll match your timing!",
      "status": "imported"
    },
    "voice_095:r_3fd86c1027f317c8": {
      "text": "All right, target confirmed!",
      "status": "imported"
    },
    "voice_095:r_d0372a183d2007ad": {
      "text": "If it's one-on-one!",
      "status": "imported"
    },
    "voice_095:r_217aa5e1d545b44d": {
      "text": "I'll cover you!",
      "status": "imported"
    },
    "voice_095:r_381992c5d8224937": {
      "text": "I won't yield to anyone!",
      "status": "imported"
    },
    "voice_095:r_f1e7ed9e5874aba5": {
      "text": "Understood! I'll finish them!",
      "status": "imported"
    },
    "voice_095:r_fc25e66a86fc2c85": {
      "text": "We'll coordinate here!",
      "status": "imported"
    },
    "voice_095:r_5aeeb4917340c42d": {
      "text": "Understood! I'll go first!",
      "status": "imported"
    },
    "voice_095:r_b765659981b6516d": {
      "text": "I'll take that role!",
      "status": "imported"
    },
    "voice_095:r_0c427458bc00eb95": {
      "text": "I'll live up to your expectations!",
      "status": "imported"
    }
  }
}
