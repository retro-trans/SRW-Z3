{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_068:r_479b340ccc6c572b": {
      "text": "Hee hee... Coming, coming!",
      "status": "imported"
    },
    "voice_068:r_ca4acbac57a2a35e": {
      "text": "I'll take the Colonel's place!",
      "status": "imported"
    },
    "voice_068:r_77949221bf58f862": {
      "text": "Amuro!\\nYou won't reach the Colonel!!",
      "status": "imported"
    },
    "voice_068:r_70b9c4b9f1f37eff": {
      "text": "Earth made you.\\nIts death saves us!!",
      "status": "imported"
    },
    "voice_068:r_9fcb3754cb1773c7": {
      "text": "I feel pressure coming...!",
      "status": "imported"
    },
    "voice_068:r_3559d2fad32c2435": {
      "text": "I hate you...! Go down!",
      "status": "imported"
    },
    "voice_068:r_f7570547e9f80a64": {
      "text": "Don't come inside my mind!!",
      "status": "imported"
    },
    "voice_068:r_83ec59afbecdec14": {
      "text": "A Gundam means nothing!",
      "status": "imported"
    },
    "voice_068:r_e20bfd42ad95a3c9": {
      "text": "Fall! Gundam!",
      "status": "imported"
    },
    "voice_068:r_0f58a8822381e57f": {
      "text": "I'm here too, you know!",
      "status": "imported"
    },
    "voice_068:r_6dbcc507fb61b51d": {
      "text": "I'll take it from here!",
      "status": "imported"
    },
    "voice_068:r_b42ab697149a7c8a": {
      "text": "Not yet! My turn to strike!",
      "status": "imported"
    },
    "voice_068:r_4de4fcf3b440baf4": {
      "text": "Colonel, I'm coming too!!",
      "status": "imported"
    },
    "voice_068:r_0121a166c715cdff": {
      "text": "I'll help you out, Gyunei!",
      "status": "imported"
    },
    "voice_068:r_30fad37a42bd3ad3": {
      "text": "I can handle this much!",
      "status": "imported"
    },
    "voice_068:r_80a0b2a84e05d81a": {
      "text": "I'll be your shield!",
      "status": "imported"
    },
    "voice_068:r_4a9ac1dff86506d9": {
      "text": "For the Colonel,\\nI could even die!",
      "status": "imported"
    },
    "voice_068:r_bc8538e6af3d2577": {
      "text": "Gyunei, you're too careless!",
      "status": "imported"
    },
    "voice_068:r_924516c8de2b5342": {
      "text": "Where are you looking?!",
      "status": "imported"
    },
    "voice_068:r_da1174533722333f": {
      "text": "Ahahaha! What's that?!",
      "status": "imported"
    },
    "voice_068:r_fdeb8162976e72c1": {
      "text": "You thought you could catch me?",
      "status": "imported"
    },
    "voice_068:r_0fadb5c26df92b42": {
      "text": "I've got so much to do!",
      "status": "imported"
    },
    "voice_068:r_6b15af9a0057cdc8": {
      "text": "I can read your every move!",
      "status": "imported"
    },
    "voice_068:r_15b4a90140e8a33a": {
      "text": "Stubborn fools.\\nYou'll never change!",
      "status": "imported"
    },
    "voice_068:r_af884a6b11dff121": {
      "text": "All of you, picking on me...!!",
      "status": "imported"
    },
    "voice_068:r_ac6fe7838e95647b": {
      "text": "I couldn't dodge!?\\nWhy not!!",
      "status": "imported"
    },
    "voice_068:r_77ca87eacd17ad52": {
      "text": "Damn!\\nNo farther, Amuro!",
      "status": "imported"
    },
    "voice_068:r_bf3244994760e535": {
      "text": "This feeling...! What a creep!",
      "status": "imported"
    },
    "voice_068:r_aabfb21c9d069ce7": {
      "text": "This one's different from the rest!",
      "status": "imported"
    },
    "voice_068:r_48b60d6c48b9b142": {
      "text": "No! I don't want this!!",
      "status": "imported"
    },
    "voice_068:r_8927e6fb681aa809": {
      "text": "I... I...\\nI'm going to burst...!",
      "status": "imported"
    },
    "voice_068:r_665f01666859013b": {
      "text": "Ugh!\\nYou don't understand a thing!",
      "status": "imported"
    },
    "voice_068:r_a571eec59b258d11": {
      "text": "Amuro!\\nQuit troubling the Colonel!!",
      "status": "imported"
    },
    "voice_068:r_ddbe581c5ea9183d": {
      "text": "Why!?\\nYou can read my movements!?",
      "status": "imported"
    },
    "voice_068:r_faae935cca0edc72": {
      "text": "I can't let them distract me...!",
      "status": "imported"
    },
    "voice_068:r_b7b5625d7cd4282f": {
      "text": "Ugh!\\nWhy does this feel so awful!?",
      "status": "imported"
    },
    "voice_068:r_36133ad73a73ef98": {
      "text": "Ah...! So many\\npeople inside me...!",
      "status": "imported"
    },
    "voice_068:r_920740a0219c5085": {
      "text": "D-don't come any closer!!",
      "status": "imported"
    },
    "voice_068:r_a8451712c57c1a72": {
      "text": "Ugh!\\nI must stop you! The Colonel!!",
      "status": "imported"
    },
    "voice_068:r_3633df5b7b8f47fa": {
      "text": "Th-that pressure won't beat me!!",
      "status": "imported"
    },
    "voice_068:r_52dfc56b14b93551": {
      "text": "You're saying you're above me!?",
      "status": "imported"
    },
    "voice_068:r_cf41e8828a90cbdb": {
      "text": "Funnel, go!!",
      "status": "imported"
    },
    "voice_068:r_719e897304ec42d4": {
      "text": "Fall, fall, fall, fall!!",
      "status": "imported"
    },
    "voice_068:r_d5e0a2317c40d322": {
      "text": "Go! Funnel squad!",
      "status": "imported"
    },
    "voice_068:r_ec2ea17765052401": {
      "text": "All of you, faaaaaall!!",
      "status": "imported"
    },
    "voice_068:r_f2d4255f1c2f7542": {
      "text": "Out of my way!",
      "status": "imported"
    },
    "voice_068:r_5d08ad19e2da125b": {
      "text": "Go! Fin Funnel!!",
      "status": "imported"
    },
    "voice_068:r_a7246b52782a877e": {
      "text": "Hit them already!!",
      "status": "imported"
    },
    "voice_068:r_dc8701f6bcb9904f": {
      "text": "I'll show you I can do it!",
      "status": "imported"
    },
    "voice_068:r_d6bdd730f24f66eb": {
      "text": "Fin Funnel, please!!",
      "status": "imported"
    },
    "voice_068:r_41997412868c48c4": {
      "text": "There you are!!",
      "status": "imported"
    },
    "voice_068:r_9e6cf4f389dae55c": {
      "text": "Damn!\\nIs this as far as I go!?",
      "status": "imported"
    },
    "voice_068:r_9e0c80ac7e33b459": {
      "text": "Aaaaaah!!",
      "status": "imported"
    },
    "voice_068:r_7432ef43ed3471dc": {
      "text": "No! I can't counterattack!",
      "status": "imported"
    },
    "voice_068:r_065443f6ddfcf0d7": {
      "text": "Don't get in my way!",
      "status": "imported"
    },
    "voice_068:r_47d52a2839c71715": {
      "text": "You won't get to the Colonel!",
      "status": "imported"
    },
    "voice_068:r_847f82e7f3eef651": {
      "text": "Stop that.\\nLeave the Colonel alone!",
      "status": "imported"
    },
    "voice_068:r_eb7ae28b53dc033c": {
      "text": "No more.\\nYou won't have your way!!",
      "status": "imported"
    },
    "voice_068:r_857c4a52ce8df0fd": {
      "text": "I'm your opponent!!",
      "status": "imported"
    },
    "voice_068:r_8fdf5910927c9591": {
      "text": "That weak Beam?\\nI'll swat it aside!",
      "status": "imported"
    },
    "voice_068:r_7d724dbcc4451e10": {
      "text": "Your Beam means nothing!!",
      "status": "imported"
    },
    "voice_068:r_93e25418a203cb8f": {
      "text": "It's useless!!",
      "status": "imported"
    },
    "voice_068:r_24cf161287ef9d5c": {
      "text": "I won't let you!!",
      "status": "imported"
    },
    "voice_068:r_8f60f6fc86db3107": {
      "text": "There!",
      "status": "imported"
    },
    "voice_068:r_128c35bf3e0e394c": {
      "text": "Ngh!!\\nWh-what is this power!?",
      "status": "imported"
    },
    "voice_068:r_5213c17e13b23de0": {
      "text": "Agh!\\nM-my machine won't hold up!?",
      "status": "imported"
    },
    "voice_068:r_38fdff9483e9245c": {
      "text": "Aah!\\nSuch incredible power...",
      "status": "imported"
    },
    "voice_068:r_620fedec67706d7d": {
      "text": "Why you!\\nThis won't take me down!!",
      "status": "imported"
    },
    "voice_068:r_9680dcd0fddcfcc7": {
      "text": "Agh!\\nThis much won't finish me!",
      "status": "imported"
    },
    "voice_068:r_2a00f1044ad5cbaa": {
      "text": "It grazed me!\\nThat's all!",
      "status": "imported"
    },
    "voice_068:r_3dbeead1bd3164ef": {
      "text": "That kind of attack won't work!",
      "status": "imported"
    },
    "voice_068:r_98d15b8cc09bc915": {
      "text": "What!? This damage is nothing!!",
      "status": "imported"
    },
    "voice_068:r_46e86d000250e137": {
      "text": "I'll dodge something this slow!!",
      "status": "imported"
    },
    "voice_068:r_ac341e7976e88f0b": {
      "text": "You'll never hit me!",
      "status": "imported"
    },
    "voice_068:r_cdbd128a5b4127cc": {
      "text": "Too easy!!",
      "status": "imported"
    },
    "voice_068:r_cfccaa1fbeda124c": {
      "text": "That's what you get, standing there!",
      "status": "imported"
    },
    "voice_068:r_b1f8ec192b9c083a": {
      "text": "Your fault for coming out...!",
      "status": "imported"
    },
    "voice_068:r_a007f9ab9cf048b3": {
      "text": "Hiding there won't save you...!",
      "status": "imported"
    },
    "voice_068:r_ddafde4b065ced49": {
      "text": "I won't let you hinder the Colonel!",
      "status": "imported"
    },
    "voice_068:r_de1213040856c089": {
      "text": "Vroooom!",
      "status": "imported"
    },
    "voice_068:r_3304412ac41f47a6": {
      "text": "Hit!",
      "status": "imported"
    },
    "voice_068:r_0c0775e051211840": {
      "text": "Later!",
      "status": "imported"
    },
    "voice_068:r_a2afffe1c396f0b3": {
      "text": "Go down!",
      "status": "imported"
    },
    "voice_068:r_13c25fbdfddc8a24": {
      "text": "I don't care about you...!",
      "status": "imported"
    },
    "voice_068:r_42ba1ecb310b4bd7": {
      "text": "Why are you getting in my way?!",
      "status": "imported"
    },
    "voice_068:r_d692f1d420460a47": {
      "text": "You have plenty to do, don't you?!",
      "status": "imported"
    },
    "voice_068:r_a5643cec86b18bd2": {
      "text": "Nothing can stop me now!",
      "status": "imported"
    },
    "voice_068:r_68f2dfab20a4a30e": {
      "text": "I don't have time for small fry!",
      "status": "imported"
    },
    "voice_068:r_9cedad8237480563": {
      "text": "You won't go any farther!",
      "status": "imported"
    },
    "voice_068:r_a03fabecba1508ca": {
      "text": "I have to kill every enemy!",
      "status": "imported"
    },
    "voice_068:r_5391b24a71eb10ae": {
      "text": "I'll drive Nanai and Lalah out!",
      "status": "imported"
    },
    "voice_068:r_a554ceef5c87b972": {
      "text": "For the Colonel,\\nI can even die!",
      "status": "imported"
    },
    "voice_068:r_546c3d5937fbb7ee": {
      "text": "Alpha will protect the Colonel!",
      "status": "imported"
    },
    "voice_068:r_1568ff6298b12b96": {
      "text": "Alpha will protect everyone!",
      "status": "imported"
    },
    "voice_068:r_2c9d94ba13c5fc50": {
      "text": "In a Gundam,\\nI feel I can do it all!",
      "status": "imported"
    },
    "voice_068:r_a77f4913375098d2": {
      "text": "Even an old model can still fight!",
      "status": "imported"
    },
    "voice_068:r_428c2116ac3071b1": {
      "text": "I'm firing!",
      "status": "imported"
    },
    "voice_068:r_84c116267b79f540": {
      "text": "You're not getting away!",
      "status": "imported"
    },
    "voice_068:r_dad38ee29af2df3a": {
      "text": "You're right there, aren't you?!",
      "status": "imported"
    },
    "voice_068:r_3d32e86f8dc80909": {
      "text": "The Psycommu is pulling me along!",
      "status": "imported"
    },
    "voice_068:r_70451ffbabe2f876": {
      "text": "I can pull this off too!",
      "status": "imported"
    },
    "voice_068:r_69dfa1659715e2fa": {
      "text": "I'll use the saber...!",
      "status": "imported"
    },
    "voice_068:r_d996fd6d4ef5b329": {
      "text": "I'll give you a real surprise!",
      "status": "imported"
    },
    "voice_068:r_8ab47a28f99ef565": {
      "text": "Ta-dah!",
      "status": "imported"
    },
    "voice_068:r_ca85f87cee5e31f7": {
      "text": "Look, look, look!",
      "status": "imported"
    },
    "voice_068:r_04e815a8d425827d": {
      "text": "Heeeere goes!",
      "status": "imported"
    },
    "voice_068:r_7bea3023abbf8a94": {
      "text": "Fall, fall, fall!",
      "status": "imported"
    },
    "voice_068:r_5e2669b82ef75ce3": {
      "text": "That's how you do it!",
      "status": "imported"
    },
    "voice_068:r_97b7431eeb81e6b6": {
      "text": "Ahahahahaha!",
      "status": "imported"
    },
    "voice_068:r_9b9726b1872759d6": {
      "text": "It's not over yet!",
      "status": "imported"
    },
    "voice_068:r_4e37f92e7d2fc62e": {
      "text": "Enough already! Just give up!",
      "status": "imported"
    },
    "voice_068:r_66ab4cfe1557909d": {
      "text": "You're persistent! Then take this!",
      "status": "imported"
    },
    "voice_068:r_0bad405ee6ca63ba": {
      "text": "If not for her,\\nI'd be with Amuro...",
      "status": "imported"
    },
    "voice_068:r_2072eaf71a260ae7": {
      "text": "If Amuro obstructs the Colonel...!",
      "status": "imported"
    },
    "voice_068:r_6c13bbfd27a7799e": {
      "text": "So what if it's a Gundam!",
      "status": "imported"
    },
    "voice_068:r_06f88dcbd3c9e738": {
      "text": "Know-it-all! That's why\\nI hate you!",
      "status": "imported"
    },
    "voice_068:r_b28faf9f71bc3598": {
      "text": "You should just\\nkeep chasing Audrey!",
      "status": "imported"
    },
    "voice_068:r_8a29278549f8e07a": {
      "text": "I hate kids! They're so pushy!",
      "status": "imported"
    },
    "voice_068:r_7e6c573c26177f98": {
      "text": "I only know your face, and yet...!",
      "status": "imported"
    },
    "voice_068:r_45abf84f7757d6eb": {
      "text": "Those bell-ringing creeps!",
      "status": "imported"
    },
    "voice_068:r_edd7a13ab8f06a14": {
      "text": "I won't listen to your jealousy!",
      "status": "imported"
    },
    "voice_068:r_8165e5b41f0124c4": {
      "text": "That's why I hate young men!",
      "status": "imported"
    },
    "voice_068:r_4e05581b7432cce8": {
      "text": "I've never liked you!",
      "status": "imported"
    },
    "voice_068:r_a60b107ea3c36a86": {
      "text": "I'll expose what you really are!",
      "status": "imported"
    },
    "voice_068:r_e33693e5ba4665b0": {
      "text": "I know this won't work...\\nAnd yet!",
      "status": "imported"
    },
    "voice_068:r_72a21a1a489af001": {
      "text": "I know how you feel! But still!",
      "status": "imported"
    },
    "voice_068:r_eb643f8bf737a0ca": {
      "text": "Someone's acting as a shield...!",
      "status": "imported"
    },
    "voice_068:r_0a3fccb71ec6cf2a": {
      "text": "What!? Someone's calling to me...!?",
      "status": "imported"
    },
    "voice_068:r_9b63cf1f3e0207ef": {
      "text": "Someone like Gyunei is here!",
      "status": "imported"
    },
    "voice_068:r_8356f4e3dcdff938": {
      "text": "Just what an adult would do!",
      "status": "imported"
    },
    "voice_068:r_1d6d784036ae0bd7": {
      "text": "I hate women like her!",
      "status": "imported"
    },
    "voice_068:r_625664af02183c17": {
      "text": "What an awful woman...!",
      "status": "imported"
    },
    "voice_068:r_3701cba361f80ea5": {
      "text": "Young men are all the same!",
      "status": "imported"
    },
    "voice_068:r_63f429c5c68c0863": {
      "text": "Do those things have hearts...?",
      "status": "imported"
    },
    "voice_068:r_38e4a434c91d8ef0": {
      "text": "What are these things?!",
      "status": "imported"
    },
    "voice_068:r_4824bea6bab3af67": {
      "text": "I'll shoot down every vile freak...!",
      "status": "imported"
    },
    "voice_068:r_862b92e63adb9734": {
      "text": "You monsters, get out of here!",
      "status": "imported"
    },
    "voice_068:r_cb306ef55e49d107": {
      "text": "You'd wipe humanity out...!",
      "status": "imported"
    },
    "voice_068:r_57b2bd2de8a1408d": {
      "text": "I'll drive you off the Earth!",
      "status": "imported"
    },
    "voice_068:r_76f080a4881e8ab5": {
      "text": "Once you're down, we win!",
      "status": "imported"
    },
    "voice_068:r_288133bc5b573dae": {
      "text": "I now believe\\nin humanity's light!",
      "status": "imported"
    },
    "voice_068:r_6f95653e548f8fcf": {
      "text": "Can we change?\\nI'll beat you to see!",
      "status": "imported"
    },
    "voice_068:r_e9b3307e9eb69f11": {
      "text": "Fin Funnel!",
      "status": "imported"
    },
    "voice_068:r_981f8fedd5414fe5": {
      "text": "Fin Funnel! There!",
      "status": "imported"
    },
    "voice_068:r_641550a2f54cb456": {
      "text": "Beam Confuse!",
      "status": "imported"
    },
    "voice_068:r_a0f2074af8debbfa": {
      "text": "I feel so many people's wills...!",
      "status": "imported"
    },
    "voice_068:r_b5f5a97ed82acb0b": {
      "text": "Please, lend me your strength!",
      "status": "imported"
    },
    "voice_068:r_d9cd2e4ded064396": {
      "text": "Gooooo!!",
      "status": "imported"
    },
    "voice_068:r_59fca03e929366c1": {
      "text": "I'll hit you back!",
      "status": "imported"
    },
    "voice_068:r_0d65eb631dcb7514": {
      "text": "You know you can't escape!",
      "status": "imported"
    },
    "voice_068:r_d03018a31e23f1e9": {
      "text": "Now face your punishment!",
      "status": "imported"
    },
    "voice_068:r_279da5f732aa8847": {
      "text": "You're the one who started this!",
      "status": "imported"
    },
    "voice_068:r_97f82e3cb6f70110": {
      "text": "You won't get off that easily!",
      "status": "imported"
    },
    "voice_068:r_c5611d8dd6def96b": {
      "text": "How dare you...! How dare you!",
      "status": "imported"
    },
    "voice_068:r_6f12cc8ed2732eb5": {
      "text": "I'm keeping this up!",
      "status": "imported"
    },
    "voice_068:r_7abfc55f8fb62ba7": {
      "text": "Shouldn't have looked away!",
      "status": "imported"
    },
    "voice_068:r_99e7a66c650b5892": {
      "text": "The Colonel isn't just handsome!",
      "status": "imported"
    },
    "voice_068:r_5b2247b5cfbcd7b2": {
      "text": "Gyunei, coordinate with me!",
      "status": "imported"
    },
    "voice_068:r_2d7a9c06347582d9": {
      "text": "Not bad, Hathaway!",
      "status": "imported"
    },
    "voice_068:r_bf953d64c3c7d9b7": {
      "text": "Amazing! That's Amuro for you!",
      "status": "imported"
    },
    "voice_068:r_e09b933e3e706779": {
      "text": "No wonder the Colonel noticed you!",
      "status": "imported"
    },
    "voice_068:r_66236eb99b676e5b": {
      "text": "I'll follow the Unicorn!",
      "status": "imported"
    },
    "voice_068:r_9639a2dbcd2f58ed": {
      "text": "Heh heh, good instincts!",
      "status": "imported"
    },
    "voice_068:r_aeea0893acb93d35": {
      "text": "Look out!",
      "status": "imported"
    },
    "voice_068:r_b31568654e53487b": {
      "text": "Not a chance!",
      "status": "imported"
    },
    "voice_068:r_2502132569141ea3": {
      "text": "Colonel! Fall back!",
      "status": "imported"
    },
    "voice_068:r_1ff312798a52c8eb": {
      "text": "Move, Gyunei!",
      "status": "imported"
    },
    "voice_068:r_fa07d90fca62f593": {
      "text": "I won't let them hurt Hathaway!",
      "status": "imported"
    },
    "voice_068:r_a25bf2676ecf9d83": {
      "text": "Why's Amuro letting his guard down?!",
      "status": "imported"
    },
    "voice_068:r_237a0288b42dce20": {
      "text": "You're being targeted, Kamille!",
      "status": "imported"
    },
    "voice_068:r_0556e8a22779ea8e": {
      "text": "Don't be so reckless!",
      "status": "imported"
    },
    "voice_068:r_09d377101a48d92a": {
      "text": "Huh!? What's going on?!",
      "status": "imported"
    },
    "voice_068:r_11517cc7b0494dbf": {
      "text": "Why can't I attack?!",
      "status": "imported"
    },
    "voice_068:r_b5864501463db244": {
      "text": "I won't just let them beat on me...!",
      "status": "imported"
    },
    "voice_068:r_a88939ea84b4474d": {
      "text": "I lost sight of the enemy...?",
      "status": "imported"
    },
    "voice_068:r_a870d0cf7cc11ec6": {
      "text": "No! I can't reach from here!",
      "status": "imported"
    },
    "voice_068:r_03f6158ef83964f3": {
      "text": "Like that could hit me!",
      "status": "imported"
    },
    "voice_068:r_2970a83693cdcc25": {
      "text": "I can read you!",
      "status": "imported"
    },
    "voice_068:r_be661448b85d0009": {
      "text": "If I dodge this way...!",
      "status": "imported"
    },
    "voice_068:r_958a56c1151cab9e": {
      "text": "I won't fall for that trick!",
      "status": "imported"
    },
    "voice_068:r_8b18aa4cc69547df": {
      "text": "That's the best attack you can do?!",
      "status": "imported"
    },
    "voice_068:r_3e87f6fc3ea65aef": {
      "text": "You don't understand anything!",
      "status": "imported"
    },
    "voice_068:r_5508a7bfa9074eb9": {
      "text": "No waaaay!",
      "status": "imported"
    },
    "voice_068:r_09a003e91f0d5dc7": {
      "text": "I don't care if it's a Gundam!",
      "status": "imported"
    },
    "voice_068:r_192447448ebd7bb5": {
      "text": "I'll be the one to beat Amuro!",
      "status": "imported"
    },
    "voice_068:r_e92920ba4b301b9f": {
      "text": "Beat them, win the Colonel's praise!",
      "status": "imported"
    },
    "voice_068:r_207b256d613bb896": {
      "text": "I know what Gyunei is thinking!",
      "status": "imported"
    },
    "voice_068:r_a6fd676d8146501b": {
      "text": "I hate you, Full Frontal!",
      "status": "imported"
    },
    "voice_068:r_09a780acca0eb4b0": {
      "text": "That won't work on me!",
      "status": "imported"
    },
    "voice_068:r_af62f2ee466b5c8c": {
      "text": "Huh? Did the barrier activate?",
      "status": "imported"
    },
    "voice_068:r_20cfb719db02fafd": {
      "text": "Thanks, Fin Funnel units.",
      "status": "imported"
    },
    "voice_068:r_570c1fdf72edb283": {
      "text": "Huh...! That hit me!?",
      "status": "imported"
    },
    "voice_068:r_23f0d87a5a6cfca1": {
      "text": "So what if you've got that!",
      "status": "imported"
    },
    "voice_068:r_60c94ea4eb7f7404": {
      "text": "Don't get cocky!",
      "status": "imported"
    },
    "voice_068:r_727b2ee0277f9159": {
      "text": "It only grazed me!",
      "status": "imported"
    },
    "voice_068:r_cff4d2eae8a939ed": {
      "text": "How did that hit me?!",
      "status": "imported"
    },
    "voice_068:r_1428fe5f35a9427b": {
      "text": "Nobody touches me and gets away!",
      "status": "imported"
    },
    "voice_068:r_96d39b8bdfa6f183": {
      "text": "So this is war...!",
      "status": "imported"
    },
    "voice_068:r_0e4f9b8a2d26ebff": {
      "text": "Eek! What are you doing?!",
      "status": "imported"
    },
    "voice_068:r_79e0d542fe12bcf7": {
      "text": "It's only a little armor damage!",
      "status": "imported"
    },
    "voice_068:r_eff747ba39a55393": {
      "text": "I knew it was coming, but...!",
      "status": "imported"
    },
    "voice_068:r_b2dc77aa6dd77e69": {
      "text": "If only this machine moved faster!",
      "status": "imported"
    },
    "voice_068:r_445d40d8b5d7092b": {
      "text": "I get it!\\nI have to move faster!",
      "status": "imported"
    },
    "voice_068:r_bbb633cb5e8e6daf": {
      "text": "Gundam! How dare you!",
      "status": "imported"
    },
    "voice_068:r_0abd8b6c713ccdac": {
      "text": "Why!? I can't beat Amuro!?",
      "status": "imported"
    },
    "voice_068:r_f4ff463b2fda1b86": {
      "text": "So what if the Colonel noticed you?!",
      "status": "imported"
    },
    "voice_068:r_4e63c037d3cb8a3d": {
      "text": "Gyunei! Now I'm really mad!",
      "status": "imported"
    },
    "voice_068:r_9ca8d188ae805e3a": {
      "text": "You can't\\nreplace the Colonel!",
      "status": "imported"
    },
    "voice_068:r_d52bece55796f599": {
      "text": "I'm scared, I feel sick... Ugh...!",
      "status": "imported"
    },
    "voice_068:r_358fe5a50bbee1df": {
      "text": "What is this pressure...!?",
      "status": "imported"
    },
    "voice_068:r_638834e16724002f": {
      "text": "Ugh...! My mind's being pulled...!",
      "status": "imported"
    },
    "voice_068:r_b02fca1590ac1210": {
      "text": "Aaaaaah! Colonel!",
      "status": "imported"
    },
    "voice_068:r_f0344d2fbaa9db77": {
      "text": "I'm scared...! But I have to fight!",
      "status": "imported"
    },
    "voice_068:r_3328eef766ff2c2c": {
      "text": "No...! I won't let it end here!",
      "status": "imported"
    },
    "voice_068:r_23b037cf6ccc695c": {
      "text": "They got me!?",
      "status": "imported"
    },
    "voice_068:r_883ad1128d340c5e": {
      "text": "I'm sorry, Colonel! This is it!",
      "status": "imported"
    },
    "voice_068:r_a9e6ed99025a703b": {
      "text": "A direct hit!? It can't be...!",
      "status": "imported"
    },
    "voice_068:r_b0d1459d6daeebbe": {
      "text": "Aah...! Hathaway...!",
      "status": "imported"
    },
    "voice_068:r_cd4893b409472e97": {
      "text": "It was just getting good! Go on!",
      "status": "imported"
    },
    "voice_068:r_5691cc71770ffdde": {
      "text": "You're awfully obedient.",
      "status": "imported"
    },
    "voice_068:r_964e07c5563a5508": {
      "text": "I see. That's another idea... Maybe!",
      "status": "imported"
    },
    "voice_068:r_db54e717bff3e3b2": {
      "text": "Come back safely, okay? Promise me!",
      "status": "imported"
    },
    "voice_068:r_0465f74c0488ad70": {
      "text": "I just have to draw their fire!",
      "status": "imported"
    },
    "voice_068:r_a30c8238b5208470": {
      "text": "I'm going on ahead!",
      "status": "imported"
    },
    "voice_068:r_64bf1c63c7c1ebdd": {
      "text": "We focus all our attacks, right?!",
      "status": "imported"
    },
    "voice_068:r_f6d5042f671118fa": {
      "text": "I can at least hold them off!",
      "status": "imported"
    },
    "voice_068:r_0be18539fac21ba4": {
      "text": "That's what I should target, right!",
      "status": "imported"
    },
    "voice_068:r_c05bd0cf089d667f": {
      "text": "One-on-one, I won't lose!",
      "status": "imported"
    },
    "voice_068:r_f69a0e1d0d67fd0e": {
      "text": "I have to show I can do it right!",
      "status": "imported"
    },
    "voice_068:r_c4e734ceafabd82c": {
      "text": "I can do this too!",
      "status": "imported"
    }
  }
}
