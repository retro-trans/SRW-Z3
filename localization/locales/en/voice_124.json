{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_124:r_479b340ccc6c572b": {
      "text": "Forcing you down isn't my style!",
      "status": "imported"
    },
    "voice_124:r_ca4acbac57a2a35e": {
      "text": "I'll get my song to you, too!",
      "status": "imported"
    },
    "voice_124:r_77949221bf58f862": {
      "text": "The wild live show's starting!",
      "status": "imported"
    },
    "voice_124:r_70b9c4b9f1f37eff": {
      "text": "My sound hits harder\\nthan a Missile!",
      "status": "imported"
    },
    "voice_124:r_9fcb3754cb1773c7": {
      "text": "I'll give you plenty of my song!",
      "status": "imported"
    },
    "voice_124:r_3559d2fad32c2435": {
      "text": "Gaaaaah! Now I'm fired up!!",
      "status": "imported"
    },
    "voice_124:r_f7570547e9f80a64": {
      "text": "My sound will rock the universe!",
      "status": "imported"
    },
    "voice_124:r_cbab0f4720e1fcf1": {
      "text": "I sing when I want!\\nThat's my sound!",
      "status": "imported"
    },
    "voice_124:r_0bbe0b4f5364e732": {
      "text": "I'll get my song through to anyone!",
      "status": "imported"
    },
    "voice_124:r_5dda5198137cb02a": {
      "text": "A moved heart knows no home planet!",
      "status": "imported"
    },
    "voice_124:r_83ec59afbecdec14": {
      "text": "I'll rock you into a short circuit!",
      "status": "imported"
    },
    "voice_124:r_e20bfd42ad95a3c9": {
      "text": "Machine or not,\\nI'll keep singing!",
      "status": "imported"
    },
    "voice_124:r_0f58a8822381e57f": {
      "text": "Try singing, too!\\nIt'll thrill you!",
      "status": "imported"
    },
    "voice_124:r_6dbcc507fb61b51d": {
      "text": "PLANET DANCE!",
      "status": "imported"
    },
    "voice_124:r_b42ab697149a7c8a": {
      "text": "Here we go!\\nPLANET DANCE!",
      "status": "imported"
    },
    "voice_124:r_4de4fcf3b440baf4": {
      "text": "PLANET DANCE!\\nListen to my song!",
      "status": "imported"
    },
    "voice_124:r_0121a166c715cdff": {
      "text": "TOTSUGEKI LOVE HEART, let's go!",
      "status": "imported"
    },
    "voice_124:r_30fad37a42bd3ad3": {
      "text": "TOTSUGEKI LOVE HEART!",
      "status": "imported"
    },
    "voice_124:r_80a0b2a84e05d81a": {
      "text": "All right! Now listen to my song!",
      "status": "imported"
    },
    "voice_124:r_4a9ac1dff86506d9": {
      "text": "You came all this way!\\nListen close!",
      "status": "imported"
    },
    "voice_124:r_bc8538e6af3d2577": {
      "text": "Hah! This live show's just starting!",
      "status": "imported"
    },
    "voice_124:r_924516c8de2b5342": {
      "text": "My turn, huh?\\nListen up good!",
      "status": "imported"
    },
    "voice_124:r_da1174533722333f": {
      "text": "Sneaking around isn't my style!",
      "status": "imported"
    },
    "voice_124:r_fdeb8162976e72c1": {
      "text": "Stop! Listen to my song!",
      "status": "imported"
    },
    "voice_124:r_0fadb5c26df92b42": {
      "text": "I can't watch this, Gamlin.",
      "status": "imported"
    },
    "voice_124:r_6b15af9a0057cdc8": {
      "text": "Time for a short break.",
      "status": "imported"
    },
    "voice_124:r_15b4a90140e8a33a": {
      "text": "Damn, my song isn't reaching them!",
      "status": "imported"
    },
    "voice_124:r_af884a6b11dff121": {
      "text": "I'll sing even without an audience!!",
      "status": "imported"
    },
    "voice_124:r_ac6fe7838e95647b": {
      "text": "No force!\\nMy song will move you!",
      "status": "imported"
    },
    "voice_124:r_77ca87eacd17ad52": {
      "text": "Stop attacking!\\nListen to my song!",
      "status": "imported"
    },
    "voice_124:r_bf3244994760e535": {
      "text": "Trading shots creates nothing!",
      "status": "imported"
    },
    "voice_124:r_aabfb21c9d069ce7": {
      "text": "Fighting's pointless!\\nHear my song!",
      "status": "imported"
    },
    "voice_124:r_02479dc8fe989560": {
      "text": "No one can stop me from singing!",
      "status": "imported"
    },
    "voice_124:r_a2df00f91a9b0a9e": {
      "text": "Heh! Now I'm getting fired up!!",
      "status": "imported"
    },
    "voice_124:r_48b60d6c48b9b142": {
      "text": "Enough of this crap!",
      "status": "imported"
    },
    "voice_124:r_8927e6fb681aa809": {
      "text": "This is just\\nanother guitar to me!",
      "status": "imported"
    },
    "voice_124:r_665f01666859013b": {
      "text": "Fighting is totally pointless!",
      "status": "imported"
    },
    "voice_124:r_a571eec59b258d11": {
      "text": "Heh.\\nThe show's only just begun!",
      "status": "imported"
    },
    "voice_124:r_ddbe581c5ea9183d": {
      "text": "Looks like it was no big deal.",
      "status": "imported"
    },
    "voice_124:r_faae935cca0edc72": {
      "text": "Stop! This fighting is pointless!!",
      "status": "imported"
    },
    "voice_124:r_d4430bf362340b32": {
      "text": "It's only a scratch!",
      "status": "imported"
    },
    "voice_124:r_6ff1323b355593e0": {
      "text": "The show's not over yet!\\nNow listen!",
      "status": "imported"
    },
    "voice_124:r_b7b5625d7cd4282f": {
      "text": "Damn! I'll make you hear my song!",
      "status": "imported"
    },
    "voice_124:r_36133ad73a73ef98": {
      "text": "Whoa! What was that?\\nThat hurts!",
      "status": "imported"
    },
    "voice_124:r_920740a0219c5085": {
      "text": "Can't you hear my song!?\\nNo way!",
      "status": "imported"
    },
    "voice_124:r_a8451712c57c1a72": {
      "text": "Damn you!\\nYou wrecked my Valkyrie!",
      "status": "imported"
    },
    "voice_124:r_3633df5b7b8f47fa": {
      "text": "No good!\\nNothing's responding!",
      "status": "imported"
    },
    "voice_124:r_52dfc56b14b93551": {
      "text": "Guh! Wh-what the hell was that!?",
      "status": "imported"
    },
    "voice_124:r_1b9b2aab5cb104da": {
      "text": "Hey! Are you serious!?",
      "status": "imported"
    },
    "voice_124:r_342044c706a2340f": {
      "text": "Damn! Next time, I'll pull it off!",
      "status": "imported"
    },
    "voice_124:r_cf41e8828a90cbdb": {
      "text": "We'll finish this another time!",
      "status": "imported"
    },
    "voice_124:r_d5e0a2317c40d322": {
      "text": "God or not,\\nI'll move your heart!",
      "status": "imported"
    },
    "voice_124:r_dc8701f6bcb9904f": {
      "text": "Song is heart! Don't you forget it!",
      "status": "imported"
    },
    "voice_124:r_d6bdd730f24f66eb": {
      "text": "I know!\\nI won't lose to Basara!",
      "status": "imported"
    },
    "voice_124:r_41997412868c48c4": {
      "text": "MY FRIENDS!",
      "status": "imported"
    },
    "voice_124:r_9e6cf4f389dae55c": {
      "text": "Don't get cocky and mess this up!",
      "status": "imported"
    },
    "voice_124:r_9e0c80ac7e33b459": {
      "text": "None of your business! Let's go!!",
      "status": "imported"
    },
    "voice_124:r_7432ef43ed3471dc": {
      "text": "I'll sing my heart out!\\nMY FRIENDS!",
      "status": "imported"
    },
    "voice_124:r_065443f6ddfcf0d7": {
      "text": "So this is...\\nthat jerk's power...!",
      "status": "imported"
    },
    "voice_124:r_47d52a2839c71715": {
      "text": "Let's go, Vajra! Listen to my song!",
      "status": "imported"
    },
    "voice_124:r_847f82e7f3eef651": {
      "text": "You guys will hear my song, too!",
      "status": "imported"
    },
    "voice_124:r_eb7ae28b53dc033c": {
      "text": "No brain needed!\\nInto your heart!",
      "status": "imported"
    },
    "voice_124:r_857c4a52ce8df0fd": {
      "text": "It'll echo\\nto the universe's edge!",
      "status": "imported"
    },
    "voice_124:r_55417493fce1d347": {
      "text": "Song has power\\nthat beats ESP!",
      "status": "imported"
    },
    "voice_124:r_8fdf5910927c9591": {
      "text": "100 years of war?\\nHear my song!",
      "status": "imported"
    },
    "voice_124:r_7d724dbcc4451e10": {
      "text": "Feel my burning heart,\\nsoldier!",
      "status": "imported"
    },
    "voice_124:r_adeb0a29274d3d9b": {
      "text": "Fighting's stupid!\\nHear my song!",
      "status": "imported"
    },
    "voice_124:r_8f60f6fc86db3107": {
      "text": "Boss man,\\nthis special show's yours!",
      "status": "imported"
    },
    "voice_124:r_b1de76a75a253c13": {
      "text": "I'll play you my greatest number!",
      "status": "imported"
    },
    "voice_124:r_128c35bf3e0e394c": {
      "text": "Forget the fight!\\nListen to my song!",
      "status": "imported"
    },
    "voice_124:r_a5643cec86b18bd2": {
      "text": "Let's let 'em hear\\nour harmony!",
      "status": "imported"
    },
    "voice_124:r_68f2dfab20a4a30e": {
      "text": "Let's go out with a bang!",
      "status": "imported"
    },
    "voice_124:r_9cedad8237480563": {
      "text": "!",
      "status": "imported"
    },
    "voice_124:r_a03fabecba1508ca": {
      "text": "All right! Now I'm fired up, too!",
      "status": "imported"
    },
    "voice_124:r_5391b24a71eb10ae": {
      "text": "DYNAMITE EXPLOSION!",
      "status": "imported"
    },
    "voice_124:r_a554ceef5c87b972": {
      "text": "Fiiiiiire!",
      "status": "imported"
    },
    "voice_124:r_546c3d5937fbb7ee": {
      "text": "We've got a special guest!\\nLet's go!",
      "status": "imported"
    },
    "voice_124:r_2c9d94ba13c5fc50": {
      "text": "Let's let 'em hear our song!",
      "status": "imported"
    },
    "voice_124:r_428c2116ac3071b1": {
      "text": "Everyone, listen to Basara's song!",
      "status": "imported"
    },
    "voice_124:r_dad38ee29af2df3a": {
      "text": "Quit spacing out, Alto!",
      "status": "imported"
    },
    "voice_124:r_3d32e86f8dc80909": {
      "text": "Don't make your sister cry!",
      "status": "imported"
    },
    "voice_124:r_70451ffbabe2f876": {
      "text": "Come on!\\nTime for our greatest show!",
      "status": "imported"
    },
    "voice_124:r_d996fd6d4ef5b329": {
      "text": "We'll hit 'em\\nwith hearts blazing!",
      "status": "imported"
    },
    "voice_124:r_8ab47a28f99ef565": {
      "text": "I'll sing from my heart, too!",
      "status": "imported"
    },
    "voice_124:r_ca85f87cee5e31f7": {
      "text": "Blazing fiiiiiiiiiiire!!",
      "status": "imported"
    },
    "voice_124:r_9072ea7bc71df136": {
      "text": "Heh, kept you waiting! Encore time!",
      "status": "imported"
    },
    "voice_124:r_04e815a8d425827d": {
      "text": "The real thrill starts now!",
      "status": "imported"
    },
    "voice_124:r_d89011fe3e5d082a": {
      "text": "You've come far!\\nHear it to the end!",
      "status": "imported"
    },
    "voice_124:r_3c5b0c2ac812d5de": {
      "text": "Quit attacking!\\nListen to my song!",
      "status": "imported"
    },
    "voice_124:r_5b9e8897190892eb": {
      "text": "All of you! Listen to my song!!",
      "status": "imported"
    },
    "voice_124:r_7bea3023abbf8a94": {
      "text": "Blazing fire!!",
      "status": "imported"
    },
    "voice_124:r_dd01a4c0d1b36a8d": {
      "text": "Basara, Mylene!\\nKeep your harmony!",
      "status": "imported"
    },
    "voice_124:r_20920ad2eb3542db": {
      "text": "I know, but Basara's the one...!",
      "status": "imported"
    },
    "voice_124:r_0ab7914877fd48ed": {
      "text": "Then follow Basara!\\nLet's go!!",
      "status": "imported"
    },
    "voice_124:r_cb846feec748c2e3": {
      "text": "TRY AGAIN!!",
      "status": "imported"
    },
    "voice_124:r_c958860b0676b1f5": {
      "text": "Hear Fire Bomber's sound\\nright now!",
      "status": "imported"
    },
    "voice_124:r_5e2669b82ef75ce3": {
      "text": "I'm giving it my all, too!",
      "status": "imported"
    },
    "voice_124:r_7847e0ed7dc9282d": {
      "text": "Go, Mylene!\\nLet's rock the galaxy!",
      "status": "imported"
    },
    "voice_124:r_6825fd1ff907bd22": {
      "text": "Let's go! Basara, Mylene!",
      "status": "imported"
    },
    "voice_124:r_607f666f1563bc0d": {
      "text": "I'm standing by over here, too!",
      "status": "imported"
    },
    "voice_124:r_97b7431eeb81e6b6": {
      "text": "All right! Sing it blazing hot!!",
      "status": "imported"
    },
    "voice_124:r_132f605d02975e71": {
      "text": "Here we go!\\nTRY AGAIN!!",
      "status": "imported"
    },
    "voice_124:r_9b9726b1872759d6": {
      "text": "Let's play!\\nKeep up, Mylene.",
      "status": "imported"
    },
    "voice_124:r_1252db29683fefe0": {
      "text": "Don't worry, Ray!",
      "status": "imported"
    },
    "voice_124:r_ad3d538f1e909184": {
      "text": "Here we go!\\nBlazing fiiiiiiire!!",
      "status": "imported"
    },
    "voice_124:r_aba6a7662129d8ce": {
      "text": "Basara, Mylene!\\nForm up!",
      "status": "imported"
    },
    "voice_124:r_b84afafb8a33ec60": {
      "text": "Roger! I'm ready anytime!",
      "status": "imported"
    },
    "voice_124:r_c8c59db85bf875e6": {
      "text": "Go! Booooomber!!",
      "status": "imported"
    },
    "voice_124:r_fa944da4b6519006": {
      "text": "We'll show you\\nFire Bomber live!",
      "status": "imported"
    },
    "voice_124:r_95d047bcc17fccc6": {
      "text": "All right! Let's make it flashy!",
      "status": "imported"
    },
    "voice_124:r_d0372a183d2007ad": {
      "text": "Whooooaa!!\\nWe'll rock the galaxy!!",
      "status": "imported"
    },
    "voice_124:r_381992c5d8224937": {
      "text": "Basara, Mylene!\\nMajor 7 formation!",
      "status": "imported"
    },
    "voice_124:r_f1e7ed9e5874aba5": {
      "text": "OK, Ray!",
      "status": "imported"
    },
    "voice_124:r_fc25e66a86fc2c85": {
      "text": "All right, let's go!\\nHear my song!",
      "status": "imported"
    },
    "voice_124:r_b765659981b6516d": {
      "text": "Formation E Minor,\\n8-beat!",
      "status": "imported"
    },
    "voice_124:r_0c427458bc00eb95": {
      "text": "Um... what was that one again...?",
      "status": "imported"
    },
    "voice_124:r_774a9ab4d8fd5351": {
      "text": "Song is heart!\\nSkip all the details!",
      "status": "imported"
    },
    "voice_124:r_7d2617c809fead70": {
      "text": "That's a Pinpoint Barrier for you!",
      "status": "imported"
    },
    "voice_124:r_001cbec4d9a4283f": {
      "text": "Are you feeling it, you guys!?",
      "status": "imported"
    },
    "voice_124:r_8ad40afecd02b41e": {
      "text": "Roooooar!! You move today!!",
      "status": "imported"
    },
    "voice_124:r_26e5efec03c03d78": {
      "text": "Basara... listen to me.",
      "status": "imported"
    },
    "voice_124:r_4ad81e88c7557a8b": {
      "text": "Basara, how was your journey?",
      "status": "imported"
    },
    "voice_124:r_1f65a7af190e4674": {
      "text": "Hear my song!",
      "status": "imported"
    },
    "voice_124:r_40c5a9358ed5bf29": {
      "text": "Blazing fiiiiiiiire!!",
      "status": "imported"
    },
    "voice_124:r_f2e18dfdfe0c89ea": {
      "text": "Go!\\nPLANET DANCE! Blazing fire!!",
      "status": "imported"
    },
    "voice_124:r_cf7dbf49e96a5755": {
      "text": "Listen to my song!!",
      "status": "imported"
    },
    "voice_124:r_fa96676cc65bb509": {
      "text": "Listen to my song!!\\nJust kidding!",
      "status": "imported"
    },
    "voice_124:r_4e37f92e7d2fc62e": {
      "text": "Yes, gladly!",
      "status": "imported"
    },
    "voice_124:r_b28faf9f71bc3598": {
      "text": "Booooomber!!",
      "status": "imported"
    },
    "voice_124:r_6f95653e548f8fcf": {
      "text": "It'll echo to the galaxy's edge!",
      "status": "imported"
    },
    "voice_124:r_d249d68bada91ab9": {
      "text": "Let's do this! Nice and flashy!",
      "status": "imported"
    },
    "voice_124:r_6026da5acbda7c69": {
      "text": "Now I'll make\\nyour heart tremble!",
      "status": "imported"
    },
    "voice_124:r_981f8fedd5414fe5": {
      "text": "Jeez...\\nYou guys, enough already!",
      "status": "imported"
    },
    "voice_124:r_96bb0dcde0c8c44a": {
      "text": "Out of nowhere!?\\nYou startled me!",
      "status": "imported"
    },
    "voice_124:r_641550a2f54cb456": {
      "text": "You've gotta be kidding me.",
      "status": "imported"
    },
    "voice_124:r_a0f2074af8debbfa": {
      "text": "Barriers are pretty handy after all.",
      "status": "imported"
    },
    "voice_124:r_b5f5a97ed82acb0b": {
      "text": "I'm not feeling it...",
      "status": "imported"
    },
    "voice_124:r_d9cd2e4ded064396": {
      "text": "Basara, Mylene!\\nMedley formation!",
      "status": "imported"
    },
    "voice_124:r_99e6349431aaf23b": {
      "text": "Got it, Ray!",
      "status": "imported"
    },
    "voice_124:r_ec1081caf845f56a": {
      "text": "We'll hit 'em with our hearts!\\nGo!!",
      "status": "imported"
    },
    "voice_124:r_76d1e51c8b494a60": {
      "text": "However huge,\\nmy song will move you!",
      "status": "imported"
    },
    "voice_124:r_eb5f687fcd372ae7": {
      "text": "Black Hole!?\\nMy song will fill it!",
      "status": "imported"
    },
    "voice_124:r_2329428a6871d9fa": {
      "text": "Song will tame your urge to fight!",
      "status": "imported"
    }
  }
}
