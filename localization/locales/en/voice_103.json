{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_103:r_479b340ccc6c572b": {
      "text": "Strike first and you win, they say!",
      "status": "imported"
    },
    "voice_103:r_ca4acbac57a2a35e": {
      "text": "Target at visual range...!",
      "status": "imported"
    },
    "voice_103:r_77949221bf58f862": {
      "text": "This is Daguza! Engaging!",
      "status": "imported"
    },
    "voice_103:r_70b9c4b9f1f37eff": {
      "text": "See how Echoes fights.\\nRemember it!",
      "status": "imported"
    },
    "voice_103:r_9fcb3754cb1773c7": {
      "text": "I'll hit it!",
      "status": "imported"
    },
    "voice_103:r_3559d2fad32c2435": {
      "text": "With moves like that...!",
      "status": "imported"
    },
    "voice_103:r_f7570547e9f80a64": {
      "text": "Aim for the vitals...!",
      "status": "imported"
    },
    "voice_103:r_cbab0f4720e1fcf1": {
      "text": "You're wide open!",
      "status": "imported"
    },
    "voice_103:r_0bbe0b4f5364e732": {
      "text": "You won't get a warning!",
      "status": "imported"
    },
    "voice_103:r_5dda5198137cb02a": {
      "text": "You noticed too late!",
      "status": "imported"
    },
    "voice_103:r_83ec59afbecdec14": {
      "text": "I'll finish this in one blow!",
      "status": "imported"
    },
    "voice_103:r_e20bfd42ad95a3c9": {
      "text": "This is Echoes!",
      "status": "imported"
    },
    "voice_103:r_0f58a8822381e57f": {
      "text": "You underestimated a Hunter!",
      "status": "imported"
    },
    "voice_103:r_6dbcc507fb61b51d": {
      "text": "Mobile combat\\nin this thing...?!",
      "status": "imported"
    },
    "voice_103:r_b42ab697149a7c8a": {
      "text": "I'll put the Gundam's power to use!",
      "status": "imported"
    },
    "voice_103:r_4de4fcf3b440baf4": {
      "text": "Outdated, but it can still fight!",
      "status": "imported"
    },
    "voice_103:r_0121a166c715cdff": {
      "text": "It's a bit far, but...!",
      "status": "imported"
    },
    "voice_103:r_30fad37a42bd3ad3": {
      "text": "I'll take the shot!",
      "status": "imported"
    },
    "voice_103:r_80a0b2a84e05d81a": {
      "text": "I'll drop you before you can evade!",
      "status": "imported"
    },
    "voice_103:r_4a9ac1dff86506d9": {
      "text": "At this in-between range...!",
      "status": "imported"
    },
    "voice_103:r_bc8538e6af3d2577": {
      "text": "I know the risks!",
      "status": "imported"
    },
    "voice_103:r_924516c8de2b5342": {
      "text": "If I can force close combat...!",
      "status": "imported"
    },
    "voice_103:r_6b15af9a0057cdc8": {
      "text": "Go down!",
      "status": "imported"
    },
    "voice_103:r_af884a6b11dff121": {
      "text": "Let's go!",
      "status": "imported"
    },
    "voice_103:r_aabfb21c9d069ce7": {
      "text": "Not yet!",
      "status": "imported"
    },
    "voice_103:r_faae935cca0edc72": {
      "text": "Yah!",
      "status": "imported"
    },
    "voice_103:r_d4430bf362340b32": {
      "text": "I'll shoot you down!",
      "status": "imported"
    },
    "voice_103:r_b7b5625d7cd4282f": {
      "text": "Hah!",
      "status": "imported"
    },
    "voice_103:r_36133ad73a73ef98": {
      "text": "Finishing blow!",
      "status": "imported"
    },
    "voice_103:r_a8451712c57c1a72": {
      "text": "Hup!",
      "status": "imported"
    },
    "voice_103:r_3633df5b7b8f47fa": {
      "text": "You won't escape!",
      "status": "imported"
    },
    "voice_103:r_1b9b2aab5cb104da": {
      "text": "Hmph!",
      "status": "imported"
    },
    "voice_103:r_342044c706a2340f": {
      "text": "This is how Echoes fights!",
      "status": "imported"
    },
    "voice_103:r_847f82e7f3eef651": {
      "text": "It can be used like this too!",
      "status": "imported"
    },
    "voice_103:r_5213c17e13b23de0": {
      "text": "If there's an opening, I'll strike!",
      "status": "imported"
    },
    "voice_103:r_38fdff9483e9245c": {
      "text": "Striking again!",
      "status": "imported"
    },
    "voice_103:r_620fedec67706d7d": {
      "text": "So I'm facing the Red Comet...!",
      "status": "imported"
    },
    "voice_103:r_9680dcd0fddcfcc7": {
      "text": "Full Frontal...! I'll hold you here!",
      "status": "imported"
    },
    "voice_103:r_2a00f1044ad5cbaa": {
      "text": "Today we hunt you down, Sleeves!",
      "status": "imported"
    },
    "voice_103:r_3dbeead1bd3164ef": {
      "text": "Come on, Neo Zeon!",
      "status": "imported"
    },
    "voice_103:r_98d15b8cc09bc915": {
      "text": "Hunting Zeon remnants is our duty!",
      "status": "imported"
    },
    "voice_103:r_46e86d000250e137": {
      "text": "Still clinging to the One Year War!",
      "status": "imported"
    },
    "voice_103:r_ac341e7976e88f0b": {
      "text": "A girl led astray by Neo Zeon...!",
      "status": "imported"
    },
    "voice_103:r_cdbd128a5b4127cc": {
      "text": "Banagher! Stay strong!",
      "status": "imported"
    },
    "voice_103:r_cfccaa1fbeda124c": {
      "text": "Now I really feel\\nlike a Hunter!",
      "status": "imported"
    },
    "voice_103:r_b1f8ec192b9c083a": {
      "text": "Space truly is vast...!",
      "status": "imported"
    },
    "voice_103:r_a007f9ab9cf048b3": {
      "text": "I won't let you wipe out humanity!",
      "status": "imported"
    },
    "voice_103:r_ddafde4b065ced49": {
      "text": "Protecting Earth is our duty too!",
      "status": "imported"
    },
    "voice_103:r_13c25fbdfddc8a24": {
      "text": "So you're the commander...!",
      "status": "imported"
    },
    "voice_103:r_42ba1ecb310b4bd7": {
      "text": "Commencing anti-ship combat!",
      "status": "imported"
    },
    "voice_103:r_d692f1d420460a47": {
      "text": "Last mission...!\\nExecute it swiftly!",
      "status": "imported"
    },
    "voice_103:r_a5643cec86b18bd2": {
      "text": "We'll crush those behind this war!",
      "status": "imported"
    },
    "voice_103:r_68f2dfab20a4a30e": {
      "text": "Pay for what you've done.\\nThat's it!",
      "status": "imported"
    },
    "voice_103:r_95d047bcc17fccc6": {
      "text": "Then I'll counterattack!",
      "status": "imported"
    },
    "voice_103:r_640327a12a559b31": {
      "text": "I'll strike as you withdraw!",
      "status": "imported"
    },
    "voice_103:r_bdd38c584fa313d0": {
      "text": "There's no escape!",
      "status": "imported"
    },
    "voice_103:r_3fd86c1027f317c8": {
      "text": "Here's some payback!",
      "status": "imported"
    },
    "voice_103:r_d0372a183d2007ad": {
      "text": "This is how opportunities arise!",
      "status": "imported"
    },
    "voice_103:r_217aa5e1d545b44d": {
      "text": "A halfhearted attack led to this!",
      "status": "imported"
    },
    "voice_103:r_381992c5d8224937": {
      "text": "This is Daguza! Providing cover!",
      "status": "imported"
    },
    "voice_103:r_f1e7ed9e5874aba5": {
      "text": "Leave the cleanup to me!",
      "status": "imported"
    },
    "voice_103:r_fc25e66a86fc2c85": {
      "text": "Are you playing around, Banagher?!",
      "status": "imported"
    },
    "voice_103:r_5aeeb4917340c42d": {
      "text": "Nicely done, Banagher!",
      "status": "imported"
    },
    "voice_103:r_b765659981b6516d": {
      "text": "I'll take over, Captain!",
      "status": "imported"
    },
    "voice_103:r_0c427458bc00eb95": {
      "text": "Leave the rest to me, Lieutenant!",
      "status": "imported"
    },
    "voice_103:r_774a9ab4d8fd5351": {
      "text": "Your fight won't be wasted, Ensign!",
      "status": "imported"
    },
    "voice_103:r_d3f01de714c015bd": {
      "text": "I'll cover the Nahel Argama!",
      "status": "imported"
    },
    "voice_103:r_7d2617c809fead70": {
      "text": "I'll strike from behind Ra Cailum!",
      "status": "imported"
    },
    "voice_103:r_ceb935ccbf830724": {
      "text": "You're a lot of trouble...!",
      "status": "imported"
    },
    "voice_103:r_862ef7385bf2abd4": {
      "text": "I can't just leave you!",
      "status": "imported"
    },
    "voice_103:r_001cbec4d9a4283f": {
      "text": "Watch the situation, Banagher!",
      "status": "imported"
    },
    "voice_103:r_8ad40afecd02b41e": {
      "text": "Banagher, fall back for now!",
      "status": "imported"
    },
    "voice_103:r_26e5efec03c03d78": {
      "text": "Go on ahead, Captain!",
      "status": "imported"
    },
    "voice_103:r_4ad81e88c7557a8b": {
      "text": "Fall back here, Lieutenant!",
      "status": "imported"
    },
    "voice_103:r_1f65a7af190e4674": {
      "text": "That was careless, Ensign!",
      "status": "imported"
    },
    "voice_103:r_40c5a9358ed5bf29": {
      "text": "Nahel Argama, fall back!",
      "status": "imported"
    },
    "voice_103:r_f2e18dfdfe0c89ea": {
      "text": "I won't let Ra Cailum fall!",
      "status": "imported"
    },
    "voice_103:r_cf7dbf49e96a5755": {
      "text": "Damn! They blocked my counter!",
      "status": "imported"
    },
    "voice_103:r_fa96676cc65bb509": {
      "text": "I won't stand by\\nand just watch!",
      "status": "imported"
    },
    "voice_103:r_4e37f92e7d2fc62e": {
      "text": "Have I exceeded the unit's limits?!",
      "status": "imported"
    },
    "voice_103:r_66ab4cfe1557909d": {
      "text": "They escaped beyond my range...!",
      "status": "imported"
    },
    "voice_103:r_0bad405ee6ca63ba": {
      "text": "They're in the gap in my range...!",
      "status": "imported"
    },
    "voice_103:r_2072eaf71a260ae7": {
      "text": "Evasion successful...!",
      "status": "imported"
    },
    "voice_103:r_6c13bbfd27a7799e": {
      "text": "You call that aiming?!",
      "status": "imported"
    },
    "voice_103:r_06f88dcbd3c9e738": {
      "text": "Your field of view is too narrow!",
      "status": "imported"
    },
    "voice_103:r_b28faf9f71bc3598": {
      "text": "No damage! Operation continues!",
      "status": "imported"
    },
    "voice_103:r_8a29278549f8e07a": {
      "text": "Don't underestimate Echoes!",
      "status": "imported"
    },
    "voice_103:r_7e6c573c26177f98": {
      "text": "I've survived more hell than you!",
      "status": "imported"
    },
    "voice_103:r_45abf84f7757d6eb": {
      "text": "Even the Red Comet's fallen low!",
      "status": "imported"
    },
    "voice_103:r_edd7a13ab8f06a14": {
      "text": "Full Frontal!\\nPulling that stunt...!",
      "status": "imported"
    },
    "voice_103:r_8165e5b41f0124c4": {
      "text": "Give it up, Sleeves!",
      "status": "imported"
    },
    "voice_103:r_4e05581b7432cce8": {
      "text": "Too soft, Neo Zeon!",
      "status": "imported"
    },
    "voice_103:r_a60b107ea3c36a86": {
      "text": "That won't work!",
      "status": "imported"
    },
    "voice_103:r_e33693e5ba4665b0": {
      "text": "The barrier's still intact!",
      "status": "imported"
    },
    "voice_103:r_eb643f8bf737a0ca": {
      "text": "So you rely on an I-Field...!",
      "status": "imported"
    },
    "voice_103:r_0a3fccb71ec6cf2a": {
      "text": "As long as the shield holds...!",
      "status": "imported"
    },
    "voice_103:r_9b63cf1f3e0207ef": {
      "text": "The shield took it cleanly, but...!",
      "status": "imported"
    },
    "voice_103:r_63f429c5c68c0863": {
      "text": "A feint, at this point...!",
      "status": "imported"
    },
    "voice_103:r_38e4a434c91d8ef0": {
      "text": "Each hit's weak, but I can't relax!",
      "status": "imported"
    },
    "voice_103:r_98ed411352a3a6ac": {
      "text": "I avoided a direct hit...!",
      "status": "imported"
    },
    "voice_103:r_4824bea6bab3af67": {
      "text": "I got lucky with where that hit...!",
      "status": "imported"
    },
    "voice_103:r_862b92e63adb9734": {
      "text": "Does Echoes make you hesitate?!",
      "status": "imported"
    },
    "voice_103:r_cb306ef55e49d107": {
      "text": "That's nowhere near a fatal wound!",
      "status": "imported"
    },
    "voice_103:r_57b2bd2de8a1408d": {
      "text": "They're getting serious now...!",
      "status": "imported"
    },
    "voice_103:r_76f080a4881e8ab5": {
      "text": "So armor can't stop it...!",
      "status": "imported"
    },
    "voice_103:r_288133bc5b573dae": {
      "text": "My opponent's a skilled veteran...!",
      "status": "imported"
    },
    "voice_103:r_6f95653e548f8fcf": {
      "text": "As commander,\\nI can't fail again...!",
      "status": "imported"
    },
    "voice_103:r_d249d68bada91ab9": {
      "text": "I've faced death like this before!",
      "status": "imported"
    },
    "voice_103:r_e9b3307e9eb69f11": {
      "text": "Hunter's infamy stays -\\nI won't die!",
      "status": "imported"
    },
    "voice_103:r_03cdac73042343ee": {
      "text": "The Red Comet...! Such power...!",
      "status": "imported"
    },
    "voice_103:r_6026da5acbda7c69": {
      "text": "Head-on attacks\\nwon't stop Frontal!",
      "status": "imported"
    },
    "voice_103:r_981f8fedd5414fe5": {
      "text": "You'll pay for that, Sleeves!",
      "status": "imported"
    },
    "voice_103:r_96bb0dcde0c8c44a": {
      "text": "They have reasons not to retreat...!",
      "status": "imported"
    },
    "voice_103:r_641550a2f54cb456": {
      "text": "Neo Zeon...!\\nThis strong already?!",
      "status": "imported"
    },
    "voice_103:r_a0f2074af8debbfa": {
      "text": "You fools don't value peace...!",
      "status": "imported"
    },
    "voice_103:r_eb5f687fcd372ae7": {
      "text": "Damn...!\\nMy limit won't hold long!",
      "status": "imported"
    },
    "voice_103:r_2329428a6871d9fa": {
      "text": "My way: find\\na path from here...!",
      "status": "imported"
    },
    "voice_103:r_0e7466971bec4cc4": {
      "text": "Think of retreat?\\nNo - move forward!",
      "status": "imported"
    },
    "voice_103:r_efa71f7a4cc33ff3": {
      "text": "I won't fall alone.\\nPlenty of gifts!",
      "status": "imported"
    },
    "voice_103:r_3fc2e1186557e7a0": {
      "text": "Not yet! Even a cog has its pride!",
      "status": "imported"
    },
    "voice_103:r_fa6930340a545054": {
      "text": "As commander, I can't fall yet!",
      "status": "imported"
    },
    "voice_103:r_2332b9d56461d7ab": {
      "text": "Damage is exceeding the limit...!",
      "status": "imported"
    },
    "voice_103:r_854aa0a91a3c80d1": {
      "text": "Daguza Mackle, withdrawing...!",
      "status": "imported"
    },
    "voice_103:r_0bc8ae32a406ceab": {
      "text": "Damn...! Have I disgraced Echoes?!",
      "status": "imported"
    },
    "voice_103:r_f16a3eb0bcaac082": {
      "text": "Banagher! Fight!!",
      "status": "imported"
    },
    "voice_103:r_10a408809e512df1": {
      "text": "I'll open a path through!",
      "status": "imported"
    },
    "voice_103:r_bc7b9e308b879dd4": {
      "text": "Concentrate your fire!",
      "status": "imported"
    },
    "voice_103:r_98902fd3143c393e": {
      "text": "Attack after I do!",
      "status": "imported"
    },
    "voice_103:r_d907fbd7bc1c4298": {
      "text": "Break their momentum!",
      "status": "imported"
    },
    "voice_103:r_96b21e3a028dd074": {
      "text": "I understand the plan...!",
      "status": "imported"
    },
    "voice_103:r_ce140b5d8e6b7310": {
      "text": "Take them down one by one...!",
      "status": "imported"
    },
    "voice_103:r_0e0335789c5396d7": {
      "text": "First, divide the enemy!",
      "status": "imported"
    },
    "voice_103:r_a8e85bd950696403": {
      "text": "I'll leave the other one to you!",
      "status": "imported"
    }
  }
}
