{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_025:r_479b340ccc6c572b": {
      "text": "This attack will finish you!",
      "status": "imported"
    },
    "voice_025:r_77949221bf58f862": {
      "text": "You're mine!",
      "status": "imported"
    },
    "voice_025:r_70b9c4b9f1f37eff": {
      "text": "Fall...! Fall!",
      "status": "imported"
    },
    "voice_025:r_9fcb3754cb1773c7": {
      "text": "Trying to run is pointless!",
      "status": "imported"
    },
    "voice_025:r_3559d2fad32c2435": {
      "text": "We've got no choice!",
      "status": "imported"
    },
    "voice_025:r_f7570547e9f80a64": {
      "text": "We are the chosen warriors!",
      "status": "imported"
    },
    "voice_025:r_cbab0f4720e1fcf1": {
      "text": "Behold the pride of Altair!",
      "status": "imported"
    },
    "voice_025:r_0bbe0b4f5364e732": {
      "text": "Everything is for Altair!",
      "status": "imported"
    },
    "voice_025:r_5dda5198137cb02a": {
      "text": "We must capture the $$レア・イグラー$$!",
      "status": "translated"
    },
    "voice_025:r_83ec59afbecdec14": {
      "text": "Complete the mission swiftly!",
      "status": "imported"
    },
    "voice_025:r_e20bfd42ad95a3c9": {
      "text": "We have our reasons to fight!",
      "status": "imported"
    },
    "voice_025:r_0f58a8822381e57f": {
      "text": "For Altair's future!\\nNo hesitation!",
      "status": "imported"
    },
    "voice_025:r_6dbcc507fb61b51d": {
      "text": "Our resolve is unshakable!",
      "status": "imported"
    },
    "voice_025:r_b42ab697149a7c8a": {
      "text": "No one can stop us!",
      "status": "imported"
    },
    "voice_025:r_4de4fcf3b440baf4": {
      "text": "Not until we find the True Eve...!",
      "status": "imported"
    },
    "voice_025:r_0121a166c715cdff": {
      "text": "An intruder from Vega?!",
      "status": "imported"
    },
    "voice_025:r_30fad37a42bd3ad3": {
      "text": "Curse you, Vega scum!",
      "status": "imported"
    },
    "voice_025:r_80a0b2a84e05d81a": {
      "text": "To think they've invaded Altair...!",
      "status": "imported"
    },
    "voice_025:r_4a9ac1dff86506d9": {
      "text": "Curse you, Machine Angel...!",
      "status": "imported"
    },
    "voice_025:r_bc8538e6af3d2577": {
      "text": "You bar our way, Machine Angel!",
      "status": "imported"
    },
    "voice_025:r_924516c8de2b5342": {
      "text": "I'll end the legend myself!",
      "status": "imported"
    },
    "voice_025:r_da1174533722333f": {
      "text": "The fabled Wings of the Sun...?!",
      "status": "imported"
    },
    "voice_025:r_fdeb8162976e72c1": {
      "text": "Another form of the Machine Angel?!",
      "status": "imported"
    },
    "voice_025:r_6b15af9a0057cdc8": {
      "text": "A long-range Machine Angel?!",
      "status": "imported"
    },
    "voice_025:r_15b4a90140e8a33a": {
      "text": "A form built for close combat!",
      "status": "imported"
    },
    "voice_025:r_af884a6b11dff121": {
      "text": "$$レア・イグラー$$ detected!",
      "status": "translated"
    },
    "voice_025:r_ac6fe7838e95647b": {
      "text": "Now to capture the $$レア・イグラー$$!",
      "status": "translated"
    },
    "voice_025:r_77ca87eacd17ad52": {
      "text": "They may well be the True Eve...!",
      "status": "imported"
    },
    "voice_025:r_bf3244994760e535": {
      "text": "That signal...!\\nA $$レア・イグラー$$?!",
      "status": "translated"
    },
    "voice_025:r_02479dc8fe989560": {
      "text": "We have no use for men!",
      "status": "imported"
    },
    "voice_025:r_a2df00f91a9b0a9e": {
      "text": "Guard the $$レア・イグラー$$? Then fall!",
      "status": "translated"
    },
    "voice_025:r_48b60d6c48b9b142": {
      "text": "Vega's vaunted\\nSuper Robot?!",
      "status": "imported"
    },
    "voice_025:r_8927e6fb681aa809": {
      "text": "Power and armor?\\nHow about speed?!",
      "status": "imported"
    },
    "voice_025:r_665f01666859013b": {
      "text": "Vega's giants\\ncan't match my Gunis!",
      "status": "imported"
    },
    "voice_025:r_a571eec59b258d11": {
      "text": "A tiny machine,\\ncoming at me...?!",
      "status": "imported"
    },
    "voice_025:r_ddbe581c5ea9183d": {
      "text": "Small, but clearly no pushover...!",
      "status": "imported"
    },
    "voice_025:r_faae935cca0edc72": {
      "text": "Gundam's name has\\nreached Altair!",
      "status": "imported"
    },
    "voice_025:r_d4430bf362340b32": {
      "text": "Show me your power, Gundam!",
      "status": "imported"
    },
    "voice_025:r_6ff1323b355593e0": {
      "text": "That wildness... Just like Kagura!",
      "status": "imported"
    },
    "voice_025:r_b7b5625d7cd4282f": {
      "text": "A beast...?!",
      "status": "imported"
    },
    "voice_025:r_36133ad73a73ef98": {
      "text": "What is that...?! A war god?!",
      "status": "imported"
    },
    "voice_025:r_920740a0219c5085": {
      "text": "That song is stirring my soul...?!",
      "status": "imported"
    },
    "voice_025:r_a8451712c57c1a72": {
      "text": "What is that?!\\nBeyond comprehension!",
      "status": "imported"
    },
    "voice_025:r_3633df5b7b8f47fa": {
      "text": "I can read your moves, fast or not!",
      "status": "imported"
    },
    "voice_025:r_52dfc56b14b93551": {
      "text": "What is that?! It's impossibly huge!",
      "status": "imported"
    },
    "voice_025:r_1b9b2aab5cb104da": {
      "text": "A Vega ace! I challenge you!",
      "status": "imported"
    },
    "voice_025:r_342044c706a2340f": {
      "text": "Target the commander first!",
      "status": "imported"
    },
    "voice_025:r_cf41e8828a90cbdb": {
      "text": "I'll down them and turn the tide!",
      "status": "imported"
    },
    "voice_025:r_719e897304ec42d4": {
      "text": "I'm going after the enemy ship!",
      "status": "imported"
    },
    "voice_025:r_d5e0a2317c40d322": {
      "text": "I'll sink the battleship myself!",
      "status": "imported"
    },
    "voice_025:r_ec2ea17765052401": {
      "text": "Target confirmed! Execute mission!",
      "status": "imported"
    },
    "voice_025:r_5d08ad19e2da125b": {
      "text": "Destroy it and capture the pilot!",
      "status": "imported"
    },
    "voice_025:r_dc8701f6bcb9904f": {
      "text": "I'll take you back to Altair!",
      "status": "imported"
    },
    "voice_025:r_ca85f87cee5e31f7": {
      "text": "Now we counterattack!",
      "status": "imported"
    },
    "voice_025:r_9072ea7bc71df136": {
      "text": "Thanks for revealing your position!",
      "status": "imported"
    },
    "voice_025:r_04e815a8d425827d": {
      "text": "You won't get away!",
      "status": "imported"
    },
    "voice_025:r_d89011fe3e5d082a": {
      "text": "Don't think you'll make it home!",
      "status": "imported"
    },
    "voice_025:r_3c5b0c2ac812d5de": {
      "text": "If you're still within range...!",
      "status": "imported"
    },
    "voice_025:r_5b9e8897190892eb": {
      "text": "Now it's our turn!",
      "status": "imported"
    },
    "voice_025:r_7bea3023abbf8a94": {
      "text": "You failed to finish me! Your loss!",
      "status": "imported"
    },
    "voice_025:r_dd01a4c0d1b36a8d": {
      "text": "I won't let you disengage!",
      "status": "imported"
    },
    "voice_025:r_20920ad2eb3542db": {
      "text": "This counterattack will finish you!",
      "status": "imported"
    },
    "voice_025:r_0ab7914877fd48ed": {
      "text": "Take this for payback!",
      "status": "imported"
    },
    "voice_025:r_cb846feec748c2e3": {
      "text": "My attack isn't over yet!",
      "status": "imported"
    },
    "voice_025:r_c958860b0676b1f5": {
      "text": "I'm coming in right behind you!",
      "status": "imported"
    },
    "voice_025:r_5e2669b82ef75ce3": {
      "text": "For Izumo and Altair...!",
      "status": "imported"
    },
    "voice_025:r_7847e0ed7dc9282d": {
      "text": "Kagura, I'll cover you!",
      "status": "imported"
    },
    "voice_025:r_e42b52c7a987b906": {
      "text": "I must support Jin...!",
      "status": "imported"
    },
    "voice_025:r_6825fd1ff907bd22": {
      "text": "How foolish to leave yourself open!",
      "status": "imported"
    },
    "voice_025:r_607f666f1563bc0d": {
      "text": "This time, I'll finish you!",
      "status": "imported"
    },
    "voice_025:r_97b7431eeb81e6b6": {
      "text": "A-Aaaaaagh!",
      "status": "imported"
    },
    "voice_025:r_132f605d02975e71": {
      "text": "Glory to Altair!",
      "status": "imported"
    },
    "voice_025:r_9b9726b1872759d6": {
      "text": "N-No! It's going to explode!!",
      "status": "imported"
    },
    "voice_025:r_1252db29683fefe0": {
      "text": "Forgive me, Izumo!",
      "status": "imported"
    },
    "voice_025:r_ad3d538f1e909184": {
      "text": "Mission failed! Repeat, mission...!",
      "status": "imported"
    },
    "voice_025:r_8c61c59a1c0aebbf": {
      "text": "Eject! Abandon the machine!",
      "status": "imported"
    },
    "voice_025:r_aba6a7662129d8ce": {
      "text": "Damn!\\nThe $$レア・イグラー$$ got away...!",
      "status": "translated"
    },
    "voice_025:r_b84afafb8a33ec60": {
      "text": "Comrades, find the True Eve!\\nAagh!",
      "status": "imported"
    },
    "voice_025:r_c8c59db85bf875e6": {
      "text": "The Machine Angel's true power...!",
      "status": "imported"
    },
    "voice_025:r_391aa56435d9dd6e": {
      "text": "It lives up to the legend...!",
      "status": "imported"
    },
    "voice_025:r_7c796ba53bd7ea03": {
      "text": "A devil sent to destroy Altair...?!",
      "status": "imported"
    },
    "voice_025:r_fa944da4b6519006": {
      "text": "The Wings of the Sun after all...?!",
      "status": "imported"
    },
    "voice_025:r_95d047bcc17fccc6": {
      "text": "This power...! A $$レア・イグラー$$ indeed!",
      "status": "translated"
    },
    "voice_025:r_bdd38c584fa313d0": {
      "text": "Worthy of becoming the True Eve...!",
      "status": "imported"
    },
    "voice_025:r_d0372a183d2007ad": {
      "text": "Such power!\\nBring them to Altair!",
      "status": "imported"
    },
    "voice_025:r_381992c5d8224937": {
      "text": "This power may\\nbreak Eve's curse...!",
      "status": "imported"
    },
    "voice_025:r_fc25e66a86fc2c85": {
      "text": "Vega's mechanical giant!\\nWhat power!",
      "status": "imported"
    },
    "voice_025:r_5aeeb4917340c42d": {
      "text": "So that's why it's a\\nSuper Robot!",
      "status": "imported"
    },
    "voice_025:r_b765659981b6516d": {
      "text": "Gundam...! Stronger than the rumors!",
      "status": "imported"
    },
    "voice_025:r_0c427458bc00eb95": {
      "text": "Small, not to be taken lightly...!",
      "status": "imported"
    },
    "voice_025:r_774a9ab4d8fd5351": {
      "text": "No! They're too fast to track!",
      "status": "imported"
    },
    "voice_025:r_d3f01de714c015bd": {
      "text": "Gwaaaagh!",
      "status": "imported"
    },
    "voice_025:r_7d2617c809fead70": {
      "text": "Strong...! They're far too strong!",
      "status": "imported"
    },
    "voice_025:r_ceb935ccbf830724": {
      "text": "W-What?! What's happening?!",
      "status": "imported"
    },
    "voice_025:r_862ef7385bf2abd4": {
      "text": "My machine can't take much more...!",
      "status": "imported"
    },
    "voice_025:r_001cbec4d9a4283f": {
      "text": "I need backup! They're too strong!",
      "status": "imported"
    },
    "voice_025:r_8ad40afecd02b41e": {
      "text": "Damage up!\\nLimit breach in minutes!",
      "status": "imported"
    },
    "voice_025:r_26e5efec03c03d78": {
      "text": "No!\\nThey'll tear my machine apart!",
      "status": "imported"
    },
    "voice_025:r_4ad81e88c7557a8b": {
      "text": "System failures!\\nAt this rate...!",
      "status": "imported"
    },
    "voice_025:r_1f65a7af190e4674": {
      "text": "Even if they destroy my machine...!",
      "status": "imported"
    },
    "voice_025:r_40c5a9358ed5bf29": {
      "text": "Our mission permits no retreat!",
      "status": "imported"
    },
    "voice_025:r_f2e18dfdfe0c89ea": {
      "text": "Not yet! The True Eve must be ours!",
      "status": "imported"
    },
    "voice_025:r_cf7dbf49e96a5755": {
      "text": "Can't lose!\\nFor Altair's future...!",
      "status": "imported"
    },
    "voice_025:r_eb643f8bf737a0ca": {
      "text": "What...?!",
      "status": "imported"
    },
    "voice_025:r_0a3fccb71ec6cf2a": {
      "text": "Whoa! A direct hit?!",
      "status": "imported"
    },
    "voice_025:r_9b63cf1f3e0207ef": {
      "text": "I can't evade it...!",
      "status": "imported"
    },
    "voice_025:r_8356f4e3dcdff938": {
      "text": "That wasn't just luck...?!",
      "status": "imported"
    },
    "voice_025:r_1d6d784036ae0bd7": {
      "text": "Not bad, warrior of Vega...!",
      "status": "imported"
    },
    "voice_025:r_625664af02183c17": {
      "text": "They got my thrusters...!",
      "status": "imported"
    },
    "voice_025:r_3701cba361f80ea5": {
      "text": "Damn! Some of my sensors are dead!",
      "status": "imported"
    },
    "voice_025:r_63f429c5c68c0863": {
      "text": "That power exceeds our data...!",
      "status": "imported"
    },
    "voice_025:r_38e4a434c91d8ef0": {
      "text": "Vega's forces are no pushovers...!",
      "status": "imported"
    },
    "voice_025:r_98ed411352a3a6ac": {
      "text": "They've completely read my moves...!",
      "status": "imported"
    },
    "voice_025:r_4824bea6bab3af67": {
      "text": "No! I'm playing into their hands!",
      "status": "imported"
    },
    "voice_025:r_862b92e63adb9734": {
      "text": "Over this?\\nI won't flee in shame...!",
      "status": "imported"
    },
    "voice_025:r_cb306ef55e49d107": {
      "text": "So little from a Machine Angel?!",
      "status": "imported"
    },
    "voice_025:r_57b2bd2de8a1408d": {
      "text": "You shame the Machine Angel name!",
      "status": "imported"
    },
    "voice_025:r_76f080a4881e8ab5": {
      "text": "Ghh! You...!",
      "status": "imported"
    },
    "voice_025:r_288133bc5b573dae": {
      "text": "A plate or two means nothing!",
      "status": "imported"
    },
    "voice_025:r_6f95653e548f8fcf": {
      "text": "So that's all you've got...!",
      "status": "imported"
    },
    "voice_025:r_d249d68bada91ab9": {
      "text": "You're all show, aren't you?!",
      "status": "imported"
    },
    "voice_025:r_e9b3307e9eb69f11": {
      "text": "It won't hinder me in battle...!",
      "status": "imported"
    },
    "voice_025:r_03cdac73042343ee": {
      "text": "That won't make me flinch!",
      "status": "imported"
    },
    "voice_025:r_6026da5acbda7c69": {
      "text": "A Vega attack won't hurt me!",
      "status": "imported"
    },
    "voice_025:r_981f8fedd5414fe5": {
      "text": "You're no match for my Gunis!",
      "status": "imported"
    },
    "voice_025:r_96bb0dcde0c8c44a": {
      "text": "Too slow!",
      "status": "imported"
    },
    "voice_025:r_641550a2f54cb456": {
      "text": "You haven't thought this through!",
      "status": "imported"
    },
    "voice_025:r_a0f2074af8debbfa": {
      "text": "I won't let you!",
      "status": "imported"
    },
    "voice_025:r_b5f5a97ed82acb0b": {
      "text": "I can't afford to take a hit!",
      "status": "imported"
    },
    "voice_025:r_d9cd2e4ded064396": {
      "text": "Hmph, just as I expected...!",
      "status": "imported"
    },
    "voice_025:r_99e6349431aaf23b": {
      "text": "Your every move is obvious!",
      "status": "imported"
    },
    "voice_025:r_ec1081caf845f56a": {
      "text": "Your aim seems rather poor!",
      "status": "imported"
    },
    "voice_025:r_2c5b7ee872c1ed7f": {
      "text": "This is the speed of the Gunis!",
      "status": "imported"
    },
    "voice_025:r_2329428a6871d9fa": {
      "text": "That won't work on me!",
      "status": "imported"
    },
    "voice_025:r_0e7466971bec4cc4": {
      "text": "What a pointless effort!",
      "status": "imported"
    },
    "voice_025:r_fa6930340a545054": {
      "text": "I have a barrier!",
      "status": "imported"
    },
    "voice_025:r_2332b9d56461d7ab": {
      "text": "Defense system, activate!",
      "status": "imported"
    },
    "voice_025:r_854aa0a91a3c80d1": {
      "text": "Unable to attack?! What's going on?!",
      "status": "imported"
    },
    "voice_025:r_0bc8ae32a406ceab": {
      "text": "I can't do anything...!",
      "status": "imported"
    },
    "voice_025:r_82c09f011d703b2c": {
      "text": "All weapons are disabled...?!",
      "status": "imported"
    },
    "voice_025:r_2b4d8818c77b6dca": {
      "text": "I lost the enemy! What a disgrace!",
      "status": "imported"
    },
    "voice_025:r_087354f2db0a31e6": {
      "text": "Can't attack from this position...!",
      "status": "imported"
    },
    "voice_025:r_db02a2dec93dd263": {
      "text": "Is the machine too badly worn...?",
      "status": "imported"
    },
    "voice_025:r_d520c6d5298a848d": {
      "text": "I can't ignore a comrade in danger!",
      "status": "imported"
    },
    "voice_025:r_099e2458cabf796f": {
      "text": "I'll be the shield!",
      "status": "imported"
    },
    "voice_025:r_fd910d714be70870": {
      "text": "We cannot afford to lose Izumo!",
      "status": "imported"
    },
    "voice_025:r_9736f29b11344ec3": {
      "text": "Kagura, please don't be reckless!",
      "status": "imported"
    },
    "voice_025:r_fcd05582aa5c6068": {
      "text": "I won't let them get Jin!",
      "status": "imported"
    },
    "voice_025:r_bece29562818acba": {
      "text": "Target acquired!",
      "status": "imported"
    },
    "voice_025:r_494b5da92ed24ecb": {
      "text": "Good range!",
      "status": "imported"
    },
    "voice_025:r_a4a5a96f4bd58920": {
      "text": "I'll score a direct hit!",
      "status": "imported"
    },
    "voice_025:r_b57d2d74233f889a": {
      "text": "I'll shoot straight through you!",
      "status": "imported"
    },
    "voice_025:r_cd06d0820d82524b": {
      "text": "Missile, fire!",
      "status": "imported"
    },
    "voice_025:r_c94c6d04be583774": {
      "text": "Missile, full salvo!",
      "status": "imported"
    },
    "voice_025:r_e54e2c99ef8297af": {
      "text": "I'll make every shot hit!",
      "status": "imported"
    },
    "voice_025:r_f16a3eb0bcaac082": {
      "text": "If this lands a direct hit...!",
      "status": "imported"
    },
    "voice_025:r_10a408809e512df1": {
      "text": "I'll finish you with Volley Fire!",
      "status": "imported"
    },
    "voice_025:r_bc7b9e308b879dd4": {
      "text": "I'll throw all my strength at you!",
      "status": "imported"
    },
    "voice_025:r_98902fd3143c393e": {
      "text": "Now face our full power!",
      "status": "imported"
    },
    "voice_025:r_d907fbd7bc1c4298": {
      "text": "This is the power of Altair!",
      "status": "imported"
    },
    "voice_025:r_96b21e3a028dd074": {
      "text": "Danger!\\nPlease fall back, Izumo!",
      "status": "imported"
    },
    "voice_025:r_ce140b5d8e6b7310": {
      "text": "We'll take the lead!",
      "status": "imported"
    },
    "voice_025:r_0e0335789c5396d7": {
      "text": "Concentrate your fire!",
      "status": "imported"
    },
    "voice_025:r_a8e85bd950696403": {
      "text": "I'll draw the enemy's attention!",
      "status": "imported"
    },
    "voice_025:r_772c8bc40ab6cb61": {
      "text": "You handle the finishing blow!",
      "status": "imported"
    },
    "voice_025:r_58dd2826a199ef51": {
      "text": "I must at least slow them down...!",
      "status": "imported"
    },
    "voice_025:r_aadc0b2442adb93b": {
      "text": "So that's my target!",
      "status": "imported"
    },
    "voice_025:r_e7a8cd8ed5bc2d1b": {
      "text": "If it's one-on-one...!",
      "status": "imported"
    },
    "voice_025:r_041dd920da4a7c17": {
      "text": "I'll separate them from their squad!",
      "status": "imported"
    },
    "voice_025:r_c7f4280cde4605b3": {
      "text": "So it's one kill apiece...!",
      "status": "imported"
    }
  }
}
