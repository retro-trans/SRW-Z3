{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_089:r_479b340ccc6c572b": {
      "text": "Rotten curs... Die!",
      "status": "imported"
    },
    "voice_089:r_ca4acbac57a2a35e": {
      "text": "You too shall share my form!",
      "status": "imported"
    },
    "voice_089:r_77949221bf58f862": {
      "text": "You too...\\nWe're both pitiful souls!",
      "status": "imported"
    },
    "voice_089:r_70b9c4b9f1f37eff": {
      "text": "I'll cast you into the abyss!",
      "status": "imported"
    },
    "voice_089:r_9fcb3754cb1773c7": {
      "text": "It won't hurt... Only agonize!",
      "status": "imported"
    },
    "voice_089:r_3559d2fad32c2435": {
      "text": "What is truth? I'll show you now!",
      "status": "imported"
    },
    "voice_089:r_f7570547e9f80a64": {
      "text": "You witless fool... Begone!",
      "status": "imported"
    },
    "voice_089:r_cbab0f4720e1fcf1": {
      "text": "This is the end for you...!",
      "status": "imported"
    },
    "voice_089:r_0bbe0b4f5364e732": {
      "text": "Be blown away without a trace!!",
      "status": "imported"
    },
    "voice_089:r_5dda5198137cb02a": {
      "text": "I'll blow it all away!",
      "status": "imported"
    },
    "voice_089:r_83ec59afbecdec14": {
      "text": "The power of God's creation!!",
      "status": "imported"
    },
    "voice_089:r_e20bfd42ad95a3c9": {
      "text": "Now it's my turn!",
      "status": "imported"
    },
    "voice_089:r_0f58a8822381e57f": {
      "text": "Giving me that intel was a mistake!",
      "status": "imported"
    },
    "voice_089:r_6dbcc507fb61b51d": {
      "text": "Regret ever challenging me!",
      "status": "imported"
    },
    "voice_089:r_b42ab697149a7c8a": {
      "text": "Don't think you can escape!",
      "status": "imported"
    },
    "voice_089:r_4de4fcf3b440baf4": {
      "text": "So you've entered my territory!",
      "status": "imported"
    },
    "voice_089:r_0121a166c715cdff": {
      "text": "You cannot escape my grasp now...",
      "status": "imported"
    },
    "voice_089:r_30fad37a42bd3ad3": {
      "text": "The terror has only just begun!",
      "status": "imported"
    },
    "voice_089:r_80a0b2a84e05d81a": {
      "text": "The true shock is yet to come!",
      "status": "imported"
    },
    "voice_089:r_4a9ac1dff86506d9": {
      "text": "No choice. I'll be your shield.",
      "status": "imported"
    },
    "voice_089:r_bc8538e6af3d2577": {
      "text": "Escape route's ready. Fall back.",
      "status": "imported"
    },
    "voice_089:r_924516c8de2b5342": {
      "text": "Fuhahahaha! So you're my opponent!",
      "status": "imported"
    },
    "voice_089:r_da1174533722333f": {
      "text": "Allow me to face you first!",
      "status": "imported"
    },
    "voice_089:r_fdeb8162976e72c1": {
      "text": "I see it... I see it!",
      "status": "imported"
    },
    "voice_089:r_0fadb5c26df92b42": {
      "text": "A rotten cur's attack. Figures.",
      "status": "imported"
    },
    "voice_089:r_6b15af9a0057cdc8": {
      "text": "Where do you think you're aiming?",
      "status": "imported"
    },
    "voice_089:r_15b4a90140e8a33a": {
      "text": "Are you even trying to hit me?",
      "status": "imported"
    },
    "voice_089:r_af884a6b11dff121": {
      "text": "Fuhahahahaha!\\nThat won't work on me!",
      "status": "imported"
    },
    "voice_089:r_ac6fe7838e95647b": {
      "text": "There is such a thing as a barrier!",
      "status": "imported"
    },
    "voice_089:r_bf3244994760e535": {
      "text": "You forced me to use my shield!",
      "status": "imported"
    },
    "voice_089:r_aabfb21c9d069ce7": {
      "text": "Such a weak attack won't fell me!",
      "status": "imported"
    },
    "voice_089:r_02479dc8fe989560": {
      "text": "Your best?\\nThen hurry up and die!",
      "status": "imported"
    },
    "voice_089:r_a2df00f91a9b0a9e": {
      "text": "No holding back.\\nGive it your all!",
      "status": "imported"
    },
    "voice_089:r_48b60d6c48b9b142": {
      "text": "Heh heh heh, all appears in order.",
      "status": "imported"
    },
    "voice_089:r_8927e6fb681aa809": {
      "text": "What's wrong? Is that your best?",
      "status": "imported"
    },
    "voice_089:r_665f01666859013b": {
      "text": "Fuhahahahaha!\\nSo that's your power!",
      "status": "imported"
    },
    "voice_089:r_a571eec59b258d11": {
      "text": "Closest to truth...\\nYou reject me?!",
      "status": "imported"
    },
    "voice_089:r_ddbe581c5ea9183d": {
      "text": "Even now, you make a sorry display!",
      "status": "imported"
    },
    "voice_089:r_faae935cca0edc72": {
      "text": "Yes!\\nNow this battle has meaning!",
      "status": "imported"
    },
    "voice_089:r_d4430bf362340b32": {
      "text": "Hmph. Impressive for a pet dog.",
      "status": "imported"
    },
    "voice_089:r_6ff1323b355593e0": {
      "text": "Not all bark.\\nYou bite as well.",
      "status": "imported"
    },
    "voice_089:r_b7b5625d7cd4282f": {
      "text": "How dare you, you rotten cur!",
      "status": "imported"
    },
    "voice_089:r_36133ad73a73ef98": {
      "text": "Why?!\\nWhy am I pushed this far?!",
      "status": "imported"
    },
    "voice_089:r_920740a0219c5085": {
      "text": "I reject this... I reject this!!",
      "status": "imported"
    },
    "voice_089:r_a8451712c57c1a72": {
      "text": "Won't die...\\nTill I know the truth!",
      "status": "imported"
    },
    "voice_089:r_3633df5b7b8f47fa": {
      "text": "Impossible!\\nNot in my script...!",
      "status": "imported"
    },
    "voice_089:r_52dfc56b14b93551": {
      "text": "Fuhahahahahahahahahaha!!",
      "status": "imported"
    },
    "voice_089:r_1b9b2aab5cb104da": {
      "text": "The nightmare is far from over!",
      "status": "imported"
    },
    "voice_089:r_342044c706a2340f": {
      "text": "Hyaaaaaaah!!",
      "status": "imported"
    },
    "voice_089:r_cf41e8828a90cbdb": {
      "text": "I found it! The power of God!!",
      "status": "imported"
    },
    "voice_089:r_719e897304ec42d4": {
      "text": "Fuhahahaha!\\nI can wield power too!",
      "status": "imported"
    },
    "voice_089:r_d5e0a2317c40d322": {
      "text": "My power...\\nFeel Big Duo's might!",
      "status": "imported"
    },
    "voice_089:r_ec2ea17765052401": {
      "text": "See world-changing power!\\nBig Duo!!",
      "status": "imported"
    },
    "voice_089:r_d6bdd730f24f66eb": {
      "text": "Others pilot Bigs too,\\nRoger Smith!",
      "status": "imported"
    },
    "voice_089:r_41997412868c48c4": {
      "text": "Big Duo surpasses your Big!\\nTruth!",
      "status": "imported"
    },
    "voice_089:r_9e6cf4f389dae55c": {
      "text": "I see it, Roger Smith!\\nYour shock!",
      "status": "imported"
    },
    "voice_089:r_7d724dbcc4451e10": {
      "text": "Challenged Big Duo?\\nYou've got guts!",
      "status": "imported"
    },
    "voice_089:r_93e25418a203cb8f": {
      "text": "What a fearless fool you are!",
      "status": "imported"
    },
    "voice_089:r_adeb0a29274d3d9b": {
      "text": "Seeking truth yourself... Fine. But!",
      "status": "imported"
    },
    "voice_089:r_24cf161287ef9d5c": {
      "text": "As thanks, taste\\ntrue terror!",
      "status": "imported"
    },
    "voice_089:r_8f60f6fc86db3107": {
      "text": "Enjoy what little respite you have!",
      "status": "imported"
    },
    "voice_089:r_b1de76a75a253c13": {
      "text": "Hmm...\\nYou grasp the situation.",
      "status": "imported"
    },
    "voice_089:r_128c35bf3e0e394c": {
      "text": "Life is that dear?!\\nMore than truth!",
      "status": "imported"
    },
    "voice_089:r_5213c17e13b23de0": {
      "text": "Fool... Think it'll\\nhit Big Duo?",
      "status": "imported"
    },
    "voice_089:r_38fdff9483e9245c": {
      "text": "Big Duo isn't\\njust another Megadeus.",
      "status": "imported"
    },
    "voice_089:r_620fedec67706d7d": {
      "text": "An attack fit for a pet dog.",
      "status": "imported"
    },
    "voice_089:r_9680dcd0fddcfcc7": {
      "text": "Roger Smith.\\nI see your every move.",
      "status": "imported"
    },
    "voice_089:r_3dbeead1bd3164ef": {
      "text": "That won't\\nwork on Big Duo!",
      "status": "imported"
    },
    "voice_089:r_98d15b8cc09bc915": {
      "text": "Mine far outclasses your machines!",
      "status": "imported"
    },
    "voice_089:r_46e86d000250e137": {
      "text": "Well, Roger Smith?\\nShow true power!",
      "status": "imported"
    },
    "voice_089:r_ac341e7976e88f0b": {
      "text": "See? Your Big\\ncan't beat Big Duo!",
      "status": "imported"
    },
    "voice_089:r_cdbd128a5b4127cc": {
      "text": "Not bad for Paradigm's dog...\\nBut!",
      "status": "imported"
    },
    "voice_089:r_cfccaa1fbeda124c": {
      "text": "Gah! Roger Smith...!\\nA nuisance!",
      "status": "imported"
    },
    "voice_089:r_b1f8ec192b9c083a": {
      "text": "Move, Big Duo!\\nMove! Crush them!!",
      "status": "imported"
    },
    "voice_089:r_a007f9ab9cf048b3": {
      "text": "Ngh!\\nSuch damage to Big Duo!",
      "status": "imported"
    },
    "voice_089:r_ddafde4b065ced49": {
      "text": "You... What in the world are you?!",
      "status": "imported"
    },
    "voice_089:r_de1213040856c089": {
      "text": "I-Is this\\nblack Big's power?!",
      "status": "imported"
    },
    "voice_089:r_3304412ac41f47a6": {
      "text": "B-Big Duo has been defeated...?!",
      "status": "imported"
    },
    "voice_089:r_13c25fbdfddc8a24": {
      "text": "If this can defeat them, I'll help!",
      "status": "imported"
    },
    "voice_089:r_42ba1ecb310b4bd7": {
      "text": "Cooperation...\\nA word I despise.",
      "status": "imported"
    }
  }
}
