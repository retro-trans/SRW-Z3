{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_045:r_479b340ccc6c572b": {
      "text": "All right, now's our chance!",
      "status": "imported"
    },
    "voice_045:r_ca4acbac57a2a35e": {
      "text": "All batteries, aim carefully!",
      "status": "imported"
    },
    "voice_045:r_77949221bf58f862": {
      "text": "Concentrate your fire!",
      "status": "imported"
    },
    "voice_045:r_70b9c4b9f1f37eff": {
      "text": "We'll blast a path through!",
      "status": "imported"
    },
    "voice_045:r_9fcb3754cb1773c7": {
      "text": "Everyone, give it all you've got!",
      "status": "imported"
    },
    "voice_045:r_3559d2fad32c2435": {
      "text": "Don't waste shots! Finish them off!",
      "status": "imported"
    },
    "voice_045:r_f7570547e9f80a64": {
      "text": "Put up a barrage! Make it thick!",
      "status": "imported"
    },
    "voice_045:r_cbab0f4720e1fcf1": {
      "text": "Clear allies from our line of fire!",
      "status": "imported"
    },
    "voice_045:r_0bbe0b4f5364e732": {
      "text": "All hands, prepare to attack!",
      "status": "imported"
    },
    "voice_045:r_5dda5198137cb02a": {
      "text": "I'm counting on you! This is it!",
      "status": "imported"
    },
    "voice_045:r_83ec59afbecdec14": {
      "text": "Enemy closing at high speed!",
      "status": "imported"
    },
    "voice_045:r_e20bfd42ad95a3c9": {
      "text": "Stay calm! Deal with it first!",
      "status": "imported"
    },
    "voice_045:r_0f58a8822381e57f": {
      "text": "Don't let them escape! Attack again!",
      "status": "imported"
    },
    "voice_045:r_6dbcc507fb61b51d": {
      "text": "This ship will open fire again!",
      "status": "imported"
    },
    "voice_045:r_b42ab697149a7c8a": {
      "text": "We'll hold Char off!",
      "status": "imported"
    },
    "voice_045:r_4de4fcf3b440baf4": {
      "text": "Newtype, Cyber-Newtype - no matter!",
      "status": "imported"
    },
    "voice_045:r_30fad37a42bd3ad3": {
      "text": "Drop Haman,\\nand turn the tide!",
      "status": "imported"
    },
    "voice_045:r_80a0b2a84e05d81a": {
      "text": "Don't let Neo Zeon invade!",
      "status": "imported"
    },
    "voice_045:r_4a9ac1dff86506d9": {
      "text": "Don't let Neo Zeon have their way!",
      "status": "imported"
    },
    "voice_045:r_bc8538e6af3d2577": {
      "text": "It's our duty to take them down!",
      "status": "imported"
    },
    "voice_045:r_924516c8de2b5342": {
      "text": "One Year War is over.\\nMake them see!",
      "status": "imported"
    },
    "voice_045:r_da1174533722333f": {
      "text": "We'll crush the Sleeves here!",
      "status": "imported"
    },
    "voice_045:r_fdeb8162976e72c1": {
      "text": "Target the Rewloola first!",
      "status": "imported"
    },
    "voice_045:r_0fadb5c26df92b42": {
      "text": "The enemy ship is our target!",
      "status": "imported"
    },
    "voice_045:r_6b15af9a0057cdc8": {
      "text": "Crush the enemy chain of command!",
      "status": "imported"
    },
    "voice_045:r_15b4a90140e8a33a": {
      "text": "Don't let that mobile armor through!",
      "status": "imported"
    },
    "voice_045:r_af884a6b11dff121": {
      "text": "Small craft closing\\nmeans trouble!",
      "status": "imported"
    },
    "voice_045:r_ac6fe7838e95647b": {
      "text": "Don't flinch, even against aliens!",
      "status": "imported"
    },
    "voice_045:r_77ca87eacd17ad52": {
      "text": "Show those monsters no mercy!",
      "status": "imported"
    },
    "voice_045:r_bf3244994760e535": {
      "text": "If they pass us, Earth's finished!",
      "status": "imported"
    },
    "voice_045:r_aabfb21c9d069ce7": {
      "text": "Protecting humanity is our duty too!",
      "status": "imported"
    },
    "voice_045:r_a2df00f91a9b0a9e": {
      "text": "We must protect Earth's future!",
      "status": "imported"
    },
    "voice_045:r_8927e6fb681aa809": {
      "text": "Why must we fight this battle?",
      "status": "imported"
    },
    "voice_045:r_665f01666859013b": {
      "text": "All batteries,\\navoid their cockpits!",
      "status": "imported"
    },
    "voice_045:r_a571eec59b258d11": {
      "text": "All hands, rally! Our final battle!",
      "status": "imported"
    },
    "voice_045:r_ddbe581c5ea9183d": {
      "text": "Our target is the Garencieres!",
      "status": "imported"
    },
    "voice_045:r_faae935cca0edc72": {
      "text": "Turn the Red Comet into stardust!",
      "status": "imported"
    },
    "voice_045:r_d4430bf362340b32": {
      "text": "Concentrate all fire on Frontal!",
      "status": "imported"
    },
    "voice_045:r_6ff1323b355593e0": {
      "text": "They're behind the war!\\nCrush them!",
      "status": "imported"
    },
    "voice_045:r_b7b5625d7cd4282f": {
      "text": "Our duty as soldiers:\\nto crush you!",
      "status": "imported"
    },
    "voice_045:r_36133ad73a73ef98": {
      "text": "Lead unit closing\\nat triple speed!",
      "status": "imported"
    },
    "voice_045:r_920740a0219c5085": {
      "text": "The Red Comet is coming! Then...!",
      "status": "imported"
    },
    "voice_045:r_a8451712c57c1a72": {
      "text": "Captain! That approaching unit...!",
      "status": "imported"
    },
    "voice_045:r_3633df5b7b8f47fa": {
      "text": "I know! Alert every battery!",
      "status": "imported"
    },
    "voice_045:r_3304412ac41f47a6": {
      "text": "All batteries, fire!",
      "status": "imported"
    },
    "voice_045:r_0c0775e051211840": {
      "text": "Anti-Air Machine Gun, sweep fire!",
      "status": "imported"
    },
    "voice_045:r_a2afffe1c396f0b3": {
      "text": "Hurry the anti-air defenses!",
      "status": "imported"
    },
    "voice_045:r_13c25fbdfddc8a24": {
      "text": "Intercept enemies nearing this ship!",
      "status": "imported"
    },
    "voice_045:r_42ba1ecb310b4bd7": {
      "text": "Mega Particle Cannon, fire!",
      "status": "imported"
    },
    "voice_045:r_d692f1d420460a47": {
      "text": "Fire the Mega Particle Cannon!",
      "status": "imported"
    },
    "voice_045:r_a5643cec86b18bd2": {
      "text": "Main Mega Particle Cannon, fire!",
      "status": "imported"
    },
    "voice_045:r_68f2dfab20a4a30e": {
      "text": "Main guns, fire!",
      "status": "imported"
    },
    "voice_045:r_9cedad8237480563": {
      "text": "Return fire immediately!",
      "status": "imported"
    },
    "voice_045:r_a03fabecba1508ca": {
      "text": "Counterattack! Hurry!",
      "status": "imported"
    },
    "voice_045:r_5391b24a71eb10ae": {
      "text": "Batteries, don't let them escape!",
      "status": "imported"
    },
    "voice_045:r_a554ceef5c87b972": {
      "text": "We can't end this without payback!",
      "status": "imported"
    },
    "voice_045:r_546c3d5937fbb7ee": {
      "text": "Pursue!\\nMaximum battle speed!",
      "status": "imported"
    },
    "voice_045:r_1568ff6298b12b96": {
      "text": "This is our chance to finish them!",
      "status": "imported"
    },
    "voice_045:r_2c9d94ba13c5fc50": {
      "text": "Follow our allies with a barrage!",
      "status": "imported"
    },
    "voice_045:r_a77f4913375098d2": {
      "text": "This ship will join the attack!",
      "status": "imported"
    },
    "voice_045:r_428c2116ac3071b1": {
      "text": "We'll follow the Captain!",
      "status": "imported"
    },
    "voice_045:r_84c116267b79f540": {
      "text": "Don't waste the Lieutenant's effort!",
      "status": "imported"
    },
    "voice_045:r_dad38ee29af2df3a": {
      "text": "Cover the Ensign!",
      "status": "imported"
    },
    "voice_045:r_3d32e86f8dc80909": {
      "text": "We'll support Banagher!",
      "status": "imported"
    },
    "voice_045:r_70451ffbabe2f876": {
      "text": "That's the spirit, Ensign Riddhe!",
      "status": "imported"
    },
    "voice_045:r_69dfa1659715e2fa": {
      "text": "Coordinate with the Ra Cailum!",
      "status": "imported"
    },
    "voice_045:r_d996fd6d4ef5b329": {
      "text": "So this is the Red Comet's skill!",
      "status": "imported"
    },
    "voice_045:r_8ab47a28f99ef565": {
      "text": "Kamille opened a gap for us!",
      "status": "imported"
    },
    "voice_045:r_546de3fb6db156ea": {
      "text": "The Gundam's as reliable as ever!",
      "status": "imported"
    },
    "voice_045:r_ca85f87cee5e31f7": {
      "text": "This ship will be your shield!",
      "status": "imported"
    },
    "voice_045:r_9072ea7bc71df136": {
      "text": "Move the Nahel Argama forward!",
      "status": "imported"
    },
    "voice_045:r_04e815a8d425827d": {
      "text": "We won't let the Captain die!",
      "status": "imported"
    },
    "voice_045:r_d89011fe3e5d082a": {
      "text": "Lieutenant, fall back behind us!",
      "status": "imported"
    },
    "voice_045:r_3c5b0c2ac812d5de": {
      "text": "We'll support the Ensign!",
      "status": "imported"
    },
    "voice_045:r_5b9e8897190892eb": {
      "text": "Order Banagher to fall back!",
      "status": "imported"
    },
    "voice_045:r_7bea3023abbf8a94": {
      "text": "Tell Ensign Riddhe to calm down!",
      "status": "imported"
    },
    "voice_045:r_dd01a4c0d1b36a8d": {
      "text": "Don't lose Londo Bell's flagship!",
      "status": "imported"
    },
    "voice_045:r_20920ad2eb3542db": {
      "text": "The Red Comet must not fall yet!",
      "status": "imported"
    },
    "voice_045:r_0ab7914877fd48ed": {
      "text": "This time, we'll protect Kamille!",
      "status": "imported"
    },
    "voice_045:r_cb846feec748c2e3": {
      "text": "The Gundam is everyone's hope!",
      "status": "imported"
    },
    "voice_045:r_c958860b0676b1f5": {
      "text": "Must we give up the counterattack?",
      "status": "imported"
    },
    "voice_045:r_5e2669b82ef75ce3": {
      "text": "They completely outplayed us!",
      "status": "imported"
    },
    "voice_045:r_7847e0ed7dc9282d": {
      "text": "Can't resupply\\nright away, either!",
      "status": "imported"
    },
    "voice_045:r_e42b52c7a987b906": {
      "text": "An attack from beyond our range?!",
      "status": "imported"
    },
    "voice_045:r_6825fd1ff907bd22": {
      "text": "Attacking us from that position?!",
      "status": "imported"
    },
    "voice_045:r_607f666f1563bc0d": {
      "text": "All right! That's good movement!",
      "status": "imported"
    },
    "voice_045:r_97b7431eeb81e6b6": {
      "text": "Maintain our current speed!",
      "status": "imported"
    },
    "voice_045:r_132f605d02975e71": {
      "text": "Evasive action! Keep it quick!",
      "status": "imported"
    },
    "voice_045:r_9b9726b1872759d6": {
      "text": "Hold starboard! Turn to 2 o'clock!",
      "status": "imported"
    },
    "voice_045:r_1252db29683fefe0": {
      "text": "Avoid needless damage!",
      "status": "imported"
    },
    "voice_045:r_ad3d538f1e909184": {
      "text": "They must be panicking over there.",
      "status": "imported"
    },
    "voice_045:r_8c61c59a1c0aebbf": {
      "text": "The enemy attack missed us!",
      "status": "imported"
    },
    "voice_045:r_aba6a7662129d8ce": {
      "text": "Good! Momentum is on our side!",
      "status": "imported"
    },
    "voice_045:r_b84afafb8a33ec60": {
      "text": "Red Comet! Don't underestimate us!",
      "status": "imported"
    },
    "voice_045:r_c8c59db85bf875e6": {
      "text": "Even Frontal won't have their way!",
      "status": "imported"
    },
    "voice_045:r_391aa56435d9dd6e": {
      "text": "Whatever the Sleeves may try!",
      "status": "imported"
    },
    "voice_045:r_7c796ba53bd7ea03": {
      "text": "Neo Zeon won't get the better of us!",
      "status": "imported"
    },
    "voice_045:r_fa944da4b6519006": {
      "text": "We know Neo Zeon's tactics!",
      "status": "imported"
    },
    "voice_045:r_95d047bcc17fccc6": {
      "text": "They'll resist to the bitter end?!",
      "status": "imported"
    },
    "voice_045:r_f1e7ed9e5874aba5": {
      "text": "What a futile thing to do!",
      "status": "imported"
    },
    "voice_045:r_fc25e66a86fc2c85": {
      "text": "Block it with the field!",
      "status": "imported"
    },
    "voice_045:r_b765659981b6516d": {
      "text": "This is nothing to us!",
      "status": "imported"
    },
    "voice_045:r_0c427458bc00eb95": {
      "text": "All batteries, thicken the barrage!",
      "status": "imported"
    },
    "voice_045:r_774a9ab4d8fd5351": {
      "text": "Seal damaged areas with bulkheads!",
      "status": "imported"
    },
    "voice_045:r_d3f01de714c015bd": {
      "text": "Anti-air! Keep the enemy away!",
      "status": "imported"
    },
    "voice_045:r_7d2617c809fead70": {
      "text": "Evasive action, faster!",
      "status": "imported"
    },
    "voice_045:r_ceb935ccbf830724": {
      "text": "We're lucky it wasn't a direct hit!",
      "status": "imported"
    },
    "voice_045:r_862ef7385bf2abd4": {
      "text": "Catapult hit! Damage is minor!",
      "status": "imported"
    },
    "voice_045:r_001cbec4d9a4283f": {
      "text": "Ignore minor damage!",
      "status": "imported"
    },
    "voice_045:r_8ad40afecd02b41e": {
      "text": "Anti-air! What are you doing?!",
      "status": "imported"
    },
    "voice_045:r_26e5efec03c03d78": {
      "text": "Our barrage is too thin! Thicken it!",
      "status": "imported"
    },
    "voice_045:r_4ad81e88c7557a8b": {
      "text": "Damn! Intercept system, auto-fire!",
      "status": "imported"
    },
    "voice_045:r_1f65a7af190e4674": {
      "text": "They're putting up quite a fight!",
      "status": "imported"
    },
    "voice_045:r_40c5a9358ed5bf29": {
      "text": "Batteries! Keep them at a distance!",
      "status": "imported"
    },
    "voice_045:r_f2e18dfdfe0c89ea": {
      "text": "The Nahel Argama won't fall yet!",
      "status": "imported"
    },
    "voice_045:r_cf7dbf49e96a5755": {
      "text": "Mobile suit deck hit! Fire!",
      "status": "imported"
    },
    "voice_045:r_fa96676cc65bb509": {
      "text": "Send fire crews to the damage zone!",
      "status": "imported"
    },
    "voice_045:r_4e37f92e7d2fc62e": {
      "text": "Report critical damage first!",
      "status": "imported"
    },
    "voice_045:r_66ab4cfe1557909d": {
      "text": "Y-yes! Understood!",
      "status": "imported"
    },
    "voice_045:r_0bad405ee6ca63ba": {
      "text": "Damn! Worthy of the Red Comet!",
      "status": "imported"
    },
    "voice_045:r_2072eaf71a260ae7": {
      "text": "Frontal! How dare you run wild!",
      "status": "imported"
    },
    "voice_045:r_6c13bbfd27a7799e": {
      "text": "Damn Sleeves! They've done it now!",
      "status": "imported"
    },
    "voice_045:r_06f88dcbd3c9e738": {
      "text": "Neo Zeon! You still mean to resist?!",
      "status": "imported"
    },
    "voice_045:r_b28faf9f71bc3598": {
      "text": "This is Neo Zeon's hidden strength?!",
      "status": "imported"
    },
    "voice_045:r_8a29278549f8e07a": {
      "text": "Their resolve is overwhelming us?!",
      "status": "imported"
    },
    "voice_045:r_e33693e5ba4665b0": {
      "text": "How can they toy with us like this?!",
      "status": "imported"
    },
    "voice_045:r_72a21a1a489af001": {
      "text": "Damn! Send damage control crews!",
      "status": "imported"
    },
    "voice_045:r_eb643f8bf737a0ca": {
      "text": "They're desperate, but so are we!",
      "status": "imported"
    },
    "voice_045:r_0a3fccb71ec6cf2a": {
      "text": "We won't last long! But not yet!",
      "status": "imported"
    },
    "voice_045:r_9b63cf1f3e0207ef": {
      "text": "Don't fall yet! Endure to the end!",
      "status": "imported"
    },
    "voice_045:r_8356f4e3dcdff938": {
      "text": "Don't fall, Nahel Argama...!",
      "status": "imported"
    },
    "voice_045:r_1d6d784036ae0bd7": {
      "text": "Engine section hit! Fire!",
      "status": "imported"
    },
    "voice_045:r_625664af02183c17": {
      "text": "Send fire crews and keep us going!",
      "status": "imported"
    },
    "voice_045:r_3701cba361f80ea5": {
      "text": "All hands! Give your all to the end!",
      "status": "imported"
    },
    "voice_045:r_63f429c5c68c0863": {
      "text": "Understood! Notifying all hands!",
      "status": "imported"
    },
    "voice_045:r_38e4a434c91d8ef0": {
      "text": "No good! All hands, abandon ship!",
      "status": "imported"
    },
    "voice_045:r_98ed411352a3a6ac": {
      "text": "Is this the end?! What a disgrace!",
      "status": "imported"
    },
    "voice_045:r_4824bea6bab3af67": {
      "text": "The Nahel Argama is going down?!",
      "status": "imported"
    },
    "voice_045:r_862b92e63adb9734": {
      "text": "All hands! Battle stations ready?!",
      "status": "imported"
    },
    "voice_045:r_cb306ef55e49d107": {
      "text": "Of course, Captain.",
      "status": "imported"
    },
    "voice_045:r_57b2bd2de8a1408d": {
      "text": "Hurry! Signal all batteries!",
      "status": "imported"
    },
    "voice_045:r_76f080a4881e8ab5": {
      "text": "Understood! Commencing attack!",
      "status": "imported"
    },
    "voice_045:r_288133bc5b573dae": {
      "text": "Minovsky particles, combat density!",
      "status": "imported"
    },
    "voice_045:r_6f95653e548f8fcf": {
      "text": "All right! Commence the attack!",
      "status": "imported"
    },
    "voice_045:r_d249d68bada91ab9": {
      "text": "A Gundam! Take it down at any cost!",
      "status": "imported"
    },
    "voice_045:r_e9b3307e9eb69f11": {
      "text": "Understood! All hands, rally!",
      "status": "imported"
    },
    "voice_045:r_99e6349431aaf23b": {
      "text": "It seems we got lucky.",
      "status": "imported"
    },
    "voice_045:r_ec1081caf845f56a": {
      "text": "Luck is part of skill!",
      "status": "imported"
    },
    "voice_045:r_2c5b7ee872c1ed7f": {
      "text": "The system activated!",
      "status": "imported"
    },
    "voice_045:r_76d1e51c8b494a60": {
      "text": "That should keep us safe for now.",
      "status": "imported"
    },
    "voice_045:r_eb5f687fcd372ae7": {
      "text": "XO! Assess the damage!",
      "status": "imported"
    },
    "voice_045:r_2329428a6871d9fa": {
      "text": "The armor's only scratched!",
      "status": "imported"
    },
    "voice_045:r_0e7466971bec4cc4": {
      "text": "We'll handle the damage assessment.",
      "status": "imported"
    },
    "voice_045:r_efa71f7a4cc33ff3": {
      "text": "It's in your hands, XO.",
      "status": "imported"
    },
    "voice_045:r_3fc2e1186557e7a0": {
      "text": "All hands! Push them back!",
      "status": "imported"
    },
    "voice_045:r_fa6930340a545054": {
      "text": "Understood! Everyone, fight harder!",
      "status": "imported"
    },
    "voice_045:r_2332b9d56461d7ab": {
      "text": "Captain! At this rate...!",
      "status": "imported"
    },
    "voice_045:r_854aa0a91a3c80d1": {
      "text": "Too soon to lose heart, XO!",
      "status": "imported"
    },
    "voice_045:r_0bc8ae32a406ceab": {
      "text": "Will you stay with me to the end?",
      "status": "imported"
    },
    "voice_045:r_82c09f011d703b2c": {
      "text": "Of course!\\nMy life is yours!",
      "status": "imported"
    },
    "voice_045:r_2b4d8818c77b6dca": {
      "text": "Captain, prepare to evacuate!",
      "status": "imported"
    },
    "voice_045:r_087354f2db0a31e6": {
      "text": "Not yet!\\nHold the line to the limit!",
      "status": "imported"
    },
    "voice_045:r_db02a2dec93dd263": {
      "text": "Save done. Quit the game, Captain?",
      "status": "imported"
    },
    "voice_045:r_d520c6d5298a848d": {
      "text": "Player's call. Prepare for anything.",
      "status": "imported"
    },
    "voice_045:r_099e2458cabf796f": {
      "text": "War goes on. This is only a respite.",
      "status": "imported"
    },
    "voice_045:r_fd910d714be70870": {
      "text": "Yes, Captain!",
      "status": "imported"
    },
    "voice_045:r_9736f29b11344ec3": {
      "text": "Get some rest. I'm counting on you.",
      "status": "imported"
    },
    "voice_045:r_fcd05582aa5c6068": {
      "text": "Will that do, XO?",
      "status": "imported"
    },
    "voice_045:r_bece29562818acba": {
      "text": "Excellent work, Captain.",
      "status": "imported"
    },
    "voice_045:r_494b5da92ed24ecb": {
      "text": "Mobile suit team, cover this ship!",
      "status": "imported"
    },
    "voice_045:r_a4a5a96f4bd58920": {
      "text": "All batteries, prepare to attack!",
      "status": "imported"
    },
    "voice_045:r_b57d2d74233f889a": {
      "text": "Captain, we're ready to attack.",
      "status": "imported"
    },
    "voice_045:r_cd06d0820d82524b": {
      "text": "Your orders, Captain.",
      "status": "imported"
    },
    "voice_045:r_c94c6d04be583774": {
      "text": "Your decision, Captain.",
      "status": "imported"
    },
    "voice_045:r_d907fbd7bc1c4298": {
      "text": "It missed us...",
      "status": "imported"
    },
    "voice_045:r_96b21e3a028dd074": {
      "text": "It seems luck is on our side.",
      "status": "imported"
    },
    "voice_045:r_ce140b5d8e6b7310": {
      "text": "Damage like this is no problem!",
      "status": "imported"
    },
    "voice_045:r_0e0335789c5396d7": {
      "text": "It won't hinder our operation.",
      "status": "imported"
    },
    "voice_045:r_a8e85bd950696403": {
      "text": "Damn! At this rate...!",
      "status": "imported"
    },
    "voice_045:r_772c8bc40ab6cb61": {
      "text": "They're targeting this ship?!",
      "status": "imported"
    },
    "voice_045:r_58dd2826a199ef51": {
      "text": "Mistime retreat,\\nand all is lost!",
      "status": "imported"
    },
    "voice_045:r_aadc0b2442adb93b": {
      "text": "More damage,\\nand we can't withdraw!",
      "status": "imported"
    },
    "voice_045:r_e7a8cd8ed5bc2d1b": {
      "text": "I won't entertain that logic!",
      "status": "imported"
    }
  }
}
