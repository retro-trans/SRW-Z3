{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_117:r_479b340ccc6c572b": {
      "text": "Commencing combat!",
      "status": "imported"
    },
    "voice_117:r_77949221bf58f862": {
      "text": "Enemy unit spotted!",
      "status": "imported"
    },
    "voice_117:r_70b9c4b9f1f37eff": {
      "text": "Target acquired!",
      "status": "imported"
    },
    "voice_117:r_9fcb3754cb1773c7": {
      "text": "Fall!",
      "status": "imported"
    },
    "voice_117:r_3559d2fad32c2435": {
      "text": "Come on, hit!",
      "status": "imported"
    },
    "voice_117:r_f7570547e9f80a64": {
      "text": "This is the end!",
      "status": "imported"
    },
    "voice_117:r_cbab0f4720e1fcf1": {
      "text": "I'll pin them down!",
      "status": "imported"
    },
    "voice_117:r_0bbe0b4f5364e732": {
      "text": "If you wanna fight!",
      "status": "imported"
    },
    "voice_117:r_5dda5198137cb02a": {
      "text": "Come and get me!",
      "status": "imported"
    },
    "voice_117:r_83ec59afbecdec14": {
      "text": "I'll take you on!",
      "status": "imported"
    },
    "voice_117:r_e20bfd42ad95a3c9": {
      "text": "No matter how outmatched we are!",
      "status": "imported"
    },
    "voice_117:r_0f58a8822381e57f": {
      "text": "You won't get past here!",
      "status": "imported"
    },
    "voice_117:r_6dbcc507fb61b51d": {
      "text": "Take out the enemy in front!",
      "status": "imported"
    },
    "voice_117:r_b42ab697149a7c8a": {
      "text": "I'll get you before you get me!",
      "status": "imported"
    },
    "voice_117:r_4de4fcf3b440baf4": {
      "text": "You overextended, now you pay!",
      "status": "imported"
    },
    "voice_117:r_0121a166c715cdff": {
      "text": "We'll create a new era!",
      "status": "imported"
    },
    "voice_117:r_30fad37a42bd3ad3": {
      "text": "Feel the wrath of the Spacenoids!",
      "status": "imported"
    },
    "voice_117:r_80a0b2a84e05d81a": {
      "text": "This battle will change the world!",
      "status": "imported"
    },
    "voice_117:r_4a9ac1dff86506d9": {
      "text": "This is Neo Zeon!",
      "status": "imported"
    },
    "voice_117:r_bc8538e6af3d2577": {
      "text": "Witness how Neo Zeon fights!",
      "status": "imported"
    },
    "voice_117:r_924516c8de2b5342": {
      "text": "To realize the Commander's ideals!",
      "status": "imported"
    },
    "voice_117:r_da1174533722333f": {
      "text": "Down with the Earth Federation!",
      "status": "imported"
    },
    "voice_117:r_fdeb8162976e72c1": {
      "text": "You who still cling to Earth\\n...!",
      "status": "imported"
    },
    "voice_117:r_0fadb5c26df92b42": {
      "text": "Spacenoids' hopes\\nare ours to bear!",
      "status": "imported"
    },
    "voice_117:r_6b15af9a0057cdc8": {
      "text": "If it falls, the world will change!",
      "status": "imported"
    },
    "voice_117:r_15b4a90140e8a33a": {
      "text": "Don't hinder the final operation!",
      "status": "imported"
    },
    "voice_117:r_af884a6b11dff121": {
      "text": "You won't break through here!",
      "status": "imported"
    },
    "voice_117:r_ac6fe7838e95647b": {
      "text": "You won't get near Axis!",
      "status": "imported"
    },
    "voice_117:r_77ca87eacd17ad52": {
      "text": "Earth's day of reckoning is here!",
      "status": "imported"
    },
    "voice_117:r_bf3244994760e535": {
      "text": "Now Earth will pay!",
      "status": "imported"
    },
    "voice_117:r_aabfb21c9d069ce7": {
      "text": "I'll shoot you down!",
      "status": "imported"
    },
    "voice_117:r_02479dc8fe989560": {
      "text": "I've got you in my sights!",
      "status": "imported"
    },
    "voice_117:r_a2df00f91a9b0a9e": {
      "text": "Hit them dead-on!",
      "status": "imported"
    },
    "voice_117:r_48b60d6c48b9b142": {
      "text": "Fire enough and something will hit!",
      "status": "imported"
    },
    "voice_117:r_8927e6fb681aa809": {
      "text": "At this range...!",
      "status": "imported"
    },
    "voice_117:r_3633df5b7b8f47fa": {
      "text": "At this range... I'll snipe them!",
      "status": "imported"
    },
    "voice_117:r_52dfc56b14b93551": {
      "text": "Target locked! Fire!",
      "status": "imported"
    },
    "voice_117:r_1b9b2aab5cb104da": {
      "text": "I'll crush you!",
      "status": "imported"
    },
    "voice_117:r_342044c706a2340f": {
      "text": "It's risky, but...!",
      "status": "imported"
    },
    "voice_117:r_cf41e8828a90cbdb": {
      "text": "Closing the distance!",
      "status": "imported"
    },
    "voice_117:r_719e897304ec42d4": {
      "text": "You let me get close!",
      "status": "imported"
    },
    "voice_117:r_d5e0a2317c40d322": {
      "text": "This will finish you!",
      "status": "imported"
    },
    "voice_117:r_d6bdd730f24f66eb": {
      "text": "If I use my saber!",
      "status": "imported"
    },
    "voice_117:r_41997412868c48c4": {
      "text": "I'll cut you down!",
      "status": "imported"
    },
    "voice_117:r_9e6cf4f389dae55c": {
      "text": "Go!",
      "status": "imported"
    },
    "voice_117:r_9e0c80ac7e33b459": {
      "text": "The finishing blow!",
      "status": "imported"
    },
    "voice_117:r_7432ef43ed3471dc": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_117:r_065443f6ddfcf0d7": {
      "text": "Damn you!",
      "status": "imported"
    },
    "voice_117:r_47d52a2839c71715": {
      "text": "There!",
      "status": "imported"
    },
    "voice_117:r_847f82e7f3eef651": {
      "text": "Haaah!",
      "status": "imported"
    },
    "voice_117:r_eb7ae28b53dc033c": {
      "text": "Got you!",
      "status": "imported"
    },
    "voice_117:r_55417493fce1d347": {
      "text": "Let's do this!",
      "status": "imported"
    },
    "voice_117:r_adeb0a29274d3d9b": {
      "text": "Raaaaagh!",
      "status": "imported"
    },
    "voice_117:r_b1de76a75a253c13": {
      "text": "Faaaall!",
      "status": "imported"
    },
    "voice_117:r_38fdff9483e9245c": {
      "text": "Whatever it takes, you fall here!",
      "status": "imported"
    },
    "voice_117:r_ac341e7976e88f0b": {
      "text": "If you're not going to move!",
      "status": "imported"
    },
    "voice_117:r_cdbd128a5b4127cc": {
      "text": "If I can land one more blow...!",
      "status": "imported"
    },
    "voice_117:r_cfccaa1fbeda124c": {
      "text": "It's not over yet!",
      "status": "imported"
    },
    "voice_117:r_b1f8ec192b9c083a": {
      "text": "If I can shoot down the Gundam...!",
      "status": "imported"
    },
    "voice_117:r_a007f9ab9cf048b3": {
      "text": "A Gundam-type... Can I take it...!",
      "status": "imported"
    },
    "voice_117:r_ddafde4b065ced49": {
      "text": "Even if it's a Gundam...!",
      "status": "imported"
    },
    "voice_117:r_de1213040856c089": {
      "text": "I have a grudge against Gundams too!",
      "status": "imported"
    },
    "voice_117:r_3304412ac41f47a6": {
      "text": "Disable it and seize it!",
      "status": "imported"
    },
    "voice_117:r_0c0775e051211840": {
      "text": "Is this our top-priority target?!",
      "status": "imported"
    },
    "voice_117:r_a2afffe1c396f0b3": {
      "text": "Even against a new Gundam!",
      "status": "imported"
    },
    "voice_117:r_13c25fbdfddc8a24": {
      "text": "A transformable Gundam?!",
      "status": "imported"
    },
    "voice_117:r_42ba1ecb310b4bd7": {
      "text": "You winged freak! Fall!",
      "status": "imported"
    },
    "voice_117:r_9cedad8237480563": {
      "text": "Stay back, you Gundam knockoff!",
      "status": "imported"
    },
    "voice_117:r_a03fabecba1508ca": {
      "text": "It's just an advanced GM!",
      "status": "imported"
    },
    "voice_117:r_5391b24a71eb10ae": {
      "text": "A Federation grunt mobile suit!",
      "status": "imported"
    },
    "voice_117:r_a554ceef5c87b972": {
      "text": "I'll shoot Londo Bell down!",
      "status": "imported"
    },
    "voice_117:r_546c3d5937fbb7ee": {
      "text": "Here to ring bells in battle?!",
      "status": "imported"
    },
    "voice_117:r_1568ff6298b12b96": {
      "text": "Celestial Being\\njoined the Feds too!",
      "status": "imported"
    },
    "voice_117:r_2c9d94ba13c5fc50": {
      "text": "We're fighting for\\nour colonies!",
      "status": "imported"
    },
    "voice_117:r_428c2116ac3071b1": {
      "text": "Side with the Feds, become my foe!",
      "status": "imported"
    },
    "voice_117:r_3d32e86f8dc80909": {
      "text": "Traitors will be purged!",
      "status": "imported"
    },
    "voice_117:r_69dfa1659715e2fa": {
      "text": "Defectors will get their due!",
      "status": "imported"
    },
    "voice_117:r_8ab47a28f99ef565": {
      "text": "Colonel... I can never forgive you!",
      "status": "imported"
    },
    "voice_117:r_546de3fb6db156ea": {
      "text": "That emblem... Is that Amuro Ray?!",
      "status": "imported"
    },
    "voice_117:r_ca85f87cee5e31f7": {
      "text": "I'll stop the Feds' White Devil!",
      "status": "imported"
    },
    "voice_117:r_9072ea7bc71df136": {
      "text": "You're just a thick-armored oaf!",
      "status": "imported"
    },
    "voice_117:r_04e815a8d425827d": {
      "text": "You hollow fake! I'll show you!",
      "status": "imported"
    },
    "voice_117:r_d89011fe3e5d082a": {
      "text": "I'll smash that expensive toy!",
      "status": "imported"
    },
    "voice_117:r_3c5b0c2ac812d5de": {
      "text": "That thing... Is it a machine...?!",
      "status": "imported"
    },
    "voice_117:r_5b9e8897190892eb": {
      "text": "Its combination system must be weak!",
      "status": "imported"
    },
    "voice_117:r_7bea3023abbf8a94": {
      "text": "A Frontier Fleet variable fighter?!",
      "status": "imported"
    },
    "voice_117:r_dd01a4c0d1b36a8d": {
      "text": "Speed alone won't decide this fight!",
      "status": "imported"
    },
    "voice_117:r_20920ad2eb3542db": {
      "text": "A mere AT...!",
      "status": "imported"
    },
    "voice_117:r_0ab7914877fd48ed": {
      "text": "An AS is charging us head-on?!",
      "status": "imported"
    },
    "voice_117:r_cb846feec748c2e3": {
      "text": "Black Knights serving the Feds!",
      "status": "imported"
    },
    "voice_117:r_c958860b0676b1f5": {
      "text": "You who abandoned your ideals...!",
      "status": "imported"
    },
    "voice_117:r_5e2669b82ef75ce3": {
      "text": "Small units are hard to target...!",
      "status": "imported"
    },
    "voice_117:r_7847e0ed7dc9282d": {
      "text": "Civilians waltzing into battle...?!",
      "status": "imported"
    },
    "voice_117:r_6825fd1ff907bd22": {
      "text": "In battle,\\nno mercy for civilians!",
      "status": "imported"
    },
    "voice_117:r_97b7431eeb81e6b6": {
      "text": "I'll crush their chain of command!",
      "status": "imported"
    },
    "voice_117:r_132f605d02975e71": {
      "text": "You're the unit commander?!",
      "status": "imported"
    },
    "voice_117:r_9b9726b1872759d6": {
      "text": "I'll sink your mothership!",
      "status": "imported"
    },
    "voice_117:r_1252db29683fefe0": {
      "text": "Up close, a battleship is...!",
      "status": "imported"
    },
    "voice_117:r_cd06d0820d82524b": {
      "text": "Payback!",
      "status": "imported"
    },
    "voice_117:r_c94c6d04be583774": {
      "text": "Commencing counterattack!",
      "status": "imported"
    },
    "voice_117:r_e54e2c99ef8297af": {
      "text": "I'll hit you back!",
      "status": "imported"
    },
    "voice_117:r_f16a3eb0bcaac082": {
      "text": "Then I'll make a move too!",
      "status": "imported"
    },
    "voice_117:r_10a408809e512df1": {
      "text": "I won't forget what you did!",
      "status": "imported"
    },
    "voice_117:r_bc7b9e308b879dd4": {
      "text": "I'll find a chance to break away!",
      "status": "imported"
    },
    "voice_117:r_98902fd3143c393e": {
      "text": "You'll pay for that!",
      "status": "imported"
    },
    "voice_117:r_d907fbd7bc1c4298": {
      "text": "I'll turn this crisis into a chance!",
      "status": "imported"
    },
    "voice_117:r_96b21e3a028dd074": {
      "text": "You took the bait!",
      "status": "imported"
    },
    "voice_117:r_ce140b5d8e6b7310": {
      "text": "Don't think you can escape me!",
      "status": "imported"
    },
    "voice_117:r_0e0335789c5396d7": {
      "text": "Let's coordinate our attack!",
      "status": "imported"
    },
    "voice_117:r_a8e85bd950696403": {
      "text": "I'll match my attack to our allies!",
      "status": "imported"
    },
    "voice_117:r_772c8bc40ab6cb61": {
      "text": "Leave the rest to me!",
      "status": "imported"
    },
    "voice_117:r_58dd2826a199ef51": {
      "text": "Commander! I'll go with you!",
      "status": "imported"
    },
    "voice_117:r_aadc0b2442adb93b": {
      "text": "Colonel! Let me aid you!",
      "status": "imported"
    },
    "voice_117:r_e7a8cd8ed5bc2d1b": {
      "text": "Follow the Red Comet!",
      "status": "imported"
    },
    "voice_117:r_041dd920da4a7c17": {
      "text": "Haman! Leave the rest to me!",
      "status": "imported"
    },
    "voice_117:r_c7f4280cde4605b3": {
      "text": "Follow the Royal Guard!",
      "status": "imported"
    },
    "voice_117:r_ec349c8ea9511a18": {
      "text": "Captain! Leave the rest to me!",
      "status": "imported"
    },
    "voice_117:r_33236ffa3ea95b68": {
      "text": "Lieutenant! I'll finish them!",
      "status": "imported"
    },
    "voice_117:r_689d0b123de71ae0": {
      "text": "Support the Ensign!",
      "status": "imported"
    },
    "voice_117:r_84883aa95f63ce32": {
      "text": "Fall back while you can!",
      "status": "imported"
    },
    "voice_117:r_25493e978ce8ff16": {
      "text": "We'll be your shield!",
      "status": "imported"
    },
    "voice_117:r_7316666150e42960": {
      "text": "Don't push it! Fall back!",
      "status": "imported"
    },
    "voice_117:r_c4f11aa93dc5b668": {
      "text": "Protect the Commander!",
      "status": "imported"
    },
    "voice_117:r_ce1a22dfe3a4d339": {
      "text": "I won't let them harm the Colonel!",
      "status": "imported"
    },
    "voice_117:r_240651adab81e145": {
      "text": "We cannot let the Red Comet fall!",
      "status": "imported"
    },
    "voice_117:r_cff0deaae73c2858": {
      "text": "Even at my life's cost, Haman...!",
      "status": "imported"
    },
    "voice_117:r_dca67f68a573fab7": {
      "text": "Are they targeting the Royal Guard?!",
      "status": "imported"
    },
    "voice_117:r_a6630215fefaf294": {
      "text": "Captain! It's dangerous!",
      "status": "imported"
    },
    "voice_117:r_6f94566ad37f8ff8": {
      "text": "Lieutenant! You're too far ahead!",
      "status": "imported"
    },
    "voice_117:r_942ca03c9de80143": {
      "text": "Ensign! Don't do anything reckless!",
      "status": "imported"
    },
    "voice_117:r_d8c669c70659e18a": {
      "text": "I can't even counterattack...!",
      "status": "imported"
    },
    "voice_117:r_8f5bade7ac2db78e": {
      "text": "Damn it! I lost them!",
      "status": "imported"
    },
    "voice_117:r_05ea490d2f522520": {
      "text": "Damn it! What's going on here?!",
      "status": "imported"
    },
    "voice_117:r_f5658c702d91db7a": {
      "text": "This is bad! I'm just a target!",
      "status": "imported"
    },
    "voice_117:r_686df329b50f195b": {
      "text": "Damn! I forgot combat basics...!",
      "status": "imported"
    },
    "voice_117:r_25f0ab0fa3cf690c": {
      "text": "My energy reserves...?!",
      "status": "imported"
    },
    "voice_117:r_b708a1d959013dbf": {
      "text": "An attack from beyond my range?!",
      "status": "imported"
    },
    "voice_117:r_59fca03e929366c1": {
      "text": "Damn! They got me from there...!",
      "status": "imported"
    },
    "voice_117:r_0d65eb631dcb7514": {
      "text": "Like that'll hit me!",
      "status": "imported"
    },
    "voice_117:r_d03018a31e23f1e9": {
      "text": "Everything you do is too slow!",
      "status": "imported"
    },
    "voice_117:r_279da5f732aa8847": {
      "text": "All right! I dodged it!",
      "status": "imported"
    },
    "voice_117:r_97f82e3cb6f70110": {
      "text": "Luck is on my side!",
      "status": "imported"
    },
    "voice_117:r_c5611d8dd6def96b": {
      "text": "Perfect timing!",
      "status": "imported"
    },
    "voice_117:r_6f12cc8ed2732eb5": {
      "text": "I'll dodge the next one too!",
      "status": "imported"
    },
    "voice_117:r_7abfc55f8fb62ba7": {
      "text": "You face me with skills like that?!",
      "status": "imported"
    },
    "voice_117:r_99e7a66c650b5892": {
      "text": "I saw that attack coming!",
      "status": "imported"
    },
    "voice_117:r_5b2247b5cfbcd7b2": {
      "text": "Real combat has honed my skills!",
      "status": "imported"
    },
    "voice_117:r_2d7a9c06347582d9": {
      "text": "Drop the Gundam name!",
      "status": "imported"
    },
    "voice_117:r_bf953d64c3c7d9b7": {
      "text": "Gundams won't lord over us forever!",
      "status": "imported"
    },
    "voice_117:r_e09b933e3e706779": {
      "text": "The age of Gundams is over!",
      "status": "imported"
    },
    "voice_117:r_66236eb99b676e5b": {
      "text": "Surrender now and I'll spare you!",
      "status": "imported"
    },
    "voice_117:r_9639a2dbcd2f58ed": {
      "text": "So much for the latest model!",
      "status": "imported"
    },
    "voice_117:r_aeea0893acb93d35": {
      "text": "A knockoff is a knockoff to the end!",
      "status": "imported"
    },
    "voice_117:r_b31568654e53487b": {
      "text": "Is ringing bells all you can do?!",
      "status": "imported"
    },
    "voice_117:r_2502132569141ea3": {
      "text": "Weak as the corrupt Federation!",
      "status": "imported"
    },
    "voice_117:r_1ff312798a52c8eb": {
      "text": "Siding with the Feds led to this!",
      "status": "imported"
    },
    "voice_117:r_237a0288b42dce20": {
      "text": "Red Comet suits the Colonel best!",
      "status": "imported"
    },
    "voice_117:r_0556e8a22779ea8e": {
      "text": "You've fallen low, Char Aznable!",
      "status": "imported"
    },
    "voice_117:r_09d377101a48d92a": {
      "text": "Oaf!\\nYou're wasting all that power!",
      "status": "imported"
    },
    "voice_117:r_11517cc7b0494dbf": {
      "text": "You're nothing but a fast gnat!",
      "status": "imported"
    },
    "voice_117:r_b5864501463db244": {
      "text": "You're too weak!",
      "status": "imported"
    },
    "voice_117:r_59369bad143d4272": {
      "text": "We've got equipment like that too!",
      "status": "imported"
    },
    "voice_117:r_25f9b1e39dd8d366": {
      "text": "That didn't even hurt!",
      "status": "imported"
    },
    "voice_117:r_af62f2ee466b5c8c": {
      "text": "With an I-field...!",
      "status": "imported"
    },
    "voice_117:r_20cfb719db02fafd": {
      "text": "As long as my shield holds...!",
      "status": "imported"
    },
    "voice_117:r_570c1fdf72edb283": {
      "text": "My shield can handle that!",
      "status": "imported"
    },
    "voice_117:r_23f0d87a5a6cfca1": {
      "text": "My armor saved me...!",
      "status": "imported"
    },
    "voice_117:r_60c94ea4eb7f7404": {
      "text": "You only managed to hit me!",
      "status": "imported"
    },
    "voice_117:r_727b2ee0277f9159": {
      "text": "That was nothing but a fluke!",
      "status": "imported"
    },
    "voice_117:r_cff4d2eae8a939ed": {
      "text": "Did I underestimate them...!",
      "status": "imported"
    },
    "voice_117:r_1428fe5f35a9427b": {
      "text": "At least your aim is true!",
      "status": "imported"
    },
    "voice_117:r_96d39b8bdfa6f183": {
      "text": "You call that damage?!",
      "status": "imported"
    },
    "voice_117:r_0e4f9b8a2d26ebff": {
      "text": "As long as it misses the reactor...!",
      "status": "imported"
    },
    "voice_117:r_79e0d542fe12bcf7": {
      "text": "A sub-camera or two won't matter!",
      "status": "imported"
    },
    "voice_117:r_eff747ba39a55393": {
      "text": "All systems normal! I can fight!",
      "status": "imported"
    },
    "voice_117:r_b2dc77aa6dd77e69": {
      "text": "Ngh! They fired where I dodged!",
      "status": "imported"
    },
    "voice_117:r_445d40d8b5d7092b": {
      "text": "This is bad! I took it head-on...!",
      "status": "imported"
    },
    "voice_117:r_bbb633cb5e8e6daf": {
      "text": "Can't let them build momentum...!",
      "status": "imported"
    },
    "voice_117:r_0abd8b6c713ccdac": {
      "text": "One opening, and this happens...!",
      "status": "imported"
    },
    "voice_117:r_f4ff463b2fda1b86": {
      "text": "Half my monitors are dead!",
      "status": "imported"
    },
    "voice_117:r_4e63c037d3cb8a3d": {
      "text": "Urgh! They pierced the armor!",
      "status": "imported"
    },
    "voice_117:r_9ca8d188ae805e3a": {
      "text": "Damn! Am I outmatched in power?!",
      "status": "imported"
    },
    "voice_117:r_795ed21f3e28e1f5": {
      "text": "Sluggish response! Drive trouble?!",
      "status": "imported"
    },
    "voice_117:r_141415c1def5ab2d": {
      "text": "Our fight won't end that easily!",
      "status": "imported"
    },
    "voice_117:r_c894e35becf35a03": {
      "text": "I was prepared for this much!",
      "status": "imported"
    },
    "voice_117:r_79b1abf5fc86483c": {
      "text": "Neo Zeon won't lose... Never!",
      "status": "imported"
    },
    "voice_117:r_e9a11621911acb19": {
      "text": "If we lose,\\nwhat of the Spacenoids?!",
      "status": "imported"
    },
    "voice_117:r_d52bece55796f599": {
      "text": "Will Gundam's myth claim me too...?!",
      "status": "imported"
    },
    "voice_117:r_358fe5a50bbee1df": {
      "text": "Damn! So this is a Gundam's power!",
      "status": "imported"
    },
    "voice_117:r_638834e16724002f": {
      "text": "Gundam!\\nBlocking Zeon's path again?!",
      "status": "imported"
    },
    "voice_117:r_b02fca1590ac1210": {
      "text": "Damn!\\nHeld back, and you got cocky!",
      "status": "imported"
    },
    "voice_117:r_f0344d2fbaa9db77": {
      "text": "The latest model's no mere show...!",
      "status": "imported"
    },
    "voice_117:r_3328eef766ff2c2c": {
      "text": "Londo Bell... Better than rumored!",
      "status": "imported"
    },
    "voice_117:r_23b037cf6ccc695c": {
      "text": "You're a class above the other Feds!",
      "status": "imported"
    },
    "voice_117:r_883ad1128d340c5e": {
      "text": "Can't beat a Gundam knockoff...?!",
      "status": "imported"
    },
    "voice_117:r_a9e6ed99025a703b": {
      "text": "Celestial Being!\\nStill that strong?!",
      "status": "imported"
    },
    "voice_117:r_b0d1459d6daeebbe": {
      "text": "You mean to abandon the colonies?!",
      "status": "imported"
    },
    "voice_117:r_5691cc71770ffdde": {
      "text": "That one...!\\nA Newtype, maybe?!",
      "status": "imported"
    },
    "voice_117:r_964e07c5563a5508": {
      "text": "I-it moves differently... No way?!",
      "status": "imported"
    },
    "voice_117:r_db54e717bff3e3b2": {
      "text": "Amuro Ray... You White Devil!",
      "status": "imported"
    },
    "voice_117:r_fcab8d80aef7e9d8": {
      "text": "Their Newtype rumor\\nwas true?!",
      "status": "imported"
    },
    "voice_117:r_2174bd0edc164171": {
      "text": "So this is the Red Comet's skill...!",
      "status": "imported"
    },
    "voice_117:r_ad54419336b49578": {
      "text": "Red Comet... With that power, why?!",
      "status": "imported"
    },
    "voice_117:r_63c353e1e05e8e39": {
      "text": "W-what is that power?!",
      "status": "imported"
    },
    "voice_117:r_87646dd472438e88": {
      "text": "Armor and raw power...\\nNo weakness?!",
      "status": "imported"
    },
    "voice_117:r_4e32ac89cba02001": {
      "text": "So it's Super, true to its name!",
      "status": "imported"
    },
    "voice_117:r_02d24e5915bfa5b7": {
      "text": "Damn! I can't flee or pursue it!",
      "status": "imported"
    },
    "voice_117:r_9331c2c2ef55c78f": {
      "text": "Mobile suits\\ncan't match that speed!",
      "status": "imported"
    },
    "voice_117:r_49734bdb3507acf7": {
      "text": "What in the world is that AT?!",
      "status": "imported"
    },
    "voice_117:r_2a730c9b4df0dca3": {
      "text": "So this is an AS's firepower?!",
      "status": "imported"
    },
    "voice_117:r_1e5842ba5dc3f705": {
      "text": "Black Knights!\\nWhy block our way?!",
      "status": "imported"
    },
    "voice_117:r_9747bd61ad23ecd3": {
      "text": "Damn!\\nHow can it have such power?!",
      "status": "imported"
    },
    "voice_117:r_a29f58ecde5f7ddd": {
      "text": "Aaaaargh!",
      "status": "imported"
    },
    "voice_117:r_4069f7e9517c47e8": {
      "text": "It's no use! Output won't rise...",
      "status": "imported"
    },
    "voice_117:r_2835a8af1c41be9b": {
      "text": "I'm already near the limit...!",
      "status": "imported"
    },
    "voice_117:r_cd84325a7c1a820f": {
      "text": "A-am I truly outclassed...?!",
      "status": "imported"
    },
    "voice_117:r_0465f74c0488ad70": {
      "text": "My main camera's been hit!",
      "status": "imported"
    },
    "voice_117:r_a30c8238b5208470": {
      "text": "Damn!\\nThe thrusters won't work!",
      "status": "imported"
    },
    "voice_117:r_64bf1c63c7c1ebdd": {
      "text": "Serious drive-system trouble?!",
      "status": "imported"
    },
    "voice_117:r_f6d5042f671118fa": {
      "text": "Bad...!\\nThe reactor will ignite!",
      "status": "imported"
    },
    "voice_117:r_0be18539fac21ba4": {
      "text": "The instant I give up, I lose...!",
      "status": "imported"
    },
    "voice_117:r_c05bd0cf089d667f": {
      "text": "Fight...! Fight to the very end!",
      "status": "imported"
    },
    "voice_117:r_f69a0e1d0d67fd0e": {
      "text": "It's too soon to think you've won!",
      "status": "imported"
    },
    "voice_117:r_c4e734ceafabd82c": {
      "text": "I can fight! I'll see it to the end!",
      "status": "imported"
    },
    "voice_117:r_62f1de6cdfb87024": {
      "text": "Until Spacenoids have a future...!",
      "status": "imported"
    },
    "voice_117:r_7ecfe7ddfa4cdb6a": {
      "text": "Not yet...! Neo Zeon still lives...!",
      "status": "imported"
    },
    "voice_117:r_d1be92a2ad355176": {
      "text": "Our ideals and cause!\\nNot to you!",
      "status": "imported"
    },
    "voice_117:r_e0022ae8da32f998": {
      "text": "Suit breaks,\\nNeo Zeon's soul lives!",
      "status": "imported"
    },
    "voice_117:r_0ef83b6a1e87f6fd": {
      "text": "A-aaaaaaaaagh!!",
      "status": "imported"
    },
    "voice_117:r_a8f0666c4d6d24a0": {
      "text": "N-no! Aaaaaaagh!!",
      "status": "imported"
    },
    "voice_117:r_3ec7c6e48027a853": {
      "text": "Is retreat our only choice?!",
      "status": "imported"
    },
    "voice_117:r_953824ba6b607e1f": {
      "text": "I-I have to abandon the unit!",
      "status": "imported"
    },
    "voice_117:r_d6c7a401f55ee42f": {
      "text": "I have to fall back here...!",
      "status": "imported"
    },
    "voice_117:r_7bce428a8c95c22c": {
      "text": "At my limit! The ejector...!",
      "status": "imported"
    },
    "voice_117:r_97b5fedc5b19e6af": {
      "text": "N-not in a place like this!",
      "status": "imported"
    },
    "voice_117:r_111aa50202ff773f": {
      "text": "C-captain! Forgive me!",
      "status": "imported"
    },
    "voice_117:r_10cb1d3f8f325f52": {
      "text": "Z-Zeon's spirit will never die!",
      "status": "imported"
    },
    "voice_117:r_ed69cbf9ff3779a7": {
      "text": "Zeon's spirit will surely live on!",
      "status": "imported"
    },
    "voice_117:r_82e0a318411dcbf7": {
      "text": "Even if I fall, Neo Zeon will...!",
      "status": "imported"
    },
    "voice_117:r_36c402609f13ec14": {
      "text": "Comrades! The rest is up to you!!",
      "status": "imported"
    },
    "voice_117:r_5ec6634ac287489a": {
      "text": "I can at least slow them down!",
      "status": "imported"
    },
    "voice_117:r_0f6c6e8f33422ecf": {
      "text": "I'll draw their attention!",
      "status": "imported"
    },
    "voice_117:r_035b4f6912ba7eed": {
      "text": "If we focus our attacks...!",
      "status": "imported"
    },
    "voice_117:r_f74b67b3cfcbe05c": {
      "text": "I know what my duty is!",
      "status": "imported"
    },
    "voice_117:r_6d8a80e2956870ed": {
      "text": "I'll open a path through!",
      "status": "imported"
    },
    "voice_117:r_426b68d671486c8e": {
      "text": "Against only one unit!",
      "status": "imported"
    },
    "voice_117:r_ae913eb08e0ff29b": {
      "text": "I can't afford to fail!",
      "status": "imported"
    },
    "voice_117:r_6fbc129ae3a24bb0": {
      "text": "The odds are even!",
      "status": "imported"
    },
    "voice_117:r_0e58a97c7f8c9ecf": {
      "text": "We'll use that strategy!",
      "status": "imported"
    },
    "voice_117:r_46e80691278d2e90": {
      "text": "I'll handle that one!",
      "status": "imported"
    }
  }
}
