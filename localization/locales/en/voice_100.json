{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_100:r_479b340ccc6c572b": {
      "text": "There!",
      "status": "imported"
    },
    "voice_100:r_ca4acbac57a2a35e": {
      "text": "That's more like it.",
      "status": "imported"
    },
    "voice_100:r_77949221bf58f862": {
      "text": "That's as far as you go!",
      "status": "imported"
    },
    "voice_100:r_70b9c4b9f1f37eff": {
      "text": "Hmph... Interesting.",
      "status": "imported"
    },
    "voice_100:r_9fcb3754cb1773c7": {
      "text": "You're a worthy opponent!",
      "status": "imported"
    },
    "voice_100:r_3559d2fad32c2435": {
      "text": "Is this where my destiny ends?",
      "status": "imported"
    },
    "voice_100:r_f7570547e9f80a64": {
      "text": "Can I not fight on like this?!",
      "status": "imported"
    },
    "voice_100:r_cbab0f4720e1fcf1": {
      "text": "Tch! It hit me!",
      "status": "imported"
    },
    "voice_100:r_0bbe0b4f5364e732": {
      "text": "Not yet, not yet!",
      "status": "imported"
    },
    "voice_100:r_5dda5198137cb02a": {
      "text": "That won't make you a match for me!",
      "status": "imported"
    },
    "voice_100:r_83ec59afbecdec14": {
      "text": "I won't be beaten!",
      "status": "imported"
    },
    "voice_100:r_e20bfd42ad95a3c9": {
      "text": "How incompetent...",
      "status": "imported"
    },
    "voice_100:r_0f58a8822381e57f": {
      "text": "Too naive!",
      "status": "imported"
    },
    "voice_100:r_6dbcc507fb61b51d": {
      "text": "You're not capable of it!",
      "status": "imported"
    },
    "voice_100:r_b42ab697149a7c8a": {
      "text": "Like I'd let you!",
      "status": "imported"
    },
    "voice_100:r_4de4fcf3b440baf4": {
      "text": "Radar contact lost?",
      "status": "imported"
    },
    "voice_100:r_0121a166c715cdff": {
      "text": "Guh! More power than I expected!",
      "status": "imported"
    },
    "voice_100:r_30fad37a42bd3ad3": {
      "text": "Not yet! This isn't over yet!",
      "status": "imported"
    },
    "voice_100:r_80a0b2a84e05d81a": {
      "text": "Me, cornered...\\nBut not beaten!",
      "status": "imported"
    },
    "voice_100:r_4a9ac1dff86506d9": {
      "text": "Whoa!\\nGuh... This fight isn't over!",
      "status": "imported"
    },
    "voice_100:r_bc8538e6af3d2577": {
      "text": "A fine attack!\\nBut I won't die yet!",
      "status": "imported"
    },
    "voice_100:r_924516c8de2b5342": {
      "text": "Ngh! You want me to get serious.",
      "status": "imported"
    },
    "voice_100:r_da1174533722333f": {
      "text": "I won't let you do it!",
      "status": "imported"
    },
    "voice_100:r_fdeb8162976e72c1": {
      "text": "Tch! An attack from out of range?!",
      "status": "imported"
    },
    "voice_100:r_0fadb5c26df92b42": {
      "text": "I know it's impossible!!",
      "status": "imported"
    },
    "voice_100:r_6b15af9a0057cdc8": {
      "text": "If I strike right there!!",
      "status": "imported"
    },
    "voice_100:r_15b4a90140e8a33a": {
      "text": "Guh!\\nI still can't abandon hope!!",
      "status": "imported"
    },
    "voice_100:r_af884a6b11dff121": {
      "text": "Don't celebrate over one hit!!",
      "status": "imported"
    },
    "voice_100:r_ac6fe7838e95647b": {
      "text": "That won't work! Not at that level!!",
      "status": "imported"
    },
    "voice_100:r_77ca87eacd17ad52": {
      "text": "Hmph... My prediction was correct.",
      "status": "imported"
    },
    "voice_100:r_bf3244994760e535": {
      "text": "I'll end this with a single blow!",
      "status": "imported"
    },
    "voice_100:r_aabfb21c9d069ce7": {
      "text": "Got you!!",
      "status": "imported"
    },
    "voice_100:r_02479dc8fe989560": {
      "text": "Meeting me has sealed your fate.",
      "status": "imported"
    },
    "voice_100:r_a2df00f91a9b0a9e": {
      "text": "Even someone like me\\ncan be of use!",
      "status": "imported"
    },
    "voice_100:r_48b60d6c48b9b142": {
      "text": "At least let me do this much!",
      "status": "imported"
    },
    "voice_100:r_8927e6fb681aa809": {
      "text": "I'll score a direct hit!",
      "status": "imported"
    },
    "voice_100:r_665f01666859013b": {
      "text": "This is as far as you go!!",
      "status": "imported"
    },
    "voice_100:r_a571eec59b258d11": {
      "text": "With this!",
      "status": "imported"
    },
    "voice_100:r_ddbe581c5ea9183d": {
      "text": "It's over!",
      "status": "imported"
    },
    "voice_100:r_d4430bf362340b32": {
      "text": "Too naive!",
      "status": "imported"
    },
    "voice_100:r_6ff1323b355593e0": {
      "text": "Here I go!",
      "status": "imported"
    },
    "voice_100:r_36133ad73a73ef98": {
      "text": "I won't let you!",
      "status": "imported"
    },
    "voice_100:r_a8451712c57c1a72": {
      "text": "This settles it!!",
      "status": "imported"
    },
    "voice_100:r_3633df5b7b8f47fa": {
      "text": "Guh...\\nIs there nothing left...?",
      "status": "imported"
    },
    "voice_100:r_1b9b2aab5cb104da": {
      "text": "I'll make the first move!",
      "status": "imported"
    },
    "voice_100:r_342044c706a2340f": {
      "text": "Whoever seizes initiative wins!",
      "status": "imported"
    },
    "voice_100:r_cf41e8828a90cbdb": {
      "text": "Let me see what that power can do!",
      "status": "imported"
    },
    "voice_100:r_719e897304ec42d4": {
      "text": "Is bloodshed my fate after all...?",
      "status": "imported"
    },
    "voice_100:r_f2d4255f1c2f7542": {
      "text": "Prepare yourself!",
      "status": "imported"
    },
    "voice_100:r_5d08ad19e2da125b": {
      "text": "This is the end!",
      "status": "imported"
    },
    "voice_100:r_a7246b52782a877e": {
      "text": "Let's go!",
      "status": "imported"
    },
    "voice_100:r_dc8701f6bcb9904f": {
      "text": "Haaaah!",
      "status": "imported"
    },
    "voice_100:r_d6bdd730f24f66eb": {
      "text": "It isn't over yet, you know!",
      "status": "imported"
    },
    "voice_100:r_41997412868c48c4": {
      "text": "I won't give you an opening!",
      "status": "imported"
    },
    "voice_100:r_9e6cf4f389dae55c": {
      "text": "Whatever my foe, I'll fight all-out!",
      "status": "imported"
    },
    "voice_100:r_9e0c80ac7e33b459": {
      "text": "I'll eliminate humanity's enemies!",
      "status": "imported"
    },
    "voice_100:r_7432ef43ed3471dc": {
      "text": "First, I'll strike at the head!",
      "status": "imported"
    },
    "voice_100:r_065443f6ddfcf0d7": {
      "text": "In war, you take out the commander!",
      "status": "imported"
    },
    "voice_100:r_47d52a2839c71715": {
      "text": "You're not worthy of such power!",
      "status": "imported"
    },
    "voice_100:r_847f82e7f3eef651": {
      "text": "I'll eliminate every spark of war!",
      "status": "imported"
    },
    "voice_100:r_9680dcd0fddcfcc7": {
      "text": "I can't let you escape!",
      "status": "imported"
    },
    "voice_100:r_2a00f1044ad5cbaa": {
      "text": "You'll receive a fitting welcome!",
      "status": "imported"
    },
    "voice_100:r_3dbeead1bd3164ef": {
      "text": "The outcome isn't decided yet!",
      "status": "imported"
    },
    "voice_100:r_98d15b8cc09bc915": {
      "text": "I can't allow a counterattack!",
      "status": "imported"
    },
    "voice_100:r_46e86d000250e137": {
      "text": "I won't waste this chance...!",
      "status": "imported"
    },
    "voice_100:r_ac341e7976e88f0b": {
      "text": "I'll follow suit!",
      "status": "imported"
    },
    "voice_100:r_cdbd128a5b4127cc": {
      "text": "To think I can't counterattack...",
      "status": "imported"
    },
    "voice_100:r_cfccaa1fbeda124c": {
      "text": "At this rate, I'm a sitting duck!",
      "status": "imported"
    },
    "voice_100:r_b1f8ec192b9c083a": {
      "text": "I'm not blind, you know!",
      "status": "imported"
    },
    "voice_100:r_a007f9ab9cf048b3": {
      "text": "I can't fight disgracefully now!",
      "status": "imported"
    },
    "voice_100:r_ddafde4b065ced49": {
      "text": "I won't stay in your sights forever.",
      "status": "imported"
    },
    "voice_100:r_de1213040856c089": {
      "text": "To think you rely on barriers...",
      "status": "imported"
    },
    "voice_100:r_3304412ac41f47a6": {
      "text": "So your equipment saved you...",
      "status": "imported"
    },
    "voice_100:r_0c0775e051211840": {
      "text": "It seems you underestimated me!",
      "status": "imported"
    },
    "voice_100:r_a2afffe1c396f0b3": {
      "text": "How boorish of you.",
      "status": "imported"
    },
    "voice_100:r_13c25fbdfddc8a24": {
      "text": "Did I overestimate you?",
      "status": "imported"
    },
    "voice_100:r_42ba1ecb310b4bd7": {
      "text": "I can't spurn a challenge, but...!",
      "status": "imported"
    },
    "voice_100:r_d692f1d420460a47": {
      "text": "To think even I left an opening...!",
      "status": "imported"
    },
    "voice_100:r_a5643cec86b18bd2": {
      "text": "I thought distractions were gone...!",
      "status": "imported"
    },
    "voice_100:r_68f2dfab20a4a30e": {
      "text": "So you aren't easily dealt with...!",
      "status": "imported"
    },
    "voice_100:r_9cedad8237480563": {
      "text": "A head-on fight... How intriguing!",
      "status": "imported"
    },
    "voice_100:r_a03fabecba1508ca": {
      "text": "You can fight me as an equal!",
      "status": "imported"
    },
    "voice_100:r_5391b24a71eb10ae": {
      "text": "You've far exceeded our predictions!",
      "status": "imported"
    },
    "voice_100:r_a554ceef5c87b972": {
      "text": "I misjudged how long I'd live...!",
      "status": "imported"
    },
    "voice_100:r_546c3d5937fbb7ee": {
      "text": "No choice. I'm leaving this battle!",
      "status": "imported"
    },
    "voice_100:r_1568ff6298b12b96": {
      "text": "I need the courage to retreat...!",
      "status": "imported"
    },
    "voice_100:r_2c9d94ba13c5fc50": {
      "text": "Fall!",
      "status": "imported"
    },
    "voice_100:r_69dfa1659715e2fa": {
      "text": "Hmph...\\nSpace's most daunting foe!",
      "status": "imported"
    },
    "voice_100:r_20920ad2eb3542db": {
      "text": "Lightning Count\\nis no empty title!",
      "status": "imported"
    },
    "voice_100:r_0ab7914877fd48ed": {
      "text": "I'll live on!\\nAs a soldier!",
      "status": "imported"
    },
    "voice_100:r_cb846feec748c2e3": {
      "text": "I won't let total peace be denied!",
      "status": "imported"
    },
    "voice_100:r_c958860b0676b1f5": {
      "text": "Noin, Relena... Guide me!",
      "status": "imported"
    },
    "voice_100:r_132f605d02975e71": {
      "text": "Follow up with another attack!",
      "status": "imported"
    },
    "voice_100:r_9b9726b1872759d6": {
      "text": "This is the perfect moment!",
      "status": "imported"
    },
    "voice_100:r_1252db29683fefe0": {
      "text": "Ngh! Impressive!",
      "status": "imported"
    },
    "voice_100:r_ad3d538f1e909184": {
      "text": "One blow did this...\\nIntriguing!",
      "status": "imported"
    },
    "voice_100:r_8c61c59a1c0aebbf": {
      "text": "I-Is this my limit...!?",
      "status": "imported"
    },
    "voice_100:r_aba6a7662129d8ce": {
      "text": "Wing Zero has taken this much...!",
      "status": "imported"
    },
    "voice_100:r_c8c59db85bf875e6": {
      "text": "That won't be enough to sink me!",
      "status": "imported"
    },
    "voice_100:r_391aa56435d9dd6e": {
      "text": "That won't affect me!",
      "status": "imported"
    },
    "voice_100:r_7c796ba53bd7ea03": {
      "text": "Hmph. I won't allow it!",
      "status": "imported"
    },
    "voice_100:r_fa944da4b6519006": {
      "text": "There you are!",
      "status": "imported"
    },
    "voice_100:r_95d047bcc17fccc6": {
      "text": "It's useless!",
      "status": "imported"
    },
    "voice_100:r_bdd38c584fa313d0": {
      "text": "Even this can stop\\nyour attack!",
      "status": "imported"
    },
    "voice_100:r_3fd86c1027f317c8": {
      "text": "I won't let brave soldiers die!",
      "status": "imported"
    },
    "voice_100:r_d0372a183d2007ad": {
      "text": "Don't give me too much trouble.",
      "status": "imported"
    },
    "voice_100:r_217aa5e1d545b44d": {
      "text": "Wing Zero! Show me victory!",
      "status": "imported"
    },
    "voice_100:r_f1e7ed9e5874aba5": {
      "text": "You've done good work.",
      "status": "imported"
    },
    "voice_100:r_fc25e66a86fc2c85": {
      "text": "Ngh! This power...!?",
      "status": "imported"
    },
    "voice_100:r_5aeeb4917340c42d": {
      "text": "Come what may,\\nI won't regret it!",
      "status": "imported"
    },
    "voice_100:r_b765659981b6516d": {
      "text": "Ugh! You have some skill after all!",
      "status": "imported"
    },
    "voice_100:r_0c427458bc00eb95": {
      "text": "That's the limit of your skill!",
      "status": "imported"
    },
    "voice_100:r_774a9ab4d8fd5351": {
      "text": "You dare challenge me...",
      "status": "imported"
    },
    "voice_100:r_d3f01de714c015bd": {
      "text": "Is that the extent of your ability?!",
      "status": "imported"
    },
    "voice_100:r_7d2617c809fead70": {
      "text": "I've seen through your moves!",
      "status": "imported"
    },
    "voice_100:r_ceb935ccbf830724": {
      "text": "Fall back at once!",
      "status": "imported"
    },
    "voice_100:r_862ef7385bf2abd4": {
      "text": "You want me to get serious!",
      "status": "imported"
    },
    "voice_100:r_8ad40afecd02b41e": {
      "text": "Hmph... What an incompetent foe.",
      "status": "imported"
    },
    "voice_100:r_26e5efec03c03d78": {
      "text": "Target locked...\\nFire Mega Cannon!",
      "status": "imported"
    },
    "voice_100:r_fa96676cc65bb509": {
      "text": "This is Wind!\\nFire Mega Cannon!!",
      "status": "imported"
    },
    "voice_100:r_7e6c573c26177f98": {
      "text": "Got you!!",
      "status": "imported"
    },
    "voice_100:r_cb306ef55e49d107": {
      "text": "Use the Heat Rod!",
      "status": "imported"
    },
    "voice_100:r_57b2bd2de8a1408d": {
      "text": "No second Milliardo\\nwill be born!",
      "status": "imported"
    },
    "voice_100:r_76f080a4881e8ab5": {
      "text": "A peacetime misfit\\ncan still help!",
      "status": "imported"
    },
    "voice_100:r_288133bc5b573dae": {
      "text": "I won't hold back against dolls!",
      "status": "imported"
    },
    "voice_100:r_6f95653e548f8fcf": {
      "text": "Wufei, Treize's ghost\\nhas you too?",
      "status": "imported"
    },
    "voice_100:r_2c5b7ee872c1ed7f": {
      "text": "Lifeless dolls are no match for me!",
      "status": "imported"
    },
    "voice_100:r_0e7466971bec4cc4": {
      "text": "Can't I even sleep in peace?!",
      "status": "imported"
    },
    "voice_100:r_efa71f7a4cc33ff3": {
      "text": "Some things only a dead man\\ncan do!",
      "status": "imported"
    },
    "voice_100:r_3fc2e1186557e7a0": {
      "text": "Now I'm Wind, here to quench fires!",
      "status": "imported"
    },
    "voice_100:r_fa6930340a545054": {
      "text": "Milliardo Peacecraft\\nwon't return!",
      "status": "imported"
    },
    "voice_100:r_2332b9d56461d7ab": {
      "text": "If even I can still be useful...!",
      "status": "imported"
    },
    "voice_100:r_854aa0a91a3c80d1": {
      "text": "I died once!\\nI can take some risks!",
      "status": "imported"
    },
    "voice_100:r_0bc8ae32a406ceab": {
      "text": "You must have your reasons, but...!",
      "status": "imported"
    },
    "voice_100:r_82c09f011d703b2c": {
      "text": "You favor roundabout methods!",
      "status": "imported"
    },
    "voice_100:r_2b4d8818c77b6dca": {
      "text": "Still possessed\\nby Treize's ghost!",
      "status": "imported"
    },
    "voice_100:r_087354f2db0a31e6": {
      "text": "A man like you, a ghost's puppet!",
      "status": "imported"
    },
    "voice_100:r_db02a2dec93dd263": {
      "text": "Embers were smoldering even here!",
      "status": "imported"
    },
    "voice_100:r_d520c6d5298a848d": {
      "text": "Another who can't adapt to peace...",
      "status": "imported"
    },
    "voice_100:r_099e2458cabf796f": {
      "text": "Ghosts, return quietly to the grave!",
      "status": "imported"
    },
    "voice_100:r_fd910d714be70870": {
      "text": "A puppet of Dekim Barton...!",
      "status": "imported"
    },
    "voice_100:r_9736f29b11344ec3": {
      "text": "They even prepared this...!",
      "status": "imported"
    },
    "voice_100:r_fcd05582aa5c6068": {
      "text": "I won't let history repeat itself!",
      "status": "imported"
    },
    "voice_100:r_bece29562818acba": {
      "text": "Such methods\\nwill change nothing!",
      "status": "imported"
    },
    "voice_100:r_494b5da92ed24ecb": {
      "text": "Your answer,\\nCaptain Quattro?!",
      "status": "imported"
    },
    "voice_100:r_a4a5a96f4bd58920": {
      "text": "Even you,\\nheld by Treize's ghost!",
      "status": "imported"
    },
    "voice_100:r_b57d2d74233f889a": {
      "text": "Captain Quattro's very moves...!?",
      "status": "imported"
    },
    "voice_100:r_cd06d0820d82524b": {
      "text": "That Mobile Armor is dangerous...!",
      "status": "imported"
    },
    "voice_100:r_c94c6d04be583774": {
      "text": "Those moves...!\\nAn enhanced pilot?!",
      "status": "imported"
    },
    "voice_100:r_e54e2c99ef8297af": {
      "text": "You reject infinite potential...!",
      "status": "imported"
    },
    "voice_100:r_f16a3eb0bcaac082": {
      "text": "Defy despair,\\nshow human potential!",
      "status": "imported"
    },
    "voice_100:r_10a408809e512df1": {
      "text": "Even if God wills mankind dead...!",
      "status": "imported"
    },
    "voice_100:r_bc7b9e308b879dd4": {
      "text": "Primal Calamity... I'll defy you!",
      "status": "imported"
    },
    "voice_100:r_98902fd3143c393e": {
      "text": "First, I'll stop that machine!",
      "status": "imported"
    },
    "voice_100:r_d907fbd7bc1c4298": {
      "text": "I'll smash that machine of bondage!",
      "status": "imported"
    },
    "voice_100:r_96b21e3a028dd074": {
      "text": "I snuff war's spark! That's my duty!",
      "status": "imported"
    },
    "voice_100:r_ce140b5d8e6b7310": {
      "text": "No hellfire\\nwill consume this world!",
      "status": "imported"
    },
    "voice_100:r_772c8bc40ab6cb61": {
      "text": "Wind here! Destroy the final target!",
      "status": "imported"
    },
    "voice_100:r_58dd2826a199ef51": {
      "text": "Galaxy-wide war\\nI'll cut its source!",
      "status": "imported"
    },
    "voice_100:r_aadc0b2442adb93b": {
      "text": "Your schemes end here!",
      "status": "imported"
    },
    "voice_100:r_e7a8cd8ed5bc2d1b": {
      "text": "We'll defeat the masterminds of war!",
      "status": "imported"
    },
    "voice_100:r_b0d1459d6daeebbe": {
      "text": "Impressive as ever, Heero!",
      "status": "imported"
    },
    "voice_100:r_cd4893b409472e97": {
      "text": "The dead follow the Reaper, then...!",
      "status": "imported"
    },
    "voice_100:r_5691cc71770ffdde": {
      "text": "Nice attack, Trowa!",
      "status": "imported"
    },
    "voice_100:r_964e07c5563a5508": {
      "text": "Quatre, leave the rest to me.",
      "status": "imported"
    },
    "voice_100:r_db54e717bff3e3b2": {
      "text": "I'll follow you, Wufei!",
      "status": "imported"
    },
    "voice_100:r_fcab8d80aef7e9d8": {
      "text": "I'm counting on you, Noin.",
      "status": "imported"
    },
    "voice_100:r_2174bd0edc164171": {
      "text": "Sharp instincts as ever, Noin.",
      "status": "imported"
    },
    "voice_100:r_ad54419336b49578": {
      "text": "I'll support you, Major Graham!",
      "status": "imported"
    },
    "voice_100:r_63c353e1e05e8e39": {
      "text": "I'll back up the Red Comet!",
      "status": "imported"
    },
    "voice_100:r_87646dd472438e88": {
      "text": "Don't make Relena cry, Heero!",
      "status": "imported"
    },
    "voice_100:r_4e32ac89cba02001": {
      "text": "A Grim Reaper can't very well die!",
      "status": "imported"
    },
    "voice_100:r_02d24e5915bfa5b7": {
      "text": "Fall back, Trowa!",
      "status": "imported"
    },
    "voice_100:r_9331c2c2ef55c78f": {
      "text": "Don't overexert yourself, Quatre!",
      "status": "imported"
    },
    "voice_100:r_49734bdb3507acf7": {
      "text": "Same as ever, Wufei!",
      "status": "imported"
    },
    "voice_100:r_2a730c9b4df0dca3": {
      "text": "Fall back, Noin!",
      "status": "imported"
    },
    "voice_100:r_1e5842ba5dc3f705": {
      "text": "This time, I'll protect you.",
      "status": "imported"
    },
    "voice_100:r_9747bd61ad23ecd3": {
      "text": "Fall back, Major Graham!",
      "status": "imported"
    },
    "voice_100:r_6823f8abe05c4727": {
      "text": "You must not die yet!",
      "status": "imported"
    },
    "voice_100:r_b8ccfd8b8ac323ac": {
      "text": "Not to some reckless attack...!",
      "status": "imported"
    },
    "voice_100:r_c885ff2097749991": {
      "text": "The name Wind is no mere boast!",
      "status": "imported"
    },
    "voice_100:r_a8da7f8d8b705db0": {
      "text": "I won't return to my coffin!",
      "status": "imported"
    },
    "voice_100:r_02e1c5e19de5bd22": {
      "text": "It seems my prediction won out!",
      "status": "imported"
    },
    "voice_100:r_6fb823898811e210": {
      "text": "If my machine moves, I fight on!",
      "status": "imported"
    },
    "voice_100:r_5dcbcf1682cc3ab8": {
      "text": "I knew the risk from the start!",
      "status": "imported"
    },
    "voice_100:r_5a20988e743dc1d0": {
      "text": "I still can't abandon hope...!",
      "status": "imported"
    },
    "voice_100:r_197f05bf899b7697": {
      "text": "Not yet! My duty\\nis not over yet!",
      "status": "imported"
    },
    "voice_100:r_623ee03bd91ab2a1": {
      "text": "Treize!\\nI won't join you yet!",
      "status": "imported"
    },
    "voice_100:r_c5c491f8761152f0": {
      "text": "Too soon to return to Hades!",
      "status": "imported"
    },
    "voice_100:r_15042263763f11bb": {
      "text": "To think I'd look so disgraceful...!",
      "status": "imported"
    },
    "voice_100:r_96b3a8f080aea8b4": {
      "text": "My battle isn't over yet...!",
      "status": "imported"
    },
    "voice_100:r_3d4fa015b8b31648": {
      "text": "Shed past and mask. Free your heart.",
      "status": "imported"
    },
    "voice_100:r_c1f3167d7dd97543": {
      "text": "Players, shed masks. Live honestly.",
      "status": "imported"
    },
    "voice_100:r_1ac46173650ffe13": {
      "text": "Understood. We'll take the lead!",
      "status": "imported"
    },
    "voice_100:r_53660d6bc7fe8513": {
      "text": "Don't think it's mere stalling...!",
      "status": "imported"
    },
    "voice_100:r_2e756557a1d92e8b": {
      "text": "Very well. That's the best strategy!",
      "status": "imported"
    },
    "voice_100:r_45d847e7b8d840e3": {
      "text": "I'll support you!",
      "status": "imported"
    },
    "voice_100:r_d2ebe8f28f2420cc": {
      "text": "Zechs here. Understood!",
      "status": "imported"
    },
    "voice_100:r_3baa2292b050034a": {
      "text": "So it's one-on-one!",
      "status": "imported"
    },
    "voice_100:r_8a303240a87b1c7d": {
      "text": "I won't be bested in single combat!",
      "status": "imported"
    }
  }
}
