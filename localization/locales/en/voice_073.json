{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_073:r_479b340ccc6c572b": {
      "text": "Then, let's begin.",
      "status": "imported"
    },
    "voice_073:r_ca4acbac57a2a35e": {
      "text": "This is what I must do.",
      "status": "imported"
    },
    "voice_073:r_77949221bf58f862": {
      "text": "All hands, we're moving out!",
      "status": "imported"
    },
    "voice_073:r_70b9c4b9f1f37eff": {
      "text": "Unite your hearts and minds! Go!",
      "status": "imported"
    },
    "voice_073:r_9fcb3754cb1773c7": {
      "text": "Now is the time to fight...!",
      "status": "imported"
    },
    "voice_073:r_3559d2fad32c2435": {
      "text": "Aquarion, grant us your power...!",
      "status": "imported"
    },
    "voice_073:r_f7570547e9f80a64": {
      "text": "So we may bathe the world in light!",
      "status": "imported"
    },
    "voice_073:r_cbab0f4720e1fcf1": {
      "text": "We'll forge the future ourselves!",
      "status": "imported"
    },
    "voice_073:r_0bbe0b4f5364e732": {
      "text": "Let's go, Amata Sora.",
      "status": "imported"
    },
    "voice_073:r_5dda5198137cb02a": {
      "text": "Understood, Chair!",
      "status": "imported"
    },
    "voice_073:r_83ec59afbecdec14": {
      "text": "Mikono Suzushiro.\\nUse your link...!",
      "status": "imported"
    },
    "voice_073:r_e20bfd42ad95a3c9": {
      "text": "Yes! I'll assist you, Chair!",
      "status": "imported"
    },
    "voice_073:r_0f58a8822381e57f": {
      "text": "Chair! I'm ready!",
      "status": "imported"
    },
    "voice_073:r_6dbcc507fb61b51d": {
      "text": "Then let's begin, Cayenne Suzushiro.",
      "status": "imported"
    },
    "voice_073:r_b42ab697149a7c8a": {
      "text": "Over to you, Chair Crea!",
      "status": "imported"
    },
    "voice_073:r_4de4fcf3b440baf4": {
      "text": "We'll strive to meet your hopes.",
      "status": "imported"
    },
    "voice_073:r_0121a166c715cdff": {
      "text": "Here's our chance. Everyone ready?",
      "status": "imported"
    },
    "voice_073:r_30fad37a42bd3ad3": {
      "text": "Yes! Ready whenever you are!",
      "status": "imported"
    },
    "voice_073:r_80a0b2a84e05d81a": {
      "text": "Jin Muso,\\nwe need your strength too.",
      "status": "imported"
    },
    "voice_073:r_4a9ac1dff86506d9": {
      "text": "Y-yes! Gladly!",
      "status": "imported"
    },
    "voice_073:r_bc8538e6af3d2577": {
      "text": "Kagura Demuri,\\nwe need you too.",
      "status": "imported"
    },
    "voice_073:r_924516c8de2b5342": {
      "text": "Sure! Take as much as you need!",
      "status": "imported"
    },
    "voice_073:r_da1174533722333f": {
      "text": "Still off guard? One more!",
      "status": "imported"
    },
    "voice_073:r_fdeb8162976e72c1": {
      "text": "My attack doesn't end with one blow.",
      "status": "imported"
    },
    "voice_073:r_0fadb5c26df92b42": {
      "text": "No one toys\\nwith our world.",
      "status": "imported"
    },
    "voice_073:r_6b15af9a0057cdc8": {
      "text": "I'll teach you\\nhow to treat a woman.",
      "status": "imported"
    },
    "voice_073:r_15b4a90140e8a33a": {
      "text": "This world needs\\nno hatred...!",
      "status": "imported"
    },
    "voice_073:r_af884a6b11dff121": {
      "text": "Your lost soul\\nI now set free...!",
      "status": "imported"
    },
    "voice_073:r_ac6fe7838e95647b": {
      "text": "We must end this war among humanity!",
      "status": "imported"
    },
    "voice_073:r_bf3244994760e535": {
      "text": "War-born machines\\nI destroy here.",
      "status": "imported"
    },
    "voice_073:r_aabfb21c9d069ce7": {
      "text": "Ravenous fiend... You won't pass.",
      "status": "imported"
    },
    "voice_073:r_02479dc8fe989560": {
      "text": "A cosmic predator of humanity...",
      "status": "imported"
    },
    "voice_073:r_48b60d6c48b9b142": {
      "text": "Dread calamity...\\nOur future foe...",
      "status": "imported"
    },
    "voice_073:r_8927e6fb681aa809": {
      "text": "Humanity's future...\\nOurs to forge.",
      "status": "imported"
    },
    "voice_073:r_a571eec59b258d11": {
      "text": "I'll free you\\nfrom your bonds now.",
      "status": "imported"
    },
    "voice_073:r_ddbe581c5ea9183d": {
      "text": "I'll stop you. Bear with me.",
      "status": "imported"
    },
    "voice_073:r_faae935cca0edc72": {
      "text": "I won't surrender this world\\nto you.",
      "status": "imported"
    },
    "voice_073:r_d4430bf362340b32": {
      "text": "I reject the future you envision.",
      "status": "imported"
    },
    "voice_073:r_6ff1323b355593e0": {
      "text": "Your vile methods\\nare unforgivable.",
      "status": "imported"
    },
    "voice_073:r_b7b5625d7cd4282f": {
      "text": "Humans are fools?\\nWitness our power!",
      "status": "imported"
    },
    "voice_073:r_36133ad73a73ef98": {
      "text": "Split clean in two...!",
      "status": "imported"
    },
    "voice_073:r_920740a0219c5085": {
      "text": "This ends now!",
      "status": "imported"
    },
    "voice_073:r_a8451712c57c1a72": {
      "text": "With this single stroke...!",
      "status": "imported"
    },
    "voice_073:r_3633df5b7b8f47fa": {
      "text": "Victory to this blade...!",
      "status": "imported"
    },
    "voice_073:r_b1f8ec192b9c083a": {
      "text": "I won't let you escape.",
      "status": "imported"
    },
    "voice_073:r_a007f9ab9cf048b3": {
      "text": "It can't be helped. I'll counter.",
      "status": "imported"
    },
    "voice_073:r_ddafde4b065ced49": {
      "text": "You've brought this on yourself.",
      "status": "imported"
    },
    "voice_073:r_de1213040856c089": {
      "text": "I'm not a gentle woman, you know.",
      "status": "imported"
    },
    "voice_073:r_3304412ac41f47a6": {
      "text": "Then it's my turn to attack.",
      "status": "imported"
    },
    "voice_073:r_0c0775e051211840": {
      "text": "It seems you need to be punished.",
      "status": "imported"
    },
    "voice_073:r_a2afffe1c396f0b3": {
      "text": "Permit me a little meddling.",
      "status": "imported"
    },
    "voice_073:r_13c25fbdfddc8a24": {
      "text": "Consider this a little bonus.",
      "status": "imported"
    },
    "voice_073:r_42ba1ecb310b4bd7": {
      "text": "I'll take care of things here.",
      "status": "imported"
    },
    "voice_073:r_d692f1d420460a47": {
      "text": "Not while I'm standing here!",
      "status": "imported"
    },
    "voice_073:r_a5643cec86b18bd2": {
      "text": "It seems my counterattack is sealed.",
      "status": "imported"
    },
    "voice_073:r_68f2dfab20a4a30e": {
      "text": "How humiliating. I'm helpless...",
      "status": "imported"
    },
    "voice_073:r_9cedad8237480563": {
      "text": "We can't keep fighting like this.",
      "status": "imported"
    },
    "voice_073:r_a03fabecba1508ca": {
      "text": "Wear is heavier than I expected.",
      "status": "imported"
    },
    "voice_073:r_5391b24a71eb10ae": {
      "text": "Beyond our range...?\\nNice move.",
      "status": "imported"
    },
    "voice_073:r_a554ceef5c87b972": {
      "text": "I can't believe I misjudged range.",
      "status": "imported"
    },
    "voice_073:r_546c3d5937fbb7ee": {
      "text": "Teleport!",
      "status": "imported"
    },
    "voice_073:r_1568ff6298b12b96": {
      "text": "I'm no longer there.",
      "status": "imported"
    },
    "voice_073:r_2c9d94ba13c5fc50": {
      "text": "Come back when you're ready.",
      "status": "imported"
    },
    "voice_073:r_a77f4913375098d2": {
      "text": "Was that meant to be an attack?",
      "status": "imported"
    },
    "voice_073:r_428c2116ac3071b1": {
      "text": "Sweeter than a chocolate donut!",
      "status": "imported"
    },
    "voice_073:r_84c116267b79f540": {
      "text": "I see through everything.",
      "status": "imported"
    },
    "voice_073:r_dad38ee29af2df3a": {
      "text": "Face reality.",
      "status": "imported"
    },
    "voice_073:r_3d32e86f8dc80909": {
      "text": "Too much of your motion is wasted.",
      "status": "imported"
    },
    "voice_073:r_70451ffbabe2f876": {
      "text": "Amazing! As expected of you!",
      "status": "imported"
    },
    "voice_073:r_69dfa1659715e2fa": {
      "text": "As Chair,\\nI must set the example.",
      "status": "imported"
    },
    "voice_073:r_d996fd6d4ef5b329": {
      "text": "Dodge with minimal motion...\\nBasic.",
      "status": "imported"
    },
    "voice_073:r_8ab47a28f99ef565": {
      "text": "Y-yes! I'm learning so much!",
      "status": "imported"
    },
    "voice_073:r_546de3fb6db156ea": {
      "text": "Such perfectly efficient movement!",
      "status": "imported"
    },
    "voice_073:r_ca85f87cee5e31f7": {
      "text": "I haven't aged for nothing.",
      "status": "imported"
    },
    "voice_073:r_9072ea7bc71df136": {
      "text": "Whoa! That was close!",
      "status": "imported"
    },
    "voice_073:r_04e815a8d425827d": {
      "text": "Watch closely. I evade with ease.",
      "status": "imported"
    },
    "voice_073:r_d89011fe3e5d082a": {
      "text": "Read the foe,\\nmove only as needed.",
      "status": "imported"
    },
    "voice_073:r_3c5b0c2ac812d5de": {
      "text": "I see...! That's the secret!",
      "status": "imported"
    },
    "voice_073:r_5b9e8897190892eb": {
      "text": "What a perfect evasive maneuver...!",
      "status": "imported"
    },
    "voice_073:r_7bea3023abbf8a94": {
      "text": "That's the wisdom of age.",
      "status": "imported"
    },
    "voice_073:r_dd01a4c0d1b36a8d": {
      "text": "Not bad! You've earned my respect!",
      "status": "imported"
    },
    "voice_073:r_20920ad2eb3542db": {
      "text": "You need a lesson\\nin proper manners.",
      "status": "imported"
    },
    "voice_073:r_0ab7914877fd48ed": {
      "text": "Learn how powerless you truly are.",
      "status": "imported"
    },
    "voice_073:r_cb846feec748c2e3": {
      "text": "Your attack can't pierce my barrier.",
      "status": "imported"
    },
    "voice_073:r_5e2669b82ef75ce3": {
      "text": "Forewarned is forearmed.",
      "status": "imported"
    },
    "voice_073:r_7847e0ed7dc9282d": {
      "text": "My shield can stop a blow that weak.",
      "status": "imported"
    },
    "voice_073:r_e42b52c7a987b906": {
      "text": "...You call that an attack?",
      "status": "imported"
    },
    "voice_073:r_6825fd1ff907bd22": {
      "text": "How could I let that hit me...?",
      "status": "imported"
    },
    "voice_073:r_607f666f1563bc0d": {
      "text": "It appears I let my guard down.",
      "status": "imported"
    },
    "voice_073:r_97b7431eeb81e6b6": {
      "text": "I should alter my approach slightly.",
      "status": "imported"
    },
    "voice_073:r_132f605d02975e71": {
      "text": "You think this\\ncan stop me?",
      "status": "imported"
    },
    "voice_073:r_9b9726b1872759d6": {
      "text": "No time to mind\\ndamage this slight.",
      "status": "imported"
    },
    "voice_073:r_1252db29683fefe0": {
      "text": "Chair! They hit us!",
      "status": "imported"
    },
    "voice_073:r_ad3d538f1e909184": {
      "text": "Calm down.\\nThis is far from fatal.",
      "status": "imported"
    },
    "voice_073:r_8c61c59a1c0aebbf": {
      "text": "It seems\\nI underrated them.",
      "status": "imported"
    },
    "voice_073:r_aba6a7662129d8ce": {
      "text": "I'm fine!\\nThe damage is minor!",
      "status": "imported"
    },
    "voice_073:r_b84afafb8a33ec60": {
      "text": "The enemy moves so fast...!",
      "status": "imported"
    },
    "voice_073:r_c8c59db85bf875e6": {
      "text": "No need to panic. I'll dodge next.",
      "status": "imported"
    },
    "voice_073:r_391aa56435d9dd6e": {
      "text": "This much doesn't count as damage.",
      "status": "imported"
    },
    "voice_073:r_7c796ba53bd7ea03": {
      "text": "A rush, Chair!\\nI'm fired up too!",
      "status": "imported"
    },
    "voice_073:r_fa944da4b6519006": {
      "text": "Check the damage to all sections...!",
      "status": "imported"
    },
    "voice_073:r_95d047bcc17fccc6": {
      "text": "Damage is minor! No problems!",
      "status": "imported"
    },
    "voice_073:r_640327a12a559b31": {
      "text": "Shifting the hit\\nto shed damage...!?",
      "status": "imported"
    },
    "voice_073:r_bdd38c584fa313d0": {
      "text": "Can't dodge?\\nUse another method.",
      "status": "imported"
    },
    "voice_073:r_3fd86c1027f317c8": {
      "text": "Damn you! You'll pay for that!",
      "status": "imported"
    },
    "voice_073:r_d0372a183d2007ad": {
      "text": "Stay calm. It's only a scratch.",
      "status": "imported"
    },
    "voice_073:r_217aa5e1d545b44d": {
      "text": "It's been so long since I felt this.",
      "status": "imported"
    },
    "voice_073:r_381992c5d8224937": {
      "text": "They're fighting desperately too.",
      "status": "imported"
    },
    "voice_073:r_f1e7ed9e5874aba5": {
      "text": "Did they foil my prediction?",
      "status": "imported"
    },
    "voice_073:r_fc25e66a86fc2c85": {
      "text": "I must reassess\\nthis opponent.",
      "status": "imported"
    },
    "voice_073:r_5aeeb4917340c42d": {
      "text": "Even I can't expect a flawless win.",
      "status": "imported"
    },
    "voice_073:r_b765659981b6516d": {
      "text": "Ngh...!\\nMaybe I'm just getting old.",
      "status": "imported"
    },
    "voice_073:r_0c427458bc00eb95": {
      "text": "The situation seems to favor them.",
      "status": "imported"
    },
    "voice_073:r_774a9ab4d8fd5351": {
      "text": "Even so,\\nwe cannot retreat!",
      "status": "imported"
    },
    "voice_073:r_d3f01de714c015bd": {
      "text": "Chair, let's turn this around!",
      "status": "imported"
    },
    "voice_073:r_7d2617c809fead70": {
      "text": "Heh... You've grown stronger too.",
      "status": "imported"
    },
    "voice_073:r_ceb935ccbf830724": {
      "text": "Chair, let me take over!",
      "status": "imported"
    },
    "voice_073:r_862ef7385bf2abd4": {
      "text": "No need.\\nLeave this to me.",
      "status": "imported"
    },
    "voice_073:r_001cbec4d9a4283f": {
      "text": "H-hey! Chair, you took that head-on!",
      "status": "imported"
    },
    "voice_073:r_8ad40afecd02b41e": {
      "text": "I know that much already!",
      "status": "imported"
    },
    "voice_073:r_26e5efec03c03d78": {
      "text": "Control damage!\\nFight on!",
      "status": "imported"
    },
    "voice_073:r_4ad81e88c7557a8b": {
      "text": "Roger! Just what I wanted!",
      "status": "imported"
    },
    "voice_073:r_1f65a7af190e4674": {
      "text": "Drive-system damage is mounting...!",
      "status": "imported"
    },
    "voice_073:r_40c5a9358ed5bf29": {
      "text": "My mistake.\\nBut no more!",
      "status": "imported"
    },
    "voice_073:r_f2e18dfdfe0c89ea": {
      "text": "Bastard!\\nYou won't get home safe!",
      "status": "imported"
    },
    "voice_073:r_cf7dbf49e96a5755": {
      "text": "That fighting spirit reassures me.",
      "status": "imported"
    },
    "voice_073:r_fa96676cc65bb509": {
      "text": "Ngh! A direct hit...!",
      "status": "imported"
    },
    "voice_073:r_4e37f92e7d2fc62e": {
      "text": "All Aura Levels are dropping...!",
      "status": "imported"
    },
    "voice_073:r_66ab4cfe1557909d": {
      "text": "I must acknowledge their strength.",
      "status": "imported"
    },
    "voice_073:r_0bad405ee6ca63ba": {
      "text": "I have no concept of surrender...!",
      "status": "imported"
    },
    "voice_073:r_2072eaf71a260ae7": {
      "text": "Hold firm,\\nAquarion will answer!",
      "status": "imported"
    },
    "voice_073:r_6c13bbfd27a7799e": {
      "text": "Eek! At my age...\\nSuch a scream...",
      "status": "imported"
    },
    "voice_073:r_06f88dcbd3c9e738": {
      "text": "Everyone, prepare yourselves!",
      "status": "imported"
    },
    "voice_073:r_b28faf9f71bc3598": {
      "text": "I know!\\nI'll fight to the very end!",
      "status": "imported"
    },
    "voice_073:r_8a29278549f8e07a": {
      "text": "Chair! We won't give up to the end!",
      "status": "imported"
    },
    "voice_073:r_7e6c573c26177f98": {
      "text": "Thank you. I feel the same way.",
      "status": "imported"
    },
    "voice_073:r_45abf84f7757d6eb": {
      "text": "I hold all your lives in my hands!",
      "status": "imported"
    },
    "voice_073:r_edd7a13ab8f06a14": {
      "text": "Understood! I'll give it my all too!",
      "status": "imported"
    },
    "voice_073:r_8165e5b41f0124c4": {
      "text": "Chair! We're almost at our limit!",
      "status": "imported"
    },
    "voice_073:r_4e05581b7432cce8": {
      "text": "We'll beat them before that happens!",
      "status": "imported"
    },
    "voice_073:r_a60b107ea3c36a86": {
      "text": "Chair, eject! We'll handle the rest!",
      "status": "imported"
    },
    "voice_073:r_e33693e5ba4665b0": {
      "text": "A Chair never abandons students!",
      "status": "imported"
    },
    "voice_073:r_72a21a1a489af001": {
      "text": "No more! Fighting on is madness!",
      "status": "imported"
    },
    "voice_073:r_eb643f8bf737a0ca": {
      "text": "Give up, and the future ends here!",
      "status": "imported"
    },
    "voice_073:r_0a3fccb71ec6cf2a": {
      "text": "Then I'll use a do-or-die plan!",
      "status": "imported"
    },
    "voice_073:r_9b63cf1f3e0207ef": {
      "text": "I like you!\\nI'm with you to the end!",
      "status": "imported"
    },
    "voice_073:r_8356f4e3dcdff938": {
      "text": "No...!\\nAquarion defeated?!",
      "status": "imported"
    },
    "voice_073:r_1d6d784036ae0bd7": {
      "text": "Everyone, eject! Hurry!",
      "status": "imported"
    },
    "voice_073:r_625664af02183c17": {
      "text": "Fudou... I'll take a break as well.",
      "status": "imported"
    },
    "voice_073:r_3701cba361f80ea5": {
      "text": "A donut...? Where is it?",
      "status": "imported"
    },
    "voice_073:r_63f429c5c68c0863": {
      "text": "...You expect that to convince me?",
      "status": "imported"
    },
    "voice_073:r_38e4a434c91d8ef0": {
      "text": "Both of you, stop this...",
      "status": "imported"
    },
    "voice_073:r_57b2bd2de8a1408d": {
      "text": "Amata, Zessica...!\\nLend me strength!",
      "status": "imported"
    },
    "voice_073:r_76f080a4881e8ab5": {
      "text": "Got it!",
      "status": "imported"
    },
    "voice_073:r_288133bc5b573dae": {
      "text": "Let's do this, Shrade!",
      "status": "imported"
    },
    "voice_073:r_6f95653e548f8fcf": {
      "text": "Here we go! Soul Arpeggio!",
      "status": "imported"
    },
    "voice_073:r_d249d68bada91ab9": {
      "text": "Sky vibrato,\\nwater allegro vivace",
      "status": "imported"
    },
    "voice_073:r_e9b3307e9eb69f11": {
      "text": "Man's moon sings life\\nin agitato!",
      "status": "imported"
    },
    "voice_073:r_03cdac73042343ee": {
      "text": "Moonlight Requiem!",
      "status": "imported"
    },
    "voice_073:r_6026da5acbda7c69": {
      "text": "My life...! I play it with the moon!",
      "status": "imported"
    },
    "voice_073:r_641550a2f54cb456": {
      "text": "Haaaaah!",
      "status": "imported"
    },
    "voice_073:r_a0f2074af8debbfa": {
      "text": "My soul and life ring in moonlight!",
      "status": "imported"
    },
    "voice_073:r_b5f5a97ed82acb0b": {
      "text": "Resound, Moonlight Requiem!",
      "status": "imported"
    },
    "voice_073:r_d9cd2e4ded064396": {
      "text": "This is the finale!",
      "status": "imported"
    },
    "voice_073:r_99e6349431aaf23b": {
      "text": "Fastest toccata,\\nlet me pluck you!",
      "status": "imported"
    },
    "voice_073:r_ec1081caf845f56a": {
      "text": "The moon tonight will play...!",
      "status": "imported"
    },
    "voice_073:r_2c5b7ee872c1ed7f": {
      "text": "Moonlight Rhapsody!",
      "status": "imported"
    },
    "voice_073:r_76d1e51c8b494a60": {
      "text": "Bewitched by the beautiful moon...!",
      "status": "imported"
    },
    "voice_073:r_eb5f687fcd372ae7": {
      "text": "Be intoxicated by my melody...!",
      "status": "imported"
    },
    "voice_073:r_2329428a6871d9fa": {
      "text": "Moonlight Rhapsody!",
      "status": "imported"
    },
    "voice_073:r_0e7466971bec4cc4": {
      "text": "No... My bare skin's sensitive...!",
      "status": "imported"
    },
    "voice_073:r_efa71f7a4cc33ff3": {
      "text": "Every part of my body...!",
      "status": "imported"
    },
    "voice_073:r_3fc2e1186557e7a0": {
      "text": "So stimulatingggg!",
      "status": "imported"
    },
    "voice_073:r_fa6930340a545054": {
      "text": "Uooooooh!",
      "status": "imported"
    },
    "voice_073:r_2332b9d56461d7ab": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_073:r_854aa0a91a3c80d1": {
      "text": "No guard!",
      "status": "imported"
    },
    "voice_073:r_0bc8ae32a406ceab": {
      "text": "Attaaack!!",
      "status": "imported"
    },
    "voice_073:r_82c09f011d703b2c": {
      "text": "Embarrassing, but it feels good!",
      "status": "imported"
    },
    "voice_073:r_2b4d8818c77b6dca": {
      "text": "My whole body's burning!",
      "status": "imported"
    },
    "voice_073:r_087354f2db0a31e6": {
      "text": "I-it's embarrassing, but...!",
      "status": "imported"
    },
    "voice_073:r_db02a2dec93dd263": {
      "text": "It feels kind of good!",
      "status": "imported"
    },
    "voice_073:r_d520c6d5298a848d": {
      "text": "Haaaaah!",
      "status": "imported"
    },
    "voice_073:r_099e2458cabf796f": {
      "text": "Heat the skin and sever the flesh!",
      "status": "imported"
    },
    "voice_073:r_fcd05582aa5c6068": {
      "text": "We did it, Amata! Mikono!",
      "status": "imported"
    },
    "voice_073:r_bece29562818acba": {
      "text": "E-embarrassment and...!",
      "status": "imported"
    },
    "voice_073:r_494b5da92ed24ecb": {
      "text": "A sense of liberation...!",
      "status": "imported"
    },
    "voice_073:r_a4a5a96f4bd58920": {
      "text": "Locked in a fierce struggle!",
      "status": "imported"
    },
    "voice_073:r_f16a3eb0bcaac082": {
      "text": "Haa... My heart won't stop racing!",
      "status": "imported"
    },
    "voice_073:r_dca67f68a573fab7": {
      "text": "I feel my friend's soul so close...!",
      "status": "imported"
    },
    "voice_073:r_a6630215fefaf294": {
      "text": "Come, fight beside me, Cayenne!",
      "status": "imported"
    },
    "voice_073:r_6f94566ad37f8ff8": {
      "text": "Let's go, my friend!",
      "status": "imported"
    },
    "voice_073:r_942ca03c9de80143": {
      "text": "This is for my friend!",
      "status": "imported"
    },
    "voice_073:r_d8c669c70659e18a": {
      "text": "Requiem of the Master Musician!!",
      "status": "imported"
    },
    "voice_073:r_8f5bade7ac2db78e": {
      "text": "Time to play the ultimate melody...!",
      "status": "imported"
    },
    "voice_073:r_05ea490d2f522520": {
      "text": "Will you play with me, Cayenne?",
      "status": "imported"
    },
    "voice_073:r_f5658c702d91db7a": {
      "text": "Of course, my friend.",
      "status": "imported"
    },
    "voice_073:r_686df329b50f195b": {
      "text": "I'll play this with my friend!",
      "status": "imported"
    },
    "voice_073:r_25f0ab0fa3cf690c": {
      "text": "Requiem of the Master Musician!!",
      "status": "imported"
    },
    "voice_073:r_b708a1d959013dbf": {
      "text": "From me...\\nA new sound born in us!",
      "status": "imported"
    },
    "voice_073:r_59fca03e929366c1": {
      "text": "This is... what Shrade longed for!",
      "status": "imported"
    },
    "voice_073:r_0d65eb631dcb7514": {
      "text": "Yes! The ultimate melody!",
      "status": "imported"
    },
    "voice_073:r_d03018a31e23f1e9": {
      "text": "Unite Spada and Gepard's power...!",
      "status": "imported"
    },
    "voice_073:r_279da5f732aa8847": {
      "text": "Requiem of the Master Musician!!",
      "status": "imported"
    },
    "voice_073:r_fa07d90fca62f593": {
      "text": "Teleport! Hah! Hyah!",
      "status": "imported"
    },
    "voice_073:r_a25bf2676ecf9d83": {
      "text": "Then I'll go on ahead.",
      "status": "imported"
    },
    "voice_073:r_237a0288b42dce20": {
      "text": "Excuse me, I'll go on ahead.",
      "status": "imported"
    },
    "voice_073:r_0556e8a22779ea8e": {
      "text": "I'll stop the enemy's movements.",
      "status": "imported"
    },
    "voice_073:r_09d377101a48d92a": {
      "text": "Match your movements to mine.",
      "status": "imported"
    },
    "voice_073:r_11517cc7b0494dbf": {
      "text": "Allow me to be your opponent.",
      "status": "imported"
    },
    "voice_073:r_b5864501463db244": {
      "text": "Please handle my opponent.",
      "status": "imported"
    },
    "voice_073:r_a88939ea84b4474d": {
      "text": "My role is to defeat you.",
      "status": "imported"
    },
    "voice_073:r_a870d0cf7cc11ec6": {
      "text": "I'll target my own enemy.",
      "status": "imported"
    }
  }
}
