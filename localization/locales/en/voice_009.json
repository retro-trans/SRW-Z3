{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_009:r_479b340ccc6c572b": {
      "text": "I'm stuck with crude, filthy men?!",
      "status": "imported"
    },
    "voice_009:r_ca4acbac57a2a35e": {
      "text": "It'd be better with girls only...!",
      "status": "imported"
    },
    "voice_009:r_77949221bf58f862": {
      "text": "A coed team is just filthy!",
      "status": "imported"
    },
    "voice_009:r_70b9c4b9f1f37eff": {
      "text": "Men and women so close...\\nFilthy!",
      "status": "imported"
    },
    "voice_009:r_9fcb3754cb1773c7": {
      "text": "I'll surpass myself as a woman...!",
      "status": "imported"
    },
    "voice_009:r_3559d2fad32c2435": {
      "text": "MIX, moving out!",
      "status": "imported"
    },
    "voice_009:r_f7570547e9f80a64": {
      "text": "Pure and proper - here I go!",
      "status": "imported"
    },
    "voice_009:r_cbab0f4720e1fcf1": {
      "text": "Guard down before me?\\nAre you mad?!",
      "status": "imported"
    },
    "voice_009:r_0bbe0b4f5364e732": {
      "text": "You there! Prepare yourself!",
      "status": "imported"
    },
    "voice_009:r_5dda5198137cb02a": {
      "text": "I can't overlook anything filthy!",
      "status": "imported"
    },
    "voice_009:r_83ec59afbecdec14": {
      "text": "I'll fight to fill the hole inside!",
      "status": "imported"
    },
    "voice_009:r_e20bfd42ad95a3c9": {
      "text": "I've got to repay everyone, too!",
      "status": "imported"
    },
    "voice_009:r_0f58a8822381e57f": {
      "text": "Back at last, so\\nI'll give my all!",
      "status": "imported"
    },
    "voice_009:r_6dbcc507fb61b51d": {
      "text": "I'll fill the hole in the world!",
      "status": "imported"
    },
    "voice_009:r_b42ab697149a7c8a": {
      "text": "Um, if my power would help, then...",
      "status": "imported"
    },
    "voice_009:r_4de4fcf3b440baf4": {
      "text": "I don't need a boy's support!",
      "status": "imported"
    },
    "voice_009:r_0121a166c715cdff": {
      "text": "Men and women this close? I can't!",
      "status": "imported"
    },
    "voice_009:r_30fad37a42bd3ad3": {
      "text": "Why are you telling me that...?",
      "status": "imported"
    },
    "voice_009:r_80a0b2a84e05d81a": {
      "text": "MIX, let me help you!",
      "status": "imported"
    },
    "voice_009:r_4a9ac1dff86506d9": {
      "text": "Roger! Let's do this, Amata!",
      "status": "imported"
    },
    "voice_009:r_bc8538e6af3d2577": {
      "text": "Ah...! Th-the enemy's coming...!",
      "status": "imported"
    },
    "voice_009:r_924516c8de2b5342": {
      "text": "Hey! Stop acting so nervous!",
      "status": "imported"
    },
    "voice_009:r_da1174533722333f": {
      "text": "MIX, leave the support to me!",
      "status": "imported"
    },
    "voice_009:r_fdeb8162976e72c1": {
      "text": "I'm counting on you, Mikono!",
      "status": "imported"
    },
    "voice_009:r_0fadb5c26df92b42": {
      "text": "Target acquired!",
      "status": "imported"
    },
    "voice_009:r_6b15af9a0057cdc8": {
      "text": "Then I'll punish you myself!",
      "status": "imported"
    },
    "voice_009:r_15b4a90140e8a33a": {
      "text": "Dive into the unknown with me!",
      "status": "imported"
    },
    "voice_009:r_af884a6b11dff121": {
      "text": "This noisy man\\nis on my team...?!",
      "status": "imported"
    },
    "voice_009:r_ac6fe7838e95647b": {
      "text": "MIX! I'll dig with all I've got!",
      "status": "imported"
    },
    "voice_009:r_77ca87eacd17ad52": {
      "text": "Shut up, hole-for-brains!",
      "status": "imported"
    },
    "voice_009:r_bf3244994760e535": {
      "text": "MIX!",
      "status": "imported"
    },
    "voice_009:r_aabfb21c9d069ce7": {
      "text": "OK, I know, Andy!",
      "status": "imported"
    },
    "voice_009:r_02479dc8fe989560": {
      "text": "We'll show you what we've got...!",
      "status": "imported"
    },
    "voice_009:r_a2df00f91a9b0a9e": {
      "text": "The ultimate combination!",
      "status": "imported"
    },
    "voice_009:r_48b60d6c48b9b142": {
      "text": "First, let's watch them carefully...",
      "status": "imported"
    },
    "voice_009:r_8927e6fb681aa809": {
      "text": "No time for talk! We're attacking!",
      "status": "imported"
    },
    "voice_009:r_665f01666859013b": {
      "text": "Go get 'em, hole-filling woman!",
      "status": "imported"
    },
    "voice_009:r_a571eec59b258d11": {
      "text": "I don't need you to tell me!",
      "status": "imported"
    },
    "voice_009:r_ddbe581c5ea9183d": {
      "text": "Jin!\\nI'm counting on your analysis!",
      "status": "imported"
    },
    "voice_009:r_faae935cca0edc72": {
      "text": "Leave it to me...!",
      "status": "imported"
    },
    "voice_009:r_d4430bf362340b32": {
      "text": "An opening! One more strike!",
      "status": "imported"
    },
    "voice_009:r_6ff1323b355593e0": {
      "text": "One strike may not be the end!",
      "status": "imported"
    },
    "voice_009:r_b7b5625d7cd4282f": {
      "text": "The Abductors made it this far...!",
      "status": "imported"
    },
    "voice_009:r_36133ad73a73ef98": {
      "text": "Abducting women is despicable!",
      "status": "imported"
    },
    "voice_009:r_920740a0219c5085": {
      "text": "Whatever your aim,\\nno mercy...!",
      "status": "imported"
    },
    "voice_009:r_a8451712c57c1a72": {
      "text": "That same beastlike brute...!",
      "status": "imported"
    },
    "voice_009:r_3633df5b7b8f47fa": {
      "text": "You won't take Mikono!",
      "status": "imported"
    },
    "voice_009:r_52dfc56b14b93551": {
      "text": "So that's their commander!",
      "status": "imported"
    },
    "voice_009:r_1b9b2aab5cb104da": {
      "text": "Defeat Altair's supreme leader...!",
      "status": "imported"
    },
    "voice_009:r_342044c706a2340f": {
      "text": "After all those abductions? Please!",
      "status": "imported"
    },
    "voice_009:r_cf41e8828a90cbdb": {
      "text": "A hollow heart?\\nDon't drag us in!",
      "status": "imported"
    },
    "voice_009:r_719e897304ec42d4": {
      "text": "Your defeat fills despair's hole!",
      "status": "imported"
    },
    "voice_009:r_d5e0a2317c40d322": {
      "text": "I must face men\\nfirm and resolute!",
      "status": "imported"
    },
    "voice_009:r_ec2ea17765052401": {
      "text": "Filthy...! It's filthy...!",
      "status": "imported"
    },
    "voice_009:r_f2d4255f1c2f7542": {
      "text": "H-h-h-h-how indecent!",
      "status": "imported"
    },
    "voice_009:r_5d08ad19e2da125b": {
      "text": "Th-th-th-this... Public indecency!!",
      "status": "imported"
    },
    "voice_009:r_a7246b52782a877e": {
      "text": "All we can do is resist invaders!",
      "status": "imported"
    },
    "voice_009:r_dc8701f6bcb9904f": {
      "text": "I've got psychic powers too!",
      "status": "imported"
    },
    "voice_009:r_d6bdd730f24f66eb": {
      "text": "Focus my mind and read its moves...!",
      "status": "imported"
    },
    "voice_009:r_41997412868c48c4": {
      "text": "Worthy of the Gundam name?\\nI'll see!",
      "status": "imported"
    },
    "voice_009:r_9e6cf4f389dae55c": {
      "text": "Guilty secrets mean\\nyou wear a mask!",
      "status": "imported"
    },
    "voice_009:r_9e0c80ac7e33b459": {
      "text": "War is barbarism started by men!",
      "status": "imported"
    },
    "voice_009:r_7432ef43ed3471dc": {
      "text": "Sorry, but I'll disable your unit!",
      "status": "imported"
    },
    "voice_009:r_065443f6ddfcf0d7": {
      "text": "M-monster, stay away from me!",
      "status": "imported"
    },
    "voice_009:r_47d52a2839c71715": {
      "text": "I have to defeat them here...!",
      "status": "imported"
    },
    "voice_009:r_eb7ae28b53dc033c": {
      "text": "I won't let you break through!",
      "status": "imported"
    },
    "voice_009:r_55417493fce1d347": {
      "text": "Honestly, there are far too many!",
      "status": "imported"
    },
    "voice_009:r_8fdf5910927c9591": {
      "text": "I won't let you wipe out humanity!",
      "status": "imported"
    },
    "voice_009:r_7d724dbcc4451e10": {
      "text": "I'll crush your wicked ambition!",
      "status": "imported"
    },
    "voice_009:r_93e25418a203cb8f": {
      "text": "The world's hole\\nis mine to fill!",
      "status": "imported"
    },
    "voice_009:r_adeb0a29274d3d9b": {
      "text": "I won't lose!\\nMy dear ones are here!",
      "status": "imported"
    },
    "voice_009:r_24cf161287ef9d5c": {
      "text": "Rue your dirty tricks!\\nJust wait!",
      "status": "imported"
    },
    "voice_009:r_8f60f6fc86db3107": {
      "text": "The hole between us,\\nwe'll fill it!",
      "status": "imported"
    },
    "voice_009:r_b1de76a75a253c13": {
      "text": "Submit and become rust on my blade!",
      "status": "imported"
    },
    "voice_009:r_128c35bf3e0e394c": {
      "text": "Now, let us duel honorably!",
      "status": "imported"
    },
    "voice_009:r_5213c17e13b23de0": {
      "text": "Don't underestimate me as a woman!",
      "status": "imported"
    },
    "voice_009:r_38fdff9483e9245c": {
      "text": "I'll cleave you in two!",
      "status": "imported"
    },
    "voice_009:r_381992c5d8224937": {
      "text": "Oh? You're still way back there?",
      "status": "imported"
    },
    "voice_009:r_f1e7ed9e5874aba5": {
      "text": "Too slow! You won't get away!",
      "status": "imported"
    },
    "voice_009:r_fc25e66a86fc2c85": {
      "text": "Now it's my turn!",
      "status": "imported"
    },
    "voice_009:r_5aeeb4917340c42d": {
      "text": "I won't let you disengage!",
      "status": "imported"
    },
    "voice_009:r_b765659981b6516d": {
      "text": "Targeting me was your last mistake!",
      "status": "imported"
    },
    "voice_009:r_0c427458bc00eb95": {
      "text": "Your price for scorning women!",
      "status": "imported"
    },
    "voice_009:r_774a9ab4d8fd5351": {
      "text": "I won't let this opening slip!",
      "status": "imported"
    },
    "voice_009:r_d3f01de714c015bd": {
      "text": "Efficiency matters in everything!",
      "status": "imported"
    },
    "voice_009:r_7d2617c809fead70": {
      "text": "I'll protect everyone!",
      "status": "imported"
    },
    "voice_009:r_ceb935ccbf830724": {
      "text": "Fall back while you can!",
      "status": "imported"
    },
    "voice_009:r_862ef7385bf2abd4": {
      "text": "No! I can't attack...!",
      "status": "imported"
    },
    "voice_009:r_001cbec4d9a4283f": {
      "text": "What the heck is going on here?!",
      "status": "imported"
    },
    "voice_009:r_8ad40afecd02b41e": {
      "text": "My Aura level is unstable...!",
      "status": "imported"
    },
    "voice_009:r_26e5efec03c03d78": {
      "text": "Just taking hits is humiliating...!",
      "status": "imported"
    },
    "voice_009:r_4ad81e88c7557a8b": {
      "text": "What do you mean I can't reach it?!",
      "status": "imported"
    },
    "voice_009:r_1f65a7af190e4674": {
      "text": "I lost track of the enemy...?!",
      "status": "imported"
    },
    "voice_009:r_40c5a9358ed5bf29": {
      "text": "Too slow!",
      "status": "imported"
    },
    "voice_009:r_f2e18dfdfe0c89ea": {
      "text": "That vulgar attack won't hit me!",
      "status": "imported"
    },
    "voice_009:r_cf7dbf49e96a5755": {
      "text": "Not some lust-crazed attack!",
      "status": "imported"
    },
    "voice_009:r_fa96676cc65bb509": {
      "text": "Your ulterior motive is obvious!",
      "status": "imported"
    },
    "voice_009:r_4e37f92e7d2fc62e": {
      "text": "Come back when you're ready!",
      "status": "imported"
    },
    "voice_009:r_66ab4cfe1557909d": {
      "text": "Not an attack riddled with holes!",
      "status": "imported"
    },
    "voice_009:r_0bad405ee6ca63ba": {
      "text": "Not some savage beast's attack...!",
      "status": "imported"
    },
    "voice_009:r_2072eaf71a260ae7": {
      "text": "Ugh!\\nThat man's raw desire!",
      "status": "imported"
    },
    "voice_009:r_6c13bbfd27a7799e": {
      "text": "You dodged that well, MIX!",
      "status": "imported"
    },
    "voice_009:r_06f88dcbd3c9e738": {
      "text": "That was only natural!",
      "status": "imported"
    },
    "voice_009:r_b28faf9f71bc3598": {
      "text": "Amazing, MIX...!",
      "status": "imported"
    },
    "voice_009:r_8a29278549f8e07a": {
      "text": "That's the fruit of daily training.",
      "status": "imported"
    },
    "voice_009:r_7e6c573c26177f98": {
      "text": "Not bad for a woman!",
      "status": "imported"
    },
    "voice_009:r_45abf84f7757d6eb": {
      "text": "...That sounded kind of sexist!",
      "status": "imported"
    },
    "voice_009:r_edd7a13ab8f06a14": {
      "text": "Not bad, Big Bang!",
      "status": "imported"
    },
    "voice_009:r_8165e5b41f0124c4": {
      "text": "What do you mean, hole-for-brains?!",
      "status": "imported"
    },
    "voice_009:r_4e05581b7432cce8": {
      "text": "That's it, MIX!",
      "status": "imported"
    },
    "voice_009:r_a60b107ea3c36a86": {
      "text": "All thanks to Andy's support!",
      "status": "imported"
    },
    "voice_009:r_e33693e5ba4665b0": {
      "text": "Keep that up next time!",
      "status": "imported"
    },
    "voice_009:r_72a21a1a489af001": {
      "text": "Of course! Leave it to me!",
      "status": "imported"
    },
    "voice_009:r_eb643f8bf737a0ca": {
      "text": "So you found a gap in its attack...",
      "status": "imported"
    },
    "voice_009:r_0a3fccb71ec6cf2a": {
      "text": "Yep. Finding holes is my specialty.",
      "status": "imported"
    },
    "voice_009:r_9b63cf1f3e0207ef": {
      "text": "Your analysis is actually useful!",
      "status": "imported"
    },
    "voice_009:r_8356f4e3dcdff938": {
      "text": "Why, thank you.",
      "status": "imported"
    },
    "voice_009:r_1d6d784036ae0bd7": {
      "text": "That won't work on me!",
      "status": "imported"
    },
    "voice_009:r_625664af02183c17": {
      "text": "Pointless!",
      "status": "imported"
    },
    "voice_009:r_3701cba361f80ea5": {
      "text": "I'll defend a maiden's purity!",
      "status": "imported"
    },
    "voice_009:r_4824bea6bab3af67": {
      "text": "Barriers are absolutely\\nessential!",
      "status": "imported"
    },
    "voice_009:r_862b92e63adb9734": {
      "text": "If I block it with the shield...!",
      "status": "imported"
    },
    "voice_009:r_cb306ef55e49d107": {
      "text": "The Spada has a shield!",
      "status": "imported"
    },
    "voice_009:r_57b2bd2de8a1408d": {
      "text": "I won't flinch from this!",
      "status": "imported"
    },
    "voice_009:r_76f080a4881e8ab5": {
      "text": "What humiliation...!",
      "status": "imported"
    },
    "voice_009:r_288133bc5b573dae": {
      "text": "I let it touch me...!",
      "status": "imported"
    },
    "voice_009:r_6f95653e548f8fcf": {
      "text": "What a vulgar attack!",
      "status": "imported"
    },
    "voice_009:r_d249d68bada91ab9": {
      "text": "Disgusting! Don't touch me!",
      "status": "imported"
    },
    "voice_009:r_e9b3307e9eb69f11": {
      "text": "Ah...!\\nI sullied Aquarion myself...",
      "status": "imported"
    },
    "voice_009:r_03cdac73042343ee": {
      "text": "Don't let its movements confuse you!",
      "status": "imported"
    },
    "voice_009:r_6026da5acbda7c69": {
      "text": "Why would I listen to a man?!",
      "status": "imported"
    },
    "voice_009:r_981f8fedd5414fe5": {
      "text": "MIX! Your timing was a step late!",
      "status": "imported"
    },
    "voice_009:r_96bb0dcde0c8c44a": {
      "text": "Roger! I'll watch it next time!",
      "status": "imported"
    },
    "voice_009:r_641550a2f54cb456": {
      "text": "Eeeek!",
      "status": "imported"
    },
    "voice_009:r_a0f2074af8debbfa": {
      "text": "Don't shriek over so little!",
      "status": "imported"
    },
    "voice_009:r_b5f5a97ed82acb0b": {
      "text": "Mikono, are you all right?",
      "status": "imported"
    },
    "voice_009:r_d9cd2e4ded064396": {
      "text": "Yeah. It just startled me a little.",
      "status": "imported"
    },
    "voice_009:r_99e6349431aaf23b": {
      "text": "Grrr!\\nThat hit was a disgrace!",
      "status": "imported"
    },
    "voice_009:r_ec1081caf845f56a": {
      "text": "I get it, so calm down, MIX.",
      "status": "imported"
    },
    "voice_009:r_2c5b7ee872c1ed7f": {
      "text": "Hey, boys! Don't drag us down!",
      "status": "imported"
    },
    "voice_009:r_76d1e51c8b494a60": {
      "text": "How is this my fault?!",
      "status": "imported"
    },
    "voice_009:r_eb5f687fcd372ae7": {
      "text": "Sorry, Andy! Are you okay?!",
      "status": "imported"
    },
    "voice_009:r_2329428a6871d9fa": {
      "text": "Your loss hurt more.\\nThis? Nothing!",
      "status": "imported"
    },
    "voice_009:r_0e7466971bec4cc4": {
      "text": "That was just a simple feint!",
      "status": "imported"
    },
    "voice_009:r_efa71f7a4cc33ff3": {
      "text": "What? Don't nitpick, you're a man!",
      "status": "imported"
    },
    "voice_009:r_3fc2e1186557e7a0": {
      "text": "Has your nose gone dull or what?!",
      "status": "imported"
    },
    "voice_009:r_fa6930340a545054": {
      "text": "You're the only one who senses that!",
      "status": "imported"
    },
    "voice_009:r_2332b9d56461d7ab": {
      "text": "Huh. So that actually hit you...",
      "status": "imported"
    },
    "voice_009:r_854aa0a91a3c80d1": {
      "text": "I-I was testing it! Just testing!",
      "status": "imported"
    },
    "voice_009:r_2b4d8818c77b6dca": {
      "text": "Ugh...!",
      "status": "imported"
    },
    "voice_009:r_087354f2db0a31e6": {
      "text": "Any more would be dangerous...!",
      "status": "imported"
    },
    "voice_009:r_db02a2dec93dd263": {
      "text": "This is bad...! I keep messing up!",
      "status": "imported"
    },
    "voice_009:r_d520c6d5298a848d": {
      "text": "Such lewd tactics are unforgivable!",
      "status": "imported"
    },
    "voice_009:r_099e2458cabf796f": {
      "text": "The shield level is dropping...?!",
      "status": "imported"
    },
    "voice_009:r_fd910d714be70870": {
      "text": "My iron guard,\\nbroken like that...!",
      "status": "imported"
    },
    "voice_009:r_9736f29b11344ec3": {
      "text": "N-no! Me, taken by some beast...!",
      "status": "imported"
    },
    "voice_009:r_fcd05582aa5c6068": {
      "text": "No mercy!\\nI'll wipe out every stray!",
      "status": "imported"
    },
    "voice_009:r_bece29562818acba": {
      "text": "I'm still okay, but any more...!",
      "status": "imported"
    },
    "voice_009:r_494b5da92ed24ecb": {
      "text": "Don't tell me what I already know!",
      "status": "imported"
    },
    "voice_009:r_a4a5a96f4bd58920": {
      "text": "MIX! You can't take any more...!",
      "status": "imported"
    },
    "voice_009:r_b57d2d74233f889a": {
      "text": "Sorry! I'll dodge next time...!",
      "status": "imported"
    },
    "voice_009:r_cd06d0820d82524b": {
      "text": "Why didn't you call its position?!",
      "status": "imported"
    },
    "voice_009:r_c94c6d04be583774": {
      "text": "I-I'm sorry!",
      "status": "imported"
    },
    "voice_009:r_e54e2c99ef8297af": {
      "text": "Sorry, MIX! My support was too late!",
      "status": "imported"
    },
    "voice_009:r_f16a3eb0bcaac082": {
      "text": "It's fine! That was my fault!",
      "status": "imported"
    },
    "voice_009:r_10a408809e512df1": {
      "text": "Such a filthy attack... I shudder!",
      "status": "imported"
    },
    "voice_009:r_bc7b9e308b879dd4": {
      "text": "What exactly is a filthy attack...?",
      "status": "imported"
    },
    "voice_009:r_98902fd3143c393e": {
      "text": "Panicking won't help you!\\nCalm down!",
      "status": "imported"
    },
    "voice_009:r_d907fbd7bc1c4298": {
      "text": "Shut up! Don't order me around!",
      "status": "imported"
    },
    "voice_009:r_96b21e3a028dd074": {
      "text": "Andy!!",
      "status": "imported"
    },
    "voice_009:r_ce140b5d8e6b7310": {
      "text": "Don't worry about me.\\nFocus!",
      "status": "imported"
    },
    "voice_009:r_0e0335789c5396d7": {
      "text": "Were you spacing out or something?",
      "status": "imported"
    },
    "voice_009:r_a8e85bd950696403": {
      "text": "No! The enemy just outplayed me!",
      "status": "imported"
    },
    "voice_009:r_772c8bc40ab6cb61": {
      "text": "That all you've got, hole-filler?!",
      "status": "imported"
    },
    "voice_009:r_58dd2826a199ef51": {
      "text": "No! I'm only getting started!",
      "status": "imported"
    },
    "voice_009:r_aadc0b2442adb93b": {
      "text": "Want me to switch in as Head?",
      "status": "imported"
    },
    "voice_009:r_e7a8cd8ed5bc2d1b": {
      "text": "No need! I'll defeat that one!",
      "status": "imported"
    },
    "voice_009:r_ec349c8ea9511a18": {
      "text": "Aaaaaah!",
      "status": "imported"
    },
    "voice_009:r_33236ffa3ea95b68": {
      "text": "Ahh, what a nightmare...!",
      "status": "imported"
    },
    "voice_009:r_689d0b123de71ae0": {
      "text": "No...! Nooooooo!",
      "status": "imported"
    },
    "voice_009:r_84883aa95f63ce32": {
      "text": "They've driven me this far...!",
      "status": "imported"
    },
    "voice_009:r_25493e978ce8ff16": {
      "text": "Though reckless,\\nI can't flee...!",
      "status": "imported"
    },
    "voice_009:r_7316666150e42960": {
      "text": "I can't lose...!\\nFor my pride!",
      "status": "imported"
    },
    "voice_009:r_c4f11aa93dc5b668": {
      "text": "All pilots, switch! Girls only now!",
      "status": "imported"
    },
    "voice_009:r_ce1a22dfe3a4d339": {
      "text": "What? I-I can't take any more!",
      "status": "imported"
    },
    "voice_009:r_240651adab81e145": {
      "text": "Amata, sorry, but...",
      "status": "imported"
    },
    "voice_009:r_cff0deaae73c2858": {
      "text": "It's fine. I've always been ready!",
      "status": "imported"
    },
    "voice_009:r_dca67f68a573fab7": {
      "text": "I've had enough! Let me off...!",
      "status": "imported"
    },
    "voice_009:r_a6630215fefaf294": {
      "text": "Is that all the resolve you had?!",
      "status": "imported"
    },
    "voice_009:r_6f94566ad37f8ff8": {
      "text": "Shield level falling! Still...!",
      "status": "imported"
    },
    "voice_009:r_942ca03c9de80143": {
      "text": "Right, I can still fight!",
      "status": "imported"
    },
    "voice_009:r_d8c669c70659e18a": {
      "text": "I can't lose...! For everyone...!",
      "status": "imported"
    },
    "voice_009:r_8f5bade7ac2db78e": {
      "text": "Right! At least don't lose heart!",
      "status": "imported"
    },
    "voice_009:r_05ea490d2f522520": {
      "text": "Now's when we need a hole, right?!",
      "status": "imported"
    },
    "voice_009:r_f5658c702d91db7a": {
      "text": "That's enough fooling around!",
      "status": "imported"
    },
    "voice_009:r_686df329b50f195b": {
      "text": "I'm with you, MIX! So don't...!",
      "status": "imported"
    },
    "voice_009:r_25f0ab0fa3cf690c": {
      "text": "I know, Andy!\\nI won't give up!",
      "status": "imported"
    },
    "voice_009:r_b708a1d959013dbf": {
      "text": "We should fall back for now!",
      "status": "imported"
    },
    "voice_009:r_59fca03e929366c1": {
      "text": "How pathetic...! Men, honestly...",
      "status": "imported"
    },
    "voice_009:r_0d65eb631dcb7514": {
      "text": "Everyone, lend me all your power!",
      "status": "imported"
    },
    "voice_009:r_d03018a31e23f1e9": {
      "text": "Yeah, take it all, hole-filler!",
      "status": "imported"
    },
    "voice_009:r_279da5f732aa8847": {
      "text": "This happened because of me...!",
      "status": "imported"
    },
    "voice_009:r_97f82e3cb6f70110": {
      "text": "No time to apologize.\\nLet's fix it.",
      "status": "imported"
    },
    "voice_009:r_c5611d8dd6def96b": {
      "text": "Ugh! I messed up...!",
      "status": "imported"
    },
    "voice_009:r_6f12cc8ed2732eb5": {
      "text": "N-no! Nooooooo!!",
      "status": "imported"
    },
    "voice_009:r_7abfc55f8fb62ba7": {
      "text": "I sealed Andy and his evil space!",
      "status": "imported"
    },
    "voice_009:r_99e7a66c650b5892": {
      "text": "No silly hole-digging. Rest well.",
      "status": "imported"
    },
    "voice_009:r_5b2247b5cfbcd7b2": {
      "text": "For the soul of Andy, who fell...!",
      "status": "imported"
    },
    "voice_009:r_2d7a9c06347582d9": {
      "text": "No way. Does that mean...?",
      "status": "imported"
    },
    "voice_009:r_bf953d64c3c7d9b7": {
      "text": "Spatial Filling!",
      "status": "imported"
    },
    "voice_009:r_9639a2dbcd2f58ed": {
      "text": "Amata, Zessica...!\\nLend me power!",
      "status": "imported"
    },
    "voice_009:r_aeea0893acb93d35": {
      "text": "Got it!",
      "status": "imported"
    },
    "voice_009:r_b31568654e53487b": {
      "text": "Let's do this, Shrade!",
      "status": "imported"
    },
    "voice_009:r_2502132569141ea3": {
      "text": "Here goes! Soul Arpeggio!",
      "status": "imported"
    },
    "voice_009:r_1ff312798a52c8eb": {
      "text": "Sky: vibrato.\\nSea: allegro vivace...",
      "status": "imported"
    },
    "voice_009:r_fa07d90fca62f593": {
      "text": "The human moon sings life\\nagitato!",
      "status": "imported"
    },
    "voice_009:r_a25bf2676ecf9d83": {
      "text": "Moonlight Requiem!",
      "status": "imported"
    },
    "voice_009:r_237a0288b42dce20": {
      "text": "My life...! I'll play with the moon!",
      "status": "imported"
    },
    "voice_009:r_11517cc7b0494dbf": {
      "text": "Haaaaah!",
      "status": "imported"
    },
    "voice_009:r_b5864501463db244": {
      "text": "My soul and life ring in moonlight!",
      "status": "imported"
    },
    "voice_009:r_a88939ea84b4474d": {
      "text": "Resound, Moonlight Requiem!",
      "status": "imported"
    },
    "voice_009:r_a870d0cf7cc11ec6": {
      "text": "This is the finale!",
      "status": "imported"
    },
    "voice_009:r_03f6158ef83964f3": {
      "text": "No... My bare skin is sensitive...!",
      "status": "imported"
    },
    "voice_009:r_2970a83693cdcc25": {
      "text": "Every last bit of my body...!",
      "status": "imported"
    },
    "voice_009:r_be661448b85d0009": {
      "text": "It's so stimulatinggg!",
      "status": "imported"
    },
    "voice_009:r_958a56c1151cab9e": {
      "text": "Uoooooh!",
      "status": "imported"
    },
    "voice_009:r_8b18aa4cc69547df": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_009:r_3e87f6fc3ea65aef": {
      "text": "No Guard!",
      "status": "imported"
    },
    "voice_009:r_5508a7bfa9074eb9": {
      "text": "Attaaack!!",
      "status": "imported"
    },
    "voice_009:r_09a003e91f0d5dc7": {
      "text": "Embarrassing, but it feels so good!",
      "status": "imported"
    },
    "voice_009:r_192447448ebd7bb5": {
      "text": "My whole body's burning up!",
      "status": "imported"
    },
    "voice_009:r_e92920ba4b301b9f": {
      "text": "I-it's embarrassing, but...!",
      "status": "imported"
    },
    "voice_009:r_207b256d613bb896": {
      "text": "This somehow feels so good!",
      "status": "imported"
    },
    "voice_009:r_a6fd676d8146501b": {
      "text": "Haaaaah!",
      "status": "imported"
    },
    "voice_009:r_94d35e5fa8e3a198": {
      "text": "Scorch the skin and sever the flesh!",
      "status": "imported"
    },
    "voice_009:r_25f9b1e39dd8d366": {
      "text": "We did it, Amata! Mikono!",
      "status": "imported"
    },
    "voice_009:r_307477bedd148060": {
      "text": "M-my shame, and...!",
      "status": "imported"
    },
    "voice_009:r_09a780acca0eb4b0": {
      "text": "A sense of release...!",
      "status": "imported"
    },
    "voice_009:r_af62f2ee466b5c8c": {
      "text": "Their fierce struggle!",
      "status": "imported"
    },
    "voice_009:r_727b2ee0277f9159": {
      "text": "Ah... My heart won't stop racing...!",
      "status": "imported"
    },
    "voice_009:r_cff4d2eae8a939ed": {
      "text": "The fastest toccata -\\nI'll pluck it!",
      "status": "imported"
    },
    "voice_009:r_1428fe5f35a9427b": {
      "text": "The moon plays for us tonight...!",
      "status": "imported"
    },
    "voice_009:r_96d39b8bdfa6f183": {
      "text": "Moonlight Rhapsody!",
      "status": "imported"
    },
    "voice_009:r_0e4f9b8a2d26ebff": {
      "text": "Those bewitched by the fair moon...!",
      "status": "imported"
    },
    "voice_009:r_79e0d542fe12bcf7": {
      "text": "Lose yourself in my melody...!",
      "status": "imported"
    },
    "voice_009:r_eff747ba39a55393": {
      "text": "Moonlight Rhapsody!",
      "status": "imported"
    },
    "voice_009:r_b2dc77aa6dd77e69": {
      "text": "I feel my friend's soul so near...!",
      "status": "imported"
    },
    "voice_009:r_445d40d8b5d7092b": {
      "text": "Come fight beside me, Cayenne!",
      "status": "imported"
    },
    "voice_009:r_bbb633cb5e8e6daf": {
      "text": "Let's go, my friend!",
      "status": "imported"
    },
    "voice_009:r_0abd8b6c713ccdac": {
      "text": "I dedicate this to my friend!",
      "status": "imported"
    },
    "voice_009:r_f4ff463b2fda1b86": {
      "text": "Trinity Requiem!!",
      "status": "imported"
    },
    "voice_009:r_4e63c037d3cb8a3d": {
      "text": "Time to play the ultimate melody...!",
      "status": "imported"
    },
    "voice_009:r_9ca8d188ae805e3a": {
      "text": "Will you play with me, Cayenne?",
      "status": "imported"
    },
    "voice_009:r_795ed21f3e28e1f5": {
      "text": "Of course, my friend.",
      "status": "imported"
    },
    "voice_009:r_141415c1def5ab2d": {
      "text": "I'll play with my friend!",
      "status": "imported"
    },
    "voice_009:r_c894e35becf35a03": {
      "text": "Trinity Requiem!!",
      "status": "imported"
    },
    "voice_009:r_79b1abf5fc86483c": {
      "text": "From me...\\nfrom us, a new sound!",
      "status": "imported"
    },
    "voice_009:r_e9a11621911acb19": {
      "text": "This is... what Shrade longed for!",
      "status": "imported"
    },
    "voice_009:r_d52bece55796f599": {
      "text": "Yes! The ultimate melody!",
      "status": "imported"
    },
    "voice_009:r_358fe5a50bbee1df": {
      "text": "Spada and Gepard's power as one...!",
      "status": "imported"
    },
    "voice_009:r_638834e16724002f": {
      "text": "Trinity Requiem!!",
      "status": "imported"
    },
    "voice_009:r_b02fca1590ac1210": {
      "text": "I'll seal your movements...!",
      "status": "imported"
    },
    "voice_009:r_f0344d2fbaa9db77": {
      "text": "Now, repent of your sins!",
      "status": "imported"
    },
    "voice_009:r_3328eef766ff2c2c": {
      "text": "Crucifixion Sword!",
      "status": "imported"
    },
    "voice_009:r_23b037cf6ccc695c": {
      "text": "It's time to confess your sins...!",
      "status": "imported"
    },
    "voice_009:r_883ad1128d340c5e": {
      "text": "Forte Fortissimo!",
      "status": "imported"
    },
    "voice_009:r_a9e6ed99025a703b": {
      "text": "Crucifixion Sword!",
      "status": "imported"
    },
    "voice_009:r_69d009696527fa68": {
      "text": "Yes!",
      "status": "imported"
    },
    "voice_009:r_aeb9079d86e2a924": {
      "text": "My memories as a woman return...!",
      "status": "imported"
    },
    "voice_009:r_bc4658630f8e40a9": {
      "text": "And always there was... Andy...!",
      "status": "imported"
    },
    "voice_009:r_92816afa2ba8a8c9": {
      "text": "Spatial Filling!",
      "status": "imported"
    },
    "voice_009:r_a29f58ecde5f7ddd": {
      "text": "I'll go on ahead!",
      "status": "imported"
    },
    "voice_009:r_4069f7e9517c47e8": {
      "text": "So I just draw their attention...!",
      "status": "imported"
    },
    "voice_009:r_2835a8af1c41be9b": {
      "text": "I can at least hold them back!",
      "status": "imported"
    },
    "voice_009:r_cd84325a7c1a820f": {
      "text": "I'll provide support!",
      "status": "imported"
    },
    "voice_009:r_0465f74c0488ad70": {
      "text": "Target confirmed!",
      "status": "imported"
    },
    "voice_009:r_a30c8238b5208470": {
      "text": "So that's my enemy!",
      "status": "imported"
    },
    "voice_009:r_64bf1c63c7c1ebdd": {
      "text": "I have to live up to expectations!",
      "status": "imported"
    },
    "voice_009:r_f6d5042f671118fa": {
      "text": "Let's both give it our best!",
      "status": "imported"
    }
  }
}
