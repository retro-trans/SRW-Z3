{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_061:r_479b340ccc6c572b": {
      "text": "All we can do is charge!",
      "status": "imported"
    },
    "voice_061:r_ca4acbac57a2a35e": {
      "text": "I'm gonna hit 'em with all I've got!",
      "status": "imported"
    },
    "voice_061:r_77949221bf58f862": {
      "text": "A road's what forms\\nafter I pass!",
      "status": "imported"
    },
    "voice_061:r_70b9c4b9f1f37eff": {
      "text": "King Kittan! Uh, reporting in!",
      "status": "imported"
    },
    "voice_061:r_9fcb3754cb1773c7": {
      "text": "Charge! King Kittan!!",
      "status": "imported"
    },
    "voice_061:r_3559d2fad32c2435": {
      "text": "Dai-Gurren's attack chief!\\nKittan!",
      "status": "imported"
    },
    "voice_061:r_f7570547e9f80a64": {
      "text": "I'm still not stopping!",
      "status": "imported"
    },
    "voice_061:r_cbab0f4720e1fcf1": {
      "text": "If one shot won't do, try two!",
      "status": "imported"
    },
    "voice_061:r_0bbe0b4f5364e732": {
      "text": "A beast - a Mechanical Beast!?",
      "status": "imported"
    },
    "voice_061:r_5dda5198137cb02a": {
      "text": "Makes no sense? I'll crush it!",
      "status": "imported"
    },
    "voice_061:r_83ec59afbecdec14": {
      "text": "Enemy boss!?\\nKittan will wreck you!",
      "status": "imported"
    },
    "voice_061:r_0f58a8822381e57f": {
      "text": "Hmph!",
      "status": "imported"
    },
    "voice_061:r_b42ab697149a7c8a": {
      "text": "Hrah!",
      "status": "imported"
    },
    "voice_061:r_0121a166c715cdff": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_061:r_80a0b2a84e05d81a": {
      "text": "Heave-ho!",
      "status": "imported"
    },
    "voice_061:r_ac6fe7838e95647b": {
      "text": "Counterattack! Begin!!",
      "status": "imported"
    },
    "voice_061:r_77ca87eacd17ad52": {
      "text": "You really went and did it now!",
      "status": "imported"
    },
    "voice_061:r_bf3244994760e535": {
      "text": "You bastard! Don't you run away!",
      "status": "imported"
    },
    "voice_061:r_aabfb21c9d069ce7": {
      "text": "You reckless bastard!",
      "status": "imported"
    },
    "voice_061:r_02479dc8fe989560": {
      "text": "Payback time!\\nHope you're ready!?",
      "status": "imported"
    },
    "voice_061:r_a2df00f91a9b0a9e": {
      "text": "Pick a fight,\\nI'll gladly take it!",
      "status": "imported"
    },
    "voice_061:r_48b60d6c48b9b142": {
      "text": "I'll beat down the rest!",
      "status": "imported"
    },
    "voice_061:r_8927e6fb681aa809": {
      "text": "A fight breaks out? Kittan's there!",
      "status": "imported"
    },
    "voice_061:r_665f01666859013b": {
      "text": "Simon came this far!\\nSo can I!",
      "status": "imported"
    },
    "voice_061:r_a571eec59b258d11": {
      "text": "Watch me, Yoko!\\nKittan's big moment!",
      "status": "imported"
    },
    "voice_061:r_ddbe581c5ea9183d": {
      "text": "This is Dai-Gurren's Combo Attack!",
      "status": "imported"
    },
    "voice_061:r_faae935cca0edc72": {
      "text": "I'll save you! You owe me one!",
      "status": "imported"
    },
    "voice_061:r_d4430bf362340b32": {
      "text": "Wait, wait, wait up!",
      "status": "imported"
    },
    "voice_061:r_6ff1323b355593e0": {
      "text": "Simon! I've got your back!",
      "status": "imported"
    },
    "voice_061:r_b7b5625d7cd4282f": {
      "text": "Yoko! I'm coming to save you!",
      "status": "imported"
    },
    "voice_061:r_36133ad73a73ef98": {
      "text": "Dai-Gurren's bond!\\nDon't dismiss us!",
      "status": "imported"
    },
    "voice_061:r_920740a0219c5085": {
      "text": "What was that!? You little punk!",
      "status": "imported"
    },
    "voice_061:r_a8451712c57c1a72": {
      "text": "Heh, you got lucky! Got that!?",
      "status": "imported"
    },
    "voice_061:r_3633df5b7b8f47fa": {
      "text": "The battery's dead!? Seriously!?",
      "status": "imported"
    },
    "voice_061:r_52dfc56b14b93551": {
      "text": "Tch! You chicken!",
      "status": "imported"
    },
    "voice_061:r_1b9b2aab5cb104da": {
      "text": "C'mon!\\nCome fight me - fight me!",
      "status": "imported"
    },
    "voice_061:r_342044c706a2340f": {
      "text": "Heh heh heh! This is way too easy!",
      "status": "imported"
    },
    "voice_061:r_cf41e8828a90cbdb": {
      "text": "You fooool! Over here, over here!",
      "status": "imported"
    },
    "voice_061:r_719e897304ec42d4": {
      "text": "Whoa! You've got some wicked aim!",
      "status": "imported"
    },
    "voice_061:r_d5e0a2317c40d322": {
      "text": "See that!? This is King Kittan!",
      "status": "imported"
    },
    "voice_061:r_ec2ea17765052401": {
      "text": "This?\\nIt's a piece of cake to dodge!",
      "status": "imported"
    },
    "voice_061:r_f2d4255f1c2f7542": {
      "text": "Kiiing Kittan! Barrier!!",
      "status": "imported"
    },
    "voice_061:r_5d08ad19e2da125b": {
      "text": "Like that'll work!",
      "status": "imported"
    },
    "voice_061:r_d6bdd730f24f66eb": {
      "text": "Oh yeah? That tickles!",
      "status": "imported"
    },
    "voice_061:r_41997412868c48c4": {
      "text": "I'm not pointy just for show!",
      "status": "imported"
    },
    "voice_061:r_9e6cf4f389dae55c": {
      "text": "See how tough King Kittan is!?",
      "status": "imported"
    },
    "voice_061:r_9e0c80ac7e33b459": {
      "text": "I don't sweat tiny scratches!",
      "status": "imported"
    },
    "voice_061:r_7432ef43ed3471dc": {
      "text": "Tch! I botched the controls!",
      "status": "imported"
    },
    "voice_061:r_065443f6ddfcf0d7": {
      "text": "Quit it! I don't pick on the weak!",
      "status": "imported"
    },
    "voice_061:r_47d52a2839c71715": {
      "text": "Still not dooone!",
      "status": "imported"
    },
    "voice_061:r_847f82e7f3eef651": {
      "text": "What the hell is this thing!?",
      "status": "imported"
    },
    "voice_061:r_eb7ae28b53dc033c": {
      "text": "With grit,\\nit doesn't hurt one bit!",
      "status": "imported"
    },
    "voice_061:r_857c4a52ce8df0fd": {
      "text": "What an irritating bastard!",
      "status": "imported"
    },
    "voice_061:r_55417493fce1d347": {
      "text": "Ngh! I'll beat you to a pulp!",
      "status": "imported"
    },
    "voice_061:r_8fdf5910927c9591": {
      "text": "Hey!\\nKeep this up and I'll kill you!",
      "status": "imported"
    },
    "voice_061:r_7d724dbcc4451e10": {
      "text": "Goddammit! What the hell is this!?",
      "status": "imported"
    },
    "voice_061:r_93e25418a203cb8f": {
      "text": "Not yet! I'll win this fight!",
      "status": "imported"
    },
    "voice_061:r_adeb0a29274d3d9b": {
      "text": "Waaaaah!\\nYou goddamn bastard!!",
      "status": "imported"
    },
    "voice_061:r_24cf161287ef9d5c": {
      "text": "Dai-Gurren's true grit!\\nWatch!!",
      "status": "imported"
    },
    "voice_061:r_8f60f6fc86db3107": {
      "text": "Heh...!\\nMy flaw? I never give up!",
      "status": "imported"
    },
    "voice_061:r_b1de76a75a253c13": {
      "text": "Y-you'll pay for this!!",
      "status": "imported"
    },
    "voice_061:r_128c35bf3e0e394c": {
      "text": "No way!?\\nKing Kittan's been...!?",
      "status": "imported"
    },
    "voice_061:r_9680dcd0fddcfcc7": {
      "text": "You've had your fun!\\nFaceless freak!",
      "status": "imported"
    },
    "voice_061:r_2a00f1044ad5cbaa": {
      "text": "Anti? Mince? Bah!\\nI'll crush you!",
      "status": "imported"
    },
    "voice_061:r_46e86d000250e137": {
      "text": "I can't let my brother-in-law die!",
      "status": "imported"
    },
    "voice_061:r_ac341e7976e88f0b": {
      "text": "Heh! Your aim's way too sloppy!",
      "status": "imported"
    },
    "voice_061:r_cdbd128a5b4127cc": {
      "text": "That all you got, faceless freak!?",
      "status": "imported"
    },
    "voice_061:r_cfccaa1fbeda124c": {
      "text": "No face -\\nhard to read your moves!",
      "status": "imported"
    },
    "voice_061:r_b1f8ec192b9c083a": {
      "text": "Faceless wins?\\nGunmen are shamed!!",
      "status": "imported"
    },
    "voice_061:r_de1213040856c089": {
      "text": "Underground grit!\\nDon't mock it!",
      "status": "imported"
    },
    "voice_061:r_3304412ac41f47a6": {
      "text": "Great pilot, me! Yeah, yeah...!",
      "status": "imported"
    },
    "voice_061:r_0c0775e051211840": {
      "text": "Now you're my brother!\\nSync with me!",
      "status": "imported"
    },
    "voice_061:r_a2afffe1c396f0b3": {
      "text": "Space King Kittan!\\nI'll smash you!!",
      "status": "imported"
    },
    "voice_061:r_42ba1ecb310b4bd7": {
      "text": "Gurren Lagann drill!\\nLet me use it!!",
      "status": "imported"
    },
    "voice_061:r_d692f1d420460a47": {
      "text": "Take thiiis!",
      "status": "imported"
    },
    "voice_061:r_a5643cec86b18bd2": {
      "text": "King Kittan!!!",
      "status": "imported"
    },
    "voice_061:r_68f2dfab20a4a30e": {
      "text": "Giga Drill Break!!",
      "status": "imported"
    },
    "voice_061:r_9cedad8237480563": {
      "text": "My soul's drill!\\nNow taste it!!",
      "status": "imported"
    },
    "voice_061:r_a03fabecba1508ca": {
      "text": "Goooo!!",
      "status": "imported"
    },
    "voice_061:r_5391b24a71eb10ae": {
      "text": "King Kittan Finisher!",
      "status": "imported"
    },
    "voice_061:r_a554ceef5c87b972": {
      "text": "Giga Drill Break!!",
      "status": "imported"
    },
    "voice_061:r_546c3d5937fbb7ee": {
      "text": "Time for my ace in the hole!",
      "status": "imported"
    },
    "voice_061:r_1568ff6298b12b96": {
      "text": "Space Kittan Beam!!",
      "status": "imported"
    },
    "voice_061:r_2c9d94ba13c5fc50": {
      "text": "No more talk! I'm firing!",
      "status": "imported"
    },
    "voice_061:r_428c2116ac3071b1": {
      "text": "Ranged isn't my style, but oh well!",
      "status": "imported"
    },
    "voice_061:r_dad38ee29af2df3a": {
      "text": "I can fight at any range now!",
      "status": "imported"
    },
    "voice_061:r_69dfa1659715e2fa": {
      "text": "I'll send you flying!!",
      "status": "imported"
    },
    "voice_061:r_8ab47a28f99ef565": {
      "text": "Hrah! Hrah hrah hrah hraah!!",
      "status": "imported"
    },
    "voice_061:r_546de3fb6db156ea": {
      "text": "Behold!\\nSpace King Kittan's speed!",
      "status": "imported"
    },
    "voice_061:r_ca85f87cee5e31f7": {
      "text": "This is the powered-up\\nKing Kittan!",
      "status": "imported"
    },
    "voice_061:r_9072ea7bc71df136": {
      "text": "Space King Kittan\\ngets serious now!",
      "status": "imported"
    },
    "voice_061:r_04e815a8d425827d": {
      "text": "Not yet!\\nSpace King Kittan lives!",
      "status": "imported"
    },
    "voice_061:r_d89011fe3e5d082a": {
      "text": "Taste King Kittan's Giga Drill Break",
      "status": "imported"
    },
    "voice_061:r_3c5b0c2ac812d5de": {
      "text": "Spiral Power, huh...\\nNot bad. Heh...",
      "status": "imported"
    },
    "voice_061:r_5b9e8897190892eb": {
      "text": "Let's match our pace and move!",
      "status": "imported"
    },
    "voice_061:r_7bea3023abbf8a94": {
      "text": "This works once in a while!",
      "status": "imported"
    },
    "voice_061:r_dd01a4c0d1b36a8d": {
      "text": "All right! I'm itching for a fight!",
      "status": "imported"
    },
    "voice_061:r_20920ad2eb3542db": {
      "text": "All right, fine! I'll help you out!",
      "status": "imported"
    },
    "voice_061:r_0ab7914877fd48ed": {
      "text": "All right! That's the one!",
      "status": "imported"
    },
    "voice_061:r_cb846feec748c2e3": {
      "text": "One-on-one? Just what I wanted!",
      "status": "imported"
    },
    "voice_061:r_c958860b0676b1f5": {
      "text": "All right! Leave it to me!",
      "status": "imported"
    },
    "voice_061:r_5e2669b82ef75ce3": {
      "text": "Roger! Let's make it flashy!",
      "status": "imported"
    }
  }
}
