{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_064:r_479b340ccc6c572b": {
      "text": "I've made my choice, too!",
      "status": "imported"
    },
    "voice_064:r_ca4acbac57a2a35e": {
      "text": "I have to stop this fighting now!",
      "status": "imported"
    },
    "voice_064:r_77949221bf58f862": {
      "text": "Because this is what I can do now!",
      "status": "imported"
    },
    "voice_064:r_70b9c4b9f1f37eff": {
      "text": "Right now, I'll do what I can!",
      "status": "imported"
    },
    "voice_064:r_9fcb3754cb1773c7": {
      "text": "I'll use this power to end the war!",
      "status": "imported"
    },
    "voice_064:r_3559d2fad32c2435": {
      "text": "I'll do what I can and what I want!",
      "status": "imported"
    },
    "voice_064:r_f7570547e9f80a64": {
      "text": "I have to fight to protect them!",
      "status": "imported"
    },
    "voice_064:r_cbab0f4720e1fcf1": {
      "text": "I have to do this!",
      "status": "imported"
    },
    "voice_064:r_0bbe0b4f5364e732": {
      "text": "I won't let hope die! Not now!",
      "status": "imported"
    },
    "voice_064:r_5dda5198137cb02a": {
      "text": "There!!",
      "status": "imported"
    },
    "voice_064:r_83ec59afbecdec14": {
      "text": "This should do!",
      "status": "imported"
    },
    "voice_064:r_e20bfd42ad95a3c9": {
      "text": "Target... locked!",
      "status": "imported"
    },
    "voice_064:r_0f58a8822381e57f": {
      "text": "Range calculated... Good!",
      "status": "imported"
    },
    "voice_064:r_6dbcc507fb61b51d": {
      "text": "Before they get out of range!",
      "status": "imported"
    },
    "voice_064:r_b42ab697149a7c8a": {
      "text": "I'll attack again!",
      "status": "imported"
    },
    "voice_064:r_4de4fcf3b440baf4": {
      "text": "Not just will... or just power...",
      "status": "imported"
    },
    "voice_064:r_0121a166c715cdff": {
      "text": "I'll finish this!!",
      "status": "imported"
    },
    "voice_064:r_30fad37a42bd3ad3": {
      "text": "Target confirmed. Multi-lock...",
      "status": "imported"
    },
    "voice_064:r_80a0b2a84e05d81a": {
      "text": "Goooo!!",
      "status": "imported"
    },
    "voice_064:r_4a9ac1dff86506d9": {
      "text": "To end this war... I have to...!",
      "status": "imported"
    },
    "voice_064:r_bc8538e6af3d2577": {
      "text": "With this power!",
      "status": "imported"
    },
    "voice_064:r_924516c8de2b5342": {
      "text": "I won't go down without a fight...!",
      "status": "imported"
    },
    "voice_064:r_da1174533722333f": {
      "text": "If you're going to attack...!",
      "status": "imported"
    },
    "voice_064:r_fdeb8162976e72c1": {
      "text": "I can't just keep defending!",
      "status": "imported"
    },
    "voice_064:r_0fadb5c26df92b42": {
      "text": "I'll counterattack...!",
      "status": "imported"
    },
    "voice_064:r_6b15af9a0057cdc8": {
      "text": "I'll strike those who spread war!",
      "status": "imported"
    },
    "voice_064:r_15b4a90140e8a33a": {
      "text": "I have a reason to fight, too!",
      "status": "imported"
    },
    "voice_064:r_af884a6b11dff121": {
      "text": "It's not over yet!",
      "status": "imported"
    },
    "voice_064:r_ac6fe7838e95647b": {
      "text": "I'll cover you! Pull back!",
      "status": "imported"
    },
    "voice_064:r_77ca87eacd17ad52": {
      "text": "Shinn, I'm with you...!",
      "status": "imported"
    },
    "voice_064:r_bf3244994760e535": {
      "text": "Amuro, I'll cover you!",
      "status": "imported"
    },
    "voice_064:r_aabfb21c9d069ce7": {
      "text": "Captain Quattro, I'll follow up!",
      "status": "imported"
    },
    "voice_064:r_02479dc8fe989560": {
      "text": "Kamille, leave the rest to me!",
      "status": "imported"
    },
    "voice_064:r_a2df00f91a9b0a9e": {
      "text": "I won't let anyone die!",
      "status": "imported"
    },
    "voice_064:r_48b60d6c48b9b142": {
      "text": "I won't let them hurt anyone!",
      "status": "imported"
    },
    "voice_064:r_8927e6fb681aa809": {
      "text": "Shinn! I'll take your place!",
      "status": "imported"
    },
    "voice_064:r_665f01666859013b": {
      "text": "Amuro, I'll handle this!",
      "status": "imported"
    },
    "voice_064:r_a571eec59b258d11": {
      "text": "Captain Quattro, fall back now!",
      "status": "imported"
    },
    "voice_064:r_ddbe581c5ea9183d": {
      "text": "Kamille! I'll be your shield!",
      "status": "imported"
    },
    "voice_064:r_faae935cca0edc72": {
      "text": "I'll do what I can!",
      "status": "imported"
    },
    "voice_064:r_d4430bf362340b32": {
      "text": "If I can break through their flank!",
      "status": "imported"
    },
    "voice_064:r_6ff1323b355593e0": {
      "text": "I'll strike first!",
      "status": "imported"
    },
    "voice_064:r_b7b5625d7cd4282f": {
      "text": "I'll focus on keeping them pinned!",
      "status": "imported"
    },
    "voice_064:r_36133ad73a73ef98": {
      "text": "I can't do a thing...!",
      "status": "imported"
    },
    "voice_064:r_920740a0219c5085": {
      "text": "I wasted too much energy...!?",
      "status": "imported"
    },
    "voice_064:r_a8451712c57c1a72": {
      "text": "Can't fire...!? From beyond range!",
      "status": "imported"
    },
    "voice_064:r_3633df5b7b8f47fa": {
      "text": "Damn... They're too far away!",
      "status": "imported"
    },
    "voice_064:r_52dfc56b14b93551": {
      "text": "You won't hit me that easily!",
      "status": "imported"
    },
    "voice_064:r_1b9b2aab5cb104da": {
      "text": "Dodged it! Just as I predicted...!",
      "status": "imported"
    },
    "voice_064:r_342044c706a2340f": {
      "text": "I can't afford to get hit!",
      "status": "imported"
    },
    "voice_064:r_cf41e8828a90cbdb": {
      "text": "That attack won't hit me!",
      "status": "imported"
    },
    "voice_064:r_719e897304ec42d4": {
      "text": "Calm down and watch their moves...!",
      "status": "imported"
    },
    "voice_064:r_d5e0a2317c40d322": {
      "text": "Good! Nice response!",
      "status": "imported"
    },
    "voice_064:r_ec2ea17765052401": {
      "text": "Watch their moves and this is easy!",
      "status": "imported"
    },
    "voice_064:r_f2d4255f1c2f7542": {
      "text": "I won't let this unit be\\ndamaged!",
      "status": "imported"
    },
    "voice_064:r_5d08ad19e2da125b": {
      "text": "With Freedom's mobility!",
      "status": "imported"
    },
    "voice_064:r_a7246b52782a877e": {
      "text": "That won't get past Phase Shift!",
      "status": "imported"
    },
    "voice_064:r_dc8701f6bcb9904f": {
      "text": "Phase Shift... That saved me...",
      "status": "imported"
    },
    "voice_064:r_d6bdd730f24f66eb": {
      "text": "I can't afford to take damage!",
      "status": "imported"
    },
    "voice_064:r_41997412868c48c4": {
      "text": "It only hit the shield!",
      "status": "imported"
    },
    "voice_064:r_9e6cf4f389dae55c": {
      "text": "A hit...!?\\nBut this is nothing!",
      "status": "imported"
    },
    "voice_064:r_9e0c80ac7e33b459": {
      "text": "Damage is minor... Ignore it!",
      "status": "imported"
    },
    "voice_064:r_7432ef43ed3471dc": {
      "text": "It only grazed me!",
      "status": "imported"
    },
    "voice_064:r_065443f6ddfcf0d7": {
      "text": "Damn! They actually hit Freedom!",
      "status": "imported"
    },
    "voice_064:r_47d52a2839c71715": {
      "text": "Damn! Did they zero in on me!?",
      "status": "imported"
    },
    "voice_064:r_847f82e7f3eef651": {
      "text": "I can't let them get any closer...!",
      "status": "imported"
    },
    "voice_064:r_eb7ae28b53dc033c": {
      "text": "More damage like this, and...!",
      "status": "imported"
    },
    "voice_064:r_857c4a52ce8df0fd": {
      "text": "My armor's gone!?\\nBut not yet!",
      "status": "imported"
    },
    "voice_064:r_55417493fce1d347": {
      "text": "They're reading my next move!?",
      "status": "imported"
    },
    "voice_064:r_8fdf5910927c9591": {
      "text": "Freedom's being cornered...!?",
      "status": "imported"
    },
    "voice_064:r_7d724dbcc4451e10": {
      "text": "Ghh! I can't go down here!",
      "status": "imported"
    },
    "voice_064:r_93e25418a203cb8f": {
      "text": "No hope, yet I fight!\\nWhy I'm here!",
      "status": "imported"
    },
    "voice_064:r_adeb0a29274d3d9b": {
      "text": "Remember...\\nwhy you're fighting!",
      "status": "imported"
    },
    "voice_064:r_24cf161287ef9d5c": {
      "text": "I won't fall till the war is over!!",
      "status": "imported"
    },
    "voice_064:r_8f60f6fc86db3107": {
      "text": "Not yet!\\nI still have work to do!!",
      "status": "imported"
    },
    "voice_064:r_b1de76a75a253c13": {
      "text": "Nothing's over yet, and I...!",
      "status": "imported"
    },
    "voice_064:r_128c35bf3e0e394c": {
      "text": "Is this... all I can do...?",
      "status": "imported"
    },
    "voice_064:r_5213c17e13b23de0": {
      "text": "I'll close the gap at once!",
      "status": "imported"
    },
    "voice_064:r_38fdff9483e9245c": {
      "text": "Hyaah!",
      "status": "imported"
    },
    "voice_064:r_620fedec67706d7d": {
      "text": "Once I'm in close!",
      "status": "imported"
    },
    "voice_064:r_2a00f1044ad5cbaa": {
      "text": "I'll close in here...!",
      "status": "imported"
    },
    "voice_064:r_98d15b8cc09bc915": {
      "text": "I... will fight!!",
      "status": "imported"
    },
    "voice_064:r_46e86d000250e137": {
      "text": "Hiiit!!",
      "status": "imported"
    },
    "voice_064:r_ac341e7976e88f0b": {
      "text": "To get where I want to go, I must!",
      "status": "imported"
    },
    "voice_064:r_cdbd128a5b4127cc": {
      "text": "I won't choose the wrong path!",
      "status": "imported"
    },
    "voice_064:r_cfccaa1fbeda124c": {
      "text": "Nothing comes from fighting! So...!",
      "status": "imported"
    },
    "voice_064:r_b1f8ec192b9c083a": {
      "text": "This time I'll find the right one!",
      "status": "imported"
    },
    "voice_064:r_a007f9ab9cf048b3": {
      "text": "Entrusted hopes...\\nwon't be wasted!",
      "status": "imported"
    },
    "voice_064:r_13c25fbdfddc8a24": {
      "text": "I'll bring them to a halt!",
      "status": "imported"
    },
    "voice_064:r_42ba1ecb310b4bd7": {
      "text": "For now, I can only fight...!",
      "status": "imported"
    },
    "voice_064:r_8ab47a28f99ef565": {
      "text": "Your new power... and you...!",
      "status": "imported"
    },
    "voice_064:r_e42b52c7a987b906": {
      "text": "Not just will... or just power...!",
      "status": "imported"
    },
    "voice_064:r_6825fd1ff907bd22": {
      "text": "Kira Yamato. Freedom, launching!",
      "status": "imported"
    },
    "voice_064:r_607f666f1563bc0d": {
      "text": "Your life is your own! That's why!",
      "status": "imported"
    },
    "voice_064:r_97b7431eeb81e6b6": {
      "text": "Blow us away - we replant flowers.",
      "status": "imported"
    },
    "voice_064:r_132f605d02975e71": {
      "text": "I'll fight for this world, too...!",
      "status": "imported"
    },
    "voice_064:r_9b9726b1872759d6": {
      "text": "Some things never change, anywhere!",
      "status": "imported"
    },
    "voice_064:r_1252db29683fefe0": {
      "text": "Wherever I am,\\nI can still help!",
      "status": "imported"
    },
    "voice_064:r_b84afafb8a33ec60": {
      "text": "Even against a Gundam...!",
      "status": "imported"
    },
    "voice_064:r_c8c59db85bf875e6": {
      "text": "If you caused this war,\\nI'll...!",
      "status": "imported"
    },
    "voice_064:r_391aa56435d9dd6e": {
      "text": "I'll stop you...!\\nand end this war!",
      "status": "imported"
    },
    "voice_064:r_7c796ba53bd7ea03": {
      "text": "Steal their freedom\\nand peace...!",
      "status": "imported"
    },
    "voice_064:r_fa944da4b6519006": {
      "text": "You came here to invade Earth...!",
      "status": "imported"
    },
    "voice_064:r_95d047bcc17fccc6": {
      "text": "The world won't change\\nthis way...!",
      "status": "imported"
    },
    "voice_064:r_640327a12a559b31": {
      "text": "Fighting won't change anything...!",
      "status": "imported"
    },
    "voice_064:r_5aeeb4917340c42d": {
      "text": "Impressive as ever, Heero.",
      "status": "imported"
    },
    "voice_064:r_b765659981b6516d": {
      "text": "I'm right behind you, Setsuna.",
      "status": "imported"
    },
    "voice_064:r_0c427458bc00eb95": {
      "text": "I'll support Celestial Being!",
      "status": "imported"
    },
    "voice_064:r_774a9ab4d8fd5351": {
      "text": "Don't push yourself, Heero!",
      "status": "imported"
    },
    "voice_064:r_d3f01de714c015bd": {
      "text": "Fall back while you can, Setsuna!",
      "status": "imported"
    },
    "voice_064:r_7d2617c809fead70": {
      "text": "Sorry, Lacus... Freedom again...",
      "status": "imported"
    },
    "voice_064:r_ceb935ccbf830724": {
      "text": "Systems check... I can still fight!",
      "status": "imported"
    },
    "voice_064:r_862ef7385bf2abd4": {
      "text": "My shield can handle this much!",
      "status": "imported"
    },
    "voice_064:r_001cbec4d9a4283f": {
      "text": "Fall back while you can!",
      "status": "imported"
    },
    "voice_064:r_8ad40afecd02b41e": {
      "text": "I'll handle this!",
      "status": "imported"
    },
    "voice_064:r_26e5efec03c03d78": {
      "text": "What are you people here for...!?",
      "status": "imported"
    },
    "voice_064:r_4ad81e88c7557a8b": {
      "text": "Our world isn't yours to abuse!",
      "status": "imported"
    },
    "voice_064:r_1f65a7af190e4674": {
      "text": "This feeling... could you be...!?",
      "status": "imported"
    },
    "voice_064:r_f2e18dfdfe0c89ea": {
      "text": "Call our world fixed?\\nHow arrogant!",
      "status": "imported"
    },
    "voice_064:r_cf7dbf49e96a5755": {
      "text": "We want tomorrow!\\nNo god takes it!",
      "status": "imported"
    },
    "voice_064:r_fa96676cc65bb509": {
      "text": "The future isn't yours to make...!",
      "status": "imported"
    },
    "voice_064:r_e33693e5ba4665b0": {
      "text": "I'll forge a future too, Setsuna!",
      "status": "imported"
    },
    "voice_064:r_72a21a1a489af001": {
      "text": "Lockon, thanks for the cover!",
      "status": "imported"
    },
    "voice_064:r_eb643f8bf737a0ca": {
      "text": "Tieria, I'll take it from here!",
      "status": "imported"
    },
    "voice_064:r_0a3fccb71ec6cf2a": {
      "text": "As planned, I'll take over now!",
      "status": "imported"
    },
    "voice_064:r_9b63cf1f3e0207ef": {
      "text": "Graham, I'll attack from here, too!",
      "status": "imported"
    },
    "voice_064:r_8356f4e3dcdff938": {
      "text": "I won't let you fight alone!",
      "status": "imported"
    },
    "voice_064:r_1d6d784036ae0bd7": {
      "text": "Setsuna, you're pushing too hard!",
      "status": "imported"
    },
    "voice_064:r_625664af02183c17": {
      "text": "His quick draw's too late!? Then!",
      "status": "imported"
    },
    "voice_064:r_3701cba361f80ea5": {
      "text": "Tieria, I'll protect you!",
      "status": "imported"
    },
    "voice_064:r_63f429c5c68c0863": {
      "text": "Celestial Being isn't finished yet!",
      "status": "imported"
    },
    "voice_064:r_38e4a434c91d8ef0": {
      "text": "Graham,\\neven you got careless!",
      "status": "imported"
    },
    "voice_064:r_98ed411352a3a6ac": {
      "text": "Even Super Soldiers are only human!",
      "status": "imported"
    },
    "voice_064:r_4824bea6bab3af67": {
      "text": "I'll stop my opponent cold!",
      "status": "imported"
    }
  }
}
