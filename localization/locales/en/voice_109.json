{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_109:r_479b340ccc6c572b": {
      "text": "I'll take this!",
      "status": "imported"
    },
    "voice_109:r_ca4acbac57a2a35e": {
      "text": "I'll handle this!",
      "status": "imported"
    },
    "voice_109:r_77949221bf58f862": {
      "text": "I've got you!",
      "status": "imported"
    },
    "voice_109:r_70b9c4b9f1f37eff": {
      "text": "I'll strike first!",
      "status": "imported"
    },
    "voice_109:r_9fcb3754cb1773c7": {
      "text": "I won't show mercy!",
      "status": "imported"
    },
    "voice_109:r_3559d2fad32c2435": {
      "text": "I'll open a breach!",
      "status": "imported"
    },
    "voice_109:r_f7570547e9f80a64": {
      "text": "You have no chance of victory!",
      "status": "imported"
    },
    "voice_109:r_cbab0f4720e1fcf1": {
      "text": "Vanish from my sight!",
      "status": "imported"
    },
    "voice_109:r_0bbe0b4f5364e732": {
      "text": "Raphael,\\nbreach their lines first!",
      "status": "imported"
    },
    "voice_109:r_5dda5198137cb02a": {
      "text": "I won't miss!",
      "status": "imported"
    },
    "voice_109:r_83ec59afbecdec14": {
      "text": "I may be no Lockon, but...!",
      "status": "imported"
    },
    "voice_109:r_e20bfd42ad95a3c9": {
      "text": "Haaaaah!",
      "status": "imported"
    },
    "voice_109:r_0f58a8822381e57f": {
      "text": "Even in close combat!",
      "status": "imported"
    },
    "voice_109:r_6dbcc507fb61b51d": {
      "text": "Raaaaaah!",
      "status": "imported"
    },
    "voice_109:r_b42ab697149a7c8a": {
      "text": "Now!",
      "status": "imported"
    },
    "voice_109:r_4de4fcf3b440baf4": {
      "text": "There!",
      "status": "imported"
    },
    "voice_109:r_0121a166c715cdff": {
      "text": "Too slow!",
      "status": "imported"
    },
    "voice_109:r_30fad37a42bd3ad3": {
      "text": "Some still remain? How foolish!",
      "status": "imported"
    },
    "voice_109:r_80a0b2a84e05d81a": {
      "text": "It seems my luck hasn't run out!",
      "status": "imported"
    },
    "voice_109:r_4a9ac1dff86506d9": {
      "text": "Raphael, continue the attack!",
      "status": "imported"
    },
    "voice_109:r_bc8538e6af3d2577": {
      "text": "A Gundam stands in my way?!",
      "status": "imported"
    },
    "voice_109:r_924516c8de2b5342": {
      "text": "Gundams fighting... It shouldn't be!",
      "status": "imported"
    },
    "voice_109:r_da1174533722333f": {
      "text": "Quantum Brainwaves fail. Dialogue?!",
      "status": "imported"
    },
    "voice_109:r_fdeb8162976e72c1": {
      "text": "What are you trying to tell me?!",
      "status": "imported"
    },
    "voice_109:r_0fadb5c26df92b42": {
      "text": "Scorning others\\nkeeps us apart!",
      "status": "imported"
    },
    "voice_109:r_6b15af9a0057cdc8": {
      "text": "This, too, is a result of dialogue!",
      "status": "imported"
    },
    "voice_109:r_15b4a90140e8a33a": {
      "text": "You insist on remaining hostile?!",
      "status": "imported"
    },
    "voice_109:r_af884a6b11dff121": {
      "text": "Raphael, engage the ELS!",
      "status": "imported"
    },
    "voice_109:r_ac6fe7838e95647b": {
      "text": "Raphael,\\nfree us from divine rule!",
      "status": "imported"
    },
    "voice_109:r_77ca87eacd17ad52": {
      "text": "Tieria Erde\\nbuild our future as one!",
      "status": "imported"
    },
    "voice_109:r_bf3244994760e535": {
      "text": "Our final mission...\\nI'll finish it!",
      "status": "imported"
    },
    "voice_109:r_aabfb21c9d069ce7": {
      "text": "Destroy the target!",
      "status": "imported"
    },
    "voice_109:r_02479dc8fe989560": {
      "text": "Annihilate the enemy!",
      "status": "imported"
    },
    "voice_109:r_a2df00f91a9b0a9e": {
      "text": "Fire!",
      "status": "imported"
    },
    "voice_109:r_48b60d6c48b9b142": {
      "text": "Trans-Am!",
      "status": "imported"
    },
    "voice_109:r_8927e6fb681aa809": {
      "text": "Full Burst!",
      "status": "imported"
    },
    "voice_109:r_665f01666859013b": {
      "text": "Going Trans-Am!",
      "status": "imported"
    },
    "voice_109:r_a571eec59b258d11": {
      "text": "Not even a trace will remain!",
      "status": "imported"
    },
    "voice_109:r_ddbe581c5ea9183d": {
      "text": "Trans-Am, now!",
      "status": "imported"
    },
    "voice_109:r_faae935cca0edc72": {
      "text": "Maximum output!",
      "status": "imported"
    },
    "voice_109:r_9680dcd0fddcfcc7": {
      "text": "If you insist on being hostile!",
      "status": "imported"
    },
    "voice_109:r_2a00f1044ad5cbaa": {
      "text": "Then allow me to counterattack!",
      "status": "imported"
    },
    "voice_109:r_3dbeead1bd3164ef": {
      "text": "You won't escape!",
      "status": "imported"
    },
    "voice_109:r_98d15b8cc09bc915": {
      "text": "I don't intend to end this here!",
      "status": "imported"
    },
    "voice_109:r_46e86d000250e137": {
      "text": "If that's how you want it!",
      "status": "imported"
    },
    "voice_109:r_ac341e7976e88f0b": {
      "text": "I won't stand by in silence!",
      "status": "imported"
    },
    "voice_109:r_cdbd128a5b4127cc": {
      "text": "You'll get what you deserve!",
      "status": "imported"
    },
    "voice_109:r_cfccaa1fbeda124c": {
      "text": "Allow me to assist!",
      "status": "imported"
    },
    "voice_109:r_b1f8ec192b9c083a": {
      "text": "You'll have to face me as well!",
      "status": "imported"
    },
    "voice_109:r_a007f9ab9cf048b3": {
      "text": "This isn't over yet!",
      "status": "imported"
    },
    "voice_109:r_ddafde4b065ced49": {
      "text": "Setsuna, I'll take the target!",
      "status": "imported"
    },
    "voice_109:r_de1213040856c089": {
      "text": "Lockon, I'll cover you!",
      "status": "imported"
    },
    "voice_109:r_3304412ac41f47a6": {
      "text": "Allelujah, thanks for the diversion!",
      "status": "imported"
    },
    "voice_109:r_0c0775e051211840": {
      "text": "I'll clear a path for Ptolemy!",
      "status": "imported"
    },
    "voice_109:r_a2afffe1c396f0b3": {
      "text": "Mileina, I'll finish things here!",
      "status": "imported"
    },
    "voice_109:r_13c25fbdfddc8a24": {
      "text": "I won't let you!",
      "status": "imported"
    },
    "voice_109:r_42ba1ecb310b4bd7": {
      "text": "Even if this is a foolish choice!",
      "status": "imported"
    },
    "voice_109:r_d692f1d420460a47": {
      "text": "It's coming! Fall back, now!",
      "status": "imported"
    },
    "voice_109:r_a5643cec86b18bd2": {
      "text": "I'll cover Setsuna!",
      "status": "imported"
    },
    "voice_109:r_68f2dfab20a4a30e": {
      "text": "They're targeting you, Lockon!",
      "status": "imported"
    },
    "voice_109:r_9cedad8237480563": {
      "text": "Allelujah, leave this to me.",
      "status": "imported"
    },
    "voice_109:r_a03fabecba1508ca": {
      "text": "Sumeragi Lee Noriega, too careless!",
      "status": "imported"
    },
    "voice_109:r_5391b24a71eb10ae": {
      "text": "This puts the mission at risk...!",
      "status": "imported"
    },
    "voice_109:r_a554ceef5c87b972": {
      "text": "The enemy trapped us...?!",
      "status": "imported"
    },
    "voice_109:r_546c3d5937fbb7ee": {
      "text": "You must be terrified of Gundams.",
      "status": "imported"
    },
    "voice_109:r_1568ff6298b12b96": {
      "text": "Ngh... What a petty trick...!",
      "status": "imported"
    },
    "voice_109:r_2c9d94ba13c5fc50": {
      "text": "By the book so far...\\nStay alert.",
      "status": "imported"
    },
    "voice_109:r_a77f4913375098d2": {
      "text": "Don't judge by appearances.",
      "status": "imported"
    },
    "voice_109:r_428c2116ac3071b1": {
      "text": "You sortied with skill that poor.",
      "status": "imported"
    },
    "voice_109:r_84c116267b79f540": {
      "text": "Your movements are too wasteful.",
      "status": "imported"
    },
    "voice_109:r_dad38ee29af2df3a": {
      "text": "I won't indulge your agenda.",
      "status": "imported"
    },
    "voice_109:r_3d32e86f8dc80909": {
      "text": "That's nothing!",
      "status": "imported"
    },
    "voice_109:r_70451ffbabe2f876": {
      "text": "I'm confident in my piloting too!",
      "status": "imported"
    },
    "voice_109:r_69dfa1659715e2fa": {
      "text": "Handling a Gundam,\\nI have the edge.",
      "status": "imported"
    },
    "voice_109:r_d996fd6d4ef5b329": {
      "text": "What a pointless thing to do.",
      "status": "imported"
    },
    "voice_109:r_546de3fb6db156ea": {
      "text": "Your attacks will never reach me.",
      "status": "imported"
    },
    "voice_109:r_ca85f87cee5e31f7": {
      "text": "Even if I can't dodge, it's fine.",
      "status": "imported"
    },
    "voice_109:r_9072ea7bc71df136": {
      "text": "GN Field!",
      "status": "imported"
    },
    "voice_109:r_04e815a8d425827d": {
      "text": "Not enough!",
      "status": "imported"
    },
    "voice_109:r_d89011fe3e5d082a": {
      "text": "Hmph. You think that will sink me?",
      "status": "imported"
    },
    "voice_109:r_3c5b0c2ac812d5de": {
      "text": "Damage check... Within tolerance.",
      "status": "imported"
    },
    "voice_109:r_5b9e8897190892eb": {
      "text": "Gundam armor...\\nDon't dismiss it!",
      "status": "imported"
    },
    "voice_109:r_7bea3023abbf8a94": {
      "text": "Can't evade it completely...!",
      "status": "imported"
    },
    "voice_109:r_dd01a4c0d1b36a8d": {
      "text": "I let the enemy land a hit...!",
      "status": "imported"
    },
    "voice_109:r_20920ad2eb3542db": {
      "text": "What?! I took a hit!",
      "status": "imported"
    },
    "voice_109:r_0ab7914877fd48ed": {
      "text": "This power... I must stay alert!",
      "status": "imported"
    },
    "voice_109:r_cb846feec748c2e3": {
      "text": "The GN Drive's intact. I can go on!",
      "status": "imported"
    },
    "voice_109:r_c958860b0676b1f5": {
      "text": "Ngh... How could I...!",
      "status": "imported"
    },
    "voice_109:r_5e2669b82ef75ce3": {
      "text": "Veda's data was off...? Impressive!",
      "status": "imported"
    },
    "voice_109:r_7847e0ed7dc9282d": {
      "text": "Ngh! Someone interfered...!",
      "status": "imported"
    },
    "voice_109:r_e42b52c7a987b906": {
      "text": "Ngh... I'm fine. Continue mission!",
      "status": "imported"
    },
    "voice_109:r_6825fd1ff907bd22": {
      "text": "An even match for a Gundam!",
      "status": "imported"
    },
    "voice_109:r_607f666f1563bc0d": {
      "text": "Good with a Gundam,\\nbut not enough!",
      "status": "imported"
    },
    "voice_109:r_97b7431eeb81e6b6": {
      "text": "Not yet! Each time\\nwe beat despair!",
      "status": "imported"
    },
    "voice_109:r_132f605d02975e71": {
      "text": "For the day that's yet to come...!",
      "status": "imported"
    },
    "voice_109:r_9b9726b1872759d6": {
      "text": "Ngh! I must defend this position!",
      "status": "imported"
    },
    "voice_109:r_1252db29683fefe0": {
      "text": "Th-this power...!",
      "status": "imported"
    },
    "voice_109:r_ad3d538f1e909184": {
      "text": "Driven this far... I never imagined!",
      "status": "imported"
    },
    "voice_109:r_8c61c59a1c0aebbf": {
      "text": "This failure... I deserve death...!",
      "status": "imported"
    },
    "voice_109:r_aba6a7662129d8ce": {
      "text": "Ugh! The mission's at risk...!",
      "status": "imported"
    },
    "voice_109:r_b84afafb8a33ec60": {
      "text": "Ngh...!\\nGN Drive won't power up...!",
      "status": "imported"
    },
    "voice_109:r_c8c59db85bf875e6": {
      "text": "I'm sorry. The rest is up to you...!",
      "status": "imported"
    },
    "voice_109:r_391aa56435d9dd6e": {
      "text": "We'll take one down ourselves!",
      "status": "imported"
    },
    "voice_109:r_7c796ba53bd7ea03": {
      "text": "You may not get a turn after all.",
      "status": "imported"
    },
    "voice_109:r_fa944da4b6519006": {
      "text": "I'll be your opponent.",
      "status": "imported"
    },
    "voice_109:r_95d047bcc17fccc6": {
      "text": "I'll carry out my assigned mission.",
      "status": "imported"
    }
  }
}
