{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_110:r_479b340ccc6c572b": {
      "text": "Nextant.\\n13th Rank: Shield of Order",
      "status": "imported"
    },
    "voice_110:r_ca4acbac57a2a35e": {
      "text": "Through Martial, I shall reach God.",
      "status": "imported"
    },
    "voice_110:r_77949221bf58f862": {
      "text": "War is the harmony of all things.",
      "status": "imported"
    },
    "voice_110:r_70b9c4b9f1f37eff": {
      "text": "My Nextant power...\\nI must show it!",
      "status": "imported"
    },
    "voice_110:r_9fcb3754cb1773c7": {
      "text": "So I must rely on AT's power...!",
      "status": "imported"
    },
    "voice_110:r_3559d2fad32c2435": {
      "text": "This is my duty!",
      "status": "imported"
    },
    "voice_110:r_f7570547e9f80a64": {
      "text": "Now, prepare yourself!",
      "status": "imported"
    },
    "voice_110:r_cbab0f4720e1fcf1": {
      "text": "Even without the aux-brain...!",
      "status": "imported"
    },
    "voice_110:r_0bbe0b4f5364e732": {
      "text": "Why? My blood is stirring...!",
      "status": "imported"
    },
    "voice_110:r_5dda5198137cb02a": {
      "text": "I won't show mercy!",
      "status": "imported"
    },
    "voice_110:r_83ec59afbecdec14": {
      "text": "This too is fate!",
      "status": "imported"
    },
    "voice_110:r_e20bfd42ad95a3c9": {
      "text": "I won't let that opening pass!",
      "status": "imported"
    },
    "voice_110:r_0f58a8822381e57f": {
      "text": "My aux-brain...\\nNever more welcome!",
      "status": "imported"
    },
    "voice_110:r_6dbcc507fb61b51d": {
      "text": "What remains...\\nMy warrior's pride!",
      "status": "imported"
    },
    "voice_110:r_b42ab697149a7c8a": {
      "text": "To bring an end to suffering...!",
      "status": "imported"
    },
    "voice_110:r_4de4fcf3b440baf4": {
      "text": "I never miss...!",
      "status": "imported"
    },
    "voice_110:r_0121a166c715cdff": {
      "text": "Distance means nothing...!",
      "status": "imported"
    },
    "voice_110:r_30fad37a42bd3ad3": {
      "text": "Wherever you flee, it's futile!",
      "status": "imported"
    },
    "voice_110:r_80a0b2a84e05d81a": {
      "text": "I can see your every move!",
      "status": "imported"
    },
    "voice_110:r_4a9ac1dff86506d9": {
      "text": "Perhaps using this is wiser...!",
      "status": "imported"
    },
    "voice_110:r_bc8538e6af3d2577": {
      "text": "You left yourself open...!",
      "status": "imported"
    },
    "voice_110:r_924516c8de2b5342": {
      "text": "I'll close the distance!",
      "status": "imported"
    },
    "voice_110:r_da1174533722333f": {
      "text": "I'll finish you in close combat!",
      "status": "imported"
    },
    "voice_110:r_fdeb8162976e72c1": {
      "text": "Farewell!",
      "status": "imported"
    },
    "voice_110:r_0fadb5c26df92b42": {
      "text": "Got you!",
      "status": "imported"
    },
    "voice_110:r_6b15af9a0057cdc8": {
      "text": "Here I go!",
      "status": "imported"
    },
    "voice_110:r_15b4a90140e8a33a": {
      "text": "The final blow!",
      "status": "imported"
    },
    "voice_110:r_af884a6b11dff121": {
      "text": "You let your guard down too soon...!",
      "status": "imported"
    },
    "voice_110:r_ac6fe7838e95647b": {
      "text": "Your escape is already cut off...!",
      "status": "imported"
    },
    "voice_110:r_77ca87eacd17ad52": {
      "text": "Chirico Cuvie...!",
      "status": "imported"
    },
    "voice_110:r_bf3244994760e535": {
      "text": "Chirico, you can no longer escape!",
      "status": "imported"
    },
    "voice_110:r_aabfb21c9d069ce7": {
      "text": "To see Fyana,\\nyou must defeat me!",
      "status": "imported"
    },
    "voice_110:r_02479dc8fe989560": {
      "text": "Untouchable... I'll fell you myself!",
      "status": "imported"
    },
    "voice_110:r_a2df00f91a9b0a9e": {
      "text": "You're quite tenacious...!",
      "status": "imported"
    },
    "voice_110:r_48b60d6c48b9b142": {
      "text": "However tough, it can still break!",
      "status": "imported"
    },
    "voice_110:r_8927e6fb681aa809": {
      "text": "Your size means nothing to me...!",
      "status": "imported"
    },
    "voice_110:r_665f01666859013b": {
      "text": "What an unfathomable power...!",
      "status": "imported"
    },
    "voice_110:r_a571eec59b258d11": {
      "text": "An enemy with superior mobility...!",
      "status": "imported"
    },
    "voice_110:r_ddbe581c5ea9183d": {
      "text": "I've heard the rumors, Gundam!",
      "status": "imported"
    },
    "voice_110:r_faae935cca0edc72": {
      "text": "Defeat you,\\nprove a Nextant's power!",
      "status": "imported"
    },
    "voice_110:r_6ff1323b355593e0": {
      "text": "A machine...?! No, a giant...!",
      "status": "imported"
    },
    "voice_110:r_b7b5625d7cd4282f": {
      "text": "W-what is that...?",
      "status": "imported"
    },
    "voice_110:r_36133ad73a73ef98": {
      "text": "Heh, the size gap...\\nHow laughable.",
      "status": "imported"
    },
    "voice_110:r_920740a0219c5085": {
      "text": "That pilot...\\nA cut above the rest!",
      "status": "imported"
    },
    "voice_110:r_a8451712c57c1a72": {
      "text": "The commander should fall first...!",
      "status": "imported"
    },
    "voice_110:r_3633df5b7b8f47fa": {
      "text": "I'll sink your battleship too...!",
      "status": "imported"
    },
    "voice_110:r_70451ffbabe2f876": {
      "text": "You won't escape...!",
      "status": "imported"
    },
    "voice_110:r_69dfa1659715e2fa": {
      "text": "The tide has turned...!",
      "status": "imported"
    },
    "voice_110:r_d996fd6d4ef5b329": {
      "text": "You shouldn't have attacked me...!",
      "status": "imported"
    },
    "voice_110:r_8ab47a28f99ef565": {
      "text": "You let me strike back. You lose!",
      "status": "imported"
    },
    "voice_110:r_546de3fb6db156ea": {
      "text": "I'll return the favor...!",
      "status": "imported"
    },
    "voice_110:r_ca85f87cee5e31f7": {
      "text": "Now, accept your fate...!",
      "status": "imported"
    },
    "voice_110:r_9072ea7bc71df136": {
      "text": "I'll follow your lead.",
      "status": "imported"
    },
    "voice_110:r_04e815a8d425827d": {
      "text": "We'll strike in tandem.",
      "status": "imported"
    },
    "voice_110:r_d89011fe3e5d082a": {
      "text": "Fall back!",
      "status": "imported"
    },
    "voice_110:r_3c5b0c2ac812d5de": {
      "text": "I'll take it from here.",
      "status": "imported"
    },
    "voice_110:r_5b9e8897190892eb": {
      "text": "What?! I can't counterattack...!",
      "status": "imported"
    },
    "voice_110:r_7bea3023abbf8a94": {
      "text": "What?!\\nDid I make a mistake...?!",
      "status": "imported"
    },
    "voice_110:r_dd01a4c0d1b36a8d": {
      "text": "Are you afraid of me...?",
      "status": "imported"
    },
    "voice_110:r_20920ad2eb3542db": {
      "text": "That is certainly one valid tactic.",
      "status": "imported"
    },
    "voice_110:r_0ab7914877fd48ed": {
      "text": "Pathetic wretch...",
      "status": "imported"
    },
    "voice_110:r_cb846feec748c2e3": {
      "text": "A natural result, a natural outcome.",
      "status": "imported"
    },
    "voice_110:r_c958860b0676b1f5": {
      "text": "God wills order\\nOnly force keeps it.",
      "status": "imported"
    },
    "voice_110:r_5e2669b82ef75ce3": {
      "text": "This is the power of a Nextant.",
      "status": "imported"
    },
    "voice_110:r_7847e0ed7dc9282d": {
      "text": "We will continue this battle.",
      "status": "imported"
    },
    "voice_110:r_e42b52c7a987b906": {
      "text": "This still won't erase the pain...",
      "status": "imported"
    },
    "voice_110:r_6825fd1ff907bd22": {
      "text": "I needn't even rely on my aux-brain.",
      "status": "imported"
    },
    "voice_110:r_607f666f1563bc0d": {
      "text": "I owe this to my aux-brain too...",
      "status": "imported"
    },
    "voice_110:r_97b7431eeb81e6b6": {
      "text": "Chirico, this way!",
      "status": "imported"
    },
    "voice_110:r_132f605d02975e71": {
      "text": "Untouchable! What a disappointment!",
      "status": "imported"
    },
    "voice_110:r_9b9726b1872759d6": {
      "text": "What a futile gesture...!",
      "status": "imported"
    },
    "voice_110:r_ad3d538f1e909184": {
      "text": "To think I would rely on this...",
      "status": "imported"
    },
    "voice_110:r_b84afafb8a33ec60": {
      "text": "Heh, that's more like it.",
      "status": "imported"
    },
    "voice_110:r_c8c59db85bf875e6": {
      "text": "Oh, you managed to hit me.",
      "status": "imported"
    },
    "voice_110:r_391aa56435d9dd6e": {
      "text": "No problem. Continue the battle.",
      "status": "imported"
    },
    "voice_110:r_7c796ba53bd7ea03": {
      "text": "This was merely an accident...!",
      "status": "imported"
    },
    "voice_110:r_fa944da4b6519006": {
      "text": "Enjoy that lucky hit while it lasts!",
      "status": "imported"
    },
    "voice_110:r_95d047bcc17fccc6": {
      "text": "Ngh...! What is going on here?!",
      "status": "imported"
    },
    "voice_110:r_640327a12a559b31": {
      "text": "Mere pain of the flesh...!",
      "status": "imported"
    },
    "voice_110:r_bdd38c584fa313d0": {
      "text": "Such insolence...!",
      "status": "imported"
    },
    "voice_110:r_3fd86c1027f317c8": {
      "text": "You surpassed my predictions...?",
      "status": "imported"
    },
    "voice_110:r_d0372a183d2007ad": {
      "text": "A fluke?! No, this is their power!",
      "status": "imported"
    },
    "voice_110:r_217aa5e1d545b44d": {
      "text": "Those reflexes...! No ordinary foe!",
      "status": "imported"
    },
    "voice_110:r_381992c5d8224937": {
      "text": "No outcome but victory is possible!",
      "status": "imported"
    },
    "voice_110:r_f1e7ed9e5874aba5": {
      "text": "Chiricooooo...!",
      "status": "imported"
    },
    "voice_110:r_fc25e66a86fc2c85": {
      "text": "Are you so exceptional, Chirico...?",
      "status": "imported"
    },
    "voice_110:r_5aeeb4917340c42d": {
      "text": "Worthy of the name Untouchable...!",
      "status": "imported"
    },
    "voice_110:r_d3f01de714c015bd": {
      "text": "Ngh! What a blunder!",
      "status": "imported"
    },
    "voice_110:r_7d2617c809fead70": {
      "text": "Damn it! How could this happen?!",
      "status": "imported"
    },
    "voice_110:r_ceb935ccbf830724": {
      "text": "Pathetic...! Shield of Order weeps!",
      "status": "imported"
    },
    "voice_110:r_862ef7385bf2abd4": {
      "text": "I know no defeat...!\\nI am a Nextant!",
      "status": "imported"
    },
    "voice_110:r_001cbec4d9a4283f": {
      "text": "Me, a Nextant...\\nPushed this far?!",
      "status": "imported"
    },
    "voice_110:r_8ad40afecd02b41e": {
      "text": "Pain obeys me.\\nI need no such power!",
      "status": "imported"
    },
    "voice_110:r_26e5efec03c03d78": {
      "text": "Not yet!\\nI must fulfill my duty!",
      "status": "imported"
    },
    "voice_110:r_4ad81e88c7557a8b": {
      "text": "Only the path of battle remains...!",
      "status": "imported"
    },
    "voice_110:r_1f65a7af190e4674": {
      "text": "Forgive me, Father...!",
      "status": "imported"
    },
    "voice_110:r_40c5a9358ed5bf29": {
      "text": "Now I've lost my warrior's pride...",
      "status": "imported"
    },
    "voice_110:r_f2e18dfdfe0c89ea": {
      "text": "No doubt... He is the Untouchable!",
      "status": "imported"
    },
    "voice_110:r_cf7dbf49e96a5755": {
      "text": "Impressive, Chirico...",
      "status": "imported"
    },
    "voice_110:r_fa96676cc65bb509": {
      "text": "Chirico, today you will fight me!",
      "status": "imported"
    },
    "voice_110:r_4e37f92e7d2fc62e": {
      "text": "Heh, relax. Your paused SRW? Cleared",
      "status": "imported"
    },
    "voice_110:r_66ab4cfe1557909d": {
      "text": "W-what is this intensity...?!",
      "status": "imported"
    },
    "voice_110:r_0bad405ee6ca63ba": {
      "text": "D'Oste Owagura Yashidiro Gratzi Mito",
      "status": "imported"
    },
    "voice_110:r_2072eaf71a260ae7": {
      "text": "Ngh...! Nnngh...!",
      "status": "imported"
    },
    "voice_110:r_6c13bbfd27a7799e": {
      "text": "Aaaaaagh!",
      "status": "imported"
    },
    "voice_110:r_06f88dcbd3c9e738": {
      "text": "I'll take the lead...!",
      "status": "imported"
    },
    "voice_110:r_b28faf9f71bc3598": {
      "text": "I'll draw the enemy's attention...!",
      "status": "imported"
    },
    "voice_110:r_8a29278549f8e07a": {
      "text": "Leave stopping them to me...!",
      "status": "imported"
    },
    "voice_110:r_7e6c573c26177f98": {
      "text": "Follow me!",
      "status": "imported"
    },
    "voice_110:r_45abf84f7757d6eb": {
      "text": "You appear to be a worthy foe...!",
      "status": "imported"
    },
    "voice_110:r_edd7a13ab8f06a14": {
      "text": "Cut the target off from the others!",
      "status": "imported"
    },
    "voice_110:r_8165e5b41f0124c4": {
      "text": "Target confirmed...!",
      "status": "imported"
    },
    "voice_110:r_4e05581b7432cce8": {
      "text": "One on one? Just what I wanted!",
      "status": "imported"
    }
  }
}
