{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_199:r_479b340ccc6c572b": {
      "text": "It's over!",
      "status": "imported"
    },
    "voice_199:r_ca4acbac57a2a35e": {
      "text": "Enemy unit sighted...!",
      "status": "imported"
    },
    "voice_199:r_77949221bf58f862": {
      "text": "Commencing attack!",
      "status": "imported"
    },
    "voice_199:r_70b9c4b9f1f37eff": {
      "text": "Neo Zeon! I'll teach you a lesson!",
      "status": "imported"
    },
    "voice_199:r_9fcb3754cb1773c7": {
      "text": "Take down Neo Zeon!",
      "status": "imported"
    },
    "voice_199:r_3559d2fad32c2435": {
      "text": "So that's the Red Comet!",
      "status": "imported"
    },
    "voice_199:r_f7570547e9f80a64": {
      "text": "Even against the Red Comet...!",
      "status": "imported"
    },
    "voice_199:r_cbab0f4720e1fcf1": {
      "text": "They've got a Gundam too?!",
      "status": "imported"
    },
    "voice_199:r_0bbe0b4f5364e732": {
      "text": "Target: Vajra!",
      "status": "imported"
    },
    "voice_199:r_5dda5198137cb02a": {
      "text": "Monster! You're not getting past me!",
      "status": "imported"
    },
    "voice_199:r_83ec59afbecdec14": {
      "text": "Drive the aliens off Earth!",
      "status": "imported"
    },
    "voice_199:r_924516c8de2b5342": {
      "text": "I'm counterattacking!",
      "status": "imported"
    },
    "voice_199:r_da1174533722333f": {
      "text": "I'll strike whoever gets closest!",
      "status": "imported"
    },
    "voice_199:r_fdeb8162976e72c1": {
      "text": "Time to hit back!",
      "status": "imported"
    },
    "voice_199:r_0fadb5c26df92b42": {
      "text": "Now it's our turn to attack!",
      "status": "imported"
    },
    "voice_199:r_6b15af9a0057cdc8": {
      "text": "Have some payback!",
      "status": "imported"
    },
    "voice_199:r_15b4a90140e8a33a": {
      "text": "Even if you try to withdraw...!",
      "status": "imported"
    },
    "voice_199:r_af884a6b11dff121": {
      "text": "Return fire!",
      "status": "imported"
    },
    "voice_199:r_ac6fe7838e95647b": {
      "text": "I'll counter by the book!",
      "status": "imported"
    },
    "voice_199:r_77ca87eacd17ad52": {
      "text": "I'll provide support from here!",
      "status": "imported"
    },
    "voice_199:r_bf3244994760e535": {
      "text": "The rest is up to you!",
      "status": "imported"
    },
    "voice_199:r_aabfb21c9d069ce7": {
      "text": "Witness Nerima Red Dragon's unity!",
      "status": "imported"
    },
    "voice_199:r_02479dc8fe989560": {
      "text": "Providing support, Captain!",
      "status": "imported"
    },
    "voice_199:r_a2df00f91a9b0a9e": {
      "text": "Can you manage one more hit?",
      "status": "imported"
    },
    "voice_199:r_48b60d6c48b9b142": {
      "text": "I won't let this chance escape!",
      "status": "imported"
    },
    "voice_199:r_8927e6fb681aa809": {
      "text": "Whoa! Aaaaaagh!",
      "status": "imported"
    },
    "voice_199:r_665f01666859013b": {
      "text": "Damn...! Is this the end?!",
      "status": "imported"
    },
    "voice_199:r_a571eec59b258d11": {
      "text": "N-no! I'm ejecting!",
      "status": "imported"
    },
    "voice_199:r_ddbe581c5ea9183d": {
      "text": "Damn it! Not here!",
      "status": "imported"
    },
    "voice_199:r_faae935cca0edc72": {
      "text": "Regrettably, I'm abandoning it!",
      "status": "imported"
    },
    "voice_199:r_d4430bf362340b32": {
      "text": "My unit can't take more! Retreat!",
      "status": "imported"
    },
    "voice_199:r_6ff1323b355593e0": {
      "text": "C-Captain! Forgive me!",
      "status": "imported"
    },
    "voice_199:r_b7b5625d7cd4282f": {
      "text": "G-glory to Nerima Red Dragon!",
      "status": "imported"
    },
    "voice_199:r_36133ad73a73ef98": {
      "text": "I-I can't lose to civilians!",
      "status": "imported"
    },
    "voice_199:r_920740a0219c5085": {
      "text": "What's happening?!\\nThey're veterans!",
      "status": "imported"
    },
    "voice_199:r_a8451712c57c1a72": {
      "text": "Nerima Red Dragon\\npushed back?!",
      "status": "imported"
    },
    "voice_199:r_3633df5b7b8f47fa": {
      "text": "Dai-Guard\\nwasn't a fake prop?!",
      "status": "imported"
    },
    "voice_199:r_52dfc56b14b93551": {
      "text": "Aagh! At this rate...!",
      "status": "imported"
    },
    "voice_199:r_1b9b2aab5cb104da": {
      "text": "Impossible! A direct hit?!",
      "status": "imported"
    },
    "voice_199:r_342044c706a2340f": {
      "text": "Damn! My unit's nearing its limit!",
      "status": "imported"
    },
    "voice_199:r_cf41e8828a90cbdb": {
      "text": "Why?! Why can't I dodge?!",
      "status": "imported"
    },
    "voice_199:r_719e897304ec42d4": {
      "text": "I won't let you do any more!",
      "status": "imported"
    },
    "voice_199:r_d5e0a2317c40d322": {
      "text": "Damn it!\\nWhat's going on here?!",
      "status": "imported"
    },
    "voice_199:r_ec2ea17765052401": {
      "text": "Not beaten yet!\\nIt starts now!",
      "status": "imported"
    },
    "voice_199:r_f2d4255f1c2f7542": {
      "text": "I'll fight as long as my unit moves!",
      "status": "imported"
    },
    "voice_199:r_5d08ad19e2da125b": {
      "text": "I hate to admit it, but good attack!",
      "status": "imported"
    },
    "voice_199:r_a7246b52782a877e": {
      "text": "I took that hit head-on...!",
      "status": "imported"
    },
    "voice_199:r_dc8701f6bcb9904f": {
      "text": "They're steadily cornering me...!",
      "status": "imported"
    },
    "voice_199:r_d6bdd730f24f66eb": {
      "text": "I have to turn the tide somehow...!",
      "status": "imported"
    },
    "voice_199:r_41997412868c48c4": {
      "text": "Trouble throughout the unit...!",
      "status": "imported"
    },
    "voice_199:r_9e6cf4f389dae55c": {
      "text": "Ngh! The damage is building up!",
      "status": "imported"
    },
    "voice_199:r_9e0c80ac7e33b459": {
      "text": "Am I losing due to the matchup?!",
      "status": "imported"
    },
    "voice_199:r_7432ef43ed3471dc": {
      "text": "Damn! I can't shake them!",
      "status": "imported"
    },
    "voice_199:r_857c4a52ce8df0fd": {
      "text": "Mere civilians! They can't do much!",
      "status": "imported"
    },
    "voice_199:r_55417493fce1d347": {
      "text": "Learned your lesson?\\nThen give up!",
      "status": "imported"
    },
    "voice_199:r_8fdf5910927c9591": {
      "text": "I mistimed my dodge...!",
      "status": "imported"
    },
    "voice_199:r_7d724dbcc4451e10": {
      "text": "That's hardly any damage...!",
      "status": "imported"
    },
    "voice_199:r_93e25418a203cb8f": {
      "text": "Was my timing off...!",
      "status": "imported"
    },
    "voice_199:r_adeb0a29274d3d9b": {
      "text": "I fell for a trick like that...!",
      "status": "imported"
    },
    "voice_199:r_24cf161287ef9d5c": {
      "text": "That attack won't faze me!",
      "status": "imported"
    },
    "voice_199:r_8f60f6fc86db3107": {
      "text": "That's nothing to worry about!",
      "status": "imported"
    },
    "voice_199:r_b1de76a75a253c13": {
      "text": "It was just a chance collision!",
      "status": "imported"
    },
    "voice_199:r_128c35bf3e0e394c": {
      "text": "It won't hinder the operation!",
      "status": "imported"
    },
    "voice_199:r_5213c17e13b23de0": {
      "text": "If the shield can block it...!",
      "status": "imported"
    },
    "voice_199:r_38fdff9483e9245c": {
      "text": "It hit the shield!",
      "status": "imported"
    },
    "voice_199:r_620fedec67706d7d": {
      "text": "Whoa, that was close!",
      "status": "imported"
    },
    "voice_199:r_9680dcd0fddcfcc7": {
      "text": "Not happening!",
      "status": "imported"
    },
    "voice_199:r_2a00f1044ad5cbaa": {
      "text": "Too slow!",
      "status": "imported"
    },
    "voice_199:r_3dbeead1bd3164ef": {
      "text": "I can do this...! I can do it!",
      "status": "imported"
    },
    "voice_199:r_98d15b8cc09bc915": {
      "text": "Good reaction!",
      "status": "imported"
    },
    "voice_199:r_46e86d000250e137": {
      "text": "Just have to dodge early...!",
      "status": "imported"
    },
    "voice_199:r_ac341e7976e88f0b": {
      "text": "I saw that coming!",
      "status": "imported"
    },
    "voice_199:r_cdbd128a5b4127cc": {
      "text": "That attack was obvious!",
      "status": "imported"
    },
    "voice_199:r_a007f9ab9cf048b3": {
      "text": "It's useless!",
      "status": "imported"
    },
    "voice_199:r_ddafde4b065ced49": {
      "text": "You think that attack will work?!",
      "status": "imported"
    },
    "voice_199:r_0c0775e051211840": {
      "text": "I've got a barrier!",
      "status": "imported"
    },
    "voice_199:r_a2afffe1c396f0b3": {
      "text": "I can't counterattack...?!",
      "status": "imported"
    },
    "voice_199:r_13c25fbdfddc8a24": {
      "text": "What's wrong?! I can't attack?!",
      "status": "imported"
    },
    "voice_199:r_42ba1ecb310b4bd7": {
      "text": "At this rate, I'll be focus-fired!",
      "status": "imported"
    },
    "voice_199:r_d692f1d420460a47": {
      "text": "No! That position is out of range!",
      "status": "imported"
    },
    "voice_199:r_a5643cec86b18bd2": {
      "text": "Beyond range...\\nYou know the basics!",
      "status": "imported"
    },
    "voice_199:r_68f2dfab20a4a30e": {
      "text": "Damn! The unit's wearing down fast!",
      "status": "imported"
    },
    "voice_199:r_9cedad8237480563": {
      "text": "Not while I'm standing right here!",
      "status": "imported"
    },
    "voice_199:r_a03fabecba1508ca": {
      "text": "Fall back while you still can!",
      "status": "imported"
    },
    "voice_199:r_5391b24a71eb10ae": {
      "text": "Nerima Red Dragon is immortal!",
      "status": "imported"
    },
    "voice_199:r_a554ceef5c87b972": {
      "text": "Captain, please fall back!",
      "status": "imported"
    },
    "voice_199:r_546c3d5937fbb7ee": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_199:r_1568ff6298b12b96": {
      "text": "There!",
      "status": "imported"
    },
    "voice_199:r_2c9d94ba13c5fc50": {
      "text": "You won't escape!",
      "status": "imported"
    },
    "voice_199:r_a77f4913375098d2": {
      "text": "Got you!",
      "status": "imported"
    },
    "voice_199:r_428c2116ac3071b1": {
      "text": "With this attack...!",
      "status": "imported"
    },
    "voice_199:r_84c116267b79f540": {
      "text": "I'll take this one!",
      "status": "imported"
    },
    "voice_199:r_dad38ee29af2df3a": {
      "text": "Don't resist!",
      "status": "imported"
    },
    "voice_199:r_3d32e86f8dc80909": {
      "text": "This will finish you!",
      "status": "imported"
    },
    "voice_199:r_70451ffbabe2f876": {
      "text": "Showing up sealed your fate!",
      "status": "imported"
    },
    "voice_199:r_69dfa1659715e2fa": {
      "text": "You took the bait!",
      "status": "imported"
    },
    "voice_199:r_d996fd6d4ef5b329": {
      "text": "The timing's right!",
      "status": "imported"
    },
    "voice_199:r_8ab47a28f99ef565": {
      "text": "I see my chance to win!",
      "status": "imported"
    },
    "voice_199:r_546de3fb6db156ea": {
      "text": "This is our mission!",
      "status": "imported"
    },
    "voice_199:r_ca85f87cee5e31f7": {
      "text": "Execute the operation swiftly!",
      "status": "imported"
    },
    "voice_199:r_9072ea7bc71df136": {
      "text": "Proceed according to plan!",
      "status": "imported"
    },
    "voice_199:r_04e815a8d425827d": {
      "text": "Exterminate the Spacenoids!",
      "status": "imported"
    },
    "voice_199:r_d89011fe3e5d082a": {
      "text": "Eliminate all space-dwellers!",
      "status": "imported"
    },
    "voice_199:r_3c5b0c2ac812d5de": {
      "text": "Die, Spacenoid!",
      "status": "imported"
    },
    "voice_199:r_5b9e8897190892eb": {
      "text": "Let every colony perish!",
      "status": "imported"
    },
    "voice_199:r_7bea3023abbf8a94": {
      "text": "Those colony-dwelling aliens...!",
      "status": "imported"
    },
    "voice_199:r_dd01a4c0d1b36a8d": {
      "text": "Citizens demand the colonies fall!",
      "status": "imported"
    },
    "voice_199:r_20920ad2eb3542db": {
      "text": "Witness Nerima Red Dragon's power!",
      "status": "imported"
    },
    "voice_199:r_0ab7914877fd48ed": {
      "text": "The Red Dragon name isn't for show!",
      "status": "imported"
    },
    "voice_199:r_cb846feec748c2e3": {
      "text": "I won't lose to mere civilians!",
      "status": "imported"
    },
    "voice_199:r_c958860b0676b1f5": {
      "text": "Even in a mock battle, I go all out!",
      "status": "imported"
    },
    "voice_199:r_5e2669b82ef75ce3": {
      "text": "Witness this cutting-edge unit!",
      "status": "imported"
    },
    "voice_199:r_7847e0ed7dc9282d": {
      "text": "Its performance rivals a Gundam's!",
      "status": "imported"
    },
    "voice_199:r_e42b52c7a987b906": {
      "text": "Hah!",
      "status": "imported"
    },
    "voice_199:r_6825fd1ff907bd22": {
      "text": "Raaaaah!",
      "status": "imported"
    },
    "voice_199:r_607f666f1563bc0d": {
      "text": "Hyah!",
      "status": "imported"
    },
    "voice_199:r_97b7431eeb81e6b6": {
      "text": "Go down!",
      "status": "imported"
    },
    "voice_199:r_132f605d02975e71": {
      "text": "Haaah!",
      "status": "imported"
    },
    "voice_199:r_1252db29683fefe0": {
      "text": "There you are!",
      "status": "imported"
    },
    "voice_199:r_8c61c59a1c0aebbf": {
      "text": "Now!",
      "status": "imported"
    },
    "voice_199:r_c8c59db85bf875e6": {
      "text": "Go down!",
      "status": "imported"
    },
    "voice_199:r_391aa56435d9dd6e": {
      "text": "Sights aligned!",
      "status": "imported"
    },
    "voice_199:r_7c796ba53bd7ea03": {
      "text": "I'll shoot you down!",
      "status": "imported"
    },
    "voice_199:r_fa944da4b6519006": {
      "text": "If I land a direct hit...!",
      "status": "imported"
    },
    "voice_199:r_95d047bcc17fccc6": {
      "text": "I'll finish you in close combat!",
      "status": "imported"
    },
    "voice_199:r_640327a12a559b31": {
      "text": "Initiating close-quarters combat!",
      "status": "imported"
    },
    "voice_199:r_bdd38c584fa313d0": {
      "text": "Charging in!",
      "status": "imported"
    },
    "voice_199:r_0c427458bc00eb95": {
      "text": "We'll make the first move!",
      "status": "imported"
    },
    "voice_199:r_774a9ab4d8fd5351": {
      "text": "I'll pin the enemy down!",
      "status": "imported"
    },
    "voice_199:r_d3f01de714c015bd": {
      "text": "Don't think this is just a feint!",
      "status": "imported"
    },
    "voice_199:r_7d2617c809fead70": {
      "text": "Leave this one to me!",
      "status": "imported"
    },
    "voice_199:r_ceb935ccbf830724": {
      "text": "Divide the enemy forces!",
      "status": "imported"
    },
    "voice_199:r_862ef7385bf2abd4": {
      "text": "If I can force a one-on-one...!",
      "status": "imported"
    }
  }
}
