{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_102:r_479b340ccc6c572b": {
      "text": "Now then, shall I start with you?",
      "status": "imported"
    },
    "voice_102:r_ca4acbac57a2a35e": {
      "text": "I always aim for results!",
      "status": "imported"
    },
    "voice_102:r_77949221bf58f862": {
      "text": "The world will change...! It can!",
      "status": "imported"
    },
    "voice_102:r_70b9c4b9f1f37eff": {
      "text": "No matter how harsh the road ahead!",
      "status": "imported"
    },
    "voice_102:r_9fcb3754cb1773c7": {
      "text": "This is my next move!",
      "status": "imported"
    },
    "voice_102:r_3559d2fad32c2435": {
      "text": "Can you predict my every move?",
      "status": "imported"
    },
    "voice_102:r_f7570547e9f80a64": {
      "text": "For all that I wish to protect!",
      "status": "imported"
    },
    "voice_102:r_cbab0f4720e1fcf1": {
      "text": "So that we may see tomorrow!",
      "status": "imported"
    },
    "voice_102:r_0bbe0b4f5364e732": {
      "text": "I'm Zero... the miracle worker!",
      "status": "imported"
    },
    "voice_102:r_5dda5198137cb02a": {
      "text": "I am always several moves ahead.",
      "status": "imported"
    },
    "voice_102:r_83ec59afbecdec14": {
      "text": "Then let me answer your encore!",
      "status": "imported"
    },
    "voice_102:r_e20bfd42ad95a3c9": {
      "text": "Gah! You monsters!",
      "status": "imported"
    },
    "voice_102:r_0f58a8822381e57f": {
      "text": "Now, leave this planet at once!",
      "status": "imported"
    },
    "voice_102:r_6dbcc507fb61b51d": {
      "text": "The world will change, not perish!",
      "status": "imported"
    },
    "voice_102:r_b42ab697149a7c8a": {
      "text": "For the future Nunnally envisioned!",
      "status": "imported"
    },
    "voice_102:r_4de4fcf3b440baf4": {
      "text": "As they wish,\\nI'll work a miracle!",
      "status": "imported"
    },
    "voice_102:r_0121a166c715cdff": {
      "text": "The world needs no ruler\\nlike you!",
      "status": "imported"
    },
    "voice_102:r_30fad37a42bd3ad3": {
      "text": "Stay out of my way!",
      "status": "imported"
    },
    "voice_102:r_80a0b2a84e05d81a": {
      "text": "Your defeat is already assured!",
      "status": "imported"
    },
    "voice_102:r_4a9ac1dff86506d9": {
      "text": "Heh heh heh... Ha ha! As planned!",
      "status": "imported"
    },
    "voice_102:r_bc8538e6af3d2577": {
      "text": "Don't think you can dodge this!",
      "status": "imported"
    },
    "voice_102:r_924516c8de2b5342": {
      "text": "All victory conditions are met!",
      "status": "imported"
    },
    "voice_102:r_da1174533722333f": {
      "text": "Begone from this world!",
      "status": "imported"
    },
    "voice_102:r_fdeb8162976e72c1": {
      "text": "All those who wield power...!",
      "status": "imported"
    },
    "voice_102:r_0fadb5c26df92b42": {
      "text": "Bear witness!",
      "status": "imported"
    },
    "voice_102:r_6b15af9a0057cdc8": {
      "text": "I fight those who prey on the weak!",
      "status": "imported"
    },
    "voice_102:r_15b4a90140e8a33a": {
      "text": "Range set...! All within my grasp!",
      "status": "imported"
    },
    "voice_102:r_af884a6b11dff121": {
      "text": "Begone!",
      "status": "imported"
    },
    "voice_102:r_ac6fe7838e95647b": {
      "text": "Until I change this world, I fight!",
      "status": "imported"
    },
    "voice_102:r_77ca87eacd17ad52": {
      "text": "Target set. Firing angle entered!",
      "status": "imported"
    },
    "voice_102:r_bf3244994760e535": {
      "text": "Spread Phase-Shift Cannon, fire!",
      "status": "imported"
    },
    "voice_102:r_aabfb21c9d069ce7": {
      "text": "I fight...!\\nall who abuse power!",
      "status": "imported"
    },
    "voice_102:r_52dfc56b14b93551": {
      "text": "This checkmate turns the tables!",
      "status": "imported"
    },
    "voice_102:r_1b9b2aab5cb104da": {
      "text": "You can't reach tomorrow by running!",
      "status": "imported"
    },
    "voice_102:r_342044c706a2340f": {
      "text": "You're the one with no way out!",
      "status": "imported"
    },
    "voice_102:r_cf41e8828a90cbdb": {
      "text": "Your moment won't go to waste!",
      "status": "imported"
    },
    "voice_102:r_719e897304ec42d4": {
      "text": "Well done, Kallen!",
      "status": "imported"
    },
    "voice_102:r_d5e0a2317c40d322": {
      "text": "We're accomplices, aren't we?",
      "status": "imported"
    },
    "voice_102:r_ec2ea17765052401": {
      "text": "Together, we can do it all... right?",
      "status": "imported"
    },
    "voice_102:r_f2d4255f1c2f7542": {
      "text": "Discarding others won't win this...!",
      "status": "imported"
    },
    "voice_102:r_5d08ad19e2da125b": {
      "text": "Kallen, don't quit! There's a move!",
      "status": "imported"
    },
    "voice_102:r_a7246b52782a877e": {
      "text": "Kallen, you must live!",
      "status": "imported"
    },
    "voice_102:r_dc8701f6bcb9904f": {
      "text": "Eject if things turn against you.",
      "status": "imported"
    },
    "voice_102:r_d6bdd730f24f66eb": {
      "text": "Stop! That's my...!",
      "status": "imported"
    },
    "voice_102:r_41997412868c48c4": {
      "text": "You can't go down, Suzaku!",
      "status": "imported"
    },
    "voice_102:r_9e6cf4f389dae55c": {
      "text": "Victory is now even more certain.",
      "status": "imported"
    },
    "voice_102:r_9e0c80ac7e33b459": {
      "text": "Damn it! Are you an idiot?!",
      "status": "imported"
    },
    "voice_102:r_7432ef43ed3471dc": {
      "text": "Not like some pompous knight, I see.",
      "status": "imported"
    },
    "voice_102:r_065443f6ddfcf0d7": {
      "text": "A combat pro...\\nyet easy to read.",
      "status": "imported"
    },
    "voice_102:r_47d52a2839c71715": {
      "text": "Our common sense is useless here...",
      "status": "imported"
    },
    "voice_102:r_847f82e7f3eef651": {
      "text": "Monster or not,\\nmotives expose it!",
      "status": "imported"
    },
    "voice_102:r_eb7ae28b53dc033c": {
      "text": "If I take out the commander...!",
      "status": "imported"
    },
    "voice_102:r_857c4a52ce8df0fd": {
      "text": "You have no right\\nto rule the world!",
      "status": "imported"
    },
    "voice_102:r_24cf161287ef9d5c": {
      "text": "How disgraceful of me...!",
      "status": "imported"
    },
    "voice_102:r_8f60f6fc86db3107": {
      "text": "To carelessly leave an opening...!",
      "status": "imported"
    },
    "voice_102:r_b1de76a75a253c13": {
      "text": "To think I'd waste a move...!",
      "status": "imported"
    },
    "voice_102:r_128c35bf3e0e394c": {
      "text": "Impressive, reading our position.",
      "status": "imported"
    },
    "voice_102:r_5213c17e13b23de0": {
      "text": "The energy's depleted...!",
      "status": "imported"
    },
    "voice_102:r_38fdff9483e9245c": {
      "text": "What's wrong? Try to defeat me.",
      "status": "imported"
    },
    "voice_102:r_620fedec67706d7d": {
      "text": "Not reason,\\nmiracles sway people.",
      "status": "imported"
    },
    "voice_102:r_9680dcd0fddcfcc7": {
      "text": "You've made the most foolish move.",
      "status": "imported"
    },
    "voice_102:r_2a00f1044ad5cbaa": {
      "text": "No. You're mistaken.",
      "status": "imported"
    },
    "voice_102:r_3dbeead1bd3164ef": {
      "text": "I have no time to play along.",
      "status": "imported"
    },
    "voice_102:r_98d15b8cc09bc915": {
      "text": "I've read your pattern!",
      "status": "imported"
    },
    "voice_102:r_46e86d000250e137": {
      "text": "Just where I knew you'd go...",
      "status": "imported"
    },
    "voice_102:r_ac341e7976e88f0b": {
      "text": "That's all your skill can manage.",
      "status": "imported"
    },
    "voice_102:r_cdbd128a5b4127cc": {
      "text": "Energy wasted.\\nIn short, futile.",
      "status": "imported"
    },
    "voice_102:r_cfccaa1fbeda124c": {
      "text": "I can tell...!\\nHa ha ha ha ha ha!",
      "status": "imported"
    },
    "voice_102:r_b1f8ec192b9c083a": {
      "text": "Yes, this too is only natural.",
      "status": "imported"
    },
    "voice_102:r_a007f9ab9cf048b3": {
      "text": "Futile. Heh heh heh... Hahahahahaha!",
      "status": "imported"
    },
    "voice_102:r_de1213040856c089": {
      "text": "What? You're no challenge...",
      "status": "imported"
    },
    "voice_102:r_3304412ac41f47a6": {
      "text": "Pathetic. Old methods, old thinking.",
      "status": "imported"
    },
    "voice_102:r_0c0775e051211840": {
      "text": "Gah! You persistent pest!",
      "status": "imported"
    },
    "voice_102:r_a2afffe1c396f0b3": {
      "text": "A blunder...? Even so!",
      "status": "imported"
    },
    "voice_102:r_13c25fbdfddc8a24": {
      "text": "What? Could I have misread this...?",
      "status": "imported"
    },
    "voice_102:r_42ba1ecb310b4bd7": {
      "text": "Damn...!\\nI knew it in theory!",
      "status": "imported"
    },
    "voice_102:r_d692f1d420460a47": {
      "text": "Don't touch me, you scum...!",
      "status": "imported"
    },
    "voice_102:r_a5643cec86b18bd2": {
      "text": "This is enough to gauge its specs.",
      "status": "imported"
    },
    "voice_102:r_68f2dfab20a4a30e": {
      "text": "Your weakness is almost pitiable.",
      "status": "imported"
    },
    "voice_102:r_9cedad8237480563": {
      "text": "Hmph... You'll never break this.",
      "status": "imported"
    },
    "voice_102:r_a03fabecba1508ca": {
      "text": "Before the Absolute Guard Zone!",
      "status": "imported"
    },
    "voice_102:r_5391b24a71eb10ae": {
      "text": "This is the power of Shinkiro.",
      "status": "imported"
    },
    "voice_102:r_a554ceef5c87b972": {
      "text": "As expected, Rakshata...\\nFine work.",
      "status": "imported"
    },
    "voice_102:r_546c3d5937fbb7ee": {
      "text": "Ngh... What a disgrace!",
      "status": "imported"
    },
    "voice_102:r_1568ff6298b12b96": {
      "text": "Damn it, stay out of my way!",
      "status": "imported"
    },
    "voice_102:r_2c9d94ba13c5fc50": {
      "text": "Don't stand in my way!",
      "status": "imported"
    },
    "voice_102:r_a77f4913375098d2": {
      "text": "My prediction was wrong?!",
      "status": "imported"
    },
    "voice_102:r_428c2116ac3071b1": {
      "text": "Tch! You changed your pattern...!",
      "status": "imported"
    },
    "voice_102:r_84c116267b79f540": {
      "text": "Clever. You read my movements...!",
      "status": "imported"
    },
    "voice_102:r_dad38ee29af2df3a": {
      "text": "Tch! An anomaly?!",
      "status": "imported"
    },
    "voice_102:r_3d32e86f8dc80909": {
      "text": "A dangerous card was hidden here...!",
      "status": "imported"
    },
    "voice_102:r_70451ffbabe2f876": {
      "text": "My apologies. I misjudged you.\\nBut!",
      "status": "imported"
    },
    "voice_102:r_69dfa1659715e2fa": {
      "text": "What?! What's happening...!?",
      "status": "imported"
    },
    "voice_102:r_d996fd6d4ef5b329": {
      "text": "I cannot let it end here!",
      "status": "imported"
    },
    "voice_102:r_8ab47a28f99ef565": {
      "text": "All my predictions were wrong...?!",
      "status": "imported"
    },
    "voice_102:r_546de3fb6db156ea": {
      "text": "That's right. I need no way back!",
      "status": "imported"
    },
    "voice_102:r_ca85f87cee5e31f7": {
      "text": "I won't turn back...!",
      "status": "imported"
    },
    "voice_102:r_9072ea7bc71df136": {
      "text": "I'll win!\\nEven from this despair!",
      "status": "imported"
    },
    "voice_102:r_04e815a8d425827d": {
      "text": "I still have a duty to fulfill...!",
      "status": "imported"
    },
    "voice_102:r_d89011fe3e5d082a": {
      "text": "My actions led here... No, my due?!",
      "status": "imported"
    },
    "voice_102:r_3c5b0c2ac812d5de": {
      "text": "We have to withdraw for now...!",
      "status": "imported"
    },
    "voice_102:r_5b9e8897190892eb": {
      "text": "I was completely outread...!",
      "status": "imported"
    },
    "voice_102:r_7bea3023abbf8a94": {
      "text": "Naive... Under 10% can still hit!",
      "status": "imported"
    },
    "voice_102:r_dd01a4c0d1b36a8d": {
      "text": "Reload my save? No! There's no time.",
      "status": "imported"
    },
    "voice_102:r_20920ad2eb3542db": {
      "text": "Time's up. No retreat. I choose...!",
      "status": "imported"
    },
    "voice_102:r_0ab7914877fd48ed": {
      "text": "Lelouch vi Britannia commands you.",
      "status": "imported"
    },
    "voice_102:r_cb846feec748c2e3": {
      "text": "All of you, die!",
      "status": "imported"
    },
    "voice_102:r_c958860b0676b1f5": {
      "text": "You... You'll die by my own hand!",
      "status": "imported"
    },
    "voice_102:r_5e2669b82ef75ce3": {
      "text": "Lelouch commands...! World, obey me!",
      "status": "imported"
    },
    "voice_102:r_7847e0ed7dc9282d": {
      "text": "Thank you... I love you, Nunnally...",
      "status": "imported"
    },
    "voice_102:r_9b9726b1872759d6": {
      "text": "I fight!\\nall who abuse their power!",
      "status": "imported"
    },
    "voice_102:r_3fd86c1027f317c8": {
      "text": "Only a King can take down a King!",
      "status": "imported"
    },
    "voice_102:r_f1e7ed9e5874aba5": {
      "text": "You read our thoughts?!",
      "status": "imported"
    },
    "voice_102:r_fc25e66a86fc2c85": {
      "text": "Gah...! A chance encounter, then!",
      "status": "imported"
    },
    "voice_102:r_5aeeb4917340c42d": {
      "text": "Small fry!\\nI've no time for you!",
      "status": "imported"
    },
    "voice_102:r_b765659981b6516d": {
      "text": "Hmph... I see. Is that all...?!",
      "status": "imported"
    },
    "voice_102:r_0c427458bc00eb95": {
      "text": "You mean to test me...?",
      "status": "imported"
    },
    "voice_102:r_774a9ab4d8fd5351": {
      "text": "How dull, when all goes as I read.",
      "status": "imported"
    },
    "voice_102:r_d3f01de714c015bd": {
      "text": "So this too is part of a miracle.",
      "status": "imported"
    },
    "voice_102:r_ceb935ccbf830724": {
      "text": "This world has no place for you!",
      "status": "imported"
    },
    "voice_102:r_862ef7385bf2abd4": {
      "text": "I deny you!\\nBegone from this world!",
      "status": "imported"
    },
    "voice_102:r_001cbec4d9a4283f": {
      "text": "Now... God or Demon King. Who wins?",
      "status": "imported"
    },
    "voice_102:r_8ad40afecd02b41e": {
      "text": "Seal that vaunted mobility, and...!",
      "status": "imported"
    },
    "voice_102:r_8165e5b41f0124c4": {
      "text": "Hmph. Using me to clear the way?",
      "status": "imported"
    },
    "voice_102:r_4e05581b7432cce8": {
      "text": "Perhaps I'll let myself be used...",
      "status": "imported"
    },
    "voice_102:r_a60b107ea3c36a86": {
      "text": "Very well. Leave this side to me.",
      "status": "imported"
    },
    "voice_102:r_e33693e5ba4665b0": {
      "text": "If this is the best course!",
      "status": "imported"
    },
    "voice_102:r_72a21a1a489af001": {
      "text": "It is certainly an effective move.",
      "status": "imported"
    },
    "voice_102:r_eb643f8bf737a0ca": {
      "text": "You dare treat me as a pawn...",
      "status": "imported"
    },
    "voice_102:r_0a3fccb71ec6cf2a": {
      "text": "Oh? You chose the surest method.",
      "status": "imported"
    },
    "voice_102:r_9b63cf1f3e0207ef": {
      "text": "That clears one condition...",
      "status": "imported"
    },
    "voice_102:r_8356f4e3dcdff938": {
      "text": "You mere lackey...!",
      "status": "imported"
    }
  }
}
