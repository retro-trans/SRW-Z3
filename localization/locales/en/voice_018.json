{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_018:r_479b340ccc6c572b": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_018:r_77949221bf58f862": {
      "text": "There!",
      "status": "imported"
    },
    "voice_018:r_70b9c4b9f1f37eff": {
      "text": "Got you!",
      "status": "imported"
    },
    "voice_018:r_9fcb3754cb1773c7": {
      "text": "I'll shoot you down!",
      "status": "imported"
    },
    "voice_018:r_3559d2fad32c2435": {
      "text": "Drop dead!",
      "status": "imported"
    },
    "voice_018:r_f7570547e9f80a64": {
      "text": "You're wide open!",
      "status": "imported"
    },
    "voice_018:r_cbab0f4720e1fcf1": {
      "text": "Target confirmed! Attack!",
      "status": "imported"
    },
    "voice_018:r_0bbe0b4f5364e732": {
      "text": "Now, let's see what you've got!",
      "status": "imported"
    },
    "voice_018:r_5dda5198137cb02a": {
      "text": "I've already assessed your forces!",
      "status": "imported"
    },
    "voice_018:r_83ec59afbecdec14": {
      "text": "Just as we anticipated!",
      "status": "imported"
    },
    "voice_018:r_e20bfd42ad95a3c9": {
      "text": "It's all part of the business!",
      "status": "imported"
    },
    "voice_018:r_0f58a8822381e57f": {
      "text": "Everything is going to plan!",
      "status": "imported"
    },
    "voice_018:r_6dbcc507fb61b51d": {
      "text": "Come on! Dance until you die!",
      "status": "imported"
    },
    "voice_018:r_b42ab697149a7c8a": {
      "text": "Looks like I've caught my prey!",
      "status": "imported"
    },
    "voice_018:r_4de4fcf3b440baf4": {
      "text": "Resistance is pointless!",
      "status": "imported"
    },
    "voice_018:r_0121a166c715cdff": {
      "text": "I can see your every move!",
      "status": "imported"
    },
    "voice_018:r_30fad37a42bd3ad3": {
      "text": "Say your farewells to this world!",
      "status": "imported"
    },
    "voice_018:r_80a0b2a84e05d81a": {
      "text": "My years at war weren't for show!",
      "status": "imported"
    },
    "voice_018:r_4a9ac1dff86506d9": {
      "text": "This thing won't be easy to stop!",
      "status": "imported"
    },
    "voice_018:r_bc8538e6af3d2577": {
      "text": "Its power is anything but ordinary!",
      "status": "imported"
    },
    "voice_018:r_924516c8de2b5342": {
      "text": "I feel like a giant!",
      "status": "imported"
    },
    "voice_018:r_da1174533722333f": {
      "text": "I'll crush you with sheer power!",
      "status": "imported"
    },
    "voice_018:r_fdeb8162976e72c1": {
      "text": "I'll show you this thing's power!",
      "status": "imported"
    },
    "voice_018:r_0fadb5c26df92b42": {
      "text": "I'll master this thing!",
      "status": "imported"
    },
    "voice_018:r_6b15af9a0057cdc8": {
      "text": "I was given their latest machine!",
      "status": "imported"
    },
    "voice_018:r_15b4a90140e8a33a": {
      "text": "It's nothing like my old machines!",
      "status": "imported"
    },
    "voice_018:r_af884a6b11dff121": {
      "text": "Impressive,\\nthis Lambda Driver!",
      "status": "imported"
    },
    "voice_018:r_ac6fe7838e95647b": {
      "text": "With the Lambda Driver's power...!",
      "status": "imported"
    },
    "voice_018:r_77ca87eacd17ad52": {
      "text": "Think you're a hero of justice?!",
      "status": "imported"
    },
    "voice_018:r_bf3244994760e535": {
      "text": "What an obnoxious bunch...!",
      "status": "imported"
    },
    "voice_018:r_aabfb21c9d069ce7": {
      "text": "We're both merchants of war!",
      "status": "imported"
    },
    "voice_018:r_02479dc8fe989560": {
      "text": "Your prized new gear\\nis scrap!",
      "status": "imported"
    },
    "voice_018:r_a2df00f91a9b0a9e": {
      "text": "So the famous white one is here...!",
      "status": "imported"
    },
    "voice_018:r_48b60d6c48b9b142": {
      "text": "I know\\nall about your danger!",
      "status": "imported"
    },
    "voice_018:r_8927e6fb681aa809": {
      "text": "Sink that one, get a special bonus!",
      "status": "imported"
    },
    "voice_018:r_665f01666859013b": {
      "text": "I've heard!\\nThe famous Toy Box!",
      "status": "imported"
    },
    "voice_018:r_a571eec59b258d11": {
      "text": "What is that fluffy thing?!",
      "status": "imported"
    },
    "voice_018:r_ddbe581c5ea9183d": {
      "text": "Absurd! A mascot suit in battle?!",
      "status": "imported"
    },
    "voice_018:r_faae935cca0edc72": {
      "text": "Mouse?! Bear?! Some sort of UMA?!",
      "status": "imported"
    },
    "voice_018:r_d4430bf362340b32": {
      "text": "Use speed all you like, big oaf!",
      "status": "imported"
    },
    "voice_018:r_6ff1323b355593e0": {
      "text": "An expensive one-off toy, huh?!",
      "status": "imported"
    },
    "voice_018:r_b7b5625d7cd4282f": {
      "text": "Flashy machines make great targets!",
      "status": "imported"
    },
    "voice_018:r_36133ad73a73ef98": {
      "text": "We're both scum. Let's be friends!",
      "status": "imported"
    },
    "voice_018:r_920740a0219c5085": {
      "text": "Don't think an AT can beat an AS!",
      "status": "imported"
    },
    "voice_018:r_a8451712c57c1a72": {
      "text": "Martial calls you\\nUntouchable...!",
      "status": "imported"
    },
    "voice_018:r_3633df5b7b8f47fa": {
      "text": "A Gundam!\\nI wanted this fight!",
      "status": "imported"
    },
    "voice_018:r_52dfc56b14b93551": {
      "text": "A Gundam kill would boost my fame!",
      "status": "imported"
    },
    "voice_018:r_1b9b2aab5cb104da": {
      "text": "Even tougher than the rumors...!",
      "status": "imported"
    },
    "voice_018:r_342044c706a2340f": {
      "text": "A knockoff Gundam is my opponent?!",
      "status": "imported"
    },
    "voice_018:r_cf41e8828a90cbdb": {
      "text": "The Earth Federation's dog is here!",
      "status": "imported"
    },
    "voice_018:r_719e897304ec42d4": {
      "text": "You people\\nruined my business!",
      "status": "imported"
    },
    "voice_018:r_d5e0a2317c40d322": {
      "text": "Celestial Being has sunk this low?!",
      "status": "imported"
    },
    "voice_018:r_ec2ea17765052401": {
      "text": "Terrorist\\nturned Federation pawn...!",
      "status": "imported"
    },
    "voice_018:r_5d08ad19e2da125b": {
      "text": "So the Preventer's Gundam is here!",
      "status": "imported"
    },
    "voice_018:r_a7246b52782a877e": {
      "text": "One Black Knights survivor remains!",
      "status": "imported"
    },
    "voice_018:r_dc8701f6bcb9904f": {
      "text": "So I face the infamous Zero...!",
      "status": "imported"
    },
    "voice_018:r_d6bdd730f24f66eb": {
      "text": "I'll kill you before you scurry off!",
      "status": "imported"
    },
    "voice_018:r_41997412868c48c4": {
      "text": "Don't think speed alone can win!",
      "status": "imported"
    },
    "voice_018:r_9e6cf4f389dae55c": {
      "text": "Stay at your desk\\nwhere you belong!",
      "status": "imported"
    },
    "voice_018:r_065443f6ddfcf0d7": {
      "text": "So an amateur came waltzing in!",
      "status": "imported"
    },
    "voice_018:r_eb7ae28b53dc033c": {
      "text": "Negotiations are over,\\nNegotiator!",
      "status": "imported"
    },
    "voice_018:r_857c4a52ce8df0fd": {
      "text": "A remote-controlled puppet...!",
      "status": "imported"
    },
    "voice_018:r_55417493fce1d347": {
      "text": "What is that?!\\nIs it a machine?!",
      "status": "imported"
    },
    "voice_018:r_8fdf5910927c9591": {
      "text": "Sink that ship, and we win!",
      "status": "imported"
    },
    "voice_018:r_7d724dbcc4451e10": {
      "text": "I'll hit the bridge dead-on!",
      "status": "imported"
    },
    "voice_018:r_93e25418a203cb8f": {
      "text": "This thing won't be overpowered!",
      "status": "imported"
    },
    "voice_018:r_adeb0a29274d3d9b": {
      "text": "A true battle between giants!",
      "status": "imported"
    },
    "voice_018:r_24cf161287ef9d5c": {
      "text": "Tremble before overwhelming power!",
      "status": "imported"
    },
    "voice_018:r_128c35bf3e0e394c": {
      "text": "You little rat! I'll crush you!",
      "status": "imported"
    },
    "voice_018:r_620fedec67706d7d": {
      "text": "Our gear's even! Skill decides it!",
      "status": "imported"
    },
    "voice_018:r_9680dcd0fddcfcc7": {
      "text": "Lambda Drivers clashing head-on!",
      "status": "imported"
    },
    "voice_018:r_2a00f1044ad5cbaa": {
      "text": "A mere AS can't defeat this thing!",
      "status": "imported"
    },
    "voice_018:r_3dbeead1bd3164ef": {
      "text": "Ordinary machines are no threat!",
      "status": "imported"
    },
    "voice_018:r_98902fd3143c393e": {
      "text": "It's my turn from here on out!",
      "status": "imported"
    },
    "voice_018:r_d907fbd7bc1c4298": {
      "text": "Now then, time to return the favor!",
      "status": "imported"
    },
    "voice_018:r_96b21e3a028dd074": {
      "text": "I'll turn the tide!",
      "status": "imported"
    },
    "voice_018:r_ce140b5d8e6b7310": {
      "text": "It's about time you shut up!",
      "status": "imported"
    },
    "voice_018:r_0e0335789c5396d7": {
      "text": "I have the right to attack too!",
      "status": "imported"
    },
    "voice_018:r_a8e85bd950696403": {
      "text": "I'll hit you before you can escape!",
      "status": "imported"
    },
    "voice_018:r_772c8bc40ab6cb61": {
      "text": "Only a fool permits a counterattack!",
      "status": "imported"
    },
    "voice_018:r_58dd2826a199ef51": {
      "text": "I won't let it end with me beaten!",
      "status": "imported"
    },
    "voice_018:r_aadc0b2442adb93b": {
      "text": "Now we're even!",
      "status": "imported"
    },
    "voice_018:r_e7a8cd8ed5bc2d1b": {
      "text": "Too bad. I'm still alive!",
      "status": "imported"
    },
    "voice_018:r_041dd920da4a7c17": {
      "text": "We'll finish this together!",
      "status": "imported"
    },
    "voice_018:r_c7f4280cde4605b3": {
      "text": "I'll deliver the finishing blow!",
      "status": "imported"
    },
    "voice_018:r_ec349c8ea9511a18": {
      "text": "In battle, one slip means death!",
      "status": "imported"
    },
    "voice_018:r_33236ffa3ea95b68": {
      "text": "As expected of you, Fe...!",
      "status": "imported"
    },
    "voice_018:r_689d0b123de71ae0": {
      "text": "Gates,\\nfall back at once!",
      "status": "imported"
    },
    "voice_018:r_84883aa95f63ce32": {
      "text": "This time, I'll finish you off!",
      "status": "imported"
    },
    "voice_018:r_25493e978ce8ff16": {
      "text": "Too bad!\\nMy attack isn't over yet!",
      "status": "imported"
    },
    "voice_018:r_7316666150e42960": {
      "text": "Gwaaaaaaah...!",
      "status": "imported"
    },
    "voice_018:r_c4f11aa93dc5b668": {
      "text": "Impossible! You're this strong...!",
      "status": "imported"
    },
    "voice_018:r_ce1a22dfe3a4d339": {
      "text": "No! The machine won't hold...!",
      "status": "imported"
    },
    "voice_018:r_240651adab81e145": {
      "text": "No! This will ruin the plan...!",
      "status": "imported"
    },
    "voice_018:r_cff0deaae73c2858": {
      "text": "Losing such an expensive unit...!",
      "status": "imported"
    },
    "voice_018:r_dca67f68a573fab7": {
      "text": "Eject! Survival comes first!",
      "status": "imported"
    },
    "voice_018:r_a6630215fefaf294": {
      "text": "No mascot suit...! That's a demon!",
      "status": "imported"
    },
    "voice_018:r_6f94566ad37f8ff8": {
      "text": "Bonta-kun is truly terrifying!",
      "status": "imported"
    },
    "voice_018:r_942ca03c9de80143": {
      "text": "Damn...! That's no ordinary soldier!",
      "status": "imported"
    },
    "voice_018:r_d8c669c70659e18a": {
      "text": "They really have gathered the best!",
      "status": "imported"
    },
    "voice_018:r_8f5bade7ac2db78e": {
      "text": "You've been a hero\\nfor good reason!",
      "status": "imported"
    },
    "voice_018:r_05ea490d2f522520": {
      "text": "So you're no mere AS after all...!",
      "status": "imported"
    },
    "voice_018:r_f5658c702d91db7a": {
      "text": "Strong...!\\nBeyond the intel I had!",
      "status": "imported"
    },
    "voice_018:r_686df329b50f195b": {
      "text": "All our moves\\nwere completely read?!",
      "status": "imported"
    },
    "voice_018:r_25f0ab0fa3cf690c": {
      "text": "That captain...! What a demon!",
      "status": "imported"
    },
    "voice_018:r_b708a1d959013dbf": {
      "text": "Am I...?! Is this a nightmare?!",
      "status": "imported"
    },
    "voice_018:r_59fca03e929366c1": {
      "text": "Damn! Is the power gap that vast?!",
      "status": "imported"
    },
    "voice_018:r_0d65eb631dcb7514": {
      "text": "That 'Super' name isn't for show!",
      "status": "imported"
    },
    "voice_018:r_d03018a31e23f1e9": {
      "text": "Gundam!\\nSo you're more than a name!",
      "status": "imported"
    },
    "voice_018:r_279da5f732aa8847": {
      "text": "Fearsome!\\nThat Gundam and pilot!",
      "status": "imported"
    },
    "voice_018:r_97f82e3cb6f70110": {
      "text": "Strong...! Truly the Untouchable!",
      "status": "imported"
    },
    "voice_018:r_c5611d8dd6def96b": {
      "text": "Damn...!\\nWhat did you live through?!",
      "status": "imported"
    },
    "voice_018:r_6f12cc8ed2732eb5": {
      "text": "Celestial Being!\\nDamn you all!",
      "status": "imported"
    },
    "voice_018:r_7abfc55f8fb62ba7": {
      "text": "Damn Preventer! Persistent pests!",
      "status": "imported"
    },
    "voice_018:r_99e7a66c650b5892": {
      "text": "The Black Knights legend lives on!",
      "status": "imported"
    },
    "voice_018:r_5b2247b5cfbcd7b2": {
      "text": "A mere salaryman\\npushed me this far!",
      "status": "imported"
    },
    "voice_018:r_e09b933e3e706779": {
      "text": "Damn! What the hell is going on?!",
      "status": "imported"
    },
    "voice_018:r_66236eb99b676e5b": {
      "text": "Whoa! That bastard's unbelievable!",
      "status": "imported"
    },
    "voice_018:r_9639a2dbcd2f58ed": {
      "text": "It seems\\nmy time is finally up...!",
      "status": "imported"
    },
    "voice_018:r_aeea0893acb93d35": {
      "text": "They're one step ahead of me...!",
      "status": "imported"
    },
    "voice_018:r_b31568654e53487b": {
      "text": "As I thought - no easy opponent...!",
      "status": "imported"
    },
    "voice_018:r_2502132569141ea3": {
      "text": "Our every read\\nmissed the mark...!",
      "status": "imported"
    },
    "voice_018:r_1ff312798a52c8eb": {
      "text": "Tch! Still no order to retreat?!",
      "status": "imported"
    },
    "voice_018:r_fa07d90fca62f593": {
      "text": "A real crisis, after so long...!",
      "status": "imported"
    },
    "voice_018:r_a25bf2676ecf9d83": {
      "text": "The voltage is unstable! Hurry!",
      "status": "imported"
    },
    "voice_018:r_237a0288b42dce20": {
      "text": "Hold on a bit longer, you heap...!",
      "status": "imported"
    },
    "voice_018:r_0556e8a22779ea8e": {
      "text": "One step short of a fatal blow!",
      "status": "imported"
    },
    "voice_018:r_09d377101a48d92a": {
      "text": "If I die here,\\nmy reward's gone!",
      "status": "imported"
    },
    "voice_018:r_11517cc7b0494dbf": {
      "text": "Time to brace myself again...!",
      "status": "imported"
    },
    "voice_018:r_b5864501463db244": {
      "text": "I admit your strength, not defeat!",
      "status": "imported"
    },
    "voice_018:r_a88939ea84b4474d": {
      "text": "The best soldiers always survive...!",
      "status": "imported"
    },
    "voice_018:r_20cfb719db02fafd": {
      "text": "The plan needs a slight revision...",
      "status": "imported"
    },
    "voice_018:r_570c1fdf72edb283": {
      "text": "Not bad... Interesting prey at last.",
      "status": "imported"
    },
    "voice_018:r_23f0d87a5a6cfca1": {
      "text": "Stay calm... Never rush in battle.",
      "status": "imported"
    },
    "voice_018:r_60c94ea4eb7f7404": {
      "text": "Even I let my guard down.",
      "status": "imported"
    },
    "voice_018:r_727b2ee0277f9159": {
      "text": "Class B damage, lower right arm?!",
      "status": "imported"
    },
    "voice_018:r_cff4d2eae8a939ed": {
      "text": "This is getting rather dull...",
      "status": "imported"
    },
    "voice_018:r_1428fe5f35a9427b": {
      "text": "But your struggle ends here!",
      "status": "imported"
    },
    "voice_018:r_96d39b8bdfa6f183": {
      "text": "I must reconsider, reluctantly...!",
      "status": "imported"
    },
    "voice_018:r_0e4f9b8a2d26ebff": {
      "text": "I'm breaking out in a cold sweat...!",
      "status": "imported"
    },
    "voice_018:r_79e0d542fe12bcf7": {
      "text": "You keep throwing me off my pace...!",
      "status": "imported"
    },
    "voice_018:r_eff747ba39a55393": {
      "text": "Their kind\\ngets deadly if cocky...!",
      "status": "imported"
    },
    "voice_018:r_b2dc77aa6dd77e69": {
      "text": "As expected, they're\\na cut above...!",
      "status": "imported"
    },
    "voice_018:r_445d40d8b5d7092b": {
      "text": "The difference in power is obvious.",
      "status": "imported"
    },
    "voice_018:r_bbb633cb5e8e6daf": {
      "text": "You still defy me after all that?",
      "status": "imported"
    },
    "voice_018:r_0abd8b6c713ccdac": {
      "text": "Think this is enough to stop me?",
      "status": "imported"
    },
    "voice_018:r_f4ff463b2fda1b86": {
      "text": "That was a direct hit? Pathetic.",
      "status": "imported"
    },
    "voice_018:r_4e63c037d3cb8a3d": {
      "text": "That attack did catch me off guard.",
      "status": "imported"
    },
    "voice_018:r_9ca8d188ae805e3a": {
      "text": "Bilateral angle needs adjustment...",
      "status": "imported"
    },
    "voice_018:r_795ed21f3e28e1f5": {
      "text": "What a pointless thing to do...!",
      "status": "imported"
    },
    "voice_018:r_141415c1def5ab2d": {
      "text": "Small fry...! Give it up already!",
      "status": "imported"
    },
    "voice_018:r_c894e35becf35a03": {
      "text": "What a boring attack.",
      "status": "imported"
    },
    "voice_018:r_79b1abf5fc86483c": {
      "text": "No reason for me to let that hit.",
      "status": "imported"
    },
    "voice_018:r_e9a11621911acb19": {
      "text": "Go ahead and stew over it.",
      "status": "imported"
    },
    "voice_018:r_d52bece55796f599": {
      "text": "No unnecessary movement.",
      "status": "imported"
    },
    "voice_018:r_358fe5a50bbee1df": {
      "text": "That sloppy attack won't hit me...!",
      "status": "imported"
    },
    "voice_018:r_638834e16724002f": {
      "text": "You move like a rank amateur.",
      "status": "imported"
    },
    "voice_018:r_b02fca1590ac1210": {
      "text": "Whoa, that was a close one!",
      "status": "imported"
    },
    "voice_018:r_f0344d2fbaa9db77": {
      "text": "I've no time for your little games!",
      "status": "imported"
    },
    "voice_018:r_3328eef766ff2c2c": {
      "text": "That won't work on me!",
      "status": "imported"
    },
    "voice_018:r_23b037cf6ccc695c": {
      "text": "I can pull off tricks like this too!",
      "status": "imported"
    },
    "voice_018:r_883ad1128d340c5e": {
      "text": "I brought the right gear for this!",
      "status": "imported"
    },
    "voice_018:r_5691cc71770ffdde": {
      "text": "Call this my invisible shield.",
      "status": "imported"
    },
    "voice_018:r_964e07c5563a5508": {
      "text": "I have a Lambda Driver of my own!",
      "status": "imported"
    },
    "voice_018:r_db54e717bff3e3b2": {
      "text": "It's handy,\\nthis Lambda Driver...!",
      "status": "imported"
    },
    "voice_018:r_fcab8d80aef7e9d8": {
      "text": "Tch! Am I out of options?!",
      "status": "imported"
    },
    "voice_018:r_2174bd0edc164171": {
      "text": "This hinders the operation...!",
      "status": "imported"
    },
    "voice_018:r_ad54419336b49578": {
      "text": "Have I fallen into their trap...?",
      "status": "imported"
    },
    "voice_018:r_63c353e1e05e8e39": {
      "text": "You must be skilled to outwit me...!",
      "status": "imported"
    },
    "voice_018:r_87646dd472438e88": {
      "text": "A surprisingly dirty trick...!",
      "status": "imported"
    },
    "voice_018:r_4e32ac89cba02001": {
      "text": "To fall for such a basic tactic...!",
      "status": "imported"
    },
    "voice_018:r_02d24e5915bfa5b7": {
      "text": "I won't let you!",
      "status": "imported"
    },
    "voice_018:r_9331c2c2ef55c78f": {
      "text": "I'll be your shield!",
      "status": "imported"
    },
    "voice_018:r_49734bdb3507acf7": {
      "text": "Fall back while you still can!",
      "status": "imported"
    },
    "voice_018:r_2a730c9b4df0dca3": {
      "text": "I'll cover Fe!",
      "status": "imported"
    },
    "voice_018:r_1e5842ba5dc3f705": {
      "text": "You're far too cocky, Gates!",
      "status": "imported"
    },
    "voice_018:r_9747bd61ad23ecd3": {
      "text": "Stay right where you are!",
      "status": "imported"
    },
    "voice_018:r_6823f8abe05c4727": {
      "text": "I'll land a direct hit!",
      "status": "imported"
    },
    "voice_018:r_b8ccfd8b8ac323ac": {
      "text": "At this range, this will do!",
      "status": "imported"
    },
    "voice_018:r_c885ff2097749991": {
      "text": "I won't miss!",
      "status": "imported"
    },
    "voice_018:r_a8da7f8d8b705db0": {
      "text": "You can't escape my sights!",
      "status": "imported"
    },
    "voice_018:r_02e1c5e19de5bd22": {
      "text": "Target locked!",
      "status": "imported"
    },
    "voice_018:r_6fb823898811e210": {
      "text": "Engaging in close combat!",
      "status": "imported"
    },
    "voice_018:r_5dcbcf1682cc3ab8": {
      "text": "Diving in!",
      "status": "imported"
    },
    "voice_018:r_5a20988e743dc1d0": {
      "text": "Closing the distance!",
      "status": "imported"
    },
    "voice_018:r_197f05bf899b7697": {
      "text": "I'll make this a melee!",
      "status": "imported"
    },
    "voice_018:r_623ee03bd91ab2a1": {
      "text": "Use the Lambda Driver!",
      "status": "imported"
    },
    "voice_018:r_c5c491f8761152f0": {
      "text": "Raaaaagh!",
      "status": "imported"
    },
    "voice_018:r_15042263763f11bb": {
      "text": "Lambda Driver, activate!",
      "status": "imported"
    },
    "voice_018:r_96b3a8f080aea8b4": {
      "text": "Deyaaaah!",
      "status": "imported"
    },
    "voice_018:r_3d4fa015b8b31648": {
      "text": "I'll move ahead and engage!",
      "status": "imported"
    },
    "voice_018:r_c1f3167d7dd97543": {
      "text": "I'll draw the enemy's attention!",
      "status": "imported"
    },
    "voice_018:r_1ac46173650ffe13": {
      "text": "I'll handle the diversion!",
      "status": "imported"
    },
    "voice_018:r_53660d6bc7fe8513": {
      "text": "I'll provide support!",
      "status": "imported"
    },
    "voice_018:r_2e756557a1d92e8b": {
      "text": "We'll take them down one by one!",
      "status": "imported"
    },
    "voice_018:r_45d847e7b8d840e3": {
      "text": "So that's the target!",
      "status": "imported"
    },
    "voice_018:r_d2ebe8f28f2420cc": {
      "text": "If it's one-on-one!",
      "status": "imported"
    },
    "voice_018:r_3baa2292b050034a": {
      "text": "I can't afford any mistakes!",
      "status": "imported"
    }
  }
}
