{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_012:r_479b340ccc6c572b": {
      "text": "This'll work!",
      "status": "imported"
    },
    "voice_012:r_77949221bf58f862": {
      "text": "I can do this!",
      "status": "imported"
    },
    "voice_012:r_70b9c4b9f1f37eff": {
      "text": "I'll knock you out of the sky!",
      "status": "imported"
    },
    "voice_012:r_9fcb3754cb1773c7": {
      "text": "I won't let you resist!",
      "status": "imported"
    },
    "voice_012:r_3559d2fad32c2435": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_012:r_f7570547e9f80a64": {
      "text": "I've got you!",
      "status": "imported"
    },
    "voice_012:r_cbab0f4720e1fcf1": {
      "text": "There!",
      "status": "imported"
    },
    "voice_012:r_0bbe0b4f5364e732": {
      "text": "At this range!",
      "status": "imported"
    },
    "voice_012:r_5dda5198137cb02a": {
      "text": "I won't let you have your way!",
      "status": "imported"
    },
    "voice_012:r_83ec59afbecdec14": {
      "text": "I'll stop you here!",
      "status": "imported"
    },
    "voice_012:r_e20bfd42ad95a3c9": {
      "text": "Here I come, Gundam!",
      "status": "imported"
    },
    "voice_012:r_0f58a8822381e57f": {
      "text": "I'll be the one to down Gundam!",
      "status": "imported"
    },
    "voice_012:r_6dbcc507fb61b51d": {
      "text": "Even if my foe is a Gundam!",
      "status": "imported"
    },
    "voice_012:r_b42ab697149a7c8a": {
      "text": "Fall, horned one!",
      "status": "imported"
    },
    "voice_012:r_0121a166c715cdff": {
      "text": "The flashy one goes down first!",
      "status": "imported"
    },
    "voice_012:r_4a9ac1dff86506d9": {
      "text": "A civilian firm has no place here!",
      "status": "imported"
    },
    "voice_012:r_924516c8de2b5342": {
      "text": "No matter how thick your armor is!",
      "status": "imported"
    },
    "voice_012:r_fdeb8162976e72c1": {
      "text": "I won't let you transform!",
      "status": "imported"
    },
    "voice_012:r_0fadb5c26df92b42": {
      "text": "I'll tear you to pieces!",
      "status": "imported"
    },
    "voice_012:r_6b15af9a0057cdc8": {
      "text": "I'll aim for the joints!",
      "status": "imported"
    },
    "voice_012:r_15b4a90140e8a33a": {
      "text": "I'll crush the weak points!",
      "status": "imported"
    },
    "voice_012:r_ac6fe7838e95647b": {
      "text": "Not all can be pierced!\\nYou'll see!",
      "status": "imported"
    },
    "voice_012:r_77ca87eacd17ad52": {
      "text": "Appearances won't fool me!",
      "status": "imported"
    },
    "voice_012:r_bf3244994760e535": {
      "text": "Size doesn't\\ndecide the battle!",
      "status": "imported"
    },
    "voice_012:r_aabfb21c9d069ce7": {
      "text": "It's only big! I'll flank it!",
      "status": "imported"
    },
    "voice_012:r_02479dc8fe989560": {
      "text": "If I sink the mothership!",
      "status": "imported"
    },
    "voice_012:r_a2df00f91a9b0a9e": {
      "text": "Hmph, what a huge target!",
      "status": "imported"
    },
    "voice_012:r_48b60d6c48b9b142": {
      "text": "What can such a tiny machine do?!",
      "status": "imported"
    },
    "voice_012:r_665f01666859013b": {
      "text": "Such a flimsy machine!",
      "status": "imported"
    },
    "voice_012:r_ddbe581c5ea9183d": {
      "text": "Damn, it's fast!",
      "status": "imported"
    },
    "voice_012:r_6ff1323b355593e0": {
      "text": "I'll exterminate you, monster!",
      "status": "imported"
    },
    "voice_012:r_b7b5625d7cd4282f": {
      "text": "You won't have your way with Earth!",
      "status": "imported"
    },
    "voice_012:r_ac341e7976e88f0b": {
      "text": "Fall!",
      "status": "imported"
    },
    "voice_012:r_cdbd128a5b4127cc": {
      "text": "I'll shoot right through you!",
      "status": "imported"
    },
    "voice_012:r_cfccaa1fbeda124c": {
      "text": "I'll hit you!",
      "status": "imported"
    },
    "voice_012:r_7847e0ed7dc9282d": {
      "text": "We'll finish this together!",
      "status": "imported"
    },
    "voice_012:r_e42b52c7a987b906": {
      "text": "I'll follow up!",
      "status": "imported"
    },
    "voice_012:r_6825fd1ff907bd22": {
      "text": "I'll cover you!",
      "status": "imported"
    },
    "voice_012:r_607f666f1563bc0d": {
      "text": "I'm here too, you know!",
      "status": "imported"
    },
    "voice_012:r_97b7431eeb81e6b6": {
      "text": "Take this one too!",
      "status": "imported"
    },
    "voice_012:r_132f605d02975e71": {
      "text": "This isn't over yet!",
      "status": "imported"
    },
    "voice_012:r_9b9726b1872759d6": {
      "text": "I-is this the end?!",
      "status": "imported"
    },
    "voice_012:r_1252db29683fefe0": {
      "text": "Uwaaaaaah!!",
      "status": "imported"
    },
    "voice_012:r_ad3d538f1e909184": {
      "text": "D-damn youuu!!",
      "status": "imported"
    },
    "voice_012:r_8c61c59a1c0aebbf": {
      "text": "I can't hold out! Uwoah!!",
      "status": "imported"
    },
    "voice_012:r_aba6a7662129d8ce": {
      "text": "I-I'm at my limit! Uaaagh!!",
      "status": "imported"
    },
    "voice_012:r_b84afafb8a33ec60": {
      "text": "This can't be happening!!",
      "status": "imported"
    },
    "voice_012:r_c8c59db85bf875e6": {
      "text": "T-the controls!!",
      "status": "imported"
    },
    "voice_012:r_391aa56435d9dd6e": {
      "text": "I won't let it end like this!",
      "status": "imported"
    },
    "voice_012:r_7c796ba53bd7ea03": {
      "text": "Ngh! I'll keep it going at any cost!",
      "status": "imported"
    },
    "voice_012:r_fa944da4b6519006": {
      "text": "W-what?!",
      "status": "imported"
    },
    "voice_012:r_95d047bcc17fccc6": {
      "text": "I won't just turn tail and run!!",
      "status": "imported"
    },
    "voice_012:r_640327a12a559b31": {
      "text": "What?! The output is dropping!!",
      "status": "imported"
    },
    "voice_012:r_bdd38c584fa313d0": {
      "text": "If the machine moves, I'll manage!!",
      "status": "imported"
    },
    "voice_012:r_3fd86c1027f317c8": {
      "text": "S-so this is Gundam's power...!",
      "status": "imported"
    },
    "voice_012:r_d0372a183d2007ad": {
      "text": "This isn't over yet, Gundam!",
      "status": "imported"
    },
    "voice_012:r_217aa5e1d545b44d": {
      "text": "Damn! They aim where it hurts!",
      "status": "imported"
    },
    "voice_012:r_381992c5d8224937": {
      "text": "Gah! The armor's been pierced!",
      "status": "imported"
    },
    "voice_012:r_f1e7ed9e5874aba5": {
      "text": "They read our every move!",
      "status": "imported"
    },
    "voice_012:r_fc25e66a86fc2c85": {
      "text": "Ngh! I can't track their movement!",
      "status": "imported"
    },
    "voice_012:r_5aeeb4917340c42d": {
      "text": "Damn! The sensors are shot!",
      "status": "imported"
    },
    "voice_012:r_b765659981b6516d": {
      "text": "W-what?! What was that attack?!",
      "status": "imported"
    },
    "voice_012:r_0c427458bc00eb95": {
      "text": "We can fight Gundam on equal terms!",
      "status": "imported"
    },
    "voice_012:r_774a9ab4d8fd5351": {
      "text": "Gundam! You won't have your way!",
      "status": "imported"
    },
    "voice_012:r_d3f01de714c015bd": {
      "text": "Ha! Is that all you've got?!",
      "status": "imported"
    },
    "voice_012:r_7d2617c809fead70": {
      "text": "Tch! I couldn't dodge it!",
      "status": "imported"
    },
    "voice_012:r_ceb935ccbf830724": {
      "text": "One or two wounds won't stop me!",
      "status": "imported"
    },
    "voice_012:r_862ef7385bf2abd4": {
      "text": "Damn them! They're holding back?!",
      "status": "imported"
    },
    "voice_012:r_001cbec4d9a4283f": {
      "text": "Hmph. They've underestimated me.",
      "status": "imported"
    },
    "voice_012:r_8ad40afecd02b41e": {
      "text": "Gundam! The rumors oversold you!",
      "status": "imported"
    },
    "voice_012:r_26e5efec03c03d78": {
      "text": "Is that all, Gundam?!",
      "status": "imported"
    },
    "voice_012:r_4ad81e88c7557a8b": {
      "text": "You shame the Gundam name!",
      "status": "imported"
    },
    "voice_012:r_1f65a7af190e4674": {
      "text": "I'll block it!",
      "status": "imported"
    },
    "voice_012:r_40c5a9358ed5bf29": {
      "text": "I've got a shield!",
      "status": "imported"
    },
    "voice_012:r_f2e18dfdfe0c89ea": {
      "text": "Like that'll hit me!",
      "status": "imported"
    },
    "voice_012:r_cf7dbf49e96a5755": {
      "text": "It won't be that easy!",
      "status": "imported"
    },
    "voice_012:r_fa96676cc65bb509": {
      "text": "I knew you'd try that!",
      "status": "imported"
    },
    "voice_012:r_4e37f92e7d2fc62e": {
      "text": "It won't go that smoothly!",
      "status": "imported"
    },
    "voice_012:r_66ab4cfe1557909d": {
      "text": "You're too naive!",
      "status": "imported"
    },
    "voice_012:r_0bad405ee6ca63ba": {
      "text": "That was nothing!",
      "status": "imported"
    },
    "voice_012:r_2072eaf71a260ae7": {
      "text": "Sloppy attack, Gundam!",
      "status": "imported"
    },
    "voice_012:r_6c13bbfd27a7799e": {
      "text": "I can do this! I can match Gundam!",
      "status": "imported"
    },
    "voice_012:r_06f88dcbd3c9e738": {
      "text": "That Gundam's nothing special!",
      "status": "imported"
    },
    "voice_012:r_b28faf9f71bc3598": {
      "text": "No attack matters if it can't hit!",
      "status": "imported"
    },
    "voice_012:r_8a29278549f8e07a": {
      "text": "I'll use my speed to throw you off!",
      "status": "imported"
    },
    "voice_012:r_7e6c573c26177f98": {
      "text": "That won't work!",
      "status": "imported"
    },
    "voice_012:r_45abf84f7757d6eb": {
      "text": "What the hell was that?!",
      "status": "imported"
    },
    "voice_012:r_4e05581b7432cce8": {
      "text": "I can't even touch them?!",
      "status": "imported"
    },
    "voice_012:r_a60b107ea3c36a86": {
      "text": "I'm a sitting duck like this!",
      "status": "imported"
    },
    "voice_012:r_e33693e5ba4665b0": {
      "text": "I'll have to wait for my chance...!",
      "status": "imported"
    },
    "voice_012:r_72a21a1a489af001": {
      "text": "I can't counterattack?! Damn it!",
      "status": "imported"
    },
    "voice_012:r_eb643f8bf737a0ca": {
      "text": "I'll have to pull back for now!",
      "status": "imported"
    },
    "voice_012:r_0a3fccb71ec6cf2a": {
      "text": "Must I let it get away?!",
      "status": "imported"
    },
    "voice_012:r_9b63cf1f3e0207ef": {
      "text": "I'll be done for if I don't retreat!",
      "status": "imported"
    },
    "voice_012:r_8356f4e3dcdff938": {
      "text": "I'll be the shield!",
      "status": "imported"
    },
    "voice_012:r_1d6d784036ae0bd7": {
      "text": "Fall back, now!",
      "status": "imported"
    },
    "voice_012:r_625664af02183c17": {
      "text": "I'll take the hit!",
      "status": "imported"
    },
    "voice_012:r_3701cba361f80ea5": {
      "text": "I'll step in!",
      "status": "imported"
    },
    "voice_012:r_63f429c5c68c0863": {
      "text": "I'll take you on!",
      "status": "imported"
    },
    "voice_012:r_38e4a434c91d8ef0": {
      "text": "Damn! I let my guard down!",
      "status": "imported"
    },
    "voice_012:r_98ed411352a3a6ac": {
      "text": "Hmph! What a pathetic display!",
      "status": "imported"
    },
    "voice_012:r_4824bea6bab3af67": {
      "text": "That won't be enough to stop us!",
      "status": "imported"
    },
    "voice_012:r_862b92e63adb9734": {
      "text": "Where are you even aiming?!",
      "status": "imported"
    },
    "voice_012:r_cb306ef55e49d107": {
      "text": "Just as I predicted!",
      "status": "imported"
    },
    "voice_012:r_57b2bd2de8a1408d": {
      "text": "Too bad for you!",
      "status": "imported"
    },
    "voice_012:r_76f080a4881e8ab5": {
      "text": "Like that'll work!",
      "status": "imported"
    },
    "voice_012:r_288133bc5b573dae": {
      "text": "It's no use!",
      "status": "imported"
    },
    "voice_012:r_6f95653e548f8fcf": {
      "text": "So what?!",
      "status": "imported"
    },
    "voice_012:r_6026da5acbda7c69": {
      "text": "I can't counterattack!",
      "status": "imported"
    },
    "voice_012:r_981f8fedd5414fe5": {
      "text": "Damn, I'm badly positioned!",
      "status": "imported"
    },
    "voice_012:r_96bb0dcde0c8c44a": {
      "text": "I can't even attack!",
      "status": "imported"
    },
    "voice_012:r_641550a2f54cb456": {
      "text": "It's nothing but a big machine!",
      "status": "imported"
    },
    "voice_012:r_d9cd2e4ded064396": {
      "text": "E-eject!",
      "status": "imported"
    },
    "voice_012:r_99e6349431aaf23b": {
      "text": "I'll use the shield!",
      "status": "imported"
    },
    "voice_012:r_ec1081caf845f56a": {
      "text": "This shield can take it!",
      "status": "imported"
    },
    "voice_012:r_2c5b7ee872c1ed7f": {
      "text": "Just as I thought - all show!",
      "status": "imported"
    }
  }
}
