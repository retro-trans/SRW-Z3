{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_136:r_479b340ccc6c572b": {
      "text": "Go down!",
      "status": "imported"
    },
    "voice_136:r_77949221bf58f862": {
      "text": "For peace for everyone!",
      "status": "imported"
    },
    "voice_136:r_70b9c4b9f1f37eff": {
      "text": "Don't underestimate me!",
      "status": "imported"
    },
    "voice_136:r_9fcb3754cb1773c7": {
      "text": "I won't let you beat me!",
      "status": "imported"
    },
    "voice_136:r_3559d2fad32c2435": {
      "text": "There!",
      "status": "imported"
    },
    "voice_136:r_f7570547e9f80a64": {
      "text": "Hit! Hit!!",
      "status": "imported"
    },
    "voice_136:r_cbab0f4720e1fcf1": {
      "text": "Now! Go!",
      "status": "imported"
    },
    "voice_136:r_0bbe0b4f5364e732": {
      "text": "So I'm on cleanup duty, Duo.",
      "status": "imported"
    },
    "voice_136:r_5dda5198137cb02a": {
      "text": "Heero, I'm fighting too!",
      "status": "imported"
    },
    "voice_136:r_83ec59afbecdec14": {
      "text": "I've got this, Quatre!",
      "status": "imported"
    },
    "voice_136:r_e20bfd42ad95a3c9": {
      "text": "I'll back you up, Trowa!",
      "status": "imported"
    },
    "voice_136:r_0f58a8822381e57f": {
      "text": "I can do this too, Wufei!",
      "status": "imported"
    },
    "voice_136:r_6dbcc507fb61b51d": {
      "text": "Noin, I'll follow your lead!",
      "status": "imported"
    },
    "voice_136:r_b42ab697149a7c8a": {
      "text": "I'm here too, you know!",
      "status": "imported"
    },
    "voice_136:r_4de4fcf3b440baf4": {
      "text": "I won't let this chance slip!",
      "status": "imported"
    },
    "voice_136:r_0121a166c715cdff": {
      "text": "Duo, go on ahead!",
      "status": "imported"
    },
    "voice_136:r_30fad37a42bd3ad3": {
      "text": "I'll protect everyone!",
      "status": "imported"
    },
    "voice_136:r_80a0b2a84e05d81a": {
      "text": "I know this is reckless!",
      "status": "imported"
    },
    "voice_136:r_4a9ac1dff86506d9": {
      "text": "Duo, don't look away!",
      "status": "imported"
    },
    "voice_136:r_bc8538e6af3d2577": {
      "text": "I won't let you hurt Duo!",
      "status": "imported"
    },
    "voice_136:r_924516c8de2b5342": {
      "text": "I'll cover you, Heero!",
      "status": "imported"
    },
    "voice_136:r_da1174533722333f": {
      "text": "Quatre, leave this to me!",
      "status": "imported"
    },
    "voice_136:r_fdeb8162976e72c1": {
      "text": "Fall back now, Trowa!",
      "status": "imported"
    },
    "voice_136:r_0fadb5c26df92b42": {
      "text": "Don't rush in too far, Wufei!",
      "status": "imported"
    },
    "voice_136:r_6b15af9a0057cdc8": {
      "text": "Noin, please fall back!",
      "status": "imported"
    },
    "voice_136:r_15b4a90140e8a33a": {
      "text": "I can't counterattack like this!",
      "status": "imported"
    },
    "voice_136:r_af884a6b11dff121": {
      "text": "Where'd they go?!",
      "status": "imported"
    },
    "voice_136:r_ac6fe7838e95647b": {
      "text": "They slipped into my blind spot?!",
      "status": "imported"
    },
    "voice_136:r_77ca87eacd17ad52": {
      "text": "All right, I dodged it!",
      "status": "imported"
    },
    "voice_136:r_bf3244994760e535": {
      "text": "Where are you aiming?",
      "status": "imported"
    },
    "voice_136:r_aabfb21c9d069ce7": {
      "text": "Whew... My training wasn't wasted.",
      "status": "imported"
    },
    "voice_136:r_02479dc8fe989560": {
      "text": "Th-That was a bit close, huh?",
      "status": "imported"
    },
    "voice_136:r_a2df00f91a9b0a9e": {
      "text": "I can't let Duo worry about me.",
      "status": "imported"
    },
    "voice_136:r_48b60d6c48b9b142": {
      "text": "I did it! Evasion successful!",
      "status": "imported"
    },
    "voice_136:r_8927e6fb681aa809": {
      "text": "Don't think I'll be an easy mark!",
      "status": "imported"
    },
    "voice_136:r_665f01666859013b": {
      "text": "An attack like that won't stop me!",
      "status": "imported"
    },
    "voice_136:r_a571eec59b258d11": {
      "text": "I-It hit! But I can still fight!",
      "status": "imported"
    },
    "voice_136:r_ddbe581c5ea9183d": {
      "text": "This damage won't make me flinch!",
      "status": "imported"
    },
    "voice_136:r_faae935cca0edc72": {
      "text": "S-Somehow, I made it...",
      "status": "imported"
    },
    "voice_136:r_d4430bf362340b32": {
      "text": "I'm okay! I can still fight!",
      "status": "imported"
    },
    "voice_136:r_6ff1323b355593e0": {
      "text": "I won't lose! It's only a scratch!",
      "status": "imported"
    },
    "voice_136:r_b7b5625d7cd4282f": {
      "text": "Aaaah!",
      "status": "imported"
    },
    "voice_136:r_36133ad73a73ef98": {
      "text": "Th-They're reading my every move?!",
      "status": "imported"
    },
    "voice_136:r_920740a0219c5085": {
      "text": "It still moves! I won't give up!",
      "status": "imported"
    },
    "voice_136:r_a8451712c57c1a72": {
      "text": "Do it! Losing heart means losing!",
      "status": "imported"
    },
    "voice_136:r_3633df5b7b8f47fa": {
      "text": "I'm not afraid...!\\nI'm ready too!",
      "status": "imported"
    },
    "voice_136:r_52dfc56b14b93551": {
      "text": "Aaaaaaaah!!",
      "status": "imported"
    },
    "voice_136:r_1b9b2aab5cb104da": {
      "text": "N-No...!\\nIt can't take any more!",
      "status": "imported"
    },
    "voice_136:r_342044c706a2340f": {
      "text": "Please, move!\\nJust a little longer!",
      "status": "imported"
    },
    "voice_136:r_cf41e8828a90cbdb": {
      "text": "N-No...!\\nMy circuits are shorting!",
      "status": "imported"
    },
    "voice_136:r_719e897304ec42d4": {
      "text": "One more hit and I won't last...!",
      "status": "imported"
    },
    "voice_136:r_d5e0a2317c40d322": {
      "text": "I-I'm ejecting!",
      "status": "imported"
    },
    "voice_136:r_ec2ea17765052401": {
      "text": "Aah! I-I can't go on...!",
      "status": "imported"
    },
    "voice_136:r_eb7ae28b53dc033c": {
      "text": "I'll make this hit!",
      "status": "imported"
    },
    "voice_136:r_857c4a52ce8df0fd": {
      "text": "We don't need peace handed to us!",
      "status": "imported"
    },
    "voice_136:r_8fdf5910927c9591": {
      "text": "I'll win peace with my own hands!",
      "status": "imported"
    },
    "voice_136:r_a007f9ab9cf048b3": {
      "text": "I'm just getting started!",
      "status": "imported"
    },
    "voice_136:r_3304412ac41f47a6": {
      "text": "We've got a barrier on our side!",
      "status": "imported"
    },
    "voice_136:r_a554ceef5c87b972": {
      "text": "I can do it now!",
      "status": "imported"
    },
    "voice_136:r_546c3d5937fbb7ee": {
      "text": "Zechs! I'll back you up!",
      "status": "imported"
    },
    "voice_136:r_1568ff6298b12b96": {
      "text": "Honestly... You're so impatient!",
      "status": "imported"
    },
    "voice_136:r_2c9d94ba13c5fc50": {
      "text": "I'll catch up to you!",
      "status": "imported"
    },
    "voice_136:r_a77f4913375098d2": {
      "text": "M-Maybe I can't fight after all?!",
      "status": "imported"
    },
    "voice_136:r_428c2116ac3071b1": {
      "text": "Aah! Check the damage!",
      "status": "imported"
    },
    "voice_136:r_84c116267b79f540": {
      "text": "Aah!",
      "status": "imported"
    },
    "voice_136:r_dad38ee29af2df3a": {
      "text": "You won't hit me!",
      "status": "imported"
    },
    "voice_136:r_3d32e86f8dc80909": {
      "text": "I can see that coming!",
      "status": "imported"
    },
    "voice_136:r_70451ffbabe2f876": {
      "text": "Easier than Duo and the others.",
      "status": "imported"
    },
    "voice_136:r_69dfa1659715e2fa": {
      "text": "That attack was pointless!",
      "status": "imported"
    },
    "voice_136:r_8ab47a28f99ef565": {
      "text": "Retreat while you can!",
      "status": "imported"
    },
    "voice_136:r_546de3fb6db156ea": {
      "text": "I'll cover you, Zechs!",
      "status": "imported"
    },
    "voice_136:r_d89011fe3e5d082a": {
      "text": "Roger! Commencing attack!",
      "status": "imported"
    },
    "voice_136:r_3c5b0c2ac812d5de": {
      "text": "We'll do this in one go!!",
      "status": "imported"
    },
    "voice_136:r_5b9e8897190892eb": {
      "text": "I'll beat you,\\nand end this battle!",
      "status": "imported"
    }
  }
}
