{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_119:r_479b340ccc6c572b": {
      "text": "Commencing combat!",
      "status": "imported"
    },
    "voice_119:r_77949221bf58f862": {
      "text": "Enemy unit sighted!",
      "status": "imported"
    },
    "voice_119:r_70b9c4b9f1f37eff": {
      "text": "Target acquired!",
      "status": "imported"
    },
    "voice_119:r_9fcb3754cb1773c7": {
      "text": "If I can bring down that Gundam!",
      "status": "imported"
    },
    "voice_119:r_3559d2fad32c2435": {
      "text": "A Gundam type... Can I beat it?!",
      "status": "imported"
    },
    "voice_119:r_f7570547e9f80a64": {
      "text": "Even if I'm facing a Gundam...!",
      "status": "imported"
    },
    "voice_119:r_cbab0f4720e1fcf1": {
      "text": "I've got a grudge with Gundam too!",
      "status": "imported"
    },
    "voice_119:r_0bbe0b4f5364e732": {
      "text": "Disable it and capture it!",
      "status": "imported"
    },
    "voice_119:r_5dda5198137cb02a": {
      "text": "So this unit is our top priority!",
      "status": "imported"
    },
    "voice_119:r_83ec59afbecdec14": {
      "text": "Even against a new Gundam...!",
      "status": "imported"
    },
    "voice_119:r_e20bfd42ad95a3c9": {
      "text": "A transformable Gundam?!",
      "status": "imported"
    },
    "voice_119:r_0f58a8822381e57f": {
      "text": "You winged freak! Go down!",
      "status": "imported"
    },
    "voice_119:r_0121a166c715cdff": {
      "text": "Get lost, you fake Gundam!",
      "status": "imported"
    },
    "voice_119:r_30fad37a42bd3ad3": {
      "text": "It's just an upgraded GM!",
      "status": "imported"
    },
    "voice_119:r_80a0b2a84e05d81a": {
      "text": "Federation cannon fodder?!",
      "status": "imported"
    },
    "voice_119:r_4a9ac1dff86506d9": {
      "text": "I'll bring Londo Bell down!",
      "status": "imported"
    },
    "voice_119:r_bc8538e6af3d2577": {
      "text": "Here to ring bells at war?!",
      "status": "imported"
    },
    "voice_119:r_924516c8de2b5342": {
      "text": "Celestial Being\\nbacks the Feds?!",
      "status": "imported"
    },
    "voice_119:r_da1174533722333f": {
      "text": "We're fighting for...\\nthe colonies!",
      "status": "imported"
    },
    "voice_119:r_0fadb5c26df92b42": {
      "text": "You chose the Feds. You're my foe!",
      "status": "imported"
    },
    "voice_119:r_af884a6b11dff121": {
      "text": "Traitors will be purged!",
      "status": "imported"
    },
    "voice_119:r_77ca87eacd17ad52": {
      "text": "Deserters will pay the price!",
      "status": "imported"
    },
    "voice_119:r_aabfb21c9d069ce7": {
      "text": "Colonel... I can't forgive you!",
      "status": "imported"
    },
    "voice_119:r_02479dc8fe989560": {
      "text": "That emblem... Amuro Ray?!",
      "status": "imported"
    },
    "voice_119:r_a2df00f91a9b0a9e": {
      "text": "I'll stop the Feds' White Devil!",
      "status": "imported"
    },
    "voice_119:r_48b60d6c48b9b142": {
      "text": "You're just an armored oaf!",
      "status": "imported"
    },
    "voice_119:r_8927e6fb681aa809": {
      "text": "You sham! I'll show you!",
      "status": "imported"
    },
    "voice_119:r_665f01666859013b": {
      "text": "I'll smash your expensive toy!",
      "status": "imported"
    },
    "voice_119:r_a571eec59b258d11": {
      "text": "That thing... Is it a machine?!",
      "status": "imported"
    },
    "voice_119:r_ddbe581c5ea9183d": {
      "text": "Its combining system must be weak!",
      "status": "imported"
    },
    "voice_119:r_faae935cca0edc72": {
      "text": "A Frontier variable fighter?!",
      "status": "imported"
    },
    "voice_119:r_d4430bf362340b32": {
      "text": "Speed isn't the only way to fight!",
      "status": "imported"
    },
    "voice_119:r_6ff1323b355593e0": {
      "text": "A mere AT...!",
      "status": "imported"
    },
    "voice_119:r_b7b5625d7cd4282f": {
      "text": "An AS is coming straight at me?!",
      "status": "imported"
    },
    "voice_119:r_36133ad73a73ef98": {
      "text": "The Black Knights serve the Feds?!",
      "status": "imported"
    },
    "voice_119:r_920740a0219c5085": {
      "text": "You abandoned your own ideals...!",
      "status": "imported"
    },
    "voice_119:r_a8451712c57c1a72": {
      "text": "Small units are hard to target...!",
      "status": "imported"
    },
    "voice_119:r_3633df5b7b8f47fa": {
      "text": "Civilians strolling into battle?!",
      "status": "imported"
    },
    "voice_119:r_1b9b2aab5cb104da": {
      "text": "Here, even civilians\\nget no mercy!",
      "status": "imported"
    },
    "voice_119:r_cf41e8828a90cbdb": {
      "text": "I'll crush your chain of command!",
      "status": "imported"
    },
    "voice_119:r_719e897304ec42d4": {
      "text": "You're the unit commander?!",
      "status": "imported"
    },
    "voice_119:r_d5e0a2317c40d322": {
      "text": "I'll sink your flagship!",
      "status": "imported"
    },
    "voice_119:r_ec2ea17765052401": {
      "text": "Once I'm close, your ship is done!",
      "status": "imported"
    },
    "voice_119:r_0c427458bc00eb95": {
      "text": "Here's some payback!",
      "status": "imported"
    },
    "voice_119:r_774a9ab4d8fd5351": {
      "text": "Commencing counterattack!",
      "status": "imported"
    },
    "voice_119:r_d3f01de714c015bd": {
      "text": "I'll pay you back!",
      "status": "imported"
    },
    "voice_119:r_7d2617c809fead70": {
      "text": "I'll launch an attack of my own!",
      "status": "imported"
    },
    "voice_119:r_ceb935ccbf830724": {
      "text": "I won't forget what you did!",
      "status": "imported"
    },
    "voice_119:r_862ef7385bf2abd4": {
      "text": "I'll strike when you try to flee!",
      "status": "imported"
    },
    "voice_119:r_001cbec4d9a4283f": {
      "text": "How dare you do that to me!",
      "status": "imported"
    },
    "voice_119:r_8ad40afecd02b41e": {
      "text": "I'll make this crisis my chance!",
      "status": "imported"
    },
    "voice_119:r_26e5efec03c03d78": {
      "text": "You took the bait!",
      "status": "imported"
    },
    "voice_119:r_4ad81e88c7557a8b": {
      "text": "Don't think you can escape me!",
      "status": "imported"
    },
    "voice_119:r_1f65a7af190e4674": {
      "text": "We'll attack in tandem!",
      "status": "imported"
    },
    "voice_119:r_40c5a9358ed5bf29": {
      "text": "If I match our allies' attack...!",
      "status": "imported"
    },
    "voice_119:r_f2e18dfdfe0c89ea": {
      "text": "Leave the rest to me!",
      "status": "imported"
    },
    "voice_119:r_cf7dbf49e96a5755": {
      "text": "Commander! I'm with you!",
      "status": "imported"
    },
    "voice_119:r_fa96676cc65bb509": {
      "text": "Colonel! Let me lend my strength!",
      "status": "imported"
    },
    "voice_119:r_4e37f92e7d2fc62e": {
      "text": "Follow the Red Comet!",
      "status": "imported"
    },
    "voice_119:r_66ab4cfe1557909d": {
      "text": "Haman! I'll take it from here!",
      "status": "imported"
    },
    "voice_119:r_0bad405ee6ca63ba": {
      "text": "Follow the Royal Guard!",
      "status": "imported"
    },
    "voice_119:r_2072eaf71a260ae7": {
      "text": "Captain! Leave the rest to me!",
      "status": "imported"
    },
    "voice_119:r_6c13bbfd27a7799e": {
      "text": "Lieutenant! I'll finish this!",
      "status": "imported"
    },
    "voice_119:r_06f88dcbd3c9e738": {
      "text": "Cover the Ensign!",
      "status": "imported"
    },
    "voice_119:r_b28faf9f71bc3598": {
      "text": "If you're not changing position...!",
      "status": "imported"
    },
    "voice_119:r_8a29278549f8e07a": {
      "text": "If I can land one more strike...!",
      "status": "imported"
    },
    "voice_119:r_7e6c573c26177f98": {
      "text": "It's not over yet!",
      "status": "imported"
    },
    "voice_119:r_45abf84f7757d6eb": {
      "text": "A-aaaaaaaagh!!",
      "status": "imported"
    },
    "voice_119:r_edd7a13ab8f06a14": {
      "text": "N-no! This can't be! Aaaaagh!!",
      "status": "imported"
    },
    "voice_119:r_8165e5b41f0124c4": {
      "text": "Is retreat my only option?!",
      "status": "imported"
    },
    "voice_119:r_4e05581b7432cce8": {
      "text": "I-I have to abandon my unit!",
      "status": "imported"
    },
    "voice_119:r_a60b107ea3c36a86": {
      "text": "I have no choice but to retreat...!",
      "status": "imported"
    },
    "voice_119:r_e33693e5ba4665b0": {
      "text": "I'm at my limit! Ejection...!",
      "status": "imported"
    },
    "voice_119:r_72a21a1a489af001": {
      "text": "N-not in a place like this!",
      "status": "imported"
    },
    "voice_119:r_eb643f8bf737a0ca": {
      "text": "C-Commander! I'm sorry!",
      "status": "imported"
    },
    "voice_119:r_0a3fccb71ec6cf2a": {
      "text": "Z-Zeon's spirit will never die!",
      "status": "imported"
    },
    "voice_119:r_9b63cf1f3e0207ef": {
      "text": "Zeon's spirit will be passed on!",
      "status": "imported"
    },
    "voice_119:r_8356f4e3dcdff938": {
      "text": "Even if I fall, Neo Zeon will...!",
      "status": "imported"
    },
    "voice_119:r_1d6d784036ae0bd7": {
      "text": "Comrades! I'm counting on you!!",
      "status": "imported"
    },
    "voice_119:r_625664af02183c17": {
      "text": "Am I next for Gundam's legend?!",
      "status": "imported"
    },
    "voice_119:r_3701cba361f80ea5": {
      "text": "Damn it! So this is Gundam's power!",
      "status": "imported"
    },
    "voice_119:r_63f429c5c68c0863": {
      "text": "Gundam!\\nIn Zeon's way again?!",
      "status": "imported"
    },
    "voice_119:r_38e4a434c91d8ef0": {
      "text": "Damn!\\nGo easy and you get cocky!",
      "status": "imported"
    },
    "voice_119:r_98ed411352a3a6ac": {
      "text": "So the latest model is no bluff...!",
      "status": "imported"
    },
    "voice_119:r_4824bea6bab3af67": {
      "text": "Londo Bell... Tougher than reports!",
      "status": "imported"
    },
    "voice_119:r_862b92e63adb9734": {
      "text": "So you're the Federation's elite!",
      "status": "imported"
    },
    "voice_119:r_cb306ef55e49d107": {
      "text": "Can't even beat a fake Gundam...?!",
      "status": "imported"
    },
    "voice_119:r_57b2bd2de8a1408d": {
      "text": "Celestial Being!\\nStill so strong?!",
      "status": "imported"
    },
    "voice_119:r_76f080a4881e8ab5": {
      "text": "Would you abandon the colonies?!",
      "status": "imported"
    },
    "voice_119:r_6f95653e548f8fcf": {
      "text": "That one...!\\nA Newtype, perhaps?!",
      "status": "imported"
    },
    "voice_119:r_d249d68bada91ab9": {
      "text": "Th-those moves... Could that be?!",
      "status": "imported"
    },
    "voice_119:r_e9b3307e9eb69f11": {
      "text": "Amuro Ray... You White Devil!",
      "status": "imported"
    },
    "voice_119:r_03cdac73042343ee": {
      "text": "That Newtype rumor...\\nWas it true?!",
      "status": "imported"
    },
    "voice_119:r_6026da5acbda7c69": {
      "text": "This is the Red Comet's skill...!",
      "status": "imported"
    },
    "voice_119:r_981f8fedd5414fe5": {
      "text": "Red Comet! With that power, why?!",
      "status": "imported"
    },
    "voice_119:r_96bb0dcde0c8c44a": {
      "text": "Wh-what is that power?!",
      "status": "imported"
    },
    "voice_119:r_641550a2f54cb456": {
      "text": "Tough and powerful!\\nNo weak spot?!",
      "status": "imported"
    },
    "voice_119:r_a0f2074af8debbfa": {
      "text": "It really is super, just as named!",
      "status": "imported"
    },
    "voice_119:r_b5f5a97ed82acb0b": {
      "text": "No! I can't escape or pursue it!",
      "status": "imported"
    },
    "voice_119:r_d9cd2e4ded064396": {
      "text": "Mobile suits\\ncan't match its speed!",
      "status": "imported"
    },
    "voice_119:r_99e6349431aaf23b": {
      "text": "What in the world is that AT?!",
      "status": "imported"
    },
    "voice_119:r_ec1081caf845f56a": {
      "text": "Is this really an AS's firepower?!",
      "status": "imported"
    },
    "voice_119:r_2c5b7ee872c1ed7f": {
      "text": "Black Knights!\\nWhy block us?!",
      "status": "imported"
    },
    "voice_119:r_76d1e51c8b494a60": {
      "text": "Damn! Where can it\\nget that power?!",
      "status": "imported"
    },
    "voice_119:r_eb5f687fcd372ae7": {
      "text": "Aaaaaagh!",
      "status": "imported"
    },
    "voice_119:r_2329428a6871d9fa": {
      "text": "Damn it! The output won't rise...",
      "status": "imported"
    },
    "voice_119:r_0e7466971bec4cc4": {
      "text": "I'm almost at my limit...!",
      "status": "imported"
    },
    "voice_119:r_efa71f7a4cc33ff3": {
      "text": "A-am I completely outclassed...?!",
      "status": "imported"
    },
    "voice_119:r_3fc2e1186557e7a0": {
      "text": "They took out the main camera!",
      "status": "imported"
    },
    "voice_119:r_fa6930340a545054": {
      "text": "Damn!\\nThe thrusters won't work!",
      "status": "imported"
    },
    "voice_119:r_2332b9d56461d7ab": {
      "text": "A critical drive-system failure?!",
      "status": "imported"
    },
    "voice_119:r_854aa0a91a3c80d1": {
      "text": "Damn!\\nThe reactor will ignite!",
      "status": "imported"
    },
    "voice_119:r_0bc8ae32a406ceab": {
      "text": "The moment I give up, I've lost...!",
      "status": "imported"
    },
    "voice_119:r_82c09f011d703b2c": {
      "text": "Fight...! Fight to the very end!",
      "status": "imported"
    },
    "voice_119:r_2b4d8818c77b6dca": {
      "text": "Don't think you've won just yet!",
      "status": "imported"
    },
    "voice_119:r_087354f2db0a31e6": {
      "text": "I can still fight! I'll fight on!",
      "status": "imported"
    },
    "voice_119:r_db02a2dec93dd263": {
      "text": "Till we make a Spacenoid future...!",
      "status": "imported"
    },
    "voice_119:r_d520c6d5298a848d": {
      "text": "Not yet...! Neo Zeon, not yet...!",
      "status": "imported"
    },
    "voice_119:r_099e2458cabf796f": {
      "text": "Our ideals and cause!\\nNot to you!",
      "status": "imported"
    },
    "voice_119:r_fd910d714be70870": {
      "text": "Suit breaks.\\nOur soul won't break!",
      "status": "imported"
    },
    "voice_119:r_689d0b123de71ae0": {
      "text": "Ghh! It moved where I dodged!",
      "status": "imported"
    },
    "voice_119:r_84883aa95f63ce32": {
      "text": "Damn! That hit me dead-on...!",
      "status": "imported"
    },
    "voice_119:r_25493e978ce8ff16": {
      "text": "If they gain steam, it'll get ugly!",
      "status": "imported"
    },
    "voice_119:r_7316666150e42960": {
      "text": "One opening, and this happens...!",
      "status": "imported"
    },
    "voice_119:r_c4f11aa93dc5b668": {
      "text": "Half the monitors are dead!",
      "status": "imported"
    },
    "voice_119:r_ce1a22dfe3a4d339": {
      "text": "Ngh! It pierced the armor?!",
      "status": "imported"
    },
    "voice_119:r_240651adab81e145": {
      "text": "Damn! It overpowers me?!",
      "status": "imported"
    },
    "voice_119:r_cff0deaae73c2858": {
      "text": "Sluggish response! Drive trouble?!",
      "status": "imported"
    },
    "voice_119:r_dca67f68a573fab7": {
      "text": "Our struggle won't end so easily!",
      "status": "imported"
    },
    "voice_119:r_a6630215fefaf294": {
      "text": "I was prepared for this much!",
      "status": "imported"
    },
    "voice_119:r_6f94566ad37f8ff8": {
      "text": "Neo Zeon will not lose! Never!",
      "status": "imported"
    },
    "voice_119:r_942ca03c9de80143": {
      "text": "If we lose,\\nwhat about Spacenoids?!",
      "status": "imported"
    },
    "voice_119:r_d8c669c70659e18a": {
      "text": "Time to drop the Gundam name!",
      "status": "imported"
    },
    "voice_119:r_8f5bade7ac2db78e": {
      "text": "Gundam won't lord over us forever!",
      "status": "imported"
    },
    "voice_119:r_05ea490d2f522520": {
      "text": "The age of Gundam is over!",
      "status": "imported"
    },
    "voice_119:r_f5658c702d91db7a": {
      "text": "Surrender now, and I'll spare you!",
      "status": "imported"
    },
    "voice_119:r_686df329b50f195b": {
      "text": "So much for the latest model!",
      "status": "imported"
    },
    "voice_119:r_25f0ab0fa3cf690c": {
      "text": "A knockoff stays a knockoff!",
      "status": "imported"
    },
    "voice_119:r_b708a1d959013dbf": {
      "text": "All you do is ring that bell?!",
      "status": "imported"
    },
    "voice_119:r_59fca03e929366c1": {
      "text": "Weak as the rotten Federation!",
      "status": "imported"
    },
    "voice_119:r_0d65eb631dcb7514": {
      "text": "You sided with the Feds for this?!",
      "status": "imported"
    },
    "voice_119:r_97f82e3cb6f70110": {
      "text": "Red Comet truly suits you, Colonel!",
      "status": "imported"
    },
    "voice_119:r_c5611d8dd6def96b": {
      "text": "You've sunk low, Char Aznable!",
      "status": "imported"
    },
    "voice_119:r_6f12cc8ed2732eb5": {
      "text": "Slow oaf!\\nYou waste that power!",
      "status": "imported"
    },
    "voice_119:r_7abfc55f8fb62ba7": {
      "text": "Just a fast little gnat!",
      "status": "imported"
    },
    "voice_119:r_99e7a66c650b5892": {
      "text": "You're too weak!",
      "status": "imported"
    },
    "voice_119:r_5b2247b5cfbcd7b2": {
      "text": "Your armor saved you...!",
      "status": "imported"
    },
    "voice_119:r_2d7a9c06347582d9": {
      "text": "That only happened to hit!",
      "status": "imported"
    },
    "voice_119:r_bf953d64c3c7d9b7": {
      "text": "That was nothing but an accident!",
      "status": "imported"
    },
    "voice_119:r_e09b933e3e706779": {
      "text": "I underestimated the situation...!",
      "status": "imported"
    },
    "voice_119:r_66236eb99b676e5b": {
      "text": "At least your aim is accurate!",
      "status": "imported"
    },
    "voice_119:r_9639a2dbcd2f58ed": {
      "text": "That hardly counts as damage!",
      "status": "imported"
    },
    "voice_119:r_aeea0893acb93d35": {
      "text": "If the reactor stays untouched...!",
      "status": "imported"
    },
    "voice_119:r_b31568654e53487b": {
      "text": "One or two sub-cameras are nothing!",
      "status": "imported"
    },
    "voice_119:r_2502132569141ea3": {
      "text": "All systems normal! I can fight!",
      "status": "imported"
    },
    "voice_119:r_5508a7bfa9074eb9": {
      "text": "As long as the shield holds...!",
      "status": "imported"
    },
    "voice_119:r_09a003e91f0d5dc7": {
      "text": "Just block it with the shield!",
      "status": "imported"
    },
    "voice_119:r_192447448ebd7bb5": {
      "text": "Like that'll hit me!",
      "status": "imported"
    },
    "voice_119:r_e92920ba4b301b9f": {
      "text": "Everything you do is too slow!",
      "status": "imported"
    },
    "voice_119:r_207b256d613bb896": {
      "text": "All right! I dodged it!",
      "status": "imported"
    },
    "voice_119:r_a6fd676d8146501b": {
      "text": "Luck is on my side!",
      "status": "imported"
    },
    "voice_119:r_94d35e5fa8e3a198": {
      "text": "That timing was perfect!",
      "status": "imported"
    },
    "voice_119:r_b686510e636673f3": {
      "text": "I'll dodge the next one too!",
      "status": "imported"
    },
    "voice_119:r_59369bad143d4272": {
      "text": "With skill like that, you face me?!",
      "status": "imported"
    },
    "voice_119:r_25f9b1e39dd8d366": {
      "text": "I saw that attack coming!",
      "status": "imported"
    },
    "voice_119:r_307477bedd148060": {
      "text": "I've been hardened by real combat!",
      "status": "imported"
    },
    "voice_119:r_09a780acca0eb4b0": {
      "text": "We've got equipment like that too!",
      "status": "imported"
    },
    "voice_119:r_af62f2ee466b5c8c": {
      "text": "That didn't hurt at all!",
      "status": "imported"
    },
    "voice_119:r_23f0d87a5a6cfca1": {
      "text": "As long as I have an I-field!",
      "status": "imported"
    },
    "voice_119:r_60c94ea4eb7f7404": {
      "text": "I can't even counterattack...!",
      "status": "imported"
    },
    "voice_119:r_727b2ee0277f9159": {
      "text": "Damn! I lost the target!",
      "status": "imported"
    },
    "voice_119:r_cff4d2eae8a939ed": {
      "text": "Damn it! What's going on here?!",
      "status": "imported"
    },
    "voice_119:r_1428fe5f35a9427b": {
      "text": "Damn! I'm just a sitting target!",
      "status": "imported"
    },
    "voice_119:r_96d39b8bdfa6f183": {
      "text": "Damn it! I forgot the basics...!",
      "status": "imported"
    },
    "voice_119:r_0e4f9b8a2d26ebff": {
      "text": "An attack from outside my range?!",
      "status": "imported"
    },
    "voice_119:r_79e0d542fe12bcf7": {
      "text": "Damn! They hit me from that far...!",
      "status": "imported"
    },
    "voice_119:r_eff747ba39a55393": {
      "text": "My remaining energy...?!",
      "status": "imported"
    },
    "voice_119:r_b2dc77aa6dd77e69": {
      "text": "Fall back while we can!",
      "status": "imported"
    },
    "voice_119:r_445d40d8b5d7092b": {
      "text": "I'll be the shield!",
      "status": "imported"
    },
    "voice_119:r_bbb633cb5e8e6daf": {
      "text": "Don't push it! Fall back!",
      "status": "imported"
    },
    "voice_119:r_0abd8b6c713ccdac": {
      "text": "Protect the Commander!",
      "status": "imported"
    },
    "voice_119:r_f4ff463b2fda1b86": {
      "text": "I won't let them harm the Colonel!",
      "status": "imported"
    },
    "voice_119:r_4e63c037d3cb8a3d": {
      "text": "The Red Comet must not fall!",
      "status": "imported"
    },
    "voice_119:r_9ca8d188ae805e3a": {
      "text": "My life for Haman, if need be...!",
      "status": "imported"
    },
    "voice_119:r_795ed21f3e28e1f5": {
      "text": "They're after the Royal Guard...?!",
      "status": "imported"
    },
    "voice_119:r_141415c1def5ab2d": {
      "text": "Captain! You're in danger!",
      "status": "imported"
    },
    "voice_119:r_c894e35becf35a03": {
      "text": "Lieutenant! You're too far ahead!",
      "status": "imported"
    },
    "voice_119:r_79b1abf5fc86483c": {
      "text": "Ensign! Don't do anything reckless!",
      "status": "imported"
    },
    "voice_119:r_e9a11621911acb19": {
      "text": "I'll crush you!",
      "status": "imported"
    },
    "voice_119:r_d52bece55796f599": {
      "text": "It's dangerous, but...!",
      "status": "imported"
    },
    "voice_119:r_358fe5a50bbee1df": {
      "text": "Closing the distance!",
      "status": "imported"
    },
    "voice_119:r_638834e16724002f": {
      "text": "You let me get close!",
      "status": "imported"
    },
    "voice_119:r_b02fca1590ac1210": {
      "text": "This will finish you!",
      "status": "imported"
    },
    "voice_119:r_f0344d2fbaa9db77": {
      "text": "I'll shoot you down!",
      "status": "imported"
    },
    "voice_119:r_3328eef766ff2c2c": {
      "text": "I've got you in my sights!",
      "status": "imported"
    },
    "voice_119:r_23b037cf6ccc695c": {
      "text": "Take a direct hit!",
      "status": "imported"
    },
    "voice_119:r_883ad1128d340c5e": {
      "text": "Keep firing and one will hit!",
      "status": "imported"
    },
    "voice_119:r_a9e6ed99025a703b": {
      "text": "At this distance...!",
      "status": "imported"
    },
    "voice_119:r_1e5842ba5dc3f705": {
      "text": "Go!",
      "status": "imported"
    },
    "voice_119:r_9747bd61ad23ecd3": {
      "text": "This is the end!",
      "status": "imported"
    },
    "voice_119:r_6823f8abe05c4727": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_119:r_b8ccfd8b8ac323ac": {
      "text": "Why, you!",
      "status": "imported"
    },
    "voice_119:r_c885ff2097749991": {
      "text": "There!",
      "status": "imported"
    },
    "voice_119:r_a8da7f8d8b705db0": {
      "text": "Haaah!",
      "status": "imported"
    },
    "voice_119:r_02e1c5e19de5bd22": {
      "text": "Got you!",
      "status": "imported"
    },
    "voice_119:r_5dcbcf1682cc3ab8": {
      "text": "Let's do this!",
      "status": "imported"
    },
    "voice_119:r_c5c491f8761152f0": {
      "text": "Raaaaagh!",
      "status": "imported"
    },
    "voice_119:r_3d4fa015b8b31648": {
      "text": "Go dooown!",
      "status": "imported"
    },
    "voice_119:r_53660d6bc7fe8513": {
      "text": "I'll down you here at any cost!",
      "status": "imported"
    },
    "voice_119:r_aeb9079d86e2a924": {
      "text": "At least I'll hold you here!",
      "status": "imported"
    },
    "voice_119:r_bc4658630f8e40a9": {
      "text": "I'll draw their attention!",
      "status": "imported"
    },
    "voice_119:r_92816afa2ba8a8c9": {
      "text": "If we concentrate our fire...!",
      "status": "imported"
    },
    "voice_119:r_a29f58ecde5f7ddd": {
      "text": "I know what my duty is!",
      "status": "imported"
    },
    "voice_119:r_4069f7e9517c47e8": {
      "text": "I'll open a way through!",
      "status": "imported"
    },
    "voice_119:r_2835a8af1c41be9b": {
      "text": "If it's only one unit!",
      "status": "imported"
    },
    "voice_119:r_cd84325a7c1a820f": {
      "text": "I can't afford to fail!",
      "status": "imported"
    },
    "voice_119:r_0465f74c0488ad70": {
      "text": "The odds are even!",
      "status": "imported"
    },
    "voice_119:r_a30c8238b5208470": {
      "text": "We'll use that plan!",
      "status": "imported"
    },
    "voice_119:r_64bf1c63c7c1ebdd": {
      "text": "I'll handle them!",
      "status": "imported"
    },
    "voice_119:r_f6d5042f671118fa": {
      "text": "Go down!",
      "status": "imported"
    },
    "voice_119:r_0be18539fac21ba4": {
      "text": "Hit the target!",
      "status": "imported"
    },
    "voice_119:r_c05bd0cf089d667f": {
      "text": "This is as far as you go!",
      "status": "imported"
    },
    "voice_119:r_f69a0e1d0d67fd0e": {
      "text": "I'll keep their heads down!",
      "status": "imported"
    },
    "voice_119:r_c4e734ceafabd82c": {
      "text": "If you're coming at me...!",
      "status": "imported"
    },
    "voice_119:r_62f1de6cdfb87024": {
      "text": "Come and get me!",
      "status": "imported"
    },
    "voice_119:r_7ecfe7ddfa4cdb6a": {
      "text": "I'll take you on!",
      "status": "imported"
    },
    "voice_119:r_d1be92a2ad355176": {
      "text": "No matter the gap in strength!",
      "status": "imported"
    },
    "voice_119:r_e0022ae8da32f998": {
      "text": "You won't get past me!",
      "status": "imported"
    },
    "voice_119:r_0ef83b6a1e87f6fd": {
      "text": "I'll hit the enemy right in front!",
      "status": "imported"
    },
    "voice_119:r_a8f0666c4d6d24a0": {
      "text": "I'll get you before you get me!",
      "status": "imported"
    },
    "voice_119:r_3ec7c6e48027a853": {
      "text": "You overextended. Now you'll pay!",
      "status": "imported"
    },
    "voice_119:r_953824ba6b607e1f": {
      "text": "We'll create a new age!",
      "status": "imported"
    },
    "voice_119:r_d6c7a401f55ee42f": {
      "text": "Feel the wrath of those in space!",
      "status": "imported"
    },
    "voice_119:r_7bce428a8c95c22c": {
      "text": "This battle will change the world!",
      "status": "imported"
    },
    "voice_119:r_97b5fedc5b19e6af": {
      "text": "This is Neo Zeon!",
      "status": "imported"
    },
    "voice_119:r_111aa50202ff773f": {
      "text": "I'll show you how Neo Zeon fights!",
      "status": "imported"
    },
    "voice_119:r_10cb1d3f8f325f52": {
      "text": "To realize the Commander's ideals!",
      "status": "imported"
    },
    "voice_119:r_ed69cbf9ff3779a7": {
      "text": "To overthrow the Earth Federation!",
      "status": "imported"
    },
    "voice_119:r_82e0a318411dcbf7": {
      "text": "You who still cling\\nto Earth...!",
      "status": "imported"
    },
    "voice_119:r_36c402609f13ec14": {
      "text": "We bear Spacenoid hopes\\nwith us!",
      "status": "imported"
    }
  }
}
