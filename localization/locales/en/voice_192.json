{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_192:r_479b340ccc6c572b": {
      "text": "Let's go!",
      "status": "imported"
    },
    "voice_192:r_77949221bf58f862": {
      "text": "Too naive!",
      "status": "imported"
    },
    "voice_192:r_70b9c4b9f1f37eff": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_192:r_9fcb3754cb1773c7": {
      "text": "Ha ha ha ha!",
      "status": "imported"
    },
    "voice_192:r_3559d2fad32c2435": {
      "text": "Have a taste of this!",
      "status": "imported"
    },
    "voice_192:r_f7570547e9f80a64": {
      "text": "Get out of my way!",
      "status": "imported"
    },
    "voice_192:r_cbab0f4720e1fcf1": {
      "text": "You let your guard down!",
      "status": "imported"
    },
    "voice_192:r_0bbe0b4f5364e732": {
      "text": "You're wide open!",
      "status": "imported"
    },
    "voice_192:r_5dda5198137cb02a": {
      "text": "I've got you!",
      "status": "imported"
    },
    "voice_192:r_83ec59afbecdec14": {
      "text": "No match for Ryunosuke Akagi!",
      "status": "imported"
    },
    "voice_192:r_e20bfd42ad95a3c9": {
      "text": "Behold the Red Dragon in action!",
      "status": "imported"
    },
    "voice_192:r_0f58a8822381e57f": {
      "text": "Nerima Red Dragon fights this way!",
      "status": "imported"
    },
    "voice_192:r_6dbcc507fb61b51d": {
      "text": "A worthy foe! Let's do this!",
      "status": "imported"
    },
    "voice_192:r_b42ab697149a7c8a": {
      "text": "Behold my secret technique!",
      "status": "imported"
    },
    "voice_192:r_4de4fcf3b440baf4": {
      "text": "Come at me with all you've got!",
      "status": "imported"
    },
    "voice_192:r_0121a166c715cdff": {
      "text": "I'll finish you in one blow!",
      "status": "imported"
    },
    "voice_192:r_30fad37a42bd3ad3": {
      "text": "I've already got you by the tail!",
      "status": "imported"
    },
    "voice_192:r_80a0b2a84e05d81a": {
      "text": "Keeping your distance won't help!",
      "status": "imported"
    },
    "voice_192:r_4a9ac1dff86506d9": {
      "text": "I happen to have sharp eyes!",
      "status": "imported"
    },
    "voice_192:r_bc8538e6af3d2577": {
      "text": "I'll make good on my second chance!",
      "status": "imported"
    },
    "voice_192:r_924516c8de2b5342": {
      "text": "This time, I'll put you to rest!",
      "status": "imported"
    },
    "voice_192:r_da1174533722333f": {
      "text": "Vile intruders\\nwill get their due!",
      "status": "imported"
    },
    "voice_192:r_fdeb8162976e72c1": {
      "text": "Whoever you are,\\nI'll take you on!",
      "status": "imported"
    },
    "voice_192:r_0fadb5c26df92b42": {
      "text": "Let's scare them with dummy rounds!",
      "status": "imported"
    },
    "voice_192:r_6b15af9a0057cdc8": {
      "text": "Care to pilot an AS with me?",
      "status": "imported"
    },
    "voice_192:r_af884a6b11dff121": {
      "text": "I've never made a Lady regret it!",
      "status": "imported"
    },
    "voice_192:r_77ca87eacd17ad52": {
      "text": "Now I'll take out the command unit!",
      "status": "imported"
    },
    "voice_192:r_bf3244994760e535": {
      "text": "Akaten,\\nlet's settle this fairly!",
      "status": "imported"
    },
    "voice_192:r_aabfb21c9d069ce7": {
      "text": "A soldier can't\\nlose to civilians!",
      "status": "imported"
    },
    "voice_192:r_02479dc8fe989560": {
      "text": "I'll give you a failing grade too!",
      "status": "imported"
    },
    "voice_192:r_a2df00f91a9b0a9e": {
      "text": "No disgrace before my instructor!",
      "status": "imported"
    },
    "voice_192:r_b1f8ec192b9c083a": {
      "text": "The attack isn't over yet!",
      "status": "imported"
    },
    "voice_192:r_a007f9ab9cf048b3": {
      "text": "That was a good attack!",
      "status": "imported"
    },
    "voice_192:r_ddafde4b065ced49": {
      "text": "I'll back you up here!",
      "status": "imported"
    },
    "voice_192:r_de1213040856c089": {
      "text": "I'll protect my comrades!",
      "status": "imported"
    },
    "voice_192:r_3304412ac41f47a6": {
      "text": "I see you know combat basics.",
      "status": "imported"
    },
    "voice_192:r_0c0775e051211840": {
      "text": "Oh? What a crafty little trick.",
      "status": "imported"
    },
    "voice_192:r_a2afffe1c396f0b3": {
      "text": "Indeed, that's one strategy.",
      "status": "imported"
    },
    "voice_192:r_13c25fbdfddc8a24": {
      "text": "The Red Dragon can't attack...!",
      "status": "imported"
    },
    "voice_192:r_42ba1ecb310b4bd7": {
      "text": "I lost sight of the target?!",
      "status": "imported"
    },
    "voice_192:r_d692f1d420460a47": {
      "text": "You are simply too naive!",
      "status": "imported"
    },
    "voice_192:r_a5643cec86b18bd2": {
      "text": "Know the Red Dragon's power now?",
      "status": "imported"
    },
    "voice_192:r_68f2dfab20a4a30e": {
      "text": "Don't worry. I'm simply too strong.",
      "status": "imported"
    },
    "voice_192:r_9cedad8237480563": {
      "text": "Well? Wasn't my technique superb?",
      "status": "imported"
    },
    "voice_192:r_a03fabecba1508ca": {
      "text": "Ladies, behold!",
      "status": "imported"
    },
    "voice_192:r_5391b24a71eb10ae": {
      "text": "Ryunosuke Akagi, at your service.",
      "status": "imported"
    },
    "voice_192:r_a554ceef5c87b972": {
      "text": "Stranger, now you know your place.",
      "status": "imported"
    },
    "voice_192:r_546c3d5937fbb7ee": {
      "text": "You'll make a fine foil for me.",
      "status": "imported"
    },
    "voice_192:r_1568ff6298b12b96": {
      "text": "After all, you're only an Akaten!",
      "status": "imported"
    },
    "voice_192:r_2c9d94ba13c5fc50": {
      "text": "Akaten's far below the Red Dragon!",
      "status": "imported"
    },
    "voice_192:r_a77f4913375098d2": {
      "text": "Civilians can't defeat soldiers!",
      "status": "imported"
    },
    "voice_192:r_69dfa1659715e2fa": {
      "text": "Ha ha ha! Useless, utterly useless!",
      "status": "imported"
    },
    "voice_192:r_d996fd6d4ef5b329": {
      "text": "I've got tricks like this too!",
      "status": "imported"
    },
    "voice_192:r_ca85f87cee5e31f7": {
      "text": "Tch!",
      "status": "imported"
    },
    "voice_192:r_9072ea7bc71df136": {
      "text": "Just hitting me won't be enough!",
      "status": "imported"
    },
    "voice_192:r_04e815a8d425827d": {
      "text": "You've got potential... But!",
      "status": "imported"
    },
    "voice_192:r_d89011fe3e5d082a": {
      "text": "That won't pierce this armor!",
      "status": "imported"
    },
    "voice_192:r_3c5b0c2ac812d5de": {
      "text": "A hit on Red Dragon merits praise!",
      "status": "imported"
    },
    "voice_192:r_5b9e8897190892eb": {
      "text": "I put too much force into that...!",
      "status": "imported"
    },
    "voice_192:r_7bea3023abbf8a94": {
      "text": "Oh, quite the dazzling attack...!",
      "status": "imported"
    },
    "voice_192:r_dd01a4c0d1b36a8d": {
      "text": "Nerima Red Dragon's pride\\nis hurt!",
      "status": "imported"
    },
    "voice_192:r_20920ad2eb3542db": {
      "text": "Impressive skill... But!",
      "status": "imported"
    },
    "voice_192:r_0ab7914877fd48ed": {
      "text": "Nice tension...! It keeps me sharp!",
      "status": "imported"
    },
    "voice_192:r_cb846feec748c2e3": {
      "text": "So that's your true power!",
      "status": "imported"
    },
    "voice_192:r_c958860b0676b1f5": {
      "text": "Sharp, spicy,\\nlike grated daikon!",
      "status": "imported"
    },
    "voice_192:r_5e2669b82ef75ce3": {
      "text": "Impressive!\\nNo ordinary foe!",
      "status": "imported"
    },
    "voice_192:r_7847e0ed7dc9282d": {
      "text": "This is too much for an attraction!",
      "status": "imported"
    },
    "voice_192:r_e42b52c7a987b906": {
      "text": "No!\\nLosing to them shames Nerima!",
      "status": "imported"
    },
    "voice_192:r_6825fd1ff907bd22": {
      "text": "Losing to Akaten means I flunk!",
      "status": "imported"
    },
    "voice_192:r_607f666f1563bc0d": {
      "text": "Bah!\\n21st Century Security beast?!",
      "status": "imported"
    },
    "voice_192:r_97b7431eeb81e6b6": {
      "text": "My instructor was right... Strong!",
      "status": "imported"
    },
    "voice_192:r_b84afafb8a33ec60": {
      "text": "Gwooooooh!",
      "status": "imported"
    },
    "voice_192:r_c8c59db85bf875e6": {
      "text": "The enemy's a renowned pilot!",
      "status": "imported"
    },
    "voice_192:r_391aa56435d9dd6e": {
      "text": "Bad!\\nThe tide is fully against us!",
      "status": "imported"
    },
    "voice_192:r_7c796ba53bd7ea03": {
      "text": "Nerima Red Dragon's name\\nunsoiled!",
      "status": "imported"
    },
    "voice_192:r_fa944da4b6519006": {
      "text": "Damn! I'll win Nerima glory!",
      "status": "imported"
    },
    "voice_192:r_95d047bcc17fccc6": {
      "text": "Hard to admit:\\nYouth's folly...!",
      "status": "imported"
    },
    "voice_192:r_640327a12a559b31": {
      "text": "W-What?! D-Did I lose?!",
      "status": "imported"
    },
    "voice_192:r_bdd38c584fa313d0": {
      "text": "Nerima Red Dragon was defeated...!",
      "status": "imported"
    },
    "voice_192:r_3fd86c1027f317c8": {
      "text": "I-I lost! Am I Akaten Dragon now?!",
      "status": "imported"
    },
    "voice_192:r_d0372a183d2007ad": {
      "text": "All right, I'll strike first!",
      "status": "imported"
    },
    "voice_192:r_217aa5e1d545b44d": {
      "text": "I'll have the first move!",
      "status": "imported"
    },
    "voice_192:r_381992c5d8224937": {
      "text": "Leave stopping them to me!",
      "status": "imported"
    },
    "voice_192:r_f1e7ed9e5874aba5": {
      "text": "Is that the target?!",
      "status": "imported"
    },
    "voice_192:r_fc25e66a86fc2c85": {
      "text": "I'll enjoy this to the fullest!",
      "status": "imported"
    },
    "voice_192:r_5aeeb4917340c42d": {
      "text": "So we take them down one by one!",
      "status": "imported"
    }
  }
}
