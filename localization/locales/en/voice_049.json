{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_049:r_479b340ccc6c572b": {
      "text": "Let's hear your melody.",
      "status": "imported"
    },
    "voice_049:r_ca4acbac57a2a35e": {
      "text": "Kill! Kill! Again! And again!!",
      "status": "imported"
    },
    "voice_049:r_77949221bf58f862": {
      "text": "You just never learn...!",
      "status": "imported"
    },
    "voice_049:r_70b9c4b9f1f37eff": {
      "text": "Take this, damn you!",
      "status": "imported"
    },
    "voice_049:r_9fcb3754cb1773c7": {
      "text": "This'll split you in two!",
      "status": "imported"
    },
    "voice_049:r_3559d2fad32c2435": {
      "text": "I'll part your head from your body!",
      "status": "imported"
    },
    "voice_049:r_f7570547e9f80a64": {
      "text": "I'll punch right through you!",
      "status": "imported"
    },
    "voice_049:r_cbab0f4720e1fcf1": {
      "text": "I'll burn you to ashes!",
      "status": "imported"
    },
    "voice_049:r_0bbe0b4f5364e732": {
      "text": "Get the hell outta here!",
      "status": "imported"
    },
    "voice_049:r_5dda5198137cb02a": {
      "text": "You aren't getting away!",
      "status": "imported"
    },
    "voice_049:r_83ec59afbecdec14": {
      "text": "Raaaaaaaagh!",
      "status": "imported"
    },
    "voice_049:r_e20bfd42ad95a3c9": {
      "text": "My blood's boiling!",
      "status": "imported"
    },
    "voice_049:r_0f58a8822381e57f": {
      "text": "I'll tear out your throat!",
      "status": "imported"
    },
    "voice_049:r_6dbcc507fb61b51d": {
      "text": "Now I'm getting serious!",
      "status": "imported"
    },
    "voice_049:r_b42ab697149a7c8a": {
      "text": "Ha ha ha ha! Ha ha ha ha ha ha!",
      "status": "imported"
    },
    "voice_049:r_4de4fcf3b440baf4": {
      "text": "Take this! Genesis!\\nInfinite Punch!",
      "status": "imported"
    },
    "voice_049:r_0121a166c715cdff": {
      "text": "Infinite Punch!",
      "status": "imported"
    },
    "voice_049:r_30fad37a42bd3ad3": {
      "text": "Stretch! Infinite Punch!",
      "status": "imported"
    },
    "voice_049:r_80a0b2a84e05d81a": {
      "text": "Take this! Infinite Punch!",
      "status": "imported"
    },
    "voice_049:r_4a9ac1dff86506d9": {
      "text": "I won't miss!",
      "status": "imported"
    },
    "voice_049:r_bc8538e6af3d2577": {
      "text": "Ora ora oraaa!",
      "status": "imported"
    },
    "voice_049:r_924516c8de2b5342": {
      "text": "I'll fill you full of holes!",
      "status": "imported"
    },
    "voice_049:r_da1174533722333f": {
      "text": "I'll put some air holes in you!",
      "status": "imported"
    },
    "voice_049:r_fdeb8162976e72c1": {
      "text": "I'll hunt you to the ends of Earth!",
      "status": "imported"
    },
    "voice_049:r_0fadb5c26df92b42": {
      "text": "Try and run if you think you can!",
      "status": "imported"
    },
    "voice_049:r_6b15af9a0057cdc8": {
      "text": "Missile, fire!",
      "status": "imported"
    },
    "voice_049:r_15b4a90140e8a33a": {
      "text": "One of these is bound to hit!",
      "status": "imported"
    },
    "voice_049:r_af884a6b11dff121": {
      "text": "Taaaaake this!!",
      "status": "imported"
    },
    "voice_049:r_ac6fe7838e95647b": {
      "text": "There's no way you'll dodge these!",
      "status": "imported"
    },
    "voice_049:r_77ca87eacd17ad52": {
      "text": "Missile, full salvo!",
      "status": "imported"
    },
    "voice_049:r_bf3244994760e535": {
      "text": "Struggle with all you've got...!",
      "status": "imported"
    },
    "voice_049:r_aabfb21c9d069ce7": {
      "text": "I won't show you any mercy!!",
      "status": "imported"
    },
    "voice_049:r_02479dc8fe989560": {
      "text": "Now that's a lovely scent...!",
      "status": "imported"
    },
    "voice_049:r_a2df00f91a9b0a9e": {
      "text": "Heh...!",
      "status": "imported"
    },
    "voice_049:r_48b60d6c48b9b142": {
      "text": "I smell it...!",
      "status": "imported"
    },
    "voice_049:r_8927e6fb681aa809": {
      "text": "Mind if I kill you?",
      "status": "imported"
    },
    "voice_049:r_665f01666859013b": {
      "text": "I've had enough! Time to die!",
      "status": "imported"
    },
    "voice_049:r_a571eec59b258d11": {
      "text": "I'll show you who's stronger!",
      "status": "imported"
    },
    "voice_049:r_ddbe581c5ea9183d": {
      "text": "Your heart...\\nWhat if I reverse it?",
      "status": "imported"
    },
    "voice_049:r_faae935cca0edc72": {
      "text": "I'll reverse your very life!",
      "status": "imported"
    },
    "voice_049:r_d4430bf362340b32": {
      "text": "My reversal power will end this!",
      "status": "imported"
    },
    "voice_049:r_6ff1323b355593e0": {
      "text": "Hmph! What worthless scents...!",
      "status": "imported"
    },
    "voice_049:r_b7b5625d7cd4282f": {
      "text": "None have a scent worth killing!",
      "status": "imported"
    },
    "voice_049:r_36133ad73a73ef98": {
      "text": "Heh. Nothing but hollow scents.",
      "status": "imported"
    },
    "voice_049:r_920740a0219c5085": {
      "text": "There...! That's my damn woman!",
      "status": "imported"
    },
    "voice_049:r_a8451712c57c1a72": {
      "text": "Where's my damn woman?!",
      "status": "imported"
    },
    "voice_049:r_3633df5b7b8f47fa": {
      "text": "Hands off my damn woman!!",
      "status": "imported"
    },
    "voice_049:r_52dfc56b14b93551": {
      "text": "Her stench... I want to kill her...!",
      "status": "imported"
    },
    "voice_049:r_1b9b2aab5cb104da": {
      "text": "Kill, hold,\\nthen break her...!",
      "status": "imported"
    },
    "voice_049:r_342044c706a2340f": {
      "text": "No one's taking Sylphy from me!",
      "status": "imported"
    },
    "voice_049:r_cf41e8828a90cbdb": {
      "text": "World be damned!\\nI won't let her go!",
      "status": "imported"
    },
    "voice_049:r_719e897304ec42d4": {
      "text": "Damn the future!\\nShe's all I need!",
      "status": "imported"
    },
    "voice_049:r_d5e0a2317c40d322": {
      "text": "These are the Wings of the Sun...!",
      "status": "imported"
    },
    "voice_049:r_ec2ea17765052401": {
      "text": "No one's getting in our way!",
      "status": "imported"
    },
    "voice_049:r_f2d4255f1c2f7542": {
      "text": "No one takes her!\\nShe's mine alone!",
      "status": "imported"
    },
    "voice_049:r_5d08ad19e2da125b": {
      "text": "We're going too!",
      "status": "imported"
    },
    "voice_049:r_a7246b52782a877e": {
      "text": "This feels pretty damn good...!",
      "status": "imported"
    },
    "voice_049:r_dc8701f6bcb9904f": {
      "text": "Hell, count me in too!",
      "status": "imported"
    },
    "voice_049:r_d6bdd730f24f66eb": {
      "text": "Amata, I'll show you how it's done!",
      "status": "imported"
    },
    "voice_049:r_41997412868c48c4": {
      "text": "You said it, so prove it, Kagura!",
      "status": "imported"
    },
    "voice_049:r_9e6cf4f389dae55c": {
      "text": "Lend me your strength, Wreck!",
      "status": "imported"
    },
    "voice_049:r_9e0c80ac7e33b459": {
      "text": "OK! You damn bastard!",
      "status": "imported"
    },
    "voice_049:r_065443f6ddfcf0d7": {
      "text": "Y-Yeah! No clue, but let's do this!",
      "status": "imported"
    },
    "voice_049:r_47d52a2839c71715": {
      "text": "Let's do this fair and square!",
      "status": "imported"
    },
    "voice_049:r_847f82e7f3eef651": {
      "text": "Huh? You mean hot and hard!",
      "status": "imported"
    },
    "voice_049:r_eb7ae28b53dc033c": {
      "text": "Full throttle from the start!",
      "status": "imported"
    },
    "voice_049:r_857c4a52ce8df0fd": {
      "text": "Mmm, it's so hot I might burn...!",
      "status": "imported"
    },
    "voice_049:r_55417493fce1d347": {
      "text": "Let's go! Uh... Jin's woman!",
      "status": "imported"
    },
    "voice_049:r_8fdf5910927c9591": {
      "text": "I-I'm Yunoha...",
      "status": "imported"
    },
    "voice_049:r_7d724dbcc4451e10": {
      "text": "Kagura Demuri!\\nFight beyond hate!",
      "status": "imported"
    },
    "voice_049:r_93e25418a203cb8f": {
      "text": "Damn right, Headmaster!",
      "status": "imported"
    },
    "voice_049:r_adeb0a29274d3d9b": {
      "text": "Stop!\\nYou can't hurt anyone else!",
      "status": "imported"
    },
    "voice_049:r_24cf161287ef9d5c": {
      "text": "Even your smile is awful, Sylphy!",
      "status": "imported"
    },
    "voice_049:r_8f60f6fc86db3107": {
      "text": "End this one,\\nthen kill till dawn!",
      "status": "imported"
    },
    "voice_049:r_b1de76a75a253c13": {
      "text": "No...!",
      "status": "imported"
    },
    "voice_049:r_128c35bf3e0e394c": {
      "text": "Please, just stop already!",
      "status": "imported"
    },
    "voice_049:r_5213c17e13b23de0": {
      "text": "It'll be quick! Wait there, Sylphy!",
      "status": "imported"
    },
    "voice_049:r_38fdff9483e9245c": {
      "text": "Fun!\\nThis prey smells different...!",
      "status": "imported"
    },
    "voice_049:r_620fedec67706d7d": {
      "text": "That smell...!?\\nIt's utterly foul!!",
      "status": "imported"
    },
    "voice_049:r_9680dcd0fddcfcc7": {
      "text": "You damn Machine Angel!",
      "status": "imported"
    },
    "voice_049:r_2a00f1044ad5cbaa": {
      "text": "Machine Angel! No more meddling!",
      "status": "imported"
    },
    "voice_049:r_3dbeead1bd3164ef": {
      "text": "You strange, scentless man!",
      "status": "imported"
    },
    "voice_049:r_98d15b8cc09bc915": {
      "text": "Give me my damn woman!",
      "status": "imported"
    },
    "voice_049:r_46e86d000250e137": {
      "text": "You did nothing,\\ncowardly Amata...!",
      "status": "imported"
    },
    "voice_049:r_ac341e7976e88f0b": {
      "text": "Amata, I'll murder you!",
      "status": "imported"
    },
    "voice_049:r_cdbd128a5b4127cc": {
      "text": "There you are...! My damn woman!",
      "status": "imported"
    },
    "voice_049:r_cfccaa1fbeda124c": {
      "text": "Heh. That scent finally showed up!",
      "status": "imported"
    },
    "voice_049:r_b1f8ec192b9c083a": {
      "text": "My... Sylphyyyyyy!!",
      "status": "imported"
    },
    "voice_049:r_a007f9ab9cf048b3": {
      "text": "12,000 years on,\\nI kill you at last!",
      "status": "imported"
    },
    "voice_049:r_ddafde4b065ced49": {
      "text": "What the hell is that sound...!?",
      "status": "imported"
    },
    "voice_049:r_de1213040856c089": {
      "text": "Jin! What the hell are you doing?!",
      "status": "imported"
    },
    "voice_049:r_3304412ac41f47a6": {
      "text": "Looks like you've got guts, Jin!",
      "status": "imported"
    },
    "voice_049:r_0c0775e051211840": {
      "text": "Mikage!\\nIt's time we settled this!",
      "status": "imported"
    },
    "voice_049:r_a2afffe1c396f0b3": {
      "text": "Mikage!\\nI've got debts to repay!",
      "status": "imported"
    },
    "voice_049:r_13c25fbdfddc8a24": {
      "text": "That's one nice scent...!",
      "status": "imported"
    },
    "voice_049:r_42ba1ecb310b4bd7": {
      "text": "Tch! Another nice scent...!",
      "status": "imported"
    },
    "voice_049:r_d692f1d420460a47": {
      "text": "Now that's some lively prey!",
      "status": "imported"
    },
    "voice_049:r_a5643cec86b18bd2": {
      "text": "You're worth sinking my teeth into!",
      "status": "imported"
    },
    "voice_049:r_68f2dfab20a4a30e": {
      "text": "What is that? An iron coffin?",
      "status": "imported"
    },
    "voice_049:r_9cedad8237480563": {
      "text": "So tiny,\\nyet it scurries about!",
      "status": "imported"
    },
    "voice_049:r_a03fabecba1508ca": {
      "text": "Always changing shape! What a pain!",
      "status": "imported"
    },
    "voice_049:r_5391b24a71eb10ae": {
      "text": "So that's a Gundam's scent...!",
      "status": "imported"
    },
    "voice_049:r_a554ceef5c87b972": {
      "text": "I'll devour that Gundam myself!",
      "status": "imported"
    },
    "voice_049:r_546c3d5937fbb7ee": {
      "text": "This one's got a weird scent...!",
      "status": "imported"
    },
    "voice_049:r_2c9d94ba13c5fc50": {
      "text": "Ngh...! It's almost scentless!?",
      "status": "imported"
    },
    "voice_049:r_a77f4913375098d2": {
      "text": "This one...! We'd get along great!",
      "status": "imported"
    },
    "voice_049:r_428c2116ac3071b1": {
      "text": "Heh, listen to you singing away!",
      "status": "imported"
    },
    "voice_049:r_84c116267b79f540": {
      "text": "I'll snap that drill in half!",
      "status": "imported"
    },
    "voice_049:r_dad38ee29af2df3a": {
      "text": "The machine itself has a scent...!?",
      "status": "imported"
    },
    "voice_049:r_3d32e86f8dc80909": {
      "text": "What is that!?\\nSo damn fluffy!",
      "status": "imported"
    },
    "voice_049:r_70451ffbabe2f876": {
      "text": "Fast, are you?\\nEscape my claws!",
      "status": "imported"
    },
    "voice_049:r_69dfa1659715e2fa": {
      "text": "Bigger prey means\\na better kill!",
      "status": "imported"
    },
    "voice_049:r_d996fd6d4ef5b329": {
      "text": "You look tougher than the rest!",
      "status": "imported"
    },
    "voice_049:r_8ab47a28f99ef565": {
      "text": "Come at me, you freaks!",
      "status": "imported"
    },
    "voice_049:r_546de3fb6db156ea": {
      "text": "All these damn swarms...! Back off!",
      "status": "imported"
    },
    "voice_049:r_9072ea7bc71df136": {
      "text": "That scent!\\nYou're the root cause!",
      "status": "imported"
    },
    "voice_049:r_04e815a8d425827d": {
      "text": "I'll devour\\nevery last bit of you!!",
      "status": "imported"
    },
    "voice_049:r_d89011fe3e5d082a": {
      "text": "We're going too!\\nBeyond love!",
      "status": "imported"
    },
    "voice_049:r_3c5b0c2ac812d5de": {
      "text": "I smell the vilest stench on you!",
      "status": "imported"
    },
    "voice_049:r_5b9e8897190892eb": {
      "text": "Time to repay what I owe, Mikage!",
      "status": "imported"
    },
    "voice_049:r_7bea3023abbf8a94": {
      "text": "Wait!",
      "status": "imported"
    },
    "voice_049:r_dd01a4c0d1b36a8d": {
      "text": "I'll pay you back double!",
      "status": "imported"
    },
    "voice_049:r_20920ad2eb3542db": {
      "text": "Struggle and it'll hurt!",
      "status": "imported"
    },
    "voice_049:r_0ab7914877fd48ed": {
      "text": "Bastard! Now it's my turn!",
      "status": "imported"
    },
    "voice_049:r_cb846feec748c2e3": {
      "text": "You won't get away!",
      "status": "imported"
    },
    "voice_049:r_c958860b0676b1f5": {
      "text": "You're not leaving unscathed...!",
      "status": "imported"
    },
    "voice_049:r_5e2669b82ef75ce3": {
      "text": "Hit me, I hit back!\\nThat's my way!",
      "status": "imported"
    },
    "voice_049:r_7847e0ed7dc9282d": {
      "text": "Get back here, damn woman!",
      "status": "imported"
    },
    "voice_049:r_e42b52c7a987b906": {
      "text": "Let's settle this, Mikage!",
      "status": "imported"
    },
    "voice_049:r_6825fd1ff907bd22": {
      "text": "Our hearts\\nwill fell your hatred!",
      "status": "imported"
    },
    "voice_049:r_607f666f1563bc0d": {
      "text": "Then we'll save both Earths!",
      "status": "imported"
    },
    "voice_049:r_82c09f011d703b2c": {
      "text": "I'll cover you!",
      "status": "imported"
    },
    "voice_049:r_2b4d8818c77b6dca": {
      "text": "That's my prey!",
      "status": "imported"
    },
    "voice_049:r_087354f2db0a31e6": {
      "text": "Man, you're slow!",
      "status": "imported"
    },
    "voice_049:r_db02a2dec93dd263": {
      "text": "Stay back if you're that weak!",
      "status": "imported"
    },
    "voice_049:r_d520c6d5298a848d": {
      "text": "Why the hell can't I attack?!",
      "status": "imported"
    },
    "voice_049:r_099e2458cabf796f": {
      "text": "I can't counter!? Damn it!!",
      "status": "imported"
    },
    "voice_049:r_fd910d714be70870": {
      "text": "So that bastard set me up...!",
      "status": "imported"
    },
    "voice_049:r_9736f29b11344ec3": {
      "text": "Next time, I'll repay you 100 times!",
      "status": "imported"
    },
    "voice_049:r_fcd05582aa5c6068": {
      "text": "The scent... vanished...!?",
      "status": "imported"
    },
    "voice_049:r_bece29562818acba": {
      "text": "Damn, that bastard runs fast...!",
      "status": "imported"
    },
    "voice_049:r_494b5da92ed24ecb": {
      "text": "I said it's useless!",
      "status": "imported"
    },
    "voice_049:r_a4a5a96f4bd58920": {
      "text": "Give up already, you damn amateur!",
      "status": "imported"
    },
    "voice_049:r_b57d2d74233f889a": {
      "text": "What a damn letdown!",
      "status": "imported"
    },
    "voice_049:r_cd06d0820d82524b": {
      "text": "That's the best you've got?!",
      "status": "imported"
    },
    "voice_049:r_c94c6d04be583774": {
      "text": "What a pathetic attack.",
      "status": "imported"
    },
    "voice_049:r_e54e2c99ef8297af": {
      "text": "You think that'll win this?!",
      "status": "imported"
    },
    "voice_049:r_f16a3eb0bcaac082": {
      "text": "Ha! Don't make me laugh!",
      "status": "imported"
    },
    "voice_049:r_10a408809e512df1": {
      "text": "Stay out of our way!",
      "status": "imported"
    },
    "voice_049:r_bc7b9e308b879dd4": {
      "text": "You don't give off any scent...!",
      "status": "imported"
    },
    "voice_049:r_98902fd3143c393e": {
      "text": "Show me you're no coward,\\nAmata!",
      "status": "imported"
    },
    "voice_049:r_d907fbd7bc1c4298": {
      "text": "You're weak...! Your love is too!",
      "status": "imported"
    },
    "voice_049:r_96b21e3a028dd074": {
      "text": "Yes, this is the scent...!",
      "status": "imported"
    },
    "voice_049:r_ce140b5d8e6b7310": {
      "text": "I knew it. You still reek...!",
      "status": "imported"
    },
    "voice_049:r_0e0335789c5396d7": {
      "text": "How's that?! See it, Amata?!",
      "status": "imported"
    },
    "voice_049:r_a8e85bd950696403": {
      "text": "Nice, Kagura!\\nI won't fall behind!",
      "status": "imported"
    },
    "voice_049:r_772c8bc40ab6cb61": {
      "text": "Not bad, you damn bastard!",
      "status": "imported"
    },
    "voice_049:r_58dd2826a199ef51": {
      "text": "I can't let Wreck cry,\\nnow can I!",
      "status": "imported"
    },
    "voice_049:r_aadc0b2442adb93b": {
      "text": "You're a marvelous conductor.",
      "status": "imported"
    },
    "voice_049:r_e7a8cd8ed5bc2d1b": {
      "text": "What the hell does that mean?",
      "status": "imported"
    },
    "voice_049:r_041dd920da4a7c17": {
      "text": "So that's what wild instinct is...!",
      "status": "imported"
    },
    "voice_049:r_c7f4280cde4605b3": {
      "text": "Reason and sense are useless to me!",
      "status": "imported"
    },
    "voice_049:r_ec349c8ea9511a18": {
      "text": "Amazing...! I've got to learn that!",
      "status": "imported"
    },
    "voice_049:r_33236ffa3ea95b68": {
      "text": "Maybe I'll train you later!",
      "status": "imported"
    },
    "voice_049:r_689d0b123de71ae0": {
      "text": "What incredible reflexes!",
      "status": "imported"
    },
    "voice_049:r_84883aa95f63ce32": {
      "text": "I'm sensitive to dangerous scents!",
      "status": "imported"
    },
    "voice_049:r_25493e978ce8ff16": {
      "text": "Impressive as ever, Kagura Demuri.",
      "status": "imported"
    },
    "voice_049:r_7316666150e42960": {
      "text": "That's nothing special to me!",
      "status": "imported"
    },
    "voice_049:r_a6630215fefaf294": {
      "text": "Like that'll wooooork?!",
      "status": "imported"
    },
    "voice_049:r_942ca03c9de80143": {
      "text": "What the hell? A barrier?",
      "status": "imported"
    },
    "voice_049:r_d8c669c70659e18a": {
      "text": "Looks like the barrier activated.",
      "status": "imported"
    },
    "voice_049:r_8f5bade7ac2db78e": {
      "text": "Huh? Did something hit me?",
      "status": "imported"
    },
    "voice_049:r_05ea490d2f522520": {
      "text": "Is this fool playing around?",
      "status": "imported"
    },
    "voice_049:r_f5658c702d91db7a": {
      "text": "What's with this one? All for show?",
      "status": "imported"
    },
    "voice_049:r_686df329b50f195b": {
      "text": "Weak, weak... Way too weak!",
      "status": "imported"
    },
    "voice_049:r_25f0ab0fa3cf690c": {
      "text": "You...!",
      "status": "imported"
    },
    "voice_049:r_b708a1d959013dbf": {
      "text": "Come at me for real! Oraaah!",
      "status": "imported"
    },
    "voice_049:r_59fca03e929366c1": {
      "text": "Damn you! Quit clinging to me...!",
      "status": "imported"
    },
    "voice_049:r_0d65eb631dcb7514": {
      "text": "There won't be a next time!",
      "status": "imported"
    },
    "voice_049:r_d03018a31e23f1e9": {
      "text": "I don't even need to dodge that!",
      "status": "imported"
    },
    "voice_049:r_279da5f732aa8847": {
      "text": "What?! Dodge it properly!",
      "status": "imported"
    },
    "voice_049:r_97f82e3cb6f70110": {
      "text": "I can't worry about that now!",
      "status": "imported"
    },
    "voice_049:r_c5611d8dd6def96b": {
      "text": "So you do get it, Wreck!",
      "status": "imported"
    },
    "voice_049:r_6f12cc8ed2732eb5": {
      "text": "Hmm...",
      "status": "imported"
    },
    "voice_049:r_7abfc55f8fb62ba7": {
      "text": "W-What? Are you mocking me?",
      "status": "imported"
    },
    "voice_049:r_99e7a66c650b5892": {
      "text": "Know the phrase 'Never let up'?",
      "status": "imported"
    },
    "voice_049:r_5b2247b5cfbcd7b2": {
      "text": "What's that? Never heard it before.",
      "status": "imported"
    },
    "voice_049:r_2d7a9c06347582d9": {
      "text": "Huh? Did something hit us?",
      "status": "imported"
    },
    "voice_049:r_bf953d64c3c7d9b7": {
      "text": "You... might be a big deal...",
      "status": "imported"
    },
    "voice_049:r_e09b933e3e706779": {
      "text": "T-These things happen, right?!",
      "status": "imported"
    },
    "voice_049:r_66236eb99b676e5b": {
      "text": "You worried? That's nice of you.",
      "status": "imported"
    },
    "voice_049:r_9639a2dbcd2f58ed": {
      "text": "It seems I miscalculated.",
      "status": "imported"
    },
    "voice_049:r_aeea0893acb93d35": {
      "text": "Tch...! Was that a jab?!",
      "status": "imported"
    },
    "voice_049:r_b31568654e53487b": {
      "text": "Gnnnnh...!",
      "status": "imported"
    },
    "voice_049:r_2502132569141ea3": {
      "text": "Screw you...!",
      "status": "imported"
    },
    "voice_049:r_1ff312798a52c8eb": {
      "text": "Uagh...! Damn it!",
      "status": "imported"
    },
    "voice_049:r_fa07d90fca62f593": {
      "text": "Ngh...! You got me good!",
      "status": "imported"
    },
    "voice_049:r_a25bf2676ecf9d83": {
      "text": "You persistent bastard!",
      "status": "imported"
    },
    "voice_049:r_237a0288b42dce20": {
      "text": "All right, now I'm pissed...!",
      "status": "imported"
    },
    "voice_049:r_0556e8a22779ea8e": {
      "text": "Ngh! My brain's boiling...!",
      "status": "imported"
    },
    "voice_049:r_09d377101a48d92a": {
      "text": "You bastard!\\nWant me to kill you?!",
      "status": "imported"
    },
    "voice_049:r_11517cc7b0494dbf": {
      "text": "Stay out of my damn woman's way!",
      "status": "imported"
    },
    "voice_049:r_b5864501463db244": {
      "text": "Bastard! Better than I thought!",
      "status": "imported"
    },
    "voice_049:r_a88939ea84b4474d": {
      "text": "Shut up, you coward, Amata...!",
      "status": "imported"
    },
    "voice_049:r_a870d0cf7cc11ec6": {
      "text": "That sound... You again...!",
      "status": "imported"
    },
    "voice_049:r_03f6158ef83964f3": {
      "text": "Mine...! Mine...!\\nSylphyyyyyy!!",
      "status": "imported"
    },
    "voice_049:r_2970a83693cdcc25": {
      "text": "Raaaaagh!\\nMy damn womaaaaan!!",
      "status": "imported"
    },
    "voice_049:r_be661448b85d0009": {
      "text": "Bastard! Brute force isn't fair!",
      "status": "imported"
    },
    "voice_049:r_958a56c1151cab9e": {
      "text": "Vega's Machine Giants can fight!",
      "status": "imported"
    },
    "voice_049:r_8b18aa4cc69547df": {
      "text": "What are you doing, Kagura?!",
      "status": "imported"
    },
    "voice_049:r_3e87f6fc3ea65aef": {
      "text": "Quiet, Amata!\\nWatch from there!",
      "status": "imported"
    },
    "voice_049:r_5508a7bfa9074eb9": {
      "text": "You're turning this around, right?",
      "status": "imported"
    },
    "voice_049:r_09a003e91f0d5dc7": {
      "text": "Of course! Trust me and wait!",
      "status": "imported"
    },
    "voice_049:r_192447448ebd7bb5": {
      "text": "Shall we play our concerto now?",
      "status": "imported"
    },
    "voice_049:r_e92920ba4b301b9f": {
      "text": "So I can't manage this alone...!",
      "status": "imported"
    },
    "voice_049:r_207b256d613bb896": {
      "text": "Hey! What's the meaning of this?!",
      "status": "imported"
    },
    "voice_049:r_a6fd676d8146501b": {
      "text": "What do you mean? It's obvious!",
      "status": "imported"
    },
    "voice_049:r_94d35e5fa8e3a198": {
      "text": "Oh no, this is really bad...!",
      "status": "imported"
    },
    "voice_049:r_b686510e636673f3": {
      "text": "Right? This is so exciting!",
      "status": "imported"
    },
    "voice_049:r_59369bad143d4272": {
      "text": "A worthy foe, bastard!\\nRight?!",
      "status": "imported"
    },
    "voice_049:r_25f9b1e39dd8d366": {
      "text": "D-Don't ask me that...",
      "status": "imported"
    },
    "voice_049:r_307477bedd148060": {
      "text": "Don't disappoint me,\\nKagura Demuri.",
      "status": "imported"
    },
    "voice_049:r_09a780acca0eb4b0": {
      "text": "That was my plan from the start!",
      "status": "imported"
    },
    "voice_049:r_96d39b8bdfa6f183": {
      "text": "Guaaaaaagh...!",
      "status": "imported"
    },
    "voice_049:r_0e4f9b8a2d26ebff": {
      "text": "Not yet...! I can still fight!",
      "status": "imported"
    },
    "voice_049:r_79e0d542fe12bcf7": {
      "text": "Damn yooooou!",
      "status": "imported"
    },
    "voice_049:r_eff747ba39a55393": {
      "text": "Give me...! My damn woman!",
      "status": "imported"
    },
    "voice_049:r_b2dc77aa6dd77e69": {
      "text": "Tch...! You little...!",
      "status": "imported"
    },
    "voice_049:r_445d40d8b5d7092b": {
      "text": "Not bad!\\nNow I can get serious too!",
      "status": "imported"
    },
    "voice_049:r_bbb633cb5e8e6daf": {
      "text": "Come at me! I'm still alive!",
      "status": "imported"
    },
    "voice_049:r_0abd8b6c713ccdac": {
      "text": "While I breathe,\\nI'll bite into you!",
      "status": "imported"
    },
    "voice_049:r_f4ff463b2fda1b86": {
      "text": "All of you\\nkeep getting in our way!",
      "status": "imported"
    },
    "voice_049:r_4e63c037d3cb8a3d": {
      "text": "My damn woman's...!\\nMine alooooone!!",
      "status": "imported"
    },
    "voice_049:r_9ca8d188ae805e3a": {
      "text": "Kagura! Use my strength too!",
      "status": "imported"
    },
    "voice_049:r_795ed21f3e28e1f5": {
      "text": "Thanks, Amata!\\nNow the fight begins!",
      "status": "imported"
    },
    "voice_049:r_141415c1def5ab2d": {
      "text": "Their lives are yours...\\nDon't lose!",
      "status": "imported"
    },
    "voice_049:r_c894e35becf35a03": {
      "text": "Leave it to me, Wreck!",
      "status": "imported"
    },
    "voice_049:r_79b1abf5fc86483c": {
      "text": "Allegro vivace to the end.\\nSo you.",
      "status": "imported"
    },
    "voice_049:r_e9a11621911acb19": {
      "text": "Of course! I'm always myself!",
      "status": "imported"
    },
    "voice_049:r_d52bece55796f599": {
      "text": "Then I'll steel myself too!",
      "status": "imported"
    },
    "voice_049:r_358fe5a50bbee1df": {
      "text": "You've got guts, Filler!",
      "status": "imported"
    },
    "voice_049:r_638834e16724002f": {
      "text": "No way, no way! Absolutely no way!",
      "status": "imported"
    },
    "voice_049:r_b02fca1590ac1210": {
      "text": "Nothing in this world is absolute!",
      "status": "imported"
    },
    "voice_049:r_f0344d2fbaa9db77": {
      "text": "Kagura! Take my little strength too!",
      "status": "imported"
    },
    "voice_049:r_3328eef766ff2c2c": {
      "text": "Yeah! I'm counting on it!",
      "status": "imported"
    },
    "voice_049:r_23b037cf6ccc695c": {
      "text": "My bet's on you, Kagura Demuri.",
      "status": "imported"
    },
    "voice_049:r_883ad1128d340c5e": {
      "text": "That's the right choice, Headmaster!",
      "status": "imported"
    },
    "voice_049:r_a9e6ed99025a703b": {
      "text": "Sylphy! You're the one I...!",
      "status": "imported"
    },
    "voice_049:r_b0d1459d6daeebbe": {
      "text": "My worst woman...!\\nI won't lose you!",
      "status": "imported"
    },
    "voice_049:r_cd4893b409472e97": {
      "text": "Kyaaaaaaaaah!",
      "status": "imported"
    },
    "voice_049:r_5691cc71770ffdde": {
      "text": "Sylphyyyyyy!!",
      "status": "imported"
    },
    "voice_049:r_ad54419336b49578": {
      "text": "Daaaaamn iiiiiit...!",
      "status": "imported"
    },
    "voice_049:r_63c353e1e05e8e39": {
      "text": "Sylphyyyyyy...!",
      "status": "imported"
    },
    "voice_049:r_87646dd472438e88": {
      "text": "Uwaaaaaaaaagh...!",
      "status": "imported"
    },
    "voice_049:r_4e32ac89cba02001": {
      "text": "Stopping here? What a damn wimp...",
      "status": "imported"
    },
    "voice_049:r_02d24e5915bfa5b7": {
      "text": "Men till dawn, women all night...?",
      "status": "imported"
    },
    "voice_049:r_9331c2c2ef55c78f": {
      "text": "Fine. Save the fun for next fight.",
      "status": "imported"
    },
    "voice_049:r_49734bdb3507acf7": {
      "text": "See you around!",
      "status": "imported"
    },
    "voice_049:r_2a730c9b4df0dca3": {
      "text": "Lame hello! Kill or quit! Shape up!",
      "status": "imported"
    },
    "voice_049:r_1e5842ba5dc3f705": {
      "text": "Heh...! Nothing's impossible for me!",
      "status": "imported"
    },
    "voice_049:r_9747bd61ad23ecd3": {
      "text": "Players! I... er, await your return!",
      "status": "imported"
    },
    "voice_049:r_c885ff2097749991": {
      "text": "I'll dig with all my strength!",
      "status": "imported"
    },
    "voice_049:r_a8da7f8d8b705db0": {
      "text": "Let's do this, Gepard!",
      "status": "imported"
    },
    "voice_049:r_02e1c5e19de5bd22": {
      "text": "Whoaaaaa!!",
      "status": "imported"
    },
    "voice_049:r_6fb823898811e210": {
      "text": "Punch right throoooough!!",
      "status": "imported"
    },
    "voice_049:r_5dcbcf1682cc3ab8": {
      "text": "I'm... digging a hole!",
      "status": "imported"
    },
    "voice_049:r_5a20988e743dc1d0": {
      "text": "Everyone, lend me your strength!",
      "status": "imported"
    },
    "voice_049:r_197f05bf899b7697": {
      "text": "Dimension Tunnel Shell!",
      "status": "imported"
    },
    "voice_049:r_623ee03bd91ab2a1": {
      "text": "Goooooo!!",
      "status": "imported"
    },
    "voice_049:r_c5c491f8761152f0": {
      "text": "Go! All of you, go beyond love!!",
      "status": "imported"
    },
    "voice_049:r_15042263763f11bb": {
      "text": "No, not EVOL! Its new name is...!",
      "status": "imported"
    },
    "voice_049:r_96b3a8f080aea8b4": {
      "text": "Reversal!",
      "status": "imported"
    },
    "voice_049:r_3d4fa015b8b31648": {
      "text": "Wingless, yet winged...\\nSo rare.",
      "status": "imported"
    },
    "voice_049:r_c1f3167d7dd97543": {
      "text": "Ah, flesh...\\nHow wonderful...!",
      "status": "imported"
    },
    "voice_049:r_1ac46173650ffe13": {
      "text": "Kagura, you\\ncan't defy me, can you?",
      "status": "imported"
    },
    "voice_049:r_53660d6bc7fe8513": {
      "text": "Heh heh heh heh heh...",
      "status": "imported"
    },
    "voice_049:r_cd84325a7c1a820f": {
      "text": "I'll go on ahead!",
      "status": "imported"
    },
    "voice_049:r_0465f74c0488ad70": {
      "text": "This might be more than a warning!",
      "status": "imported"
    },
    "voice_049:r_a30c8238b5208470": {
      "text": "I'll knock them out of the sky!",
      "status": "imported"
    },
    "voice_049:r_64bf1c63c7c1ebdd": {
      "text": "This is no place for you!",
      "status": "imported"
    },
    "voice_049:r_f6d5042f671118fa": {
      "text": "So that's my prey?",
      "status": "imported"
    },
    "voice_049:r_0be18539fac21ba4": {
      "text": "So it's one-on-one!",
      "status": "imported"
    },
    "voice_049:r_c05bd0cf089d667f": {
      "text": "I'll do whatever I damn well please!",
      "status": "imported"
    },
    "voice_049:r_f69a0e1d0d67fd0e": {
      "text": "I'll tear them all to shreds!",
      "status": "imported"
    }
  }
}
