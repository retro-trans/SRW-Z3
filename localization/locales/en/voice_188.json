{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_188:r_479b340ccc6c572b": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_188:r_77949221bf58f862": {
      "text": "I'll knock you flat!",
      "status": "imported"
    },
    "voice_188:r_70b9c4b9f1f37eff": {
      "text": "Drop dead!",
      "status": "imported"
    },
    "voice_188:r_9fcb3754cb1773c7": {
      "text": "Here you go!",
      "status": "imported"
    },
    "voice_188:r_3559d2fad32c2435": {
      "text": "Get squashed flat!",
      "status": "imported"
    },
    "voice_188:r_f7570547e9f80a64": {
      "text": "Move and I'll get mad!",
      "status": "imported"
    },
    "voice_188:r_cbab0f4720e1fcf1": {
      "text": "I'll tear you to shreds!",
      "status": "imported"
    },
    "voice_188:r_0bbe0b4f5364e732": {
      "text": "I'll crush and roll you into a ball!",
      "status": "imported"
    },
    "voice_188:r_5dda5198137cb02a": {
      "text": "You're one stubborn bastard!",
      "status": "imported"
    },
    "voice_188:r_83ec59afbecdec14": {
      "text": "Gundam vs. Gunmen! Full-on clash!",
      "status": "imported"
    },
    "voice_188:r_e20bfd42ad95a3c9": {
      "text": "Gundams, huh?\\nHow many types exist!?",
      "status": "imported"
    },
    "voice_188:r_0f58a8822381e57f": {
      "text": "What is it!? A bird!? A plane!?",
      "status": "imported"
    },
    "voice_188:r_6dbcc507fb61b51d": {
      "text": "Beast robots belong with Beastmen!",
      "status": "imported"
    },
    "voice_188:r_b42ab697149a7c8a": {
      "text": "Hand over the bird on your chest!",
      "status": "imported"
    },
    "voice_188:r_4de4fcf3b440baf4": {
      "text": "That thing's just standing there!",
      "status": "imported"
    },
    "voice_188:r_0121a166c715cdff": {
      "text": "Damn you and all that combining!",
      "status": "imported"
    },
    "voice_188:r_30fad37a42bd3ad3": {
      "text": "Who cares what god you are!",
      "status": "imported"
    },
    "voice_188:r_80a0b2a84e05d81a": {
      "text": "That's the captain! Crush 'em!",
      "status": "imported"
    },
    "voice_188:r_4a9ac1dff86506d9": {
      "text": "Big ones are worth punching!",
      "status": "imported"
    },
    "voice_188:r_bc8538e6af3d2577": {
      "text": "Slippery little bastard!",
      "status": "imported"
    },
    "voice_188:r_924516c8de2b5342": {
      "text": "You gnat! I'll swat you down!",
      "status": "imported"
    },
    "voice_188:r_da1174533722333f": {
      "text": "I'll smash their nest to bits!",
      "status": "imported"
    },
    "voice_188:r_fdeb8162976e72c1": {
      "text": "I can beat a little runt like that!",
      "status": "imported"
    },
    "voice_188:r_0fadb5c26df92b42": {
      "text": "Time to counterattack!",
      "status": "imported"
    },
    "voice_188:r_6b15af9a0057cdc8": {
      "text": "You don't get to hit and run!",
      "status": "imported"
    },
    "voice_188:r_15b4a90140e8a33a": {
      "text": "You messed with me! Now you're dead!",
      "status": "imported"
    },
    "voice_188:r_af884a6b11dff121": {
      "text": "I pay back what I owe right away!",
      "status": "imported"
    },
    "voice_188:r_ac6fe7838e95647b": {
      "text": "Hey, wait! Don't you run!",
      "status": "imported"
    },
    "voice_188:r_77ca87eacd17ad52": {
      "text": "Ha ha ha ha! Running won't save you!",
      "status": "imported"
    },
    "voice_188:r_bf3244994760e535": {
      "text": "Like hell I'll let you escape!",
      "status": "imported"
    },
    "voice_188:r_aabfb21c9d069ce7": {
      "text": "I'll help! You'd better be grateful!",
      "status": "imported"
    },
    "voice_188:r_02479dc8fe989560": {
      "text": "I'll take you on!",
      "status": "imported"
    },
    "voice_188:r_a2df00f91a9b0a9e": {
      "text": "Damn it! This is so frustrating!",
      "status": "imported"
    },
    "voice_188:r_48b60d6c48b9b142": {
      "text": "Huh!? I can't counterattack!",
      "status": "imported"
    },
    "voice_188:r_8927e6fb681aa809": {
      "text": "I can't do a damn thing!",
      "status": "imported"
    },
    "voice_188:r_665f01666859013b": {
      "text": "Fine, I'll let you go this time.",
      "status": "imported"
    },
    "voice_188:r_a571eec59b258d11": {
      "text": "Crap! My Gunmen and I are starving!",
      "status": "imported"
    },
    "voice_188:r_ddbe581c5ea9183d": {
      "text": "Cheating! Dirty! Cowardly! No fair!",
      "status": "imported"
    },
    "voice_188:r_faae935cca0edc72": {
      "text": "Why the hell are you over there!?",
      "status": "imported"
    },
    "voice_188:r_d4430bf362340b32": {
      "text": "Impressed now!?",
      "status": "imported"
    },
    "voice_188:r_6ff1323b355593e0": {
      "text": "Nyah nyah! You missed!",
      "status": "imported"
    },
    "voice_188:r_b7b5625d7cd4282f": {
      "text": "You're weak! I'm strong!",
      "status": "imported"
    },
    "voice_188:r_36133ad73a73ef98": {
      "text": "Heh heh heh! What luck!",
      "status": "imported"
    },
    "voice_188:r_920740a0219c5085": {
      "text": "I did it! Woo-hoo!!",
      "status": "imported"
    },
    "voice_188:r_a8451712c57c1a72": {
      "text": "Useless, useless!",
      "status": "imported"
    },
    "voice_188:r_52dfc56b14b93551": {
      "text": "Wahaha! It itches, it itches!",
      "status": "imported"
    },
    "voice_188:r_1b9b2aab5cb104da": {
      "text": "Hm? Did something hit me?",
      "status": "imported"
    },
    "voice_188:r_342044c706a2340f": {
      "text": "That actually hit me!",
      "status": "imported"
    },
    "voice_188:r_cf41e8828a90cbdb": {
      "text": "Stop it! That tickles!",
      "status": "imported"
    },
    "voice_188:r_719e897304ec42d4": {
      "text": "You spineless worm! Try again!",
      "status": "imported"
    },
    "voice_188:r_d5e0a2317c40d322": {
      "text": "What, are you holding back?",
      "status": "imported"
    },
    "voice_188:r_ec2ea17765052401": {
      "text": "What a boring bastard!",
      "status": "imported"
    },
    "voice_188:r_f2d4255f1c2f7542": {
      "text": "Ugh, my head's spinning!",
      "status": "imported"
    },
    "voice_188:r_5d08ad19e2da125b": {
      "text": "M-my nose is bleeding, damn it!",
      "status": "imported"
    },
    "voice_188:r_a7246b52782a877e": {
      "text": "You'll regret making me angry!",
      "status": "imported"
    },
    "voice_188:r_dc8701f6bcb9904f": {
      "text": "Damn! What'd you do to my Gunmen?!",
      "status": "imported"
    },
    "voice_188:r_d6bdd730f24f66eb": {
      "text": "O-okay!\\nThat never happened!",
      "status": "imported"
    },
    "voice_188:r_41997412868c48c4": {
      "text": "H-heh...\\nWe'll call it a draw.",
      "status": "imported"
    },
    "voice_188:r_9e6cf4f389dae55c": {
      "text": "Like hell I'll lose to you lot!",
      "status": "imported"
    },
    "voice_188:r_9e0c80ac7e33b459": {
      "text": "Not bad for something so small!",
      "status": "imported"
    },
    "voice_188:r_7432ef43ed3471dc": {
      "text": "That runt can\\nfight me evenly!?",
      "status": "imported"
    },
    "voice_188:r_065443f6ddfcf0d7": {
      "text": "Damn Gundam! You've done it now!",
      "status": "imported"
    },
    "voice_188:r_47d52a2839c71715": {
      "text": "I-I can't underestimate wild power!",
      "status": "imported"
    },
    "voice_188:r_847f82e7f3eef651": {
      "text": "Gah! That thing's not just for show!",
      "status": "imported"
    },
    "voice_188:r_eb7ae28b53dc033c": {
      "text": "Big and strong? That's cheating!",
      "status": "imported"
    },
    "voice_188:r_857c4a52ce8df0fd": {
      "text": "Th-that thing really is super...!",
      "status": "imported"
    },
    "voice_188:r_55417493fce1d347": {
      "text": "Not just speed -\\nit's powerful too!?",
      "status": "imported"
    },
    "voice_188:r_8fdf5910927c9591": {
      "text": "It's so fast! I can't get a lock!",
      "status": "imported"
    },
    "voice_188:r_7d724dbcc4451e10": {
      "text": "Nngh! I-I'm done for!",
      "status": "imported"
    },
    "voice_188:r_93e25418a203cb8f": {
      "text": "Ugh! I'm seeing sparks!!",
      "status": "imported"
    },
    "voice_188:r_adeb0a29274d3d9b": {
      "text": "Ow, hot! My fur's on fire!!",
      "status": "imported"
    },
    "voice_188:r_24cf161287ef9d5c": {
      "text": "Someone! Come help me right now!",
      "status": "imported"
    },
    "voice_188:r_8f60f6fc86db3107": {
      "text": "R-run...!\\nI want to, but I can't!",
      "status": "imported"
    },
    "voice_188:r_b1de76a75a253c13": {
      "text": "I'm done! Fire's shooting all over!",
      "status": "imported"
    },
    "voice_188:r_128c35bf3e0e394c": {
      "text": "This is bad! Bad! Really bad!",
      "status": "imported"
    },
    "voice_188:r_5213c17e13b23de0": {
      "text": "S-sorry!\\nI take back the runt crack!",
      "status": "imported"
    },
    "voice_188:r_38fdff9483e9245c": {
      "text": "G-G-Gundam!!",
      "status": "imported"
    },
    "voice_188:r_620fedec67706d7d": {
      "text": "Damn it!\\nEnough already, Gundam!!",
      "status": "imported"
    },
    "voice_188:r_9680dcd0fddcfcc7": {
      "text": "That's no beast! It's a monster!",
      "status": "imported"
    },
    "voice_188:r_2a00f1044ad5cbaa": {
      "text": "Ngh!\\nYou're stronger than you look!",
      "status": "imported"
    },
    "voice_188:r_3dbeead1bd3164ef": {
      "text": "You're bigger! Give me a handicap!",
      "status": "imported"
    },
    "voice_188:r_98d15b8cc09bc915": {
      "text": "Heeelp meee!!",
      "status": "imported"
    },
    "voice_188:r_46e86d000250e137": {
      "text": "E-eject!!",
      "status": "imported"
    },
    "voice_188:r_ac341e7976e88f0b": {
      "text": "Damn it! I'm outta here!!",
      "status": "imported"
    },
    "voice_188:r_cdbd128a5b4127cc": {
      "text": "Waaagh!!",
      "status": "imported"
    },
    "voice_188:r_cfccaa1fbeda124c": {
      "text": "I-I'm finished!!",
      "status": "imported"
    },
    "voice_188:r_dad38ee29af2df3a": {
      "text": "Heh! You're right where I want you!",
      "status": "imported"
    },
    "voice_188:r_3d32e86f8dc80909": {
      "text": "Move! The Beastman's coming through!",
      "status": "imported"
    },
    "voice_188:r_d996fd6d4ef5b329": {
      "text": "Hey! Get back here!",
      "status": "imported"
    },
    "voice_188:r_8ab47a28f99ef565": {
      "text": "My turn at last!",
      "status": "imported"
    },
    "voice_188:r_546de3fb6db156ea": {
      "text": "Y-you'll pay for this!",
      "status": "imported"
    },
    "voice_188:r_ca85f87cee5e31f7": {
      "text": "Wait! Calm down! Okay? Okay?",
      "status": "imported"
    },
    "voice_188:r_9072ea7bc71df136": {
      "text": "M-my Gunmen's\\nbeen torn to pieces!",
      "status": "imported"
    },
    "voice_188:r_04e815a8d425827d": {
      "text": "Whoa! That one really hurt!",
      "status": "imported"
    },
    "voice_188:r_d89011fe3e5d082a": {
      "text": "Damn! Not this kinda spotlight!!",
      "status": "imported"
    },
    "voice_188:r_3c5b0c2ac812d5de": {
      "text": "That stung!",
      "status": "imported"
    },
    "voice_188:r_5b9e8897190892eb": {
      "text": "My Gunmen's built tough!",
      "status": "imported"
    },
    "voice_188:r_7bea3023abbf8a94": {
      "text": "Heh heh! That woke me right up!",
      "status": "imported"
    },
    "voice_188:r_dd01a4c0d1b36a8d": {
      "text": "You're slower than a turtle!",
      "status": "imported"
    },
    "voice_188:r_20920ad2eb3542db": {
      "text": "I can do it when I try! I'm great!",
      "status": "imported"
    },
    "voice_188:r_0ab7914877fd48ed": {
      "text": "I can see every move you're making!",
      "status": "imported"
    },
    "voice_188:r_cb846feec748c2e3": {
      "text": "Like that'll hurt!",
      "status": "imported"
    },
    "voice_188:r_5e2669b82ef75ce3": {
      "text": "Witness my secret weapon's power!",
      "status": "imported"
    },
    "voice_188:r_7847e0ed7dc9282d": {
      "text": "I'll go first!",
      "status": "imported"
    },
    "voice_188:r_e42b52c7a987b906": {
      "text": "Pardon me, I'm going on ahead!",
      "status": "imported"
    },
    "voice_188:r_6825fd1ff907bd22": {
      "text": "I'll make myself useful too!",
      "status": "imported"
    },
    "voice_188:r_607f666f1563bc0d": {
      "text": "That one's my prey!",
      "status": "imported"
    }
  }
}
