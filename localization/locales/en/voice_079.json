{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_079:r_479b340ccc6c572b": {
      "text": "Sorry to keep you waiting! My turn!",
      "status": "imported"
    },
    "voice_079:r_ca4acbac57a2a35e": {
      "text": "Today's heroine is yours truly!",
      "status": "imported"
    },
    "voice_079:r_77949221bf58f862": {
      "text": "I'm the seme this time!",
      "status": "imported"
    },
    "voice_079:r_70b9c4b9f1f37eff": {
      "text": "Sazanka Bianca, reporting in!",
      "status": "imported"
    },
    "voice_079:r_9fcb3754cb1773c7": {
      "text": "I get to be Head!\\nI'll go all out!",
      "status": "imported"
    },
    "voice_079:r_3559d2fad32c2435": {
      "text": "Everyone, rot away!",
      "status": "imported"
    },
    "voice_079:r_f7570547e9f80a64": {
      "text": "Heh heh heh\\nmy Element is corrosion!",
      "status": "imported"
    },
    "voice_079:r_cbab0f4720e1fcf1": {
      "text": "I'll rot all matter\\nuntil it decays!",
      "status": "imported"
    },
    "voice_079:r_0bbe0b4f5364e732": {
      "text": "Heh heh heh!\\nHeh heh heh heh heh!",
      "status": "imported"
    },
    "voice_079:r_5dda5198137cb02a": {
      "text": "Sazanka, leave support to me!",
      "status": "imported"
    },
    "voice_079:r_83ec59afbecdec14": {
      "text": "Then take care of my heart too!",
      "status": "imported"
    },
    "voice_079:r_e20bfd42ad95a3c9": {
      "text": "Sazanka, I'm ready!",
      "status": "imported"
    },
    "voice_079:r_0f58a8822381e57f": {
      "text": "Thanks, Mikono!",
      "status": "imported"
    },
    "voice_079:r_6dbcc507fb61b51d": {
      "text": "Can you do this, Sazanka?",
      "status": "imported"
    },
    "voice_079:r_b42ab697149a7c8a": {
      "text": "Of course, Cayenne!",
      "status": "imported"
    },
    "voice_079:r_4de4fcf3b440baf4": {
      "text": "Well, just do your best.",
      "status": "imported"
    },
    "voice_079:r_0121a166c715cdff": {
      "text": "Hey!\\nWhy no enthusiasm for me?!",
      "status": "imported"
    },
    "voice_079:r_30fad37a42bd3ad3": {
      "text": "Don't be fooled by appearances!",
      "status": "imported"
    },
    "voice_079:r_80a0b2a84e05d81a": {
      "text": "A seeming seme may be an uke!",
      "status": "imported"
    },
    "voice_079:r_4a9ac1dff86506d9": {
      "text": "Quit spacing out, you fujoshi!",
      "status": "imported"
    },
    "voice_079:r_bc8538e6af3d2577": {
      "text": "Ahh, this heat is too much...!",
      "status": "imported"
    },
    "voice_079:r_924516c8de2b5342": {
      "text": "Hey, let me take photos later!",
      "status": "imported"
    },
    "voice_079:r_da1174533722333f": {
      "text": "Fine, just watch where you're going!",
      "status": "imported"
    },
    "voice_079:r_fdeb8162976e72c1": {
      "text": "Oh! So you're a coy uke!",
      "status": "imported"
    },
    "voice_079:r_0fadb5c26df92b42": {
      "text": "This time, I'll finish you!",
      "status": "imported"
    },
    "voice_079:r_6b15af9a0057cdc8": {
      "text": "You're after Mikono again?!",
      "status": "imported"
    },
    "voice_079:r_15b4a90140e8a33a": {
      "text": "Amata's soul, yet totally different!",
      "status": "imported"
    },
    "voice_079:r_af884a6b11dff121": {
      "text": "No more abducting people!",
      "status": "imported"
    },
    "voice_079:r_ac6fe7838e95647b": {
      "text": "You may have reasons, but...!",
      "status": "imported"
    },
    "voice_079:r_77ca87eacd17ad52": {
      "text": "At last,\\nAltea's supreme leader!",
      "status": "imported"
    },
    "voice_079:r_bf3244994760e535": {
      "text": "Hand over women? So selfish!",
      "status": "imported"
    },
    "voice_079:r_aabfb21c9d069ce7": {
      "text": "Just having someone to love is best!",
      "status": "imported"
    },
    "voice_079:r_02479dc8fe989560": {
      "text": "Those pretty-boy types\\nare so dated!",
      "status": "imported"
    },
    "voice_079:r_a2df00f91a9b0a9e": {
      "text": "Definitely an uke! An uke!",
      "status": "imported"
    },
    "voice_079:r_665f01666859013b": {
      "text": "Maybe a seme disguised as an uke...?",
      "status": "imported"
    },
    "voice_079:r_a571eec59b258d11": {
      "text": "A seme! No doubt about it!",
      "status": "imported"
    },
    "voice_079:r_6ff1323b355593e0": {
      "text": "Too ambiguous to ship!",
      "status": "imported"
    },
    "voice_079:r_1b9b2aab5cb104da": {
      "text": "Oh no, gorgeous...!",
      "status": "imported"
    },
    "voice_079:r_342044c706a2340f": {
      "text": "No wonder they seemed so brooding!",
      "status": "imported"
    },
    "voice_079:r_cf41e8828a90cbdb": {
      "text": "Oh no, get it together, MIX!",
      "status": "imported"
    },
    "voice_079:r_719e897304ec42d4": {
      "text": "Can I avoid hitting the cockpit...?",
      "status": "imported"
    },
    "voice_079:r_d5e0a2317c40d322": {
      "text": "An alien? Oh no, I need a photo!",
      "status": "imported"
    },
    "voice_079:r_ec2ea17765052401": {
      "text": "A psychic?\\nThey'll take mind photos!",
      "status": "imported"
    },
    "voice_079:r_f2d4255f1c2f7542": {
      "text": "Tiny targets are so hard to hit!",
      "status": "imported"
    },
    "voice_079:r_5d08ad19e2da125b": {
      "text": "I'm bad with speedy opponents!",
      "status": "imported"
    },
    "voice_079:r_a7246b52782a877e": {
      "text": "Whoa! Now that's intimidating!",
      "status": "imported"
    },
    "voice_079:r_dc8701f6bcb9904f": {
      "text": "No way, I have to fight a Gundam?!",
      "status": "imported"
    },
    "voice_079:r_d6bdd730f24f66eb": {
      "text": "This is no time to wage war...!",
      "status": "imported"
    },
    "voice_079:r_9e6cf4f389dae55c": {
      "text": "Why do you keep targeting people?!",
      "status": "imported"
    },
    "voice_079:r_7432ef43ed3471dc": {
      "text": "Space Monsters, humanity's enemy...!",
      "status": "imported"
    },
    "voice_079:r_065443f6ddfcf0d7": {
      "text": "I hate this kind of thing!",
      "status": "imported"
    },
    "voice_079:r_47d52a2839c71715": {
      "text": "I won't let you annihilate us!",
      "status": "imported"
    },
    "voice_079:r_eb7ae28b53dc033c": {
      "text": "Even a mighty foe won't scare me!",
      "status": "imported"
    },
    "voice_079:r_857c4a52ce8df0fd": {
      "text": "You won't get to do as you please!",
      "status": "imported"
    },
    "voice_079:r_55417493fce1d347": {
      "text": "No way,\\nI'm on the final stage...!",
      "status": "imported"
    },
    "voice_079:r_8fdf5910927c9591": {
      "text": "My final, greatest\\nmoment to shine!",
      "status": "imported"
    },
    "voice_079:r_7d724dbcc4451e10": {
      "text": "I trust us,\\nthe future, every love!",
      "status": "imported"
    },
    "voice_079:r_93e25418a203cb8f": {
      "text": "I hate anyone who uses dirty tricks!",
      "status": "imported"
    },
    "voice_079:r_adeb0a29274d3d9b": {
      "text": "Too bad!\\nHumans aren't that stupid!",
      "status": "imported"
    },
    "voice_079:r_24cf161287ef9d5c": {
      "text": "I just have to do it like Shrade!",
      "status": "imported"
    },
    "voice_079:r_8f60f6fc86db3107": {
      "text": "Now, let's finish this with style!",
      "status": "imported"
    },
    "voice_079:r_b1de76a75a253c13": {
      "text": "Come on, let's fight!",
      "status": "imported"
    },
    "voice_079:r_128c35bf3e0e394c": {
      "text": "There, cut in two!",
      "status": "imported"
    },
    "voice_079:r_5213c17e13b23de0": {
      "text": "There, got you!",
      "status": "imported"
    },
    "voice_079:r_38fdff9483e9245c": {
      "text": "If they hit you, hit back!",
      "status": "imported"
    },
    "voice_079:r_620fedec67706d7d": {
      "text": "I won't just take this lying down!",
      "status": "imported"
    },
    "voice_079:r_9680dcd0fddcfcc7": {
      "text": "Seme-uke swap! No, offense-defense!",
      "status": "imported"
    },
    "voice_079:r_2a00f1044ad5cbaa": {
      "text": "I've got quite a sharp eye!",
      "status": "imported"
    },
    "voice_079:r_3dbeead1bd3164ef": {
      "text": "You're the one who attacked first!",
      "status": "imported"
    },
    "voice_079:r_46e86d000250e137": {
      "text": "I can't let myself fall behind!",
      "status": "imported"
    },
    "voice_079:r_ac341e7976e88f0b": {
      "text": "Nobody called, but I'm jumping in!",
      "status": "imported"
    },
    "voice_079:r_cdbd128a5b4127cc": {
      "text": "Watch out! Get back!",
      "status": "imported"
    },
    "voice_079:r_cfccaa1fbeda124c": {
      "text": "I can't ignore a friend in danger!",
      "status": "imported"
    },
    "voice_079:r_b1f8ec192b9c083a": {
      "text": "Huh? Huh? What's gotten into you?!",
      "status": "imported"
    },
    "voice_079:r_a007f9ab9cf048b3": {
      "text": "What? You can't counterattack?!",
      "status": "imported"
    },
    "voice_079:r_ddafde4b065ced49": {
      "text": "No way! I can't do anything...!",
      "status": "imported"
    },
    "voice_079:r_de1213040856c089": {
      "text": "No!\\nMy Spirit Level is plummeting!",
      "status": "imported"
    },
    "voice_079:r_3304412ac41f47a6": {
      "text": "Huh? Where did you go?!",
      "status": "imported"
    },
    "voice_079:r_0c0775e051211840": {
      "text": "Looks like my weapons won't work!",
      "status": "imported"
    },
    "voice_079:r_a2afffe1c396f0b3": {
      "text": "I can do this too! Sparkle!",
      "status": "imported"
    },
    "voice_079:r_13c25fbdfddc8a24": {
      "text": "Yes! I'm really standing out!",
      "status": "imported"
    },
    "voice_079:r_42ba1ecb310b4bd7": {
      "text": "I trained in secret for this day!",
      "status": "imported"
    },
    "voice_079:r_d692f1d420460a47": {
      "text": "That's never going to hit me!",
      "status": "imported"
    },
    "voice_079:r_a5643cec86b18bd2": {
      "text": "Ahh! The spotlight feels so good!",
      "status": "imported"
    },
    "voice_079:r_68f2dfab20a4a30e": {
      "text": "I'm an Element! This much is easy!",
      "status": "imported"
    },
    "voice_079:r_9cedad8237480563": {
      "text": "I'm like a beast tamer right now!",
      "status": "imported"
    },
    "voice_079:r_a03fabecba1508ca": {
      "text": "You impressed me, Sazanka!",
      "status": "imported"
    },
    "voice_079:r_5391b24a71eb10ae": {
      "text": "What?\\nWas that a subtle insult?!",
      "status": "imported"
    },
    "voice_079:r_a554ceef5c87b972": {
      "text": "Sazanka, that was amazing...!",
      "status": "imported"
    },
    "voice_079:r_546c3d5937fbb7ee": {
      "text": "Really? Oh no, I'm blushing!",
      "status": "imported"
    },
    "voice_079:r_1568ff6298b12b96": {
      "text": "Studying Cayenne's moves\\npaid off!",
      "status": "imported"
    },
    "voice_079:r_2c9d94ba13c5fc50": {
      "text": "You were watching me...?",
      "status": "imported"
    },
    "voice_079:r_a77f4913375098d2": {
      "text": "No need to dig a hole after all!",
      "status": "imported"
    },
    "voice_079:r_428c2116ac3071b1": {
      "text": "Well, obviously!",
      "status": "imported"
    },
    "voice_079:r_84c116267b79f540": {
      "text": "You've improved, Sazanka.",
      "status": "imported"
    },
    "voice_079:r_dad38ee29af2df3a": {
      "text": "See? Heh heh heh!",
      "status": "imported"
    },
    "voice_079:r_3d32e86f8dc80909": {
      "text": "Not bad, despite how you look.",
      "status": "imported"
    },
    "voice_079:r_70451ffbabe2f876": {
      "text": "Oh my, was that... a compliment?",
      "status": "imported"
    },
    "voice_079:r_69dfa1659715e2fa": {
      "text": "Jin's analysis is so dependable!",
      "status": "imported"
    },
    "voice_079:r_d996fd6d4ef5b329": {
      "text": "...Thanks.",
      "status": "imported"
    },
    "voice_079:r_546de3fb6db156ea": {
      "text": "Heh heh heh, that's useless!",
      "status": "imported"
    },
    "voice_079:r_ca85f87cee5e31f7": {
      "text": "That won't work on me!",
      "status": "imported"
    },
    "voice_079:r_d89011fe3e5d082a": {
      "text": "That barrier really saved me!",
      "status": "imported"
    },
    "voice_079:r_3c5b0c2ac812d5de": {
      "text": "Finishing move! Shield Defense!",
      "status": "imported"
    },
    "voice_079:r_5b9e8897190892eb": {
      "text": "Whoa! That hit my shield!",
      "status": "imported"
    },
    "voice_079:r_7bea3023abbf8a94": {
      "text": "Eek! Just kidding!",
      "status": "imported"
    },
    "voice_079:r_dd01a4c0d1b36a8d": {
      "text": "I thought I dodged that...",
      "status": "imported"
    },
    "voice_079:r_20920ad2eb3542db": {
      "text": "Could they be reading my moves?",
      "status": "imported"
    },
    "voice_079:r_0ab7914877fd48ed": {
      "text": "Oops... Is it time to switch Heads?",
      "status": "imported"
    },
    "voice_079:r_cb846feec748c2e3": {
      "text": "I'll do better next time! Next time!",
      "status": "imported"
    },
    "voice_079:r_c958860b0676b1f5": {
      "text": "A maiden in battle fears no wound!",
      "status": "imported"
    },
    "voice_079:r_5e2669b82ef75ce3": {
      "text": "That hit you, Sazanka!",
      "status": "imported"
    },
    "voice_079:r_7847e0ed7dc9282d": {
      "text": "Just a scratch! Amata, so picky!",
      "status": "imported"
    },
    "voice_079:r_e42b52c7a987b906": {
      "text": "Aaah!",
      "status": "imported"
    },
    "voice_079:r_6825fd1ff907bd22": {
      "text": "Mikono, what a cute little scream!",
      "status": "imported"
    },
    "voice_079:r_607f666f1563bc0d": {
      "text": "Couldn't you have dodged that one?",
      "status": "imported"
    },
    "voice_079:r_97b7431eeb81e6b6": {
      "text": "(Can't say\\nI stared at Cayenne!)",
      "status": "imported"
    },
    "voice_079:r_132f605d02975e71": {
      "text": "Hey, don't get hit by lame attacks!",
      "status": "imported"
    },
    "voice_079:r_9b9726b1872759d6": {
      "text": "Oh, please!\\nYour hat is even lamer!",
      "status": "imported"
    },
    "voice_079:r_1252db29683fefe0": {
      "text": "Even small hits add up big!",
      "status": "imported"
    },
    "voice_079:r_ad3d538f1e909184": {
      "text": "But they haven't added up yet!",
      "status": "imported"
    },
    "voice_079:r_8c61c59a1c0aebbf": {
      "text": "If it hits,\\nmake it a strong one!",
      "status": "imported"
    },
    "voice_079:r_aba6a7662129d8ce": {
      "text": "You're talking total nonsense!",
      "status": "imported"
    },
    "voice_079:r_b84afafb8a33ec60": {
      "text": "You got hit by that...? Amazing.",
      "status": "imported"
    },
    "voice_079:r_c8c59db85bf875e6": {
      "text": "Is that praise or an insult?!",
      "status": "imported"
    },
    "voice_079:r_391aa56435d9dd6e": {
      "text": "Kyaaaah!",
      "status": "imported"
    },
    "voice_079:r_7c796ba53bd7ea03": {
      "text": "Huh? Whaaaat...?!",
      "status": "imported"
    },
    "voice_079:r_fa944da4b6519006": {
      "text": "D-Did I just hear a huge crash...?!",
      "status": "imported"
    },
    "voice_079:r_95d047bcc17fccc6": {
      "text": "Um, right now...\\nWhat do I do?!",
      "status": "imported"
    },
    "voice_079:r_640327a12a559b31": {
      "text": "So persistent...!\\nWait, a stalker?!",
      "status": "imported"
    },
    "voice_079:r_bdd38c584fa313d0": {
      "text": "Donar is going to punish me!",
      "status": "imported"
    },
    "voice_079:r_3fd86c1027f317c8": {
      "text": "No way! A stray dog bit me!",
      "status": "imported"
    },
    "voice_079:r_d0372a183d2007ad": {
      "text": "Any more is dangerous, Sazanka!",
      "status": "imported"
    },
    "voice_079:r_217aa5e1d545b44d": {
      "text": "I know!\\nDon't get hit again, right?!",
      "status": "imported"
    },
    "voice_079:r_381992c5d8224937": {
      "text": "Were you looking away, Sazanka?!",
      "status": "imported"
    },
    "voice_079:r_f1e7ed9e5874aba5": {
      "text": "Sorry! I was picturing a hot guy...",
      "status": "imported"
    },
    "voice_079:r_fc25e66a86fc2c85": {
      "text": "Hey...",
      "status": "imported"
    },
    "voice_079:r_5aeeb4917340c42d": {
      "text": "Ahh,\\nCayenne's gaze pierces me!",
      "status": "imported"
    },
    "voice_079:r_b765659981b6516d": {
      "text": "Oh no,\\nI shamed myself in public...",
      "status": "imported"
    },
    "voice_079:r_0c427458bc00eb95": {
      "text": "Want to crawl into a hole? I'll dig.",
      "status": "imported"
    },
    "voice_079:r_774a9ab4d8fd5351": {
      "text": "Come on!\\nMalloy didn't direct me!",
      "status": "imported"
    },
    "voice_079:r_d3f01de714c015bd": {
      "text": "How is it my fault?!",
      "status": "imported"
    },
    "voice_079:r_7d2617c809fead70": {
      "text": "How'd you get hit by that?!",
      "status": "imported"
    },
    "voice_079:r_ceb935ccbf830724": {
      "text": "Obviously,\\nI'm terrible at this!",
      "status": "imported"
    },
    "voice_079:r_862ef7385bf2abd4": {
      "text": "My analysis wasn't fast enough...",
      "status": "imported"
    },
    "voice_079:r_001cbec4d9a4283f": {
      "text": "Sorry, your Head is unreliable...",
      "status": "imported"
    },
    "voice_079:r_8ad40afecd02b41e": {
      "text": "Strong for Mikono's stalker!",
      "status": "imported"
    },
    "voice_079:r_1f65a7af190e4674": {
      "text": "W-What is this?! Aaaaaah!",
      "status": "imported"
    },
    "voice_079:r_40c5a9358ed5bf29": {
      "text": "I'm about to rot away completely...!",
      "status": "imported"
    },
    "voice_079:r_f2e18dfdfe0c89ea": {
      "text": "My heart throbs!\\nA first for me...!",
      "status": "imported"
    },
    "voice_079:r_cf7dbf49e96a5755": {
      "text": "No! Somebody help me, hurry!",
      "status": "imported"
    },
    "voice_079:r_fa96676cc65bb509": {
      "text": "No! Aquarion can't hold on!",
      "status": "imported"
    },
    "voice_079:r_4e37f92e7d2fc62e": {
      "text": "They're fighting!\\nI can't lose...!",
      "status": "imported"
    },
    "voice_079:r_66ab4cfe1557909d": {
      "text": "I'm done! Amata, do something!",
      "status": "imported"
    },
    "voice_079:r_0bad405ee6ca63ba": {
      "text": "Keep fighting to the end, Sazanka!",
      "status": "imported"
    },
    "voice_079:r_2072eaf71a260ae7": {
      "text": "Sazanka,\\ndon't worry about me!",
      "status": "imported"
    },
    "voice_079:r_6c13bbfd27a7799e": {
      "text": "Mikono... Sorry I pushed you...!",
      "status": "imported"
    },
    "voice_079:r_06f88dcbd3c9e738": {
      "text": "I'm entrusting my life to you!",
      "status": "imported"
    },
    "voice_079:r_b28faf9f71bc3598": {
      "text": "Whaaat?!\\nY-Your precious life...?!",
      "status": "imported"
    },
    "voice_079:r_8a29278549f8e07a": {
      "text": "I don't want to die here!",
      "status": "imported"
    },
    "voice_079:r_7e6c573c26177f98": {
      "text": "Hey, don't say such ominous things!",
      "status": "imported"
    },
    "voice_079:r_45abf84f7757d6eb": {
      "text": "They read your moves! Do something!",
      "status": "imported"
    },
    "voice_079:r_edd7a13ab8f06a14": {
      "text": "If I could, I'd have done it!",
      "status": "imported"
    },
    "voice_079:r_8165e5b41f0124c4": {
      "text": "What do we do? We're in trouble!",
      "status": "imported"
    },
    "voice_079:r_4e05581b7432cce8": {
      "text": "Now I just have to go for it!",
      "status": "imported"
    },
    "voice_079:r_a60b107ea3c36a86": {
      "text": "Should we run?",
      "status": "imported"
    },
    "voice_079:r_e33693e5ba4665b0": {
      "text": "No, I won't run!\\nI'm an Element too!",
      "status": "imported"
    },
    "voice_079:r_72a21a1a489af001": {
      "text": "That was my big moment, and now...!",
      "status": "imported"
    },
    "voice_079:r_eb643f8bf737a0ca": {
      "text": "Everyone, I'm sorry...!",
      "status": "imported"
    },
    "voice_079:r_0a3fccb71ec6cf2a": {
      "text": "Hey! Great photos! Want any?",
      "status": "imported"
    },
    "voice_079:r_9b63cf1f3e0207ef": {
      "text": "Mikono/Zessica/MIX/Yunoha/Crea/Suomi",
      "status": "imported"
    },
    "voice_079:r_8356f4e3dcdff938": {
      "text": "Or maybe you'd rather have... me?",
      "status": "imported"
    },
    "voice_079:r_1d6d784036ae0bd7": {
      "text": "Kidding. I wish someone saw only me!",
      "status": "imported"
    },
    "voice_079:r_625664af02183c17": {
      "text": "Well, see you later!",
      "status": "imported"
    },
    "voice_079:r_3701cba361f80ea5": {
      "text": "Shrade-Cayenne... dizzy, nosebleed!",
      "status": "imported"
    },
    "voice_079:r_63f429c5c68c0863": {
      "text": "W-What are you doing, Malloy?",
      "status": "imported"
    },
    "voice_079:r_38e4a434c91d8ef0": {
      "text": "Then I'll corrode the player's will!",
      "status": "imported"
    },
    "voice_079:r_98ed411352a3a6ac": {
      "text": "Heh heh heh...! Heh heh heh heh heh",
      "status": "imported"
    },
    "voice_079:r_4824bea6bab3af67": {
      "text": "Heh heh heh! Heh heh heh heh heh!",
      "status": "imported"
    },
    "voice_079:r_05ea490d2f522520": {
      "text": "My fastest toccata,\\nI'll pluck!",
      "status": "imported"
    },
    "voice_079:r_f5658c702d91db7a": {
      "text": "Tonight's moon plays...!",
      "status": "imported"
    },
    "voice_079:r_686df329b50f195b": {
      "text": "Rhapsody!",
      "status": "imported"
    },
    "voice_079:r_25f0ab0fa3cf690c": {
      "text": "One bewitched by the fair moon...!",
      "status": "imported"
    },
    "voice_079:r_b708a1d959013dbf": {
      "text": "Lose yourself in my melody...!",
      "status": "imported"
    },
    "voice_079:r_59fca03e929366c1": {
      "text": "Rhapsody!",
      "status": "imported"
    },
    "voice_079:r_0d65eb631dcb7514": {
      "text": "Amata, Zessica...!\\nLend me strength!",
      "status": "imported"
    },
    "voice_079:r_d03018a31e23f1e9": {
      "text": "Got it!",
      "status": "imported"
    },
    "voice_079:r_279da5f732aa8847": {
      "text": "Let's do this, Shrade!",
      "status": "imported"
    },
    "voice_079:r_97f82e3cb6f70110": {
      "text": "Let's go! Soul Arpeggio!",
      "status": "imported"
    },
    "voice_079:r_c5611d8dd6def96b": {
      "text": "Sky moon vibrato,\\nwater moon vivace",
      "status": "imported"
    },
    "voice_079:r_6f12cc8ed2732eb5": {
      "text": "Human moon sings life\\nagitato!",
      "status": "imported"
    },
    "voice_079:r_7abfc55f8fb62ba7": {
      "text": "Moon Requiem!",
      "status": "imported"
    },
    "voice_079:r_99e7a66c650b5892": {
      "text": "My life...! I play with the moon!",
      "status": "imported"
    },
    "voice_079:r_bf953d64c3c7d9b7": {
      "text": "Haaaaah!",
      "status": "imported"
    },
    "voice_079:r_e09b933e3e706779": {
      "text": "Soul and life ring in moonlight...!",
      "status": "imported"
    },
    "voice_079:r_66236eb99b676e5b": {
      "text": "Resound, Moon Requiem!",
      "status": "imported"
    },
    "voice_079:r_9639a2dbcd2f58ed": {
      "text": "This is the finale!",
      "status": "imported"
    },
    "voice_079:r_aeea0893acb93d35": {
      "text": "Oh... My bare skin is sensitive...!",
      "status": "imported"
    },
    "voice_079:r_b31568654e53487b": {
      "text": "Everything in my whole body...!",
      "status": "imported"
    },
    "voice_079:r_2502132569141ea3": {
      "text": "So stimulatingggg!",
      "status": "imported"
    },
    "voice_079:r_1ff312798a52c8eb": {
      "text": "Uoooooh!",
      "status": "imported"
    },
    "voice_079:r_fa07d90fca62f593": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_079:r_a25bf2676ecf9d83": {
      "text": "No Guard!",
      "status": "imported"
    },
    "voice_079:r_237a0288b42dce20": {
      "text": "Attaaack!!",
      "status": "imported"
    },
    "voice_079:r_0556e8a22779ea8e": {
      "text": "Embarrassing, but it feels so good!",
      "status": "imported"
    },
    "voice_079:r_09d377101a48d92a": {
      "text": "My whole body's burning!",
      "status": "imported"
    },
    "voice_079:r_11517cc7b0494dbf": {
      "text": "I-It's embarrassing, but...!",
      "status": "imported"
    },
    "voice_079:r_b5864501463db244": {
      "text": "This somehow feels so good!",
      "status": "imported"
    },
    "voice_079:r_a88939ea84b4474d": {
      "text": "Haaaaah!",
      "status": "imported"
    },
    "voice_079:r_a870d0cf7cc11ec6": {
      "text": "Scorch skin and cleave flesh!",
      "status": "imported"
    },
    "voice_079:r_be661448b85d0009": {
      "text": "We did it, Amata! Mikono!",
      "status": "imported"
    },
    "voice_079:r_958a56c1151cab9e": {
      "text": "S-Shame, and...!",
      "status": "imported"
    },
    "voice_079:r_8b18aa4cc69547df": {
      "text": "A sense of release...!",
      "status": "imported"
    },
    "voice_079:r_3e87f6fc3ea65aef": {
      "text": "In a furious clash!",
      "status": "imported"
    },
    "voice_079:r_207b256d613bb896": {
      "text": "Ahh... My heart won't stop pounding!",
      "status": "imported"
    },
    "voice_079:r_4e63c037d3cb8a3d": {
      "text": "I feel my friend's soul so close...!",
      "status": "imported"
    },
    "voice_079:r_9ca8d188ae805e3a": {
      "text": "Come, fight beside me, Cayenne!",
      "status": "imported"
    },
    "voice_079:r_795ed21f3e28e1f5": {
      "text": "Let's go, my best friend!",
      "status": "imported"
    },
    "voice_079:r_141415c1def5ab2d": {
      "text": "I dedicate this to my friend!",
      "status": "imported"
    },
    "voice_079:r_c894e35becf35a03": {
      "text": "Requiem!!",
      "status": "imported"
    },
    "voice_079:r_79b1abf5fc86483c": {
      "text": "Time to play the ultimate melody...!",
      "status": "imported"
    },
    "voice_079:r_e9a11621911acb19": {
      "text": "Will you play it with me, Cayenne?",
      "status": "imported"
    },
    "voice_079:r_d52bece55796f599": {
      "text": "Of course, my best friend.",
      "status": "imported"
    },
    "voice_079:r_358fe5a50bbee1df": {
      "text": "I'll play it with my friend!",
      "status": "imported"
    },
    "voice_079:r_638834e16724002f": {
      "text": "Requiem!!",
      "status": "imported"
    },
    "voice_079:r_b02fca1590ac1210": {
      "text": "New sound...\\nborn from me, from us!",
      "status": "imported"
    },
    "voice_079:r_f0344d2fbaa9db77": {
      "text": "This is... what Shrade sought!",
      "status": "imported"
    },
    "voice_079:r_3328eef766ff2c2c": {
      "text": "Yes! The ultimate melody!",
      "status": "imported"
    },
    "voice_079:r_23b037cf6ccc695c": {
      "text": "Spada and Gepard's powers, unite!",
      "status": "imported"
    },
    "voice_079:r_883ad1128d340c5e": {
      "text": "Requiem!!",
      "status": "imported"
    },
    "voice_079:r_2a730c9b4df0dca3": {
      "text": "What?! I'm the decoy?!",
      "status": "imported"
    },
    "voice_079:r_1e5842ba5dc3f705": {
      "text": "So I just draw their attention...!",
      "status": "imported"
    },
    "voice_079:r_9747bd61ad23ecd3": {
      "text": "Pardon me, I'm going on ahead!",
      "status": "imported"
    },
    "voice_079:r_6823f8abe05c4727": {
      "text": "Then I'll leave the rest to you!",
      "status": "imported"
    },
    "voice_079:r_b8ccfd8b8ac323ac": {
      "text": "That person is my partner...!",
      "status": "imported"
    },
    "voice_079:r_c885ff2097749991": {
      "text": "One-on-one is easy! I think...?",
      "status": "imported"
    },
    "voice_079:r_a8da7f8d8b705db0": {
      "text": "I can't be the only one to mess up!",
      "status": "imported"
    },
    "voice_079:r_02e1c5e19de5bd22": {
      "text": "I have to show them I can do it!",
      "status": "imported"
    }
  }
}
