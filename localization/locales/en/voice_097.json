{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_097:r_479b340ccc6c572b": {
      "text": "We'll make the first move!",
      "status": "imported"
    },
    "voice_097:r_ca4acbac57a2a35e": {
      "text": "The Ptolemy will take point!",
      "status": "imported"
    },
    "voice_097:r_77949221bf58f862": {
      "text": "Celestial Being's way of war:\\nwatch!",
      "status": "imported"
    },
    "voice_097:r_70b9c4b9f1f37eff": {
      "text": "If my prediction is correct!",
      "status": "imported"
    },
    "voice_097:r_9fcb3754cb1773c7": {
      "text": "All we can do now is fight!",
      "status": "imported"
    },
    "voice_097:r_3559d2fad32c2435": {
      "text": "We'll do what must be done...!",
      "status": "imported"
    },
    "voice_097:r_f7570547e9f80a64": {
      "text": "After Feldt's analysis,\\nbreak out!",
      "status": "imported"
    },
    "voice_097:r_cbab0f4720e1fcf1": {
      "text": "So delicate, yet so forceful.",
      "status": "imported"
    },
    "voice_097:r_0bbe0b4f5364e732": {
      "text": "Enemy at twelve o'clock!",
      "status": "imported"
    },
    "voice_097:r_5dda5198137cb02a": {
      "text": "Right on the money!",
      "status": "imported"
    },
    "voice_097:r_83ec59afbecdec14": {
      "text": "Enemy craft acquired!",
      "status": "imported"
    },
    "voice_097:r_e20bfd42ad95a3c9": {
      "text": "Just as predicted. Strike first!",
      "status": "imported"
    },
    "voice_097:r_0f58a8822381e57f": {
      "text": "No more delays.\\nAttack again!",
      "status": "imported"
    },
    "voice_097:r_6dbcc507fb61b51d": {
      "text": "We'll disrupt their coordination!",
      "status": "imported"
    },
    "voice_097:r_b42ab697149a7c8a": {
      "text": "Enemy's still within Ptolemy range!",
      "status": "imported"
    },
    "voice_097:r_4de4fcf3b440baf4": {
      "text": "Then let's overwhelm them here!",
      "status": "imported"
    },
    "voice_097:r_0121a166c715cdff": {
      "text": "First, sever their command chain!",
      "status": "imported"
    },
    "voice_097:r_30fad37a42bd3ad3": {
      "text": "Roger! Hit the command unit!",
      "status": "imported"
    },
    "voice_097:r_80a0b2a84e05d81a": {
      "text": "Noriega, that unit!",
      "status": "imported"
    },
    "voice_097:r_4a9ac1dff86506d9": {
      "text": "It's the commander! Stay sharp!",
      "status": "imported"
    },
    "voice_097:r_bc8538e6af3d2577": {
      "text": "If we can pin down that big one...",
      "status": "imported"
    },
    "voice_097:r_924516c8de2b5342": {
      "text": "Even odds. Wanna move in?",
      "status": "imported"
    },
    "voice_097:r_da1174533722333f": {
      "text": "Lasse, take us to their mothership!",
      "status": "imported"
    },
    "voice_097:r_fdeb8162976e72c1": {
      "text": "Roger! Course set for their ship!",
      "status": "imported"
    },
    "voice_097:r_0fadb5c26df92b42": {
      "text": "One unit's charging!\\nCrazy fast!",
      "status": "imported"
    },
    "voice_097:r_6b15af9a0057cdc8": {
      "text": "Switch to Plan B2! Intercept!",
      "status": "imported"
    },
    "voice_097:r_15b4a90140e8a33a": {
      "text": "Even a Gundam won't stop us.\\nWe...!",
      "status": "imported"
    },
    "voice_097:r_af884a6b11dff121": {
      "text": "An enemy Gundam is approaching!",
      "status": "imported"
    },
    "voice_097:r_ac6fe7838e95647b": {
      "text": "No change in plan.\\nRespond as set!",
      "status": "imported"
    },
    "voice_097:r_77ca87eacd17ad52": {
      "text": "New leaders seek\\nreconciliation...!",
      "status": "imported"
    },
    "voice_097:r_bf3244994760e535": {
      "text": "Hard-won human peace...\\nIs no toy!",
      "status": "imported"
    },
    "voice_097:r_aabfb21c9d069ce7": {
      "text": "Alien dialogue...\\nCan it happen...?",
      "status": "imported"
    },
    "voice_097:r_02479dc8fe989560": {
      "text": "GN can't link our minds...\\nSo...",
      "status": "imported"
    },
    "voice_097:r_a2df00f91a9b0a9e": {
      "text": "We aren't ready for dialogue...!",
      "status": "imported"
    },
    "voice_097:r_48b60d6c48b9b142": {
      "text": "Sadly,\\nwe must fight...!",
      "status": "imported"
    },
    "voice_097:r_8927e6fb681aa809": {
      "text": "So they're beyond dialogue...!",
      "status": "imported"
    },
    "voice_097:r_665f01666859013b": {
      "text": "Values worlds apart...\\nOnly war...!",
      "status": "imported"
    },
    "voice_097:r_a571eec59b258d11": {
      "text": "Since we can talk, I can't give up.",
      "status": "imported"
    },
    "voice_097:r_ddbe581c5ea9183d": {
      "text": "But\\nwe have to fend off the sparks.",
      "status": "imported"
    },
    "voice_097:r_faae935cca0edc72": {
      "text": "Settle this...!\\nLast mission, go!",
      "status": "imported"
    },
    "voice_097:r_d4430bf362340b32": {
      "text": "This time... we'll all survive!",
      "status": "imported"
    },
    "voice_097:r_6ff1323b355593e0": {
      "text": "Our true final mission,\\nleft to us!",
      "status": "imported"
    },
    "voice_097:r_b7b5625d7cd4282f": {
      "text": "Final objective dead ahead!",
      "status": "imported"
    },
    "voice_097:r_36133ad73a73ef98": {
      "text": "Ptolemy's last battle!\\nLet's go!",
      "status": "imported"
    },
    "voice_097:r_920740a0219c5085": {
      "text": "Lasse, I'm counting on you!",
      "status": "imported"
    },
    "voice_097:r_a8451712c57c1a72": {
      "text": "Yeah! Let's nail 'em with a Missile!",
      "status": "imported"
    },
    "voice_097:r_3633df5b7b8f47fa": {
      "text": "Lasse, follow the plan!",
      "status": "imported"
    },
    "voice_097:r_52dfc56b14b93551": {
      "text": "Here's a Missile gift! Take it!",
      "status": "imported"
    },
    "voice_097:r_1b9b2aab5cb104da": {
      "text": "Lasse!",
      "status": "imported"
    },
    "voice_097:r_342044c706a2340f": {
      "text": "Roger! Missile Salvo!",
      "status": "imported"
    },
    "voice_097:r_cf41e8828a90cbdb": {
      "text": "GN Missile, full salvo!",
      "status": "imported"
    },
    "voice_097:r_719e897304ec42d4": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_097:r_d5e0a2317c40d322": {
      "text": "Enemy craft are closing in!",
      "status": "imported"
    },
    "voice_097:r_ec2ea17765052401": {
      "text": "Ptolemy, commence bombardment!",
      "status": "imported"
    },
    "voice_097:r_f2d4255f1c2f7542": {
      "text": "Roger! Commencing bombardment!",
      "status": "imported"
    },
    "voice_097:r_5d08ad19e2da125b": {
      "text": "Target is in GN Cannon range!",
      "status": "imported"
    },
    "voice_097:r_a7246b52782a877e": {
      "text": "Lasse!",
      "status": "imported"
    },
    "voice_097:r_dc8701f6bcb9904f": {
      "text": "Yeah! Let's blast 'em sky-high!",
      "status": "imported"
    },
    "voice_097:r_d6bdd730f24f66eb": {
      "text": "GN Cannon is ready anytime!",
      "status": "imported"
    },
    "voice_097:r_41997412868c48c4": {
      "text": "Give me the signal!",
      "status": "imported"
    },
    "voice_097:r_9e6cf4f389dae55c": {
      "text": "GN Cannon... Fire!",
      "status": "imported"
    },
    "voice_097:r_a03fabecba1508ca": {
      "text": "Now's our chance to strike!",
      "status": "imported"
    },
    "voice_097:r_5391b24a71eb10ae": {
      "text": "We won't let them sink us quietly!",
      "status": "imported"
    },
    "voice_097:r_a554ceef5c87b972": {
      "text": "Think you caught us off guard...!",
      "status": "imported"
    },
    "voice_097:r_546c3d5937fbb7ee": {
      "text": "The prey took the bait!",
      "status": "imported"
    },
    "voice_097:r_1568ff6298b12b96": {
      "text": "Let's give 'em the royal welcome!",
      "status": "imported"
    },
    "voice_097:r_2c9d94ba13c5fc50": {
      "text": "If they escape, we'll regret it...!",
      "status": "imported"
    },
    "voice_097:r_a77f4913375098d2": {
      "text": "Now's the time to finish this!",
      "status": "imported"
    },
    "voice_097:r_428c2116ac3071b1": {
      "text": "The enemy is withdrawing!",
      "status": "imported"
    },
    "voice_097:r_84c116267b79f540": {
      "text": "Don't let them get away!",
      "status": "imported"
    },
    "voice_097:r_dad38ee29af2df3a": {
      "text": "Tracking the enemy perfectly!",
      "status": "imported"
    },
    "voice_097:r_3d32e86f8dc80909": {
      "text": "Commence counterattack!",
      "status": "imported"
    },
    "voice_097:r_70451ffbabe2f876": {
      "text": "Enemy still within our range!",
      "status": "imported"
    },
    "voice_097:r_d996fd6d4ef5b329": {
      "text": "We'll handle the pursuit!",
      "status": "imported"
    },
    "voice_097:r_8ab47a28f99ef565": {
      "text": "It's time. Begin the second wave!",
      "status": "imported"
    },
    "voice_097:r_546de3fb6db156ea": {
      "text": "Move the Ptolemy forward!",
      "status": "imported"
    },
    "voice_097:r_ca85f87cee5e31f7": {
      "text": "You got it!",
      "status": "imported"
    },
    "voice_097:r_9072ea7bc71df136": {
      "text": "Don't waste the opening they made!",
      "status": "imported"
    },
    "voice_097:r_04e815a8d425827d": {
      "text": "Roger that!",
      "status": "imported"
    },
    "voice_097:r_d89011fe3e5d082a": {
      "text": "We'll follow the 00's attack!",
      "status": "imported"
    },
    "voice_097:r_3c5b0c2ac812d5de": {
      "text": "Setsuna can't bear this alone!",
      "status": "imported"
    },
    "voice_097:r_5b9e8897190892eb": {
      "text": "While they're dealing with Lockon!",
      "status": "imported"
    },
    "voice_097:r_7bea3023abbf8a94": {
      "text": "Mind-reflex fusion... Impressive!",
      "status": "imported"
    },
    "voice_097:r_dd01a4c0d1b36a8d": {
      "text": "Tieria's attack has them reeling!",
      "status": "imported"
    },
    "voice_097:r_20920ad2eb3542db": {
      "text": "The Ptolemy will aid our allies!",
      "status": "imported"
    },
    "voice_097:r_0ab7914877fd48ed": {
      "text": "My bad feeling was right!",
      "status": "imported"
    },
    "voice_097:r_cb846feec748c2e3": {
      "text": "We're going to assist our allies!",
      "status": "imported"
    },
    "voice_097:r_c958860b0676b1f5": {
      "text": "I'm cutting in!",
      "status": "imported"
    },
    "voice_097:r_5e2669b82ef75ce3": {
      "text": "All hands, brace for impact!",
      "status": "imported"
    },
    "voice_097:r_7847e0ed7dc9282d": {
      "text": "A stopgap machine!\\nDon't push it!",
      "status": "imported"
    },
    "voice_097:r_e42b52c7a987b906": {
      "text": "Setsuna and that unit are our hope!",
      "status": "imported"
    },
    "voice_097:r_6825fd1ff907bd22": {
      "text": "Haro can't keep up?!\\nThen...!",
      "status": "imported"
    },
    "voice_097:r_607f666f1563bc0d": {
      "text": "Harute, fall back behind Ptolemy!",
      "status": "imported"
    },
    "voice_097:r_97b7431eeb81e6b6": {
      "text": "Tieria!\\nWhat a reckless move...!",
      "status": "imported"
    },
    "voice_097:r_132f605d02975e71": {
      "text": "An allied unit is being targeted!",
      "status": "imported"
    },
    "voice_097:r_9b9726b1872759d6": {
      "text": "Move the Ptolemy forward!",
      "status": "imported"
    },
    "voice_097:r_1252db29683fefe0": {
      "text": "Setsuna!",
      "status": "imported"
    },
    "voice_097:r_ad3d538f1e909184": {
      "text": "Come on, make it in time!",
      "status": "imported"
    },
    "voice_097:r_8c61c59a1c0aebbf": {
      "text": "Erde, sorry to keep you waiting!",
      "status": "imported"
    },
    "voice_097:r_aba6a7662129d8ce": {
      "text": "Erde, Raphael is falling back!",
      "status": "imported"
    },
    "voice_097:r_b84afafb8a33ec60": {
      "text": "We're all out of options...!",
      "status": "imported"
    },
    "voice_097:r_c8c59db85bf875e6": {
      "text": "Calm down, Mileina. I have a plan!",
      "status": "imported"
    },
    "voice_097:r_391aa56435d9dd6e": {
      "text": "We should pull back for now...",
      "status": "imported"
    },
    "voice_097:r_7c796ba53bd7ea03": {
      "text": "Yeah.\\nWe'd just be a target...!",
      "status": "imported"
    },
    "voice_097:r_fa944da4b6519006": {
      "text": "A long battle will be tough...!",
      "status": "imported"
    },
    "voice_097:r_95d047bcc17fccc6": {
      "text": "The gap in our range?! Nicely done!",
      "status": "imported"
    },
    "voice_097:r_640327a12a559b31": {
      "text": "That strategy won't work!",
      "status": "imported"
    },
    "voice_097:r_bdd38c584fa313d0": {
      "text": "That's Lasse for you!",
      "status": "imported"
    },
    "voice_097:r_3fd86c1027f317c8": {
      "text": "We're lucky, aren't we?",
      "status": "imported"
    },
    "voice_097:r_d0372a183d2007ad": {
      "text": "I outread you.",
      "status": "imported"
    },
    "voice_097:r_217aa5e1d545b44d": {
      "text": "Somehow.",
      "status": "imported"
    },
    "voice_097:r_381992c5d8224937": {
      "text": "No damage to any system.",
      "status": "imported"
    },
    "voice_097:r_f1e7ed9e5874aba5": {
      "text": "That was too close...!",
      "status": "imported"
    },
    "voice_097:r_fc25e66a86fc2c85": {
      "text": "Just as I read it.",
      "status": "imported"
    },
    "voice_097:r_5aeeb4917340c42d": {
      "text": "Amazing as ever, Noriega!",
      "status": "imported"
    },
    "voice_097:r_b765659981b6516d": {
      "text": "We made it somehow...!",
      "status": "imported"
    },
    "voice_097:r_774a9ab4d8fd5351": {
      "text": "Deploy the GN Field!",
      "status": "imported"
    },
    "voice_097:r_d3f01de714c015bd": {
      "text": "The GN Field is holding.",
      "status": "imported"
    },
    "voice_097:r_7d2617c809fead70": {
      "text": "Thanks to Ian.",
      "status": "imported"
    },
    "voice_097:r_ceb935ccbf830724": {
      "text": "Dad's amazing!",
      "status": "imported"
    },
    "voice_097:r_862ef7385bf2abd4": {
      "text": "They got one over on us. But...!",
      "status": "imported"
    },
    "voice_097:r_001cbec4d9a4283f": {
      "text": "This is nothing to worry about!",
      "status": "imported"
    },
    "voice_097:r_8ad40afecd02b41e": {
      "text": "Sorry, they got us!",
      "status": "imported"
    },
    "voice_097:r_26e5efec03c03d78": {
      "text": "We're lucky that's all it did.",
      "status": "imported"
    },
    "voice_097:r_4ad81e88c7557a8b": {
      "text": "Couldn't quite dodge that one.",
      "status": "imported"
    },
    "voice_097:r_1f65a7af190e4674": {
      "text": "No use crying over a hit!",
      "status": "imported"
    },
    "voice_097:r_40c5a9358ed5bf29": {
      "text": "Damage is minor. Navigation normal.",
      "status": "imported"
    },
    "voice_097:r_f2e18dfdfe0c89ea": {
      "text": "Were they trying to pin us down?",
      "status": "imported"
    },
    "voice_097:r_cf7dbf49e96a5755": {
      "text": "Damage is minimal.",
      "status": "imported"
    },
    "voice_097:r_fa96676cc65bb509": {
      "text": "We're good.\\nAll units, next phase!",
      "status": "imported"
    },
    "voice_097:r_4e37f92e7d2fc62e": {
      "text": "Ptolemy's still going strong!",
      "status": "imported"
    },
    "voice_097:r_66ab4cfe1557909d": {
      "text": "Stay focused, Mileina.",
      "status": "imported"
    },
    "voice_097:r_0bad405ee6ca63ba": {
      "text": "They broke through the GN Field!",
      "status": "imported"
    },
    "voice_097:r_2072eaf71a260ae7": {
      "text": "So far, as planned... Now what?",
      "status": "imported"
    },
    "voice_097:r_6c13bbfd27a7799e": {
      "text": "They read our evasion...\\nNot bad.",
      "status": "imported"
    },
    "voice_097:r_06f88dcbd3c9e738": {
      "text": "Not yet. Draw them in closer!",
      "status": "imported"
    },
    "voice_097:r_b28faf9f71bc3598": {
      "text": "Use the debris as a shield! Retreat!",
      "status": "imported"
    },
    "voice_097:r_8a29278549f8e07a": {
      "text": "They sure know how to hit us...!",
      "status": "imported"
    },
    "voice_097:r_7e6c573c26177f98": {
      "text": "Even so, we can't retreat!",
      "status": "imported"
    },
    "voice_097:r_45abf84f7757d6eb": {
      "text": "That punk's running wild!",
      "status": "imported"
    },
    "voice_097:r_edd7a13ab8f06a14": {
      "text": "We have to endure this...!",
      "status": "imported"
    },
    "voice_097:r_8165e5b41f0124c4": {
      "text": "We must keep their home safe...!",
      "status": "imported"
    },
    "voice_097:r_4e05581b7432cce8": {
      "text": "Feldt...",
      "status": "imported"
    },
    "voice_097:r_a60b107ea3c36a86": {
      "text": "First particle output unit hit!",
      "status": "imported"
    },
    "voice_097:r_e33693e5ba4665b0": {
      "text": "Send all particles to output two!",
      "status": "imported"
    },
    "voice_097:r_72a21a1a489af001": {
      "text": "Ship damage is spreading!",
      "status": "imported"
    },
    "voice_097:r_eb643f8bf737a0ca": {
      "text": "Mission can continue.\\nMove on!",
      "status": "imported"
    },
    "voice_097:r_0a3fccb71ec6cf2a": {
      "text": "My read was wrong...?!",
      "status": "imported"
    },
    "voice_097:r_9b63cf1f3e0207ef": {
      "text": "Don't sweat it, Noriega!",
      "status": "imported"
    },
    "voice_097:r_8356f4e3dcdff938": {
      "text": "Fall to Y32!\\nJam GN, then regroup!",
      "status": "imported"
    },
    "voice_097:r_1d6d784036ae0bd7": {
      "text": "We have to weather this somehow...!",
      "status": "imported"
    },
    "voice_097:r_625664af02183c17": {
      "text": "We've truly got nowhere left to go!",
      "status": "imported"
    },
    "voice_097:r_3701cba361f80ea5": {
      "text": "Even now, we can still do something!",
      "status": "imported"
    },
    "voice_097:r_63f429c5c68c0863": {
      "text": "This is bad! What do we do?!",
      "status": "imported"
    },
    "voice_097:r_38e4a434c91d8ef0": {
      "text": "We live, and Ptolemy does...\\nSo...!",
      "status": "imported"
    },
    "voice_097:r_98ed411352a3a6ac": {
      "text": "Critical damage! Starboard ravaged!",
      "status": "imported"
    },
    "voice_097:r_4824bea6bab3af67": {
      "text": "E20 through E68 -\\nshutters down!",
      "status": "imported"
    },
    "voice_097:r_862b92e63adb9734": {
      "text": "Damn! All hands, prep to evacuate!",
      "status": "imported"
    },
    "voice_097:r_cb306ef55e49d107": {
      "text": "No!\\nThis time, we're all surviving!",
      "status": "imported"
    },
    "voice_097:r_57b2bd2de8a1408d": {
      "text": "Feldt, status of onboard systems?!",
      "status": "imported"
    },
    "voice_097:r_76f080a4881e8ab5": {
      "text": "Nav and combat systems\\nhit hard...!",
      "status": "imported"
    },
    "voice_097:r_288133bc5b573dae": {
      "text": "Mileina, report our damage status!",
      "status": "imported"
    },
    "voice_097:r_6f95653e548f8fcf": {
      "text": "Damage is over 70%...!",
      "status": "imported"
    },
    "voice_097:r_d249d68bada91ab9": {
      "text": "The Ptolemy's in huge trouble...!",
      "status": "imported"
    },
    "voice_097:r_e9b3307e9eb69f11": {
      "text": "Just hold on a little longer!",
      "status": "imported"
    },
    "voice_097:r_03cdac73042343ee": {
      "text": "This can't be real...?",
      "status": "imported"
    },
    "voice_097:r_6026da5acbda7c69": {
      "text": "It's real. We've lost...",
      "status": "imported"
    },
    "voice_097:r_981f8fedd5414fe5": {
      "text": "Sumeragi...!",
      "status": "imported"
    },
    "voice_097:r_96bb0dcde0c8c44a": {
      "text": "Damn! Abandon ship! Hurry!",
      "status": "imported"
    },
    "voice_097:r_641550a2f54cb456": {
      "text": "Looks like this is our end...!",
      "status": "imported"
    },
    "voice_097:r_a0f2074af8debbfa": {
      "text": "No! I don't want this! Nooo!",
      "status": "imported"
    },
    "voice_097:r_b5f5a97ed82acb0b": {
      "text": "We don't have enough particles!",
      "status": "imported"
    },
    "voice_097:r_d9cd2e4ded064396": {
      "text": "We're in deep trouble at this rate!",
      "status": "imported"
    },
    "voice_097:r_99e6349431aaf23b": {
      "text": "Enemy contact lost!",
      "status": "imported"
    },
    "voice_097:r_ec1081caf845f56a": {
      "text": "Damn, what a monster...!",
      "status": "imported"
    },
    "voice_097:r_2c5b7ee872c1ed7f": {
      "text": "Evasion successful!",
      "status": "imported"
    },
    "voice_097:r_76d1e51c8b494a60": {
      "text": "And that's how it's done!",
      "status": "imported"
    },
    "voice_097:r_eb5f687fcd372ae7": {
      "text": "Here we go!",
      "status": "imported"
    },
    "voice_097:r_2329428a6871d9fa": {
      "text": "Aeon, you're incredible!",
      "status": "imported"
    },
    "voice_097:r_0e7466971bec4cc4": {
      "text": "Raaagh!",
      "status": "imported"
    },
    "voice_097:r_efa71f7a4cc33ff3": {
      "text": "Timing is perfect!",
      "status": "imported"
    },
    "voice_097:r_3fc2e1186557e7a0": {
      "text": "We're being pushed back!",
      "status": "imported"
    },
    "voice_097:r_fa6930340a545054": {
      "text": "The fight's only getting started!",
      "status": "imported"
    }
  }
}
