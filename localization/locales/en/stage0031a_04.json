{
  "schema": 1,
  "language": "en",
  "messages": {
    "stage0031a_04:r_caaab7bad760e16d": {
      "text": "$$マヤ$$\n「Surveillance target entered the Odawara Defense Line.」",
      "status": "imported"
    },
    "stage0031a_04:r_99b162aa6aa286a2": {
      "text": "$$シゲル$$\n「Analysis of unidentified flying object complete.\n　Pattern Blue, confirmed Angel.」",
      "status": "imported"
    },
    "stage0031a_04:r_58fb02434a1c40b2": {
      "text": "$$冬月$$\n「As I thought, it's $$第６の使徒$$.」",
      "status": "imported"
    },
    "stage0031a_04:r_1c0f94acd5a8a143": {
      "text": "$$ゲンドウ$$\n「Deploy Unit-01.」",
      "status": "imported"
    },
    "stage0031a_04:r_1263541f4071624e": {
      "text": "$$ミサト$$\n「EVA Unit-01, prepare for launch!」",
      "status": "imported"
    },
    "stage0031a_04:r_3bc300bbdc277d82": {
      "text": "$$マコト$$\n「EVA Unit-01, launch preparations complete!」",
      "status": "imported"
    },
    "stage0031a_04:r_38762a09460d8b6b": {
      "text": "$$ミサト$$\n「Launch!」",
      "status": "imported"
    },
    "stage0031a_04:r_7ab28e70b4d4f641": {
      "text": "$$シゲル$$\n「High energy reading inside the target!」",
      "status": "imported"
    },
    "stage0031a_04:r_b05f6a6e8f3d9b24": {
      "text": "$$ミサト$$\n「What did you say!?」",
      "status": "imported"
    },
    "stage0031a_04:r_ec335e69f984b8b3": {
      "text": "$$リツコ$$\n「It can't be!」",
      "status": "imported"
    },
    "stage0031a_04:r_0abcaf0c31978670": {
      "text": "$$ミサト$$\n「Dodge it, $$シンジ$$!」",
      "status": "imported"
    },
    "stage0031a_04:r_1d6bc48b7f246730": {
      "text": "$$シンジ$$\n「Eh...」",
      "status": "imported"
    },
    "stage0031a_04:r_1af20fccc3c53cfc": {
      "text": "$$シンジ$$\n「Waaaaaaaah!!」",
      "status": "imported"
    },
    "stage0031a_04:r_f951916061232dcd": {
      "text": "$$ミサト$$\n「Prioritize protecting the pilot!\n　Emergency-eject the plug!」",
      "status": "imported"
    },
    "stage0031a_04:r_4d863c3fb88a4c39": {
      "text": "$$ゲンドウ$$\n「No.」",
      "status": "imported"
    },
    "stage0031a_04:r_44f4742c3dcce39a": {
      "text": "$$ミサト$$\n「!」",
      "status": "imported"
    },
    "stage0031a_04:r_9e701cdeb3842c21": {
      "text": "$$リツコ$$\n「If we lose the pilot now,\n　the EVA's A.T. Field will vanish completely.\n　That would be our worst-case scenario.」",
      "status": "imported"
    },
    "stage0031a_04:r_6fd81f4abebe60c5": {
      "text": "$$ミサト$$\n「Forced recovery, now!\n　Ignite the explosive bolts!」",
      "status": "imported"
    },
    "stage0031a_04:r_da2132b5038ec737": {
      "text": "$$第６の使徒$$\n「.........」",
      "status": "imported"
    },
    "stage0031a_04:r_495d61d3ec7e16f2": {
      "text": "$$シゲル$$\n「Target's gone silent.」",
      "status": "imported"
    },
    "stage0031a_04:r_5cd353758cfe474d": {
      "text": "$$マヤ$$\n「Unit-01 recovered, to the emergency cage!」",
      "status": "imported"
    },
    "stage0031a_04:r_a653c8dec4c0f06f": {
      "text": "$$ミサト$$\n「Medical team, hurry!\n　Save $$シンジ$$, no matter what!」",
      "status": "imported"
    },
    "stage0031a_04:r_86d493e37a9799a7": {
      "text": "$$ゲンドウ$$\n「.........」",
      "status": "imported"
    }
  }
}
