{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_146:r_479b340ccc6c572b": {
      "text": "Hey, you!\\nYou go no farther!",
      "status": "imported"
    },
    "voice_146:r_77949221bf58f862": {
      "text": "Hear this and know!\\nI'm Boss Borot!",
      "status": "imported"
    },
    "voice_146:r_70b9c4b9f1f37eff": {
      "text": "Take my challenge, if you dare!",
      "status": "imported"
    },
    "voice_146:r_9fcb3754cb1773c7": {
      "text": "I can't afford\\nto lose this fight!",
      "status": "imported"
    },
    "voice_146:r_3559d2fad32c2435": {
      "text": "Alias: Boss!\\nAuthor knows no name!",
      "status": "imported"
    },
    "voice_146:r_f7570547e9f80a64": {
      "text": "Lose more,\\nKurogane-ya goes broke!",
      "status": "imported"
    },
    "voice_146:r_cbab0f4720e1fcf1": {
      "text": "Kurogane-ya\\ntook me in. Big debt!",
      "status": "imported"
    },
    "voice_146:r_0bbe0b4f5364e732": {
      "text": "Gah, water?!\\nHurry or I'll drown!",
      "status": "imported"
    },
    "voice_146:r_5dda5198137cb02a": {
      "text": "E-e-e-enemy!",
      "status": "imported"
    },
    "voice_146:r_83ec59afbecdec14": {
      "text": "Shut up! I can see that!",
      "status": "imported"
    },
    "voice_146:r_e20bfd42ad95a3c9": {
      "text": "Boss! Hang in there!",
      "status": "imported"
    },
    "voice_146:r_0f58a8822381e57f": {
      "text": "Ha ha ha ha ha ha!\\nTime to show off!",
      "status": "imported"
    },
    "voice_146:r_6dbcc507fb61b51d": {
      "text": "We're counting on you, Boss!",
      "status": "imported"
    },
    "voice_146:r_b42ab697149a7c8a": {
      "text": "Damn right!\\nTop dog for a reason!",
      "status": "imported"
    },
    "voice_146:r_4de4fcf3b440baf4": {
      "text": "Boss! The enemy's here!",
      "status": "imported"
    },
    "voice_146:r_0121a166c715cdff": {
      "text": "Japan's top gang boss\\nwill take you!",
      "status": "imported"
    },
    "voice_146:r_30fad37a42bd3ad3": {
      "text": "All right! Nuke, Mucha, let's go!",
      "status": "imported"
    },
    "voice_146:r_80a0b2a84e05d81a": {
      "text": "Aye!",
      "status": "imported"
    },
    "voice_146:r_4a9ac1dff86506d9": {
      "text": "But wait - here's another shot!",
      "status": "imported"
    },
    "voice_146:r_bc8538e6af3d2577": {
      "text": "Perfect!\\nYour head's my soccer ball!",
      "status": "imported"
    },
    "voice_146:r_924516c8de2b5342": {
      "text": "Mechabeast!\\nYour foe is Boss Borot!",
      "status": "imported"
    },
    "voice_146:r_da1174533722333f": {
      "text": "Move it!\\nI'll take out the monster!",
      "status": "imported"
    },
    "voice_146:r_fdeb8162976e72c1": {
      "text": "Humans,\\nquit fighting each other!",
      "status": "imported"
    },
    "voice_146:r_0fadb5c26df92b42": {
      "text": "Boss to boss,\\nI'll set you straight!",
      "status": "imported"
    },
    "voice_146:r_6b15af9a0057cdc8": {
      "text": "Mechabeast or not, don't get scared!",
      "status": "imported"
    },
    "voice_146:r_15b4a90140e8a33a": {
      "text": "Aye, got it!",
      "status": "imported"
    },
    "voice_146:r_af884a6b11dff121": {
      "text": "I-is that Gundam on our side?!",
      "status": "imported"
    },
    "voice_146:r_ac6fe7838e95647b": {
      "text": "Boss! That one's the enemy!",
      "status": "imported"
    },
    "voice_146:r_77ca87eacd17ad52": {
      "text": "Hey! Don't act like some big shot!",
      "status": "imported"
    },
    "voice_146:r_bf3244994760e535": {
      "text": "Final boss?\\nThen fight our Boss!",
      "status": "imported"
    },
    "voice_146:r_aabfb21c9d069ce7": {
      "text": "Last fight!\\nLet's finish with a win!",
      "status": "imported"
    },
    "voice_146:r_02479dc8fe989560": {
      "text": "That's my brawling style!",
      "status": "imported"
    },
    "voice_146:r_a2df00f91a9b0a9e": {
      "text": "Fistfights are my specialty!",
      "status": "imported"
    },
    "voice_146:r_48b60d6c48b9b142": {
      "text": "I'll beat you to a pulp!",
      "status": "imported"
    },
    "voice_146:r_8927e6fb681aa809": {
      "text": "Raaaaagh!",
      "status": "imported"
    },
    "voice_146:r_665f01666859013b": {
      "text": "How do you like thiiis?!",
      "status": "imported"
    },
    "voice_146:r_a571eec59b258d11": {
      "text": "My punch is no ordinary punch!",
      "status": "imported"
    },
    "voice_146:r_ddbe581c5ea9183d": {
      "text": "It's all or nothing now!",
      "status": "imported"
    },
    "voice_146:r_faae935cca0edc72": {
      "text": "Chaaaarge!",
      "status": "imported"
    },
    "voice_146:r_d4430bf362340b32": {
      "text": "This is the end!",
      "status": "imported"
    },
    "voice_146:r_6ff1323b355593e0": {
      "text": "Sometimes death brings glory!",
      "status": "imported"
    },
    "voice_146:r_b7b5625d7cd4282f": {
      "text": "I've been waiting for this!",
      "status": "imported"
    },
    "voice_146:r_36133ad73a73ef98": {
      "text": "Grit your teeth!",
      "status": "imported"
    },
    "voice_146:r_920740a0219c5085": {
      "text": "The biggest gamble of my life!",
      "status": "imported"
    },
    "voice_146:r_a8451712c57c1a72": {
      "text": "Everyone, I'm counting on you!",
      "status": "imported"
    },
    "voice_146:r_3633df5b7b8f47fa": {
      "text": "Uooooooh!!",
      "status": "imported"
    },
    "voice_146:r_1b9b2aab5cb104da": {
      "text": "I'm ready for the worst!",
      "status": "imported"
    },
    "voice_146:r_cf41e8828a90cbdb": {
      "text": "A true do-or-die strike!",
      "status": "imported"
    },
    "voice_146:r_719e897304ec42d4": {
      "text": "I'm with you, Boss!",
      "status": "imported"
    },
    "voice_146:r_98d15b8cc09bc915": {
      "text": "This won't stand!\\nI need payback!",
      "status": "imported"
    },
    "voice_146:r_46e86d000250e137": {
      "text": "Now then, it's our turn!",
      "status": "imported"
    },
    "voice_146:r_ac341e7976e88f0b": {
      "text": "I'll return the favor in full!",
      "status": "imported"
    },
    "voice_146:r_cdbd128a5b4127cc": {
      "text": "I never forget what I owe!",
      "status": "imported"
    },
    "voice_146:r_cfccaa1fbeda124c": {
      "text": "Now you answer to me!",
      "status": "imported"
    },
    "voice_146:r_b1f8ec192b9c083a": {
      "text": "Your real opponent is me!",
      "status": "imported"
    },
    "voice_146:r_a007f9ab9cf048b3": {
      "text": "Not bad!\\nThat's my rival for you!",
      "status": "imported"
    },
    "voice_146:r_ddafde4b065ced49": {
      "text": "Stay outta this, Kabuto!",
      "status": "imported"
    },
    "voice_146:r_de1213040856c089": {
      "text": "Ladies first!\\nThen you'll face me!",
      "status": "imported"
    },
    "voice_146:r_3304412ac41f47a6": {
      "text": "Don't mention it! Leave this to me!",
      "status": "imported"
    },
    "voice_146:r_0c0775e051211840": {
      "text": "No worries!\\nWe're eternal fall guys!",
      "status": "imported"
    },
    "voice_146:r_a2afffe1c396f0b3": {
      "text": "What's wrong, Kabuto? Not like you!",
      "status": "imported"
    },
    "voice_146:r_13c25fbdfddc8a24": {
      "text": "I'll be the first to beat Kabuto!",
      "status": "imported"
    },
    "voice_146:r_42ba1ecb310b4bd7": {
      "text": "Sayaka!\\nDependable Boss is here!",
      "status": "imported"
    },
    "voice_146:r_d692f1d420460a47": {
      "text": "Heh! This once, I'll let it slide!",
      "status": "imported"
    },
    "voice_146:r_a5643cec86b18bd2": {
      "text": "W-w-w-what do we do...?!",
      "status": "imported"
    },
    "voice_146:r_68f2dfab20a4a30e": {
      "text": "Idiot!\\nOf 36 plans, running's best!",
      "status": "imported"
    },
    "voice_146:r_9cedad8237480563": {
      "text": "What?!\\nDid you skimp on supplies?!",
      "status": "imported"
    },
    "voice_146:r_a03fabecba1508ca": {
      "text": "Daaamn! It still won't reach?!",
      "status": "imported"
    },
    "voice_146:r_5391b24a71eb10ae": {
      "text": "Like that wimpy shot could hit me!",
      "status": "imported"
    },
    "voice_146:r_a554ceef5c87b972": {
      "text": "Thanks for wasting that attack!",
      "status": "imported"
    },
    "voice_146:r_546c3d5937fbb7ee": {
      "text": "What were you aiming at, you idiot?!",
      "status": "imported"
    },
    "voice_146:r_1568ff6298b12b96": {
      "text": "Whoa!\\nThat was scary, scary!",
      "status": "imported"
    },
    "voice_146:r_2c9d94ba13c5fc50": {
      "text": "Don't get cocky, Mechabeast!",
      "status": "imported"
    },
    "voice_146:r_a77f4913375098d2": {
      "text": "Soft, Mechabeast! Famous Boss here!",
      "status": "imported"
    },
    "voice_146:r_428c2116ac3071b1": {
      "text": "If you want no more shame,\\nget lost!",
      "status": "imported"
    },
    "voice_146:r_84c116267b79f540": {
      "text": "Boss! You look so cool!",
      "status": "imported"
    },
    "voice_146:r_dad38ee29af2df3a": {
      "text": "ESP, hunch, sixth sense!\\nKappa fart!",
      "status": "imported"
    },
    "voice_146:r_3d32e86f8dc80909": {
      "text": "That's vulgar, Boss!",
      "status": "imported"
    },
    "voice_146:r_70451ffbabe2f876": {
      "text": "That's our Boss!",
      "status": "imported"
    },
    "voice_146:r_69dfa1659715e2fa": {
      "text": "Heh, you better believe it!",
      "status": "imported"
    },
    "voice_146:r_d996fd6d4ef5b329": {
      "text": "What a sluggish attack!",
      "status": "imported"
    },
    "voice_146:r_8ab47a28f99ef565": {
      "text": "You're worse than a two-bit thug!",
      "status": "imported"
    },
    "voice_146:r_04e815a8d425827d": {
      "text": "Whoa there!\\nWe've got a barrier!",
      "status": "imported"
    },
    "voice_146:r_d89011fe3e5d082a": {
      "text": "Me and Borot\\nare built real tough!",
      "status": "imported"
    },
    "voice_146:r_3c5b0c2ac812d5de": {
      "text": "What the heck?!\\nYou playing around?!",
      "status": "imported"
    },
    "voice_146:r_5b9e8897190892eb": {
      "text": "Guts, grit, power -\\nall too low!",
      "status": "imported"
    },
    "voice_146:r_7bea3023abbf8a94": {
      "text": "Next to Kabuto\\nthat punch is a fart!",
      "status": "imported"
    },
    "voice_146:r_dd01a4c0d1b36a8d": {
      "text": "Y-you bastard! Now you've done it!",
      "status": "imported"
    },
    "voice_146:r_20920ad2eb3542db": {
      "text": "Don't sweat it, Nuke! Stand firm!",
      "status": "imported"
    },
    "voice_146:r_0ab7914877fd48ed": {
      "text": "Boss, I think that one hit us...?",
      "status": "imported"
    },
    "voice_146:r_cb846feec748c2e3": {
      "text": "It's fine! Don't sweat small stuff!",
      "status": "imported"
    },
    "voice_146:r_c958860b0676b1f5": {
      "text": "Punk!\\nYou scratched my fresh polish!",
      "status": "imported"
    },
    "voice_146:r_5e2669b82ef75ce3": {
      "text": "We did the polishing, though...",
      "status": "imported"
    },
    "voice_146:r_7847e0ed7dc9282d": {
      "text": "Can't we\\njust ignore that guy??",
      "status": "imported"
    },
    "voice_146:r_e42b52c7a987b906": {
      "text": "I'm fine!\\nBut the rest face trouble!",
      "status": "imported"
    },
    "voice_146:r_6825fd1ff907bd22": {
      "text": "Whoa! Sparks shot from my eyes!",
      "status": "imported"
    },
    "voice_146:r_607f666f1563bc0d": {
      "text": "Finally, I can get serious!",
      "status": "imported"
    },
    "voice_146:r_97b7431eeb81e6b6": {
      "text": "Nyoooh! What'd you do, bastard?!",
      "status": "imported"
    },
    "voice_146:r_132f605d02975e71": {
      "text": "Daaamn!\\nThis is getting real rough!",
      "status": "imported"
    },
    "voice_146:r_9b9726b1872759d6": {
      "text": "Dammit!\\nThis is getting dangerous!",
      "status": "imported"
    },
    "voice_146:r_1252db29683fefe0": {
      "text": "Can't help it!\\nIt's a work machine!",
      "status": "imported"
    },
    "voice_146:r_ad3d538f1e909184": {
      "text": "Not bad!\\nYou may become my lackey!",
      "status": "imported"
    },
    "voice_146:r_8c61c59a1c0aebbf": {
      "text": "Boss!\\nNo scary guys in our gang!",
      "status": "imported"
    },
    "voice_146:r_aba6a7662129d8ce": {
      "text": "Are you okay, you heap of junk?!",
      "status": "imported"
    },
    "voice_146:r_b84afafb8a33ec60": {
      "text": "Who cares! Damn the consequences!",
      "status": "imported"
    },
    "voice_146:r_c8c59db85bf875e6": {
      "text": "B-Boss! This is bad, isn't it?!",
      "status": "imported"
    },
    "voice_146:r_391aa56435d9dd6e": {
      "text": "Shut up!\\nNow we fight or die!",
      "status": "imported"
    },
    "voice_146:r_7c796ba53bd7ea03": {
      "text": "Ughhh! That one really hurt...!",
      "status": "imported"
    },
    "voice_146:r_fa944da4b6519006": {
      "text": "Boss Borot\\ncan't take a Mechabeast!",
      "status": "imported"
    },
    "voice_146:r_95d047bcc17fccc6": {
      "text": "Boss!\\nThat Mechabeast is no joke!",
      "status": "imported"
    },
    "voice_146:r_640327a12a559b31": {
      "text": "I know! I was ready for that!",
      "status": "imported"
    },
    "voice_146:r_381992c5d8224937": {
      "text": "We're desperate,\\nso are they. Damn!",
      "status": "imported"
    },
    "voice_146:r_f1e7ed9e5874aba5": {
      "text": "Ughhhh! That one really hurt!",
      "status": "imported"
    },
    "voice_146:r_fc25e66a86fc2c85": {
      "text": "H-hey, wait!\\nThis is no damn joke!",
      "status": "imported"
    },
    "voice_146:r_5aeeb4917340c42d": {
      "text": "Waaah!\\nKnee-deep in the Sanzu River!",
      "status": "imported"
    },
    "voice_146:r_b765659981b6516d": {
      "text": "Screw you!\\nI'm not beaten yet!",
      "status": "imported"
    },
    "voice_146:r_0c427458bc00eb95": {
      "text": "Eeeeeek!\\nI don't wanna die!",
      "status": "imported"
    },
    "voice_146:r_774a9ab4d8fd5351": {
      "text": "Don't worry! We'll die together!",
      "status": "imported"
    },
    "voice_146:r_d3f01de714c015bd": {
      "text": "Boss! Let's retreat for now!",
      "status": "imported"
    },
    "voice_146:r_7d2617c809fead70": {
      "text": "Fool!\\nReal men charge into danger!",
      "status": "imported"
    },
    "voice_146:r_ceb935ccbf830724": {
      "text": "Heeelp! I can't take any more!",
      "status": "imported"
    },
    "voice_146:r_862ef7385bf2abd4": {
      "text": "Stop!\\nA man never begs for life!",
      "status": "imported"
    },
    "voice_146:r_001cbec4d9a4283f": {
      "text": "Boss! There's nothing we can do now!",
      "status": "imported"
    },
    "voice_146:r_8ad40afecd02b41e": {
      "text": "Now we've got no choice but retreat!",
      "status": "imported"
    },
    "voice_146:r_26e5efec03c03d78": {
      "text": "D-dammit! My Borot!",
      "status": "imported"
    },
    "voice_146:r_4ad81e88c7557a8b": {
      "text": "Daaaaamn!\\nYou'll pay for this!",
      "status": "imported"
    },
    "voice_146:r_1f65a7af190e4674": {
      "text": "All right, everyone! You're up!",
      "status": "imported"
    },
    "voice_146:r_40c5a9358ed5bf29": {
      "text": "Cross, fighter with the arms of Z!",
      "status": "imported"
    },
    "voice_146:r_f2e18dfdfe0c89ea": {
      "text": "Magnum Z gunman,\\nWild Django!",
      "status": "imported"
    },
    "voice_146:r_cf7dbf49e96a5755": {
      "text": "Blade Z cuts in silence -\\nSensei!",
      "status": "imported"
    },
    "voice_146:r_fa96676cc65bb509": {
      "text": "The human bomb, Yasu the Weasel!",
      "status": "imported"
    },
    "voice_146:r_4e37f92e7d2fc62e": {
      "text": "Strongest!\\nSwift-thread Kikunosuke!",
      "status": "imported"
    },
    "voice_146:r_66ab4cfe1557909d": {
      "text": "They are the Kurogane Five!",
      "status": "imported"
    },
    "voice_146:r_0bad405ee6ca63ba": {
      "text": "Those gathered here are...!",
      "status": "imported"
    },
    "voice_146:r_2072eaf71a260ae7": {
      "text": "Sorry we're late!\\nThe Kurogane Five!",
      "status": "imported"
    },
    "voice_146:r_6c13bbfd27a7799e": {
      "text": "Cross!",
      "status": "imported"
    },
    "voice_146:r_06f88dcbd3c9e738": {
      "text": "Django!",
      "status": "imported"
    },
    "voice_146:r_b28faf9f71bc3598": {
      "text": "Sensei!",
      "status": "imported"
    },
    "voice_146:r_8a29278549f8e07a": {
      "text": "Yasu!",
      "status": "imported"
    },
    "voice_146:r_7e6c573c26177f98": {
      "text": "Okiku!",
      "status": "imported"
    },
    "voice_146:r_8165e5b41f0124c4": {
      "text": "Behold Boss Borot in action!",
      "status": "imported"
    },
    "voice_146:r_4e05581b7432cce8": {
      "text": "Let's see who's stronger, you or me!",
      "status": "imported"
    },
    "voice_146:r_a60b107ea3c36a86": {
      "text": "We fight!\\nThat's Boss Borot's job!",
      "status": "imported"
    },
    "voice_146:r_e33693e5ba4665b0": {
      "text": "Boss! You look so cool!",
      "status": "imported"
    },
    "voice_146:r_72a21a1a489af001": {
      "text": "We'll follow you anywhere!",
      "status": "imported"
    },
    "voice_146:r_625664af02183c17": {
      "text": "Time to show 'em what I can do!",
      "status": "imported"
    },
    "voice_146:r_3701cba361f80ea5": {
      "text": "You think you can run away?!",
      "status": "imported"
    },
    "voice_146:r_63f429c5c68c0863": {
      "text": "Gotcha! The fool's guard is down!",
      "status": "imported"
    },
    "voice_146:r_38e4a434c91d8ef0": {
      "text": "We lost again...",
      "status": "imported"
    },
    "voice_146:r_98ed411352a3a6ac": {
      "text": "It hurts knowing it's coming...",
      "status": "imported"
    },
    "voice_146:r_4824bea6bab3af67": {
      "text": "Not so fast!\\nMe and Borot never die!",
      "status": "imported"
    },
    "voice_146:r_862b92e63adb9734": {
      "text": "Tch! You really get on my nerves!",
      "status": "imported"
    },
    "voice_146:r_cb306ef55e49d107": {
      "text": "You bastard! Bring it on!",
      "status": "imported"
    },
    "voice_146:r_57b2bd2de8a1408d": {
      "text": "I won't go down that easily!",
      "status": "imported"
    },
    "voice_146:r_76f080a4881e8ab5": {
      "text": "Behold the gallant Boss Borot!",
      "status": "imported"
    },
    "voice_146:r_288133bc5b573dae": {
      "text": "Whoa! Not gonna happen!",
      "status": "imported"
    },
    "voice_146:r_6f95653e548f8fcf": {
      "text": "Come on! You're too slow!",
      "status": "imported"
    },
    "voice_146:r_e9b3307e9eb69f11": {
      "text": "Like that'd get through my barrier!",
      "status": "imported"
    },
    "voice_146:r_03cdac73042343ee": {
      "text": "Hurts a bit, but a man endures!",
      "status": "imported"
    },
    "voice_146:r_6026da5acbda7c69": {
      "text": "Well, panicking won't help!",
      "status": "imported"
    },
    "voice_146:r_981f8fedd5414fe5": {
      "text": "Hear! See! Flee!\\nThe Kurogane Five!",
      "status": "imported"
    },
    "voice_146:r_96bb0dcde0c8c44a": {
      "text": "First, this fighter! Step up!",
      "status": "imported"
    },
    "voice_146:r_641550a2f54cb456": {
      "text": "And who do we have next?",
      "status": "imported"
    },
    "voice_146:r_a0f2074af8debbfa": {
      "text": "Now then, who's up next?",
      "status": "imported"
    },
    "voice_146:r_b5f5a97ed82acb0b": {
      "text": "Only two left! Which will it be?",
      "status": "imported"
    },
    "voice_146:r_d9cd2e4ded064396": {
      "text": "And now, the one who remains!",
      "status": "imported"
    },
    "voice_146:r_99e6349431aaf23b": {
      "text": "All together! The Kurogane Five!",
      "status": "imported"
    },
    "voice_146:r_2c5b7ee872c1ed7f": {
      "text": "I'm leading the charge!",
      "status": "imported"
    },
    "voice_146:r_76d1e51c8b494a60": {
      "text": "All right! Follow Boss Borot!",
      "status": "imported"
    },
    "voice_146:r_eb5f687fcd372ae7": {
      "text": "I've been given a job!\\nI'll nail it!",
      "status": "imported"
    },
    "voice_146:r_2329428a6871d9fa": {
      "text": "One-on-one, I can't afford to lose!",
      "status": "imported"
    },
    "voice_146:r_0e7466971bec4cc4": {
      "text": "You're gonna face me, bastard!",
      "status": "imported"
    },
    "voice_146:r_efa71f7a4cc33ff3": {
      "text": "All right! I'll take a swing too!",
      "status": "imported"
    }
  }
}
