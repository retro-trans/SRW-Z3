{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_175:r_479b340ccc6c572b": {
      "text": "I don't have anything else.",
      "status": "imported"
    },
    "voice_175:r_ca4acbac57a2a35e": {
      "text": "EVA is my only bond with others.",
      "status": "imported"
    },
    "voice_175:r_77949221bf58f862": {
      "text": "It's what that person wanted.",
      "status": "imported"
    },
    "voice_175:r_70b9c4b9f1f37eff": {
      "text": "I'm not a doll.",
      "status": "imported"
    },
    "voice_175:r_9fcb3754cb1773c7": {
      "text": "EVA is a mirror. Of my heart.",
      "status": "imported"
    },
    "voice_175:r_3559d2fad32c2435": {
      "text": "Because this is our bond...",
      "status": "imported"
    },
    "voice_175:r_f7570547e9f80a64": {
      "text": "I'll do what Shinji wants.",
      "status": "imported"
    },
    "voice_175:r_cbab0f4720e1fcf1": {
      "text": "I'm here of my own free will.",
      "status": "imported"
    },
    "voice_175:r_0bbe0b4f5364e732": {
      "text": "My own wish. I'll make it real.",
      "status": "imported"
    },
    "voice_175:r_5dda5198137cb02a": {
      "text": "Rei, I'm counting on you.",
      "status": "imported"
    },
    "voice_175:r_83ec59afbecdec14": {
      "text": "Yes.",
      "status": "imported"
    },
    "voice_175:r_e20bfd42ad95a3c9": {
      "text": "Finish them for sure, Rei.",
      "status": "imported"
    },
    "voice_175:r_0f58a8822381e57f": {
      "text": "Understood.",
      "status": "imported"
    },
    "voice_175:r_6dbcc507fb61b51d": {
      "text": "I can do it.",
      "status": "imported"
    },
    "voice_175:r_b42ab697149a7c8a": {
      "text": "Here it comes...",
      "status": "imported"
    },
    "voice_175:r_4de4fcf3b440baf4": {
      "text": "Commencing attack.",
      "status": "imported"
    },
    "voice_175:r_0121a166c715cdff": {
      "text": "Target acquired.",
      "status": "imported"
    },
    "voice_175:r_30fad37a42bd3ad3": {
      "text": "EVA-00, commencing battle.",
      "status": "imported"
    },
    "voice_175:r_80a0b2a84e05d81a": {
      "text": "Commencing combat operations.",
      "status": "imported"
    },
    "voice_175:r_4a9ac1dff86506d9": {
      "text": "There.",
      "status": "imported"
    },
    "voice_175:r_bc8538e6af3d2577": {
      "text": "Goodbye.",
      "status": "imported"
    },
    "voice_175:r_924516c8de2b5342": {
      "text": "Ngh...!",
      "status": "imported"
    },
    "voice_175:r_da1174533722333f": {
      "text": "Target locked.",
      "status": "imported"
    },
    "voice_175:r_fdeb8162976e72c1": {
      "text": "I won't miss.",
      "status": "imported"
    },
    "voice_175:r_0fadb5c26df92b42": {
      "text": "Taking aim... I can do this.",
      "status": "imported"
    },
    "voice_175:r_6b15af9a0057cdc8": {
      "text": "If I close the distance...",
      "status": "imported"
    },
    "voice_175:r_15b4a90140e8a33a": {
      "text": "From here, this will work.",
      "status": "imported"
    },
    "voice_175:r_af884a6b11dff121": {
      "text": "I'll have to close in.",
      "status": "imported"
    },
    "voice_175:r_ac6fe7838e95647b": {
      "text": "Continuing the attack.",
      "status": "imported"
    },
    "voice_175:r_77ca87eacd17ad52": {
      "text": "Attack again.",
      "status": "imported"
    },
    "voice_175:r_bf3244994760e535": {
      "text": "I won't let you reach Lilith.",
      "status": "imported"
    },
    "voice_175:r_aabfb21c9d069ce7": {
      "text": "Because that's my role.",
      "status": "imported"
    },
    "voice_175:r_02479dc8fe989560": {
      "text": "Do they feel warm too...?",
      "status": "imported"
    },
    "voice_175:r_a2df00f91a9b0a9e": {
      "text": "Those people... They're warm...",
      "status": "imported"
    },
    "voice_175:r_48b60d6c48b9b142": {
      "text": "I'm sorry.",
      "status": "imported"
    },
    "voice_175:r_8927e6fb681aa809": {
      "text": "You're just like me...",
      "status": "imported"
    },
    "voice_175:r_665f01666859013b": {
      "text": "I won't let you have your way.",
      "status": "imported"
    },
    "voice_175:r_ddbe581c5ea9183d": {
      "text": "I don't understand how you feel.",
      "status": "imported"
    },
    "voice_175:r_d4430bf362340b32": {
      "text": "Shinji, thank you for everything.",
      "status": "imported"
    },
    "voice_175:r_6ff1323b355593e0": {
      "text": "I want to stay here. That's enough.",
      "status": "imported"
    },
    "voice_175:r_b7b5625d7cd4282f": {
      "text": "I'll beat you.\\nNo one fights again.",
      "status": "imported"
    },
    "voice_175:r_36133ad73a73ef98": {
      "text": "Future's yours and EVA's.\\nGo, Rei!",
      "status": "imported"
    },
    "voice_175:r_920740a0219c5085": {
      "text": "Yes.",
      "status": "imported"
    },
    "voice_175:r_24cf161287ef9d5c": {
      "text": "EVA-00, switching to counterattack.",
      "status": "imported"
    },
    "voice_175:r_8f60f6fc86db3107": {
      "text": "I won't let you escape.",
      "status": "imported"
    },
    "voice_175:r_b1de76a75a253c13": {
      "text": "I'll intercept.",
      "status": "imported"
    },
    "voice_175:r_128c35bf3e0e394c": {
      "text": "I'll stop you here.",
      "status": "imported"
    },
    "voice_175:r_5213c17e13b23de0": {
      "text": "Counterattack. I can do this.",
      "status": "imported"
    },
    "voice_175:r_38fdff9483e9245c": {
      "text": "No. Now it's my turn.",
      "status": "imported"
    },
    "voice_175:r_620fedec67706d7d": {
      "text": "We'll attack together.",
      "status": "imported"
    },
    "voice_175:r_9680dcd0fddcfcc7": {
      "text": "I'll back up the allied unit.",
      "status": "imported"
    },
    "voice_175:r_2a00f1044ad5cbaa": {
      "text": "Move.",
      "status": "imported"
    },
    "voice_175:r_3dbeead1bd3164ef": {
      "text": "You're in the way.",
      "status": "imported"
    },
    "voice_175:r_98d15b8cc09bc915": {
      "text": "I want to help Shinji...",
      "status": "imported"
    },
    "voice_175:r_46e86d000250e137": {
      "text": "Shinji, leave the rest to me.",
      "status": "imported"
    },
    "voice_175:r_ac341e7976e88f0b": {
      "text": "I'll follow Asuka's lead.",
      "status": "imported"
    },
    "voice_175:r_cdbd128a5b4127cc": {
      "text": "I'll support EVA-02's pilot.",
      "status": "imported"
    },
    "voice_175:r_cfccaa1fbeda124c": {
      "text": "I won't let you!",
      "status": "imported"
    },
    "voice_175:r_b1f8ec192b9c083a": {
      "text": "If I disappear, I can be replaced.",
      "status": "imported"
    },
    "voice_175:r_a007f9ab9cf048b3": {
      "text": "You won't die. I'll protect you.",
      "status": "imported"
    },
    "voice_175:r_ddafde4b065ced49": {
      "text": "Shinji...!",
      "status": "imported"
    },
    "voice_175:r_de1213040856c089": {
      "text": "You can find happiness without EVA.",
      "status": "imported"
    },
    "voice_175:r_3304412ac41f47a6": {
      "text": "Get away, EVA-02 pilot!",
      "status": "imported"
    },
    "voice_175:r_0c0775e051211840": {
      "text": "No. Counterattack impossible.",
      "status": "imported"
    },
    "voice_175:r_a2afffe1c396f0b3": {
      "text": "I can't do anything.",
      "status": "imported"
    },
    "voice_175:r_13c25fbdfddc8a24": {
      "text": "Target lost...",
      "status": "imported"
    },
    "voice_175:r_42ba1ecb310b4bd7": {
      "text": "No choice of action remains.",
      "status": "imported"
    },
    "voice_175:r_d692f1d420460a47": {
      "text": "Damage zero.",
      "status": "imported"
    },
    "voice_175:r_a5643cec86b18bd2": {
      "text": "Evasion successful.",
      "status": "imported"
    },
    "voice_175:r_68f2dfab20a4a30e": {
      "text": "No. That won't work...",
      "status": "imported"
    },
    "voice_175:r_9cedad8237480563": {
      "text": "EVA-00, no damage.",
      "status": "imported"
    },
    "voice_175:r_a03fabecba1508ca": {
      "text": "All systems normal. Continuing.",
      "status": "imported"
    },
    "voice_175:r_5391b24a71eb10ae": {
      "text": "I can't afford to be defeated.",
      "status": "imported"
    },
    "voice_175:r_a554ceef5c87b972": {
      "text": "You're in good form, Rei.",
      "status": "imported"
    },
    "voice_175:r_546c3d5937fbb7ee": {
      "text": "Yes. No problems.",
      "status": "imported"
    },
    "voice_175:r_1568ff6298b12b96": {
      "text": "Status?",
      "status": "imported"
    },
    "voice_175:r_2c9d94ba13c5fc50": {
      "text": "There are no problems.",
      "status": "imported"
    },
    "voice_175:r_a77f4913375098d2": {
      "text": "I see...",
      "status": "imported"
    },
    "voice_175:r_428c2116ac3071b1": {
      "text": "It won't work.",
      "status": "imported"
    },
    "voice_175:r_dad38ee29af2df3a": {
      "text": "Because I have an AT Field.",
      "status": "imported"
    },
    "voice_175:r_3d32e86f8dc80909": {
      "text": "Field at full power.",
      "status": "imported"
    },
    "voice_175:r_70451ffbabe2f876": {
      "text": "AT Field... Full power!",
      "status": "imported"
    },
    "voice_175:r_69dfa1659715e2fa": {
      "text": "I'm fine.",
      "status": "imported"
    },
    "voice_175:r_d996fd6d4ef5b329": {
      "text": "Continuing battle.",
      "status": "imported"
    },
    "voice_175:r_8ab47a28f99ef565": {
      "text": "Armor partially damaged.",
      "status": "imported"
    },
    "voice_175:r_546de3fb6db156ea": {
      "text": "It only grazed me.",
      "status": "imported"
    },
    "voice_175:r_ca85f87cee5e31f7": {
      "text": "That won't defeat an EVA.",
      "status": "imported"
    },
    "voice_175:r_9072ea7bc71df136": {
      "text": "They pierced my AT Field?",
      "status": "imported"
    },
    "voice_175:r_04e815a8d425827d": {
      "text": "Rei, are you all right?",
      "status": "imported"
    },
    "voice_175:r_d89011fe3e5d082a": {
      "text": "Yes. No problems.",
      "status": "imported"
    },
    "voice_175:r_3c5b0c2ac812d5de": {
      "text": "Ggh...!",
      "status": "imported"
    },
    "voice_175:r_5b9e8897190892eb": {
      "text": "Ngh... Nghh...!",
      "status": "imported"
    },
    "voice_175:r_7bea3023abbf8a94": {
      "text": "They broke through the Field...",
      "status": "imported"
    },
    "voice_175:r_dd01a4c0d1b36a8d": {
      "text": "I can still fight.",
      "status": "imported"
    },
    "voice_175:r_20920ad2eb3542db": {
      "text": "They're strong... But...",
      "status": "imported"
    },
    "voice_175:r_0ab7914877fd48ed": {
      "text": "There's still something I can do.",
      "status": "imported"
    },
    "voice_175:r_cb846feec748c2e3": {
      "text": "Primary armor cracked! Rei, you OK?",
      "status": "imported"
    },
    "voice_175:r_c958860b0676b1f5": {
      "text": "I can still go on...!",
      "status": "imported"
    },
    "voice_175:r_5e2669b82ef75ce3": {
      "text": "Nnnngh...!",
      "status": "imported"
    },
    "voice_175:r_7847e0ed7dc9282d": {
      "text": "No. If this keeps up...",
      "status": "imported"
    },
    "voice_175:r_e42b52c7a987b906": {
      "text": "I just need to move a little more.",
      "status": "imported"
    },
    "voice_175:r_6825fd1ff907bd22": {
      "text": "So this is your power...",
      "status": "imported"
    },
    "voice_175:r_607f666f1563bc0d": {
      "text": "We're still alive, EVA and I...",
      "status": "imported"
    },
    "voice_175:r_97b7431eeb81e6b6": {
      "text": "It isn't over yet.",
      "status": "imported"
    },
    "voice_175:r_132f605d02975e71": {
      "text": "I can't lose. This is our bond...",
      "status": "imported"
    },
    "voice_175:r_9b9726b1872759d6": {
      "text": "Shinji hasn't given up. So...!",
      "status": "imported"
    },
    "voice_175:r_1252db29683fefe0": {
      "text": "Rei,\\nif needed, ditch it! Retreat!",
      "status": "imported"
    },
    "voice_175:r_ad3d538f1e909184": {
      "text": "No. I don't have anything else...",
      "status": "imported"
    },
    "voice_175:r_8c61c59a1c0aebbf": {
      "text": "This is as far as I go...",
      "status": "imported"
    },
    "voice_175:r_aba6a7662129d8ce": {
      "text": "EVA-00 can't continue combat.",
      "status": "imported"
    },
    "voice_175:r_b84afafb8a33ec60": {
      "text": "I'm sorry. I couldn't do a thing...",
      "status": "imported"
    },
    "voice_175:r_c8c59db85bf875e6": {
      "text": "Read this? Understood. I'll do it.",
      "status": "imported"
    },
    "voice_175:r_391aa56435d9dd6e": {
      "text": "EVA-01 launches, its pilot unaware.",
      "status": "imported"
    },
    "voice_175:r_7c796ba53bd7ea03": {
      "text": "EVA-00 thaws. What's next for life?",
      "status": "imported"
    },
    "voice_175:r_fa944da4b6519006": {
      "text": "Next time, too: Service, service!",
      "status": "imported"
    },
    "voice_175:r_95d047bcc17fccc6": {
      "text": "Shinji.",
      "status": "imported"
    },
    "voice_175:r_640327a12a559b31": {
      "text": "Is Super Robot Wars fun?",
      "status": "imported"
    },
    "voice_175:r_bdd38c584fa313d0": {
      "text": "Is it fun to play with someone?",
      "status": "imported"
    },
    "voice_175:r_3fd86c1027f317c8": {
      "text": "Would they like me to play instead?",
      "status": "imported"
    },
    "voice_175:r_d0372a183d2007ad": {
      "text": "That person?",
      "status": "imported"
    },
    "voice_175:r_217aa5e1d545b44d": {
      "text": "I don't know. I feel warm with you.",
      "status": "imported"
    },
    "voice_175:r_381992c5d8224937": {
      "text": "I think I want to warm you too.",
      "status": "imported"
    },
    "voice_175:r_f1e7ed9e5874aba5": {
      "text": "I'll be waiting.",
      "status": "imported"
    },
    "voice_175:r_fc25e66a86fc2c85": {
      "text": "Because it's our bond...",
      "status": "imported"
    },
    "voice_175:r_5aeeb4917340c42d": {
      "text": "Goodbye.",
      "status": "imported"
    },
    "voice_175:r_b765659981b6516d": {
      "text": "Unsure. Shinji warms me, and I him.",
      "status": "imported"
    },
    "voice_175:r_0c427458bc00eb95": {
      "text": "I hope Shinji and Ikari bond warmly.",
      "status": "imported"
    },
    "voice_175:r_774a9ab4d8fd5351": {
      "text": "Delicious...",
      "status": "imported"
    },
    "voice_175:r_ceb935ccbf830724": {
      "text": "I'll go on ahead.",
      "status": "imported"
    },
    "voice_175:r_862ef7385bf2abd4": {
      "text": "I'll keep them pinned.",
      "status": "imported"
    },
    "voice_175:r_001cbec4d9a4283f": {
      "text": "EVA-00 will hold them here.",
      "status": "imported"
    },
    "voice_175:r_8ad40afecd02b41e": {
      "text": "So that's the enemy...",
      "status": "imported"
    },
    "voice_175:r_26e5efec03c03d78": {
      "text": "Target confirmed.",
      "status": "imported"
    },
    "voice_175:r_4ad81e88c7557a8b": {
      "text": "I'll split the enemy forces.",
      "status": "imported"
    }
  }
}
