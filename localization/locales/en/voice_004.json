{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_004:r_479b340ccc6c572b": {
      "text": "Might makes right - the primal law?",
      "status": "imported"
    },
    "voice_004:r_ca4acbac57a2a35e": {
      "text": "GO",
      "status": "imported"
    },
    "voice_004:r_77949221bf58f862": {
      "text": "Are you ready?",
      "status": "imported"
    },
    "voice_004:r_70b9c4b9f1f37eff": {
      "text": "Bad news. I'm all set.",
      "status": "imported"
    },
    "voice_004:r_9fcb3754cb1773c7": {
      "text": "Perfect for killing some time.",
      "status": "imported"
    },
    "voice_004:r_3559d2fad32c2435": {
      "text": "I'm a combat asset too, you know.",
      "status": "imported"
    },
    "voice_004:r_f7570547e9f80a64": {
      "text": "Now then, shall we begin?",
      "status": "imported"
    },
    "voice_004:r_cbab0f4720e1fcf1": {
      "text": "This isn't so bad for a change.",
      "status": "imported"
    },
    "voice_004:r_0bbe0b4f5364e732": {
      "text": "Don't disappoint me.",
      "status": "imported"
    },
    "voice_004:r_5dda5198137cb02a": {
      "text": "I don't intend to miss.",
      "status": "imported"
    },
    "voice_004:r_83ec59afbecdec14": {
      "text": "Relax. My aim is perfect.",
      "status": "imported"
    },
    "voice_004:r_e20bfd42ad95a3c9": {
      "text": "Don't move. You'll spoil my aim.",
      "status": "imported"
    },
    "voice_004:r_0f58a8822381e57f": {
      "text": "Sorry...",
      "status": "imported"
    },
    "voice_004:r_6dbcc507fb61b51d": {
      "text": "I've got you.",
      "status": "imported"
    },
    "voice_004:r_b42ab697149a7c8a": {
      "text": "Once I get in close!",
      "status": "imported"
    },
    "voice_004:r_4de4fcf3b440baf4": {
      "text": "You're a tough one...",
      "status": "imported"
    },
    "voice_004:r_0121a166c715cdff": {
      "text": "Oh, no need to hold back.",
      "status": "imported"
    },
    "voice_004:r_30fad37a42bd3ad3": {
      "text": "They won't be easy to stop...!",
      "status": "imported"
    },
    "voice_004:r_80a0b2a84e05d81a": {
      "text": "They'd be trouble as an enemy.",
      "status": "imported"
    },
    "voice_004:r_4a9ac1dff86506d9": {
      "text": "Now they've got me hunting monsters!",
      "status": "imported"
    },
    "voice_004:r_bc8538e6af3d2577": {
      "text": "To think I'd fight scum like them...",
      "status": "imported"
    },
    "voice_004:r_924516c8de2b5342": {
      "text": "I swore this ends\\nhere and now.",
      "status": "imported"
    },
    "voice_004:r_da1174533722333f": {
      "text": "One demon king is more than enough.",
      "status": "imported"
    },
    "voice_004:r_ddbe581c5ea9183d": {
      "text": "It's over.",
      "status": "imported"
    },
    "voice_004:r_faae935cca0edc72": {
      "text": "Disappear!",
      "status": "imported"
    },
    "voice_004:r_d4430bf362340b32": {
      "text": "This is the end.",
      "status": "imported"
    },
    "voice_004:r_6ff1323b355593e0": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_004:r_b7b5625d7cd4282f": {
      "text": "Give up.",
      "status": "imported"
    },
    "voice_004:r_36133ad73a73ef98": {
      "text": "Goodbye.",
      "status": "imported"
    },
    "voice_004:r_41997412868c48c4": {
      "text": "Lelouch will nag me if you escape...",
      "status": "imported"
    },
    "voice_004:r_9e6cf4f389dae55c": {
      "text": "I may not look it, but I keep score.",
      "status": "imported"
    },
    "voice_004:r_9e0c80ac7e33b459": {
      "text": "That's not fair. Don't run away.",
      "status": "imported"
    },
    "voice_004:r_7432ef43ed3471dc": {
      "text": "You started this, didn't you?",
      "status": "imported"
    },
    "voice_004:r_065443f6ddfcf0d7": {
      "text": "You really waited.\\nHow kind of you.",
      "status": "imported"
    },
    "voice_004:r_47d52a2839c71715": {
      "text": "I'm not one to forget a favor.",
      "status": "imported"
    },
    "voice_004:r_847f82e7f3eef651": {
      "text": "I'll cover you.",
      "status": "imported"
    },
    "voice_004:r_eb7ae28b53dc033c": {
      "text": "Oops. Am I stealing your kill?",
      "status": "imported"
    },
    "voice_004:r_857c4a52ce8df0fd": {
      "text": "We're accomplices, after all.",
      "status": "imported"
    },
    "voice_004:r_55417493fce1d347": {
      "text": "Go on ahead, Lelouch.",
      "status": "imported"
    },
    "voice_004:r_8fdf5910927c9591": {
      "text": "Well, well. Not bad, Kallen.",
      "status": "imported"
    },
    "voice_004:r_7d724dbcc4451e10": {
      "text": "Heh. Good to have you on my side.",
      "status": "imported"
    },
    "voice_004:r_93e25418a203cb8f": {
      "text": "You'll owe me big for this.",
      "status": "imported"
    },
    "voice_004:r_adeb0a29274d3d9b": {
      "text": "Hey, I'm not your guardian.",
      "status": "imported"
    },
    "voice_004:r_24cf161287ef9d5c": {
      "text": "I said I'd protect you, didn't I?",
      "status": "imported"
    },
    "voice_004:r_8f60f6fc86db3107": {
      "text": "Our pact? I'd stay at your side...",
      "status": "imported"
    },
    "voice_004:r_b1de76a75a253c13": {
      "text": "You're reckless as ever...",
      "status": "imported"
    },
    "voice_004:r_128c35bf3e0e394c": {
      "text": "To think even you couldn't dodge...",
      "status": "imported"
    },
    "voice_004:r_5213c17e13b23de0": {
      "text": "Can't counterattack, huh? Oh well.",
      "status": "imported"
    },
    "voice_004:r_38fdff9483e9245c": {
      "text": "I'll give up this time...",
      "status": "imported"
    },
    "voice_004:r_620fedec67706d7d": {
      "text": "To think I'd run out of energy.",
      "status": "imported"
    },
    "voice_004:r_9680dcd0fddcfcc7": {
      "text": "Heh. Are you afraid of me...?",
      "status": "imported"
    },
    "voice_004:r_2a00f1044ad5cbaa": {
      "text": "I hate persistent people.",
      "status": "imported"
    },
    "voice_004:r_3dbeead1bd3164ef": {
      "text": "You lack initiative...",
      "status": "imported"
    },
    "voice_004:r_98d15b8cc09bc915": {
      "text": "I won't land in some stupid crisis.",
      "status": "imported"
    },
    "voice_004:r_46e86d000250e137": {
      "text": "You're so frustrating.",
      "status": "imported"
    },
    "voice_004:r_ac341e7976e88f0b": {
      "text": "Heh. So reserved.",
      "status": "imported"
    },
    "voice_004:r_cdbd128a5b4127cc": {
      "text": "I don't like being chased around.",
      "status": "imported"
    },
    "voice_004:r_cfccaa1fbeda124c": {
      "text": "Pathetic.",
      "status": "imported"
    },
    "voice_004:r_b1f8ec192b9c083a": {
      "text": "Are you just playing around?",
      "status": "imported"
    },
    "voice_004:r_a007f9ab9cf048b3": {
      "text": "You've got a long way to go, boy.",
      "status": "imported"
    },
    "voice_004:r_ddafde4b065ced49": {
      "text": "No need to be disappointed...",
      "status": "imported"
    },
    "voice_004:r_de1213040856c089": {
      "text": "Hmm. What a boring attack.",
      "status": "imported"
    },
    "voice_004:r_3304412ac41f47a6": {
      "text": "What, you only managed to hit me?",
      "status": "imported"
    },
    "voice_004:r_0c0775e051211840": {
      "text": "I'd rather you didn't touch me.",
      "status": "imported"
    },
    "voice_004:r_a2afffe1c396f0b3": {
      "text": "You're terrible at making a move.",
      "status": "imported"
    },
    "voice_004:r_13c25fbdfddc8a24": {
      "text": "I can't say I'm impressed by this.",
      "status": "imported"
    },
    "voice_004:r_42ba1ecb310b4bd7": {
      "text": "Simply attacking won't be enough...",
      "status": "imported"
    },
    "voice_004:r_d692f1d420460a47": {
      "text": "Heh. You're pretty good.",
      "status": "imported"
    },
    "voice_004:r_a5643cec86b18bd2": {
      "text": "You're nimbler than you look.",
      "status": "imported"
    },
    "voice_004:r_68f2dfab20a4a30e": {
      "text": "That doesn't even count as pain.",
      "status": "imported"
    },
    "voice_004:r_9cedad8237480563": {
      "text": "Hmm. I'm a little impressed.",
      "status": "imported"
    },
    "voice_004:r_a03fabecba1508ca": {
      "text": "You're as mean as someone I know...",
      "status": "imported"
    },
    "voice_004:r_5391b24a71eb10ae": {
      "text": "Honestly... You're quite the worker.",
      "status": "imported"
    },
    "voice_004:r_a554ceef5c87b972": {
      "text": "No way to treat a lady, boy.",
      "status": "imported"
    },
    "voice_004:r_546c3d5937fbb7ee": {
      "text": "I'm amazed you got this far...",
      "status": "imported"
    },
    "voice_004:r_1568ff6298b12b96": {
      "text": "This should do... No, I'm uneasy.",
      "status": "imported"
    },
    "voice_004:r_2c9d94ba13c5fc50": {
      "text": "This may actually be bad...",
      "status": "imported"
    },
    "voice_004:r_a77f4913375098d2": {
      "text": "You're good at making people angry.",
      "status": "imported"
    },
    "voice_004:r_428c2116ac3071b1": {
      "text": "Old feelings are stirring again.",
      "status": "imported"
    },
    "voice_004:r_84c116267b79f540": {
      "text": "Well, living long has its rewards.",
      "status": "imported"
    },
    "voice_004:r_dad38ee29af2df3a": {
      "text": "The machine's at its limit...",
      "status": "imported"
    },
    "voice_004:r_3d32e86f8dc80909": {
      "text": "I'm ejecting. Handle the rest.",
      "status": "imported"
    },
    "voice_004:r_70451ffbabe2f876": {
      "text": "That greeting? No warmth or allure.",
      "status": "imported"
    },
    "voice_004:r_69dfa1659715e2fa": {
      "text": "Then I'll show you my trump card...",
      "status": "imported"
    },
    "voice_004:r_d996fd6d4ef5b329": {
      "text": "Master... Anything. Just come back!",
      "status": "imported"
    },
    "voice_004:r_8ab47a28f99ef565": {
      "text": "And that's roughly how it goes.",
      "status": "imported"
    },
    "voice_004:r_9072ea7bc71df136": {
      "text": "As expected of you...!",
      "status": "imported"
    },
    "voice_004:r_04e815a8d425827d": {
      "text": "Such tenacity...!",
      "status": "imported"
    },
    "voice_004:r_d89011fe3e5d082a": {
      "text": "You've irritated me a little...",
      "status": "imported"
    },
    "voice_004:r_3c5b0c2ac812d5de": {
      "text": "Stop that. You're making me angry.",
      "status": "imported"
    },
    "voice_004:r_5b9e8897190892eb": {
      "text": "Well. Aren't you endearing.",
      "status": "imported"
    },
    "voice_004:r_7bea3023abbf8a94": {
      "text": "Shall I praise you for doing well?",
      "status": "imported"
    },
    "voice_004:r_dd01a4c0d1b36a8d": {
      "text": "I'm sick and tired of that.",
      "status": "imported"
    },
    "voice_004:r_20920ad2eb3542db": {
      "text": "I'll get serious for the finale.",
      "status": "imported"
    },
    "voice_004:r_0ab7914877fd48ed": {
      "text": "I can't afford to lose this one.",
      "status": "imported"
    },
    "voice_004:r_e42b52c7a987b906": {
      "text": "Now I have a reason to fight.",
      "status": "imported"
    },
    "voice_004:r_6825fd1ff907bd22": {
      "text": "Awaken! Unseal the king's power!",
      "status": "imported"
    },
    "voice_004:r_607f666f1563bc0d": {
      "text": "Yes. You can leave it to me.",
      "status": "imported"
    },
    "voice_004:r_97b7431eeb81e6b6": {
      "text": "All right...",
      "status": "imported"
    },
    "voice_004:r_132f605d02975e71": {
      "text": "Understood.",
      "status": "imported"
    },
    "voice_004:r_9b9726b1872759d6": {
      "text": "Yes, I know.",
      "status": "imported"
    },
    "voice_004:r_1252db29683fefe0": {
      "text": "I can do at least that much.",
      "status": "imported"
    }
  }
}
