{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_121:r_479b340ccc6c572b": {
      "text": "Here we go! Buster Missile!!",
      "status": "imported"
    },
    "voice_121:r_ca4acbac57a2a35e": {
      "text": "Now feel\\nGunbuster's true power!!",
      "status": "imported"
    },
    "voice_121:r_77949221bf58f862": {
      "text": "I'm not backing down here!",
      "status": "imported"
    },
    "voice_121:r_70b9c4b9f1f37eff": {
      "text": "I won't let you go any further!",
      "status": "imported"
    },
    "voice_121:r_9fcb3754cb1773c7": {
      "text": "If that's your move, here's mine!",
      "status": "imported"
    },
    "voice_121:r_3559d2fad32c2435": {
      "text": "I'll never flinch!\\nRight, Coach?",
      "status": "imported"
    },
    "voice_121:r_f7570547e9f80a64": {
      "text": "Gunbuster's still here!",
      "status": "imported"
    },
    "voice_121:r_cbab0f4720e1fcf1": {
      "text": "I won't give up! I can still fight!",
      "status": "imported"
    },
    "voice_121:r_0bbe0b4f5364e732": {
      "text": "I can't let myself fall behind!",
      "status": "imported"
    },
    "voice_121:r_5dda5198137cb02a": {
      "text": "I can still go on!",
      "status": "imported"
    },
    "voice_121:r_83ec59afbecdec14": {
      "text": "You won't reach Earth! Never!",
      "status": "imported"
    },
    "voice_121:r_e20bfd42ad95a3c9": {
      "text": "Prepare, monster!\\nFace Gunbuster!",
      "status": "imported"
    },
    "voice_121:r_0f58a8822381e57f": {
      "text": "Hard to aim...!\\nIt's too fast...!",
      "status": "imported"
    },
    "voice_121:r_6dbcc507fb61b51d": {
      "text": "I promised!\\nBeat you and go home!!",
      "status": "imported"
    },
    "voice_121:r_b42ab697149a7c8a": {
      "text": "A miracle...\\nI'll make it happen!!",
      "status": "imported"
    },
    "voice_121:r_4de4fcf3b440baf4": {
      "text": "Not to you...\\nOur future is ours!",
      "status": "imported"
    },
    "voice_121:r_0121a166c715cdff": {
      "text": "I won't let you! Never!",
      "status": "imported"
    },
    "voice_121:r_30fad37a42bd3ad3": {
      "text": "Hold it right there!!",
      "status": "imported"
    },
    "voice_121:r_80a0b2a84e05d81a": {
      "text": "I'll protect it to the end!",
      "status": "imported"
    },
    "voice_121:r_4a9ac1dff86506d9": {
      "text": "Gunbuster can protect it!",
      "status": "imported"
    },
    "voice_121:r_bc8538e6af3d2577": {
      "text": "However many come,\\nI won't lose!",
      "status": "imported"
    },
    "voice_121:r_924516c8de2b5342": {
      "text": "I'm not the same\\nas I once was!",
      "status": "imported"
    },
    "voice_121:r_da1174533722333f": {
      "text": "Useless! It's useless!",
      "status": "imported"
    },
    "voice_121:r_fdeb8162976e72c1": {
      "text": "That won't\\nscratch Gunbuster!",
      "status": "imported"
    },
    "voice_121:r_0fadb5c26df92b42": {
      "text": "That didn't hurt!",
      "status": "imported"
    },
    "voice_121:r_6b15af9a0057cdc8": {
      "text": "Buster Alloy\\nwon't budge from that!",
      "status": "imported"
    },
    "voice_121:r_15b4a90140e8a33a": {
      "text": "Space monsters...!\\nThey picked me!?",
      "status": "imported"
    },
    "voice_121:r_af884a6b11dff121": {
      "text": "No space monster\\nwill defeat me!",
      "status": "imported"
    },
    "voice_121:r_ac6fe7838e95647b": {
      "text": "I won't let hope's flame go out!",
      "status": "imported"
    },
    "voice_121:r_77ca87eacd17ad52": {
      "text": "Watched the screen,\\nso I got hit...!",
      "status": "imported"
    },
    "voice_121:r_bf3244994760e535": {
      "text": "If I lose,\\nmy training is wasted!",
      "status": "imported"
    },
    "voice_121:r_aabfb21c9d069ce7": {
      "text": "Ghk! It's stronger than before!?",
      "status": "imported"
    },
    "voice_121:r_02479dc8fe989560": {
      "text": "Papa...! Please protect me...!!",
      "status": "imported"
    },
    "voice_121:r_a2df00f91a9b0a9e": {
      "text": "Ngh! We absolutely\\nhave to win!!",
      "status": "imported"
    },
    "voice_121:r_48b60d6c48b9b142": {
      "text": "S-Space monsters...!\\nNo easy prey!",
      "status": "imported"
    },
    "voice_121:r_8927e6fb681aa809": {
      "text": "I-If it comes to that, I'll ram it!",
      "status": "imported"
    },
    "voice_121:r_665f01666859013b": {
      "text": "Oh no...",
      "status": "imported"
    },
    "voice_121:r_a571eec59b258d11": {
      "text": "Buster Missile!!",
      "status": "imported"
    },
    "voice_121:r_ddbe581c5ea9183d": {
      "text": "Buster Tomahawk!!",
      "status": "imported"
    },
    "voice_121:r_faae935cca0edc72": {
      "text": "I won't let you escape again!",
      "status": "imported"
    },
    "voice_121:r_d4430bf362340b32": {
      "text": "Buster Beeeeeam!!",
      "status": "imported"
    },
    "voice_121:r_6ff1323b355593e0": {
      "text": "Sis... Coach... I'm sorry.",
      "status": "imported"
    },
    "voice_121:r_b7b5625d7cd4282f": {
      "text": "Not yet! I'll still pull through!!",
      "status": "imported"
    },
    "voice_121:r_36133ad73a73ef98": {
      "text": "Not, not like this!\\nI won't lose!!",
      "status": "imported"
    },
    "voice_121:r_920740a0219c5085": {
      "text": "Please, hold on, Gunbuster!!",
      "status": "imported"
    },
    "voice_121:r_a8451712c57c1a72": {
      "text": "Agh!! I-I'm not done yet!!",
      "status": "imported"
    },
    "voice_121:r_3633df5b7b8f47fa": {
      "text": "It hurt!! But we\\ncan't lose!",
      "status": "imported"
    },
    "voice_121:r_52dfc56b14b93551": {
      "text": "No! Gunbuster\\nwon't fall to that!!",
      "status": "imported"
    },
    "voice_121:r_1b9b2aab5cb104da": {
      "text": "Not yet! This is nothing!!",
      "status": "imported"
    },
    "voice_121:r_342044c706a2340f": {
      "text": "Ngh! You're good... but!!",
      "status": "imported"
    },
    "voice_121:r_cf41e8828a90cbdb": {
      "text": "Coach's Gunbuster.\\nDon't dismiss it.",
      "status": "imported"
    },
    "voice_121:r_719e897304ec42d4": {
      "text": "That weak attack won't hurt me!!",
      "status": "imported"
    },
    "voice_121:r_d5e0a2317c40d322": {
      "text": "This is nothing!!",
      "status": "imported"
    },
    "voice_121:r_ec2ea17765052401": {
      "text": "Like that could hit me!!",
      "status": "imported"
    },
    "voice_121:r_f2d4255f1c2f7542": {
      "text": "Too easy!!",
      "status": "imported"
    },
    "voice_121:r_5d08ad19e2da125b": {
      "text": "Too slow!",
      "status": "imported"
    },
    "voice_121:r_a7246b52782a877e": {
      "text": "I'll dodge it!!",
      "status": "imported"
    },
    "voice_121:r_dc8701f6bcb9904f": {
      "text": "You think that\\ncan beat us?!",
      "status": "imported"
    },
    "voice_121:r_d6bdd730f24f66eb": {
      "text": "Even Gunbuster...\\ncan't reach it!?",
      "status": "imported"
    },
    "voice_121:r_41997412868c48c4": {
      "text": "Oh no...!\\nI need resupply to fight!",
      "status": "imported"
    },
    "voice_121:r_eb7ae28b53dc033c": {
      "text": "I'll finish this now!!",
      "status": "imported"
    },
    "voice_121:r_857c4a52ce8df0fd": {
      "text": "Here's my chance!!",
      "status": "imported"
    },
    "voice_121:r_55417493fce1d347": {
      "text": "I'll never, ever forgive you!",
      "status": "imported"
    },
    "voice_121:r_128c35bf3e0e394c": {
      "text": "Buster Collider!!",
      "status": "imported"
    },
    "voice_121:r_5213c17e13b23de0": {
      "text": "Aaaaaagh!!",
      "status": "imported"
    },
    "voice_121:r_38fdff9483e9245c": {
      "text": "I'll fight for Sis too...!",
      "status": "imported"
    },
    "voice_121:r_620fedec67706d7d": {
      "text": "Feel, think,\\nlet your heart decide!",
      "status": "imported"
    },
    "voice_121:r_9680dcd0fddcfcc7": {
      "text": "See, think...\\nthen your body acts!",
      "status": "imported"
    },
    "voice_121:r_2a00f1044ad5cbaa": {
      "text": "It's okay...! You can do it, Noriko!",
      "status": "imported"
    },
    "voice_121:r_3dbeead1bd3164ef": {
      "text": "Lend me your power, Gunbuster!",
      "status": "imported"
    },
    "voice_121:r_98d15b8cc09bc915": {
      "text": "I'm Gunbuster's pilot.\\nI'll do it!",
      "status": "imported"
    },
    "voice_121:r_46e86d000250e137": {
      "text": "All right, I'll give it a try!",
      "status": "imported"
    },
    "voice_121:r_ac341e7976e88f0b": {
      "text": "This is a fight I can't lose...!",
      "status": "imported"
    },
    "voice_121:r_cdbd128a5b4127cc": {
      "text": "Time to show off my training!",
      "status": "imported"
    },
    "voice_121:r_cfccaa1fbeda124c": {
      "text": "Gunbuster, here we go!",
      "status": "imported"
    },
    "voice_121:r_b1f8ec192b9c083a": {
      "text": "Space belongs to all.\\nI'll guard it!",
      "status": "imported"
    },
    "voice_121:r_a007f9ab9cf048b3": {
      "text": "I'm not stopping yet!",
      "status": "imported"
    },
    "voice_121:r_ddafde4b065ced49": {
      "text": "This time, I'll finish it!",
      "status": "imported"
    },
    "voice_121:r_de1213040856c089": {
      "text": "Another chance! Once more!",
      "status": "imported"
    },
    "voice_121:r_3304412ac41f47a6": {
      "text": "We have to stop the space monsters!",
      "status": "imported"
    },
    "voice_121:r_0c0775e051211840": {
      "text": "Gunbuster's here\\nto crush monsters!",
      "status": "imported"
    },
    "voice_121:r_a2afffe1c396f0b3": {
      "text": "With Gunbuster,\\nno beast runs free!",
      "status": "imported"
    },
    "voice_121:r_13c25fbdfddc8a24": {
      "text": "Focus fire and destroy the core!",
      "status": "imported"
    },
    "voice_121:r_42ba1ecb310b4bd7": {
      "text": "Need a way\\nto break the A.T. Field!",
      "status": "imported"
    },
    "voice_121:r_d692f1d420460a47": {
      "text": "I won't let humanity be destroyed!",
      "status": "imported"
    },
    "voice_121:r_a5643cec86b18bd2": {
      "text": "That's far enough, Fifteen-Face!",
      "status": "imported"
    },
    "voice_121:r_68f2dfab20a4a30e": {
      "text": "We never give up!\\nWe never despair!",
      "status": "imported"
    },
    "voice_121:r_9cedad8237480563": {
      "text": "EVA fight...\\nRepairs concern me!",
      "status": "imported"
    },
    "voice_121:r_a03fabecba1508ca": {
      "text": "Neither of us will hold back!",
      "status": "imported"
    },
    "voice_121:r_5391b24a71eb10ae": {
      "text": "No berserk mode in a drill... right?",
      "status": "imported"
    },
    "voice_121:r_a554ceef5c87b972": {
      "text": "Here I come, Shinji!",
      "status": "imported"
    },
    "voice_121:r_546c3d5937fbb7ee": {
      "text": "Asuka! I'm going all out!",
      "status": "imported"
    },
    "voice_121:r_1568ff6298b12b96": {
      "text": "I'll take you down a peg, Asuka!",
      "status": "imported"
    },
    "voice_121:r_2c9d94ba13c5fc50": {
      "text": "You're calm, even in battle...!",
      "status": "imported"
    },
    "voice_121:r_a77f4913375098d2": {
      "text": "I'm coming at you for real, Rei!",
      "status": "imported"
    },
    "voice_121:r_428c2116ac3071b1": {
      "text": "I won't lose to a heartless robot!",
      "status": "imported"
    },
    "voice_121:r_84c116267b79f540": {
      "text": "My effort and guts beat machines!",
      "status": "imported"
    },
    "voice_121:r_dad38ee29af2df3a": {
      "text": "Why are humans fighting each other?!",
      "status": "imported"
    },
    "voice_121:r_3d32e86f8dc80909": {
      "text": "Come at me,\\nand I'll give it my all!",
      "status": "imported"
    },
    "voice_121:r_70451ffbabe2f876": {
      "text": "There you are, invader of Earth!",
      "status": "imported"
    },
    "voice_121:r_69dfa1659715e2fa": {
      "text": "Don't underestimate Earthlings!",
      "status": "imported"
    },
    "voice_121:r_d996fd6d4ef5b329": {
      "text": "For a monster, a finishing move!",
      "status": "imported"
    },
    "voice_121:r_8ab47a28f99ef565": {
      "text": "Noriko Takaya,\\nmonster duty calls!",
      "status": "imported"
    },
    "voice_121:r_546de3fb6db156ea": {
      "text": "Vicious monster!\\nFace Gunbuster!",
      "status": "imported"
    },
    "voice_121:r_ca85f87cee5e31f7": {
      "text": "Space has enemies like these too...!",
      "status": "imported"
    },
    "voice_121:r_9072ea7bc71df136": {
      "text": "I'll drive you off with Nagoya Shot!",
      "status": "imported"
    },
    "voice_121:r_04e815a8d425827d": {
      "text": "Gundam vs. Gunbuster.\\nGuns blazing!",
      "status": "imported"
    },
    "voice_121:r_d89011fe3e5d082a": {
      "text": "To meet a Gundam like this...!",
      "status": "imported"
    },
    "voice_121:r_3c5b0c2ac812d5de": {
      "text": "Give back the girl you abducted!",
      "status": "imported"
    },
    "voice_121:r_5b9e8897190892eb": {
      "text": "I'll stop you before it's too late!",
      "status": "imported"
    },
    "voice_121:r_7bea3023abbf8a94": {
      "text": "Red Comet! I'll take you on!",
      "status": "imported"
    },
    "voice_121:r_dd01a4c0d1b36a8d": {
      "text": "No mercy for an evil Super Robot!",
      "status": "imported"
    },
    "voice_121:r_20920ad2eb3542db": {
      "text": "Gunbuster can fight you as an equal!",
      "status": "imported"
    },
    "voice_121:r_0ab7914877fd48ed": {
      "text": "Speed won't deny me my chance!",
      "status": "imported"
    },
    "voice_121:r_cb846feec748c2e3": {
      "text": "I'll win before you get close!",
      "status": "imported"
    },
    "voice_121:r_c958860b0676b1f5": {
      "text": "Target: enemy warship! No escape!",
      "status": "imported"
    },
    "voice_121:r_5e2669b82ef75ce3": {
      "text": "Concentrate all fire on their ship!",
      "status": "imported"
    },
    "voice_121:r_7847e0ed7dc9282d": {
      "text": "We'll decide our world's future!",
      "status": "imported"
    },
    "voice_121:r_e42b52c7a987b906": {
      "text": "Your ideal\\nbrings others misery!",
      "status": "imported"
    },
    "voice_121:r_6825fd1ff907bd22": {
      "text": "Earth and us!\\nGunbuster's mission!",
      "status": "imported"
    },
    "voice_121:r_607f666f1563bc0d": {
      "text": "I'll crush all enemies of peace!",
      "status": "imported"
    },
    "voice_121:r_97b7431eeb81e6b6": {
      "text": "This is the only way right now!",
      "status": "imported"
    },
    "voice_121:r_132f605d02975e71": {
      "text": "I'm sorry! Please bear with this!",
      "status": "imported"
    },
    "voice_121:r_9b9726b1872759d6": {
      "text": "You toyed with hearts.\\nUnforgivable!",
      "status": "imported"
    },
    "voice_121:r_1252db29683fefe0": {
      "text": "Brace yourself!\\nI'm truly furious!",
      "status": "imported"
    },
    "voice_121:r_63f429c5c68c0863": {
      "text": "I'll hit you at full power!",
      "status": "imported"
    },
    "voice_121:r_38e4a434c91d8ef0": {
      "text": "Lightning Kick!!",
      "status": "imported"
    },
    "voice_121:r_98ed411352a3a6ac": {
      "text": "With Gunbuster's power!",
      "status": "imported"
    },
    "voice_121:r_4824bea6bab3af67": {
      "text": "Finisher! Lightning Kick!!",
      "status": "imported"
    },
    "voice_121:r_862b92e63adb9734": {
      "text": "Now I'm coming at you!",
      "status": "imported"
    },
    "voice_121:r_cb306ef55e49d107": {
      "text": "Now take this attack!",
      "status": "imported"
    },
    "voice_121:r_57b2bd2de8a1408d": {
      "text": "Think you'll have your way? Wrong!",
      "status": "imported"
    },
    "voice_121:r_76f080a4881e8ab5": {
      "text": "Here's my counterattack chance!",
      "status": "imported"
    },
    "voice_121:r_288133bc5b573dae": {
      "text": "I absolutely won't let you escape!",
      "status": "imported"
    },
    "voice_121:r_6f95653e548f8fcf": {
      "text": "Going second,\\nI can turn it around!",
      "status": "imported"
    },
    "voice_121:r_d249d68bada91ab9": {
      "text": "Melee is an Oki Girls' tradition!",
      "status": "imported"
    },
    "voice_121:r_03cdac73042343ee": {
      "text": "I'll close the distance at once!",
      "status": "imported"
    },
    "voice_121:r_96bb0dcde0c8c44a": {
      "text": "Rooooooooar!!",
      "status": "imported"
    },
    "voice_121:r_a0f2074af8debbfa": {
      "text": "Goooooooo!!",
      "status": "imported"
    },
    "voice_121:r_b5f5a97ed82acb0b": {
      "text": "Take careful aiiim...!",
      "status": "imported"
    },
    "voice_121:r_99e6349431aaf23b": {
      "text": "At long range, use this!",
      "status": "imported"
    },
    "voice_121:r_2c5b7ee872c1ed7f": {
      "text": "No matter how far away you are!",
      "status": "imported"
    },
    "voice_121:r_eb5f687fcd372ae7": {
      "text": "You're open after that, Shinji!",
      "status": "imported"
    },
    "voice_121:r_2329428a6871d9fa": {
      "text": "Here's some payback, Asuka!",
      "status": "imported"
    },
    "voice_121:r_0e7466971bec4cc4": {
      "text": "Before Unit-00 can defend!",
      "status": "imported"
    },
    "voice_121:r_efa71f7a4cc33ff3": {
      "text": "This timing will work!",
      "status": "imported"
    },
    "voice_121:r_3fc2e1186557e7a0": {
      "text": "It isn't over yet!",
      "status": "imported"
    },
    "voice_121:r_fa6930340a545054": {
      "text": "I won't lose to Simon's spirit!",
      "status": "imported"
    },
    "voice_121:r_2332b9d56461d7ab": {
      "text": "Switch, Shinji!",
      "status": "imported"
    },
    "voice_121:r_854aa0a91a3c80d1": {
      "text": "I'll back up the EVA!",
      "status": "imported"
    },
    "voice_121:r_0bc8ae32a406ceab": {
      "text": "Getter's leader!\\nI must learn too!",
      "status": "imported"
    },
    "voice_121:r_82c09f011d703b2c": {
      "text": "I'll follow the Getter Team!",
      "status": "imported"
    },
    "voice_121:r_2b4d8818c77b6dca": {
      "text": "Gunbuster, bear with it a little!",
      "status": "imported"
    },
    "voice_121:r_087354f2db0a31e6": {
      "text": "Gunbuster's power protects everyone!",
      "status": "imported"
    },
    "voice_121:r_db02a2dec93dd263": {
      "text": "Don't be reckless, Simon!",
      "status": "imported"
    },
    "voice_121:r_d520c6d5298a848d": {
      "text": "Shinji!\\nHide behind Gunbuster!",
      "status": "imported"
    },
    "voice_121:r_099e2458cabf796f": {
      "text": "I won't let the EVA go down!",
      "status": "imported"
    },
    "voice_121:r_fd910d714be70870": {
      "text": "Ryoma!\\nGunbuster will shield you!",
      "status": "imported"
    },
    "voice_121:r_9736f29b11344ec3": {
      "text": "Gunbuster, protect Getter!",
      "status": "imported"
    },
    "voice_121:r_fcd05582aa5c6068": {
      "text": "I can't counterattack...!",
      "status": "imported"
    },
    "voice_121:r_bece29562818acba": {
      "text": "At this rate, they'll get me soon!",
      "status": "imported"
    },
    "voice_121:r_494b5da92ed24ecb": {
      "text": "Oh no...! They got in my blind spot!",
      "status": "imported"
    },
    "voice_121:r_a4a5a96f4bd58920": {
      "text": "No! I can't counter from here!",
      "status": "imported"
    },
    "voice_121:r_b57d2d74233f889a": {
      "text": "I'm right here!",
      "status": "imported"
    },
    "voice_121:r_cd06d0820d82524b": {
      "text": "I can handle this much too!",
      "status": "imported"
    },
    "voice_121:r_c94c6d04be583774": {
      "text": "I'll protect Gunbuster!",
      "status": "imported"
    },
    "voice_121:r_e54e2c99ef8297af": {
      "text": "Let their attack come in close...!",
      "status": "imported"
    },
    "voice_121:r_f16a3eb0bcaac082": {
      "text": "Don't doubt Gunbuster's\\nmobility!",
      "status": "imported"
    },
    "voice_121:r_10a408809e512df1": {
      "text": "I already predicted that attack!",
      "status": "imported"
    },
    "voice_121:r_bc7b9e308b879dd4": {
      "text": "Drill or not,\\nno needless hits!",
      "status": "imported"
    },
    "voice_121:r_98902fd3143c393e": {
      "text": "Gunbuster can\\nkeep up with an EVA!",
      "status": "imported"
    },
    "voice_121:r_d907fbd7bc1c4298": {
      "text": "Yes! I can track the space monsters!",
      "status": "imported"
    },
    "voice_121:r_96b21e3a028dd074": {
      "text": "Barrier, deploy!",
      "status": "imported"
    },
    "voice_121:r_ce140b5d8e6b7310": {
      "text": "That can't break my barrier!",
      "status": "imported"
    },
    "voice_121:r_0e0335789c5396d7": {
      "text": "Inertial Canceller!\\nDeflect it!",
      "status": "imported"
    },
    "voice_121:r_a8e85bd950696403": {
      "text": "Inertial Canceller, full power!",
      "status": "imported"
    },
    "voice_121:r_772c8bc40ab6cb61": {
      "text": "I have to avoid a direct hit...!",
      "status": "imported"
    },
    "voice_121:r_58dd2826a199ef51": {
      "text": "Take the hit, Gunbuster!",
      "status": "imported"
    },
    "voice_121:r_aadc0b2442adb93b": {
      "text": "I'll beat this damage with guts!",
      "status": "imported"
    },
    "voice_121:r_e7a8cd8ed5bc2d1b": {
      "text": "Gunbuster and I\\nfear no pain!",
      "status": "imported"
    },
    "voice_121:r_041dd920da4a7c17": {
      "text": "I'll focus on attacking now!",
      "status": "imported"
    },
    "voice_121:r_c7f4280cde4605b3": {
      "text": "I...! I'm not afraid to be hurt!",
      "status": "imported"
    },
    "voice_121:r_ec349c8ea9511a18": {
      "text": "I see its moves...!\\nNow just react!",
      "status": "imported"
    },
    "voice_121:r_33236ffa3ea95b68": {
      "text": "You're no match for Gunbuster!",
      "status": "imported"
    },
    "voice_121:r_689d0b123de71ae0": {
      "text": "Again! You lack effort and guts!",
      "status": "imported"
    },
    "voice_121:r_84883aa95f63ce32": {
      "text": "Train for real,\\nor it means nothing!",
      "status": "imported"
    },
    "voice_121:r_25493e978ce8ff16": {
      "text": "Shinji!\\nCome at me at full power!",
      "status": "imported"
    },
    "voice_121:r_7316666150e42960": {
      "text": "Asuka! Where's your usual big talk?",
      "status": "imported"
    },
    "voice_121:r_c4f11aa93dc5b668": {
      "text": "Rei's hit\\nwas surely no fluke...!",
      "status": "imported"
    },
    "voice_121:r_ce1a22dfe3a4d339": {
      "text": "Gunbuster won't\\nfall to monsters!",
      "status": "imported"
    },
    "voice_121:r_240651adab81e145": {
      "text": "Sis entrusted Gunbuster to me...!",
      "status": "imported"
    },
    "voice_121:r_cff0deaae73c2858": {
      "text": "Hold on, Gunbuster!",
      "status": "imported"
    },
    "voice_121:r_dca67f68a573fab7": {
      "text": "I'll turn this around from here!",
      "status": "imported"
    },
    "voice_121:r_a6630215fefaf294": {
      "text": "I can't react to their speed!?",
      "status": "imported"
    },
    "voice_121:r_6f94566ad37f8ff8": {
      "text": "That's more damage than I thought...",
      "status": "imported"
    },
    "voice_121:r_942ca03c9de80143": {
      "text": "The enemy's keeping up with us...!",
      "status": "imported"
    },
    "voice_121:r_d8c669c70659e18a": {
      "text": "Not yet! The fight starts now!",
      "status": "imported"
    },
    "voice_121:r_8f5bade7ac2db78e": {
      "text": "This won't faze\\nGunbuster or me!",
      "status": "imported"
    },
    "voice_121:r_05ea490d2f522520": {
      "text": "What Coach taught\\nwon't break here!",
      "status": "imported"
    },
    "voice_121:r_f5658c702d91db7a": {
      "text": "Gunbuster\\nhas far more than this!",
      "status": "imported"
    },
    "voice_121:r_686df329b50f195b": {
      "text": "That's it!\\nKeep it coming!",
      "status": "imported"
    },
    "voice_121:r_25f0ab0fa3cf690c": {
      "text": "A decisive weapon! Name well earned!",
      "status": "imported"
    },
    "voice_121:r_b708a1d959013dbf": {
      "text": "This is bad. We're losing ground...!",
      "status": "imported"
    },
    "voice_121:r_59fca03e929366c1": {
      "text": "Shinji and Unit-01's power...!",
      "status": "imported"
    },
    "voice_121:r_0d65eb631dcb7514": {
      "text": "Nice, Asuka!\\nYou're not all talk!",
      "status": "imported"
    },
    "voice_121:r_d03018a31e23f1e9": {
      "text": "Rei's attacks are hard to read!",
      "status": "imported"
    },
    "voice_121:r_279da5f732aa8847": {
      "text": "Beasts...!\\nGunbuster still fights!",
      "status": "imported"
    },
    "voice_121:r_97f82e3cb6f70110": {
      "text": "Not yet, beast!\\nGunbuster won't die!",
      "status": "imported"
    },
    "voice_121:r_66236eb99b676e5b": {
      "text": "If I stop,\\nI'll never see Sis again!",
      "status": "imported"
    },
    "voice_121:r_9639a2dbcd2f58ed": {
      "text": "Until I see Sis,\\nI guard Gunbuster!",
      "status": "imported"
    },
    "voice_121:r_aeea0893acb93d35": {
      "text": "I won't scream! Never!!",
      "status": "imported"
    },
    "voice_121:r_b31568654e53487b": {
      "text": "Trade flesh for bone!\\nNow we fight!",
      "status": "imported"
    },
    "voice_121:r_2502132569141ea3": {
      "text": "I never expected\\na flawless victory!",
      "status": "imported"
    },
    "voice_121:r_1ff312798a52c8eb": {
      "text": "Never give up!\\nCoach taught me that!",
      "status": "imported"
    },
    "voice_121:r_fa07d90fca62f593": {
      "text": "Super Robots\\nmake comebacks!",
      "status": "imported"
    },
    "voice_121:r_a25bf2676ecf9d83": {
      "text": "I can't lose!\\nGunbuster is our hope!",
      "status": "imported"
    },
    "voice_121:r_237a0288b42dce20": {
      "text": "I stake my life on Gunbuster!",
      "status": "imported"
    },
    "voice_121:r_0556e8a22779ea8e": {
      "text": "Hope lives!\\nGunbuster still fights!",
      "status": "imported"
    },
    "voice_121:r_09d377101a48d92a": {
      "text": "I'm sorry, Coach, Sis...!",
      "status": "imported"
    },
    "voice_121:r_11517cc7b0494dbf": {
      "text": "Gunbuster... beaten...!?",
      "status": "imported"
    },
    "voice_121:r_b5864501463db244": {
      "text": "Ghk! Gunbuster's going down...!",
      "status": "imported"
    },
    "voice_121:r_a88939ea84b4474d": {
      "text": "They got me...! I lose!",
      "status": "imported"
    },
    "voice_121:r_a870d0cf7cc11ec6": {
      "text": "Yes! Don't forget this feeling!",
      "status": "imported"
    },
    "voice_121:r_03f6158ef83964f3": {
      "text": "Another scramble for Earth's future!",
      "status": "imported"
    },
    "voice_121:r_2970a83693cdcc25": {
      "text": "Foes! Really, really, all may fall!",
      "status": "imported"
    },
    "voice_121:r_be661448b85d0009": {
      "text": "Player, help us win Earth's future!",
      "status": "imported"
    },
    "voice_121:r_958a56c1151cab9e": {
      "text": "Next: SRW Z3 - Song of a Far Galaxy!",
      "status": "imported"
    },
    "voice_121:r_8b18aa4cc69547df": {
      "text": "Lightning Kick, together with you!",
      "status": "imported"
    },
    "voice_121:r_3e87f6fc3ea65aef": {
      "text": "SRW Z3! Strategy Class!",
      "status": "imported"
    },
    "voice_121:r_5508a7bfa9074eb9": {
      "text": "Takaya solo! I've grown, Coach, Sis!",
      "status": "imported"
    },
    "voice_121:r_09a003e91f0d5dc7": {
      "text": "Ahem. Downing a foe adds one kill.",
      "status": "imported"
    },
    "voice_121:r_192447448ebd7bb5": {
      "text": "Top Ace: most kills, bonus Focus!",
      "status": "imported"
    },
    "voice_121:r_e92920ba4b301b9f": {
      "text": "Top Ace, our star! Root for my rise!",
      "status": "imported"
    },
    "voice_121:r_207b256d613bb896": {
      "text": "Once your kill count passes 80...",
      "status": "imported"
    },
    "voice_121:r_a6fd676d8146501b": {
      "text": "Ace: Focus, cash, and Ace Bonus!",
      "status": "imported"
    },
    "voice_121:r_94d35e5fa8e3a198": {
      "text": "Find each bonus! Wait, what's mine?",
      "status": "imported"
    },
    "voice_121:r_b686510e636673f3": {
      "text": "No! Miracles happen! I'll make one!",
      "status": "imported"
    },
    "voice_121:r_59369bad143d4272": {
      "text": "I'll go on ahead!",
      "status": "imported"
    },
    "voice_121:r_25f9b1e39dd8d366": {
      "text": "I'll suppress them with Gunbuster!",
      "status": "imported"
    },
    "voice_121:r_307477bedd148060": {
      "text": "I'll draw the enemy away!",
      "status": "imported"
    },
    "voice_121:r_09a780acca0eb4b0": {
      "text": "Let's combine our two machines!",
      "status": "imported"
    },
    "voice_121:r_af62f2ee466b5c8c": {
      "text": "We'll split up and attack!",
      "status": "imported"
    },
    "voice_121:r_20cfb719db02fafd": {
      "text": "We're commencing combat too!",
      "status": "imported"
    },
    "voice_121:r_570c1fdf72edb283": {
      "text": "Your opponent is Gunbuster!",
      "status": "imported"
    },
    "voice_121:r_23f0d87a5a6cfca1": {
      "text": "One on one, fair and square!",
      "status": "imported"
    }
  }
}
