{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_003:r_479b340ccc6c572b": {
      "text": "Gotcha!",
      "status": "imported"
    },
    "voice_003:r_77949221bf58f862": {
      "text": "Heh, you've fallen for my trap!",
      "status": "imported"
    },
    "voice_003:r_70b9c4b9f1f37eff": {
      "text": "You're an eyesore!",
      "status": "imported"
    },
    "voice_003:r_9fcb3754cb1773c7": {
      "text": "Go to hell!",
      "status": "imported"
    },
    "voice_003:r_3559d2fad32c2435": {
      "text": "We're nothing but dogs of war...!",
      "status": "imported"
    },
    "voice_003:r_f7570547e9f80a64": {
      "text": "Now this is my kind of battlefield!",
      "status": "imported"
    },
    "voice_003:r_cbab0f4720e1fcf1": {
      "text": "Drop dead!",
      "status": "imported"
    },
    "voice_003:r_0bbe0b4f5364e732": {
      "text": "That's no ordinary AT pilot...!",
      "status": "imported"
    },
    "voice_003:r_5dda5198137cb02a": {
      "text": "That's perfect prey for an AT!",
      "status": "imported"
    },
    "voice_003:r_83ec59afbecdec14": {
      "text": "I'll pierce that thick armor!",
      "status": "imported"
    },
    "voice_003:r_e20bfd42ad95a3c9": {
      "text": "Heh, you're an easy target!",
      "status": "imported"
    },
    "voice_003:r_0f58a8822381e57f": {
      "text": "Hmph, now that's one big target!",
      "status": "imported"
    },
    "voice_003:r_6dbcc507fb61b51d": {
      "text": "I'm fighting the famous Gundam!",
      "status": "imported"
    },
    "voice_003:r_b42ab697149a7c8a": {
      "text": "This kill will make me famous!",
      "status": "imported"
    },
    "voice_003:r_4de4fcf3b440baf4": {
      "text": "I can turn on a dime too!",
      "status": "imported"
    },
    "voice_003:r_0121a166c715cdff": {
      "text": "That's one flimsy-looking machine!",
      "status": "imported"
    },
    "voice_003:r_80a0b2a84e05d81a": {
      "text": "Quit flitting around up there!",
      "status": "imported"
    },
    "voice_003:r_4a9ac1dff86506d9": {
      "text": "If I hit the weak spot!",
      "status": "imported"
    },
    "voice_003:r_bc8538e6af3d2577": {
      "text": "I won't let you transform!",
      "status": "imported"
    },
    "voice_003:r_da1174533722333f": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_003:r_9e0c80ac7e33b459": {
      "text": "You're not getting away!",
      "status": "imported"
    },
    "voice_003:r_7432ef43ed3471dc": {
      "text": "Don't expect to make it home alive!",
      "status": "imported"
    },
    "voice_003:r_065443f6ddfcf0d7": {
      "text": "Now I'm coming for you!",
      "status": "imported"
    },
    "voice_003:r_47d52a2839c71715": {
      "text": "My turn!",
      "status": "imported"
    },
    "voice_003:r_847f82e7f3eef651": {
      "text": "Time to start over!",
      "status": "imported"
    },
    "voice_003:r_eb7ae28b53dc033c": {
      "text": "Couldn't get away, huh!",
      "status": "imported"
    },
    "voice_003:r_857c4a52ce8df0fd": {
      "text": "This fight isn't over yet!",
      "status": "imported"
    },
    "voice_003:r_55417493fce1d347": {
      "text": "Heh, left yourself open!",
      "status": "imported"
    },
    "voice_003:r_8fdf5910927c9591": {
      "text": "Take this one too!",
      "status": "imported"
    },
    "voice_003:r_7d724dbcc4451e10": {
      "text": "Still hanging around there!",
      "status": "imported"
    },
    "voice_003:r_93e25418a203cb8f": {
      "text": "That one's mine!",
      "status": "imported"
    },
    "voice_003:r_adeb0a29274d3d9b": {
      "text": "I won't miss my chance!",
      "status": "imported"
    },
    "voice_003:r_24cf161287ef9d5c": {
      "text": "I screwed up!!",
      "status": "imported"
    },
    "voice_003:r_8f60f6fc86db3107": {
      "text": "Uwoooaaah!!",
      "status": "imported"
    },
    "voice_003:r_b1de76a75a253c13": {
      "text": "So this is it!",
      "status": "imported"
    },
    "voice_003:r_128c35bf3e0e394c": {
      "text": "I-I'm done for!!",
      "status": "imported"
    },
    "voice_003:r_5213c17e13b23de0": {
      "text": "D-damn it!!",
      "status": "imported"
    },
    "voice_003:r_38fdff9483e9245c": {
      "text": "Damn it, I can't take any more!",
      "status": "imported"
    },
    "voice_003:r_620fedec67706d7d": {
      "text": "Tch! My gauges are dying on me!",
      "status": "imported"
    },
    "voice_003:r_9680dcd0fddcfcc7": {
      "text": "Damn it!\\nMission Disc's burned out!",
      "status": "imported"
    },
    "voice_003:r_2a00f1044ad5cbaa": {
      "text": "This is bad! No hydraulic pressure!",
      "status": "imported"
    },
    "voice_003:r_3dbeead1bd3164ef": {
      "text": "I-I can see the Grim Reaper...!",
      "status": "imported"
    },
    "voice_003:r_98d15b8cc09bc915": {
      "text": "No hydraulics...! I can't go on!",
      "status": "imported"
    },
    "voice_003:r_46e86d000250e137": {
      "text": "No good!\\nMission Disc's burned out!",
      "status": "imported"
    },
    "voice_003:r_ac341e7976e88f0b": {
      "text": "B-Barely hanging on by a thread!",
      "status": "imported"
    },
    "voice_003:r_cdbd128a5b4127cc": {
      "text": "D-Damn you, Gundam!",
      "status": "imported"
    },
    "voice_003:r_cfccaa1fbeda124c": {
      "text": "You'll pay for that, Gundam!",
      "status": "imported"
    },
    "voice_003:r_b1f8ec192b9c083a": {
      "text": "T-Too fast! I can't see it move!",
      "status": "imported"
    },
    "voice_003:r_ddafde4b065ced49": {
      "text": "How can that thing move like that!?",
      "status": "imported"
    },
    "voice_003:r_3304412ac41f47a6": {
      "text": "A-At this rate, it'll crush me!",
      "status": "imported"
    },
    "voice_003:r_0c0775e051211840": {
      "text": "Damn, it's just too much bigger...!",
      "status": "imported"
    },
    "voice_003:r_a2afffe1c396f0b3": {
      "text": "That hit me dead-on!",
      "status": "imported"
    },
    "voice_003:r_13c25fbdfddc8a24": {
      "text": "Now this is getting interesting!",
      "status": "imported"
    },
    "voice_003:r_42ba1ecb310b4bd7": {
      "text": "Tch! They're no amateur either!",
      "status": "imported"
    },
    "voice_003:r_d692f1d420460a47": {
      "text": "Respond, you slow piece of junk!",
      "status": "imported"
    },
    "voice_003:r_a5643cec86b18bd2": {
      "text": "I won't go down that easily!",
      "status": "imported"
    },
    "voice_003:r_68f2dfab20a4a30e": {
      "text": "Damn! The camera's been hit!",
      "status": "imported"
    },
    "voice_003:r_9cedad8237480563": {
      "text": "Gah! You're damn good!",
      "status": "imported"
    },
    "voice_003:r_a03fabecba1508ca": {
      "text": "Heh, how very kind of you!",
      "status": "imported"
    },
    "voice_003:r_5391b24a71eb10ae": {
      "text": "Hmph, that only grazed me!",
      "status": "imported"
    },
    "voice_003:r_a554ceef5c87b972": {
      "text": "You'll have to try a bit harder!",
      "status": "imported"
    },
    "voice_003:r_546c3d5937fbb7ee": {
      "text": "Come at me with all you've got!",
      "status": "imported"
    },
    "voice_003:r_1568ff6298b12b96": {
      "text": "That won't be enough to kill me!",
      "status": "imported"
    },
    "voice_003:r_2c9d94ba13c5fc50": {
      "text": "Ha! Who cares if it's a Gundam!",
      "status": "imported"
    },
    "voice_003:r_a77f4913375098d2": {
      "text": "Not as good as they say, Gundam!",
      "status": "imported"
    },
    "voice_003:r_428c2116ac3071b1": {
      "text": "Tch! Quit darting around up there!",
      "status": "imported"
    },
    "voice_003:r_84c116267b79f540": {
      "text": "I can't let them pin me down!",
      "status": "imported"
    },
    "voice_003:r_dad38ee29af2df3a": {
      "text": "All that bulk, and such a weak hit!",
      "status": "imported"
    },
    "voice_003:r_3d32e86f8dc80909": {
      "text": "All you've got is size, bastard!",
      "status": "imported"
    },
    "voice_003:r_70451ffbabe2f876": {
      "text": "Damn amateur!",
      "status": "imported"
    },
    "voice_003:r_69dfa1659715e2fa": {
      "text": "What the hell are you aiming at!",
      "status": "imported"
    },
    "voice_003:r_d996fd6d4ef5b329": {
      "text": "Ha! What the hell was that!?",
      "status": "imported"
    },
    "voice_003:r_8ab47a28f99ef565": {
      "text": "Don't take me lightly!",
      "status": "imported"
    },
    "voice_003:r_546de3fb6db156ea": {
      "text": "Whoa, that was close!",
      "status": "imported"
    },
    "voice_003:r_ca85f87cee5e31f7": {
      "text": "You're dealing with a pro!",
      "status": "imported"
    },
    "voice_003:r_9072ea7bc71df136": {
      "text": "Come back when you're ready!",
      "status": "imported"
    },
    "voice_003:r_d89011fe3e5d082a": {
      "text": "I can't attack...!? Damn it!",
      "status": "imported"
    },
    "voice_003:r_3c5b0c2ac812d5de": {
      "text": "Damn! I can't counterattack!",
      "status": "imported"
    },
    "voice_003:r_5b9e8897190892eb": {
      "text": "Tch! I can't do a damn thing!",
      "status": "imported"
    },
    "voice_003:r_7bea3023abbf8a94": {
      "text": "Damn! You got out of my reach!",
      "status": "imported"
    },
    "voice_003:r_dd01a4c0d1b36a8d": {
      "text": "Damn, you're in a tricky spot!",
      "status": "imported"
    },
    "voice_003:r_20920ad2eb3542db": {
      "text": "I'm the one you're fighting!",
      "status": "imported"
    },
    "voice_003:r_0ab7914877fd48ed": {
      "text": "Let's set off some huge fireworks!",
      "status": "imported"
    },
    "voice_003:r_cb846feec748c2e3": {
      "text": "One direct hit will finish this!",
      "status": "imported"
    },
    "voice_003:r_c958860b0676b1f5": {
      "text": "I'll crush you, cockpit and all!",
      "status": "imported"
    },
    "voice_003:r_5e2669b82ef75ce3": {
      "text": "I'll take this to close combat!",
      "status": "imported"
    },
    "voice_003:r_8c61c59a1c0aebbf": {
      "text": "Now that's some prime prey!",
      "status": "imported"
    },
    "voice_003:r_aba6a7662129d8ce": {
      "text": "Attack Pattern B! Let's do this!",
      "status": "imported"
    },
    "voice_003:r_b84afafb8a33ec60": {
      "text": "That cockpit will be your coffin!",
      "status": "imported"
    },
    "voice_003:r_bdd38c584fa313d0": {
      "text": "N-No way!!",
      "status": "imported"
    },
    "voice_003:r_3fd86c1027f317c8": {
      "text": "Gwaaaagh!!",
      "status": "imported"
    },
    "voice_003:r_d0372a183d2007ad": {
      "text": "Like hell I'll die here!",
      "status": "imported"
    },
    "voice_003:r_217aa5e1d545b44d": {
      "text": "I won't die in a dump like this!",
      "status": "imported"
    },
    "voice_003:r_381992c5d8224937": {
      "text": "What did you say!?",
      "status": "imported"
    },
    "voice_003:r_f1e7ed9e5874aba5": {
      "text": "Damn, a direct hit!",
      "status": "imported"
    },
    "voice_003:r_fc25e66a86fc2c85": {
      "text": "That wound's nothing to fuss over!",
      "status": "imported"
    },
    "voice_003:r_5aeeb4917340c42d": {
      "text": "Hm? Did something hit me?",
      "status": "imported"
    },
    "voice_003:r_b765659981b6516d": {
      "text": "Your cheap bluff won't work on me!",
      "status": "imported"
    },
    "voice_003:r_0c427458bc00eb95": {
      "text": "What a boring opponent!",
      "status": "imported"
    },
    "voice_003:r_774a9ab4d8fd5351": {
      "text": "I'm right here!",
      "status": "imported"
    },
    "voice_003:r_d3f01de714c015bd": {
      "text": "You fool!",
      "status": "imported"
    },
    "voice_003:r_7d2617c809fead70": {
      "text": "Too bad for you!",
      "status": "imported"
    },
    "voice_003:r_ceb935ccbf830724": {
      "text": "Like that'll hurt me!",
      "status": "imported"
    },
    "voice_003:r_8ad40afecd02b41e": {
      "text": "Hit the vitals,\\neven a giant...!",
      "status": "imported"
    },
    "voice_003:r_1f65a7af190e4674": {
      "text": "That bastard! You'll pay for that!",
      "status": "imported"
    },
    "voice_003:r_40c5a9358ed5bf29": {
      "text": "What the hell was that?",
      "status": "imported"
    },
    "voice_003:r_f2e18dfdfe0c89ea": {
      "text": "Not good enough!",
      "status": "imported"
    },
    "voice_003:r_cf7dbf49e96a5755": {
      "text": "I'll keep them distracted!",
      "status": "imported"
    },
    "voice_003:r_fa96676cc65bb509": {
      "text": "I'll stop them in their tracks!",
      "status": "imported"
    },
    "voice_003:r_4e37f92e7d2fc62e": {
      "text": "Now I can really show my skills!",
      "status": "imported"
    },
    "voice_003:r_66ab4cfe1557909d": {
      "text": "I'll provide support!",
      "status": "imported"
    },
    "voice_003:r_0bad405ee6ca63ba": {
      "text": "I'll finish them myself!",
      "status": "imported"
    },
    "voice_003:r_2072eaf71a260ae7": {
      "text": "Leave that one to me!",
      "status": "imported"
    },
    "voice_003:r_6c13bbfd27a7799e": {
      "text": "Not one of them gets away!",
      "status": "imported"
    }
  }
}
