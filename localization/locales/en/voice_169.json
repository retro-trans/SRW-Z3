{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_169:r_479b340ccc6c572b": {
      "text": "Contract fulfilled!\\nThat's my style!",
      "status": "imported"
    },
    "voice_169:r_ca4acbac57a2a35e": {
      "text": "Ungentlemanly, but\\nunavoidable...!",
      "status": "imported"
    },
    "voice_169:r_77949221bf58f862": {
      "text": "No negotiation for you.\\nTake this!",
      "status": "imported"
    },
    "voice_169:r_70b9c4b9f1f37eff": {
      "text": "I'll face you with all sincerity!",
      "status": "imported"
    },
    "voice_169:r_9fcb3754cb1773c7": {
      "text": "Time to get a little rough!",
      "status": "imported"
    },
    "voice_169:r_3559d2fad32c2435": {
      "text": "My best in every job...\\nThat's all!",
      "status": "imported"
    },
    "voice_169:r_f7570547e9f80a64": {
      "text": "Words won't work? Then take this!",
      "status": "imported"
    },
    "voice_169:r_cbab0f4720e1fcf1": {
      "text": "I'm busy!\\nLet's make it quick!",
      "status": "imported"
    },
    "voice_169:r_0bbe0b4f5364e732": {
      "text": "Whatever the reason, you're my foe!",
      "status": "imported"
    },
    "voice_169:r_5dda5198137cb02a": {
      "text": "You broke Roger's law.\\nNow leave!",
      "status": "imported"
    },
    "voice_169:r_83ec59afbecdec14": {
      "text": "I hate using force...\\nNo choice!",
      "status": "imported"
    },
    "voice_169:r_e20bfd42ad95a3c9": {
      "text": "I, Roger Smith,\\nwill face you.",
      "status": "imported"
    },
    "voice_169:r_0f58a8822381e57f": {
      "text": "It seems\\nyou won't negotiate.",
      "status": "imported"
    },
    "voice_169:r_6dbcc507fb61b51d": {
      "text": "Let's go, Dorothy!",
      "status": "imported"
    },
    "voice_169:r_b42ab697149a7c8a": {
      "text": "Yes. I'm ready whenever you are.",
      "status": "imported"
    },
    "voice_169:r_4de4fcf3b440baf4": {
      "text": "You really don't like them, do you?",
      "status": "imported"
    },
    "voice_169:r_0121a166c715cdff": {
      "text": "There's no logic to my perversity!",
      "status": "imported"
    },
    "voice_169:r_30fad37a42bd3ad3": {
      "text": "Roger,\\nlet's beat them to a pulp.",
      "status": "imported"
    },
    "voice_169:r_80a0b2a84e05d81a": {
      "text": "Indeed.\\nEmotion has its uses.",
      "status": "imported"
    },
    "voice_169:r_4a9ac1dff86506d9": {
      "text": "They want an encore.\\nLet's oblige!",
      "status": "imported"
    },
    "voice_169:r_bc8538e6af3d2577": {
      "text": "Take this light!",
      "status": "imported"
    },
    "voice_169:r_924516c8de2b5342": {
      "text": "Etch this light's path in your eyes!",
      "status": "imported"
    },
    "voice_169:r_da1174533722333f": {
      "text": "A party!\\nLet's be generous!",
      "status": "imported"
    },
    "voice_169:r_fdeb8162976e72c1": {
      "text": "My gift!\\nTake it without reserve!",
      "status": "imported"
    },
    "voice_169:r_0fadb5c26df92b42": {
      "text": "Sadly,\\nyou're in Big O's range!",
      "status": "imported"
    },
    "voice_169:r_6b15af9a0057cdc8": {
      "text": "I'll fire everything I can...!",
      "status": "imported"
    },
    "voice_169:r_15b4a90140e8a33a": {
      "text": "Behold Big O's trump card!",
      "status": "imported"
    },
    "voice_169:r_af884a6b11dff121": {
      "text": "Bathe in this shower of light!",
      "status": "imported"
    },
    "voice_169:r_ac6fe7838e95647b": {
      "text": "Can you tell the final letter!?",
      "status": "imported"
    },
    "voice_169:r_77ca87eacd17ad52": {
      "text": "See the answer with your own eyes!",
      "status": "imported"
    },
    "voice_169:r_02479dc8fe989560": {
      "text": "Big O!\\nAAAAACTION!!",
      "status": "imported"
    },
    "voice_169:r_a2df00f91a9b0a9e": {
      "text": "This'll finish you!!",
      "status": "imported"
    },
    "voice_169:r_48b60d6c48b9b142": {
      "text": "It's Shoooowtime!",
      "status": "imported"
    },
    "voice_169:r_8927e6fb681aa809": {
      "text": "Sleep forever!!",
      "status": "imported"
    },
    "voice_169:r_665f01666859013b": {
      "text": "Big O, let's go!",
      "status": "imported"
    },
    "voice_169:r_a571eec59b258d11": {
      "text": "Bye-bye!!",
      "status": "imported"
    },
    "voice_169:r_ddbe581c5ea9183d": {
      "text": "Big O! Action!!",
      "status": "imported"
    },
    "voice_169:r_faae935cca0edc72": {
      "text": "Feel this earth-splitting fist!!",
      "status": "imported"
    },
    "voice_169:r_d4430bf362340b32": {
      "text": "Big O!\\nFinal Staaaage!!",
      "status": "imported"
    },
    "voice_169:r_6ff1323b355593e0": {
      "text": "Now!\\nTake our mightiest blow!!",
      "status": "imported"
    },
    "voice_169:r_b7b5625d7cd4282f": {
      "text": "It's the grand finale!!",
      "status": "imported"
    },
    "voice_169:r_36133ad73a73ef98": {
      "text": "This stage is over too.",
      "status": "imported"
    },
    "voice_169:r_a8451712c57c1a72": {
      "text": "The power of Roger, Big O, and me.",
      "status": "imported"
    },
    "voice_169:r_cf41e8828a90cbdb": {
      "text": "For future memories,\\nI fire!!",
      "status": "imported"
    },
    "voice_169:r_719e897304ec42d4": {
      "text": "Negotiation ends here too.",
      "status": "imported"
    },
    "voice_169:r_ec2ea17765052401": {
      "text": "Roger the Negotiator",
      "status": "imported"
    },
    "voice_169:r_f2d4255f1c2f7542": {
      "text": "By Roger Smith's name,\\nI judge you!!",
      "status": "imported"
    },
    "voice_169:r_a7246b52782a877e": {
      "text": "Cards on the table.\\nThat's fair!",
      "status": "imported"
    },
    "voice_169:r_dc8701f6bcb9904f": {
      "text": "Revenge is tasteless...\\nEven so!",
      "status": "imported"
    },
    "voice_169:r_d6bdd730f24f66eb": {
      "text": "Big O, stop\\nthem having their way!",
      "status": "imported"
    },
    "voice_169:r_41997412868c48c4": {
      "text": "I'm a man who values fair play...!",
      "status": "imported"
    },
    "voice_169:r_24cf161287ef9d5c": {
      "text": "Leave the rest to me!",
      "status": "imported"
    },
    "voice_169:r_8f60f6fc86db3107": {
      "text": "Wait!\\nI have something for you too!",
      "status": "imported"
    },
    "voice_169:r_b1de76a75a253c13": {
      "text": "You really are a handful...",
      "status": "imported"
    },
    "voice_169:r_128c35bf3e0e394c": {
      "text": "Hurry and fall back!",
      "status": "imported"
    },
    "voice_169:r_5213c17e13b23de0": {
      "text": "I do tend to meddle.",
      "status": "imported"
    },
    "voice_169:r_38fdff9483e9245c": {
      "text": "I'm your opponent!",
      "status": "imported"
    },
    "voice_169:r_620fedec67706d7d": {
      "text": "Leave a one-on-one fight to me!",
      "status": "imported"
    },
    "voice_169:r_9680dcd0fddcfcc7": {
      "text": "Here,\\nI'll play the supporting role.",
      "status": "imported"
    },
    "voice_169:r_2a00f1044ad5cbaa": {
      "text": "Another job!\\nI'll see it done!",
      "status": "imported"
    },
    "voice_169:r_3dbeead1bd3164ef": {
      "text": "This isn't fair.",
      "status": "imported"
    },
    "voice_169:r_98d15b8cc09bc915": {
      "text": "No helping it.\\nI'll await my chance.",
      "status": "imported"
    },
    "voice_169:r_46e86d000250e137": {
      "text": "You won't hit me!",
      "status": "imported"
    },
    "voice_169:r_ac341e7976e88f0b": {
      "text": "Stop!\\nUse your time wisely!",
      "status": "imported"
    },
    "voice_169:r_cdbd128a5b4127cc": {
      "text": "Big O is anything but sluggish!",
      "status": "imported"
    },
    "voice_169:r_cfccaa1fbeda124c": {
      "text": "Are you looking for me?",
      "status": "imported"
    },
    "voice_169:r_b1f8ec192b9c083a": {
      "text": "You don't know\\nBig O's power, Beck!",
      "status": "imported"
    },
    "voice_169:r_a007f9ab9cf048b3": {
      "text": "You're nothing without cheap shots!",
      "status": "imported"
    },
    "voice_169:r_ddafde4b065ced49": {
      "text": "I know how to defend myself too.",
      "status": "imported"
    },
    "voice_169:r_de1213040856c089": {
      "text": "Never meant\\nto use you as a shield.",
      "status": "imported"
    },
    "voice_169:r_3304412ac41f47a6": {
      "text": "That attack\\nwon't stop me!",
      "status": "imported"
    },
    "voice_169:r_0c0775e051211840": {
      "text": "Don't underestimate Big O's armor!",
      "status": "imported"
    },
    "voice_169:r_a2afffe1c396f0b3": {
      "text": "That won't bring Big O down!",
      "status": "imported"
    },
    "voice_169:r_13c25fbdfddc8a24": {
      "text": "Ngh...!\\nControls are going slack...!",
      "status": "imported"
    },
    "voice_169:r_42ba1ecb310b4bd7": {
      "text": "Everywhere, some\\nlove a wild uproar.",
      "status": "imported"
    },
    "voice_169:r_d692f1d420460a47": {
      "text": "It seems\\nwords won't sway you!",
      "status": "imported"
    },
    "voice_169:r_a5643cec86b18bd2": {
      "text": "Enough!\\nYour pranks go too far!",
      "status": "imported"
    },
    "voice_169:r_68f2dfab20a4a30e": {
      "text": "Accurate, yes...\\nBut not sincere!",
      "status": "imported"
    },
    "voice_169:r_9cedad8237480563": {
      "text": "Ngh!\\nQuite the lethal weapon!",
      "status": "imported"
    },
    "voice_169:r_a03fabecba1508ca": {
      "text": "You don't know any manners,\\ndo you?",
      "status": "imported"
    },
    "voice_169:r_5391b24a71eb10ae": {
      "text": "Beck, damn you!\\nThat's enough!!",
      "status": "imported"
    },
    "voice_169:r_a554ceef5c87b972": {
      "text": "Hoodlum! My patience has limits!",
      "status": "imported"
    },
    "voice_169:r_1568ff6298b12b96": {
      "text": "Ngh...!\\nI never foresaw this...!",
      "status": "imported"
    },
    "voice_169:r_2c9d94ba13c5fc50": {
      "text": "What's happening...?\\nMove, Big O!?",
      "status": "imported"
    },
    "voice_169:r_a77f4913375098d2": {
      "text": "This...\\nIt's grossly unfair...!",
      "status": "imported"
    },
    "voice_169:r_428c2116ac3071b1": {
      "text": "Bad...\\nA rare career crisis...!",
      "status": "imported"
    },
    "voice_169:r_84c116267b79f540": {
      "text": "A pity...\\nBut watch my comeback!",
      "status": "imported"
    },
    "voice_169:r_dad38ee29af2df3a": {
      "text": "A true pro thrives under adversity!",
      "status": "imported"
    },
    "voice_169:r_69dfa1659715e2fa": {
      "text": "Ngh! Big O's been defeated!?",
      "status": "imported"
    },
    "voice_169:r_d996fd6d4ef5b329": {
      "text": "Not here...!\\nI have work to do!",
      "status": "imported"
    },
    "voice_169:r_8ab47a28f99ef565": {
      "text": "Not my style,\\nbut force it is!",
      "status": "imported"
    },
    "voice_169:r_546de3fb6db156ea": {
      "text": "Damn it!",
      "status": "imported"
    },
    "voice_169:r_ca85f87cee5e31f7": {
      "text": "Moby Dick Anchor, launch!",
      "status": "imported"
    },
    "voice_169:r_04e815a8d425827d": {
      "text": "If this fist lands,\\nyou're done for!",
      "status": "imported"
    },
    "voice_169:r_3c5b0c2ac812d5de": {
      "text": "For balance,\\nbut it works here too!",
      "status": "imported"
    },
    "voice_169:r_7bea3023abbf8a94": {
      "text": "Big O! Give it everything!",
      "status": "imported"
    },
    "voice_169:r_cb846feec748c2e3": {
      "text": "You're no pro, crook!\\nBack to jail!",
      "status": "imported"
    },
    "voice_169:r_c958860b0676b1f5": {
      "text": "You won't escape, Beck!",
      "status": "imported"
    },
    "voice_169:r_5e2669b82ef75ce3": {
      "text": "Black is good...\\nThe pilot isn't!",
      "status": "imported"
    },
    "voice_169:r_7847e0ed7dc9282d": {
      "text": "No mere pawn\\nwill steal my freedom!",
      "status": "imported"
    },
    "voice_169:r_e42b52c7a987b906": {
      "text": "Hope it's the last\\nI hit a woman...",
      "status": "imported"
    },
    "voice_169:r_6825fd1ff907bd22": {
      "text": "Sorry, please step aside,\\nmiss!",
      "status": "imported"
    },
    "voice_169:r_8ad40afecd02b41e": {
      "text": "Surprised?\\nBig O has this too.",
      "status": "imported"
    },
    "voice_169:r_26e5efec03c03d78": {
      "text": "What an extravagant welcome!",
      "status": "imported"
    },
    "voice_169:r_4ad81e88c7557a8b": {
      "text": "Then I should return the favor.",
      "status": "imported"
    },
    "voice_169:r_1f65a7af190e4674": {
      "text": "Weren't we going to be gentlemanly?",
      "status": "imported"
    },
    "voice_169:r_40c5a9358ed5bf29": {
      "text": "Depends on the foe.\\nNo need here!",
      "status": "imported"
    },
    "voice_169:r_f2e18dfdfe0c89ea": {
      "text": "Roger, begin the counterattack.",
      "status": "imported"
    },
    "voice_169:r_cf7dbf49e96a5755": {
      "text": "Force is my last resort,\\nDorothy.",
      "status": "imported"
    },
    "voice_169:r_b28faf9f71bc3598": {
      "text": "Big O seems to be running well.",
      "status": "imported"
    },
    "voice_169:r_8a29278549f8e07a": {
      "text": "So are you, Roger.",
      "status": "imported"
    },
    "voice_169:r_7e6c573c26177f98": {
      "text": "Well done, Big O.",
      "status": "imported"
    },
    "voice_169:r_45abf84f7757d6eb": {
      "text": "I'm the one piloting, though...",
      "status": "imported"
    },
    "voice_169:r_edd7a13ab8f06a14": {
      "text": "You never learn.",
      "status": "imported"
    },
    "voice_169:r_8165e5b41f0124c4": {
      "text": "The foe is Beck. It can't be helped.",
      "status": "imported"
    },
    "voice_169:r_e33693e5ba4665b0": {
      "text": "Sorry, Dorothy. I was careless.",
      "status": "imported"
    },
    "voice_169:r_72a21a1a489af001": {
      "text": "I'm fine. That wasn't a problem.",
      "status": "imported"
    },
    "voice_169:r_eb643f8bf737a0ca": {
      "text": "Roger, pilot more carefully.",
      "status": "imported"
    },
    "voice_169:r_0a3fccb71ec6cf2a": {
      "text": "Dorothy,\\ncredit their skill.",
      "status": "imported"
    },
    "voice_169:r_9b63cf1f3e0207ef": {
      "text": "In music,\\nthat's pianissimo.",
      "status": "imported"
    },
    "voice_169:r_8356f4e3dcdff938": {
      "text": "True.\\nStill below your piano.",
      "status": "imported"
    },
    "voice_169:r_1d6d784036ae0bd7": {
      "text": "Here,\\nplaying a suave lead is hard.",
      "status": "imported"
    },
    "voice_169:r_625664af02183c17": {
      "text": "Don't you mean the comic relief?",
      "status": "imported"
    },
    "voice_169:r_3701cba361f80ea5": {
      "text": "Keep this up,\\nand you'll regret it.",
      "status": "imported"
    },
    "voice_169:r_63f429c5c68c0863": {
      "text": "That's R. Dorothy for you.",
      "status": "imported"
    },
    "voice_169:r_38e4a434c91d8ef0": {
      "text": "Damn, they're infuriating.",
      "status": "imported"
    },
    "voice_169:r_98ed411352a3a6ac": {
      "text": "Dorothy.\\nA lady shouldn't say that.",
      "status": "imported"
    },
    "voice_169:r_4824bea6bab3af67": {
      "text": "Dorothy.\\nHow do we stage a comeback?",
      "status": "imported"
    },
    "voice_169:r_862b92e63adb9734": {
      "text": "That's your job to figure out.",
      "status": "imported"
    },
    "voice_169:r_cb306ef55e49d107": {
      "text": "Dorothy, if it comes to it, eject!",
      "status": "imported"
    },
    "voice_169:r_57b2bd2de8a1408d": {
      "text": "That won't happen...\\nRight, Roger?",
      "status": "imported"
    },
    "voice_169:r_76f080a4881e8ab5": {
      "text": "Roger...",
      "status": "imported"
    },
    "voice_169:r_288133bc5b573dae": {
      "text": "No need to say anything. Eject.",
      "status": "imported"
    },
    "voice_169:r_6f95653e548f8fcf": {
      "text": "Roger Smith, amnesiac city agent.",
      "status": "imported"
    },
    "voice_169:r_d249d68bada91ab9": {
      "text": "Big O! Showtime!",
      "status": "imported"
    },
    "voice_169:r_e9b3307e9eb69f11": {
      "text": "Norman will be pleased too.",
      "status": "imported"
    },
    "voice_169:r_981f8fedd5414fe5": {
      "text": "No negotiation needed for this job!",
      "status": "imported"
    },
    "voice_169:r_96bb0dcde0c8c44a": {
      "text": "Stay still. This will be quick.",
      "status": "imported"
    },
    "voice_169:r_641550a2f54cb456": {
      "text": "Dorothy,\\nhold on tight!",
      "status": "imported"
    },
    "voice_169:r_a0f2074af8debbfa": {
      "text": "Understood, Roger.",
      "status": "imported"
    },
    "voice_169:r_0e7466971bec4cc4": {
      "text": "In any age, some\\nsolve all by force!",
      "status": "imported"
    },
    "voice_169:r_efa71f7a4cc33ff3": {
      "text": "Allow me to help!",
      "status": "imported"
    },
    "voice_169:r_3fc2e1186557e7a0": {
      "text": "Unfortunately, this isn't over yet!",
      "status": "imported"
    },
    "voice_169:r_fa6930340a545054": {
      "text": "So negotiations failed...",
      "status": "imported"
    },
    "voice_169:r_2332b9d56461d7ab": {
      "text": "Don't they always?\\nLet's run.",
      "status": "imported"
    },
    "voice_169:r_854aa0a91a3c80d1": {
      "text": "I won't whine,\\nbut this is trouble!",
      "status": "imported"
    },
    "voice_169:r_0bc8ae32a406ceab": {
      "text": "Th-this can't be!\\nHow could I...!",
      "status": "imported"
    },
    "voice_169:r_82c09f011d703b2c": {
      "text": "Calm down a little,\\nRoger Smith.",
      "status": "imported"
    },
    "voice_169:r_2b4d8818c77b6dca": {
      "text": "You! That sarcasm goes too far!",
      "status": "imported"
    },
    "voice_169:r_087354f2db0a31e6": {
      "text": "You're my worst negotiation partner.",
      "status": "imported"
    },
    "voice_169:r_db02a2dec93dd263": {
      "text": "We knew that\\nfrom the start.",
      "status": "imported"
    },
    "voice_169:r_d520c6d5298a848d": {
      "text": "Don't get carried away!",
      "status": "imported"
    },
    "voice_169:r_099e2458cabf796f": {
      "text": "End this pointless resistance!",
      "status": "imported"
    },
    "voice_169:r_fd910d714be70870": {
      "text": "I see no abnormalities.",
      "status": "imported"
    },
    "voice_169:r_9736f29b11344ec3": {
      "text": "As expected, Big O.\\nLet's continue!",
      "status": "imported"
    },
    "voice_169:r_bece29562818acba": {
      "text": "Norman would mind any scratches.",
      "status": "imported"
    },
    "voice_169:r_494b5da92ed24ecb": {
      "text": "You!\\nDon't misuse all that power!",
      "status": "imported"
    },
    "voice_169:r_cd06d0820d82524b": {
      "text": "Beck!\\nThis is a true pro!!",
      "status": "imported"
    },
    "voice_169:r_c94c6d04be583774": {
      "text": "Right now,\\nno negotiator is needed.",
      "status": "imported"
    },
    "voice_169:r_e54e2c99ef8297af": {
      "text": "This is far from\\nnegotiator's work.",
      "status": "imported"
    },
    "voice_169:r_f16a3eb0bcaac082": {
      "text": "This method is hardly elegant.",
      "status": "imported"
    },
    "voice_169:r_10a408809e512df1": {
      "text": "When can I\\nfocus on my real work...?",
      "status": "imported"
    },
    "voice_169:r_bc7b9e308b879dd4": {
      "text": "Big O, I'm counting on you...!",
      "status": "imported"
    },
    "voice_169:r_98902fd3143c393e": {
      "text": "Behold\\na professional at work!",
      "status": "imported"
    },
    "voice_169:r_d907fbd7bc1c4298": {
      "text": "No need to hold back, Big O!",
      "status": "imported"
    },
    "voice_169:r_96b21e3a028dd074": {
      "text": "This earth has law:\\nRoger's law!",
      "status": "imported"
    },
    "voice_169:r_ce140b5d8e6b7310": {
      "text": "Go, Big O.",
      "status": "imported"
    },
    "voice_169:r_0e0335789c5396d7": {
      "text": "You make giving orders sound easy.",
      "status": "imported"
    },
    "voice_169:r_a8e85bd950696403": {
      "text": "You're in the way.",
      "status": "imported"
    },
    "voice_169:r_772c8bc40ab6cb61": {
      "text": "What a coincidence. I agree.",
      "status": "imported"
    },
    "voice_169:r_58dd2826a199ef51": {
      "text": "You won't escape.",
      "status": "imported"
    },
    "voice_169:r_aadc0b2442adb93b": {
      "text": "Of course, Dorothy.",
      "status": "imported"
    },
    "voice_169:r_e7a8cd8ed5bc2d1b": {
      "text": "I won't take long.\\nTell Norman.",
      "status": "imported"
    },
    "voice_169:r_c7f4280cde4605b3": {
      "text": "A dramatic reunion! Thank Lady Luck!",
      "status": "imported"
    },
    "voice_169:r_ec349c8ea9511a18": {
      "text": "If that's a welcome,\\nI'll accept!",
      "status": "imported"
    },
    "voice_169:r_33236ffa3ea95b68": {
      "text": "Don't get above yourself, hoodlum!",
      "status": "imported"
    },
    "voice_169:r_689d0b123de71ae0": {
      "text": "Beck! That vulgar laugh ends now!",
      "status": "imported"
    },
    "voice_169:r_84883aa95f63ce32": {
      "text": "Your machine is as crude as you...!",
      "status": "imported"
    },
    "voice_169:r_25493e978ce8ff16": {
      "text": "A bargain-bin Megadeus? Pathetic.",
      "status": "imported"
    },
    "voice_169:r_7316666150e42960": {
      "text": "No Dominus needed... Is that it...!?",
      "status": "imported"
    },
    "voice_169:r_c4f11aa93dc5b668": {
      "text": "This is my job.",
      "status": "imported"
    },
    "voice_169:r_ce1a22dfe3a4d339": {
      "text": "No bird or beast!\\nYou're you, Angel!",
      "status": "imported"
    },
    "voice_169:r_240651adab81e145": {
      "text": "I'll stop you\\nand fulfill my duty!",
      "status": "imported"
    },
    "voice_169:r_cff0deaae73c2858": {
      "text": "Hmm. Your machine shows good taste.",
      "status": "imported"
    },
    "voice_169:r_dca67f68a573fab7": {
      "text": "I'd hoped not to face a Gundam.",
      "status": "imported"
    },
    "voice_169:r_a6630215fefaf294": {
      "text": "What an honor.\\nThe famed Gundam...!",
      "status": "imported"
    },
    "voice_169:r_6f94566ad37f8ff8": {
      "text": "No will of your own?\\nStand down!",
      "status": "imported"
    },
    "voice_169:r_942ca03c9de80143": {
      "text": "You're warned. I won't hold back!",
      "status": "imported"
    },
    "voice_169:r_d8c669c70659e18a": {
      "text": "Wrong leader chosen.\\nYour fault...!",
      "status": "imported"
    },
    "voice_169:r_8f5bade7ac2db78e": {
      "text": "Rude kidnappers\\ndeserve no talks!",
      "status": "imported"
    },
    "voice_169:r_05ea490d2f522520": {
      "text": "Abducting a woman is contemptible!",
      "status": "imported"
    },
    "voice_169:r_f5658c702d91db7a": {
      "text": "Not you - your exploiter\\nis my foe!",
      "status": "imported"
    },
    "voice_169:r_686df329b50f195b": {
      "text": "I pity you,\\nwrong master's servant.",
      "status": "imported"
    },
    "voice_169:r_25f0ab0fa3cf690c": {
      "text": "Hit women?\\nAgainst my creed, but...",
      "status": "imported"
    },
    "voice_169:r_59fca03e929366c1": {
      "text": "Would you calm down, Lady?",
      "status": "imported"
    },
    "voice_169:r_d03018a31e23f1e9": {
      "text": "Now,\\nhow shall I welcome our angel?",
      "status": "imported"
    },
    "voice_169:r_279da5f732aa8847": {
      "text": "At least, it's not\\nmy notion of God!",
      "status": "imported"
    },
    "voice_169:r_97f82e3cb6f70110": {
      "text": "Power's even. How about the pilot!?",
      "status": "imported"
    },
    "voice_169:r_c5611d8dd6def96b": {
      "text": "You're a worthy opponent,\\nBig O!",
      "status": "imported"
    },
    "voice_169:r_6f12cc8ed2732eb5": {
      "text": "Big O, can you handle a fast foe?",
      "status": "imported"
    },
    "voice_169:r_7abfc55f8fb62ba7": {
      "text": "Fast, indeed.\\nBut I have a counter!",
      "status": "imported"
    },
    "voice_169:r_99e7a66c650b5892": {
      "text": "Can that unit\\nstand against Big O?",
      "status": "imported"
    },
    "voice_169:r_5b2247b5cfbcd7b2": {
      "text": "It feels unfair, but so be it.",
      "status": "imported"
    },
    "voice_169:r_2d7a9c06347582d9": {
      "text": "I feel lost\\nin a fable or novel!",
      "status": "imported"
    },
    "voice_169:r_bf953d64c3c7d9b7": {
      "text": "Hardly a being\\nI can negotiate with!",
      "status": "imported"
    },
    "voice_169:r_66236eb99b676e5b": {
      "text": "You're outside my expertise...!",
      "status": "imported"
    },
    "voice_169:r_aeea0893acb93d35": {
      "text": "Creatures that destroy endlessly...!",
      "status": "imported"
    },
    "voice_169:r_b31568654e53487b": {
      "text": "Invaders\\nhave no right to talks...!",
      "status": "imported"
    },
    "voice_169:r_2502132569141ea3": {
      "text": "Surviving this\\nis a true pro's work.",
      "status": "imported"
    },
    "voice_169:r_1ff312798a52c8eb": {
      "text": "Reason or not,\\nthis is hard...!",
      "status": "imported"
    },
    "voice_169:r_fa07d90fca62f593": {
      "text": "The VIP comes in person...!",
      "status": "imported"
    },
    "voice_169:r_a25bf2676ecf9d83": {
      "text": "Play the fool to the end, then...!",
      "status": "imported"
    },
    "voice_169:r_237a0288b42dce20": {
      "text": "We should've\\ndebated much more...!",
      "status": "imported"
    },
    "voice_169:r_0556e8a22779ea8e": {
      "text": "You want Earth?\\nPay a fair price!",
      "status": "imported"
    },
    "voice_169:r_09d377101a48d92a": {
      "text": "Your arrogance deserves no courtesy!",
      "status": "imported"
    },
    "voice_169:r_11517cc7b0494dbf": {
      "text": "To deceive another\\nis unforgivable!",
      "status": "imported"
    },
    "voice_169:r_b5864501463db244": {
      "text": "Know this:\\nyou're the worst...!",
      "status": "imported"
    },
    "voice_169:r_f74b67b3cfcbe05c": {
      "text": "Big O! Action!",
      "status": "imported"
    },
    "voice_169:r_6d8a80e2956870ed": {
      "text": "This is the end!",
      "status": "imported"
    },
    "voice_169:r_426b68d671486c8e": {
      "text": "Big O! AAAAACTION!",
      "status": "imported"
    },
    "voice_169:r_ae913eb08e0ff29b": {
      "text": "Goodbye! This is farewell!",
      "status": "imported"
    },
    "voice_169:r_0e58a97c7f8c9ecf": {
      "text": "Live as a human being, Angel!",
      "status": "imported"
    },
    "voice_169:r_c4c8af04ee11993c": {
      "text": "Sleep tight, monster!",
      "status": "imported"
    },
    "voice_169:r_cdfaf9cd1fd55c77": {
      "text": "I'll shoot through your weak point!",
      "status": "imported"
    },
    "voice_169:r_cf9a2e6954ba3564": {
      "text": "True...\\nI need to repay you somehow.",
      "status": "imported"
    },
    "voice_169:r_a9474d20d8dd3193": {
      "text": "You'll accept my return gift, yes?",
      "status": "imported"
    },
    "voice_169:r_d1b635ea0c0c2d67": {
      "text": "Save your confession for after this!",
      "status": "imported"
    },
    "voice_169:r_b8b0c93fd828bea6": {
      "text": "There is no room left to negotiate!",
      "status": "imported"
    },
    "voice_169:r_eb6326b22b74aaf5": {
      "text": "Very well.\\nI'll repay you in kind!",
      "status": "imported"
    },
    "voice_169:r_4561a1a3695f1597": {
      "text": "Sorry to steal your spotlight.",
      "status": "imported"
    },
    "voice_169:r_e756cef3d5de51e9": {
      "text": "Did you calculate this too, Zero?",
      "status": "imported"
    },
    "voice_169:r_e65d29f740ec5a07": {
      "text": "Excuse me for coming from behind.",
      "status": "imported"
    },
    "voice_169:r_25b3885e2565f90b": {
      "text": "That mistake isn't like you, Zero.",
      "status": "imported"
    },
    "voice_169:r_96858669715407f1": {
      "text": "If only talks\\nwent this smoothly.",
      "status": "imported"
    },
    "voice_169:r_2bb2a166baa517b9": {
      "text": "Bingo! Just as I thought!",
      "status": "imported"
    },
    "voice_169:r_34be00b434b42bea": {
      "text": "Have you had enough yet?",
      "status": "imported"
    },
    "voice_169:r_5b9baad61908571a": {
      "text": "More shame upon yourself, Beck?",
      "status": "imported"
    },
    "voice_169:r_7eedcce1036b4f4a": {
      "text": "Beck! End this foolishness now!",
      "status": "imported"
    },
    "voice_169:r_e016bd611281c0a6": {
      "text": "Mass-made junk Megadeus.\\nAbsurd.",
      "status": "imported"
    },
    "voice_169:r_aa211e3c1f473e51": {
      "text": "This cheap Megadeus will beat me?",
      "status": "imported"
    },
    "voice_169:r_c07813b8d06a7217": {
      "text": "Unmanned Megadeus.\\nThat's all it is.",
      "status": "imported"
    },
    "voice_169:r_81a6bca77bc301c0": {
      "text": "Angel! Stop this now!",
      "status": "imported"
    },
    "voice_169:r_febe65de885f155a": {
      "text": "Is this the doubt within Angel...!?",
      "status": "imported"
    },
    "voice_169:r_689700a088dc2f5b": {
      "text": "Are you nervous before me?",
      "status": "imported"
    },
    "voice_169:r_5a1e097aa0ec9859": {
      "text": "Listen.\\nBravery isn't recklessness.",
      "status": "imported"
    },
    "voice_169:r_2a8d41aa8f4749ec": {
      "text": "Somewhat anticlimactic.",
      "status": "imported"
    },
    "voice_169:r_01c80710474b30ae": {
      "text": "It had no effect at all.",
      "status": "imported"
    },
    "voice_169:r_870a7c766b4e2144": {
      "text": "Not good.\\nI'm bullying the weak.",
      "status": "imported"
    },
    "voice_169:r_a9f39df34c38f5b3": {
      "text": "It's useless.",
      "status": "imported"
    },
    "voice_169:r_c9f83672cc4c8866": {
      "text": "I wish they understood that too.",
      "status": "imported"
    },
    "voice_169:r_19631c3492e99773": {
      "text": "Norman should\\nfocus on dinner...",
      "status": "imported"
    },
    "voice_169:r_a49cb27d62c078ed": {
      "text": "Unlike talks,\\nthis isn't easy...",
      "status": "imported"
    },
    "voice_169:r_aa6642a8b00c07f9": {
      "text": "A pro\\nundoes their own mistakes!",
      "status": "imported"
    },
    "voice_169:r_b6a1f76ff2f0b93d": {
      "text": "Listen.\\nMy patience has limits!",
      "status": "imported"
    },
    "voice_169:r_16669b320b466ffb": {
      "text": "This is a problem.",
      "status": "imported"
    },
    "voice_169:r_50c7272601f9608b": {
      "text": "Dorothy,\\nwas that a joke?",
      "status": "imported"
    },
    "voice_169:r_9783be4881baaf30": {
      "text": "Systems check... All clear.",
      "status": "imported"
    },
    "voice_169:r_7a533f3a77a702e3": {
      "text": "Excellent! Now, let's counterattack!",
      "status": "imported"
    },
    "voice_169:r_f13d4928e70aad04": {
      "text": "Is this your trump card, Beck!?",
      "status": "imported"
    },
    "voice_169:r_bf8c22ddf5e5ebc4": {
      "text": "Beck,\\nyou still botch the finish...!",
      "status": "imported"
    },
    "voice_169:r_9ca308feda543481": {
      "text": "Win by numbers?\\nHow tasteless...!",
      "status": "imported"
    },
    "voice_169:r_323506822dc933d1": {
      "text": "Mass-made, but\\nstill a Big...!",
      "status": "imported"
    },
    "voice_169:r_a60677a64d47d57d": {
      "text": "Let a fake win?\\nNever, Big O!",
      "status": "imported"
    },
    "voice_169:r_eb27b8cd0e427016": {
      "text": "Angel!\\nCan't you hear my voice!?",
      "status": "imported"
    },
    "voice_169:r_d99d6b303b9eca7a": {
      "text": "Is this what you truly want, Angel!?",
      "status": "imported"
    },
    "voice_169:r_497ecb7603305283": {
      "text": "So,\\nnegotiation suits me best...!",
      "status": "imported"
    },
    "voice_169:r_5007f4e5632e10dc": {
      "text": "No haggling over\\nBig O's repairs!",
      "status": "imported"
    },
    "voice_169:r_c6e2e5a0cf999610": {
      "text": "Sorry!\\nHold on longer, Big O!",
      "status": "imported"
    },
    "voice_169:r_fd60a3acea1b3ee7": {
      "text": "This is getting bad.",
      "status": "imported"
    },
    "voice_169:r_4ae43494550cddb4": {
      "text": "Difficult situations suit me best!",
      "status": "imported"
    },
    "voice_169:r_ed6a018f016df09c": {
      "text": "I can't take any more...",
      "status": "imported"
    },
    "voice_169:r_07aec1c333dfbb19": {
      "text": "This isn't like you, R. Dorothy!",
      "status": "imported"
    },
    "voice_169:r_107aa098b3ff1499": {
      "text": "...Time to eject.",
      "status": "imported"
    },
    "voice_169:r_77289aae7685d872": {
      "text": "Ladies first, formally.\\nEject first.",
      "status": "imported"
    },
    "voice_169:r_5b29d293c437429d": {
      "text": "Me...? Isn't it our mistake, Angel?",
      "status": "imported"
    },
    "voice_169:r_03a3a973128986f1": {
      "text": "What...?",
      "status": "imported"
    },
    "voice_169:r_13209866a96cdb7e": {
      "text": "No, no! Wrong! Listen, Dorothy!",
      "status": "imported"
    },
    "voice_169:r_58fa3a0d2bd59f45": {
      "text": "We need rest, and a way to enjoy it.",
      "status": "imported"
    },
    "voice_169:r_6290e34747497854": {
      "text": "R. Dorothy: black, no milk or sugar.",
      "status": "imported"
    },
    "voice_169:r_20f27bcf531af7a7": {
      "text": "Bitter coffee and sweet talk. Ideal.",
      "status": "imported"
    },
    "voice_169:r_d6e13e5d6953bb84": {
      "text": "Human women tell me that often.",
      "status": "imported"
    },
    "voice_169:r_3baf3d844fb1d682": {
      "text": "Done for now? I'll rest a while too.",
      "status": "imported"
    },
    "voice_169:r_3360fe6adb1d6342": {
      "text": "You're the lead. No tale lacks one.",
      "status": "imported"
    },
    "voice_169:r_5102781c1e823018": {
      "text": "I'm still Roger. You stay the hero.",
      "status": "imported"
    },
    "voice_169:r_21062243b0a51b01": {
      "text": "Till next time in Super Robot Wars.",
      "status": "imported"
    },
    "voice_169:r_ecb10ae1dba4d07b": {
      "text": "We choose\\nour purpose in life!",
      "status": "imported"
    },
    "voice_169:r_e58eebaa984b6a93": {
      "text": "Schwarzwald!\\nEnough of your ravings!",
      "status": "imported"
    },
    "voice_169:r_75727ed69511d963": {
      "text": "Schwarz!\\nAn end you never foretold!",
      "status": "imported"
    },
    "voice_169:r_d876f2286c3c1194": {
      "text": "You cannot possibly\\nbe Big O's ally!",
      "status": "imported"
    },
    "voice_169:r_c4afbc5dcb6aff0f": {
      "text": "No matter who,\\nyou're no foe to us!",
      "status": "imported"
    },
    "voice_169:r_9f1316eb7e761e5d": {
      "text": "Schwarz!\\nThis battle's truth!!",
      "status": "imported"
    },
    "voice_169:r_4d90cfb045501000": {
      "text": "Schwarz - no, Michael\\nSeebach! Stop!",
      "status": "imported"
    },
    "voice_169:r_b727ac590e5fc881": {
      "text": "Not even tabloid news,\\nSchwarz!",
      "status": "imported"
    },
    "voice_169:r_d23baf327f21df3d": {
      "text": "Looks alike,\\nbut hollow inside!",
      "status": "imported"
    },
    "voice_169:r_37a8e35d923df797": {
      "text": "Schwarzwald!\\nIs this your truth!?",
      "status": "imported"
    },
    "voice_169:r_c17bbeb7638f9448": {
      "text": "Damn you, Schwarz!\\nRunning wild...!",
      "status": "imported"
    },
    "voice_169:r_8bd9a45beabc7906": {
      "text": "I-is this\\nthat red Big's power...!?",
      "status": "imported"
    },
    "voice_169:r_2a7c3e63066bb476": {
      "text": "Leave it to me!",
      "status": "imported"
    },
    "voice_169:r_857d69cc06534ed0": {
      "text": "I'll take that job!",
      "status": "imported"
    },
    "voice_169:r_abadc65ae19c6a47": {
      "text": "This one's on the house.",
      "status": "imported"
    },
    "voice_169:r_5f804641f79a8d84": {
      "text": "Understood! I'll lend a hand!",
      "status": "imported"
    }
  }
}
