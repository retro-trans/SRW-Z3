{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_030:r_479b340ccc6c572b": {
      "text": "Take this! Now learn!",
      "status": "imported"
    },
    "voice_030:r_ca4acbac57a2a35e": {
      "text": "This time, despair is certain!",
      "status": "imported"
    },
    "voice_030:r_77949221bf58f862": {
      "text": "To bring you absolute despair!",
      "status": "imported"
    },
    "voice_030:r_9fcb3754cb1773c7": {
      "text": "Glad to have lived a little longer?",
      "status": "imported"
    },
    "voice_030:r_3559d2fad32c2435": {
      "text": "It is futile!",
      "status": "imported"
    },
    "voice_030:r_cbab0f4720e1fcf1": {
      "text": "Nnngh!!",
      "status": "imported"
    },
    "voice_030:r_5dda5198137cb02a": {
      "text": "Taste absolute despair!!",
      "status": "imported"
    },
    "voice_030:r_83ec59afbecdec14": {
      "text": "Your inborn karma demands\\nyour doom!",
      "status": "imported"
    },
    "voice_030:r_e20bfd42ad95a3c9": {
      "text": "Our cosmos, our rule.\\nYou can't win!",
      "status": "imported"
    },
    "voice_030:r_0f58a8822381e57f": {
      "text": "Dare you\\nprotect the universe?!",
      "status": "imported"
    },
    "voice_030:r_6dbcc507fb61b51d": {
      "text": "Dare you\\nsacrifice everything?!",
      "status": "imported"
    },
    "voice_030:r_b42ab697149a7c8a": {
      "text": "We are the universe.\\nYou cannot win!",
      "status": "imported"
    },
    "voice_030:r_4de4fcf3b440baf4": {
      "text": "Kill to live.\\nSpiral Power's karma!!",
      "status": "imported"
    },
    "voice_030:r_0121a166c715cdff": {
      "text": "Ignorant Spiral race!\\nPerish!!",
      "status": "imported"
    },
    "voice_030:r_30fad37a42bd3ad3": {
      "text": "Foolish Spirals!\\nYou're not special!",
      "status": "imported"
    },
    "voice_030:r_80a0b2a84e05d81a": {
      "text": "Meet the old Spiral Warriors' fate!",
      "status": "imported"
    },
    "voice_030:r_4a9ac1dff86506d9": {
      "text": "I match your form\\non equal ground!",
      "status": "imported"
    },
    "voice_030:r_bc8538e6af3d2577": {
      "text": "Gunmen!\\nSpiral fools' last stand?!",
      "status": "imported"
    },
    "voice_030:r_924516c8de2b5342": {
      "text": "You too bear ruin's karma!\\nThen!!",
      "status": "imported"
    },
    "voice_030:r_fdeb8162976e72c1": {
      "text": "Lost in evolution's bliss!\\nNow pay!",
      "status": "imported"
    },
    "voice_030:r_0fadb5c26df92b42": {
      "text": "Guard one world.\\nHow narrow...!",
      "status": "imported"
    },
    "voice_030:r_ac6fe7838e95647b": {
      "text": "You too bear the seed of evolution!",
      "status": "imported"
    },
    "voice_030:r_bf3244994760e535": {
      "text": "Hope's song fades.\\nLet despair ring!",
      "status": "imported"
    },
    "voice_030:r_aabfb21c9d069ce7": {
      "text": "That song: Spiral Power too!\\nPerish!",
      "status": "imported"
    },
    "voice_030:r_a7246b52782a877e": {
      "text": "Endless flames of cosmic creation!",
      "status": "imported"
    },
    "voice_030:r_dc8701f6bcb9904f": {
      "text": "Infinity Big Bang\\nStorm!",
      "status": "imported"
    },
    "voice_030:r_d6bdd730f24f66eb": {
      "text": "Be erased down to your last DNA!!",
      "status": "imported"
    },
    "voice_030:r_41997412868c48c4": {
      "text": "Taste universe-birthing energy!",
      "status": "imported"
    },
    "voice_030:r_9e6cf4f389dae55c": {
      "text": "Infinity! Big Bang!\\nStorm!!",
      "status": "imported"
    },
    "voice_030:r_9e0c80ac7e33b459": {
      "text": "Burn to ash with despair in flames!!",
      "status": "imported"
    },
    "voice_030:r_7432ef43ed3471dc": {
      "text": "Such power...! Then...!",
      "status": "imported"
    },
    "voice_030:r_065443f6ddfcf0d7": {
      "text": "Anti-Spiral!!",
      "status": "imported"
    },
    "voice_030:r_47d52a2839c71715": {
      "text": "Gigaaa! Drill!",
      "status": "imported"
    },
    "voice_030:r_847f82e7f3eef651": {
      "text": "Breeeak!!",
      "status": "imported"
    },
    "voice_030:r_eb7ae28b53dc033c": {
      "text": "Foolish Spiral race...!",
      "status": "imported"
    },
    "voice_030:r_857c4a52ce8df0fd": {
      "text": "That which you all rely upon...!",
      "status": "imported"
    },
    "voice_030:r_55417493fce1d347": {
      "text": "With this drill!",
      "status": "imported"
    },
    "voice_030:r_8fdf5910927c9591": {
      "text": "I shall smash it to pieces!!",
      "status": "imported"
    },
    "voice_030:r_7d724dbcc4451e10": {
      "text": "I'll return your hope as despair!",
      "status": "imported"
    },
    "voice_030:r_93e25418a203cb8f": {
      "text": "Won't quit?\\nI'll bury your regrets!",
      "status": "imported"
    },
    "voice_030:r_adeb0a29274d3d9b": {
      "text": "It seems you need more despair!",
      "status": "imported"
    },
    "voice_030:r_24cf161287ef9d5c": {
      "text": "Now is the hour of your demise!",
      "status": "imported"
    },
    "voice_030:r_8f60f6fc86db3107": {
      "text": "Time to erase all you've done!",
      "status": "imported"
    },
    "voice_030:r_b1de76a75a253c13": {
      "text": "Your futile struggle ends here!",
      "status": "imported"
    },
    "voice_030:r_128c35bf3e0e394c": {
      "text": "You defy me...?!",
      "status": "imported"
    },
    "voice_030:r_5213c17e13b23de0": {
      "text": "Action without resolve is futile.",
      "status": "imported"
    },
    "voice_030:r_38fdff9483e9245c": {
      "text": "Hahahahaha! Futile.\\nI rule its odds.",
      "status": "imported"
    },
    "voice_030:r_620fedec67706d7d": {
      "text": "A final stand?\\nStill all in vain.",
      "status": "imported"
    },
    "voice_030:r_9680dcd0fddcfcc7": {
      "text": "Once more: here,\\nyour odds are zero.",
      "status": "imported"
    },
    "voice_030:r_2a00f1044ad5cbaa": {
      "text": "It does noooothing!!",
      "status": "imported"
    },
    "voice_030:r_46e86d000250e137": {
      "text": "No resolve? Such a feeble attack!",
      "status": "imported"
    },
    "voice_030:r_ac341e7976e88f0b": {
      "text": "Struggle on: beauty!\\nYour instinct!",
      "status": "imported"
    },
    "voice_030:r_cdbd128a5b4127cc": {
      "text": "Cling to faint hope!\\nHow foolish!",
      "status": "imported"
    },
    "voice_030:r_cfccaa1fbeda124c": {
      "text": "In eternal time,\\nyou are but specks!",
      "status": "imported"
    },
    "voice_030:r_b1f8ec192b9c083a": {
      "text": "Senseless force\\ncan't defeat us...!",
      "status": "imported"
    },
    "voice_030:r_a007f9ab9cf048b3": {
      "text": "Still you fight.\\nNothing new to us!",
      "status": "imported"
    },
    "voice_030:r_ddafde4b065ced49": {
      "text": "Evolution alone\\ndooms the universe!",
      "status": "imported"
    },
    "voice_030:r_de1213040856c089": {
      "text": "Cling to life.\\nThat is your karma!",
      "status": "imported"
    },
    "voice_030:r_3304412ac41f47a6": {
      "text": "Why...?!\\nWhence comes this power?!",
      "status": "imported"
    },
    "voice_030:r_0c0775e051211840": {
      "text": "Evolution: ruin.\\nWhy can't you see?!",
      "status": "imported"
    },
    "voice_030:r_a2afffe1c396f0b3": {
      "text": "Cosmic chaos!\\nWhy not understand?!",
      "status": "imported"
    },
    "voice_030:r_13c25fbdfddc8a24": {
      "text": "Our mere prey\\ncame this far...?!",
      "status": "imported"
    },
    "voice_030:r_42ba1ecb310b4bd7": {
      "text": "No! No-no-no-no-no-no-no-no! Never!",
      "status": "imported"
    }
  }
}
