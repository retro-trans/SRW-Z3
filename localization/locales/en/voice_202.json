{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_202:r_479b340ccc6c572b": {
      "text": "There!",
      "status": "imported"
    },
    "voice_202:r_77949221bf58f862": {
      "text": "Got you!",
      "status": "imported"
    },
    "voice_202:r_70b9c4b9f1f37eff": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_202:r_9fcb3754cb1773c7": {
      "text": "I'll take that!",
      "status": "imported"
    },
    "voice_202:r_3559d2fad32c2435": {
      "text": "Ready yourself!",
      "status": "imported"
    },
    "voice_202:r_f7570547e9f80a64": {
      "text": "We won't be stopped!",
      "status": "imported"
    },
    "voice_202:r_cbab0f4720e1fcf1": {
      "text": "Kneel before my power!",
      "status": "imported"
    },
    "voice_202:r_0bbe0b4f5364e732": {
      "text": "You're not going any farther!",
      "status": "imported"
    },
    "voice_202:r_5dda5198137cb02a": {
      "text": "Those who oppose us are evil!",
      "status": "imported"
    },
    "voice_202:r_83ec59afbecdec14": {
      "text": "This world needs us!",
      "status": "imported"
    },
    "voice_202:r_e20bfd42ad95a3c9": {
      "text": "We'll bring this rotten world down!",
      "status": "imported"
    },
    "voice_202:r_0f58a8822381e57f": {
      "text": "We will change the world!",
      "status": "imported"
    },
    "voice_202:r_6dbcc507fb61b51d": {
      "text": "Gundam! You stand in our way?!",
      "status": "imported"
    },
    "voice_202:r_b42ab697149a7c8a": {
      "text": "Drawn here by the scent of war?!",
      "status": "imported"
    },
    "voice_202:r_4de4fcf3b440baf4": {
      "text": "Dancouga! You've appeared here too!",
      "status": "imported"
    },
    "voice_202:r_0121a166c715cdff": {
      "text": "Civilians have no place in battle!",
      "status": "imported"
    },
    "voice_202:r_80a0b2a84e05d81a": {
      "text": "Sink the flagship and we win!",
      "status": "imported"
    },
    "voice_202:r_4a9ac1dff86506d9": {
      "text": "A direct hit will pierce any armor!",
      "status": "imported"
    },
    "voice_202:r_bc8538e6af3d2577": {
      "text": "I'll crush you with raw power!",
      "status": "imported"
    },
    "voice_202:r_924516c8de2b5342": {
      "text": "You won't escape!",
      "status": "imported"
    },
    "voice_202:r_da1174533722333f": {
      "text": "I'll turn your attack against you!",
      "status": "imported"
    },
    "voice_202:r_fdeb8162976e72c1": {
      "text": "I'll repay that debt at once!",
      "status": "imported"
    },
    "voice_202:r_0fadb5c26df92b42": {
      "text": "We'll press our attack right here!",
      "status": "imported"
    },
    "voice_202:r_6b15af9a0057cdc8": {
      "text": "I'll follow up with another attack!",
      "status": "imported"
    },
    "voice_202:r_15b4a90140e8a33a": {
      "text": "This will finish you!",
      "status": "imported"
    },
    "voice_202:r_af884a6b11dff121": {
      "text": "D-Daaaaamn!!",
      "status": "imported"
    },
    "voice_202:r_ac6fe7838e95647b": {
      "text": "M-My machine!!",
      "status": "imported"
    },
    "voice_202:r_77ca87eacd17ad52": {
      "text": "I-Impossible!!",
      "status": "imported"
    },
    "voice_202:r_bf3244994760e535": {
      "text": "N-No... I failed!!",
      "status": "imported"
    },
    "voice_202:r_aabfb21c9d069ce7": {
      "text": "Wh-What incredible power!",
      "status": "imported"
    },
    "voice_202:r_02479dc8fe989560": {
      "text": "W-Why is this so easy for them?!",
      "status": "imported"
    },
    "voice_202:r_a2df00f91a9b0a9e": {
      "text": "Wh-What in the world did they do?!",
      "status": "imported"
    },
    "voice_202:r_48b60d6c48b9b142": {
      "text": "I won't let them overwhelm me!",
      "status": "imported"
    },
    "voice_202:r_8927e6fb681aa809": {
      "text": "I'll stop them, whatever it takes!!",
      "status": "imported"
    },
    "voice_202:r_665f01666859013b": {
      "text": "We can turn this around! We must!",
      "status": "imported"
    },
    "voice_202:r_a571eec59b258d11": {
      "text": "O-Our battle\\ncan never be stopped!",
      "status": "imported"
    },
    "voice_202:r_ddbe581c5ea9183d": {
      "text": "The world won't change by yielding!",
      "status": "imported"
    },
    "voice_202:r_faae935cca0edc72": {
      "text": "Our fight for change isn't over!",
      "status": "imported"
    },
    "voice_202:r_d4430bf362340b32": {
      "text": "S-So this is the Gundam's power?!",
      "status": "imported"
    },
    "voice_202:r_6ff1323b355593e0": {
      "text": "Fiercer than rumors!\\nSo, Dancouga!",
      "status": "imported"
    },
    "voice_202:r_b7b5625d7cd4282f": {
      "text": "Tch, they're no ordinary opponent!",
      "status": "imported"
    },
    "voice_202:r_36133ad73a73ef98": {
      "text": "Damn! I let my guard down!",
      "status": "imported"
    },
    "voice_202:r_920740a0219c5085": {
      "text": "Urgh! What is this?!",
      "status": "imported"
    },
    "voice_202:r_a8451712c57c1a72": {
      "text": "Damn, was that a direct hit?!",
      "status": "imported"
    },
    "voice_202:r_3633df5b7b8f47fa": {
      "text": "Looks like you have some skill!",
      "status": "imported"
    },
    "voice_202:r_52dfc56b14b93551": {
      "text": "Guh! This fight isn't over yet!",
      "status": "imported"
    },
    "voice_202:r_1b9b2aab5cb104da": {
      "text": "Grr! This won't\\nshake our resolve!",
      "status": "imported"
    },
    "voice_202:r_342044c706a2340f": {
      "text": "Why not use that power for reform?!",
      "status": "imported"
    },
    "voice_202:r_cf41e8828a90cbdb": {
      "text": "C-Curse you, Gundam!",
      "status": "imported"
    },
    "voice_202:r_719e897304ec42d4": {
      "text": "S-So this is Dancouga's power?!",
      "status": "imported"
    },
    "voice_202:r_d5e0a2317c40d322": {
      "text": "What was that?",
      "status": "imported"
    },
    "voice_202:r_ec2ea17765052401": {
      "text": "What? One hit is all you've got?",
      "status": "imported"
    },
    "voice_202:r_f2d4255f1c2f7542": {
      "text": "Hmph. This wound isn't fatal.",
      "status": "imported"
    },
    "voice_202:r_5d08ad19e2da125b": {
      "text": "You're underestimating us!",
      "status": "imported"
    },
    "voice_202:r_a7246b52782a877e": {
      "text": "You're weak! In will and in power!",
      "status": "imported"
    },
    "voice_202:r_dc8701f6bcb9904f": {
      "text": "That won't\\nshatter our justice!",
      "status": "imported"
    },
    "voice_202:r_d6bdd730f24f66eb": {
      "text": "You don't decide the world's fate!",
      "status": "imported"
    },
    "voice_202:r_41997412868c48c4": {
      "text": "Even a Gundam is nothing special!",
      "status": "imported"
    },
    "voice_202:r_9e6cf4f389dae55c": {
      "text": "Hmph! So what if you're Dancouga?!",
      "status": "imported"
    },
    "voice_202:r_9e0c80ac7e33b459": {
      "text": "I can't afford a direct hit!",
      "status": "imported"
    },
    "voice_202:r_7432ef43ed3471dc": {
      "text": "Where are you looking?!",
      "status": "imported"
    },
    "voice_202:r_065443f6ddfcf0d7": {
      "text": "I can see right through that!",
      "status": "imported"
    },
    "voice_202:r_47d52a2839c71715": {
      "text": "Such predictable movements!",
      "status": "imported"
    },
    "voice_202:r_847f82e7f3eef651": {
      "text": "Attacks that miss are meaningless!",
      "status": "imported"
    },
    "voice_202:r_eb7ae28b53dc033c": {
      "text": "We have power to change the world!",
      "status": "imported"
    },
    "voice_202:r_857c4a52ce8df0fd": {
      "text": "You cannot bend our will!",
      "status": "imported"
    },
    "voice_202:r_55417493fce1d347": {
      "text": "The powerless can't preach justice!",
      "status": "imported"
    },
    "voice_202:r_8fdf5910927c9591": {
      "text": "So even a Gundam is this weak!",
      "status": "imported"
    },
    "voice_202:r_7d724dbcc4451e10": {
      "text": "You're naive, Dancouga!",
      "status": "imported"
    },
    "voice_202:r_93e25418a203cb8f": {
      "text": "It's useless!",
      "status": "imported"
    },
    "voice_202:r_24cf161287ef9d5c": {
      "text": "We have no choice but to withdraw!",
      "status": "imported"
    },
    "voice_202:r_8f60f6fc86db3107": {
      "text": "No! I can't counterattack!",
      "status": "imported"
    },
    "voice_202:r_b1de76a75a253c13": {
      "text": "Ugh!\\nThey'll crush me like this!",
      "status": "imported"
    },
    "voice_202:r_128c35bf3e0e394c": {
      "text": "Damn it, where did they go?!",
      "status": "imported"
    },
    "voice_202:r_5213c17e13b23de0": {
      "text": "Damn, not from that position!",
      "status": "imported"
    },
    "voice_202:r_38fdff9483e9245c": {
      "text": "Tch! They're in a troublesome spot!",
      "status": "imported"
    },
    "voice_202:r_620fedec67706d7d": {
      "text": "Now! Fire!",
      "status": "imported"
    },
    "voice_202:r_9680dcd0fddcfcc7": {
      "text": "I'll hit you!",
      "status": "imported"
    },
    "voice_202:r_2a00f1044ad5cbaa": {
      "text": "Right in my sights!",
      "status": "imported"
    },
    "voice_202:r_3dbeead1bd3164ef": {
      "text": "I'll force this into close combat!",
      "status": "imported"
    },
    "voice_202:r_98d15b8cc09bc915": {
      "text": "Charge!!",
      "status": "imported"
    },
    "voice_202:r_46e86d000250e137": {
      "text": "Out of my way!",
      "status": "imported"
    },
    "voice_202:r_ac341e7976e88f0b": {
      "text": "Hraaaah!",
      "status": "imported"
    },
    "voice_202:r_cdbd128a5b4127cc": {
      "text": "Withdraw at once!",
      "status": "imported"
    },
    "voice_202:r_7847e0ed7dc9282d": {
      "text": "Eat this!",
      "status": "imported"
    },
    "voice_202:r_e42b52c7a987b906": {
      "text": "All right, now!",
      "status": "imported"
    },
    "voice_202:r_6825fd1ff907bd22": {
      "text": "No mercy!",
      "status": "imported"
    },
    "voice_202:r_607f666f1563bc0d": {
      "text": "For our noble ideal!",
      "status": "imported"
    },
    "voice_202:r_97b7431eeb81e6b6": {
      "text": "Reform always demands sacrifice!",
      "status": "imported"
    },
    "voice_202:r_fa944da4b6519006": {
      "text": "Don't move!",
      "status": "imported"
    },
    "voice_202:r_95d047bcc17fccc6": {
      "text": "Don't think you can escape!",
      "status": "imported"
    },
    "voice_202:r_640327a12a559b31": {
      "text": "We'll strike as one!",
      "status": "imported"
    },
    "voice_202:r_bdd38c584fa313d0": {
      "text": "I'll hit you with one more shot!",
      "status": "imported"
    },
    "voice_202:r_3fd86c1027f317c8": {
      "text": "This ends now!",
      "status": "imported"
    },
    "voice_202:r_d0372a183d2007ad": {
      "text": "Raaaaagh!",
      "status": "imported"
    },
    "voice_202:r_217aa5e1d545b44d": {
      "text": "Damn it!!",
      "status": "imported"
    },
    "voice_202:r_381992c5d8224937": {
      "text": "This is bad! I can't hold out!",
      "status": "imported"
    },
    "voice_202:r_f1e7ed9e5874aba5": {
      "text": "M-My spirit isn't broken yet!!",
      "status": "imported"
    },
    "voice_202:r_fc25e66a86fc2c85": {
      "text": "I was prepared for this much!",
      "status": "imported"
    },
    "voice_202:r_5aeeb4917340c42d": {
      "text": "Guh! Brute force won't beat me!",
      "status": "imported"
    },
    "voice_202:r_b765659981b6516d": {
      "text": "It seems I overestimated them.",
      "status": "imported"
    },
    "voice_202:r_0c427458bc00eb95": {
      "text": "They're hardly worth my time!",
      "status": "imported"
    },
    "voice_202:r_774a9ab4d8fd5351": {
      "text": "Hah! Is that the best you can do?",
      "status": "imported"
    },
    "voice_202:r_d3f01de714c015bd": {
      "text": "I've got a shield!",
      "status": "imported"
    },
    "voice_202:r_7d2617c809fead70": {
      "text": "You'll never hit me!",
      "status": "imported"
    },
    "voice_202:r_ceb935ccbf830724": {
      "text": "Your aim is too sloppy!",
      "status": "imported"
    },
    "voice_202:r_862ef7385bf2abd4": {
      "text": "That will never work on me!",
      "status": "imported"
    },
    "voice_202:r_001cbec4d9a4283f": {
      "text": "As if that could hurt me!",
      "status": "imported"
    },
    "voice_202:r_4ad81e88c7557a8b": {
      "text": "Damn, I lost sight of them!",
      "status": "imported"
    },
    "voice_202:r_1f65a7af190e4674": {
      "text": "I won't let you!",
      "status": "imported"
    },
    "voice_202:r_40c5a9358ed5bf29": {
      "text": "I'll hold them off here!",
      "status": "imported"
    },
    "voice_202:r_f2e18dfdfe0c89ea": {
      "text": "Damn! Can't I do anything?!",
      "status": "imported"
    },
    "voice_202:r_cf7dbf49e96a5755": {
      "text": "We will carry out our cause!",
      "status": "imported"
    },
    "voice_202:r_66ab4cfe1557909d": {
      "text": "I-Is this the end for me?!",
      "status": "imported"
    },
    "voice_202:r_0bad405ee6ca63ba": {
      "text": "I can't worry about a mere scratch!",
      "status": "imported"
    },
    "voice_202:r_2072eaf71a260ae7": {
      "text": "I'll keep them in check!",
      "status": "imported"
    },
    "voice_202:r_6c13bbfd27a7799e": {
      "text": "I'll make the first move!",
      "status": "imported"
    },
    "voice_202:r_06f88dcbd3c9e738": {
      "text": "Roger! Commencing attack!",
      "status": "imported"
    },
    "voice_202:r_b28faf9f71bc3598": {
      "text": "I'm your opponent!",
      "status": "imported"
    }
  }
}
