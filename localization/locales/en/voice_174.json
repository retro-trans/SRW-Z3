{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_174:r_479b340ccc6c572b": {
      "text": "All right, time to clean house!",
      "status": "imported"
    },
    "voice_174:r_ca4acbac57a2a35e": {
      "text": "Sorry, but this is goodbye!",
      "status": "imported"
    },
    "voice_174:r_77949221bf58f862": {
      "text": "We'll be your opponents!",
      "status": "imported"
    },
    "voice_174:r_70b9c4b9f1f37eff": {
      "text": "Once we start, we never stop!",
      "status": "imported"
    },
    "voice_174:r_9fcb3754cb1773c7": {
      "text": "Let's show them what we've got!",
      "status": "imported"
    },
    "voice_174:r_3559d2fad32c2435": {
      "text": "Dancouga,\\nnow this fires me up!",
      "status": "imported"
    },
    "voice_174:r_f7570547e9f80a64": {
      "text": "I'll draw out\\nMax God's full power!",
      "status": "imported"
    },
    "voice_174:r_cbab0f4720e1fcf1": {
      "text": "We bear everyone's hopes and\\nwishes!",
      "status": "imported"
    },
    "voice_174:r_0bbe0b4f5364e732": {
      "text": "Aoi, I'll leave this to you!",
      "status": "imported"
    },
    "voice_174:r_5dda5198137cb02a": {
      "text": "Then I'll take you up on that!",
      "status": "imported"
    },
    "voice_174:r_83ec59afbecdec14": {
      "text": "Aoi! Bogey closing from R2-U38!",
      "status": "imported"
    },
    "voice_174:r_e20bfd42ad95a3c9": {
      "text": "Got it, Kurara!",
      "status": "imported"
    },
    "voice_174:r_0f58a8822381e57f": {
      "text": "Let's hurry up and finish this!",
      "status": "imported"
    },
    "voice_174:r_6dbcc507fb61b51d": {
      "text": "Then I'll grant your request!",
      "status": "imported"
    },
    "voice_174:r_b42ab697149a7c8a": {
      "text": "Let's go! I'll blow 'em away!",
      "status": "imported"
    },
    "voice_174:r_4de4fcf3b440baf4": {
      "text": "If only it were that easy!",
      "status": "imported"
    },
    "voice_174:r_0121a166c715cdff": {
      "text": "Aoi! They're coming head-on!",
      "status": "imported"
    },
    "voice_174:r_30fad37a42bd3ad3": {
      "text": "Got it! We'll meet them head-on!",
      "status": "imported"
    },
    "voice_174:r_80a0b2a84e05d81a": {
      "text": "Aoi, let's stay calm out there!",
      "status": "imported"
    },
    "voice_174:r_4a9ac1dff86506d9": {
      "text": "Roger! We'll finish this cool!",
      "status": "imported"
    },
    "voice_174:r_bc8538e6af3d2577": {
      "text": "Watch the enemy! Now, Aoi!",
      "status": "imported"
    },
    "voice_174:r_924516c8de2b5342": {
      "text": "Thanks, Eida!",
      "status": "imported"
    },
    "voice_174:r_da1174533722333f": {
      "text": "Enemy acquired! Sending data!",
      "status": "imported"
    },
    "voice_174:r_fdeb8162976e72c1": {
      "text": "All right! Let's make it flashy!",
      "status": "imported"
    },
    "voice_174:r_0fadb5c26df92b42": {
      "text": "Well then, here goes!",
      "status": "imported"
    },
    "voice_174:r_6b15af9a0057cdc8": {
      "text": "Let's show them what we've got!",
      "status": "imported"
    },
    "voice_174:r_15b4a90140e8a33a": {
      "text": "Hey, that's supposed to be my line!",
      "status": "imported"
    },
    "voice_174:r_af884a6b11dff121": {
      "text": "Is everyone ready?!",
      "status": "imported"
    },
    "voice_174:r_ac6fe7838e95647b": {
      "text": "I'll show 'em!",
      "status": "imported"
    },
    "voice_174:r_77ca87eacd17ad52": {
      "text": "Ah! I knew someone would say it!",
      "status": "imported"
    },
    "voice_174:r_bf3244994760e535": {
      "text": "Let's go, everyone!",
      "status": "imported"
    },
    "voice_174:r_aabfb21c9d069ce7": {
      "text": "I'll show them what I can do!",
      "status": "imported"
    },
    "voice_174:r_02479dc8fe989560": {
      "text": "Ah... Someone beat me to it.",
      "status": "imported"
    },
    "voice_174:r_a2df00f91a9b0a9e": {
      "text": "Everyone, let's finish this!",
      "status": "imported"
    },
    "voice_174:r_48b60d6c48b9b142": {
      "text": "Let's do this!",
      "status": "imported"
    },
    "voice_174:r_8927e6fb681aa809": {
      "text": "Let me say it too!",
      "status": "imported"
    },
    "voice_174:r_665f01666859013b": {
      "text": "Let's pound that thing!",
      "status": "imported"
    },
    "voice_174:r_a571eec59b258d11": {
      "text": "Yeah!",
      "status": "imported"
    },
    "voice_174:r_ddbe581c5ea9183d": {
      "text": "Everyone, you're ready, right?!",
      "status": "imported"
    },
    "voice_174:r_d4430bf362340b32": {
      "text": "We'll hit them with all we've got!",
      "status": "imported"
    },
    "voice_174:r_6ff1323b355593e0": {
      "text": "Yeah!",
      "status": "imported"
    },
    "voice_174:r_b7b5625d7cd4282f": {
      "text": "We'll stake everything on Dancouga!",
      "status": "imported"
    },
    "voice_174:r_920740a0219c5085": {
      "text": "We'll unite their rage and hopes!",
      "status": "imported"
    },
    "voice_174:r_3633df5b7b8f47fa": {
      "text": "Do men hate a persistent woman?",
      "status": "imported"
    },
    "voice_174:r_52dfc56b14b93551": {
      "text": "I won't overlook\\nthat opening!",
      "status": "imported"
    },
    "voice_174:r_1b9b2aab5cb104da": {
      "text": "Back off if you don't want a wound!",
      "status": "imported"
    },
    "voice_174:r_342044c706a2340f": {
      "text": "Hey, pilot!\\nBehave yourself!",
      "status": "imported"
    },
    "voice_174:r_cf41e8828a90cbdb": {
      "text": "How fun!\\nYou want to race me?!",
      "status": "imported"
    },
    "voice_174:r_719e897304ec42d4": {
      "text": "I'm confident in my speed too!",
      "status": "imported"
    },
    "voice_174:r_d5e0a2317c40d322": {
      "text": "Sorry, but\\nEarth doesn't want you!",
      "status": "imported"
    },
    "voice_174:r_ec2ea17765052401": {
      "text": "All right! Let's hunt some monsters!",
      "status": "imported"
    },
    "voice_174:r_f2d4255f1c2f7542": {
      "text": "Sorry, but\\nyou're just not my type!",
      "status": "imported"
    },
    "voice_174:r_5d08ad19e2da125b": {
      "text": "Time to pick on someone strong!",
      "status": "imported"
    },
    "voice_174:r_a7246b52782a877e": {
      "text": "You may\\nreally fire me up!",
      "status": "imported"
    },
    "voice_174:r_dc8701f6bcb9904f": {
      "text": "Behold\\nthe human power you sought!",
      "status": "imported"
    },
    "voice_174:r_d6bdd730f24f66eb": {
      "text": "Aoi! You know what to do, right?",
      "status": "imported"
    },
    "voice_174:r_41997412868c48c4": {
      "text": "We don't hurt the pilot, remember?",
      "status": "imported"
    },
    "voice_174:r_9e6cf4f389dae55c": {
      "text": "Aoi, data from\\nMonthly Men's UMA!",
      "status": "imported"
    },
    "voice_174:r_9e0c80ac7e33b459": {
      "text": "How is that supposed to help?!",
      "status": "imported"
    },
    "voice_174:r_7432ef43ed3471dc": {
      "text": "If you're going after Earth...",
      "status": "imported"
    },
    "voice_174:r_065443f6ddfcf0d7": {
      "text": "Then we'll take you on!",
      "status": "imported"
    },
    "voice_174:r_47d52a2839c71715": {
      "text": "It's their boss! Don't get careless!",
      "status": "imported"
    },
    "voice_174:r_847f82e7f3eef651": {
      "text": "Beat it,\\nthen a happy ending!",
      "status": "imported"
    },
    "voice_174:r_eb7ae28b53dc033c": {
      "text": "Impressive!\\nFar beyond the others!",
      "status": "imported"
    },
    "voice_174:r_857c4a52ce8df0fd": {
      "text": "We'll hit them with everything!",
      "status": "imported"
    },
    "voice_174:r_55417493fce1d347": {
      "text": "They're human! Don't go overboard!",
      "status": "imported"
    },
    "voice_174:r_8fdf5910927c9591": {
      "text": "Yeah, yeah! I know!",
      "status": "imported"
    },
    "voice_174:r_7d724dbcc4451e10": {
      "text": "Raaaaaagh!",
      "status": "imported"
    },
    "voice_174:r_93e25418a203cb8f": {
      "text": "We'll punch right through!",
      "status": "imported"
    },
    "voice_174:r_adeb0a29274d3d9b": {
      "text": "Blooow awaaay!",
      "status": "imported"
    },
    "voice_174:r_24cf161287ef9d5c": {
      "text": "Hyaaaaaaaaah!",
      "status": "imported"
    },
    "voice_174:r_8f60f6fc86db3107": {
      "text": "This is iiiiiit!",
      "status": "imported"
    },
    "voice_174:r_b1de76a75a253c13": {
      "text": "Goooooooo!",
      "status": "imported"
    },
    "voice_174:r_128c35bf3e0e394c": {
      "text": "Johnny, now!",
      "status": "imported"
    },
    "voice_174:r_5213c17e13b23de0": {
      "text": "Here goes! Missile Detonator!",
      "status": "imported"
    },
    "voice_174:r_38fdff9483e9245c": {
      "text": "Use the Missile Detonator!",
      "status": "imported"
    },
    "voice_174:r_620fedec67706d7d": {
      "text": "There!",
      "status": "imported"
    },
    "voice_174:r_9680dcd0fddcfcc7": {
      "text": "Please leave this to me!!",
      "status": "imported"
    },
    "voice_174:r_2a00f1044ad5cbaa": {
      "text": "Gooo!",
      "status": "imported"
    },
    "voice_174:r_98d15b8cc09bc915": {
      "text": "Missile Detonator!",
      "status": "imported"
    },
    "voice_174:r_ac341e7976e88f0b": {
      "text": "Missile Detonator!!",
      "status": "imported"
    },
    "voice_174:r_cdbd128a5b4127cc": {
      "text": "Sakuya! You're up!",
      "status": "imported"
    },
    "voice_174:r_cfccaa1fbeda124c": {
      "text": "Booost! Nova!\\nKnuckle!!",
      "status": "imported"
    },
    "voice_174:r_b1f8ec192b9c083a": {
      "text": "Here's your chance, Aoi!",
      "status": "imported"
    },
    "voice_174:r_a007f9ab9cf048b3": {
      "text": "Dankuuken!",
      "status": "imported"
    },
    "voice_174:r_ddafde4b065ced49": {
      "text": "Gooooooo!",
      "status": "imported"
    },
    "voice_174:r_de1213040856c089": {
      "text": "Dankuu Zan!",
      "status": "imported"
    },
    "voice_174:r_0c0775e051211840": {
      "text": "Dankuukeeen!",
      "status": "imported"
    },
    "voice_174:r_a2afffe1c396f0b3": {
      "text": "Goooooo!",
      "status": "imported"
    },
    "voice_174:r_13c25fbdfddc8a24": {
      "text": "Dan! Kuu! Zan!",
      "status": "imported"
    },
    "voice_174:r_42ba1ecb310b4bd7": {
      "text": "Aoi! Use the Dankuuken!",
      "status": "imported"
    },
    "voice_174:r_d692f1d420460a47": {
      "text": "All at once! Dankuuken!",
      "status": "imported"
    },
    "voice_174:r_a5643cec86b18bd2": {
      "text": "Haaaaaaaaah!",
      "status": "imported"
    },
    "voice_174:r_68f2dfab20a4a30e": {
      "text": "Dankuu Zaaaan!",
      "status": "imported"
    },
    "voice_174:r_9cedad8237480563": {
      "text": "I'm counting on you, Eida!",
      "status": "imported"
    },
    "voice_174:r_a03fabecba1508ca": {
      "text": "Roger!",
      "status": "imported"
    },
    "voice_174:r_5391b24a71eb10ae": {
      "text": "Dan Blade Shoot!",
      "status": "imported"
    },
    "voice_174:r_a554ceef5c87b972": {
      "text": "Eida! Please!",
      "status": "imported"
    },
    "voice_174:r_1568ff6298b12b96": {
      "text": "Dan Blade! Shoot!",
      "status": "imported"
    },
    "voice_174:r_2c9d94ba13c5fc50": {
      "text": "Everyone! We're charging in!",
      "status": "imported"
    },
    "voice_174:r_a77f4913375098d2": {
      "text": "Kurara!\\nFinal Dankuu Hou is ready!",
      "status": "imported"
    },
    "voice_174:r_428c2116ac3071b1": {
      "text": "Got it! Go, Aoi!",
      "status": "imported"
    },
    "voice_174:r_84c116267b79f540": {
      "text": "Let 'em have it, Johnny!",
      "status": "imported"
    },
    "voice_174:r_dad38ee29af2df3a": {
      "text": "Missile Detonator!",
      "status": "imported"
    },
    "voice_174:r_3d32e86f8dc80909": {
      "text": "Point-blank Final Dankuu Hou!\\nFire!",
      "status": "imported"
    },
    "voice_174:r_70451ffbabe2f876": {
      "text": "We'll dive right into their guard!",
      "status": "imported"
    },
    "voice_174:r_69dfa1659715e2fa": {
      "text": "Final Dankuu Hou, standby!\\nKurara!",
      "status": "imported"
    },
    "voice_174:r_d996fd6d4ef5b329": {
      "text": "Roger! Aoi, fire whenever!",
      "status": "imported"
    },
    "voice_174:r_8ab47a28f99ef565": {
      "text": "Now, Johnny!",
      "status": "imported"
    },
    "voice_174:r_546de3fb6db156ea": {
      "text": "Missile Detonator!",
      "status": "imported"
    },
    "voice_174:r_9072ea7bc71df136": {
      "text": "I really hate losing!",
      "status": "imported"
    },
    "voice_174:r_04e815a8d425827d": {
      "text": "You won't get away that easily!",
      "status": "imported"
    },
    "voice_174:r_d89011fe3e5d082a": {
      "text": "Since we're here, take this!",
      "status": "imported"
    },
    "voice_174:r_3c5b0c2ac812d5de": {
      "text": "I hate just taking a beating!",
      "status": "imported"
    },
    "voice_174:r_5b9e8897190892eb": {
      "text": "You forgot this! Keep it!",
      "status": "imported"
    },
    "voice_174:r_7bea3023abbf8a94": {
      "text": "You won't get away scot-free!",
      "status": "imported"
    },
    "voice_174:r_dd01a4c0d1b36a8d": {
      "text": "Ciao! I'm here to help!",
      "status": "imported"
    },
    "voice_174:r_20920ad2eb3542db": {
      "text": "Excuse me.\\nI'll support you!",
      "status": "imported"
    },
    "voice_174:r_cb846feec748c2e3": {
      "text": "I'll be your opponent here!",
      "status": "imported"
    },
    "voice_174:r_c958860b0676b1f5": {
      "text": "Dancouga always helps the weak!",
      "status": "imported"
    },
    "voice_174:r_5e2669b82ef75ce3": {
      "text": "Doesn't this seem a bit unfair?!",
      "status": "imported"
    },
    "voice_174:r_7847e0ed7dc9282d": {
      "text": "Well, no chasing those who leave!",
      "status": "imported"
    },
    "voice_174:r_e42b52c7a987b906": {
      "text": "I don't follow\\nanyone's footsteps!",
      "status": "imported"
    },
    "voice_174:r_6825fd1ff907bd22": {
      "text": "I'm not very good at this range.",
      "status": "imported"
    },
    "voice_174:r_607f666f1563bc0d": {
      "text": "Damn!\\nFrom all the way over there?!",
      "status": "imported"
    },
    "voice_174:r_97b7431eeb81e6b6": {
      "text": "My opponent seems awfully shy!",
      "status": "imported"
    },
    "voice_174:r_132f605d02975e71": {
      "text": "Looks like we need a pit stop!",
      "status": "imported"
    },
    "voice_174:r_9b9726b1872759d6": {
      "text": "No way! We're out of energy?!",
      "status": "imported"
    },
    "voice_174:r_1252db29683fefe0": {
      "text": "Aoi! We can't charge in time!",
      "status": "imported"
    },
    "voice_174:r_ad3d538f1e909184": {
      "text": "You're not even worth discussing.",
      "status": "imported"
    },
    "voice_174:r_8c61c59a1c0aebbf": {
      "text": "Sorry, but come back another time?",
      "status": "imported"
    },
    "voice_174:r_aba6a7662129d8ce": {
      "text": "A model can't\\nlet her skin get hurt!",
      "status": "imported"
    },
    "voice_174:r_b84afafb8a33ec60": {
      "text": "Don't underestimate a racer's eyes!",
      "status": "imported"
    },
    "voice_174:r_c8c59db85bf875e6": {
      "text": "Impressive, Aoi.",
      "status": "imported"
    },
    "voice_174:r_391aa56435d9dd6e": {
      "text": "I don't mind the compliment.",
      "status": "imported"
    },
    "voice_174:r_7c796ba53bd7ea03": {
      "text": "Wasn't that a little too close?",
      "status": "imported"
    },
    "voice_174:r_fa944da4b6519006": {
      "text": "As if! That was nothing.",
      "status": "imported"
    },
    "voice_174:r_95d047bcc17fccc6": {
      "text": "Too bad. You missed by a mile!",
      "status": "imported"
    },
    "voice_174:r_640327a12a559b31": {
      "text": "Getting cocky is dangerous.",
      "status": "imported"
    },
    "voice_174:r_bdd38c584fa313d0": {
      "text": "Such a weak blow\\ncan't hit me!",
      "status": "imported"
    },
    "voice_174:r_3fd86c1027f317c8": {
      "text": "Ooh! Big talk!",
      "status": "imported"
    },
    "voice_174:r_d0372a183d2007ad": {
      "text": "Honestly, men...!",
      "status": "imported"
    },
    "voice_174:r_217aa5e1d545b44d": {
      "text": "I know exactly what you're thinking!",
      "status": "imported"
    },
    "voice_174:r_381992c5d8224937": {
      "text": "That feels a little unfair!",
      "status": "imported"
    },
    "voice_174:r_f1e7ed9e5874aba5": {
      "text": "I don't like jokes like that.",
      "status": "imported"
    },
    "voice_174:r_fc25e66a86fc2c85": {
      "text": "Isn't it time\\nyou got serious?",
      "status": "imported"
    },
    "voice_174:r_5aeeb4917340c42d": {
      "text": "Still sizing me up?",
      "status": "imported"
    },
    "voice_174:r_b765659981b6516d": {
      "text": "No good. You don't fire me up.",
      "status": "imported"
    },
    "voice_174:r_0c427458bc00eb95": {
      "text": "Nice effort, but it's futile.",
      "status": "imported"
    },
    "voice_174:r_774a9ab4d8fd5351": {
      "text": "So, is that all?",
      "status": "imported"
    },
    "voice_174:r_d3f01de714c015bd": {
      "text": "Is that the best you can do?",
      "status": "imported"
    },
    "voice_174:r_7d2617c809fead70": {
      "text": "You're no match for us!",
      "status": "imported"
    },
    "voice_174:r_ceb935ccbf830724": {
      "text": "Aoi! They're reading your moves!",
      "status": "imported"
    },
    "voice_174:r_862ef7385bf2abd4": {
      "text": "I won't screw up again!",
      "status": "imported"
    },
    "voice_174:r_001cbec4d9a4283f": {
      "text": "Hey! Are they just playing around?!",
      "status": "imported"
    },
    "voice_174:r_8ad40afecd02b41e": {
      "text": "Maybe Dancouga's just too strong!",
      "status": "imported"
    },
    "voice_174:r_26e5efec03c03d78": {
      "text": "Sorry! I messed up a little!",
      "status": "imported"
    },
    "voice_174:r_4ad81e88c7557a8b": {
      "text": "Come on!\\nOur lives depend on you!",
      "status": "imported"
    },
    "voice_174:r_1f65a7af190e4674": {
      "text": "What's the damage?!",
      "status": "imported"
    },
    "voice_174:r_40c5a9358ed5bf29": {
      "text": "We're fine. It's nothing serious.",
      "status": "imported"
    },
    "voice_174:r_f2e18dfdfe0c89ea": {
      "text": "This isn't the time to play, Aoi.",
      "status": "imported"
    },
    "voice_174:r_cf7dbf49e96a5755": {
      "text": "I know. I'll do it right next time.",
      "status": "imported"
    },
    "voice_174:r_fa96676cc65bb509": {
      "text": "Are you all right, Eida?",
      "status": "imported"
    },
    "voice_174:r_4e37f92e7d2fc62e": {
      "text": "Yes! It was only a little shake!",
      "status": "imported"
    },
    "voice_174:r_66ab4cfe1557909d": {
      "text": "Eida! Are you all right?!",
      "status": "imported"
    },
    "voice_174:r_0bad405ee6ca63ba": {
      "text": "Oh, thank you,\\nJohnny!",
      "status": "imported"
    },
    "voice_174:r_2072eaf71a260ae7": {
      "text": "Yeah, yeah... How romantic...",
      "status": "imported"
    },
    "voice_174:r_6c13bbfd27a7799e": {
      "text": "That's a very forceful approach!",
      "status": "imported"
    },
    "voice_174:r_06f88dcbd3c9e738": {
      "text": "Ngh!\\nNow I'm getting fired up!",
      "status": "imported"
    },
    "voice_174:r_b28faf9f71bc3598": {
      "text": "An extreme battle\\nbeyond any race!",
      "status": "imported"
    },
    "voice_174:r_8a29278549f8e07a": {
      "text": "I feel danger\\nawakening inside me!",
      "status": "imported"
    },
    "voice_174:r_7e6c573c26177f98": {
      "text": "This tension... I kind of like it!",
      "status": "imported"
    },
    "voice_174:r_45abf84f7757d6eb": {
      "text": "They hit, I hit back!\\nThat's my way!",
      "status": "imported"
    },
    "voice_174:r_edd7a13ab8f06a14": {
      "text": "Waaah!",
      "status": "imported"
    },
    "voice_174:r_8165e5b41f0124c4": {
      "text": "Well, aren't you something!",
      "status": "imported"
    },
    "voice_174:r_4e05581b7432cce8": {
      "text": "Kurara! What's your damage?!",
      "status": "imported"
    },
    "voice_174:r_a60b107ea3c36a86": {
      "text": "I'm fine, so focus on attacking!",
      "status": "imported"
    },
    "voice_174:r_e33693e5ba4665b0": {
      "text": "Crap! The maintenance crew'll flip!",
      "status": "imported"
    },
    "voice_174:r_72a21a1a489af001": {
      "text": "That's scarier\\nthan this enemy!",
      "status": "imported"
    },
    "voice_174:r_eb643f8bf737a0ca": {
      "text": "Sakuya, how are things over there?!",
      "status": "imported"
    },
    "voice_174:r_0a3fccb71ec6cf2a": {
      "text": "Bad!\\nWe can't hold out much longer!",
      "status": "imported"
    },
    "voice_174:r_9b63cf1f3e0207ef": {
      "text": "Now we've got a real mess!",
      "status": "imported"
    },
    "voice_174:r_8356f4e3dcdff938": {
      "text": "Long fights hurt us.\\nEnd this fast!",
      "status": "imported"
    },
    "voice_174:r_1d6d784036ae0bd7": {
      "text": "Aoi! Pull back for a moment!",
      "status": "imported"
    },
    "voice_174:r_625664af02183c17": {
      "text": "No way!\\nWe're pushing forward here!",
      "status": "imported"
    },
    "voice_174:r_3701cba361f80ea5": {
      "text": "Eida, prepare for the next attack!",
      "status": "imported"
    },
    "voice_174:r_63f429c5c68c0863": {
      "text": "Roger! Reestablishing our posture!",
      "status": "imported"
    },
    "voice_174:r_38e4a434c91d8ef0": {
      "text": "No way! What is this thing?!",
      "status": "imported"
    },
    "voice_174:r_98ed411352a3a6ac": {
      "text": "We can't fall!\\nWe can't give up!",
      "status": "imported"
    },
    "voice_174:r_4824bea6bab3af67": {
      "text": "Strong! Painfully,\\nbetter than me!",
      "status": "imported"
    },
    "voice_174:r_862b92e63adb9734": {
      "text": "I won't release the wheel\\nor brake!",
      "status": "imported"
    },
    "voice_174:r_cb306ef55e49d107": {
      "text": "To the last,\\nI'll give my all!",
      "status": "imported"
    },
    "voice_174:r_57b2bd2de8a1408d": {
      "text": "I won't lose to them!\\nNever!",
      "status": "imported"
    },
    "voice_174:r_76f080a4881e8ab5": {
      "text": "Aaaaaaagh!",
      "status": "imported"
    },
    "voice_174:r_288133bc5b573dae": {
      "text": "We're really out of room now!",
      "status": "imported"
    },
    "voice_174:r_6f95653e548f8fcf": {
      "text": "Kurara, no whining!",
      "status": "imported"
    },
    "voice_174:r_d249d68bada91ab9": {
      "text": "Of course!\\nI'm committed to the end!",
      "status": "imported"
    },
    "voice_174:r_e9b3307e9eb69f11": {
      "text": "Ngh!\\nThings are looking pretty grim!",
      "status": "imported"
    },
    "voice_174:r_03cdac73042343ee": {
      "text": "No! The real fight starts now!",
      "status": "imported"
    },
    "voice_174:r_6026da5acbda7c69": {
      "text": "Ngh! At this rate...!",
      "status": "imported"
    },
    "voice_174:r_981f8fedd5414fe5": {
      "text": "No quitting, Aoi!\\nYou're lead pilot!",
      "status": "imported"
    },
    "voice_174:r_96bb0dcde0c8c44a": {
      "text": "Eida! At least you should escape!",
      "status": "imported"
    },
    "voice_174:r_641550a2f54cb456": {
      "text": "No!\\nI'm part of Team D too!",
      "status": "imported"
    },
    "voice_174:r_a0f2074af8debbfa": {
      "text": "Sorry...\\nI failed when needed.",
      "status": "imported"
    },
    "voice_174:r_b5f5a97ed82acb0b": {
      "text": "No way! I can't retire here!",
      "status": "imported"
    },
    "voice_174:r_d9cd2e4ded064396": {
      "text": "Let's go, all!\\nOur final battle!",
      "status": "imported"
    },
    "voice_174:r_99e6349431aaf23b": {
      "text": "I'll show 'em what I can do!!",
      "status": "imported"
    },
    "voice_174:r_2c5b7ee872c1ed7f": {
      "text": "Dankuuken!",
      "status": "imported"
    },
    "voice_174:r_76d1e51c8b494a60": {
      "text": "Haaaaaaaaaaaah!",
      "status": "imported"
    },
    "voice_174:r_eb5f687fcd372ae7": {
      "text": "Dankuu Dangaiken!",
      "status": "imported"
    },
    "voice_174:r_2329428a6871d9fa": {
      "text": "Haaaaaaaaaaaaaah!!",
      "status": "imported"
    },
    "voice_174:r_efa71f7a4cc33ff3": {
      "text": "Dankuuken!",
      "status": "imported"
    },
    "voice_174:r_3fc2e1186557e7a0": {
      "text": "I'm staking everything on this blow!",
      "status": "imported"
    },
    "voice_174:r_fa6930340a545054": {
      "text": "Dankuu! Dangaikeeen!!",
      "status": "imported"
    },
    "voice_174:r_2332b9d56461d7ab": {
      "text": "Goooooooooooo!!",
      "status": "imported"
    },
    "voice_174:r_854aa0a91a3c80d1": {
      "text": "This mission was really tough too.",
      "status": "imported"
    },
    "voice_174:r_0bc8ae32a406ceab": {
      "text": "Yeah... You fought with us. Thanks!",
      "status": "imported"
    },
    "voice_174:r_82c09f011d703b2c": {
      "text": "Thanks for all your hard work!",
      "status": "imported"
    },
    "voice_174:r_2b4d8818c77b6dca": {
      "text": "Next time, fight with us agaaain!",
      "status": "imported"
    },
    "voice_174:r_087354f2db0a31e6": {
      "text": "Let's show them what we've got!",
      "status": "imported"
    },
    "voice_174:r_db02a2dec93dd263": {
      "text": "If anyone's tired, it's the player!",
      "status": "imported"
    },
    "voice_174:r_d520c6d5298a848d": {
      "text": "Make sure you get plenty of rest!",
      "status": "imported"
    },
    "voice_174:r_099e2458cabf796f": {
      "text": "Ahh! It's over! Finally!",
      "status": "imported"
    },
    "voice_174:r_fd910d714be70870": {
      "text": "Your playthrough was blazing hot!",
      "status": "imported"
    },
    "voice_174:r_9736f29b11344ec3": {
      "text": "Let's see... Super Robot Wars Z?",
      "status": "imported"
    },
    "voice_174:r_fcd05582aa5c6068": {
      "text": "Kidding! Read the clear data guide!",
      "status": "imported"
    },
    "voice_174:r_bece29562818acba": {
      "text": "Strike, Valor, Alert, Luck, Gain...",
      "status": "imported"
    },
    "voice_174:r_494b5da92ed24ecb": {
      "text": "I see... I'll remember that.",
      "status": "imported"
    },
    "voice_174:r_a4a5a96f4bd58920": {
      "text": "Then let me share a useful tip!",
      "status": "imported"
    },
    "voice_174:r_b57d2d74233f889a": {
      "text": "Save clear data. You'll need it!",
      "status": "imported"
    },
    "voice_174:r_cd06d0820d82524b": {
      "text": "Sure! I read Monthly Men's SRW!",
      "status": "imported"
    },
    "voice_174:r_c94c6d04be583774": {
      "text": "So you were in here playing games!",
      "status": "imported"
    },
    "voice_174:r_e54e2c99ef8297af": {
      "text": "How the hell do you know that?",
      "status": "imported"
    },
    "voice_174:r_f16a3eb0bcaac082": {
      "text": "Let's show them what we've got!",
      "status": "imported"
    },
    "voice_174:r_10a408809e512df1": {
      "text": "What fascinating behavior.",
      "status": "imported"
    },
    "voice_174:r_bc7b9e308b879dd4": {
      "text": "Troubling... We're out of moves!",
      "status": "imported"
    },
    "voice_174:r_98902fd3143c393e": {
      "text": "Battle gets familiar,\\nit's routine.",
      "status": "imported"
    },
    "voice_174:r_d907fbd7bc1c4298": {
      "text": "You underestimated our equipment!",
      "status": "imported"
    },
    "voice_174:r_96b21e3a028dd074": {
      "text": "Damage check...\\nNo need, actually.",
      "status": "imported"
    },
    "voice_174:r_ce140b5d8e6b7310": {
      "text": "Bad... Things aren't looking good.",
      "status": "imported"
    },
    "voice_174:r_0e0335789c5396d7": {
      "text": "Feels like we're hunting kaiju!",
      "status": "imported"
    },
    "voice_174:r_a8e85bd950696403": {
      "text": "Fail to read them,\\nthis happens!",
      "status": "imported"
    },
    "voice_174:r_772c8bc40ab6cb61": {
      "text": "Thrilling!\\nNow this is a fight!",
      "status": "imported"
    },
    "voice_174:r_58dd2826a199ef51": {
      "text": "P-please don't let us go boom!",
      "status": "imported"
    },
    "voice_174:r_1428fe5f35a9427b": {
      "text": "Why, you! No hit-and-run for you!",
      "status": "imported"
    },
    "voice_174:r_96d39b8bdfa6f183": {
      "text": "I'll show you my blazing finisher!",
      "status": "imported"
    },
    "voice_174:r_0e4f9b8a2d26ebff": {
      "text": "Boost Nova Knuckle!!",
      "status": "imported"
    },
    "voice_174:r_79e0d542fe12bcf7": {
      "text": "Ow! You got way too cocky!",
      "status": "imported"
    },
    "voice_174:r_eff747ba39a55393": {
      "text": "There must still be a chance to win!",
      "status": "imported"
    },
    "voice_174:r_b2dc77aa6dd77e69": {
      "text": "I'll endure these wounds by will!",
      "status": "imported"
    },
    "voice_174:r_445d40d8b5d7092b": {
      "text": "They're stronger than we expected!",
      "status": "imported"
    },
    "voice_174:r_bbb633cb5e8e6daf": {
      "text": "Kyaaaah!",
      "status": "imported"
    },
    "voice_174:r_0abd8b6c713ccdac": {
      "text": "Super Beast Fusion!",
      "status": "imported"
    },
    "voice_174:r_f4ff463b2fda1b86": {
      "text": "Dancouga Nova Max God!",
      "status": "imported"
    },
    "voice_174:r_4e63c037d3cb8a3d": {
      "text": "Super Beast Fusion!",
      "status": "imported"
    },
    "voice_174:r_9ca8d188ae805e3a": {
      "text": "Dancouga Nova!",
      "status": "imported"
    },
    "voice_174:r_c894e35becf35a03": {
      "text": "I'm not really the hot-blooded type!",
      "status": "imported"
    },
    "voice_174:r_79b1abf5fc86483c": {
      "text": "Change, Elephant!\\nHumanoid Mode!",
      "status": "imported"
    },
    "voice_174:r_e9a11621911acb19": {
      "text": "Change, Liger!\\nHumanoid Mode!",
      "status": "imported"
    },
    "voice_174:r_d52bece55796f599": {
      "text": "Change, Rhinos! Humanoid Mode!",
      "status": "imported"
    },
    "voice_174:r_358fe5a50bbee1df": {
      "text": "I'll make it happen!",
      "status": "imported"
    },
    "voice_174:r_638834e16724002f": {
      "text": "I'll show 'em!\\nHeh, said it first.",
      "status": "imported"
    },
    "voice_174:r_b02fca1590ac1210": {
      "text": "Change, Eagle!\\nHumanoid Mode!",
      "status": "imported"
    },
    "voice_174:r_f0344d2fbaa9db77": {
      "text": "I told you, don't say it first!",
      "status": "imported"
    },
    "voice_174:r_3328eef766ff2c2c": {
      "text": "I'll complete my R-Daigan mission!",
      "status": "imported"
    },
    "voice_174:r_0e58a97c7f8c9ecf": {
      "text": "We'll keep going, F.S.!",
      "status": "imported"
    },
    "voice_174:r_46e80691278d2e90": {
      "text": "Dragon's Hive\\nis home to us!",
      "status": "imported"
    },
    "voice_174:r_c4c8af04ee11993c": {
      "text": "We've got to protect our employer!",
      "status": "imported"
    },
    "voice_174:r_ef1ca3b6b4a983b9": {
      "text": "All obstacles will move aside!",
      "status": "imported"
    },
    "voice_174:r_cdfaf9cd1fd55c77": {
      "text": "Now it's Dancouga Nova's turn!",
      "status": "imported"
    },
    "voice_174:r_3d2454ac7a0fed22": {
      "text": "No overtime.\\nLet's finish this fast!",
      "status": "imported"
    },
    "voice_174:r_437f5e90c3bb0592": {
      "text": "Team D has arrived! Just kidding.",
      "status": "imported"
    },
    "voice_174:r_cf9a2e6954ba3564": {
      "text": "All right! I'm itching for action!",
      "status": "imported"
    },
    "voice_174:r_a9474d20d8dd3193": {
      "text": "You won't escape!",
      "status": "imported"
    },
    "voice_174:r_25b3885e2565f90b": {
      "text": "This is payback!",
      "status": "imported"
    },
    "voice_174:r_96858669715407f1": {
      "text": "Then allow me to return the favor!",
      "status": "imported"
    },
    "voice_174:r_2bb2a166baa517b9": {
      "text": "Feels like I'm stealing your kill!",
      "status": "imported"
    },
    "voice_174:r_34be00b434b42bea": {
      "text": "One more time! Let's show 'em!",
      "status": "imported"
    },
    "voice_174:r_5b9baad61908571a": {
      "text": "Too bad.\\nI won't miss that opening!",
      "status": "imported"
    },
    "voice_174:r_7eedcce1036b4f4a": {
      "text": "It's finally my turn! One more shot!",
      "status": "imported"
    },
    "voice_174:r_e016bd611281c0a6": {
      "text": "Ngh! Ughhh...!",
      "status": "imported"
    },
    "voice_174:r_aa211e3c1f473e51": {
      "text": "Not yet!\\nWe can still do something!",
      "status": "imported"
    },
    "voice_174:r_c07813b8d06a7217": {
      "text": "This fight's getting pretty brutal!",
      "status": "imported"
    },
    "voice_174:r_81a6bca77bc301c0": {
      "text": "I don't like\\ngreedy types!",
      "status": "imported"
    },
    "voice_174:r_febe65de885f155a": {
      "text": "Seems\\nwe'll need to get serious!",
      "status": "imported"
    },
    "voice_174:r_c081014541c22ae4": {
      "text": "With this gap in power,\\nno contest.",
      "status": "imported"
    },
    "voice_174:r_3840c01b1a9bf34b": {
      "text": "Listen,\\nwe have no time to play!",
      "status": "imported"
    },
    "voice_174:r_f03ef5034d024e8e": {
      "text": "That's painfully obvious.",
      "status": "imported"
    },
    "voice_174:r_bc1a77b291081b0f": {
      "text": "Sorry, but\\nI hate being touched.",
      "status": "imported"
    },
    "voice_174:r_94089c60b94d9a81": {
      "text": "Amazing, Sammy! Even this equipment!",
      "status": "imported"
    },
    "voice_174:r_42c897bd608f37fd": {
      "text": "Time you learned how vast space is!",
      "status": "imported"
    },
    "voice_174:r_689700a088dc2f5b": {
      "text": "You'll regret targeting Earth!",
      "status": "imported"
    },
    "voice_174:r_5a1e097aa0ec9859": {
      "text": "More reasonable\\nthan Moon WILL.",
      "status": "imported"
    },
    "voice_174:r_2a8d41aa8f4749ec": {
      "text": "Let's show them Earth's resolve!",
      "status": "imported"
    },
    "voice_174:r_01c80710474b30ae": {
      "text": "Looks like talking is pointless.",
      "status": "imported"
    },
    "voice_174:r_870a7c766b4e2144": {
      "text": "A silent invasion? You've got nerve!",
      "status": "imported"
    },
    "voice_174:r_a9f39df34c38f5b3": {
      "text": "If there's a fight,\\nwe show up too!",
      "status": "imported"
    },
    "voice_174:r_c9f83672cc4c8866": {
      "text": "We'll teach you\\nto swear off war!",
      "status": "imported"
    },
    "voice_174:r_19631c3492e99773": {
      "text": "Earth's in ruins,\\nstill more war?",
      "status": "imported"
    },
    "voice_174:r_a49cb27d62c078ed": {
      "text": "We're working too.\\nSorry!",
      "status": "imported"
    },
    "voice_174:r_b6a1f76ff2f0b93d": {
      "text": "We meant no fight\\nwith the military!",
      "status": "imported"
    },
    "voice_174:r_50c7272601f9608b": {
      "text": "Sorry,\\nmy fire-up list is closed!",
      "status": "imported"
    },
    "voice_174:r_9783be4881baaf30": {
      "text": "Such bloodlust... Tough one!",
      "status": "imported"
    },
    "voice_174:r_7a533f3a77a702e3": {
      "text": "Want a strong foe?\\nDancouga's game!",
      "status": "imported"
    },
    "voice_174:r_f13d4928e70aad04": {
      "text": "Damn the gods!\\nOur future is ours!",
      "status": "imported"
    },
    "voice_174:r_bf8c22ddf5e5ebc4": {
      "text": "Life is wanted!\\nA god denying that?!",
      "status": "imported"
    },
    "voice_174:r_9ca308feda543481": {
      "text": "Biggest since Moon WILL!\\nBring it!",
      "status": "imported"
    },
    "voice_174:r_75727ed69511d963": {
      "text": "Let's help\\nthese troubled kids.",
      "status": "imported"
    },
    "voice_174:r_c4afbc5dcb6aff0f": {
      "text": "Leave the rest to your big sisters!",
      "status": "imported"
    },
    "voice_174:r_a4891580f1ed7c34": {
      "text": "Foe then, friend now.\\nWe'll help!",
      "status": "imported"
    },
    "voice_174:r_4d90cfb045501000": {
      "text": "Big sisters protect kids, you know!",
      "status": "imported"
    },
    "voice_174:r_d23baf327f21df3d": {
      "text": "I hate seeing children cry!",
      "status": "imported"
    },
    "voice_174:r_7eb1ff91e6dd4579": {
      "text": "What're you doing?!\\nYou're stronger!",
      "status": "imported"
    },
    "voice_174:r_8613ff1ecb2e0b6d": {
      "text": "Maybe a white flag would surprise?",
      "status": "imported"
    },
    "voice_174:r_cd9a2530d3339bb9": {
      "text": "Their culture, huh?\\nWe could try it.",
      "status": "imported"
    },
    "voice_174:r_c3e2c2524e6af617": {
      "text": "Wanting something to fire you up...",
      "status": "imported"
    },
    "voice_174:r_08e1901fa81a3ce2": {
      "text": "We're every bit as good!",
      "status": "imported"
    },
    "voice_174:r_c33c630320a0f42d": {
      "text": "Flattered, but\\nI'm loyal. Really!",
      "status": "imported"
    },
    "voice_174:r_2890b43c4f3875b2": {
      "text": "Kurara, you're way off.",
      "status": "imported"
    },
    "voice_174:r_7e84498103e0d8e2": {
      "text": "End this!\\nOur power tops gods!",
      "status": "imported"
    },
    "voice_174:r_f1795d62699fbde5": {
      "text": "I'll show 'em what I can do!",
      "status": "imported"
    },
    "voice_174:r_49f278326a3ba3df": {
      "text": "I'm getting fired up too!",
      "status": "imported"
    },
    "voice_174:r_00d67eda0ca8bcac": {
      "text": "Same words, no sense.\\nCulture shock.",
      "status": "imported"
    },
    "voice_174:r_cb6f5f32c512bd06": {
      "text": "We refuse\\nyour gift of invasion!",
      "status": "imported"
    },
    "voice_174:r_1908b4bfabaaf397": {
      "text": "Don't tell me...\\nYou're from Earth?",
      "status": "imported"
    },
    "voice_174:r_299353f629fec323": {
      "text": "Not behind me...\\nYou won't get that.",
      "status": "imported"
    },
    "voice_174:r_be7defc50f86d5b5": {
      "text": "We're real champions of justice now.",
      "status": "imported"
    },
    "voice_174:r_91cf32ef70b44e2d": {
      "text": "Whoa, they're swarming everywhere!",
      "status": "imported"
    },
    "voice_174:r_1f7722403476a2d4": {
      "text": "All right, come quietly!",
      "status": "imported"
    },
    "voice_174:r_bb64cc3e79718d28": {
      "text": "Not my drug beat...\\nCan't ignore it!",
      "status": "imported"
    },
    "voice_174:r_fbe010968c59557d": {
      "text": "I can't forgive terrorists!",
      "status": "imported"
    },
    "voice_174:r_233105911ffd7216": {
      "text": "Attack the army,\\nget trouble later!",
      "status": "imported"
    },
    "voice_174:r_e2cfe1dd207eff04": {
      "text": "Quite a thrill.\\nLast mission! Go!",
      "status": "imported"
    },
    "voice_174:r_d8066ba2d8e44a06": {
      "text": "We'll survive!\\nNo matter who!",
      "status": "imported"
    },
    "voice_174:r_bbb8bd651042a9bf": {
      "text": "Alien overtech -\\nfascinating.",
      "status": "imported"
    },
    "voice_174:r_f2c3d6c2e5157100": {
      "text": "Don't be fooled,\\nI've fought aliens.",
      "status": "imported"
    },
    "voice_174:r_5719486984cbef30": {
      "text": "Honestly...\\nNo business manners.",
      "status": "imported"
    },
    "voice_174:r_a04b5de0e98d451e": {
      "text": "Dancouga's a Super Robot.\\nNo mercy!",
      "status": "imported"
    },
    "voice_174:r_fd82c979e1dfdd1b": {
      "text": "No shared tongue,\\nso talk is futile.",
      "status": "imported"
    },
    "voice_174:r_5347e0a72d1255e2": {
      "text": "Well, now.\\nIt's like an SF movie!",
      "status": "imported"
    },
    "voice_174:r_1211f02e2cb813d7": {
      "text": "If only\\nwe could talk and negotiate.",
      "status": "imported"
    },
    "voice_174:r_c277e50bcc5ab42d": {
      "text": "Now, let me play the hero!",
      "status": "imported"
    },
    "voice_174:r_aff5a6fbc01acc8d": {
      "text": "Only fifty years.\\nQuit that group!",
      "status": "imported"
    },
    "voice_174:r_b2b3fe6a1ef90b22": {
      "text": "So you're the final boss!",
      "status": "imported"
    },
    "voice_174:r_cfd4ac1866ac60f7": {
      "text": "Final mission -\\nI'll burn hot too!",
      "status": "imported"
    },
    "voice_174:r_6da6eb14aeca70a4": {
      "text": "No god's servant.\\nIt surpasses gods!",
      "status": "imported"
    },
    "voice_174:r_e0a655a4464d86f3": {
      "text": "Turn tail and run while you can!",
      "status": "imported"
    },
    "voice_174:r_f40d920d8960ab48": {
      "text": "Everyone's lives are in my hands!",
      "status": "imported"
    },
    "voice_174:r_16b64f722a458774": {
      "text": "Don't mock human power,\\nyou alien!",
      "status": "imported"
    },
    "voice_174:r_8a25bf55dcc36b04": {
      "text": "Same words, no accord!\\nHumans too!",
      "status": "imported"
    },
    "voice_174:r_a386e0756c8933b3": {
      "text": "No shared words,\\nthen we fight!",
      "status": "imported"
    },
    "voice_174:r_189a0e6670ccbe8b": {
      "text": "For Earth,\\nDancouga takes you on!",
      "status": "imported"
    },
    "voice_174:r_b317647e46f8a9ec": {
      "text": "No mercy for terrorists!",
      "status": "imported"
    },
    "voice_174:r_58bef1a0aaf888df": {
      "text": "Punish bad guys...\\nNice and simple!",
      "status": "imported"
    },
    "voice_174:r_dcf8c4e08d63fab3": {
      "text": "No more!\\nWhy drag out this war?!",
      "status": "imported"
    },
    "voice_174:r_9629de991575f44e": {
      "text": "The army...\\nHope this goes smoothly.",
      "status": "imported"
    },
    "voice_174:r_88d2398f1f12ffe8": {
      "text": "Army or not,\\na mission's a mission!",
      "status": "imported"
    },
    "voice_174:r_b05079ed8ff917ef": {
      "text": "Won our future once!\\nWe will again!",
      "status": "imported"
    },
    "voice_174:r_15761052eb1798f2": {
      "text": "God or not!\\nI'll get it done!",
      "status": "imported"
    },
    "voice_174:r_755f051b9e6c48ca": {
      "text": "Then please, go ahead.",
      "status": "imported"
    },
    "voice_174:r_7cb04b0c2ddf0a92": {
      "text": "All right! I'll show 'em!",
      "status": "imported"
    },
    "voice_174:r_8bc4a4656f6f9cd3": {
      "text": "A perfect setup... Feels odd.",
      "status": "imported"
    },
    "voice_174:r_1af5909260e38782": {
      "text": "I'll get it done!",
      "status": "imported"
    },
    "voice_174:r_6edbedf0f1cf42fb": {
      "text": "Well then, shall we go?",
      "status": "imported"
    },
    "voice_174:r_8e343a83a7dce229": {
      "text": "After I went to all that effort...!",
      "status": "imported"
    },
    "voice_174:r_e644dc64c0a29695": {
      "text": "This month's A Man's Alien says...",
      "status": "imported"
    },
    "voice_174:r_34cb40ff82dfa2bb": {
      "text": "Forget it.\\nControl the generator!",
      "status": "imported"
    },
    "voice_174:r_406087caba7ae52e": {
      "text": "All right! Nova Knuckle is next!",
      "status": "imported"
    },
    "voice_174:r_3b368b0612a391e8": {
      "text": "Boost Nova Knuckle!",
      "status": "imported"
    },
    "voice_174:r_cb285c8939c64487": {
      "text": "I'll draw them with Nova Knuckle!",
      "status": "imported"
    },
    "voice_174:r_98fc445b02cb2046": {
      "text": "Boost Nova... Knuckle!",
      "status": "imported"
    },
    "voice_174:r_f4b789f39c1c7670": {
      "text": "Let's concentrate our fire!",
      "status": "imported"
    },
    "voice_174:r_4d49308e9e0222b0": {
      "text": "Then pardon me for going ahead!",
      "status": "imported"
    },
    "voice_174:r_bc04d65d5261e01d": {
      "text": "Team D here!\\nWe'll go first!",
      "status": "imported"
    },
    "voice_174:r_407f9599aaa17be1": {
      "text": "Yeah! Nice teamwork!",
      "status": "imported"
    },
    "voice_174:r_4f499a8c835c0698": {
      "text": "Allow me to be your opponent!",
      "status": "imported"
    },
    "voice_174:r_ef7e76b4d4bf74b0": {
      "text": "One-on-one! You won't escape!",
      "status": "imported"
    },
    "voice_174:r_548917aa00265172": {
      "text": "Roger! I'll lend a hand!",
      "status": "imported"
    },
    "voice_174:r_ed133d8d2201c939": {
      "text": "Got it! Leave this side to me!",
      "status": "imported"
    }
  }
}
