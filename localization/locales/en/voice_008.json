{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_008:r_479b340ccc6c572b": {
      "text": "Found you!",
      "status": "imported"
    },
    "voice_008:r_77949221bf58f862": {
      "text": "Here! Your ticket straight to hell!",
      "status": "imported"
    },
    "voice_008:r_70b9c4b9f1f37eff": {
      "text": "You total amateur!",
      "status": "imported"
    },
    "voice_008:r_9fcb3754cb1773c7": {
      "text": "Let's make this party a blast!",
      "status": "imported"
    },
    "voice_008:r_3559d2fad32c2435": {
      "text": "Now this feels good! The best!",
      "status": "imported"
    },
    "voice_008:r_f7570547e9f80a64": {
      "text": "This is how Firebug does things!",
      "status": "imported"
    },
    "voice_008:r_cbab0f4720e1fcf1": {
      "text": "Firebug ain't no firefly!",
      "status": "imported"
    },
    "voice_008:r_0bbe0b4f5364e732": {
      "text": "I'll set your life on fire!",
      "status": "imported"
    },
    "voice_008:r_5dda5198137cb02a": {
      "text": "Goodbye, world! Hello, afterlife!",
      "status": "imported"
    },
    "voice_008:r_83ec59afbecdec14": {
      "text": "Sorry! But I've got a job to do!",
      "status": "imported"
    },
    "voice_008:r_e20bfd42ad95a3c9": {
      "text": "Come on! Space out and you're dead!",
      "status": "imported"
    },
    "voice_008:r_0f58a8822381e57f": {
      "text": "You run! I shoot!",
      "status": "imported"
    },
    "voice_008:r_6dbcc507fb61b51d": {
      "text": "Let's crank up the excitement!",
      "status": "imported"
    },
    "voice_008:r_b42ab697149a7c8a": {
      "text": "Ha ha ha! Now this is getting fun!",
      "status": "imported"
    },
    "voice_008:r_4de4fcf3b440baf4": {
      "text": "Burglar means robber.\\nGot that?",
      "status": "imported"
    },
    "voice_008:r_0121a166c715cdff": {
      "text": "Axio or not,\\ndon't count it out!",
      "status": "imported"
    },
    "voice_008:r_30fad37a42bd3ad3": {
      "text": "Get to work, you piece of junk!",
      "status": "imported"
    },
    "voice_008:r_80a0b2a84e05d81a": {
      "text": "Hello!\\nAn invitation to hell!",
      "status": "imported"
    },
    "voice_008:r_4a9ac1dff86506d9": {
      "text": "Heave-ho, set! Heave-ho, shoot!",
      "status": "imported"
    },
    "voice_008:r_bc8538e6af3d2577": {
      "text": "You idiot! You're in my range!",
      "status": "imported"
    },
    "voice_008:r_924516c8de2b5342": {
      "text": "I'll shoot through your heart!",
      "status": "imported"
    },
    "voice_008:r_da1174533722333f": {
      "text": "Here comes the zap! Zaaap!",
      "status": "imported"
    },
    "voice_008:r_fdeb8162976e72c1": {
      "text": "Here you go! Just a little poke!",
      "status": "imported"
    },
    "voice_008:r_0fadb5c26df92b42": {
      "text": "I'll tear through your cockpit!",
      "status": "imported"
    },
    "voice_008:r_6b15af9a0057cdc8": {
      "text": "Close combat's my specialty!",
      "status": "imported"
    },
    "voice_008:r_15b4a90140e8a33a": {
      "text": "Warm-up's over! Now for real!",
      "status": "imported"
    },
    "voice_008:r_af884a6b11dff121": {
      "text": "Gundam, baby! I've missed you!",
      "status": "imported"
    },
    "voice_008:r_ac6fe7838e95647b": {
      "text": "As of today, I'm a Gundam killer!",
      "status": "imported"
    },
    "voice_008:r_77ca87eacd17ad52": {
      "text": "Bang, bang, bang, bang! Shut up!",
      "status": "imported"
    },
    "voice_008:r_bf3244994760e535": {
      "text": "Nab the Gundam and sell it to Feds!",
      "status": "imported"
    },
    "voice_008:r_aabfb21c9d069ce7": {
      "text": "My, aren't we brave, Super?",
      "status": "imported"
    },
    "voice_008:r_02479dc8fe989560": {
      "text": "You're Super, so I'll slice you up!",
      "status": "imported"
    },
    "voice_008:r_a2df00f91a9b0a9e": {
      "text": "I'll take your Super Robot title!",
      "status": "imported"
    },
    "voice_008:r_48b60d6c48b9b142": {
      "text": "Easy life for a salaryman...\\nNot!",
      "status": "imported"
    },
    "voice_008:r_665f01666859013b": {
      "text": "Give up your bonus,\\nand you can go!",
      "status": "imported"
    },
    "voice_008:r_ddbe581c5ea9183d": {
      "text": "You stubborn stiff! Brace yourself!",
      "status": "imported"
    },
    "voice_008:r_d4430bf362340b32": {
      "text": "I'll pierce that prized armor!",
      "status": "imported"
    },
    "voice_008:r_b7b5625d7cd4282f": {
      "text": "You join, split - always so busy!",
      "status": "imported"
    },
    "voice_008:r_920740a0219c5085": {
      "text": "S-Stop!\\nThat drill makes me dizzy!",
      "status": "imported"
    },
    "voice_008:r_a8451712c57c1a72": {
      "text": "Go dig your own grave!",
      "status": "imported"
    },
    "voice_008:r_3633df5b7b8f47fa": {
      "text": "No fear, no fear! Animals are pals!",
      "status": "imported"
    },
    "voice_008:r_52dfc56b14b93551": {
      "text": "Joined up?\\nI'll rip you apart!",
      "status": "imported"
    },
    "voice_008:r_1b9b2aab5cb104da": {
      "text": "Size alone won't win this!",
      "status": "imported"
    },
    "voice_008:r_342044c706a2340f": {
      "text": "Oh no!\\nChasing you makes me dizzy!",
      "status": "imported"
    },
    "voice_008:r_cf41e8828a90cbdb": {
      "text": "Me...\\nI act big around little guys!",
      "status": "imported"
    },
    "voice_008:r_719e897304ec42d4": {
      "text": "Clang! You get one bell!",
      "status": "imported"
    },
    "voice_008:r_d5e0a2317c40d322": {
      "text": "I'm great at swatting flies!",
      "status": "imported"
    },
    "voice_008:r_ec2ea17765052401": {
      "text": "You're dead before you transform!",
      "status": "imported"
    },
    "voice_008:r_f2d4255f1c2f7542": {
      "text": "Speed straight on down to hell!",
      "status": "imported"
    },
    "voice_008:r_5d08ad19e2da125b": {
      "text": "Leaders earn me a bonus!",
      "status": "imported"
    },
    "voice_008:r_a7246b52782a877e": {
      "text": "An ace should always face an ace!",
      "status": "imported"
    },
    "voice_008:r_dc8701f6bcb9904f": {
      "text": "Sink the warship and I'm the hero!",
      "status": "imported"
    },
    "voice_008:r_d6bdd730f24f66eb": {
      "text": "Hit the bridge,\\nand this is easy!",
      "status": "imported"
    },
    "voice_008:r_7bea3023abbf8a94": {
      "text": "I'll ride someone else's coattails!",
      "status": "imported"
    },
    "voice_008:r_dd01a4c0d1b36a8d": {
      "text": "I'm Firebug's resident remora!",
      "status": "imported"
    },
    "voice_008:r_20920ad2eb3542db": {
      "text": "Called, I popped out - and whatnot!",
      "status": "imported"
    },
    "voice_008:r_0ab7914877fd48ed": {
      "text": "I'll take the easiest win I can!",
      "status": "imported"
    },
    "voice_008:r_cb846feec748c2e3": {
      "text": "Yeah, yeah! Out of my way!",
      "status": "imported"
    },
    "voice_008:r_c958860b0676b1f5": {
      "text": "H-Hey! Quit pushing!",
      "status": "imported"
    },
    "voice_008:r_5e2669b82ef75ce3": {
      "text": "What?! I'm the shield, seriously?!",
      "status": "imported"
    },
    "voice_008:r_7847e0ed7dc9282d": {
      "text": "Seriously?! I'm the sacrifice?!",
      "status": "imported"
    },
    "voice_008:r_e42b52c7a987b906": {
      "text": "Seriously?! I can't counter?!",
      "status": "imported"
    },
    "voice_008:r_6825fd1ff907bd22": {
      "text": "No waaay! What's going on here?!",
      "status": "imported"
    },
    "voice_008:r_607f666f1563bc0d": {
      "text": "Huh? Huh? I'm really off today...",
      "status": "imported"
    },
    "voice_008:r_97b7431eeb81e6b6": {
      "text": "I can counter! I just won't!",
      "status": "imported"
    },
    "voice_008:r_132f605d02975e71": {
      "text": "Damn it! I'm all out?!",
      "status": "imported"
    },
    "voice_008:r_9b9726b1872759d6": {
      "text": "Hmm...\\nYou know combat basics...!",
      "status": "imported"
    },
    "voice_008:r_1252db29683fefe0": {
      "text": "Hmph... From afar?\\nScared of me?",
      "status": "imported"
    },
    "voice_008:r_ad3d538f1e909184": {
      "text": "Yeah, yeah! See? I can't reach you!",
      "status": "imported"
    },
    "voice_008:r_8c61c59a1c0aebbf": {
      "text": "Hmph... That was my afterimage.",
      "status": "imported"
    },
    "voice_008:r_aba6a7662129d8ce": {
      "text": "Hey!\\nAre you even serious?!",
      "status": "imported"
    },
    "voice_008:r_b84afafb8a33ec60": {
      "text": "This won't even cure my boredom!",
      "status": "imported"
    },
    "voice_008:r_c8c59db85bf875e6": {
      "text": "I got serious... What a waste.",
      "status": "imported"
    },
    "voice_008:r_391aa56435d9dd6e": {
      "text": "Did you see those dazzling moves?",
      "status": "imported"
    },
    "voice_008:r_7c796ba53bd7ea03": {
      "text": "Here I go!\\nHop, skip, and jump!",
      "status": "imported"
    },
    "voice_008:r_fa944da4b6519006": {
      "text": "Useless! Completely useless!",
      "status": "imported"
    },
    "voice_008:r_640327a12a559b31": {
      "text": "I just can't get fired up.",
      "status": "imported"
    },
    "voice_008:r_bdd38c584fa313d0": {
      "text": "What is this, a preschool recital?",
      "status": "imported"
    },
    "voice_008:r_3fd86c1027f317c8": {
      "text": "Aw... Now my armor's scratched.",
      "status": "imported"
    },
    "voice_008:r_d0372a183d2007ad": {
      "text": "No way! You call that an attack?!",
      "status": "imported"
    },
    "voice_008:r_217aa5e1d545b44d": {
      "text": "Kummen's bugs\\nhit harder than that!",
      "status": "imported"
    },
    "voice_008:r_381992c5d8224937": {
      "text": "I won't play house with you!",
      "status": "imported"
    },
    "voice_008:r_f1e7ed9e5874aba5": {
      "text": "Not bad! I'll give you 60 points!",
      "status": "imported"
    },
    "voice_008:r_fc25e66a86fc2c85": {
      "text": "YES! Nice attack!",
      "status": "imported"
    },
    "voice_008:r_5aeeb4917340c42d": {
      "text": "Nice one, not bad!\\nThat's amazing!",
      "status": "imported"
    },
    "voice_008:r_b765659981b6516d": {
      "text": "No way! Was that a lucky hit?!",
      "status": "imported"
    },
    "voice_008:r_0c427458bc00eb95": {
      "text": "Hold it!\\nMy cockpit shorted out!",
      "status": "imported"
    },
    "voice_008:r_774a9ab4d8fd5351": {
      "text": "Whoa! The cockpit's shaking hard!",
      "status": "imported"
    },
    "voice_008:r_d3f01de714c015bd": {
      "text": "W-Wait! We can talk this out!",
      "status": "imported"
    },
    "voice_008:r_7d2617c809fead70": {
      "text": "Crap! Some guts came out my mouth!",
      "status": "imported"
    },
    "voice_008:r_ceb935ccbf830724": {
      "text": "Are you serious, Gundam?!",
      "status": "imported"
    },
    "voice_008:r_862ef7385bf2abd4": {
      "text": "Gundam just can't take a joke!",
      "status": "imported"
    },
    "voice_008:r_001cbec4d9a4283f": {
      "text": "This is why Gundams suck...!",
      "status": "imported"
    },
    "voice_008:r_8ad40afecd02b41e": {
      "text": "I-It's Super and then some!",
      "status": "imported"
    },
    "voice_008:r_26e5efec03c03d78": {
      "text": "Wait!\\nThat's way too Super!",
      "status": "imported"
    },
    "voice_008:r_4ad81e88c7557a8b": {
      "text": "That's why\\nI hate Super Robots!",
      "status": "imported"
    },
    "voice_008:r_1f65a7af190e4674": {
      "text": "Hold it!\\nYou broke the speed limit!",
      "status": "imported"
    },
    "voice_008:r_40c5a9358ed5bf29": {
      "text": "W-What?! Is that a magic trick?!",
      "status": "imported"
    },
    "voice_008:r_cf7dbf49e96a5755": {
      "text": "Crap! I took that runt too lightly!",
      "status": "imported"
    },
    "voice_008:r_45abf84f7757d6eb": {
      "text": "H-Hey...! That's going too far!",
      "status": "imported"
    },
    "voice_008:r_edd7a13ab8f06a14": {
      "text": "That bastard...! No ordinary enemy!",
      "status": "imported"
    },
    "voice_008:r_8165e5b41f0124c4": {
      "text": "Hot, hot! My cockpit's on fire!",
      "status": "imported"
    },
    "voice_008:r_4e05581b7432cce8": {
      "text": "Hold on! This really hurts!",
      "status": "imported"
    },
    "voice_008:r_a60b107ea3c36a86": {
      "text": "What now?!\\nAm I in a nightmare?!",
      "status": "imported"
    },
    "voice_008:r_e33693e5ba4665b0": {
      "text": "Talibia was less hellish\\nthan this!",
      "status": "imported"
    },
    "voice_008:r_72a21a1a489af001": {
      "text": "Enough!\\nThis isn't funny anymore!",
      "status": "imported"
    },
    "voice_008:r_eb643f8bf737a0ca": {
      "text": "Damn it! You don't know restraint!",
      "status": "imported"
    },
    "voice_008:r_0a3fccb71ec6cf2a": {
      "text": "Whoa!\\nI may not make it this time!",
      "status": "imported"
    },
    "voice_008:r_9b63cf1f3e0207ef": {
      "text": "Crap!\\nRed vision, black future!",
      "status": "imported"
    },
    "voice_008:r_8356f4e3dcdff938": {
      "text": "Fine!\\nI'll run when I get a chance!",
      "status": "imported"
    },
    "voice_008:r_1d6d784036ae0bd7": {
      "text": "Y-You cheat! You cheat!!",
      "status": "imported"
    },
    "voice_008:r_625664af02183c17": {
      "text": "Damn it! Daaaaamn it!",
      "status": "imported"
    },
    "voice_008:r_3701cba361f80ea5": {
      "text": "Gaaaaah! Whyyyyy?!",
      "status": "imported"
    },
    "voice_008:r_63f429c5c68c0863": {
      "text": "E-Eject! I'm not dying here!",
      "status": "imported"
    },
    "voice_008:r_38e4a434c91d8ef0": {
      "text": "You'll pay!\\nNext time... Aaaaagh!!",
      "status": "imported"
    },
    "voice_008:r_099e2458cabf796f": {
      "text": "Running won't do you any good!",
      "status": "imported"
    },
    "voice_008:r_fd910d714be70870": {
      "text": "Quit scurrying around!",
      "status": "imported"
    },
    "voice_008:r_9736f29b11344ec3": {
      "text": "Hunting people sure is fun!",
      "status": "imported"
    },
    "voice_008:r_fcd05582aa5c6068": {
      "text": "Give me fireworks with your life!",
      "status": "imported"
    },
    "voice_008:r_bece29562818acba": {
      "text": "Man, war is the absolute best!",
      "status": "imported"
    },
    "voice_008:r_d907fbd7bc1c4298": {
      "text": "Whoa! It won't end in one round!",
      "status": "imported"
    },
    "voice_008:r_96b21e3a028dd074": {
      "text": "Join me for one more round!",
      "status": "imported"
    },
    "voice_008:r_ce140b5d8e6b7310": {
      "text": "Gwah! Gwaaaah!!",
      "status": "imported"
    },
    "voice_008:r_0e0335789c5396d7": {
      "text": "Hated folks live long!\\nI won't die!",
      "status": "imported"
    },
    "voice_008:r_a8e85bd950696403": {
      "text": "Tch!\\nTaking this fight seriously?!",
      "status": "imported"
    },
    "voice_008:r_772c8bc40ab6cb61": {
      "text": "Ho ho! Now I'm getting fired up!",
      "status": "imported"
    },
    "voice_008:r_58dd2826a199ef51": {
      "text": "What now, honey?!\\nI'm being beaten!",
      "status": "imported"
    },
    "voice_008:r_aadc0b2442adb93b": {
      "text": "Oh, my! It actually hit me!",
      "status": "imported"
    },
    "voice_008:r_e7a8cd8ed5bc2d1b": {
      "text": "Ha ha ha! Guess I'm too strong!",
      "status": "imported"
    },
    "voice_008:r_041dd920da4a7c17": {
      "text": "Too bad! Come back and try again!",
      "status": "imported"
    },
    "voice_008:r_c7f4280cde4605b3": {
      "text": "Oh, dear... What's gotten into you?",
      "status": "imported"
    },
    "voice_008:r_ec349c8ea9511a18": {
      "text": "So? How do you like my barrier?",
      "status": "imported"
    },
    "voice_008:r_33236ffa3ea95b68": {
      "text": "Ha ha ha! Nice barrier!",
      "status": "imported"
    },
    "voice_008:r_689d0b123de71ae0": {
      "text": "Oops! I got a little carried away!",
      "status": "imported"
    },
    "voice_008:r_84883aa95f63ce32": {
      "text": "I'll squash that annoying fly!",
      "status": "imported"
    },
    "voice_008:r_25493e978ce8ff16": {
      "text": "Let's see you dance the fire dance!",
      "status": "imported"
    },
    "voice_008:r_7316666150e42960": {
      "text": "Gundam! Time to thin your herd!",
      "status": "imported"
    },
    "voice_008:r_c4f11aa93dc5b668": {
      "text": "Timber, you big useless log!",
      "status": "imported"
    },
    "voice_008:r_8f5bade7ac2db78e": {
      "text": "Whoa! Whoa! This is really bad!",
      "status": "imported"
    },
    "voice_008:r_05ea490d2f522520": {
      "text": "That hurt! You really got me there!",
      "status": "imported"
    },
    "voice_008:r_f5658c702d91db7a": {
      "text": "Awoooo, Princess! I'll do it!",
      "status": "imported"
    },
    "voice_008:r_686df329b50f195b": {
      "text": "Firebug is immortal!",
      "status": "imported"
    },
    "voice_008:r_25f0ab0fa3cf690c": {
      "text": "D-I-E! Die!!",
      "status": "imported"
    },
    "voice_008:r_b708a1d959013dbf": {
      "text": "Firebug's burning bright today!",
      "status": "imported"
    },
    "voice_008:r_59fca03e929366c1": {
      "text": "I'll set your machine on fire!",
      "status": "imported"
    },
    "voice_008:r_0d65eb631dcb7514": {
      "text": "We fight on without our Princess!",
      "status": "imported"
    },
    "voice_008:r_d03018a31e23f1e9": {
      "text": "The Princess in my heart drives me!",
      "status": "imported"
    },
    "voice_008:r_279da5f732aa8847": {
      "text": "I live, so Firebug won't die!",
      "status": "imported"
    },
    "voice_008:r_97f82e3cb6f70110": {
      "text": "We're just dogs of war anyway!",
      "status": "imported"
    },
    "voice_008:r_c5611d8dd6def96b": {
      "text": "This hated bastard will thrive!",
      "status": "imported"
    },
    "voice_008:r_6f12cc8ed2732eb5": {
      "text": "I'll do anything for the right pay!",
      "status": "imported"
    },
    "voice_008:r_7abfc55f8fb62ba7": {
      "text": "The battlefield is our only home!",
      "status": "imported"
    },
    "voice_008:r_99e7a66c650b5892": {
      "text": "Gundam! I take you down today!",
      "status": "imported"
    },
    "voice_008:r_5b2247b5cfbcd7b2": {
      "text": "Gundam fest!\\nHeave-ho! Heave-ho!",
      "status": "imported"
    },
    "voice_008:r_2d7a9c06347582d9": {
      "text": "New Gundam variant spotted!",
      "status": "imported"
    },
    "voice_008:r_e09b933e3e706779": {
      "text": "A makeover, Gundam?!",
      "status": "imported"
    },
    "voice_008:r_66236eb99b676e5b": {
      "text": "You're a stubborn one, Celestial!",
      "status": "imported"
    },
    "voice_008:r_9639a2dbcd2f58ed": {
      "text": "Mithril!\\nLet's enjoy the thrill!",
      "status": "imported"
    },
    "voice_008:r_aeea0893acb93d35": {
      "text": "One vacancy,\\nMithril may hire me!",
      "status": "imported"
    },
    "voice_008:r_b31568654e53487b": {
      "text": "At last!\\nBrace yourself, Mithril!",
      "status": "imported"
    },
    "voice_008:r_2502132569141ea3": {
      "text": "Whoa! That's one cool-looking AS!",
      "status": "imported"
    },
    "voice_008:r_1ff312798a52c8eb": {
      "text": "Let's settle this with my Burglar!",
      "status": "imported"
    },
    "voice_008:r_fa07d90fca62f593": {
      "text": "Y-You're so cute, Bonta-kun!!",
      "status": "imported"
    },
    "voice_008:r_a25bf2676ecf9d83": {
      "text": "Let me pet you! Let me pet yooou!!",
      "status": "imported"
    },
    "voice_008:r_237a0288b42dce20": {
      "text": "Bon-bon, bo-bon, Bonta-kun! Bon!",
      "status": "imported"
    },
    "voice_008:r_0556e8a22779ea8e": {
      "text": "You damn normie squad!",
      "status": "imported"
    },
    "voice_008:r_09d377101a48d92a": {
      "text": "Big or not,\\nthere's still a limit!",
      "status": "imported"
    },
    "voice_008:r_11517cc7b0494dbf": {
      "text": "Quit acting so high and mighty!",
      "status": "imported"
    },
    "voice_008:r_b5864501463db244": {
      "text": "I'll use that cable as a jump rope!",
      "status": "imported"
    },
    "voice_008:r_a88939ea84b4474d": {
      "text": "I don't trust smooth-talking men!",
      "status": "imported"
    },
    "voice_008:r_03f6158ef83964f3": {
      "text": "Salarymen have it rough too!",
      "status": "imported"
    },
    "voice_008:r_958a56c1151cab9e": {
      "text": "Oho! Found myself an easy mark!",
      "status": "imported"
    },
    "voice_008:r_8b18aa4cc69547df": {
      "text": "Oh! You've grown a little, I see!",
      "status": "imported"
    },
    "voice_008:r_3e87f6fc3ea65aef": {
      "text": "Hey... Wanna be our new Princess?",
      "status": "imported"
    },
    "voice_008:r_09a003e91f0d5dc7": {
      "text": "We'll find our new Princess!",
      "status": "imported"
    },
    "voice_008:r_e92920ba4b301b9f": {
      "text": "T-Tessa!\\nPlease be our Princess!",
      "status": "imported"
    },
    "voice_008:r_cd4893b409472e97": {
      "text": "Payback twice over is all the rage!",
      "status": "imported"
    },
    "voice_008:r_5691cc71770ffdde": {
      "text": "I counter! You suffer carnage!",
      "status": "imported"
    },
    "voice_008:r_964e07c5563a5508": {
      "text": "Now it's my turn!\\nAlways my turn!",
      "status": "imported"
    },
    "voice_008:r_db54e717bff3e3b2": {
      "text": "Hit me, I hit back - that's my way!",
      "status": "imported"
    },
    "voice_008:r_fcab8d80aef7e9d8": {
      "text": "I'm right behind you, Beck!",
      "status": "imported"
    },
    "voice_008:r_2174bd0edc164171": {
      "text": "I'll cover you, Gates!",
      "status": "imported"
    },
    "voice_008:r_ad54419336b49578": {
      "text": "Out of my way, Kan Yu!",
      "status": "imported"
    },
    "voice_008:r_63c353e1e05e8e39": {
      "text": "I'll protect Beck myself!",
      "status": "imported"
    },
    "voice_008:r_87646dd472438e88": {
      "text": "I'll be Gates's shield!",
      "status": "imported"
    },
    "voice_008:r_4e32ac89cba02001": {
      "text": "Stay back, Kan Yu!",
      "status": "imported"
    },
    "voice_008:r_02d24e5915bfa5b7": {
      "text": "Whoa! You scared me!",
      "status": "imported"
    },
    "voice_008:r_9331c2c2ef55c78f": {
      "text": "Useless DEATH! Useless DEATH!",
      "status": "imported"
    },
    "voice_008:r_49734bdb3507acf7": {
      "text": "Total miss! Try again!",
      "status": "imported"
    },
    "voice_008:r_2a730c9b4df0dca3": {
      "text": "Hey!\\nIs your scope fogged up?",
      "status": "imported"
    },
    "voice_008:r_1e5842ba5dc3f705": {
      "text": "Hey! I just polished that armor!",
      "status": "imported"
    },
    "voice_008:r_9747bd61ad23ecd3": {
      "text": "Oh dear, now that's a scratch...",
      "status": "imported"
    },
    "voice_008:r_6823f8abe05c4727": {
      "text": "Oh! My perfect mirror finish!",
      "status": "imported"
    },
    "voice_008:r_b8ccfd8b8ac323ac": {
      "text": "That scratch... will cost you, pal.",
      "status": "imported"
    },
    "voice_008:r_c885ff2097749991": {
      "text": "No way! Am I actually losing?!",
      "status": "imported"
    },
    "voice_008:r_a8da7f8d8b705db0": {
      "text": "Hold it! That hit went too far!",
      "status": "imported"
    },
    "voice_008:r_02e1c5e19de5bd22": {
      "text": "Gyaaaah! Help me, Princess!",
      "status": "imported"
    },
    "voice_008:r_6fb823898811e210": {
      "text": "Damn! If Princess were here...!",
      "status": "imported"
    },
    "voice_008:r_5dcbcf1682cc3ab8": {
      "text": "Not bad at all, Mithril!",
      "status": "imported"
    },
    "voice_008:r_5a20988e743dc1d0": {
      "text": "Don't think justice always wins!",
      "status": "imported"
    },
    "voice_008:r_197f05bf899b7697": {
      "text": "That AS is cool and strong!",
      "status": "imported"
    },
    "voice_008:r_623ee03bd91ab2a1": {
      "text": "Hey! You're going way too wild!",
      "status": "imported"
    },
    "voice_008:r_c5c491f8761152f0": {
      "text": "Ah...\\nGlad Bonta-kun beat me...!",
      "status": "imported"
    },
    "voice_008:r_15042263763f11bb": {
      "text": "More! More, Bonta-kun!",
      "status": "imported"
    },
    "voice_008:r_96b3a8f080aea8b4": {
      "text": "My dream!\\nPlaying with Bonta-kun!",
      "status": "imported"
    },
    "voice_008:r_3d4fa015b8b31648": {
      "text": "Ow!\\nA fierce hit by a new Princess!",
      "status": "imported"
    },
    "voice_008:r_1ac46173650ffe13": {
      "text": "That hit!\\nA new Princess, maybe!",
      "status": "imported"
    },
    "voice_008:r_2835a8af1c41be9b": {
      "text": "Whoa! That joke went way too far!",
      "status": "imported"
    },
    "voice_008:r_cd84325a7c1a820f": {
      "text": "Eek!\\nThe cockpit's in total panic!",
      "status": "imported"
    },
    "voice_008:r_0465f74c0488ad70": {
      "text": "Damn it!\\nIf Princess were here...!",
      "status": "imported"
    },
    "voice_008:r_a30c8238b5208470": {
      "text": "Whoo!\\nFirebug's ass is on fire!",
      "status": "imported"
    },
    "voice_008:r_64bf1c63c7c1ebdd": {
      "text": "Aaaaaagh! Princess!!",
      "status": "imported"
    },
    "voice_008:r_f6d5042f671118fa": {
      "text": "S-Seriously?! This ending again?!",
      "status": "imported"
    },
    "voice_008:r_0be18539fac21ba4": {
      "text": "Damn it!\\nI'm just the fall guy!",
      "status": "imported"
    },
    "voice_008:r_c05bd0cf089d667f": {
      "text": "Ah... I see a vision of Princess...",
      "status": "imported"
    },
    "voice_008:r_f69a0e1d0d67fd0e": {
      "text": "We'll gang up and beat you down!",
      "status": "imported"
    },
    "voice_008:r_c4e734ceafabd82c": {
      "text": "Pardon me, I'm going on ahead!",
      "status": "imported"
    },
    "voice_008:r_62f1de6cdfb87024": {
      "text": "All right! First one there is me!",
      "status": "imported"
    },
    "voice_008:r_7ecfe7ddfa4cdb6a": {
      "text": "A full course of murder! Me first!",
      "status": "imported"
    },
    "voice_008:r_d1be92a2ad355176": {
      "text": "I love ganging up on one target!",
      "status": "imported"
    },
    "voice_008:r_e0022ae8da32f998": {
      "text": "Leave this side to me!",
      "status": "imported"
    },
    "voice_008:r_0ef83b6a1e87f6fd": {
      "text": "Go on a date with me, baby!",
      "status": "imported"
    },
    "voice_008:r_a8f0666c4d6d24a0": {
      "text": "Let's have some fun, just us two!",
      "status": "imported"
    },
    "voice_008:r_3ec7c6e48027a853": {
      "text": "My heart is yours!",
      "status": "imported"
    },
    "voice_008:r_953824ba6b607e1f": {
      "text": "And now, the touching reunion!",
      "status": "imported"
    }
  }
}
