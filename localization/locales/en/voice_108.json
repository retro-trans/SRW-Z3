{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_108:r_479b340ccc6c572b": {
      "text": "Well then, let's begin.",
      "status": "imported"
    },
    "voice_108:r_ca4acbac57a2a35e": {
      "text": "Prepare yourself.",
      "status": "imported"
    },
    "voice_108:r_77949221bf58f862": {
      "text": "I'll crush anyone in my way.",
      "status": "imported"
    },
    "voice_108:r_70b9c4b9f1f37eff": {
      "text": "I'll tear you limb from limb.",
      "status": "imported"
    },
    "voice_108:r_9fcb3754cb1773c7": {
      "text": "I'll snuff out your life!",
      "status": "imported"
    },
    "voice_108:r_3559d2fad32c2435": {
      "text": "I'll make sure you can't move again.",
      "status": "imported"
    },
    "voice_108:r_f7570547e9f80a64": {
      "text": "I see you.\\nYou won't get off easy.",
      "status": "imported"
    },
    "voice_108:r_cbab0f4720e1fcf1": {
      "text": "Demon General Duncan will end you.",
      "status": "imported"
    },
    "voice_108:r_0bbe0b4f5364e732": {
      "text": "My Demon General title is no boast.",
      "status": "imported"
    },
    "voice_108:r_5dda5198137cb02a": {
      "text": "All units! Crush the enemy!",
      "status": "imported"
    },
    "voice_108:r_83ec59afbecdec14": {
      "text": "Now is the time to show our power!",
      "status": "imported"
    },
    "voice_108:r_e20bfd42ad95a3c9": {
      "text": "Crush the Space Demon King's foes!",
      "status": "imported"
    },
    "voice_108:r_0f58a8822381e57f": {
      "text": "Demon General Duncan orders:\\nAttack!",
      "status": "imported"
    },
    "voice_108:r_6dbcc507fb61b51d": {
      "text": "Attack until the enemy falls!",
      "status": "imported"
    },
    "voice_108:r_b42ab697149a7c8a": {
      "text": "Don't think this ends in one blow.",
      "status": "imported"
    },
    "voice_108:r_4de4fcf3b440baf4": {
      "text": "Can you withstand this, brat?",
      "status": "imported"
    },
    "voice_108:r_0121a166c715cdff": {
      "text": "Tetsujin! I'll crush you!",
      "status": "imported"
    },
    "voice_108:r_30fad37a42bd3ad3": {
      "text": "I'll turn you to scrap, Black Ox!",
      "status": "imported"
    },
    "voice_108:r_80a0b2a84e05d81a": {
      "text": "This is the end for you, Black Ox.",
      "status": "imported"
    },
    "voice_108:r_4a9ac1dff86506d9": {
      "text": "Die, Mars.",
      "status": "imported"
    },
    "voice_108:r_bc8538e6af3d2577": {
      "text": "So the famed Godmars has come!",
      "status": "imported"
    },
    "voice_108:r_924516c8de2b5342": {
      "text": "An Earth-built Super Robot, is it?",
      "status": "imported"
    },
    "voice_108:r_da1174533722333f": {
      "text": "Its power rivals a Space Robot!",
      "status": "imported"
    },
    "voice_108:r_fdeb8162976e72c1": {
      "text": "You irritating little pest!",
      "status": "imported"
    },
    "voice_108:r_0fadb5c26df92b42": {
      "text": "Damn! Too small to get a lock on!",
      "status": "imported"
    },
    "voice_108:r_6b15af9a0057cdc8": {
      "text": "I'll down your warship and end this!",
      "status": "imported"
    },
    "voice_108:r_d5e0a2317c40d322": {
      "text": "Small Saucer squadron, attack!",
      "status": "imported"
    },
    "voice_108:r_ec2ea17765052401": {
      "text": "Deploy the attack saucers!",
      "status": "imported"
    },
    "voice_108:r_f2d4255f1c2f7542": {
      "text": "Attack saucers, shoot it down!",
      "status": "imported"
    },
    "voice_108:r_5d08ad19e2da125b": {
      "text": "Commence the counterattack!",
      "status": "imported"
    },
    "voice_108:r_a7246b52782a877e": {
      "text": "You won't escape!",
      "status": "imported"
    },
    "voice_108:r_dc8701f6bcb9904f": {
      "text": "I'll chase you wherever you go!",
      "status": "imported"
    },
    "voice_108:r_d6bdd730f24f66eb": {
      "text": "Your schemes end here!",
      "status": "imported"
    },
    "voice_108:r_41997412868c48c4": {
      "text": "I always repay my debts!",
      "status": "imported"
    },
    "voice_108:r_9e6cf4f389dae55c": {
      "text": "You've chosen this place to die?",
      "status": "imported"
    },
    "voice_108:r_9e0c80ac7e33b459": {
      "text": "You'd test a Demon General's might?",
      "status": "imported"
    },
    "voice_108:r_7432ef43ed3471dc": {
      "text": "You want death? Wish granted!",
      "status": "imported"
    },
    "voice_108:r_065443f6ddfcf0d7": {
      "text": "This attack isn't over yet!",
      "status": "imported"
    },
    "voice_108:r_47d52a2839c71715": {
      "text": "I'll finish you off now!",
      "status": "imported"
    },
    "voice_108:r_847f82e7f3eef651": {
      "text": "Gura, I'll cover you!",
      "status": "imported"
    },
    "voice_108:r_eb7ae28b53dc033c": {
      "text": "I'll be your shield!",
      "status": "imported"
    },
    "voice_108:r_857c4a52ce8df0fd": {
      "text": "Do you need cover?",
      "status": "imported"
    },
    "voice_108:r_55417493fce1d347": {
      "text": "Gura! Please fall back!",
      "status": "imported"
    },
    "voice_108:r_8fdf5910927c9591": {
      "text": "Damn it! I can't counter now!",
      "status": "imported"
    },
    "voice_108:r_7d724dbcc4451e10": {
      "text": "What?! I can't do anything?!",
      "status": "imported"
    },
    "voice_108:r_93e25418a203cb8f": {
      "text": "Ngh! Have I run out of energy?!",
      "status": "imported"
    },
    "voice_108:r_adeb0a29274d3d9b": {
      "text": "They've seen through our range?!",
      "status": "imported"
    },
    "voice_108:r_24cf161287ef9d5c": {
      "text": "Damn you!\\nI can't counter there!",
      "status": "imported"
    },
    "voice_108:r_8f60f6fc86db3107": {
      "text": "I can see your attacks coming.",
      "status": "imported"
    },
    "voice_108:r_b1de76a75a253c13": {
      "text": "Heh heh heh! Where are you aiming?",
      "status": "imported"
    },
    "voice_108:r_128c35bf3e0e394c": {
      "text": "That attack nearly made me yawn.",
      "status": "imported"
    },
    "voice_108:r_5213c17e13b23de0": {
      "text": "You'll never lay a finger on me.",
      "status": "imported"
    },
    "voice_108:r_38fdff9483e9245c": {
      "text": "Don't slight the Demon General!",
      "status": "imported"
    },
    "voice_108:r_620fedec67706d7d": {
      "text": "You face me.\\nI praise your nerve!",
      "status": "imported"
    },
    "voice_108:r_9680dcd0fddcfcc7": {
      "text": "Give it up already, brat!",
      "status": "imported"
    },
    "voice_108:r_2a00f1044ad5cbaa": {
      "text": "The famed Tetsujin isn't so tough.",
      "status": "imported"
    },
    "voice_108:r_3dbeead1bd3164ef": {
      "text": "You're feeble, Black Ox.",
      "status": "imported"
    },
    "voice_108:r_98d15b8cc09bc915": {
      "text": "Don't make me laugh, Mars.",
      "status": "imported"
    },
    "voice_108:r_46e86d000250e137": {
      "text": "That's all Earth robots can muster!",
      "status": "imported"
    },
    "voice_108:r_ddafde4b065ced49": {
      "text": "You'll never break this barrier!",
      "status": "imported"
    },
    "voice_108:r_de1213040856c089": {
      "text": "I'm fully prepared for anything!",
      "status": "imported"
    },
    "voice_108:r_a2afffe1c396f0b3": {
      "text": "Hmph. That barely tickled!",
      "status": "imported"
    },
    "voice_108:r_13c25fbdfddc8a24": {
      "text": "Cease your futile resistance.",
      "status": "imported"
    },
    "voice_108:r_42ba1ecb310b4bd7": {
      "text": "Well now... You laid a hand on me!",
      "status": "imported"
    },
    "voice_108:r_d692f1d420460a47": {
      "text": "At this rate,\\nyou'll need ten years.",
      "status": "imported"
    },
    "voice_108:r_a5643cec86b18bd2": {
      "text": "So feeble, yet\\nyou dare face me.",
      "status": "imported"
    },
    "voice_108:r_68f2dfab20a4a30e": {
      "text": "Ha ha ha! Know your place now?!",
      "status": "imported"
    },
    "voice_108:r_9cedad8237480563": {
      "text": "Tch! You don't know when to quit!",
      "status": "imported"
    },
    "voice_108:r_a03fabecba1508ca": {
      "text": "Hmm!\\nYou're better than I expected!",
      "status": "imported"
    },
    "voice_108:r_5391b24a71eb10ae": {
      "text": "I can't let them\\nbuild momentum!",
      "status": "imported"
    },
    "voice_108:r_a554ceef5c87b972": {
      "text": "To match a Demon General\\nlike me...!",
      "status": "imported"
    },
    "voice_108:r_546c3d5937fbb7ee": {
      "text": "Impressive!\\nShame to end you here!",
      "status": "imported"
    },
    "voice_108:r_1568ff6298b12b96": {
      "text": "Damn!\\nCan't you see I'm going easy?!",
      "status": "imported"
    },
    "voice_108:r_2c9d94ba13c5fc50": {
      "text": "You brat! I won't forgive you!",
      "status": "imported"
    },
    "voice_108:r_a77f4913375098d2": {
      "text": "Damn you, insolent Tetsujin!",
      "status": "imported"
    },
    "voice_108:r_428c2116ac3071b1": {
      "text": "Black Ox! You accursed nuisance!",
      "status": "imported"
    },
    "voice_108:r_84c116267b79f540": {
      "text": "Ngh! Is this Mars's true power?!",
      "status": "imported"
    },
    "voice_108:r_dad38ee29af2df3a": {
      "text": "Damn!\\nI misjudged Earth's robots!",
      "status": "imported"
    },
    "voice_108:r_3d32e86f8dc80909": {
      "text": "Such power... A true Super Robot!",
      "status": "imported"
    },
    "voice_108:r_9072ea7bc71df136": {
      "text": "Impossible!\\nHow can I be cornered?!",
      "status": "imported"
    },
    "voice_108:r_04e815a8d425827d": {
      "text": "On my honor as Demon General, fall!",
      "status": "imported"
    },
    "voice_108:r_d89011fe3e5d082a": {
      "text": "I can't face the Space Demon King!",
      "status": "imported"
    },
    "voice_108:r_3c5b0c2ac812d5de": {
      "text": "How could I take this much damage?!",
      "status": "imported"
    },
    "voice_108:r_5b9e8897190892eb": {
      "text": "You're strong!\\nBut I cannot lose!",
      "status": "imported"
    },
    "voice_108:r_7bea3023abbf8a94": {
      "text": "Not yet! I'll\\ntake you down with me!",
      "status": "imported"
    },
    "voice_108:r_dd01a4c0d1b36a8d": {
      "text": "Ngh! I'll retreat for now!",
      "status": "imported"
    },
    "voice_108:r_20920ad2eb3542db": {
      "text": "Space Demon King! Please forgive me!",
      "status": "imported"
    },
    "voice_108:r_0ab7914877fd48ed": {
      "text": "Nwaaaaaaagh!",
      "status": "imported"
    },
    "voice_108:r_cb846feec748c2e3": {
      "text": "Nngh... Damn you! You'll pay, brat!",
      "status": "imported"
    },
    "voice_108:r_c958860b0676b1f5": {
      "text": "Cursed Tetsujin!\\nI'll repay this!",
      "status": "imported"
    }
  }
}
