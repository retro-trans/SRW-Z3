{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_036:r_479b340ccc6c572b": {
      "text": "We will destroy... everything...",
      "status": "imported"
    },
    "voice_036:r_77949221bf58f862": {
      "text": "All shall return to nothing...",
      "status": "imported"
    },
    "voice_036:r_70b9c4b9f1f37eff": {
      "text": "Perish, all who live...",
      "status": "imported"
    },
    "voice_036:r_9fcb3754cb1773c7": {
      "text": "Life's power, fade away...",
      "status": "imported"
    },
    "voice_036:r_3559d2fad32c2435": {
      "text": "We are chaos... We are order...",
      "status": "imported"
    },
    "voice_036:r_f7570547e9f80a64": {
      "text": "Eternity is with us...",
      "status": "imported"
    },
    "voice_036:r_cbab0f4720e1fcf1": {
      "text": "To the end of the causal horizon...",
      "status": "imported"
    },
    "voice_036:r_0bbe0b4f5364e732": {
      "text": "We are part of infinity...",
      "status": "imported"
    },
    "voice_036:r_5dda5198137cb02a": {
      "text": "Cast off your flesh and join us...",
      "status": "imported"
    },
    "voice_036:r_83ec59afbecdec14": {
      "text": "Unleash your karma...",
      "status": "imported"
    },
    "voice_036:r_e20bfd42ad95a3c9": {
      "text": "Ahead is darkness... That is fate.",
      "status": "imported"
    },
    "voice_036:r_0f58a8822381e57f": {
      "text": "Abandon all hope...",
      "status": "imported"
    },
    "voice_036:r_6dbcc507fb61b51d": {
      "text": "We alone are infinite power...",
      "status": "imported"
    },
    "voice_036:r_b42ab697149a7c8a": {
      "text": "Kneel before the supreme power...",
      "status": "imported"
    },
    "voice_036:r_4de4fcf3b440baf4": {
      "text": "A great will... A great power...",
      "status": "imported"
    },
    "voice_036:r_0121a166c715cdff": {
      "text": "Causality and rebirth consume you!",
      "status": "imported"
    },
    "voice_036:r_a2df00f91a9b0a9e": {
      "text": "Oooh...!",
      "status": "imported"
    },
    "voice_036:r_48b60d6c48b9b142": {
      "text": "Aaah...!",
      "status": "imported"
    },
    "voice_036:r_8927e6fb681aa809": {
      "text": "Uuuh...!",
      "status": "imported"
    },
    "voice_036:r_665f01666859013b": {
      "text": "Why...?",
      "status": "imported"
    },
    "voice_036:r_a571eec59b258d11": {
      "text": "Will you still struggle...?",
      "status": "imported"
    },
    "voice_036:r_ddbe581c5ea9183d": {
      "text": "How pitiful...",
      "status": "imported"
    },
    "voice_036:r_faae935cca0edc72": {
      "text": "Know fear...",
      "status": "imported"
    },
    "voice_036:r_d4430bf362340b32": {
      "text": "It is futile...",
      "status": "imported"
    },
    "voice_036:r_6ff1323b355593e0": {
      "text": "It is over...",
      "status": "imported"
    },
    "voice_036:r_b7b5625d7cd4282f": {
      "text": "This is the flesh's limit...",
      "status": "imported"
    },
    "voice_036:r_36133ad73a73ef98": {
      "text": "We are darkness... We are the void.",
      "status": "imported"
    },
    "voice_036:r_920740a0219c5085": {
      "text": "Know your powerlessness...",
      "status": "imported"
    },
    "voice_036:r_a8451712c57c1a72": {
      "text": "Infinite power belongs to us...",
      "status": "imported"
    },
    "voice_036:r_3633df5b7b8f47fa": {
      "text": "Why do you struggle...?",
      "status": "imported"
    },
    "voice_036:r_52dfc56b14b93551": {
      "text": "Why do you try to live...?",
      "status": "imported"
    },
    "voice_036:r_1b9b2aab5cb104da": {
      "text": "Why not cast off your flesh...?",
      "status": "imported"
    },
    "voice_036:r_342044c706a2340f": {
      "text": "Why do you try to press on...?",
      "status": "imported"
    },
    "voice_036:r_cf41e8828a90cbdb": {
      "text": "So this is life...",
      "status": "imported"
    },
    "voice_036:r_719e897304ec42d4": {
      "text": "So this is the flesh's power...",
      "status": "imported"
    },
    "voice_036:r_d5e0a2317c40d322": {
      "text": "So this is emotion...",
      "status": "imported"
    },
    "voice_036:r_ec2ea17765052401": {
      "text": "So this is hope...",
      "status": "imported"
    },
    "voice_036:r_f2d4255f1c2f7542": {
      "text": "Uoooooh...!",
      "status": "imported"
    },
    "voice_036:r_5d08ad19e2da125b": {
      "text": "Uaaaaah...!",
      "status": "imported"
    },
    "voice_036:r_a7246b52782a877e": {
      "text": "Uuuuuuh...!",
      "status": "imported"
    },
    "voice_036:r_dc8701f6bcb9904f": {
      "text": "Darkness... is swallowing us...",
      "status": "imported"
    },
    "voice_036:r_d6bdd730f24f66eb": {
      "text": "We are becoming one with the void.",
      "status": "imported"
    },
    "voice_036:r_41997412868c48c4": {
      "text": "Everything... is disappearing...",
      "status": "imported"
    },
    "voice_036:r_9e6cf4f389dae55c": {
      "text": "The cycle of rebirth... is ending.",
      "status": "imported"
    }
  }
}
