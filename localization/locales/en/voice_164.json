{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_164:r_479b340ccc6c572b": {
      "text": "I'm... so embarrassed...",
      "status": "imported"
    },
    "voice_164:r_ca4acbac57a2a35e": {
      "text": "Um... well...\\nIt's nice to meet you!",
      "status": "imported"
    },
    "voice_164:r_77949221bf58f862": {
      "text": "Trust me and fight beside me!",
      "status": "imported"
    },
    "voice_164:r_70b9c4b9f1f37eff": {
      "text": "I'm still not very good at this...!",
      "status": "imported"
    },
    "voice_164:r_9fcb3754cb1773c7": {
      "text": "Yunoha Thrul! I'll fight!",
      "status": "imported"
    },
    "voice_164:r_3559d2fad32c2435": {
      "text": "It's okay. I won't be embarrassed!",
      "status": "imported"
    },
    "voice_164:r_f7570547e9f80a64": {
      "text": "I have to take the first step!",
      "status": "imported"
    },
    "voice_164:r_cbab0f4720e1fcf1": {
      "text": "I want to help everyone too...!",
      "status": "imported"
    },
    "voice_164:r_0bbe0b4f5364e732": {
      "text": "I'll give it everything I've got!",
      "status": "imported"
    },
    "voice_164:r_5dda5198137cb02a": {
      "text": "I'm an Element too...!",
      "status": "imported"
    },
    "voice_164:r_83ec59afbecdec14": {
      "text": "I finally became a cadet...!",
      "status": "imported"
    },
    "voice_164:r_e20bfd42ad95a3c9": {
      "text": "I can't hold everyone back!",
      "status": "imported"
    },
    "voice_164:r_0f58a8822381e57f": {
      "text": "Now it's my turn to support you all!",
      "status": "imported"
    },
    "voice_164:r_6dbcc507fb61b51d": {
      "text": "I can't bear to lose anyone again!",
      "status": "imported"
    },
    "voice_164:r_b42ab697149a7c8a": {
      "text": "Jin taught me\\nthat I'm not alone...!",
      "status": "imported"
    },
    "voice_164:r_4de4fcf3b440baf4": {
      "text": "I want to protect what they cherish!",
      "status": "imported"
    },
    "voice_164:r_0121a166c715cdff": {
      "text": "This is Jin's home planet...",
      "status": "imported"
    },
    "voice_164:r_30fad37a42bd3ad3": {
      "text": "You can do it, Yunoha!",
      "status": "imported"
    },
    "voice_164:r_80a0b2a84e05d81a": {
      "text": "Y-yes!\\nYunoha Thrul, doing my best!",
      "status": "imported"
    },
    "voice_164:r_4a9ac1dff86506d9": {
      "text": "I'm an Element too, after all!",
      "status": "imported"
    },
    "voice_164:r_bc8538e6af3d2577": {
      "text": "You're fired up, Yunoha!",
      "status": "imported"
    },
    "voice_164:r_924516c8de2b5342": {
      "text": "Mikono, here I go!",
      "status": "imported"
    },
    "voice_164:r_da1174533722333f": {
      "text": "Right! Let's combine our strength!",
      "status": "imported"
    },
    "voice_164:r_fdeb8162976e72c1": {
      "text": "Yunoha, don't push yourself.",
      "status": "imported"
    },
    "voice_164:r_0fadb5c26df92b42": {
      "text": "I'm okay!\\nI won't disappear again!",
      "status": "imported"
    },
    "voice_164:r_6b15af9a0057cdc8": {
      "text": "I'll follow Cayenne's example...!",
      "status": "imported"
    },
    "voice_164:r_15b4a90140e8a33a": {
      "text": "Great concentration, Yunoha!",
      "status": "imported"
    },
    "voice_164:r_af884a6b11dff121": {
      "text": "Embarrassed? Want me to dig a hole?",
      "status": "imported"
    },
    "voice_164:r_ac6fe7838e95647b": {
      "text": "I-I'm okay!",
      "status": "imported"
    },
    "voice_164:r_77ca87eacd17ad52": {
      "text": "Malloy, I'm counting on you!",
      "status": "imported"
    },
    "voice_164:r_bf3244994760e535": {
      "text": "Leave support to me!",
      "status": "imported"
    },
    "voice_164:r_aabfb21c9d069ce7": {
      "text": "K-Kagura, I'm not much, but...",
      "status": "imported"
    },
    "voice_164:r_02479dc8fe989560": {
      "text": "You're Jin's girl. Stand proud!",
      "status": "imported"
    },
    "voice_164:r_a2df00f91a9b0a9e": {
      "text": "Jin, please lend me your strength!",
      "status": "imported"
    },
    "voice_164:r_48b60d6c48b9b142": {
      "text": "Got it!",
      "status": "imported"
    },
    "voice_164:r_8927e6fb681aa809": {
      "text": "Yunoha, you needn't be afraid...",
      "status": "imported"
    },
    "voice_164:r_665f01666859013b": {
      "text": "No. With Jin here, I'm not afraid.",
      "status": "imported"
    },
    "voice_164:r_a571eec59b258d11": {
      "text": "One more time, without being shy!",
      "status": "imported"
    },
    "voice_164:r_ddbe581c5ea9183d": {
      "text": "I'll make it count this time!",
      "status": "imported"
    },
    "voice_164:r_faae935cca0edc72": {
      "text": "People from another world...!",
      "status": "imported"
    },
    "voice_164:r_d4430bf362340b32": {
      "text": "Why are you abducting women...!?",
      "status": "imported"
    },
    "voice_164:r_6ff1323b355593e0": {
      "text": "Do we really have to fight...!?",
      "status": "imported"
    },
    "voice_164:r_b7b5625d7cd4282f": {
      "text": "You're only targeting Mikono...?",
      "status": "imported"
    },
    "voice_164:r_36133ad73a73ef98": {
      "text": "So you're\\nanother Amata too!",
      "status": "imported"
    },
    "voice_164:r_920740a0219c5085": {
      "text": "That's the Mythical Aquarion...!",
      "status": "imported"
    },
    "voice_164:r_a8451712c57c1a72": {
      "text": "Even against Mythical Aquarion...!",
      "status": "imported"
    },
    "voice_164:r_3633df5b7b8f47fa": {
      "text": "Remember!\\nRemember Andy!",
      "status": "imported"
    },
    "voice_164:r_52dfc56b14b93551": {
      "text": "MIX!\\nYou're still MIX!",
      "status": "imported"
    },
    "voice_164:r_1b9b2aab5cb104da": {
      "text": "Sorry! I have to stop your machine!",
      "status": "imported"
    },
    "voice_164:r_342044c706a2340f": {
      "text": "To save you!\\nPlease bear with it!",
      "status": "imported"
    },
    "voice_164:r_cf41e8828a90cbdb": {
      "text": "Jin's world's supreme leader...!",
      "status": "imported"
    },
    "voice_164:r_719e897304ec42d4": {
      "text": "Love should\\nfeel so much warmer...!",
      "status": "imported"
    },
    "voice_164:r_d5e0a2317c40d322": {
      "text": "I'll protect\\nJin's planet and Earth!",
      "status": "imported"
    },
    "voice_164:r_ec2ea17765052401": {
      "text": "You can't attack Earth!",
      "status": "imported"
    },
    "voice_164:r_f2d4255f1c2f7542": {
      "text": "I-I won't hand Earth\\nover to you!",
      "status": "imported"
    },
    "voice_164:r_5d08ad19e2da125b": {
      "text": "Element powers are psychic too!",
      "status": "imported"
    },
    "voice_164:r_a7246b52782a877e": {
      "text": "You're so fast, I'm getting dizzy!",
      "status": "imported"
    },
    "voice_164:r_dc8701f6bcb9904f": {
      "text": "Gundam, let's see who wins!",
      "status": "imported"
    },
    "voice_164:r_d6bdd730f24f66eb": {
      "text": "People from one world fighting...!",
      "status": "imported"
    },
    "voice_164:r_9e6cf4f389dae55c": {
      "text": "Surely we don't have to fight...",
      "status": "imported"
    },
    "voice_164:r_7432ef43ed3471dc": {
      "text": "If you attack people, then fight me!",
      "status": "imported"
    },
    "voice_164:r_065443f6ddfcf0d7": {
      "text": "I can't let that space monster pass!",
      "status": "imported"
    },
    "voice_164:r_47d52a2839c71715": {
      "text": "Gods shouldn't do such awful things!",
      "status": "imported"
    },
    "voice_164:r_847f82e7f3eef651": {
      "text": "C-crime is wrong!",
      "status": "imported"
    },
    "voice_164:r_eb7ae28b53dc033c": {
      "text": "I won't let you annihilate them!",
      "status": "imported"
    },
    "voice_164:r_55417493fce1d347": {
      "text": "I can't lose, even to a mighty foe!",
      "status": "imported"
    },
    "voice_164:r_8fdf5910927c9591": {
      "text": "If I take down their commander...!",
      "status": "imported"
    },
    "voice_164:r_7d724dbcc4451e10": {
      "text": "Targeting the enemy battleship!",
      "status": "imported"
    },
    "voice_164:r_93e25418a203cb8f": {
      "text": "To carry life's flow into tomorrow!",
      "status": "imported"
    },
    "voice_164:r_adeb0a29274d3d9b": {
      "text": "We'll protect both Earth and space!",
      "status": "imported"
    },
    "voice_164:r_24cf161287ef9d5c": {
      "text": "We'll fight you cowards!",
      "status": "imported"
    },
    "voice_164:r_8f60f6fc86db3107": {
      "text": "Humans at war...\\nIt's unforgivable!",
      "status": "imported"
    },
    "voice_164:r_b1de76a75a253c13": {
      "text": "I'll cleave you in two!",
      "status": "imported"
    },
    "voice_164:r_128c35bf3e0e394c": {
      "text": "This blade is razor-sharp!",
      "status": "imported"
    },
    "voice_164:r_5213c17e13b23de0": {
      "text": "I'll cut you down with this!",
      "status": "imported"
    },
    "voice_164:r_38fdff9483e9245c": {
      "text": "No holding back!",
      "status": "imported"
    },
    "voice_164:r_381992c5d8224937": {
      "text": "Counterattack!",
      "status": "imported"
    },
    "voice_164:r_f1e7ed9e5874aba5": {
      "text": "I won't let you escape!",
      "status": "imported"
    },
    "voice_164:r_fc25e66a86fc2c85": {
      "text": "I can't let you disengage!",
      "status": "imported"
    },
    "voice_164:r_5aeeb4917340c42d": {
      "text": "I'll fight back too...!",
      "status": "imported"
    },
    "voice_164:r_b765659981b6516d": {
      "text": "While the enemy's off guard...!",
      "status": "imported"
    },
    "voice_164:r_0c427458bc00eb95": {
      "text": "That attack gave your position away!",
      "status": "imported"
    },
    "voice_164:r_774a9ab4d8fd5351": {
      "text": "May I join you?",
      "status": "imported"
    },
    "voice_164:r_d3f01de714c015bd": {
      "text": "Sorry for barging in...!",
      "status": "imported"
    },
    "voice_164:r_7d2617c809fead70": {
      "text": "I'll spare you\\nthe pain of loss...!",
      "status": "imported"
    },
    "voice_164:r_ceb935ccbf830724": {
      "text": "I'll protect you!",
      "status": "imported"
    },
    "voice_164:r_862ef7385bf2abd4": {
      "text": "N-no, you can't!",
      "status": "imported"
    },
    "voice_164:r_001cbec4d9a4283f": {
      "text": "No...! I can't counterattack...!",
      "status": "imported"
    },
    "voice_164:r_8ad40afecd02b41e": {
      "text": "If I don't act now, I'm done for...!",
      "status": "imported"
    },
    "voice_164:r_26e5efec03c03d78": {
      "text": "Huh?\\nSpirit Level is dropping...?",
      "status": "imported"
    },
    "voice_164:r_4ad81e88c7557a8b": {
      "text": "Um, where's the enemy...?",
      "status": "imported"
    },
    "voice_164:r_1f65a7af190e4674": {
      "text": "Even Aquarion can't reach them...!",
      "status": "imported"
    },
    "voice_164:r_40c5a9358ed5bf29": {
      "text": "It's okay. I won't be embarrassed!",
      "status": "imported"
    },
    "voice_164:r_f2e18dfdfe0c89ea": {
      "text": "Phew, I dodged it...",
      "status": "imported"
    },
    "voice_164:r_cf7dbf49e96a5755": {
      "text": "I can't risk you all.\\nI just can't.",
      "status": "imported"
    },
    "voice_164:r_fa96676cc65bb509": {
      "text": "I can do it if I try!",
      "status": "imported"
    },
    "voice_164:r_4e37f92e7d2fc62e": {
      "text": "No, don't stare at me like that...!",
      "status": "imported"
    },
    "voice_164:r_66ab4cfe1557909d": {
      "text": "I'm good at running away!",
      "status": "imported"
    },
    "voice_164:r_0bad405ee6ca63ba": {
      "text": "Th-they're strong, but...!",
      "status": "imported"
    },
    "voice_164:r_2072eaf71a260ae7": {
      "text": "Not bad, Yunoha!",
      "status": "imported"
    },
    "voice_164:r_6c13bbfd27a7799e": {
      "text": "Ehehe...\\nAmata praised me.",
      "status": "imported"
    },
    "voice_164:r_06f88dcbd3c9e738": {
      "text": "Nice dodge, Yunoha.",
      "status": "imported"
    },
    "voice_164:r_b28faf9f71bc3598": {
      "text": "It's because Mikono believed in me.",
      "status": "imported"
    },
    "voice_164:r_8a29278549f8e07a": {
      "text": "You've really improved, Yunoha.",
      "status": "imported"
    },
    "voice_164:r_7e6c573c26177f98": {
      "text": "R-really?",
      "status": "imported"
    },
    "voice_164:r_45abf84f7757d6eb": {
      "text": "The famed Vanishing Element!",
      "status": "imported"
    },
    "voice_164:r_edd7a13ab8f06a14": {
      "text": "Please forget about that already...",
      "status": "imported"
    },
    "voice_164:r_8165e5b41f0124c4": {
      "text": "You've gotten better, Yunoha!",
      "status": "imported"
    },
    "voice_164:r_4e05581b7432cce8": {
      "text": "Maybe now I can be of some use...",
      "status": "imported"
    },
    "voice_164:r_a60b107ea3c36a86": {
      "text": "Not bad, Jin's girl!",
      "status": "imported"
    },
    "voice_164:r_e33693e5ba4665b0": {
      "text": "U-um, I told you, my name is Yunoha!",
      "status": "imported"
    },
    "voice_164:r_72a21a1a489af001": {
      "text": "Amazing, Yunoha!",
      "status": "imported"
    },
    "voice_164:r_eb643f8bf737a0ca": {
      "text": "Yeah, um... It's all thanks to Jin.",
      "status": "imported"
    },
    "voice_164:r_0a3fccb71ec6cf2a": {
      "text": "Huh? That did zero damage?",
      "status": "imported"
    },
    "voice_164:r_8356f4e3dcdff938": {
      "text": "The barrier protected me...",
      "status": "imported"
    },
    "voice_164:r_1d6d784036ae0bd7": {
      "text": "Thank goodness I had the barrier...",
      "status": "imported"
    },
    "voice_164:r_625664af02183c17": {
      "text": "I-I'll stop it with my shield...!",
      "status": "imported"
    },
    "voice_164:r_3701cba361f80ea5": {
      "text": "I'll block it with my shield!",
      "status": "imported"
    },
    "voice_164:r_63f429c5c68c0863": {
      "text": "Hnnng!",
      "status": "imported"
    },
    "voice_164:r_38e4a434c91d8ef0": {
      "text": "Thanks, Yunoha! You saved me!",
      "status": "imported"
    },
    "voice_164:r_4824bea6bab3af67": {
      "text": "I-I'm still perfectly fine!",
      "status": "imported"
    },
    "voice_164:r_862b92e63adb9734": {
      "text": "A girl's got to have guts!",
      "status": "imported"
    },
    "voice_164:r_cb306ef55e49d107": {
      "text": "It only grazed me!",
      "status": "imported"
    },
    "voice_164:r_57b2bd2de8a1408d": {
      "text": "Maybe I need more training...",
      "status": "imported"
    },
    "voice_164:r_76f080a4881e8ab5": {
      "text": "Looks like the armor's scratched...",
      "status": "imported"
    },
    "voice_164:r_288133bc5b573dae": {
      "text": "Donar will chew me out later!",
      "status": "imported"
    },
    "voice_164:r_6f95653e548f8fcf": {
      "text": "I'm hopeless...",
      "status": "imported"
    },
    "voice_164:r_d249d68bada91ab9": {
      "text": "This is just the beginning!",
      "status": "imported"
    },
    "voice_164:r_e9b3307e9eb69f11": {
      "text": "Sorry my support came late.",
      "status": "imported"
    },
    "voice_164:r_03cdac73042343ee": {
      "text": "No, it was my fault!",
      "status": "imported"
    },
    "voice_164:r_6026da5acbda7c69": {
      "text": "Thank goodness it only grazed you...",
      "status": "imported"
    },
    "voice_164:r_981f8fedd5414fe5": {
      "text": "I'll be more careful next time...",
      "status": "imported"
    },
    "voice_164:r_96bb0dcde0c8c44a": {
      "text": "I couldn't dodge...\\nI'm ashamed...",
      "status": "imported"
    },
    "voice_164:r_641550a2f54cb456": {
      "text": "All right! I'll dig you a hole!",
      "status": "imported"
    },
    "voice_164:r_a0f2074af8debbfa": {
      "text": "It's nothing! Don't worry, Yunoha!",
      "status": "imported"
    },
    "voice_164:r_b5f5a97ed82acb0b": {
      "text": "Y-yes!",
      "status": "imported"
    },
    "voice_164:r_d9cd2e4ded064396": {
      "text": "Aquarion is damaged...",
      "status": "imported"
    },
    "voice_164:r_99e6349431aaf23b": {
      "text": "That'll heal if you lick it!",
      "status": "imported"
    },
    "voice_164:r_ec1081caf845f56a": {
      "text": "Want me to take over, Yunoha?",
      "status": "imported"
    },
    "voice_164:r_2c5b7ee872c1ed7f": {
      "text": "No. I want to help everyone too.",
      "status": "imported"
    },
    "voice_164:r_76d1e51c8b494a60": {
      "text": "I'm not scared...! Not at all!",
      "status": "imported"
    },
    "voice_164:r_eb5f687fcd372ae7": {
      "text": "No...!\\nEveryone's Aura is dropping!",
      "status": "imported"
    },
    "voice_164:r_2329428a6871d9fa": {
      "text": "I'm causing trouble for everyone...!",
      "status": "imported"
    },
    "voice_164:r_0e7466971bec4cc4": {
      "text": "I won't flee\\nto end up alone...!",
      "status": "imported"
    },
    "voice_164:r_efa71f7a4cc33ff3": {
      "text": "This isn't even a crisis yet!",
      "status": "imported"
    },
    "voice_164:r_3fc2e1186557e7a0": {
      "text": "I can't lose heart now...!",
      "status": "imported"
    },
    "voice_164:r_fa6930340a545054": {
      "text": "That person...! They're terrifying!",
      "status": "imported"
    },
    "voice_164:r_2332b9d56461d7ab": {
      "text": "Yunoha!\\nFace the person before you!",
      "status": "imported"
    },
    "voice_164:r_854aa0a91a3c80d1": {
      "text": "I wish I could disappear...",
      "status": "imported"
    },
    "voice_164:r_0bc8ae32a406ceab": {
      "text": "I'm sorry I put you through that...",
      "status": "imported"
    },
    "voice_164:r_82c09f011d703b2c": {
      "text": "I'm fine! Yunoha's here with me!",
      "status": "imported"
    },
    "voice_164:r_2b4d8818c77b6dca": {
      "text": "Focus your senses! Feel their moves!",
      "status": "imported"
    },
    "voice_164:r_087354f2db0a31e6": {
      "text": "Y-yes! I'll do everything I can!",
      "status": "imported"
    },
    "voice_164:r_db02a2dec93dd263": {
      "text": "Andy, are you okay!?",
      "status": "imported"
    },
    "voice_164:r_d520c6d5298a848d": {
      "text": "Yeah, no need to worry!",
      "status": "imported"
    },
    "voice_164:r_099e2458cabf796f": {
      "text": "Hey, come on, Yunoha!",
      "status": "imported"
    },
    "voice_164:r_fd910d714be70870": {
      "text": "I'll be more careful next time!",
      "status": "imported"
    },
    "voice_164:r_9736f29b11344ec3": {
      "text": "I-I'm not beaten yet!",
      "status": "imported"
    },
    "voice_164:r_fcd05582aa5c6068": {
      "text": "At least you've got a pro's guts!",
      "status": "imported"
    },
    "voice_164:r_bece29562818acba": {
      "text": "Ah! Jin!",
      "status": "imported"
    },
    "voice_164:r_494b5da92ed24ecb": {
      "text": "It's okay, Yunoha!\\nI'm with you!",
      "status": "imported"
    },
    "voice_164:r_b57d2d74233f889a": {
      "text": "Kyaaaah!",
      "status": "imported"
    },
    "voice_164:r_cd06d0820d82524b": {
      "text": "Aah! I can't take any more!",
      "status": "imported"
    },
    "voice_164:r_c94c6d04be583774": {
      "text": "N-no... What do I do...?",
      "status": "imported"
    },
    "voice_164:r_e54e2c99ef8297af": {
      "text": "The damage keeps piling up...!",
      "status": "imported"
    },
    "voice_164:r_f16a3eb0bcaac082": {
      "text": "It hurts...!\\nBut not like heartache!",
      "status": "imported"
    },
    "voice_164:r_10a408809e512df1": {
      "text": "I can't be the one to give up...!",
      "status": "imported"
    },
    "voice_164:r_bc7b9e308b879dd4": {
      "text": "I want to protect them...! Ngh...!",
      "status": "imported"
    },
    "voice_164:r_98902fd3143c393e": {
      "text": "Jin, please...! Protect us!",
      "status": "imported"
    },
    "voice_164:r_d907fbd7bc1c4298": {
      "text": "Keep going! Don't give up, Yunoha!",
      "status": "imported"
    },
    "voice_164:r_96b21e3a028dd074": {
      "text": "Y-yes!",
      "status": "imported"
    },
    "voice_164:r_ce140b5d8e6b7310": {
      "text": "Because I believe in Yunoha...!",
      "status": "imported"
    },
    "voice_164:r_0e0335789c5396d7": {
      "text": "Thank you, Mikono!",
      "status": "imported"
    },
    "voice_164:r_a8e85bd950696403": {
      "text": "You can't take any more, Yunoha!",
      "status": "imported"
    },
    "voice_164:r_772c8bc40ab6cb61": {
      "text": "But...\\nI'm not beaten yet...!",
      "status": "imported"
    },
    "voice_164:r_58dd2826a199ef51": {
      "text": "Let's dig a huge hole\\nand hide!",
      "status": "imported"
    },
    "voice_164:r_aadc0b2442adb93b": {
      "text": "C-calm down, Andy!",
      "status": "imported"
    },
    "voice_164:r_e7a8cd8ed5bc2d1b": {
      "text": "Let's pull back for now, Yunoha!",
      "status": "imported"
    },
    "voice_164:r_041dd920da4a7c17": {
      "text": "No! I don't want to run anymore...!",
      "status": "imported"
    },
    "voice_164:r_c7f4280cde4605b3": {
      "text": "You're Jin's girl! Get it together!",
      "status": "imported"
    },
    "voice_164:r_ec349c8ea9511a18": {
      "text": "Are you trying to comfort me...?",
      "status": "imported"
    },
    "voice_164:r_33236ffa3ea95b68": {
      "text": "Yunoha doesn't need to get hurt...!",
      "status": "imported"
    },
    "voice_164:r_689d0b123de71ae0": {
      "text": "I'm fine!\\nI'll share Jin's pain too!",
      "status": "imported"
    },
    "voice_164:r_84883aa95f63ce32": {
      "text": "Nooooo...!",
      "status": "imported"
    },
    "voice_164:r_25493e978ce8ff16": {
      "text": "Yunoha Thrul, retreating!",
      "status": "imported"
    },
    "voice_164:r_7316666150e42960": {
      "text": "Jin, why are you here?",
      "status": "imported"
    },
    "voice_164:r_c4f11aa93dc5b668": {
      "text": "Want to play SRW together now?",
      "status": "imported"
    },
    "voice_164:r_ce1a22dfe3a4d339": {
      "text": "It's solo. Teach me if I get stuck.",
      "status": "imported"
    },
    "voice_164:r_240651adab81e145": {
      "text": "I want to protect them...",
      "status": "imported"
    },
    "voice_164:r_cff0deaae73c2858": {
      "text": "I want to protect them...",
      "status": "imported"
    },
    "voice_164:r_dca67f68a573fab7": {
      "text": "What you cherish!",
      "status": "imported"
    },
    "voice_164:r_d8c669c70659e18a": {
      "text": "Hnnn...",
      "status": "imported"
    },
    "voice_164:r_8f5bade7ac2db78e": {
      "text": "Hnnn!",
      "status": "imported"
    },
    "voice_164:r_05ea490d2f522520": {
      "text": "Amata! Zessica!\\nLend me your power!",
      "status": "imported"
    },
    "voice_164:r_f5658c702d91db7a": {
      "text": "Got it!",
      "status": "imported"
    },
    "voice_164:r_686df329b50f195b": {
      "text": "Let's do it, Shrade!",
      "status": "imported"
    },
    "voice_164:r_25f0ab0fa3cf690c": {
      "text": "Here we go! Arpeggio of Souls!",
      "status": "imported"
    },
    "voice_164:r_b708a1d959013dbf": {
      "text": "Sky trills,\\nsea plays arpeggios...",
      "status": "imported"
    },
    "voice_164:r_59fca03e929366c1": {
      "text": "The human moon sings life\\nagitato!",
      "status": "imported"
    },
    "voice_164:r_0d65eb631dcb7514": {
      "text": "Moon Requiem!",
      "status": "imported"
    },
    "voice_164:r_d03018a31e23f1e9": {
      "text": "Human life...! Played with the moon!",
      "status": "imported"
    },
    "voice_164:r_c5611d8dd6def96b": {
      "text": "Haaaah!",
      "status": "imported"
    },
    "voice_164:r_6f12cc8ed2732eb5": {
      "text": "Soul and life ring in moonlight...!",
      "status": "imported"
    },
    "voice_164:r_7abfc55f8fb62ba7": {
      "text": "Resound, Moon Requiem!",
      "status": "imported"
    },
    "voice_164:r_99e7a66c650b5892": {
      "text": "This is the finale!",
      "status": "imported"
    },
    "voice_164:r_5b2247b5cfbcd7b2": {
      "text": "My fastest toccata,\\npluck by pluck!",
      "status": "imported"
    },
    "voice_164:r_2d7a9c06347582d9": {
      "text": "Tonight's moon shall play...!",
      "status": "imported"
    },
    "voice_164:r_bf953d64c3c7d9b7": {
      "text": "Rhapsody!",
      "status": "imported"
    },
    "voice_164:r_e09b933e3e706779": {
      "text": "Bewitched by the lovely moon...!",
      "status": "imported"
    },
    "voice_164:r_66236eb99b676e5b": {
      "text": "Lose yourself in humanity's tune...!",
      "status": "imported"
    },
    "voice_164:r_9639a2dbcd2f58ed": {
      "text": "Rhapsody!",
      "status": "imported"
    },
    "voice_164:r_aeea0893acb93d35": {
      "text": "Oh... My bare skin is sensitive...!",
      "status": "imported"
    },
    "voice_164:r_b31568654e53487b": {
      "text": "Everything in my body...!",
      "status": "imported"
    },
    "voice_164:r_2502132569141ea3": {
      "text": "It's so stimulating!",
      "status": "imported"
    },
    "voice_164:r_1ff312798a52c8eb": {
      "text": "Uoooooh!",
      "status": "imported"
    },
    "voice_164:r_fa07d90fca62f593": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_164:r_a25bf2676ecf9d83": {
      "text": "Barcode!",
      "status": "imported"
    },
    "voice_164:r_237a0288b42dce20": {
      "text": "Attack!!",
      "status": "imported"
    },
    "voice_164:r_0556e8a22779ea8e": {
      "text": "It's embarrassing, but feels good!",
      "status": "imported"
    },
    "voice_164:r_09d377101a48d92a": {
      "text": "My whole body is burning hot!",
      "status": "imported"
    },
    "voice_164:r_11517cc7b0494dbf": {
      "text": "I-it's embarrassing, but...!",
      "status": "imported"
    },
    "voice_164:r_b5864501463db244": {
      "text": "Somehow, it feels good!",
      "status": "imported"
    },
    "voice_164:r_a88939ea84b4474d": {
      "text": "Haaaah!",
      "status": "imported"
    },
    "voice_164:r_a870d0cf7cc11ec6": {
      "text": "Scorch the skin, cleave the flesh!",
      "status": "imported"
    },
    "voice_164:r_be661448b85d0009": {
      "text": "We did it, Amata! Mikono!",
      "status": "imported"
    },
    "voice_164:r_958a56c1151cab9e": {
      "text": "Sh-shame and...!",
      "status": "imported"
    },
    "voice_164:r_8b18aa4cc69547df": {
      "text": "Liberation...!",
      "status": "imported"
    },
    "voice_164:r_3e87f6fc3ea65aef": {
      "text": "A fierce struggle!",
      "status": "imported"
    },
    "voice_164:r_207b256d613bb896": {
      "text": "Haa... My heart won't stop racing!",
      "status": "imported"
    },
    "voice_164:r_4e63c037d3cb8a3d": {
      "text": "I feel my friend's soul so close...!",
      "status": "imported"
    },
    "voice_164:r_9ca8d188ae805e3a": {
      "text": "Now, let's fight together, Cayenne!",
      "status": "imported"
    },
    "voice_164:r_795ed21f3e28e1f5": {
      "text": "Let's go, my friend!",
      "status": "imported"
    },
    "voice_164:r_141415c1def5ab2d": {
      "text": "Dedicated to my friend!",
      "status": "imported"
    },
    "voice_164:r_c894e35becf35a03": {
      "text": "Requiem!!",
      "status": "imported"
    },
    "voice_164:r_79b1abf5fc86483c": {
      "text": "Now, play the ultimate melody!",
      "status": "imported"
    },
    "voice_164:r_e9a11621911acb19": {
      "text": "Will you play it with me, Cayenne?",
      "status": "imported"
    },
    "voice_164:r_d52bece55796f599": {
      "text": "Of course, my friend.",
      "status": "imported"
    },
    "voice_164:r_358fe5a50bbee1df": {
      "text": "I'll play it with my friend!",
      "status": "imported"
    },
    "voice_164:r_638834e16724002f": {
      "text": "Requiem!!",
      "status": "imported"
    },
    "voice_164:r_b02fca1590ac1210": {
      "text": "New sound is born\\nfrom inside us...!",
      "status": "imported"
    },
    "voice_164:r_f0344d2fbaa9db77": {
      "text": "This is what Shrade sought...!",
      "status": "imported"
    },
    "voice_164:r_3328eef766ff2c2c": {
      "text": "Yes! The ultimate melody!",
      "status": "imported"
    },
    "voice_164:r_23b037cf6ccc695c": {
      "text": "Combine Spada and Gepard's power...!",
      "status": "imported"
    },
    "voice_164:r_883ad1128d340c5e": {
      "text": "Requiem!!",
      "status": "imported"
    },
    "voice_164:r_2a730c9b4df0dca3": {
      "text": "Nooooo...!",
      "status": "imported"
    },
    "voice_164:r_1e5842ba5dc3f705": {
      "text": "This is...!",
      "status": "imported"
    },
    "voice_164:r_9747bd61ad23ecd3": {
      "text": "Fuse!!",
      "status": "imported"
    },
    "voice_164:r_6823f8abe05c4727": {
      "text": "Ours!",
      "status": "imported"
    },
    "voice_164:r_c885ff2097749991": {
      "text": "I'll draw the enemy's attention!",
      "status": "imported"
    },
    "voice_164:r_a8da7f8d8b705db0": {
      "text": "The rest is up to you!",
      "status": "imported"
    },
    "voice_164:r_02e1c5e19de5bd22": {
      "text": "I mustn't hold everyone back...!",
      "status": "imported"
    },
    "voice_164:r_6fb823898811e210": {
      "text": "Leave the assist to me!",
      "status": "imported"
    },
    "voice_164:r_5dcbcf1682cc3ab8": {
      "text": "One-on-one? All right...!",
      "status": "imported"
    },
    "voice_164:r_5a20988e743dc1d0": {
      "text": "I'll show you I can do it right!",
      "status": "imported"
    },
    "voice_164:r_197f05bf899b7697": {
      "text": "They trusted me with this!",
      "status": "imported"
    },
    "voice_164:r_623ee03bd91ab2a1": {
      "text": "That's my enemy...!",
      "status": "imported"
    }
  }
}
