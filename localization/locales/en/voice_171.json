{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_171:r_479b340ccc6c572b": {
      "text": "Found you!",
      "status": "imported"
    },
    "voice_171:r_ca4acbac57a2a35e": {
      "text": "I don't even need to take aim!",
      "status": "imported"
    },
    "voice_171:r_77949221bf58f862": {
      "text": "This is Loni! Going straight in!",
      "status": "imported"
    },
    "voice_171:r_70b9c4b9f1f37eff": {
      "text": "I won't let you interfere!",
      "status": "imported"
    },
    "voice_171:r_9fcb3754cb1773c7": {
      "text": "Coming at me head-on?!",
      "status": "imported"
    },
    "voice_171:r_3559d2fad32c2435": {
      "text": "As long as I land a hit!",
      "status": "imported"
    },
    "voice_171:r_f7570547e9f80a64": {
      "text": "Just disappear!",
      "status": "imported"
    },
    "voice_171:r_cbab0f4720e1fcf1": {
      "text": "I'll blast you away!",
      "status": "imported"
    },
    "voice_171:r_0bbe0b4f5364e732": {
      "text": "I won't miss!",
      "status": "imported"
    },
    "voice_171:r_5dda5198137cb02a": {
      "text": "As if you could dodge!",
      "status": "imported"
    },
    "voice_171:r_83ec59afbecdec14": {
      "text": "I'll shoot down every last enemy!",
      "status": "imported"
    },
    "voice_171:r_e20bfd42ad95a3c9": {
      "text": "I'll use whatever it takes!",
      "status": "imported"
    },
    "voice_171:r_0f58a8822381e57f": {
      "text": "I'll avenge Father here and now!",
      "status": "imported"
    },
    "voice_171:r_6dbcc507fb61b51d": {
      "text": "Sieg Zeon!",
      "status": "imported"
    },
    "voice_171:r_b42ab697149a7c8a": {
      "text": "With this Shambro...!",
      "status": "imported"
    },
    "voice_171:r_4de4fcf3b440baf4": {
      "text": "Shambro embodies all our rage!",
      "status": "imported"
    },
    "voice_171:r_0121a166c715cdff": {
      "text": "Did you think it was over?!",
      "status": "imported"
    },
    "voice_171:r_30fad37a42bd3ad3": {
      "text": "Your next move is too slow!",
      "status": "imported"
    },
    "voice_171:r_80a0b2a84e05d81a": {
      "text": "That split-horn Gundam is nothing!",
      "status": "imported"
    },
    "voice_171:r_4a9ac1dff86506d9": {
      "text": "The key to the Box defies me?!",
      "status": "imported"
    },
    "voice_171:r_bc8538e6af3d2577": {
      "text": "Clear the way, Banagher!",
      "status": "imported"
    },
    "voice_171:r_924516c8de2b5342": {
      "text": "You would defy me, Gundam?!",
      "status": "imported"
    },
    "voice_171:r_da1174533722333f": {
      "text": "I'll take care of the Gundam!",
      "status": "imported"
    },
    "voice_171:r_fdeb8162976e72c1": {
      "text": "Gundam... Zeon's sworn enemy!",
      "status": "imported"
    },
    "voice_171:r_0fadb5c26df92b42": {
      "text": "A machine descended from Gundam?!",
      "status": "imported"
    },
    "voice_171:r_6b15af9a0057cdc8": {
      "text": "I'm facing the Federation's elite?!",
      "status": "imported"
    },
    "voice_171:r_15b4a90140e8a33a": {
      "text": "A mere MS\\ncan't defeat Shambro!",
      "status": "imported"
    },
    "voice_171:r_af884a6b11dff121": {
      "text": "This feeling is so repulsive...!",
      "status": "imported"
    },
    "voice_171:r_ac6fe7838e95647b": {
      "text": "What in the world is this thing?!",
      "status": "imported"
    },
    "voice_171:r_77ca87eacd17ad52": {
      "text": "From Shambro, you look like ants!",
      "status": "imported"
    },
    "voice_171:r_bf3244994760e535": {
      "text": "Don't waste shots - clear the way!",
      "status": "imported"
    },
    "voice_171:r_aabfb21c9d069ce7": {
      "text": "You pest, buzzing around overhead!",
      "status": "imported"
    },
    "voice_171:r_02479dc8fe989560": {
      "text": "I'll crush you beneath Shambro!",
      "status": "imported"
    },
    "voice_171:r_a2df00f91a9b0a9e": {
      "text": "Battleships fall\\nto Shambro's guns!",
      "status": "imported"
    },
    "voice_171:r_f2d4255f1c2f7542": {
      "text": "This is payback!",
      "status": "imported"
    },
    "voice_171:r_5d08ad19e2da125b": {
      "text": "Don't get in my way!",
      "status": "imported"
    },
    "voice_171:r_a7246b52782a877e": {
      "text": "You're no match for Shambro!",
      "status": "imported"
    },
    "voice_171:r_dc8701f6bcb9904f": {
      "text": "Do you want to die that badly?!",
      "status": "imported"
    },
    "voice_171:r_d6bdd730f24f66eb": {
      "text": "Regret ever attacking me!",
      "status": "imported"
    },
    "voice_171:r_41997412868c48c4": {
      "text": "Don't think you can escape!",
      "status": "imported"
    },
    "voice_171:r_9e6cf4f389dae55c": {
      "text": "Stand in my way and...!",
      "status": "imported"
    },
    "voice_171:r_9e0c80ac7e33b459": {
      "text": "You should've cleared the way!",
      "status": "imported"
    },
    "voice_171:r_7432ef43ed3471dc": {
      "text": "Shambro can't counterattack...!?",
      "status": "imported"
    },
    "voice_171:r_065443f6ddfcf0d7": {
      "text": "We must advance, not chase them...!",
      "status": "imported"
    },
    "voice_171:r_47d52a2839c71715": {
      "text": "Near the operating limit...!?",
      "status": "imported"
    },
    "voice_171:r_847f82e7f3eef651": {
      "text": "They escaped my range...!",
      "status": "imported"
    },
    "voice_171:r_eb7ae28b53dc033c": {
      "text": "Damn! I can't attack from there!",
      "status": "imported"
    },
    "voice_171:r_857c4a52ce8df0fd": {
      "text": "I missed?!",
      "status": "imported"
    },
    "voice_171:r_55417493fce1d347": {
      "text": "I sense hostility...!",
      "status": "imported"
    },
    "voice_171:r_8fdf5910927c9591": {
      "text": "I can see your every move...!",
      "status": "imported"
    },
    "voice_171:r_7d724dbcc4451e10": {
      "text": "You thought I couldn't dodge?!",
      "status": "imported"
    },
    "voice_171:r_93e25418a203cb8f": {
      "text": "Too scared to aim straight?!",
      "status": "imported"
    },
    "voice_171:r_adeb0a29274d3d9b": {
      "text": "You underestimated our mobility!",
      "status": "imported"
    },
    "voice_171:r_24cf161287ef9d5c": {
      "text": "Split-horn Gundam!\\nYield and move!",
      "status": "imported"
    },
    "voice_171:r_8f60f6fc86db3107": {
      "text": "Don't interfere, Banagher...!",
      "status": "imported"
    },
    "voice_171:r_b1de76a75a253c13": {
      "text": "Even Gundam falls before Shambro!",
      "status": "imported"
    },
    "voice_171:r_128c35bf3e0e394c": {
      "text": "Even Gundam is no match!",
      "status": "imported"
    },
    "voice_171:r_5213c17e13b23de0": {
      "text": "Federation attacks are nothing...!",
      "status": "imported"
    },
    "voice_171:r_38fdff9483e9245c": {
      "text": "A mobile suit\\ncan't beat Shambro!",
      "status": "imported"
    },
    "voice_171:r_620fedec67706d7d": {
      "text": "Damn...!\\nI said leave me alone...!",
      "status": "imported"
    },
    "voice_171:r_9680dcd0fddcfcc7": {
      "text": "What?! This revulsion is growing!",
      "status": "imported"
    },
    "voice_171:r_a007f9ab9cf048b3": {
      "text": "With Reflector Bits on my side!",
      "status": "imported"
    },
    "voice_171:r_ddafde4b065ced49": {
      "text": "Shambro has gear like this too!",
      "status": "imported"
    },
    "voice_171:r_de1213040856c089": {
      "text": "Stop this pointless struggle!",
      "status": "imported"
    },
    "voice_171:r_0c0775e051211840": {
      "text": "It hit...!",
      "status": "imported"
    },
    "voice_171:r_a2afffe1c396f0b3": {
      "text": "What a half-hearted attack!",
      "status": "imported"
    },
    "voice_171:r_13c25fbdfddc8a24": {
      "text": "No number of such weak hits matters!",
      "status": "imported"
    },
    "voice_171:r_42ba1ecb310b4bd7": {
      "text": "Did you think that could stop me?!",
      "status": "imported"
    },
    "voice_171:r_d692f1d420460a47": {
      "text": "I don't have time to deal with you!",
      "status": "imported"
    },
    "voice_171:r_a5643cec86b18bd2": {
      "text": "Tch! You took out one of my Bits!",
      "status": "imported"
    },
    "voice_171:r_68f2dfab20a4a30e": {
      "text": "You insist on getting in my way?!",
      "status": "imported"
    },
    "voice_171:r_9cedad8237480563": {
      "text": "I'll get you before you get me...!",
      "status": "imported"
    },
    "voice_171:r_a03fabecba1508ca": {
      "text": "Damn! You came from my blind spot!",
      "status": "imported"
    },
    "voice_171:r_5391b24a71eb10ae": {
      "text": "Zeon's rage... Mine won't end here!",
      "status": "imported"
    },
    "voice_171:r_a554ceef5c87b972": {
      "text": "It's not fatal! I can still fight!",
      "status": "imported"
    },
    "voice_171:r_546c3d5937fbb7ee": {
      "text": "Engines intact!\\nWe keep advancing!",
      "status": "imported"
    },
    "voice_171:r_1568ff6298b12b96": {
      "text": "Enough, you split-horn Gundam...!",
      "status": "imported"
    },
    "voice_171:r_2c9d94ba13c5fc50": {
      "text": "Banagher...! It's too late now...!",
      "status": "imported"
    },
    "voice_171:r_a77f4913375098d2": {
      "text": "Still getting in my way, Gundam?!",
      "status": "imported"
    },
    "voice_171:r_428c2116ac3071b1": {
      "text": "Gundam!\\nMy kin, comrades - now me?!",
      "status": "imported"
    },
    "voice_171:r_84c116267b79f540": {
      "text": "Spineless Feds\\nresist this much...!?",
      "status": "imported"
    },
    "voice_171:r_dad38ee29af2df3a": {
      "text": "They...!\\nA cause not to yield too?!",
      "status": "imported"
    },
    "voice_171:r_3d32e86f8dc80909": {
      "text": "My wish and heart!\\nYou can't know!",
      "status": "imported"
    },
    "voice_171:r_70451ffbabe2f876": {
      "text": "Don't...! Stay out of my heart!",
      "status": "imported"
    },
    "voice_171:r_3c5b0c2ac812d5de": {
      "text": "While I can move, I'll press on...!",
      "status": "imported"
    },
    "voice_171:r_5b9e8897190892eb": {
      "text": "I don't care about limits! I...!",
      "status": "imported"
    },
    "voice_171:r_7bea3023abbf8a94": {
      "text": "Retreat was never an option...!",
      "status": "imported"
    },
    "voice_171:r_dd01a4c0d1b36a8d": {
      "text": "Don't stop, Shambro...! Move!",
      "status": "imported"
    },
    "voice_171:r_20920ad2eb3542db": {
      "text": "I may go no farther...! But...!",
      "status": "imported"
    },
    "voice_171:r_0ab7914877fd48ed": {
      "text": "Avenge Father, Mother,\\nand comrades!",
      "status": "imported"
    },
    "voice_171:r_cb846feec748c2e3": {
      "text": "Not yet! It's not over yet...!",
      "status": "imported"
    },
    "voice_171:r_c958860b0676b1f5": {
      "text": "Shambro still moves...! Still...!!",
      "status": "imported"
    },
    "voice_171:r_aba6a7662129d8ce": {
      "text": "Focus, and finish this!",
      "status": "imported"
    },
    "voice_171:r_b84afafb8a33ec60": {
      "text": "I'll pin you right there!",
      "status": "imported"
    },
    "voice_171:r_c8c59db85bf875e6": {
      "text": "I can handle things here alone!",
      "status": "imported"
    },
    "voice_171:r_391aa56435d9dd6e": {
      "text": "You can't beat me one-on-one!",
      "status": "imported"
    },
    "voice_171:r_7c796ba53bd7ea03": {
      "text": "Shambro will take it from here!",
      "status": "imported"
    },
    "voice_171:r_fa944da4b6519006": {
      "text": "Clear my line of fire!",
      "status": "imported"
    },
    "voice_171:r_95d047bcc17fccc6": {
      "text": "Kirks! Leave this to me!",
      "status": "imported"
    },
    "voice_171:r_640327a12a559b31": {
      "text": "Use Shambro as your shield!",
      "status": "imported"
    },
    "voice_171:r_bdd38c584fa313d0": {
      "text": "Fall back to the rear!",
      "status": "imported"
    },
    "voice_171:r_3fd86c1027f317c8": {
      "text": "Kirks! Fall back!",
      "status": "imported"
    }
  }
}
