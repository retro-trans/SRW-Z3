{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_082:r_479b340ccc6c572b": {
      "text": "Commencing combat...!",
      "status": "imported"
    },
    "voice_082:r_ca4acbac57a2a35e": {
      "text": "You Earthlings can't hope to win!",
      "status": "imported"
    },
    "voice_082:r_77949221bf58f862": {
      "text": "Only destruction awaits you!",
      "status": "imported"
    },
    "voice_082:r_70b9c4b9f1f37eff": {
      "text": "Witness the power we wield...!",
      "status": "imported"
    },
    "voice_082:r_9fcb3754cb1773c7": {
      "text": "Fall!",
      "status": "imported"
    },
    "voice_082:r_3559d2fad32c2435": {
      "text": "I'll make this hit!",
      "status": "imported"
    },
    "voice_082:r_f7570547e9f80a64": {
      "text": "If that's how you want it!",
      "status": "imported"
    },
    "voice_082:r_cbab0f4720e1fcf1": {
      "text": "I can see you!",
      "status": "imported"
    },
    "voice_082:r_0bbe0b4f5364e732": {
      "text": "The outcome's already decided!",
      "status": "imported"
    },
    "voice_082:r_5dda5198137cb02a": {
      "text": "No hard feelings!",
      "status": "imported"
    },
    "voice_082:r_83ec59afbecdec14": {
      "text": "Don't bother resisting!",
      "status": "imported"
    },
    "voice_082:r_e20bfd42ad95a3c9": {
      "text": "Perfect timing!",
      "status": "imported"
    },
    "voice_082:r_0f58a8822381e57f": {
      "text": "At this distance...!",
      "status": "imported"
    },
    "voice_082:r_6dbcc507fb61b51d": {
      "text": "You're naive in every way!",
      "status": "imported"
    },
    "voice_082:r_b42ab697149a7c8a": {
      "text": "A backwater fool knows nothing!",
      "status": "imported"
    },
    "voice_082:r_4de4fcf3b440baf4": {
      "text": "Resist, and you'll only suffer!",
      "status": "imported"
    },
    "voice_082:r_0121a166c715cdff": {
      "text": "I'll carry out the mission!",
      "status": "imported"
    },
    "voice_082:r_30fad37a42bd3ad3": {
      "text": "All that's left is to crush them!",
      "status": "imported"
    },
    "voice_082:r_80a0b2a84e05d81a": {
      "text": "A convenient target!",
      "status": "imported"
    },
    "voice_082:r_4a9ac1dff86506d9": {
      "text": "Know your place, Earthling!",
      "status": "imported"
    },
    "voice_082:r_bc8538e6af3d2577": {
      "text": "This is the fate that awaits you!",
      "status": "imported"
    },
    "voice_082:r_924516c8de2b5342": {
      "text": "I've no grudge against you... But!",
      "status": "imported"
    },
    "voice_082:r_da1174533722333f": {
      "text": "You've fallen for our tactics!",
      "status": "imported"
    },
    "voice_082:r_fdeb8162976e72c1": {
      "text": "Tactical Pattern 073!",
      "status": "imported"
    },
    "voice_082:r_0fadb5c26df92b42": {
      "text": "Applying Tactical Pattern 154!",
      "status": "imported"
    },
    "voice_082:r_6b15af9a0057cdc8": {
      "text": "Witness how the Geminis fight!",
      "status": "imported"
    },
    "voice_082:r_15b4a90140e8a33a": {
      "text": "This is how the Geminis fight!",
      "status": "imported"
    },
    "voice_082:r_af884a6b11dff121": {
      "text": "Geminis pride lives on in me!",
      "status": "imported"
    },
    "voice_082:r_ac6fe7838e95647b": {
      "text": "Though this fight means nothing...!",
      "status": "imported"
    },
    "voice_082:r_77ca87eacd17ad52": {
      "text": "Blame them if you must!",
      "status": "imported"
    },
    "voice_082:r_bf3244994760e535": {
      "text": "Why was only your world spared...!",
      "status": "imported"
    },
    "voice_082:r_aabfb21c9d069ce7": {
      "text": "Then we'll face you head-on!",
      "status": "imported"
    },
    "voice_082:r_02479dc8fe989560": {
      "text": "Should've died\\nin civil war...!",
      "status": "imported"
    },
    "voice_082:r_a2df00f91a9b0a9e": {
      "text": "Head-on, we'll never fall behind!",
      "status": "imported"
    },
    "voice_082:r_48b60d6c48b9b142": {
      "text": "There's no turning back for us now!",
      "status": "imported"
    },
    "voice_082:r_8927e6fb681aa809": {
      "text": "Then we'll take Earth down with us!",
      "status": "imported"
    },
    "voice_082:r_665f01666859013b": {
      "text": "Walk quietly down the path to ruin!",
      "status": "imported"
    },
    "voice_082:r_a571eec59b258d11": {
      "text": "Let Earth meet Geminai's fate!",
      "status": "imported"
    },
    "voice_082:r_ddbe581c5ea9183d": {
      "text": "How is Earth unlike our Geminai!",
      "status": "imported"
    },
    "voice_082:r_faae935cca0edc72": {
      "text": "Only you are spared...\\nI forbid it!",
      "status": "imported"
    },
    "voice_082:r_d4430bf362340b32": {
      "text": "I'll score a direct hit!",
      "status": "imported"
    },
    "voice_082:r_6ff1323b355593e0": {
      "text": "I'll shoot through the power core!",
      "status": "imported"
    },
    "voice_082:r_b7b5625d7cd4282f": {
      "text": "My sights are aligned!",
      "status": "imported"
    },
    "voice_082:r_36133ad73a73ef98": {
      "text": "I'll shoot it down with this!",
      "status": "imported"
    },
    "voice_082:r_920740a0219c5085": {
      "text": "You're in range!",
      "status": "imported"
    },
    "voice_082:r_a8451712c57c1a72": {
      "text": "Close combat!",
      "status": "imported"
    },
    "voice_082:r_3633df5b7b8f47fa": {
      "text": "This is a valid tactic too!",
      "status": "imported"
    },
    "voice_082:r_52dfc56b14b93551": {
      "text": "I'll close the distance!",
      "status": "imported"
    },
    "voice_082:r_1b9b2aab5cb104da": {
      "text": "Cross Combat!",
      "status": "imported"
    },
    "voice_082:r_342044c706a2340f": {
      "text": "I'll cut you apart!",
      "status": "imported"
    },
    "voice_082:r_cf41e8828a90cbdb": {
      "text": "Continuing the attack!",
      "status": "imported"
    },
    "voice_082:r_719e897304ec42d4": {
      "text": "Don't think that was the end!",
      "status": "imported"
    },
    "voice_082:r_d5e0a2317c40d322": {
      "text": "And now, one more strike!",
      "status": "imported"
    },
    "voice_082:r_ec2ea17765052401": {
      "text": "My opponent's a Gundam!",
      "status": "imported"
    },
    "voice_082:r_f2d4255f1c2f7542": {
      "text": "I'll knock you down, Gundam!",
      "status": "imported"
    },
    "voice_082:r_5d08ad19e2da125b": {
      "text": "How many Gundams\\ndoes Earth have!?",
      "status": "imported"
    },
    "voice_082:r_a7246b52782a877e": {
      "text": "Another Gundam here too!",
      "status": "imported"
    },
    "voice_082:r_dc8701f6bcb9904f": {
      "text": "Earth's famed super robot!",
      "status": "imported"
    },
    "voice_082:r_d6bdd730f24f66eb": {
      "text": "So this is a super robot!",
      "status": "imported"
    },
    "voice_082:r_41997412868c48c4": {
      "text": "Here comes a one-off custom unit!",
      "status": "imported"
    },
    "voice_082:r_9e6cf4f389dae55c": {
      "text": "Power alone won't decide this!",
      "status": "imported"
    },
    "voice_082:r_9e0c80ac7e33b459": {
      "text": "I'll show you war's cruelty, kid!",
      "status": "imported"
    },
    "voice_082:r_7432ef43ed3471dc": {
      "text": "Stay out of this, kid!",
      "status": "imported"
    },
    "voice_082:r_065443f6ddfcf0d7": {
      "text": "This thing... A psychic weapon!?",
      "status": "imported"
    },
    "voice_082:r_47d52a2839c71715": {
      "text": "Is its pilot a psychic!?",
      "status": "imported"
    },
    "voice_082:r_847f82e7f3eef651": {
      "text": "It's like a true demon god...!",
      "status": "imported"
    },
    "voice_082:r_eb7ae28b53dc033c": {
      "text": "I'll tear that proud armor apart!",
      "status": "imported"
    },
    "voice_082:r_857c4a52ce8df0fd": {
      "text": "This unit runs on Getter Rays!?",
      "status": "imported"
    },
    "voice_082:r_55417493fce1d347": {
      "text": "I'll strike before it transforms!",
      "status": "imported"
    },
    "voice_082:r_7d724dbcc4451e10": {
      "text": "I'll subdue this beast by force!",
      "status": "imported"
    },
    "voice_082:r_93e25418a203cb8f": {
      "text": "A civilian on the battlefield!?",
      "status": "imported"
    },
    "voice_082:r_adeb0a29274d3d9b": {
      "text": "I'll run circles around that hulk!",
      "status": "imported"
    },
    "voice_082:r_24cf161287ef9d5c": {
      "text": "Don't think words can win a battle!",
      "status": "imported"
    },
    "voice_082:r_b1de76a75a253c13": {
      "text": "No way...\\nA fabled Machine Angel!?",
      "status": "imported"
    },
    "voice_082:r_128c35bf3e0e394c": {
      "text": "That huge thing\\ncan't turn quickly!",
      "status": "imported"
    },
    "voice_082:r_5213c17e13b23de0": {
      "text": "I'll smash that precious drill!",
      "status": "imported"
    },
    "voice_082:r_38fdff9483e9245c": {
      "text": "This machine... Is it alive!?",
      "status": "imported"
    },
    "voice_082:r_620fedec67706d7d": {
      "text": "Earth's mainstay mobile suit!?",
      "status": "imported"
    },
    "voice_082:r_9680dcd0fddcfcc7": {
      "text": "This thing...\\nBuilt like Diosc!?",
      "status": "imported"
    },
    "voice_082:r_2a00f1044ad5cbaa": {
      "text": "Tch! I can't get a clean lock!",
      "status": "imported"
    },
    "voice_082:r_3dbeead1bd3164ef": {
      "text": "A small unit falls in one hit!",
      "status": "imported"
    },
    "voice_082:r_98d15b8cc09bc915": {
      "text": "A fast transformable unit!",
      "status": "imported"
    },
    "voice_082:r_46e86d000250e137": {
      "text": "Impressive agility! But...!",
      "status": "imported"
    },
    "voice_082:r_ac341e7976e88f0b": {
      "text": "Just what are you trying to do!?",
      "status": "imported"
    },
    "voice_082:r_cfccaa1fbeda124c": {
      "text": "Why is someone like you in battle!?",
      "status": "imported"
    },
    "voice_082:r_a007f9ab9cf048b3": {
      "text": "Damn! You're hard to fight!",
      "status": "imported"
    },
    "voice_082:r_de1213040856c089": {
      "text": "Take out the leader - tactics 101!",
      "status": "imported"
    },
    "voice_082:r_3304412ac41f47a6": {
      "text": "You're the core of their forces!",
      "status": "imported"
    },
    "voice_082:r_0c0775e051211840": {
      "text": "I'll engage the enemy ship!",
      "status": "imported"
    },
    "voice_082:r_a2afffe1c396f0b3": {
      "text": "A warship! Aim for the bridge!",
      "status": "imported"
    },
    "voice_082:r_13c25fbdfddc8a24": {
      "text": "Your existence won't be tolerated!",
      "status": "imported"
    },
    "voice_082:r_42ba1ecb310b4bd7": {
      "text": "Fake Geminia!\\nI'll knock you down!",
      "status": "imported"
    },
    "voice_082:r_d692f1d420460a47": {
      "text": "Pay for wounding our pride!",
      "status": "imported"
    },
    "voice_082:r_a5643cec86b18bd2": {
      "text": "How long will you thwart us!?",
      "status": "imported"
    },
    "voice_082:r_68f2dfab20a4a30e": {
      "text": "This unit uses Spirit Energy!?",
      "status": "imported"
    },
    "voice_082:r_9cedad8237480563": {
      "text": "Light Particle Maser!",
      "status": "imported"
    },
    "voice_082:r_a03fabecba1508ca": {
      "text": "Light particles focused! Fire!",
      "status": "imported"
    },
    "voice_082:r_5391b24a71eb10ae": {
      "text": "Psychic targeting! I won't miss!",
      "status": "imported"
    },
    "voice_082:r_a554ceef5c87b972": {
      "text": "Light Particle Blade!",
      "status": "imported"
    },
    "voice_082:r_546c3d5937fbb7ee": {
      "text": "Light particles focused! Take this!",
      "status": "imported"
    },
    "voice_082:r_1568ff6298b12b96": {
      "text": "Witness the Geminis battle arts!",
      "status": "imported"
    },
    "voice_082:r_2c9d94ba13c5fc50": {
      "text": "Don't think you can escape!",
      "status": "imported"
    },
    "voice_082:r_a77f4913375098d2": {
      "text": "Taaake this!",
      "status": "imported"
    },
    "voice_082:r_428c2116ac3071b1": {
      "text": "Command Arts, set!",
      "status": "imported"
    },
    "voice_082:r_84c116267b79f540": {
      "text": "Let's do this, Diosc!",
      "status": "imported"
    },
    "voice_082:r_dad38ee29af2df3a": {
      "text": "I'll finish you for sure!!",
      "status": "imported"
    },
    "voice_082:r_3d32e86f8dc80909": {
      "text": "Psy-Control, max level!",
      "status": "imported"
    },
    "voice_082:r_70451ffbabe2f876": {
      "text": "Witness pilot and machine as one!",
      "status": "imported"
    },
    "voice_082:r_69dfa1659715e2fa": {
      "text": "This is Geminis Command Arts!",
      "status": "imported"
    },
    "voice_082:r_26e5efec03c03d78": {
      "text": "Counterattack, now!",
      "status": "imported"
    },
    "voice_082:r_4ad81e88c7557a8b": {
      "text": "I lured you right into my trap!",
      "status": "imported"
    },
    "voice_082:r_1f65a7af190e4674": {
      "text": "Now it's our turn!",
      "status": "imported"
    },
    "voice_082:r_40c5a9358ed5bf29": {
      "text": "I never forget a grudge...!",
      "status": "imported"
    },
    "voice_082:r_f2e18dfdfe0c89ea": {
      "text": "I'll turn the tables on you!",
      "status": "imported"
    },
    "voice_082:r_cf7dbf49e96a5755": {
      "text": "You're within our range!",
      "status": "imported"
    },
    "voice_082:r_fa96676cc65bb509": {
      "text": "You should've retreated sooner!",
      "status": "imported"
    },
    "voice_082:r_4e37f92e7d2fc62e": {
      "text": "Here's some payback!",
      "status": "imported"
    },
    "voice_082:r_66ab4cfe1557909d": {
      "text": "We're not down yet!",
      "status": "imported"
    },
    "voice_082:r_0bad405ee6ca63ba": {
      "text": "Targeting me sealed your fate!",
      "status": "imported"
    },
    "voice_082:r_2072eaf71a260ae7": {
      "text": "Blame your own recklessness!",
      "status": "imported"
    },
    "voice_082:r_6c13bbfd27a7799e": {
      "text": "Earthling! I'll show you what for!",
      "status": "imported"
    },
    "voice_082:r_06f88dcbd3c9e738": {
      "text": "Leave the rest to me!",
      "status": "imported"
    },
    "voice_082:r_b28faf9f71bc3598": {
      "text": "I'll deliver the final blow!",
      "status": "imported"
    },
    "voice_082:r_8a29278549f8e07a": {
      "text": "Our attack isn't over yet!",
      "status": "imported"
    },
    "voice_082:r_7e6c573c26177f98": {
      "text": "No time to catch your breath!",
      "status": "imported"
    },
    "voice_082:r_45abf84f7757d6eb": {
      "text": "Witness the Geminis fight as one!",
      "status": "imported"
    },
    "voice_082:r_edd7a13ab8f06a14": {
      "text": "I'll cover you, Major Annalotta!",
      "status": "imported"
    },
    "voice_082:r_8165e5b41f0124c4": {
      "text": "Major! I'll take it from here!",
      "status": "imported"
    },
    "voice_082:r_4e05581b7432cce8": {
      "text": "I'm with you, Captain!",
      "status": "imported"
    },
    "voice_082:r_a60b107ea3c36a86": {
      "text": "Together with the Captain...!",
      "status": "imported"
    },
    "voice_082:r_e33693e5ba4665b0": {
      "text": "Pull back for now!",
      "status": "imported"
    },
    "voice_082:r_72a21a1a489af001": {
      "text": "Use my machine as your shield!",
      "status": "imported"
    },
    "voice_082:r_eb643f8bf737a0ca": {
      "text": "I'll withstand an attack that weak!",
      "status": "imported"
    },
    "voice_082:r_0a3fccb71ec6cf2a": {
      "text": "I'll hold them off here!",
      "status": "imported"
    },
    "voice_082:r_9b63cf1f3e0207ef": {
      "text": "I won't let them hurt my comrade!",
      "status": "imported"
    },
    "voice_082:r_8356f4e3dcdff938": {
      "text": "Please fall back, Major Annalotta!",
      "status": "imported"
    },
    "voice_082:r_1d6d784036ae0bd7": {
      "text": "The Major is the Geminaids' hope!",
      "status": "imported"
    },
    "voice_082:r_625664af02183c17": {
      "text": "I won't let them take the Captain!",
      "status": "imported"
    },
    "voice_082:r_3701cba361f80ea5": {
      "text": "I'd gladly be Geminia's shield!",
      "status": "imported"
    },
    "voice_082:r_63f429c5c68c0863": {
      "text": "Tch! I can't counterattack!?",
      "status": "imported"
    },
    "voice_082:r_38e4a434c91d8ef0": {
      "text": "You outmaneuvered even me...!",
      "status": "imported"
    },
    "voice_082:r_98ed411352a3a6ac": {
      "text": "My counterattack's fully sealed...!",
      "status": "imported"
    },
    "voice_082:r_4824bea6bab3af67": {
      "text": "Don't think I'll stay your target!",
      "status": "imported"
    },
    "voice_082:r_862b92e63adb9734": {
      "text": "You know your tactical basics...!",
      "status": "imported"
    },
    "voice_082:r_cb306ef55e49d107": {
      "text": "Not cheap...\\nIt's still a tactic!",
      "status": "imported"
    },
    "voice_082:r_57b2bd2de8a1408d": {
      "text": "Fine tactics... But not twice!",
      "status": "imported"
    },
    "voice_082:r_76f080a4881e8ab5": {
      "text": "Me, caught in a trap...!?",
      "status": "imported"
    },
    "voice_082:r_288133bc5b573dae": {
      "text": "This much is nothing.",
      "status": "imported"
    },
    "voice_082:r_6f95653e548f8fcf": {
      "text": "Did you really think that'd hit?",
      "status": "imported"
    },
    "voice_082:r_d249d68bada91ab9": {
      "text": "Whoa! That was close!",
      "status": "imported"
    },
    "voice_082:r_e9b3307e9eb69f11": {
      "text": "I can see that move coming...!",
      "status": "imported"
    },
    "voice_082:r_03cdac73042343ee": {
      "text": "Try all you want - it's useless!",
      "status": "imported"
    },
    "voice_082:r_6026da5acbda7c69": {
      "text": "I've already read your tactics!",
      "status": "imported"
    },
    "voice_082:r_981f8fedd5414fe5": {
      "text": "You fell for the feint!",
      "status": "imported"
    },
    "voice_082:r_96bb0dcde0c8c44a": {
      "text": "That feeble attack won't work!",
      "status": "imported"
    },
    "voice_082:r_641550a2f54cb456": {
      "text": "Fallen or not, we're still Geminis!",
      "status": "imported"
    },
    "voice_082:r_a0f2074af8debbfa": {
      "text": "Diosc can use\\nPsy-Control!",
      "status": "imported"
    },
    "voice_082:r_b5f5a97ed82acb0b": {
      "text": "I've locked onto your hostility...!",
      "status": "imported"
    },
    "voice_082:r_d9cd2e4ded064396": {
      "text": "Pathetic, Gundam!",
      "status": "imported"
    },
    "voice_082:r_99e6349431aaf23b": {
      "text": "Too soft, Gundam!",
      "status": "imported"
    },
    "voice_082:r_ec1081caf845f56a": {
      "text": "Some super robot you are!",
      "status": "imported"
    },
    "voice_082:r_2c5b7ee872c1ed7f": {
      "text": "Well, super robot?\\nIs that all!?",
      "status": "imported"
    },
    "voice_082:r_76d1e51c8b494a60": {
      "text": "Don't make me laugh, impostor!",
      "status": "imported"
    },
    "voice_082:r_eb5f687fcd372ae7": {
      "text": "I knew it...\\nNothing like Geminia!",
      "status": "imported"
    },
    "voice_082:r_854aa0a91a3c80d1": {
      "text": "Go on with your futile resistance!",
      "status": "imported"
    },
    "voice_082:r_82c09f011d703b2c": {
      "text": "Not enough to break my field!",
      "status": "imported"
    },
    "voice_082:r_2b4d8818c77b6dca": {
      "text": "I've got a field!",
      "status": "imported"
    },
    "voice_082:r_087354f2db0a31e6": {
      "text": "I'll block it with my shield!",
      "status": "imported"
    },
    "voice_082:r_db02a2dec93dd263": {
      "text": "I've got a shield too!",
      "status": "imported"
    },
    "voice_082:r_d520c6d5298a848d": {
      "text": "Just hitting me isn't enough...!",
      "status": "imported"
    },
    "voice_082:r_099e2458cabf796f": {
      "text": "That was nothing but a fluke!",
      "status": "imported"
    },
    "voice_082:r_fd910d714be70870": {
      "text": "Was I careless somewhere...!",
      "status": "imported"
    },
    "voice_082:r_9736f29b11344ec3": {
      "text": "That was just a freak accident!",
      "status": "imported"
    },
    "voice_082:r_fcd05582aa5c6068": {
      "text": "Tch...! You grazed me!",
      "status": "imported"
    },
    "voice_082:r_bece29562818acba": {
      "text": "A scratch or two won't stop me...!",
      "status": "imported"
    },
    "voice_082:r_494b5da92ed24ecb": {
      "text": "You read my tactical pattern...!?",
      "status": "imported"
    },
    "voice_082:r_a4a5a96f4bd58920": {
      "text": "That doesn't even count as damage!",
      "status": "imported"
    },
    "voice_082:r_b57d2d74233f889a": {
      "text": "You actually hit my Diosc...!",
      "status": "imported"
    },
    "voice_082:r_cd06d0820d82524b": {
      "text": "You surpassed my\\nPsy-Control...!?",
      "status": "imported"
    },
    "voice_082:r_c94c6d04be583774": {
      "text": "Tch! This one's my mistake!",
      "status": "imported"
    },
    "voice_082:r_e54e2c99ef8297af": {
      "text": "Ngh...! I didn't account for this!",
      "status": "imported"
    },
    "voice_082:r_f16a3eb0bcaac082": {
      "text": "What the hell just happened!?",
      "status": "imported"
    },
    "voice_082:r_10a408809e512df1": {
      "text": "Our tactics\\naren't working...!?",
      "status": "imported"
    },
    "voice_082:r_bc7b9e308b879dd4": {
      "text": "Even I took that full force...!",
      "status": "imported"
    },
    "voice_082:r_98902fd3143c393e": {
      "text": "This is taking a bad turn...!",
      "status": "imported"
    },
    "voice_082:r_d907fbd7bc1c4298": {
      "text": "Should I fall back for now...!?",
      "status": "imported"
    },
    "voice_082:r_96b21e3a028dd074": {
      "text": "You attacked where I dodged!?",
      "status": "imported"
    },
    "voice_082:r_ce140b5d8e6b7310": {
      "text": "I can't keep taking these hits...!",
      "status": "imported"
    },
    "voice_082:r_0e0335789c5396d7": {
      "text": "Damn! What an annoying pest!",
      "status": "imported"
    },
    "voice_082:r_a8e85bd950696403": {
      "text": "Earthlings getting cocky...!",
      "status": "imported"
    },
    "voice_082:r_772c8bc40ab6cb61": {
      "text": "You still haven't learned to quit!?",
      "status": "imported"
    },
    "voice_082:r_58dd2826a199ef51": {
      "text": "Damn it!\\nEven in a Diosc...!",
      "status": "imported"
    },
    "voice_082:r_aadc0b2442adb93b": {
      "text": "My Psy-Control was disrupted!",
      "status": "imported"
    },
    "voice_082:r_e7a8cd8ed5bc2d1b": {
      "text": "Psy-Control\\ncan't evade it all...!?",
      "status": "imported"
    },
    "voice_082:r_041dd920da4a7c17": {
      "text": "Damn you, Gundam! How dare you!",
      "status": "imported"
    },
    "voice_082:r_c7f4280cde4605b3": {
      "text": "The Gundam name is well earned!",
      "status": "imported"
    },
    "voice_082:r_ec349c8ea9511a18": {
      "text": "Gundam's power holds true here!",
      "status": "imported"
    },
    "voice_082:r_33236ffa3ea95b68": {
      "text": "The super robot title is no lie!",
      "status": "imported"
    },
    "voice_082:r_689d0b123de71ae0": {
      "text": "That power head-on?\\nBad idea...!",
      "status": "imported"
    },
    "voice_082:r_84883aa95f63ce32": {
      "text": "It deserves\\nthe super robot name!",
      "status": "imported"
    },
    "voice_082:r_25493e978ce8ff16": {
      "text": "I won't let you fly free anymore!",
      "status": "imported"
    },
    "voice_082:r_7316666150e42960": {
      "text": "Tch! I can't track that speed!",
      "status": "imported"
    },
    "voice_082:r_c4f11aa93dc5b668": {
      "text": "That size, and such combat power!",
      "status": "imported"
    },
    "voice_082:r_ce1a22dfe3a4d339": {
      "text": "An impostor pushed me this far...!",
      "status": "imported"
    },
    "voice_082:r_240651adab81e145": {
      "text": "Not to you...\\nI refuse to lose!",
      "status": "imported"
    },
    "voice_082:r_b708a1d959013dbf": {
      "text": "Ngh! What the hell is going on!?",
      "status": "imported"
    },
    "voice_082:r_59fca03e929366c1": {
      "text": "Tch! That was a direct hit!",
      "status": "imported"
    },
    "voice_082:r_0d65eb631dcb7514": {
      "text": "You're a better pilot than me!?",
      "status": "imported"
    },
    "voice_082:r_d03018a31e23f1e9": {
      "text": "I'll endure this! I'm not done!",
      "status": "imported"
    },
    "voice_082:r_279da5f732aa8847": {
      "text": "This is bad...! Damage past limit!",
      "status": "imported"
    },
    "voice_082:r_97f82e3cb6f70110": {
      "text": "Damn it!\\nIs this where I die!?",
      "status": "imported"
    },
    "voice_082:r_c5611d8dd6def96b": {
      "text": "The tide is turning their way...!",
      "status": "imported"
    },
    "voice_082:r_6f12cc8ed2732eb5": {
      "text": "This bad...\\nNot since that fight!",
      "status": "imported"
    },
    "voice_082:r_7abfc55f8fb62ba7": {
      "text": "Too soon to end!\\nI can still fight!",
      "status": "imported"
    },
    "voice_082:r_99e7a66c650b5892": {
      "text": "Earthling! That was a clever trick!",
      "status": "imported"
    },
    "voice_082:r_5b2247b5cfbcd7b2": {
      "text": "One mistake\\ncaused all this...!",
      "status": "imported"
    },
    "voice_082:r_2d7a9c06347582d9": {
      "text": "The cockpit's\\nbursting into flames!",
      "status": "imported"
    },
    "voice_082:r_bf953d64c3c7d9b7": {
      "text": "You piece of junk! React faster!",
      "status": "imported"
    },
    "voice_082:r_e09b933e3e706779": {
      "text": "Damn it!\\nStuck in this junk...!",
      "status": "imported"
    },
    "voice_082:r_66236eb99b676e5b": {
      "text": "Had Psy-Control worked,\\nnot this!",
      "status": "imported"
    },
    "voice_082:r_9639a2dbcd2f58ed": {
      "text": "Damn it! This is\\na Diosc, damn it!",
      "status": "imported"
    },
    "voice_082:r_aeea0893acb93d35": {
      "text": "I have Psy-Control\\non my side!",
      "status": "imported"
    },
    "voice_082:r_b31568654e53487b": {
      "text": "Are Diosc and I finished here...!?",
      "status": "imported"
    },
    "voice_082:r_2502132569141ea3": {
      "text": "I've no home!\\nI fight to the end!",
      "status": "imported"
    },
    "voice_082:r_1ff312798a52c8eb": {
      "text": "Earthlings... Anyone but you...!",
      "status": "imported"
    },
    "voice_082:r_fa07d90fca62f593": {
      "text": "Until you taste\\nour despair...!",
      "status": "imported"
    },
    "voice_082:r_a25bf2676ecf9d83": {
      "text": "Not yet! I'll show you hell too!",
      "status": "imported"
    },
    "voice_082:r_237a0288b42dce20": {
      "text": "Is this it...!? Is this really it!",
      "status": "imported"
    },
    "voice_082:r_0556e8a22779ea8e": {
      "text": "Damn! In this cosmic backwater...!",
      "status": "imported"
    },
    "voice_082:r_09d377101a48d92a": {
      "text": "Damn it! Even I can lose...!",
      "status": "imported"
    },
    "voice_082:r_11517cc7b0494dbf": {
      "text": "Eject! I'm not dying here!",
      "status": "imported"
    },
    "voice_082:r_b5864501463db244": {
      "text": "Damage beyond limit! Eject!",
      "status": "imported"
    },
    "voice_082:r_a88939ea84b4474d": {
      "text": "N-no! This machine won't hold!",
      "status": "imported"
    },
    "voice_082:r_a870d0cf7cc11ec6": {
      "text": "Waaagh! D-damn it!",
      "status": "imported"
    },
    "voice_082:r_03f6158ef83964f3": {
      "text": "No! This machine will explode!",
      "status": "imported"
    },
    "voice_082:r_2970a83693cdcc25": {
      "text": "D-Diosc...!",
      "status": "imported"
    },
    "voice_082:r_be661448b85d0009": {
      "text": "No! Diosc is done for!",
      "status": "imported"
    },
    "voice_082:r_958a56c1151cab9e": {
      "text": "Now I can join everyone...",
      "status": "imported"
    },
    "voice_082:r_8b18aa4cc69547df": {
      "text": "A fitting end for me...",
      "status": "imported"
    },
    "voice_082:r_3e87f6fc3ea65aef": {
      "text": "Now... my fight... is over...",
      "status": "imported"
    },
    "voice_082:r_5508a7bfa9074eb9": {
      "text": "Earthlings, this far...\\nFight on...",
      "status": "imported"
    },
    "voice_082:r_09a003e91f0d5dc7": {
      "text": "Concentrate all fire on that one!",
      "status": "imported"
    },
    "voice_082:r_192447448ebd7bb5": {
      "text": "I'll keep them occupied!",
      "status": "imported"
    },
    "voice_082:r_e92920ba4b301b9f": {
      "text": "Once I pin them, it's up to you!",
      "status": "imported"
    },
    "voice_082:r_207b256d613bb896": {
      "text": "Hit them with concentrated fire!",
      "status": "imported"
    },
    "voice_082:r_a6fd676d8146501b": {
      "text": "I'll make the first move!",
      "status": "imported"
    },
    "voice_082:r_94d35e5fa8e3a198": {
      "text": "Leave that enemy to me!",
      "status": "imported"
    },
    "voice_082:r_b686510e636673f3": {
      "text": "I'll take care of that one!",
      "status": "imported"
    },
    "voice_082:r_59369bad143d4272": {
      "text": "We'll handle things on our end!",
      "status": "imported"
    },
    "voice_082:r_25f9b1e39dd8d366": {
      "text": "Focus on your own opponent!",
      "status": "imported"
    },
    "voice_082:r_307477bedd148060": {
      "text": "I'll force a one-on-one!",
      "status": "imported"
    },
    "voice_082:r_20cfb719db02fafd": {
      "text": "Witness the power of Diosc!",
      "status": "imported"
    },
    "voice_082:r_570c1fdf72edb283": {
      "text": "While I pilot this,\\nI won't lose!",
      "status": "imported"
    },
    "voice_082:r_23f0d87a5a6cfca1": {
      "text": "Now that I pilot a Diosc...!",
      "status": "imported"
    },
    "voice_082:r_60c94ea4eb7f7404": {
      "text": "With Psy-Control...!",
      "status": "imported"
    },
    "voice_082:r_727b2ee0277f9159": {
      "text": "With my psychic power and Diosc...!",
      "status": "imported"
    },
    "voice_082:r_cff4d2eae8a939ed": {
      "text": "This Diosc is my arms and legs!",
      "status": "imported"
    }
  }
}
