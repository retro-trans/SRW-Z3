{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_035:r_479b340ccc6c572b": {
      "text": "With me here, defeat is impossible!",
      "status": "imported"
    },
    "voice_035:r_ca4acbac57a2a35e": {
      "text": "Altair's fate\\nis at stake...!",
      "status": "imported"
    },
    "voice_035:r_77949221bf58f862": {
      "text": "At all costs, bring in the true Eve!",
      "status": "imported"
    },
    "voice_035:r_70b9c4b9f1f37eff": {
      "text": "Find the strongest $$レア・イグラー$$\\nnow!",
      "status": "translated"
    },
    "voice_035:r_9fcb3754cb1773c7": {
      "text": "Time to savor the air of battle...!",
      "status": "imported"
    },
    "voice_035:r_3559d2fad32c2435": {
      "text": "Feel the absolute gulf in power!",
      "status": "imported"
    },
    "voice_035:r_f7570547e9f80a64": {
      "text": "See Altair's supreme leader\\nfight!",
      "status": "imported"
    },
    "voice_035:r_cbab0f4720e1fcf1": {
      "text": "Witness Izumo Kamurogi in battle!",
      "status": "imported"
    },
    "voice_035:r_0bbe0b4f5364e732": {
      "text": "Well, you withstood that attack!",
      "status": "imported"
    },
    "voice_035:r_5dda5198137cb02a": {
      "text": "No time to waste...! I'll end this!",
      "status": "imported"
    },
    "voice_035:r_83ec59afbecdec14": {
      "text": "A flying Mechanical Angel...!",
      "status": "imported"
    },
    "voice_035:r_e20bfd42ad95a3c9": {
      "text": "Is that boy piloting it...!",
      "status": "imported"
    },
    "voice_035:r_0f58a8822381e57f": {
      "text": "A Mechanical Angel...!",
      "status": "imported"
    },
    "voice_035:r_6dbcc507fb61b51d": {
      "text": "Capture the $$レア・イグラー$$!",
      "status": "translated"
    },
    "voice_035:r_b42ab697149a7c8a": {
      "text": "We will welcome the true Eve!",
      "status": "imported"
    },
    "voice_035:r_4de4fcf3b440baf4": {
      "text": "Could they also be\\na $$レア・イグラー$$...!",
      "status": "translated"
    },
    "voice_035:r_30fad37a42bd3ad3": {
      "text": "Forgive me. You'll join Altair too!",
      "status": "imported"
    },
    "voice_035:r_4a9ac1dff86506d9": {
      "text": "The youth long lost to Altair...!",
      "status": "imported"
    },
    "voice_035:r_bc8538e6af3d2577": {
      "text": "Youth is ever the more fragile...!",
      "status": "imported"
    },
    "voice_035:r_924516c8de2b5342": {
      "text": "Just shatter that sturdy armor!",
      "status": "imported"
    },
    "voice_035:r_da1174533722333f": {
      "text": "Face me, Mechanical Giant of Vega!",
      "status": "imported"
    },
    "voice_035:r_fdeb8162976e72c1": {
      "text": "Mechanical Angel?! Demon's apostle?!",
      "status": "imported"
    },
    "voice_035:r_0fadb5c26df92b42": {
      "text": "It can't be...!\\nMikage warned me...",
      "status": "imported"
    },
    "voice_035:r_6b15af9a0057cdc8": {
      "text": "First, I'll seal that mobility!",
      "status": "imported"
    },
    "voice_035:r_15b4a90140e8a33a": {
      "text": "Gundam...!\\nA fine pilot, they say!",
      "status": "imported"
    },
    "voice_035:r_af884a6b11dff121": {
      "text": "Singing in battle? What nerve!",
      "status": "imported"
    },
    "voice_035:r_ac6fe7838e95647b": {
      "text": "Why is that on the battlefield?!",
      "status": "imported"
    },
    "voice_035:r_77ca87eacd17ad52": {
      "text": "No matter how huge you are!",
      "status": "imported"
    },
    "voice_035:r_bf3244994760e535": {
      "text": "A foe I can't underestimate...!",
      "status": "imported"
    },
    "voice_035:r_aabfb21c9d069ce7": {
      "text": "You're fit to cross blades\\nwith me!",
      "status": "imported"
    },
    "voice_035:r_02479dc8fe989560": {
      "text": "A duel between commanders, then...!",
      "status": "imported"
    },
    "voice_035:r_a2df00f91a9b0a9e": {
      "text": "Once the battleship is sunk!",
      "status": "imported"
    },
    "voice_035:r_eb7ae28b53dc033c": {
      "text": "With Ahura Gnis's power...!",
      "status": "imported"
    },
    "voice_035:r_857c4a52ce8df0fd": {
      "text": "Behold my martial arts!",
      "status": "imported"
    },
    "voice_035:r_55417493fce1d347": {
      "text": "Experience decides close combat!",
      "status": "imported"
    },
    "voice_035:r_8fdf5910927c9591": {
      "text": "I'll force my way through!",
      "status": "imported"
    },
    "voice_035:r_7d724dbcc4451e10": {
      "text": "I'll pay you back twofold!",
      "status": "imported"
    },
    "voice_035:r_93e25418a203cb8f": {
      "text": "Taste the power of double payback!",
      "status": "imported"
    },
    "voice_035:r_adeb0a29274d3d9b": {
      "text": "Your power is now my Gnis's power!",
      "status": "imported"
    },
    "voice_035:r_24cf161287ef9d5c": {
      "text": "This is the power of my Ahura Gnis!",
      "status": "imported"
    },
    "voice_035:r_8f60f6fc86db3107": {
      "text": "Iron-C, made by my mother Oriza!",
      "status": "imported"
    },
    "voice_035:r_b1de76a75a253c13": {
      "text": "Altair Cannon...!",
      "status": "imported"
    },
    "voice_035:r_128c35bf3e0e394c": {
      "text": "Fire!!",
      "status": "imported"
    },
    "voice_035:r_5213c17e13b23de0": {
      "text": "Iron-C, lend me your power!",
      "status": "imported"
    },
    "voice_035:r_38fdff9483e9245c": {
      "text": "All of Altair's energy...!",
      "status": "imported"
    },
    "voice_035:r_620fedec67706d7d": {
      "text": "Take this!!",
      "status": "imported"
    },
    "voice_035:r_9680dcd0fddcfcc7": {
      "text": "I must return the favor...!",
      "status": "imported"
    },
    "voice_035:r_2a00f1044ad5cbaa": {
      "text": "How naive, allowing my counter...!",
      "status": "imported"
    },
    "voice_035:r_3dbeead1bd3164ef": {
      "text": "Now it's my turn...!",
      "status": "imported"
    },
    "voice_035:r_98d15b8cc09bc915": {
      "text": "You attacked. I must fight back...!",
      "status": "imported"
    },
    "voice_035:r_46e86d000250e137": {
      "text": "I can't let you escape...!",
      "status": "imported"
    },
    "voice_035:r_ac341e7976e88f0b": {
      "text": "I must return what I've received!",
      "status": "imported"
    },
    "voice_035:r_cdbd128a5b4127cc": {
      "text": "You were too slow to escape...!",
      "status": "imported"
    },
    "voice_035:r_cfccaa1fbeda124c": {
      "text": "Stay hidden,\\nand you'd still live!",
      "status": "imported"
    },
    "voice_035:r_b1f8ec192b9c083a": {
      "text": "We'll attack in tandem!",
      "status": "imported"
    },
    "voice_035:r_a007f9ab9cf048b3": {
      "text": "I can't let this opening pass!",
      "status": "imported"
    },
    "voice_035:r_ddafde4b065ced49": {
      "text": "I can't lose this vital asset!",
      "status": "imported"
    },
    "voice_035:r_de1213040856c089": {
      "text": "I'll take care of this!",
      "status": "imported"
    },
    "voice_035:r_3304412ac41f47a6": {
      "text": "To think you can't even counter...",
      "status": "imported"
    },
    "voice_035:r_0c0775e051211840": {
      "text": "Am I to just let the enemy go...?!",
      "status": "imported"
    },
    "voice_035:r_a2afffe1c396f0b3": {
      "text": "Very well. Another chance will come.",
      "status": "imported"
    },
    "voice_035:r_13c25fbdfddc8a24": {
      "text": "The unexpected is always possible...",
      "status": "imported"
    },
    "voice_035:r_42ba1ecb310b4bd7": {
      "text": "Naive... But I admire your drive.",
      "status": "imported"
    },
    "voice_035:r_d692f1d420460a47": {
      "text": "Now you know our power gap. Retreat.",
      "status": "imported"
    },
    "voice_035:r_a5643cec86b18bd2": {
      "text": "Now you know your own helplessness.",
      "status": "imported"
    },
    "voice_035:r_68f2dfab20a4a30e": {
      "text": "We cannot afford to lose!",
      "status": "imported"
    },
    "voice_035:r_9cedad8237480563": {
      "text": "You're acting like a child...!",
      "status": "imported"
    },
    "voice_035:r_a03fabecba1508ca": {
      "text": "That won't be enough to catch me!",
      "status": "imported"
    },
    "voice_035:r_5391b24a71eb10ae": {
      "text": "Mechanical Angel lore won't faze me!",
      "status": "imported"
    },
    "voice_035:r_a554ceef5c87b972": {
      "text": "Mechanical Angel's myth ends today!",
      "status": "imported"
    },
    "voice_035:r_546c3d5937fbb7ee": {
      "text": "Leave, boy... I don't want to fight.",
      "status": "imported"
    },
    "voice_035:r_1568ff6298b12b96": {
      "text": "It's futile, $$レア・イグラー$$.",
      "status": "translated"
    },
    "voice_035:r_428c2116ac3071b1": {
      "text": "Give up and come under my command.",
      "status": "imported"
    },
    "voice_035:r_3d32e86f8dc80909": {
      "text": "Youth alone cannot win!",
      "status": "imported"
    },
    "voice_035:r_70451ffbabe2f876": {
      "text": "Your lack of experience is clear...",
      "status": "imported"
    },
    "voice_035:r_dd01a4c0d1b36a8d": {
      "text": "It's futile!",
      "status": "imported"
    },
    "voice_035:r_20920ad2eb3542db": {
      "text": "That won't work!",
      "status": "imported"
    },
    "voice_035:r_c958860b0676b1f5": {
      "text": "The defense system activated.",
      "status": "imported"
    },
    "voice_035:r_5e2669b82ef75ce3": {
      "text": "I see... So this is the answer.",
      "status": "imported"
    },
    "voice_035:r_7847e0ed7dc9282d": {
      "text": "You'd squander your own life...?",
      "status": "imported"
    },
    "voice_035:r_e42b52c7a987b906": {
      "text": "You press on beyond despair...?",
      "status": "imported"
    },
    "voice_035:r_6825fd1ff907bd22": {
      "text": "You mistake recklessness for valor.",
      "status": "imported"
    },
    "voice_035:r_607f666f1563bc0d": {
      "text": "Good aim. But...!",
      "status": "imported"
    },
    "voice_035:r_97b7431eeb81e6b6": {
      "text": "Willpower alone won't win!",
      "status": "imported"
    },
    "voice_035:r_132f605d02975e71": {
      "text": "Just momentum, as I thought!",
      "status": "imported"
    },
    "voice_035:r_9b9726b1872759d6": {
      "text": "I'll acknowledge that spirit...!",
      "status": "imported"
    },
    "voice_035:r_1252db29683fefe0": {
      "text": "Hm... A fine, spirited attack.",
      "status": "imported"
    },
    "voice_035:r_ad3d538f1e909184": {
      "text": "Vega's warriors are quite capable.",
      "status": "imported"
    },
    "voice_035:r_8c61c59a1c0aebbf": {
      "text": "Bit by bit,\\nthey're moving better...",
      "status": "imported"
    },
    "voice_035:r_aba6a7662129d8ce": {
      "text": "Seems\\nthey too can't back down.",
      "status": "imported"
    },
    "voice_035:r_b84afafb8a33ec60": {
      "text": "Guh! What?!",
      "status": "imported"
    },
    "voice_035:r_c8c59db85bf875e6": {
      "text": "You damaged this Ahura Gnis...!",
      "status": "imported"
    },
    "voice_035:r_391aa56435d9dd6e": {
      "text": "This makes entering battle\\nworth it!",
      "status": "imported"
    },
    "voice_035:r_7c796ba53bd7ea03": {
      "text": "For Altair's future,\\nI can't lose!",
      "status": "imported"
    },
    "voice_035:r_fa944da4b6519006": {
      "text": "Well done, Mechanical Angel! Yes!",
      "status": "imported"
    },
    "voice_035:r_95d047bcc17fccc6": {
      "text": "I must beat the Mechanical Angel...!",
      "status": "imported"
    },
    "voice_035:r_640327a12a559b31": {
      "text": "This feeling...!\\nSo the pilot is...!",
      "status": "imported"
    },
    "voice_035:r_bdd38c584fa313d0": {
      "text": "Even if the winged child\\nis aboard!",
      "status": "imported"
    },
    "voice_035:r_3fd86c1027f317c8": {
      "text": "Bravo, Vega's Mechanical Giant!\\nBut!",
      "status": "imported"
    },
    "voice_035:r_d0372a183d2007ad": {
      "text": "You rival this Ahura Gnis\\nin power?!",
      "status": "imported"
    },
    "voice_035:r_217aa5e1d545b44d": {
      "text": "Legendary demon power... Fearsome!",
      "status": "imported"
    },
    "voice_035:r_381992c5d8224937": {
      "text": "Now you're fit to be the true Eve!",
      "status": "imported"
    },
    "voice_035:r_5aeeb4917340c42d": {
      "text": "So be it...! I'll take you by force!",
      "status": "imported"
    },
    "voice_035:r_774a9ab4d8fd5351": {
      "text": "So this is... youth!",
      "status": "imported"
    },
    "voice_035:r_d3f01de714c015bd": {
      "text": "Youth can turn folly into hope...?",
      "status": "imported"
    },
    "voice_035:r_2072eaf71a260ae7": {
      "text": "I am brought to my knees...!?",
      "status": "imported"
    },
    "voice_035:r_6c13bbfd27a7799e": {
      "text": "That searing heat...\\nIt's been ages!",
      "status": "imported"
    },
    "voice_035:r_06f88dcbd3c9e738": {
      "text": "At last, nowhere left to retreat...!",
      "status": "imported"
    },
    "voice_035:r_b28faf9f71bc3598": {
      "text": "I cannot allow myself to lose...!",
      "status": "imported"
    },
    "voice_035:r_8a29278549f8e07a": {
      "text": "I must end the $$レア・イグラー$$\\ntragedy!",
      "status": "translated"
    },
    "voice_035:r_7e6c573c26177f98": {
      "text": "Alicia's sacrifice won't be in vain!",
      "status": "imported"
    },
    "voice_035:r_45abf84f7757d6eb": {
      "text": "So you too\\nhave resolve enough...!",
      "status": "imported"
    },
    "voice_035:r_edd7a13ab8f06a14": {
      "text": "Now our resolve\\ndecides who wins...!",
      "status": "imported"
    },
    "voice_035:r_8165e5b41f0124c4": {
      "text": "Damn! I must withdraw for now...!",
      "status": "imported"
    },
    "voice_035:r_4e05581b7432cce8": {
      "text": "Impressive... I concede defeat here.",
      "status": "imported"
    },
    "voice_035:r_a60b107ea3c36a86": {
      "text": "Raaaaaagh!!",
      "status": "imported"
    },
    "voice_035:r_e33693e5ba4665b0": {
      "text": "Winged child, we may meet again...",
      "status": "imported"
    },
    "voice_035:r_72a21a1a489af001": {
      "text": "Amata... You've grown strong...",
      "status": "imported"
    },
    "voice_035:r_eb643f8bf737a0ca": {
      "text": "Altair has no home\\nfor you anymore!",
      "status": "imported"
    }
  }
}
