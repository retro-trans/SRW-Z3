{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_092:r_479b340ccc6c572b": {
      "text": "Your tone's clearer than before.",
      "status": "imported"
    },
    "voice_092:r_ca4acbac57a2a35e": {
      "text": "Let's see just how good you are.",
      "status": "imported"
    },
    "voice_092:r_77949221bf58f862": {
      "text": "You'll spice up this boring mission.",
      "status": "imported"
    },
    "voice_092:r_70b9c4b9f1f37eff": {
      "text": "It's basically just a game, anyway.",
      "status": "imported"
    },
    "voice_092:r_9fcb3754cb1773c7": {
      "text": "Well, time for a pilgrimage...!",
      "status": "imported"
    },
    "voice_092:r_3559d2fad32c2435": {
      "text": "I'll find\\nthe top $$レア・イグラー$$...!",
      "status": "translated"
    },
    "voice_092:r_f7570547e9f80a64": {
      "text": "I don't plan on staying long...",
      "status": "imported"
    },
    "voice_092:r_cbab0f4720e1fcf1": {
      "text": "A mysterious showtime...",
      "status": "imported"
    },
    "voice_092:r_0bbe0b4f5364e732": {
      "text": "Unseen door, future door,\\nfly far!",
      "status": "imported"
    },
    "voice_092:r_5dda5198137cb02a": {
      "text": "Mission, start...",
      "status": "imported"
    },
    "voice_092:r_83ec59afbecdec14": {
      "text": "You just don't know when to quit!",
      "status": "imported"
    },
    "voice_092:r_e20bfd42ad95a3c9": {
      "text": "This time, you're going down!",
      "status": "imported"
    },
    "voice_092:r_0f58a8822381e57f": {
      "text": "That's the form used against Kagura.",
      "status": "imported"
    },
    "voice_092:r_6dbcc507fb61b51d": {
      "text": "I've already verified the specs...",
      "status": "imported"
    },
    "voice_092:r_b42ab697149a7c8a": {
      "text": "A Mechanical Angel... Then...!",
      "status": "imported"
    },
    "voice_092:r_4de4fcf3b440baf4": {
      "text": "Kagura won't shut up about this...",
      "status": "imported"
    },
    "voice_092:r_0121a166c715cdff": {
      "text": "This is a $$レア・イグラー$$!?",
      "status": "translated"
    },
    "voice_092:r_80a0b2a84e05d81a": {
      "text": "What a letdown. It's no Sylphy...",
      "status": "imported"
    },
    "voice_092:r_bc8538e6af3d2577": {
      "text": "Observe! Observe...! Observe...!",
      "status": "imported"
    },
    "voice_092:r_da1174533722333f": {
      "text": "It certainly looks tough...",
      "status": "imported"
    },
    "voice_092:r_0fadb5c26df92b42": {
      "text": "Looks Super, but\\nwhat's inside?",
      "status": "imported"
    },
    "voice_092:r_15b4a90140e8a33a": {
      "text": "That's one shabby machine.",
      "status": "imported"
    },
    "voice_092:r_af884a6b11dff121": {
      "text": "Let's see what a Gundam can do.",
      "status": "imported"
    },
    "voice_092:r_ac6fe7838e95647b": {
      "text": "That one... is just like Kagura...",
      "status": "imported"
    },
    "voice_092:r_77ca87eacd17ad52": {
      "text": "Overflowing feelings, streamlined...",
      "status": "imported"
    },
    "voice_092:r_bf3244994760e535": {
      "text": "What a creep...!",
      "status": "imported"
    },
    "voice_092:r_aabfb21c9d069ce7": {
      "text": "Why's that thing on a battlefield!?",
      "status": "imported"
    },
    "voice_092:r_02479dc8fe989560": {
      "text": "You only live to destroy, monster!",
      "status": "imported"
    },
    "voice_092:r_a2df00f91a9b0a9e": {
      "text": "Let them pass,\\nand Vega is finished!",
      "status": "imported"
    },
    "voice_092:r_8927e6fb681aa809": {
      "text": "So speed's your claim to fame...",
      "status": "imported"
    },
    "voice_092:r_665f01666859013b": {
      "text": "Bigger doesn't always mean better.",
      "status": "imported"
    },
    "voice_092:r_a571eec59b258d11": {
      "text": "It moves unlike all the others...!",
      "status": "imported"
    },
    "voice_092:r_ddbe581c5ea9183d": {
      "text": "I'll wreck command\\nand sow chaos...!",
      "status": "imported"
    },
    "voice_092:r_faae935cca0edc72": {
      "text": "Sink that ship, and it's game over!",
      "status": "imported"
    },
    "voice_092:r_d4430bf362340b32": {
      "text": "Target locked...",
      "status": "imported"
    },
    "voice_092:r_6ff1323b355593e0": {
      "text": "Lining up a shot is easy.",
      "status": "imported"
    },
    "voice_092:r_b7b5625d7cd4282f": {
      "text": "My prediction says... right here.",
      "status": "imported"
    },
    "voice_092:r_36133ad73a73ef98": {
      "text": "Could you hold still for a bit...!",
      "status": "imported"
    },
    "voice_092:r_920740a0219c5085": {
      "text": "I'd love to leave you no way out.",
      "status": "imported"
    },
    "voice_092:r_a8451712c57c1a72": {
      "text": "Live rounds, then!",
      "status": "imported"
    },
    "voice_092:r_3633df5b7b8f47fa": {
      "text": "I don't intend to miss.",
      "status": "imported"
    },
    "voice_092:r_52dfc56b14b93551": {
      "text": "Try your hardest to dodge.",
      "status": "imported"
    },
    "voice_092:r_1b9b2aab5cb104da": {
      "text": "Gooooo!",
      "status": "imported"
    },
    "voice_092:r_342044c706a2340f": {
      "text": "Now, how many will hit?",
      "status": "imported"
    },
    "voice_092:r_cf41e8828a90cbdb": {
      "text": "This ends it!",
      "status": "imported"
    },
    "voice_092:r_d5e0a2317c40d322": {
      "text": "Bye-bye!",
      "status": "imported"
    },
    "voice_092:r_f2d4255f1c2f7542": {
      "text": "There's nowhere you can run!",
      "status": "imported"
    },
    "voice_092:r_5d08ad19e2da125b": {
      "text": "Hold it.",
      "status": "imported"
    },
    "voice_092:r_a7246b52782a877e": {
      "text": "Letting me counter? How naive.",
      "status": "imported"
    },
    "voice_092:r_dc8701f6bcb9904f": {
      "text": "Right, don't forget to counter.",
      "status": "imported"
    },
    "voice_092:r_d6bdd730f24f66eb": {
      "text": "You started this, didn't you?",
      "status": "imported"
    },
    "voice_092:r_41997412868c48c4": {
      "text": "You really get on my nerves...!",
      "status": "imported"
    },
    "voice_092:r_9e6cf4f389dae55c": {
      "text": "I can't let it end in defeat...!",
      "status": "imported"
    },
    "voice_092:r_9e0c80ac7e33b459": {
      "text": "Hey there.",
      "status": "imported"
    },
    "voice_092:r_7432ef43ed3471dc": {
      "text": "Sorry to keep you waiting.",
      "status": "imported"
    },
    "voice_092:r_065443f6ddfcf0d7": {
      "text": "Don't go acting on your own.",
      "status": "imported"
    },
    "voice_092:r_47d52a2839c71715": {
      "text": "Stop making more work for me.",
      "status": "imported"
    },
    "voice_092:r_847f82e7f3eef651": {
      "text": "Even I can't attack...!",
      "status": "imported"
    },
    "voice_092:r_eb7ae28b53dc033c": {
      "text": "Well, it is one possible tactic...",
      "status": "imported"
    },
    "voice_092:r_857c4a52ce8df0fd": {
      "text": "So much for my simulation...",
      "status": "imported"
    },
    "voice_092:r_55417493fce1d347": {
      "text": "Sigh... Guess I have to give up...",
      "status": "imported"
    },
    "voice_092:r_8fdf5910927c9591": {
      "text": "I'm not dumb enough to rush out.",
      "status": "imported"
    },
    "voice_092:r_7d724dbcc4451e10": {
      "text": "I need to resupply somewhere...!",
      "status": "imported"
    },
    "voice_092:r_93e25418a203cb8f": {
      "text": "What a shame.",
      "status": "imported"
    },
    "voice_092:r_adeb0a29274d3d9b": {
      "text": "Analysis complete.",
      "status": "imported"
    },
    "voice_092:r_24cf161287ef9d5c": {
      "text": "Proceeding just as simulated...",
      "status": "imported"
    },
    "voice_092:r_8f60f6fc86db3107": {
      "text": "Ha. Just as I predicted.",
      "status": "imported"
    },
    "voice_092:r_b1de76a75a253c13": {
      "text": "I see now.",
      "status": "imported"
    },
    "voice_092:r_128c35bf3e0e394c": {
      "text": "What an utterly childish attack...",
      "status": "imported"
    },
    "voice_092:r_5213c17e13b23de0": {
      "text": "Weaklings\\ncan't be the true Eve.",
      "status": "imported"
    },
    "voice_092:r_620fedec67706d7d": {
      "text": "Can't you tell it has no effect?",
      "status": "imported"
    },
    "voice_092:r_9680dcd0fddcfcc7": {
      "text": "What a pointless thing to do.",
      "status": "imported"
    },
    "voice_092:r_98d15b8cc09bc915": {
      "text": "This barrier makes it easy.",
      "status": "imported"
    },
    "voice_092:r_46e86d000250e137": {
      "text": "Far too weak...",
      "status": "imported"
    },
    "voice_092:r_ac341e7976e88f0b": {
      "text": "What...!?",
      "status": "imported"
    },
    "voice_092:r_cdbd128a5b4127cc": {
      "text": "Don't you dare touch me.",
      "status": "imported"
    },
    "voice_092:r_cfccaa1fbeda124c": {
      "text": "This isn't even useful for analysis.",
      "status": "imported"
    },
    "voice_092:r_b1f8ec192b9c083a": {
      "text": "This kind of thing's a real pain.",
      "status": "imported"
    },
    "voice_092:r_a007f9ab9cf048b3": {
      "text": "So you can do worse than predicted.",
      "status": "imported"
    },
    "voice_092:r_ddafde4b065ced49": {
      "text": "Heavy armor was the right call.",
      "status": "imported"
    },
    "voice_092:r_de1213040856c089": {
      "text": "My flawless Iron Shield\\nprotects me.",
      "status": "imported"
    },
    "voice_092:r_3304412ac41f47a6": {
      "text": "Gwah...!",
      "status": "imported"
    },
    "voice_092:r_0c0775e051211840": {
      "text": "Ugh, give me a break...",
      "status": "imported"
    },
    "voice_092:r_a2afffe1c396f0b3": {
      "text": "This is enough data for me.",
      "status": "imported"
    },
    "voice_092:r_13c25fbdfddc8a24": {
      "text": "This is all within expectations!",
      "status": "imported"
    },
    "voice_092:r_42ba1ecb310b4bd7": {
      "text": "This sort of thing's so annoying!",
      "status": "imported"
    },
    "voice_092:r_d692f1d420460a47": {
      "text": "Interesting...\\nBut not now!",
      "status": "imported"
    },
    "voice_092:r_a5643cec86b18bd2": {
      "text": "S-so this is a $$レア・イグラー$$...!",
      "status": "translated"
    },
    "voice_092:r_68f2dfab20a4a30e": {
      "text": "Really, $$レア・イグラー$$...!\\nToo much!",
      "status": "translated"
    },
    "voice_092:r_9cedad8237480563": {
      "text": "They're nothing like Sylphy...!",
      "status": "imported"
    },
    "voice_092:r_546c3d5937fbb7ee": {
      "text": "No way! Ngh...!",
      "status": "imported"
    },
    "voice_092:r_1568ff6298b12b96": {
      "text": "No way!\\nWhat an outrageous move!",
      "status": "imported"
    },
    "voice_092:r_2c9d94ba13c5fc50": {
      "text": "This situation\\nwasn't simulated!",
      "status": "imported"
    },
    "voice_092:r_a77f4913375098d2": {
      "text": "Even I'm... completely cornered...!",
      "status": "imported"
    },
    "voice_092:r_428c2116ac3071b1": {
      "text": "Me, beaten by absurd tactics...!",
      "status": "imported"
    },
    "voice_092:r_84c116267b79f540": {
      "text": "Game over, in a place like this...!",
      "status": "imported"
    },
    "voice_092:r_dad38ee29af2df3a": {
      "text": "U-uwaaaaaah!",
      "status": "imported"
    },
    "voice_092:r_3d32e86f8dc80909": {
      "text": "Some kind of invisible power...!",
      "status": "imported"
    },
    "voice_092:r_70451ffbabe2f876": {
      "text": "I fight\\nto end this fighting...!",
      "status": "imported"
    },
    "voice_092:r_69dfa1659715e2fa": {
      "text": "Stop...!\\nDon't make Yunoha sad!",
      "status": "imported"
    },
    "voice_092:r_d996fd6d4ef5b329": {
      "text": "For those who took me in,\\nI fight!",
      "status": "imported"
    },
    "voice_092:r_8ab47a28f99ef565": {
      "text": "For all who told me I'm needed!",
      "status": "imported"
    },
    "voice_092:r_546de3fb6db156ea": {
      "text": "Never again\\na loved one's tears!",
      "status": "imported"
    },
    "voice_092:r_ca85f87cee5e31f7": {
      "text": "I'll protect Yunoha's world!",
      "status": "imported"
    },
    "voice_092:r_9072ea7bc71df136": {
      "text": "To keep the flow of life unbroken!",
      "status": "imported"
    },
    "voice_092:r_04e815a8d425827d": {
      "text": "Our lives\\naren't ours alone...!",
      "status": "imported"
    },
    "voice_092:r_d89011fe3e5d082a": {
      "text": "I'm counting on you, Jin!",
      "status": "imported"
    },
    "voice_092:r_3c5b0c2ac812d5de": {
      "text": "If you ask, I have to do it.",
      "status": "imported"
    },
    "voice_092:r_5b9e8897190892eb": {
      "text": "Now, let's see what you can do!",
      "status": "imported"
    },
    "voice_092:r_7bea3023abbf8a94": {
      "text": "P-please don't stare so much...",
      "status": "imported"
    },
    "voice_092:r_20920ad2eb3542db": {
      "text": "...That may be true.",
      "status": "imported"
    },
    "voice_092:r_0ab7914877fd48ed": {
      "text": "Get fired up and get moving!",
      "status": "imported"
    },
    "voice_092:r_cb846feec748c2e3": {
      "text": "I'm no good with forceful people...",
      "status": "imported"
    },
    "voice_092:r_c958860b0676b1f5": {
      "text": "Time to make my move...!",
      "status": "imported"
    },
    "voice_092:r_5e2669b82ef75ce3": {
      "text": "What's this?\\nA trap for love?",
      "status": "imported"
    },
    "voice_092:r_7847e0ed7dc9282d": {
      "text": "Hang in there, Jin!",
      "status": "imported"
    },
    "voice_092:r_e42b52c7a987b906": {
      "text": "With you, I can do anything...!",
      "status": "imported"
    },
    "voice_092:r_6825fd1ff907bd22": {
      "text": "Jin, leave the support to me!",
      "status": "imported"
    },
    "voice_092:r_607f666f1563bc0d": {
      "text": "Thank you, Yunoha.",
      "status": "imported"
    },
    "voice_092:r_97b7431eeb81e6b6": {
      "text": "Jin Muso,\\nshow me how you fight.",
      "status": "imported"
    },
    "voice_092:r_132f605d02975e71": {
      "text": "Understood...!",
      "status": "imported"
    },
    "voice_092:r_9b9726b1872759d6": {
      "text": "Stop this, Kagura...!",
      "status": "imported"
    },
    "voice_092:r_1252db29683fefe0": {
      "text": "Kagura...! I...!!",
      "status": "imported"
    },
    "voice_092:r_ad3d538f1e909184": {
      "text": "I still care for Altair,\\nbut...!",
      "status": "imported"
    },
    "voice_092:r_8c61c59a1c0aebbf": {
      "text": "We have to connect, not hate!",
      "status": "imported"
    },
    "voice_092:r_aba6a7662129d8ce": {
      "text": "You're behind it all! I'll beat you!",
      "status": "imported"
    },
    "voice_092:r_b84afafb8a33ec60": {
      "text": "I'll protect both Altair and Vega!",
      "status": "imported"
    },
    "voice_092:r_c8c59db85bf875e6": {
      "text": "Yunoha's world\\nwon't be destroyed!",
      "status": "imported"
    },
    "voice_092:r_391aa56435d9dd6e": {
      "text": "I'll cut this fate of despair short!",
      "status": "imported"
    },
    "voice_092:r_7c796ba53bd7ea03": {
      "text": "No one is ever truly alone...",
      "status": "imported"
    },
    "voice_092:r_fa944da4b6519006": {
      "text": "You people fight dirty...!",
      "status": "imported"
    },
    "voice_092:r_3fc2e1186557e7a0": {
      "text": "It tracks you, so you can't dodge.",
      "status": "imported"
    },
    "voice_092:r_fa6930340a545054": {
      "text": "Sorry, but these things multiply.",
      "status": "imported"
    },
    "voice_092:r_2332b9d56461d7ab": {
      "text": "See you. Bye-bye!",
      "status": "imported"
    },
    "voice_092:r_854aa0a91a3c80d1": {
      "text": "I can do this sort of thing too!",
      "status": "imported"
    },
    "voice_092:r_0bc8ae32a406ceab": {
      "text": "Missile, fire!",
      "status": "imported"
    },
    "voice_092:r_82c09f011d703b2c": {
      "text": "How many did we end up with...?",
      "status": "imported"
    },
    "voice_092:r_2b4d8818c77b6dca": {
      "text": "Try counting them, if you can!",
      "status": "imported"
    },
    "voice_092:r_087354f2db0a31e6": {
      "text": "If there's anything I can do...!",
      "status": "imported"
    },
    "voice_092:r_db02a2dec93dd263": {
      "text": "I'll support my allies...!",
      "status": "imported"
    },
    "voice_092:r_d520c6d5298a848d": {
      "text": "So that's a $$レア・イグラー$$'s power...!",
      "status": "translated"
    },
    "voice_092:r_fd910d714be70870": {
      "text": "I'll back you up, Shinji.",
      "status": "imported"
    },
    "voice_092:r_9736f29b11344ec3": {
      "text": "I won't let you!",
      "status": "imported"
    },
    "voice_092:r_fcd05582aa5c6068": {
      "text": "I'll protect everyone!",
      "status": "imported"
    },
    "voice_092:r_bece29562818acba": {
      "text": "I have to protect the $$レア・イグラー$$!",
      "status": "translated"
    },
    "voice_092:r_a4a5a96f4bd58920": {
      "text": "We're friends... after all.",
      "status": "imported"
    },
    "voice_092:r_b57d2d74233f889a": {
      "text": "Not bad, Jin! That was amazing!",
      "status": "imported"
    },
    "voice_092:r_cd06d0820d82524b": {
      "text": "This much is easy with my skill.",
      "status": "imported"
    },
    "voice_092:r_c94c6d04be583774": {
      "text": "Hey, you're pretty cool, kid!",
      "status": "imported"
    },
    "voice_092:r_e54e2c99ef8297af": {
      "text": "Cool? Me...?",
      "status": "imported"
    },
    "voice_092:r_f16a3eb0bcaac082": {
      "text": "Every sound analyzed...\\nA maestro.",
      "status": "imported"
    },
    "voice_092:r_10a408809e512df1": {
      "text": "Uh... Well... I'm not really sure...",
      "status": "imported"
    },
    "voice_092:r_bc7b9e308b879dd4": {
      "text": "Of course I did that! Now, next!",
      "status": "imported"
    },
    "voice_092:r_98902fd3143c393e": {
      "text": "(You're too strict, $$レア・イグラー$$...!)",
      "status": "translated"
    },
    "voice_092:r_d907fbd7bc1c4298": {
      "text": "That attack cracked me up!\\nSo wild!",
      "status": "imported"
    },
    "voice_092:r_96b21e3a028dd074": {
      "text": "(A code?\\nToo deep, $$レア・イグラー$$...!)",
      "status": "translated"
    },
    "voice_092:r_ce140b5d8e6b7310": {
      "text": "Jin, that was amazing...!",
      "status": "imported"
    },
    "voice_092:r_0e0335789c5396d7": {
      "text": "Yunoha lent me strength too.",
      "status": "imported"
    },
    "voice_092:r_a8e85bd950696403": {
      "text": "So this is your power, Jin!",
      "status": "imported"
    },
    "voice_092:r_772c8bc40ab6cb61": {
      "text": "No. Yunoha and everyone helped.",
      "status": "imported"
    },
    "voice_092:r_58dd2826a199ef51": {
      "text": "You've exceeded my hopes, Jin Muso.",
      "status": "imported"
    },
    "voice_092:r_aadc0b2442adb93b": {
      "text": "Y-yes! Thank you very much!",
      "status": "imported"
    },
    "voice_092:r_e7a8cd8ed5bc2d1b": {
      "text": "Um... How do I put it? So close.",
      "status": "imported"
    },
    "voice_092:r_041dd920da4a7c17": {
      "text": "It's no good.\\nJust say so clearly.",
      "status": "imported"
    },
    "voice_092:r_c7f4280cde4605b3": {
      "text": "Um... Are you okay?",
      "status": "imported"
    },
    "voice_092:r_ec349c8ea9511a18": {
      "text": "Fine!\\nWe're stronger than we look!",
      "status": "imported"
    },
    "voice_092:r_33236ffa3ea95b68": {
      "text": "Your heart's tempo slipped, huh?",
      "status": "imported"
    },
    "voice_092:r_689d0b123de71ae0": {
      "text": "No secrets\\ncan be kept from you...",
      "status": "imported"
    },
    "voice_092:r_84883aa95f63ce32": {
      "text": "Well? Are you awake now?",
      "status": "imported"
    },
    "voice_092:r_25493e978ce8ff16": {
      "text": "I was awake from the start...!",
      "status": "imported"
    },
    "voice_092:r_7316666150e42960": {
      "text": "Sorry...",
      "status": "imported"
    },
    "voice_092:r_c4f11aa93dc5b668": {
      "text": "Aww, you're cute when you're down!",
      "status": "imported"
    },
    "voice_092:r_ce1a22dfe3a4d339": {
      "text": "Sorry, Yunoha! I hit you!",
      "status": "imported"
    },
    "voice_092:r_240651adab81e145": {
      "text": "It's okay! I don't mind!",
      "status": "imported"
    },
    "voice_092:r_cff0deaae73c2858": {
      "text": "I must have let my guard down.",
      "status": "imported"
    },
    "voice_092:r_dca67f68a573fab7": {
      "text": "You can lecture me later.",
      "status": "imported"
    },
    "voice_092:r_a6630215fefaf294": {
      "text": "Jin! Fall back from the enemy!",
      "status": "imported"
    },
    "voice_092:r_6f94566ad37f8ff8": {
      "text": "Got it! I'll do that!",
      "status": "imported"
    },
    "voice_092:r_942ca03c9de80143": {
      "text": "My analysis isn't working...!?",
      "status": "imported"
    },
    "voice_092:r_d8c669c70659e18a": {
      "text": "Then adapt to the situation!",
      "status": "imported"
    },
    "voice_092:r_8f5bade7ac2db78e": {
      "text": "Allegro ma non troppo...\\nGet it?",
      "status": "imported"
    },
    "voice_092:r_05ea490d2f522520": {
      "text": "No, not at all...",
      "status": "imported"
    },
    "voice_092:r_f5658c702d91db7a": {
      "text": "Idle thoughts\\nmade you careless!?",
      "status": "imported"
    },
    "voice_092:r_686df329b50f195b": {
      "text": "Th-that's not true!",
      "status": "imported"
    },
    "voice_092:r_25f0ab0fa3cf690c": {
      "text": "Oh no!\\nMy predictions are all off!",
      "status": "imported"
    },
    "voice_092:r_b708a1d959013dbf": {
      "text": "Then just revise them!",
      "status": "imported"
    },
    "voice_092:r_59fca03e929366c1": {
      "text": "We're fine!\\nLet's go all out! Yeah!",
      "status": "imported"
    },
    "voice_092:r_0d65eb631dcb7514": {
      "text": "Y... Yeah!",
      "status": "imported"
    },
    "voice_092:r_d03018a31e23f1e9": {
      "text": "Unlike me, you're still green, Jin.",
      "status": "imported"
    },
    "voice_092:r_279da5f732aa8847": {
      "text": "...Huh? What does that mean...?",
      "status": "imported"
    },
    "voice_092:r_97f82e3cb6f70110": {
      "text": "Jin, keep trying till you succeed!",
      "status": "imported"
    },
    "voice_092:r_c5611d8dd6def96b": {
      "text": "Roger, Amata!",
      "status": "imported"
    },
    "voice_092:r_6f12cc8ed2732eb5": {
      "text": "A comeback now\\ngets you fired up?",
      "status": "imported"
    },
    "voice_092:r_7abfc55f8fb62ba7": {
      "text": "I don't hate that idea...!",
      "status": "imported"
    },
    "voice_092:r_99e7a66c650b5892": {
      "text": "Guard what matters, right, Jin?",
      "status": "imported"
    },
    "voice_092:r_5b2247b5cfbcd7b2": {
      "text": "I know...!\\nSo I won't give up!",
      "status": "imported"
    },
    "voice_092:r_2d7a9c06347582d9": {
      "text": "Jin!\\nWe're comrades, so rely on me!",
      "status": "imported"
    },
    "voice_092:r_bf953d64c3c7d9b7": {
      "text": "R-right! I'll count on you!",
      "status": "imported"
    },
    "voice_092:r_e09b933e3e706779": {
      "text": "I can't do this! We should run!",
      "status": "imported"
    },
    "voice_092:r_66236eb99b676e5b": {
      "text": "No! Never again\\nwill I run away!",
      "status": "imported"
    },
    "voice_092:r_9639a2dbcd2f58ed": {
      "text": "Kyaaaaaah!",
      "status": "imported"
    },
    "voice_092:r_aeea0893acb93d35": {
      "text": "Yunoha!\\nEven if it costs my life...",
      "status": "imported"
    },
    "voice_092:r_b31568654e53487b": {
      "text": "I believe.\\nJin will be okay...!",
      "status": "imported"
    },
    "voice_092:r_2502132569141ea3": {
      "text": "Thanks, Yunoha.\\nTogether to the end!",
      "status": "imported"
    },
    "voice_092:r_1ff312798a52c8eb": {
      "text": "Jin Muso!",
      "status": "imported"
    },
    "voice_092:r_fa07d90fca62f593": {
      "text": "Yes, I understand, Chair Crea!",
      "status": "imported"
    },
    "voice_092:r_a25bf2676ecf9d83": {
      "text": "Sorry, Yunoha... Sorry, all...!",
      "status": "imported"
    },
    "voice_092:r_237a0288b42dce20": {
      "text": "I-I wasn't curious about combining!",
      "status": "imported"
    },
    "voice_092:r_0556e8a22779ea8e": {
      "text": "O-okay.",
      "status": "imported"
    },
    "voice_092:r_09d377101a48d92a": {
      "text": "(Oh... Is this thrill... combining?)",
      "status": "imported"
    },
    "voice_092:r_11517cc7b0494dbf": {
      "text": "(Could this... be combining...?)",
      "status": "imported"
    },
    "voice_092:r_b5864501463db244": {
      "text": "I want to protect...",
      "status": "imported"
    },
    "voice_092:r_a88939ea84b4474d": {
      "text": "I want to protect...",
      "status": "imported"
    },
    "voice_092:r_a870d0cf7cc11ec6": {
      "text": "What you hold precious!",
      "status": "imported"
    },
    "voice_092:r_958a56c1151cab9e": {
      "text": "This is the power to sever!",
      "status": "imported"
    },
    "voice_092:r_3e87f6fc3ea65aef": {
      "text": "I'll dig with everything I've got!",
      "status": "imported"
    },
    "voice_092:r_5508a7bfa9074eb9": {
      "text": "Let's do this, Gepard!",
      "status": "imported"
    },
    "voice_092:r_09a003e91f0d5dc7": {
      "text": "Raaaaagh!!",
      "status": "imported"
    },
    "voice_092:r_192447448ebd7bb5": {
      "text": "Smash right through!!",
      "status": "imported"
    },
    "voice_092:r_e92920ba4b301b9f": {
      "text": "I... will dig a hole!",
      "status": "imported"
    },
    "voice_092:r_207b256d613bb896": {
      "text": "Everyone, lend me your strength!",
      "status": "imported"
    },
    "voice_092:r_a6fd676d8146501b": {
      "text": "Dimension Tunnel Shell!",
      "status": "imported"
    },
    "voice_092:r_94d35e5fa8e3a198": {
      "text": "Gooooooo!!",
      "status": "imported"
    },
    "voice_092:r_b686510e636673f3": {
      "text": "Yunoha, our bond makes me strong...",
      "status": "imported"
    },
    "voice_092:r_25f9b1e39dd8d366": {
      "text": "We will!",
      "status": "imported"
    },
    "voice_092:r_60c94ea4eb7f7404": {
      "text": "Shinji!!",
      "status": "imported"
    },
    "voice_092:r_1428fe5f35a9427b": {
      "text": "It's far beyond my predictions...!",
      "status": "imported"
    },
    "voice_092:r_96d39b8bdfa6f183": {
      "text": "A plan to concentrate our attacks?",
      "status": "imported"
    },
    "voice_092:r_0e4f9b8a2d26ebff": {
      "text": "I'll provide support.",
      "status": "imported"
    },
    "voice_092:r_79e0d542fe12bcf7": {
      "text": "If a diversion's enough...!",
      "status": "imported"
    },
    "voice_092:r_eff747ba39a55393": {
      "text": "I'll draw their attention this way!",
      "status": "imported"
    },
    "voice_092:r_b2dc77aa6dd77e69": {
      "text": "So that's my assignment.",
      "status": "imported"
    },
    "voice_092:r_445d40d8b5d7092b": {
      "text": "A plan to split up their forces?",
      "status": "imported"
    },
    "voice_092:r_bbb633cb5e8e6daf": {
      "text": "I have to prove myself too...!",
      "status": "imported"
    },
    "voice_092:r_0abd8b6c713ccdac": {
      "text": "I'll take the enemies over there...!",
      "status": "imported"
    }
  }
}
