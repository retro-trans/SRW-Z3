{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_070:r_479b340ccc6c572b": {
      "text": "I never miss my mark!",
      "status": "imported"
    },
    "voice_070:r_ca4acbac57a2a35e": {
      "text": "Target... acquired!",
      "status": "imported"
    },
    "voice_070:r_77949221bf58f862": {
      "text": "No mercy!",
      "status": "imported"
    },
    "voice_070:r_70b9c4b9f1f37eff": {
      "text": "Have a taste of this!",
      "status": "imported"
    },
    "voice_070:r_9fcb3754cb1773c7": {
      "text": "Bingo! Got you!",
      "status": "imported"
    },
    "voice_070:r_3559d2fad32c2435": {
      "text": "Let's see if you're a match for me!",
      "status": "imported"
    },
    "voice_070:r_f7570547e9f80a64": {
      "text": "I dislike pointless battles... But!",
      "status": "imported"
    },
    "voice_070:r_cbab0f4720e1fcf1": {
      "text": "Don't underestimate the Zentran!",
      "status": "imported"
    },
    "voice_070:r_0bbe0b4f5364e732": {
      "text": "This is how the Zentradi fight!",
      "status": "imported"
    },
    "voice_070:r_5dda5198137cb02a": {
      "text": "That was just a warm-up!",
      "status": "imported"
    },
    "voice_070:r_83ec59afbecdec14": {
      "text": "I'll take down the Vajra!",
      "status": "imported"
    },
    "voice_070:r_e20bfd42ad95a3c9": {
      "text": "Vajra! They just keep coming!",
      "status": "imported"
    },
    "voice_070:r_0f58a8822381e57f": {
      "text": "The Vajra are monsters enough!",
      "status": "imported"
    },
    "voice_070:r_6dbcc507fb61b51d": {
      "text": "This Earth is quite dangerous too!",
      "status": "imported"
    },
    "voice_070:r_b42ab697149a7c8a": {
      "text": "The enemy commander is mine!",
      "status": "imported"
    },
    "voice_070:r_bc8538e6af3d2577": {
      "text": "You won't escape my sights...!",
      "status": "imported"
    },
    "voice_070:r_924516c8de2b5342": {
      "text": "You'll never get away!",
      "status": "imported"
    },
    "voice_070:r_da1174533722333f": {
      "text": "Let's see you dodge this!",
      "status": "imported"
    },
    "voice_070:r_fdeb8162976e72c1": {
      "text": "Just try and dodge this!!",
      "status": "imported"
    },
    "voice_070:r_0fadb5c26df92b42": {
      "text": "Run all you like...",
      "status": "imported"
    },
    "voice_070:r_6b15af9a0057cdc8": {
      "text": "I'll finish you for sure!",
      "status": "imported"
    },
    "voice_070:r_15b4a90140e8a33a": {
      "text": "Take this!",
      "status": "imported"
    },
    "voice_070:r_af884a6b11dff121": {
      "text": "You're mine!",
      "status": "imported"
    },
    "voice_070:r_b7b5625d7cd4282f": {
      "text": "I'll at least praise your nerve!",
      "status": "imported"
    },
    "voice_070:r_36133ad73a73ef98": {
      "text": "Counterattack! Here I go!",
      "status": "imported"
    },
    "voice_070:r_920740a0219c5085": {
      "text": "Getting beaten isn't in my nature!",
      "status": "imported"
    },
    "voice_070:r_a8451712c57c1a72": {
      "text": "Here's some payback!",
      "status": "imported"
    },
    "voice_070:r_3633df5b7b8f47fa": {
      "text": "You think you can disengage?!",
      "status": "imported"
    },
    "voice_070:r_52dfc56b14b93551": {
      "text": "Running away won't do you any good!",
      "status": "imported"
    },
    "voice_070:r_1b9b2aab5cb104da": {
      "text": "I'm going in! Clear a path!",
      "status": "imported"
    },
    "voice_070:r_342044c706a2340f": {
      "text": "Klan Klang here! Providing support!",
      "status": "imported"
    },
    "voice_070:r_cf41e8828a90cbdb": {
      "text": "Alto! Now we'd\\nmake a great team!",
      "status": "imported"
    },
    "voice_070:r_719e897304ec42d4": {
      "text": "I'll lend you a hand, Michel!",
      "status": "imported"
    },
    "voice_070:r_d5e0a2317c40d322": {
      "text": "You're always sloppy at the finish!",
      "status": "imported"
    },
    "voice_070:r_ec2ea17765052401": {
      "text": "Michel!\\nMM Jenius Formation!",
      "status": "imported"
    },
    "voice_070:r_f2d4255f1c2f7542": {
      "text": "Luca! Don't push yourself too hard!",
      "status": "imported"
    },
    "voice_070:r_5d08ad19e2da125b": {
      "text": "I'll take the finishing blow, Ozma!",
      "status": "imported"
    },
    "voice_070:r_a7246b52782a877e": {
      "text": "Canaria! How about we women team up?",
      "status": "imported"
    },
    "voice_070:r_dc8701f6bcb9904f": {
      "text": "I'll strike from behind the Quarter!",
      "status": "imported"
    },
    "voice_070:r_d6bdd730f24f66eb": {
      "text": "You expect me to just stand by?!",
      "status": "imported"
    },
    "voice_070:r_41997412868c48c4": {
      "text": "Leave this to me and go on ahead!",
      "status": "imported"
    },
    "voice_070:r_9e6cf4f389dae55c": {
      "text": "Don't make her wait and cry,\\nAlto!",
      "status": "imported"
    },
    "voice_070:r_9e0c80ac7e33b459": {
      "text": "Michel...! I won't let you get him!!",
      "status": "imported"
    },
    "voice_070:r_7432ef43ed3471dc": {
      "text": "I-it's not like I meant to help you!",
      "status": "imported"
    },
    "voice_070:r_065443f6ddfcf0d7": {
      "text": "Luca! You're too far out in front!",
      "status": "imported"
    },
    "voice_070:r_47d52a2839c71715": {
      "text": "What's up, Ozma?\\nToo soon to be old!",
      "status": "imported"
    },
    "voice_070:r_847f82e7f3eef651": {
      "text": "The Konig can't do this, Canaria!",
      "status": "imported"
    },
    "voice_070:r_eb7ae28b53dc033c": {
      "text": "Quarter, fall back!",
      "status": "imported"
    },
    "voice_070:r_98d15b8cc09bc915": {
      "text": "I missed my chance to counter...!",
      "status": "imported"
    },
    "voice_070:r_46e86d000250e137": {
      "text": "Tch! I fell for the enemy's trap!",
      "status": "imported"
    },
    "voice_070:r_ac341e7976e88f0b": {
      "text": "What's wrong?! Move, Quadran!",
      "status": "imported"
    },
    "voice_070:r_cdbd128a5b4127cc": {
      "text": "Hmph! You spineless coward!",
      "status": "imported"
    },
    "voice_070:r_cfccaa1fbeda124c": {
      "text": "Ngh! They know my weapon's reach...!",
      "status": "imported"
    },
    "voice_070:r_b1f8ec192b9c083a": {
      "text": "You greenhorn!",
      "status": "imported"
    },
    "voice_070:r_a007f9ab9cf048b3": {
      "text": "You'll have to move faster!",
      "status": "imported"
    },
    "voice_070:r_ddafde4b065ced49": {
      "text": "You missed by a mile!",
      "status": "imported"
    },
    "voice_070:r_de1213040856c089": {
      "text": "Hmph, it seems I'm the faster one.",
      "status": "imported"
    },
    "voice_070:r_3304412ac41f47a6": {
      "text": "Like that'll hit me!",
      "status": "imported"
    },
    "voice_070:r_0c0775e051211840": {
      "text": "Come back when you're ready!",
      "status": "imported"
    },
    "voice_070:r_a2afffe1c396f0b3": {
      "text": "You think you can hit my Quadran?",
      "status": "imported"
    },
    "voice_070:r_13c25fbdfddc8a24": {
      "text": "Not nearly enough to fire me up.",
      "status": "imported"
    },
    "voice_070:r_42ba1ecb310b4bd7": {
      "text": "Blindly taking aim won't help!",
      "status": "imported"
    },
    "voice_070:r_d692f1d420460a47": {
      "text": "You miss because you rush...!",
      "status": "imported"
    },
    "voice_070:r_a5643cec86b18bd2": {
      "text": "That won't work!",
      "status": "imported"
    },
    "voice_070:r_a03fabecba1508ca": {
      "text": "My armor can deflect that much!",
      "status": "imported"
    },
    "voice_070:r_5391b24a71eb10ae": {
      "text": "It barely grazed me!",
      "status": "imported"
    },
    "voice_070:r_a554ceef5c87b972": {
      "text": "Pathetic! Are you even a warrior?",
      "status": "imported"
    },
    "voice_070:r_546c3d5937fbb7ee": {
      "text": "If you're weak, stay out!\\nGet back!",
      "status": "imported"
    },
    "voice_070:r_1568ff6298b12b96": {
      "text": "Damn! I failed to dodge that!",
      "status": "imported"
    },
    "voice_070:r_2c9d94ba13c5fc50": {
      "text": "Interesting, but not a second time!",
      "status": "imported"
    },
    "voice_070:r_a77f4913375098d2": {
      "text": "You've got skill...! I like you!",
      "status": "imported"
    },
    "voice_070:r_428c2116ac3071b1": {
      "text": "Now we're talking!\\nI can go all out!",
      "status": "imported"
    },
    "voice_070:r_84c116267b79f540": {
      "text": "Heh... Zentran blood stirs in me!",
      "status": "imported"
    },
    "voice_070:r_dad38ee29af2df3a": {
      "text": "Damn! That was a direct hit!",
      "status": "imported"
    },
    "voice_070:r_3d32e86f8dc80909": {
      "text": "You kept up with my moves...?!",
      "status": "imported"
    },
    "voice_070:r_70451ffbabe2f876": {
      "text": "Don't think Zentran fall so easily!",
      "status": "imported"
    },
    "voice_070:r_69dfa1659715e2fa": {
      "text": "I have my own reason not to die...!",
      "status": "imported"
    },
    "voice_070:r_d996fd6d4ef5b329": {
      "text": "I won't sit here and wait to die...!",
      "status": "imported"
    },
    "voice_070:r_8ab47a28f99ef565": {
      "text": "N-no...!\\nThey've read my every move!",
      "status": "imported"
    },
    "voice_070:r_546de3fb6db156ea": {
      "text": "Impossible...! Am I going down?!",
      "status": "imported"
    },
    "voice_070:r_ca85f87cee5e31f7": {
      "text": "Ngh...! M-Michel...!",
      "status": "imported"
    },
    "voice_070:r_9072ea7bc71df136": {
      "text": "Is this it...?! I'm withdrawing!",
      "status": "imported"
    },
    "voice_070:r_04e815a8d425827d": {
      "text": "I'm hit...! Klan unit retreating!",
      "status": "imported"
    },
    "voice_070:r_d89011fe3e5d082a": {
      "text": "M-Michel!!",
      "status": "imported"
    },
    "voice_070:r_3c5b0c2ac812d5de": {
      "text": "Failed to finish you! Then...!",
      "status": "imported"
    },
    "voice_070:r_5b9e8897190892eb": {
      "text": "I won't fall to such a weak attack!",
      "status": "imported"
    },
    "voice_070:r_7bea3023abbf8a94": {
      "text": "A barrier?! Fine by me!",
      "status": "imported"
    },
    "voice_070:r_dd01a4c0d1b36a8d": {
      "text": "Michel! Get behind me!",
      "status": "imported"
    },
    "voice_070:r_20920ad2eb3542db": {
      "text": "The top ace title is mine!",
      "status": "imported"
    },
    "voice_070:r_0ab7914877fd48ed": {
      "text": "At that pace,\\nyou can't escape me!",
      "status": "imported"
    },
    "voice_070:r_cb846feec748c2e3": {
      "text": "Holteez!",
      "status": "imported"
    },
    "voice_070:r_c958860b0676b1f5": {
      "text": "Holt Dantz Zentran!",
      "status": "imported"
    },
    "voice_070:r_5e2669b82ef75ce3": {
      "text": "Even if the Vajra have us outgunned!",
      "status": "imported"
    },
    "voice_070:r_7847e0ed7dc9282d": {
      "text": "Come! I'll crush you!\\nLike Vajra!",
      "status": "imported"
    },
    "voice_070:r_e42b52c7a987b906": {
      "text": "I'm right here, monster!",
      "status": "imported"
    },
    "voice_070:r_6825fd1ff907bd22": {
      "text": "Zentran battle instinct beats gods!",
      "status": "imported"
    },
    "voice_070:r_607f666f1563bc0d": {
      "text": "I flee no foe!\\nLove fears no death!",
      "status": "imported"
    },
    "voice_070:r_97b7431eeb81e6b6": {
      "text": "I'll protect our new homeland!",
      "status": "imported"
    },
    "voice_070:r_ceb935ccbf830724": {
      "text": "The new model looks good, Alto!",
      "status": "imported"
    },
    "voice_070:r_862ef7385bf2abd4": {
      "text": "Be a man! Master the new one, Alto!",
      "status": "imported"
    },
    "voice_070:r_001cbec4d9a4283f": {
      "text": "The bugs are closing in...!",
      "status": "imported"
    },
    "voice_070:r_8ad40afecd02b41e": {
      "text": "Damn Vajra... Are they confused?",
      "status": "imported"
    },
    "voice_070:r_1f65a7af190e4674": {
      "text": "That's all you've got!",
      "status": "imported"
    },
    "voice_070:r_40c5a9358ed5bf29": {
      "text": "Heh, pointless!",
      "status": "imported"
    },
    "voice_070:r_fa96676cc65bb509": {
      "text": "Ngh! The Vajra\\npushed me so far...!",
      "status": "imported"
    },
    "voice_070:r_4e37f92e7d2fc62e": {
      "text": "Vajra...\\nThey read my moves?!",
      "status": "imported"
    },
    "voice_070:r_2072eaf71a260ae7": {
      "text": "Hmph! Done already? Still no guts!",
      "status": "imported"
    },
    "voice_070:r_6c13bbfd27a7799e": {
      "text": "Easy there! Pilots must stay fit!",
      "status": "imported"
    },
    "voice_070:r_06f88dcbd3c9e738": {
      "text": "Fine! Break approved! I'll join you!",
      "status": "imported"
    },
    "voice_070:r_b28faf9f71bc3598": {
      "text": "N-not for company! A lesson in duty!",
      "status": "imported"
    },
    "voice_070:r_8a29278549f8e07a": {
      "text": "Rest now! Superior's order! Got it?!",
      "status": "imported"
    },
    "voice_070:r_7e6c573c26177f98": {
      "text": "I'll hold them here!",
      "status": "imported"
    },
    "voice_070:r_45abf84f7757d6eb": {
      "text": "Don't think this is just a feint!",
      "status": "imported"
    },
    "voice_070:r_edd7a13ab8f06a14": {
      "text": "I'll take the vanguard!",
      "status": "imported"
    },
    "voice_070:r_8165e5b41f0124c4": {
      "text": "No matter who the enemy is!",
      "status": "imported"
    },
    "voice_070:r_4e05581b7432cce8": {
      "text": "Leave this side to me!",
      "status": "imported"
    },
    "voice_070:r_a60b107ea3c36a86": {
      "text": "All right! I'm coming aboard!",
      "status": "imported"
    }
  }
}
