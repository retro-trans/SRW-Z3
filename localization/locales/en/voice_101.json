{
  "schema": 1,
  "language": "en",
  "messages": {
    "voice_101:r_ca4acbac57a2a35e": {
      "text": "We'll attack first!",
      "status": "imported"
    },
    "voice_101:r_77949221bf58f862": {
      "text": "All right! Let's go!",
      "status": "imported"
    },
    "voice_101:r_70b9c4b9f1f37eff": {
      "text": "I won't hold anything back!",
      "status": "imported"
    },
    "voice_101:r_9fcb3754cb1773c7": {
      "text": "I'm going all out!",
      "status": "imported"
    },
    "voice_101:r_3559d2fad32c2435": {
      "text": "This one's my turn!",
      "status": "imported"
    },
    "voice_101:r_f7570547e9f80a64": {
      "text": "I'll show you Aquarion's power!",
      "status": "imported"
    },
    "voice_101:r_cbab0f4720e1fcf1": {
      "text": "You think you can run? Think again!",
      "status": "imported"
    },
    "voice_101:r_0bbe0b4f5364e732": {
      "text": "I'm in top form today!",
      "status": "imported"
    },
    "voice_101:r_5dda5198137cb02a": {
      "text": "Fighting is all I can do...!",
      "status": "imported"
    },
    "voice_101:r_83ec59afbecdec14": {
      "text": "All I can do now is...\\nfight...!",
      "status": "imported"
    },
    "voice_101:r_e20bfd42ad95a3c9": {
      "text": "At least my fighting can help Amata!",
      "status": "imported"
    },
    "voice_101:r_0f58a8822381e57f": {
      "text": "What I can do for Amata is...!",
      "status": "imported"
    },
    "voice_101:r_6dbcc507fb61b51d": {
      "text": "I can feel it... Everyone's power!",
      "status": "imported"
    },
    "voice_101:r_b42ab697149a7c8a": {
      "text": "Everyone, lend me your strength!",
      "status": "imported"
    },
    "voice_101:r_4de4fcf3b440baf4": {
      "text": "Let's go, Amata! Lend me your power!",
      "status": "imported"
    },
    "voice_101:r_0121a166c715cdff": {
      "text": "Roger that, Zessica!",
      "status": "imported"
    },
    "voice_101:r_30fad37a42bd3ad3": {
      "text": "Now, Zessica! This is our chance!",
      "status": "imported"
    },
    "voice_101:r_80a0b2a84e05d81a": {
      "text": "I won't waste Amata's support!",
      "status": "imported"
    },
    "voice_101:r_4a9ac1dff86506d9": {
      "text": "Watch me, Amata! Watch me fight!",
      "status": "imported"
    },
    "voice_101:r_bc8538e6af3d2577": {
      "text": "Zessica...",
      "status": "imported"
    },
    "voice_101:r_924516c8de2b5342": {
      "text": "Mikono! Are you ready!?",
      "status": "imported"
    },
    "voice_101:r_da1174533722333f": {
      "text": "Ready whenever you are!",
      "status": "imported"
    },
    "voice_101:r_fdeb8162976e72c1": {
      "text": "Straight ahead, Zessica!",
      "status": "imported"
    },
    "voice_101:r_0fadb5c26df92b42": {
      "text": "A head-on fight?\\nYou've got guts!",
      "status": "imported"
    },
    "voice_101:r_6b15af9a0057cdc8": {
      "text": "U-um, Zessica... About Amata...",
      "status": "imported"
    },
    "voice_101:r_15b4a90140e8a33a": {
      "text": "We can talk later! Focus on battle!",
      "status": "imported"
    },
    "voice_101:r_af884a6b11dff121": {
      "text": "Mikono has Amata... And I have...!",
      "status": "imported"
    },
    "voice_101:r_ac6fe7838e95647b": {
      "text": "Zessica...",
      "status": "imported"
    },
    "voice_101:r_77ca87eacd17ad52": {
      "text": "Let's finish this in one shot!",
      "status": "imported"
    },
    "voice_101:r_bf3244994760e535": {
      "text": "You really are the number one girl.",
      "status": "imported"
    },
    "voice_101:r_aabfb21c9d069ce7": {
      "text": "Andy! Keep your eyes on the fight!",
      "status": "imported"
    },
    "voice_101:r_02479dc8fe989560": {
      "text": "Yeah!\\nI'll cover Zessica!",
      "status": "imported"
    },
    "voice_101:r_a2df00f91a9b0a9e": {
      "text": "What's the plan, Zessica?",
      "status": "imported"
    },
    "voice_101:r_48b60d6c48b9b142": {
      "text": "Charge in head-on, of course!",
      "status": "imported"
    },
    "voice_101:r_8927e6fb681aa809": {
      "text": "Let's do this, Wreck!",
      "status": "imported"
    },
    "voice_101:r_665f01666859013b": {
      "text": "Save it, Mr. Upside-Down!",
      "status": "imported"
    },
    "voice_101:r_a571eec59b258d11": {
      "text": "Jin! Show me what you've really got!",
      "status": "imported"
    },
    "voice_101:r_ddbe581c5ea9183d": {
      "text": "Ngh... The pressure...",
      "status": "imported"
    },
    "voice_101:r_faae935cca0edc72": {
      "text": "Kagura! Lend me your strength!",
      "status": "imported"
    },
    "voice_101:r_d4430bf362340b32": {
      "text": "Sure!\\nWe'll show them our strength!",
      "status": "imported"
    },
    "voice_101:r_6ff1323b355593e0": {
      "text": "Amata, Kagura!\\nLet's finish this!",
      "status": "imported"
    },
    "voice_101:r_b7b5625d7cd4282f": {
      "text": "Zessica! Take our power...!",
      "status": "imported"
    },
    "voice_101:r_36133ad73a73ef98": {
      "text": "We're entrusting it to you!",
      "status": "imported"
    },
    "voice_101:r_920740a0219c5085": {
      "text": "My chance! I'll strike again!",
      "status": "imported"
    },
    "voice_101:r_a8451712c57c1a72": {
      "text": "Too bad! Our attack isn't over yet!",
      "status": "imported"
    },
    "voice_101:r_3633df5b7b8f47fa": {
      "text": "Beasts need\\na harsh punishment!",
      "status": "imported"
    },
    "voice_101:r_52dfc56b14b93551": {
      "text": "I'm a wild animal tamer now...!",
      "status": "imported"
    },
    "voice_101:r_1b9b2aab5cb104da": {
      "text": "No mercy for an enemy of women!",
      "status": "imported"
    },
    "voice_101:r_342044c706a2340f": {
      "text": "If flirting's all you want,\\ntry me!",
      "status": "imported"
    },
    "voice_101:r_cf41e8828a90cbdb": {
      "text": "Take down the boss and we win!",
      "status": "imported"
    },
    "voice_101:r_d5e0a2317c40d322": {
      "text": "You came out yourself.\\nPerfect...!",
      "status": "imported"
    },
    "voice_101:r_f2d4255f1c2f7542": {
      "text": "Our hearts will crush your darkness!",
      "status": "imported"
    },
    "voice_101:r_5d08ad19e2da125b": {
      "text": "I won't fall into darkness like you!",
      "status": "imported"
    },
    "voice_101:r_a7246b52782a877e": {
      "text": "Please, MIX! Listen to me!",
      "status": "imported"
    },
    "voice_101:r_dc8701f6bcb9904f": {
      "text": "I'll stop MIX!\\nThat's my atonement!",
      "status": "imported"
    },
    "voice_101:r_d6bdd730f24f66eb": {
      "text": "Up close, Gepard is nothing...!",
      "status": "imported"
    },
    "voice_101:r_41997412868c48c4": {
      "text": "Pierce the barrage, then close in!",
      "status": "imported"
    },
    "voice_101:r_9e6cf4f389dae55c": {
      "text": "I can't lose to another Spada!",
      "status": "imported"
    },
    "voice_101:r_9e0c80ac7e33b459": {
      "text": "Same reach...! Then skill wins out!",
      "status": "imported"
    },
    "voice_101:r_7432ef43ed3471dc": {
      "text": "Aquarion Spada won't lose on speed!",
      "status": "imported"
    },
    "voice_101:r_065443f6ddfcf0d7": {
      "text": "Can't relax against a Gundam!",
      "status": "imported"
    },
    "voice_101:r_47d52a2839c71715": {
      "text": "This is going to hurt a little!",
      "status": "imported"
    },
    "voice_101:r_847f82e7f3eef651": {
      "text": "No one's aboard, so no holding back!",
      "status": "imported"
    },
    "voice_101:r_eb7ae28b53dc033c": {
      "text": "Gross things give me the creeps...!",
      "status": "imported"
    },
    "voice_101:r_857c4a52ce8df0fd": {
      "text": "Unknown or not, attackers are foes!",
      "status": "imported"
    },
    "voice_101:r_55417493fce1d347": {
      "text": "We won't let your kind\\nrule Earth!",
      "status": "imported"
    },
    "voice_101:r_7d724dbcc4451e10": {
      "text": "I have pride\\nas the number one girl!",
      "status": "imported"
    },
    "voice_101:r_93e25418a203cb8f": {
      "text": "Let's settle who's the ace!",
      "status": "imported"
    },
    "voice_101:r_adeb0a29274d3d9b": {
      "text": "I won't hear\\nyour selfish logic!",
      "status": "imported"
    },
    "voice_101:r_24cf161287ef9d5c": {
      "text": "The world has no need\\nfor your kind!",
      "status": "imported"
    },
    "voice_101:r_8f60f6fc86db3107": {
      "text": "Skulking cowards\\nwon't beat us!",
      "status": "imported"
    },
    "voice_101:r_b1de76a75a253c13": {
      "text": "Humanity\\nwon't bend to your will!",
      "status": "imported"
    },
    "voice_101:r_128c35bf3e0e394c": {
      "text": "Watch out, Zessica! Here they come!",
      "status": "imported"
    },
    "voice_101:r_5213c17e13b23de0": {
      "text": "I got this, Amata! They're mine!",
      "status": "imported"
    },
    "voice_101:r_38fdff9483e9245c": {
      "text": "Let's settle this, Mikage!",
      "status": "imported"
    },
    "voice_101:r_620fedec67706d7d": {
      "text": "Our will\\nwill crush hate's captive!",
      "status": "imported"
    },
    "voice_101:r_9680dcd0fddcfcc7": {
      "text": "Then we'll save both Earths!",
      "status": "imported"
    },
    "voice_101:r_774a9ab4d8fd5351": {
      "text": "I'll slice you clean in two!",
      "status": "imported"
    },
    "voice_101:r_d3f01de714c015bd": {
      "text": "Try this on for size!",
      "status": "imported"
    },
    "voice_101:r_7d2617c809fead70": {
      "text": "Behold my graceful swordplay!",
      "status": "imported"
    },
    "voice_101:r_ceb935ccbf830724": {
      "text": "Hah! Split in two!",
      "status": "imported"
    },
    "voice_101:r_862ef7385bf2abd4": {
      "text": "Thought I'd just let you hit me?",
      "status": "imported"
    },
    "voice_101:r_001cbec4d9a4283f": {
      "text": "Now it's my turn!",
      "status": "imported"
    },
    "voice_101:r_8ad40afecd02b41e": {
      "text": "Think you can run? Big mistake!",
      "status": "imported"
    },
    "voice_101:r_26e5efec03c03d78": {
      "text": "No hit-and-run attacks on my watch!",
      "status": "imported"
    },
    "voice_101:r_4ad81e88c7557a8b": {
      "text": "Let's go! Time to counterattack!",
      "status": "imported"
    },
    "voice_101:r_1f65a7af190e4674": {
      "text": "Here's payback for before!",
      "status": "imported"
    },
    "voice_101:r_40c5a9358ed5bf29": {
      "text": "I'll give you a hand!",
      "status": "imported"
    },
    "voice_101:r_f2e18dfdfe0c89ea": {
      "text": "This one's a little bonus from me!",
      "status": "imported"
    },
    "voice_101:r_cf7dbf49e96a5755": {
      "text": "You really are a handful...!",
      "status": "imported"
    },
    "voice_101:r_fa96676cc65bb509": {
      "text": "I may not look it, but I'm loyal!",
      "status": "imported"
    },
    "voice_101:r_4e37f92e7d2fc62e": {
      "text": "Huh!? I can't counterattack!",
      "status": "imported"
    },
    "voice_101:r_66ab4cfe1557909d": {
      "text": "Damn! I'm a sitting duck like this!",
      "status": "imported"
    },
    "voice_101:r_0bad405ee6ca63ba": {
      "text": "Oh no! I got my pacing wrong!",
      "status": "imported"
    },
    "voice_101:r_2072eaf71a260ae7": {
      "text": "They took a nasty position!",
      "status": "imported"
    },
    "voice_101:r_6c13bbfd27a7799e": {
      "text": "Ngh...! They're out of range!",
      "status": "imported"
    },
    "voice_101:r_06f88dcbd3c9e738": {
      "text": "You missed!",
      "status": "imported"
    },
    "voice_101:r_b28faf9f71bc3598": {
      "text": "Over here! You're too slow!",
      "status": "imported"
    },
    "voice_101:r_8a29278549f8e07a": {
      "text": "See? I knew you'd do that!",
      "status": "imported"
    },
    "voice_101:r_7e6c573c26177f98": {
      "text": "Like that attack could hit me!",
      "status": "imported"
    },
    "voice_101:r_45abf84f7757d6eb": {
      "text": "I've trained against this plenty!",
      "status": "imported"
    },
    "voice_101:r_edd7a13ab8f06a14": {
      "text": "Too slow to catch me!",
      "status": "imported"
    },
    "voice_101:r_8165e5b41f0124c4": {
      "text": "Oh? That courage was all talk!",
      "status": "imported"
    },
    "voice_101:r_4e05581b7432cce8": {
      "text": "A mindless beast won't catch me...!",
      "status": "imported"
    },
    "voice_101:r_a60b107ea3c36a86": {
      "text": "That's our Zessica!",
      "status": "imported"
    },
    "voice_101:r_e33693e5ba4665b0": {
      "text": "Naturally!",
      "status": "imported"
    },
    "voice_101:r_72a21a1a489af001": {
      "text": "Won't you praise me, Amata?",
      "status": "imported"
    },
    "voice_101:r_eb643f8bf737a0ca": {
      "text": "Oh, right...! Amazing, Zessica!",
      "status": "imported"
    },
    "voice_101:r_0a3fccb71ec6cf2a": {
      "text": "See that, Mikono? That's my skill.",
      "status": "imported"
    },
    "voice_101:r_9b63cf1f3e0207ef": {
      "text": "Y-yes! That was amazing!",
      "status": "imported"
    },
    "voice_101:r_8356f4e3dcdff938": {
      "text": "Wow... I'd never have dodged that...",
      "status": "imported"
    },
    "voice_101:r_1d6d784036ae0bd7": {
      "text": "Hehe, praise does feel pretty good.",
      "status": "imported"
    },
    "voice_101:r_625664af02183c17": {
      "text": "Not bad, Zessica.",
      "status": "imported"
    },
    "voice_101:r_3701cba361f80ea5": {
      "text": "I'm not number one for nothing!",
      "status": "imported"
    },
    "voice_101:r_63f429c5c68c0863": {
      "text": "All right! That's our Zessica!",
      "status": "imported"
    },
    "voice_101:r_38e4a434c91d8ef0": {
      "text": "Too bad the praise came from Andy...",
      "status": "imported"
    },
    "voice_101:r_98ed411352a3a6ac": {
      "text": "You can't\\nkeep up with our speed.",
      "status": "imported"
    },
    "voice_101:r_4824bea6bab3af67": {
      "text": "Don't drop your guard, Zessica!",
      "status": "imported"
    },
    "voice_101:r_862b92e63adb9734": {
      "text": "Not bad, Wreck!",
      "status": "imported"
    },
    "voice_101:r_cb306ef55e49d107": {
      "text": "Then quit calling me that!",
      "status": "imported"
    },
    "voice_101:r_57b2bd2de8a1408d": {
      "text": "With Aquarion Spada's speed!",
      "status": "imported"
    },
    "voice_101:r_76f080a4881e8ab5": {
      "text": "Nice reflexes. I'm impressed.",
      "status": "imported"
    },
    "voice_101:r_288133bc5b573dae": {
      "text": "That won't work!",
      "status": "imported"
    },
    "voice_101:r_d249d68bada91ab9": {
      "text": "We've got a barrier on our side!",
      "status": "imported"
    },
    "voice_101:r_e9b3307e9eb69f11": {
      "text": "We have a barrier, so it's useless!",
      "status": "imported"
    },
    "voice_101:r_03cdac73042343ee": {
      "text": "Aquarion Spada has a shield!",
      "status": "imported"
    },
    "voice_101:r_6026da5acbda7c69": {
      "text": "I'll block it with the shield!",
      "status": "imported"
    },
    "voice_101:r_981f8fedd5414fe5": {
      "text": "Oops... Guess I read that wrong.",
      "status": "imported"
    },
    "voice_101:r_96bb0dcde0c8c44a": {
      "text": "No way! They hit me!",
      "status": "imported"
    },
    "voice_101:r_641550a2f54cb456": {
      "text": "This is nothing!",
      "status": "imported"
    },
    "voice_101:r_a0f2074af8debbfa": {
      "text": "Ow! Not bad!",
      "status": "imported"
    },
    "voice_101:r_b5f5a97ed82acb0b": {
      "text": "How dare you mar a girl's skin...!",
      "status": "imported"
    },
    "voice_101:r_d9cd2e4ded064396": {
      "text": "You caught up to me? Not bad!",
      "status": "imported"
    },
    "voice_101:r_99e6349431aaf23b": {
      "text": "Why...!? Why me!?",
      "status": "imported"
    },
    "voice_101:r_ec1081caf845f56a": {
      "text": "No...! My body won't move right!",
      "status": "imported"
    },
    "voice_101:r_2c5b7ee872c1ed7f": {
      "text": "Zessica actually got hit...",
      "status": "imported"
    },
    "voice_101:r_76d1e51c8b494a60": {
      "text": "Even I make mistakes sometimes!",
      "status": "imported"
    },
    "voice_101:r_eb5f687fcd372ae7": {
      "text": "Aren't you worried about me, Amata?",
      "status": "imported"
    },
    "voice_101:r_2329428a6871d9fa": {
      "text": "Huh? Oh...! Are you okay, Zessica!?",
      "status": "imported"
    },
    "voice_101:r_0e7466971bec4cc4": {
      "text": "They hit me!? How!?",
      "status": "imported"
    },
    "voice_101:r_efa71f7a4cc33ff3": {
      "text": "Easy, Zessica! Just a scratch!",
      "status": "imported"
    },
    "voice_101:r_3fc2e1186557e7a0": {
      "text": "Zessica, are you all right!?",
      "status": "imported"
    },
    "voice_101:r_fa6930340a545054": {
      "text": "Sorry! I messed up a little!",
      "status": "imported"
    },
    "voice_101:r_2332b9d56461d7ab": {
      "text": "Whoops, I let my guard down...!",
      "status": "imported"
    },
    "voice_101:r_854aa0a91a3c80d1": {
      "text": "I'm fine! Focus on attacking!",
      "status": "imported"
    },
    "voice_101:r_0bc8ae32a406ceab": {
      "text": "You could've dodged that, Zessica.",
      "status": "imported"
    },
    "voice_101:r_82c09f011d703b2c": {
      "text": "The number one girl ought to weep.",
      "status": "imported"
    },
    "voice_101:r_2b4d8818c77b6dca": {
      "text": "Hey, Zessica! What are you doing!?",
      "status": "imported"
    },
    "voice_101:r_087354f2db0a31e6": {
      "text": "Men don't fuss over little things!",
      "status": "imported"
    },
    "voice_101:r_db02a2dec93dd263": {
      "text": "Sorry, Malloy! I got hit!",
      "status": "imported"
    },
    "voice_101:r_d520c6d5298a848d": {
      "text": "No problems here! Don't worry!",
      "status": "imported"
    },
    "voice_101:r_099e2458cabf796f": {
      "text": "Weak feints.\\nThat's what happens.",
      "status": "imported"
    },
    "voice_101:r_fd910d714be70870": {
      "text": "Jin, you're such a nitpicker.",
      "status": "imported"
    },
    "voice_101:r_9736f29b11344ec3": {
      "text": "This isn't playtime, Wreck!",
      "status": "imported"
    },
    "voice_101:r_fcd05582aa5c6068": {
      "text": "Enough, Kagura! Just be quiet!",
      "status": "imported"
    },
    "voice_101:r_bece29562818acba": {
      "text": "Your reaction was a little slow.",
      "status": "imported"
    },
    "voice_101:r_494b5da92ed24ecb": {
      "text": "Can't fool Cayenne's eyes...",
      "status": "imported"
    },
    "voice_101:r_cd06d0820d82524b": {
      "text": "Not bad...! This one's strong!",
      "status": "imported"
    },
    "voice_101:r_c94c6d04be583774": {
      "text": "Aah! They got me!",
      "status": "imported"
    },
    "voice_101:r_e54e2c99ef8297af": {
      "text": "I fell for the feint...!?",
      "status": "imported"
    },
    "voice_101:r_f16a3eb0bcaac082": {
      "text": "Ngh...!\\nThis is seriously bad!",
      "status": "imported"
    },
    "voice_101:r_10a408809e512df1": {
      "text": "Looks like I need to get serious!",
      "status": "imported"
    },
    "voice_101:r_bc7b9e308b879dd4": {
      "text": "Everything I do backfires...!",
      "status": "imported"
    },
    "voice_101:r_98902fd3143c393e": {
      "text": "Wounds like this don't matter!",
      "status": "imported"
    },
    "voice_101:r_d907fbd7bc1c4298": {
      "text": "I won't stop...! Not until I win!",
      "status": "imported"
    },
    "voice_101:r_96b21e3a028dd074": {
      "text": "Ngh...! A stray dog bit me!",
      "status": "imported"
    },
    "voice_101:r_ce140b5d8e6b7310": {
      "text": "Strong...!\\nMore monster than beast!?",
      "status": "imported"
    },
    "voice_101:r_0e0335789c5396d7": {
      "text": "Are you okay, Zessica!?",
      "status": "imported"
    },
    "voice_101:r_a8e85bd950696403": {
      "text": "...You really are worried, Amata.",
      "status": "imported"
    },
    "voice_101:r_772c8bc40ab6cb61": {
      "text": "That one... isn't like past foes...!",
      "status": "imported"
    },
    "voice_101:r_58dd2826a199ef51": {
      "text": "They've driven Zessica this far...!",
      "status": "imported"
    },
    "voice_101:r_aadc0b2442adb93b": {
      "text": "Zessica, what is it!?\\nFeeling sick!?",
      "status": "imported"
    },
    "voice_101:r_e7a8cd8ed5bc2d1b": {
      "text": "Fighting is all I can do, but...!",
      "status": "imported"
    },
    "voice_101:r_041dd920da4a7c17": {
      "text": "Ngh...! They totally outwitted me!",
      "status": "imported"
    },
    "voice_101:r_c7f4280cde4605b3": {
      "text": "I-I'm fine!\\nThe power core is safe!",
      "status": "imported"
    },
    "voice_101:r_ec349c8ea9511a18": {
      "text": "Zessica! The chest took damage!",
      "status": "imported"
    },
    "voice_101:r_33236ffa3ea95b68": {
      "text": "No! They touched my chest!?",
      "status": "imported"
    },
    "voice_101:r_689d0b123de71ae0": {
      "text": "Want me to take over, Zessica?",
      "status": "imported"
    },
    "voice_101:r_84883aa95f63ce32": {
      "text": "You wish! The fight starts now!",
      "status": "imported"
    },
    "voice_101:r_25493e978ce8ff16": {
      "text": "They matched Spada's speed...!",
      "status": "imported"
    },
    "voice_101:r_7316666150e42960": {
      "text": "So the enemy's got some skill.",
      "status": "imported"
    },
    "voice_101:r_c4f11aa93dc5b668": {
      "text": "Andy, are you alive!?",
      "status": "imported"
    },
    "voice_101:r_ce1a22dfe3a4d339": {
      "text": "Of course!\\nI won't die here!",
      "status": "imported"
    },
    "voice_101:r_240651adab81e145": {
      "text": "They're reading our movements!?",
      "status": "imported"
    },
    "voice_101:r_cff0deaae73c2858": {
      "text": "Then use speed to throw them off!",
      "status": "imported"
    },
    "voice_101:r_dca67f68a573fab7": {
      "text": "That one's good...!",
      "status": "imported"
    },
    "voice_101:r_a6630215fefaf294": {
      "text": "Heh...! Now that's a worthy foe!",
      "status": "imported"
    },
    "voice_101:r_6f94566ad37f8ff8": {
      "text": "Their speed is beyond my estimates.",
      "status": "imported"
    },
    "voice_101:r_942ca03c9de80143": {
      "text": "Then we'll go even faster!",
      "status": "imported"
    },
    "voice_101:r_05ea490d2f522520": {
      "text": "No...! I can't take any more...!",
      "status": "imported"
    },
    "voice_101:r_f5658c702d91db7a": {
      "text": "They attacked where I dodged...!",
      "status": "imported"
    },
    "voice_101:r_686df329b50f195b": {
      "text": "Ngh! This is really bad...!",
      "status": "imported"
    },
    "voice_101:r_25f0ab0fa3cf690c": {
      "text": "Sorry...\\nYou may have to brace...!",
      "status": "imported"
    },
    "voice_101:r_b708a1d959013dbf": {
      "text": "I won't lose...! I'll come back!",
      "status": "imported"
    },
    "voice_101:r_59fca03e929366c1": {
      "text": "Spada's armor is about to fail...!",
      "status": "imported"
    },
    "voice_101:r_0d65eb631dcb7514": {
      "text": "I... won't lose! I can't lose!",
      "status": "imported"
    },
    "voice_101:r_d03018a31e23f1e9": {
      "text": "I must fight...!\\nI can't lose!",
      "status": "imported"
    },
    "voice_101:r_279da5f732aa8847": {
      "text": "Zessica! Pull back for a moment!",
      "status": "imported"
    },
    "voice_101:r_97f82e3cb6f70110": {
      "text": "No!\\nRetreat and they'll pick me off!",
      "status": "imported"
    },
    "voice_101:r_c5611d8dd6def96b": {
      "text": "Amata, I'm sorry! One last push!",
      "status": "imported"
    },
    "voice_101:r_6f12cc8ed2732eb5": {
      "text": "Don't quit, Zessica! I'll cover you!",
      "status": "imported"
    },
    "voice_101:r_7abfc55f8fb62ba7": {
      "text": "Too reckless, Zessica! Calm down!",
      "status": "imported"
    },
    "voice_101:r_99e7a66c650b5892": {
      "text": "But... But I...!",
      "status": "imported"
    },
    "voice_101:r_5b2247b5cfbcd7b2": {
      "text": "Zessica, you can't take any more...!",
      "status": "imported"
    },
    "voice_101:r_2d7a9c06347582d9": {
      "text": "I know! I'll do something!",
      "status": "imported"
    },
    "voice_101:r_bf953d64c3c7d9b7": {
      "text": "Spada's armor may be thin, but...!",
      "status": "imported"
    },
    "voice_101:r_e09b933e3e706779": {
      "text": "It'll hold a bit!\\nSo don't give up!",
      "status": "imported"
    },
    "voice_101:r_66236eb99b676e5b": {
      "text": "Damn! That was a direct hit!",
      "status": "imported"
    },
    "voice_101:r_9639a2dbcd2f58ed": {
      "text": "Aquarion turns things around!",
      "status": "imported"
    },
    "voice_101:r_aeea0893acb93d35": {
      "text": "They cornered Zessica this badly...!",
      "status": "imported"
    },
    "voice_101:r_b31568654e53487b": {
      "text": "But I'll win in the end!",
      "status": "imported"
    },
    "voice_101:r_2502132569141ea3": {
      "text": "Do something, Zessica!",
      "status": "imported"
    },
    "voice_101:r_1ff312798a52c8eb": {
      "text": "No complaints.\\nLend me your power!",
      "status": "imported"
    },
    "voice_101:r_fa07d90fca62f593": {
      "text": "Ngh! They hit Spada's weak point!",
      "status": "imported"
    },
    "voice_101:r_a25bf2676ecf9d83": {
      "text": "Then I'll beat them to the punch!",
      "status": "imported"
    },
    "voice_101:r_237a0288b42dce20": {
      "text": "Zessica! Are you trying to die!?",
      "status": "imported"
    },
    "voice_101:r_0556e8a22779ea8e": {
      "text": "Quit it!\\nI can't die before love!",
      "status": "imported"
    },
    "voice_101:r_09d377101a48d92a": {
      "text": "Fall back! We can't take any more!",
      "status": "imported"
    },
    "voice_101:r_11517cc7b0494dbf": {
      "text": "Men don't even think about running!",
      "status": "imported"
    },
    "voice_101:r_b5864501463db244": {
      "text": "No way! I... lost!?",
      "status": "imported"
    },
    "voice_101:r_a88939ea84b4474d": {
      "text": "No! Everyone, get out now!!",
      "status": "imported"
    },
    "voice_101:r_a870d0cf7cc11ec6": {
      "text": "Sorry, Amata... Sorry, everyone...",
      "status": "imported"
    },
    "voice_101:r_03f6158ef83964f3": {
      "text": "OK! Then let's all go together!",
      "status": "imported"
    },
    "voice_101:r_2970a83693cdcc25": {
      "text": "No?",
      "status": "imported"
    },
    "voice_101:r_be661448b85d0009": {
      "text": "Haha, kidding! Go date Mikono!",
      "status": "imported"
    },
    "voice_101:r_958a56c1151cab9e": {
      "text": "Whew... So players, comfort me!",
      "status": "imported"
    },
    "voice_101:r_94d35e5fa8e3a198": {
      "text": "No... My bare skin's sensitive...!",
      "status": "imported"
    },
    "voice_101:r_b686510e636673f3": {
      "text": "Every part of my body...!",
      "status": "imported"
    },
    "voice_101:r_59369bad143d4272": {
      "text": "So stimulatingggg!",
      "status": "imported"
    },
    "voice_101:r_25f9b1e39dd8d366": {
      "text": "Uooooooh!",
      "status": "imported"
    },
    "voice_101:r_307477bedd148060": {
      "text": "Receive this!",
      "status": "imported"
    },
    "voice_101:r_09a780acca0eb4b0": {
      "text": "No guard!",
      "status": "imported"
    },
    "voice_101:r_af62f2ee466b5c8c": {
      "text": "Attaaack!!",
      "status": "imported"
    },
    "voice_101:r_20cfb719db02fafd": {
      "text": "Embarrassing, but it feels good!",
      "status": "imported"
    },
    "voice_101:r_570c1fdf72edb283": {
      "text": "My whole body's burning!",
      "status": "imported"
    },
    "voice_101:r_23f0d87a5a6cfca1": {
      "text": "I-it's embarrassing, but...!",
      "status": "imported"
    },
    "voice_101:r_60c94ea4eb7f7404": {
      "text": "This feels kind of good!",
      "status": "imported"
    },
    "voice_101:r_727b2ee0277f9159": {
      "text": "Haaaaah!",
      "status": "imported"
    },
    "voice_101:r_cff4d2eae8a939ed": {
      "text": "Heat the skin and sever the flesh!",
      "status": "imported"
    },
    "voice_101:r_0e4f9b8a2d26ebff": {
      "text": "We did it, Amata! Mikono!",
      "status": "imported"
    },
    "voice_101:r_79e0d542fe12bcf7": {
      "text": "E-embarrassment, and...!",
      "status": "imported"
    },
    "voice_101:r_eff747ba39a55393": {
      "text": "A sense of liberation...!",
      "status": "imported"
    },
    "voice_101:r_b2dc77aa6dd77e69": {
      "text": "Locked in a fierce struggle!",
      "status": "imported"
    },
    "voice_101:r_4e63c037d3cb8a3d": {
      "text": "Haa... My heart won't stop racing!",
      "status": "imported"
    },
    "voice_101:r_9ca8d188ae805e3a": {
      "text": "Amata, Zessica...!\\nLend me power!",
      "status": "imported"
    },
    "voice_101:r_795ed21f3e28e1f5": {
      "text": "Got it!",
      "status": "imported"
    },
    "voice_101:r_141415c1def5ab2d": {
      "text": "Let's do this, Shrade!",
      "status": "imported"
    },
    "voice_101:r_c894e35becf35a03": {
      "text": "Here we go! Soul Arpeggio!",
      "status": "imported"
    },
    "voice_101:r_79b1abf5fc86483c": {
      "text": "Sky vibrato,\\nwater allegro vivace...",
      "status": "imported"
    },
    "voice_101:r_e9a11621911acb19": {
      "text": "Human moon sings life\\nagitato!",
      "status": "imported"
    },
    "voice_101:r_d52bece55796f599": {
      "text": "Moonlight Requiem!",
      "status": "imported"
    },
    "voice_101:r_358fe5a50bbee1df": {
      "text": "My life...! I play with the moon!",
      "status": "imported"
    },
    "voice_101:r_f0344d2fbaa9db77": {
      "text": "Haaaaah!",
      "status": "imported"
    },
    "voice_101:r_3328eef766ff2c2c": {
      "text": "My soul and life ring in moonlight!",
      "status": "imported"
    },
    "voice_101:r_23b037cf6ccc695c": {
      "text": "Resound, Moonlight Requiem!",
      "status": "imported"
    },
    "voice_101:r_883ad1128d340c5e": {
      "text": "This is the finale!",
      "status": "imported"
    },
    "voice_101:r_a9e6ed99025a703b": {
      "text": "Fastest toccata,\\nI'll pluck you!",
      "status": "imported"
    },
    "voice_101:r_b0d1459d6daeebbe": {
      "text": "Tonight's moon will perform...!",
      "status": "imported"
    },
    "voice_101:r_cd4893b409472e97": {
      "text": "Moonlight Rhapsody!",
      "status": "imported"
    },
    "voice_101:r_5691cc71770ffdde": {
      "text": "Spellbound by the fair moon...!",
      "status": "imported"
    },
    "voice_101:r_964e07c5563a5508": {
      "text": "Be intoxicated by my melody...!",
      "status": "imported"
    },
    "voice_101:r_db54e717bff3e3b2": {
      "text": "Moonlight Rhapsody!",
      "status": "imported"
    },
    "voice_101:r_fcab8d80aef7e9d8": {
      "text": "I feel my friend's soul so close...!",
      "status": "imported"
    },
    "voice_101:r_2174bd0edc164171": {
      "text": "Now, fight beside me, Cayenne!",
      "status": "imported"
    },
    "voice_101:r_ad54419336b49578": {
      "text": "Let's go, my friend!",
      "status": "imported"
    },
    "voice_101:r_63c353e1e05e8e39": {
      "text": "I dedicate this to my friend!",
      "status": "imported"
    },
    "voice_101:r_87646dd472438e88": {
      "text": "Requiem of the Master Musician!!",
      "status": "imported"
    },
    "voice_101:r_4e32ac89cba02001": {
      "text": "Now I play the ultimate melody...!",
      "status": "imported"
    },
    "voice_101:r_02d24e5915bfa5b7": {
      "text": "Will you play with me, Cayenne?",
      "status": "imported"
    },
    "voice_101:r_9331c2c2ef55c78f": {
      "text": "Of course, my friend.",
      "status": "imported"
    },
    "voice_101:r_49734bdb3507acf7": {
      "text": "I play this with my friend!",
      "status": "imported"
    },
    "voice_101:r_2a730c9b4df0dca3": {
      "text": "Requiem of the Master Musician!!",
      "status": "imported"
    },
    "voice_101:r_1e5842ba5dc3f705": {
      "text": "From me...\\nNew sound is born in us!",
      "status": "imported"
    },
    "voice_101:r_9747bd61ad23ecd3": {
      "text": "This is... what Shrade sought!",
      "status": "imported"
    },
    "voice_101:r_6823f8abe05c4727": {
      "text": "Yes! The ultimate melody!",
      "status": "imported"
    },
    "voice_101:r_b8ccfd8b8ac323ac": {
      "text": "Unite Spada and Gepard's power...!",
      "status": "imported"
    },
    "voice_101:r_c885ff2097749991": {
      "text": "Requiem of the Master Musician!!",
      "status": "imported"
    },
    "voice_101:r_0ef83b6a1e87f6fd": {
      "text": "I... love Amata.",
      "status": "imported"
    },
    "voice_101:r_a8f0666c4d6d24a0": {
      "text": "I love Amataaaaaa!!",
      "status": "imported"
    },
    "voice_101:r_36c402609f13ec14": {
      "text": "Pardon me, I'm going ahead!",
      "status": "imported"
    },
    "voice_101:r_5ec6634ac287489a": {
      "text": "Let's hit them with focused fire!",
      "status": "imported"
    },
    "voice_101:r_0f6c6e8f33422ecf": {
      "text": "I'll keep them pinned down!",
      "status": "imported"
    },
    "voice_101:r_035b4f6912ba7eed": {
      "text": "The finishing blow is yours!",
      "status": "imported"
    },
    "voice_101:r_f74b67b3cfcbe05c": {
      "text": "I'm your opponent!",
      "status": "imported"
    },
    "voice_101:r_6d8a80e2956870ed": {
      "text": "I won't lose one-on-one!",
      "status": "imported"
    },
    "voice_101:r_426b68d671486c8e": {
      "text": "Target confirmed! Let's attack!",
      "status": "imported"
    },
    "voice_101:r_ae913eb08e0ff29b": {
      "text": "Leave this one to me!",
      "status": "imported"
    }
  }
}
