    "stage0075_03:r_caaab7bad760e16d": {
      "text": "Phòng riêng",
      "status": "reviewed"
    },
    "stage0075_03:r_99b162aa6aa286a2": {
      "text": "Phòng riêng",
      "status": "reviewed"
    },
    "stage0075_03:r_58fb02434a1c40b2": {
      "text": "Phòng riêng",
      "status": "reviewed"
    },
    "stage0075_03:r_1c0f94acd5a8a143": {
      "text": "　\n　\n　～ $$ラー・カイラム$$, phòng riêng của $$アムロ・レイ$$ ～",
      "status": "reviewed"
    },
    "stage0075_03:r_1263541f4071624e": {
      "text": "$$アムロ$$\n「$$チェーン$$ à?」",
      "status": "reviewed"
    },
    "stage0075_03:r_3bc300bbdc277d82": {
      "text": "Lính bảo trì\n「.........」",
      "status": "reviewed"
    },
    "stage0075_03:r_38762a09460d8b6b": {
      "text": "$$アムロ$$\n「Cậu là ai?」",
      "status": "reviewed"
    },
    "stage0075_03:r_7ab28e70b4d4f641": {
      "text": "Lính bảo trì\n「$$アムロ・レイ$$...」",
      "status": "reviewed"
    },
    "stage0075_03:r_b05f6a6e8f3d9b24": {
      "text": "Lính bảo trì\n「Ngươi phải chết...!」",
      "status": "reviewed"
    },
    "stage0075_03:r_ec335e69f984b8b3": {
      "text": "$$アムロ$$\n「!」",
      "status": "reviewed"
    },
    "stage0075_03:r_0abcaf0c31978670": {
      "text": "$$ラー・カイラム$$, phòng họp tác chiến",
      "status": "reviewed"
    },
    "stage0075_03:r_1d6bc48b7f246730": {
      "text": "$$ラー・カイラム$$, phòng họp tác chiến",
      "status": "reviewed"
    },
    "stage0075_03:r_1af20fccc3c53cfc": {
      "text": "$$ラー・カイラム$$, phòng họp tác chiến",
      "status": "reviewed"
    },
    "stage0075_03:r_f951916061232dcd": {
      "text": "　\n　\n　～ $$ラー・カイラム$$, phòng họp tác chiến ～",
      "status": "reviewed"
    },
    "stage0075_03:r_4d863c3fb88a4c39": {
      "text": "$$ギュネイ$$\n「...Rốt cuộc gọi chúng tôi đến có việc gì vậy?」",
      "status": "reviewed"
    },
    "stage0075_03:r_44f4742c3dcce39a": {
      "text": "$$ブライト$$\n「.........」",
      "status": "reviewed"
    },
    "stage0075_03:r_9e701cdeb3842c21": {
      "text": "$$クェス$$\n「Có chuyện gì vậy, thuyền trưởng?\n　Sao mặt chú đáng sợ thế...」",
      "status": "reviewed"
    },
    "stage0075_03:r_6fd81f4abebe60c5": {
      "text": "$$アムロ$$\n「Nhìn thế này thì có vẻ họ không được báo gì cả.」",
      "status": "reviewed"
    },
    "stage0075_03:r_da2132b5038ec737": {
      "text": "$$ブライト$$\n「Cậu cũng nghĩ vậy sao...」",
      "status": "reviewed"
    },
    "stage0075_03:r_495d61d3ec7e16f2": {
      "text": "$$マリーダ$$\n「Đã xảy ra chuyện gì vậy?」",
      "status": "reviewed"
    },
    "stage0075_03:r_5cd353758cfe474d": {
      "text": "$$ブライト$$\n「$$アムロ$$ vừa suýt bị ám sát.」",
      "status": "reviewed"
    },
    "stage0075_03:r_a653c8dec4c0f06f": {
      "text": "$$クェス$$\n「Ơ...!?」",
      "status": "reviewed"
    },
    "stage0075_03:r_86d493e37a9799a7": {
      "text": "$$ギュネイ$$\n「Thủ phạm là ai?」",
      "status": "reviewed"
    },
    "stage0075_03:r_09d0fcc600cdd3df": {
      "text": "$$アムロ$$\n「Tôi đã chống trả. Kẻ tấn công tự sát\n　khi $$刹那$$ và những người khác nghe tiếng động chạy đến.」",
      "status": "reviewed"
    },
    "stage0075_03:r_182faded068c15ed": {
      "text": "$$ブライト$$\n「Đó là lính bảo trì lên tàu từ chi nhánh Viễn Đông.\n　Tư trang cùng những chứng cứ khác cho thấy\n　kẻ đó là người của Neo Zeon.」",
      "status": "reviewed"
    },
    "stage0075_03:r_9c206d19bfda4bd5": {
      "text": "$$マリーダ$$\n「...Chúng tôi đang bị nghi ngờ sao?」",
      "status": "reviewed"
    },
    "stage0075_03:r_6e558bc69acf5bf3": {
      "text": "$$ブライト$$\n「Rất tiếc là vậy.」",
      "status": "reviewed"
    },
    "stage0075_03:r_d60d0818e965232f": {
      "text": "$$クェス$$\n「Khoan đã, thuyền trưởng!\n　Bọn cháu không biết... chuyện đó mà!」",
      "status": "reviewed"
    },
    "stage0075_03:r_5b23687574286204": {
      "text": "$$マリーダ$$\n「Bình tĩnh nào, $$クェス$$.\n　Đại úy $$アムロ$$ cũng hiểu điều đó mà.」",
      "status": "reviewed"
    },
    "stage0075_03:r_6fd86c96891ea942": {
      "text": "$$ギュネイ$$\n「Nhưng chỉ vậy thì chưa thể tha bổng chúng tôi sao...」",
      "status": "reviewed"
    },
    "stage0075_03:r_43e4e548c0b28376": {
      "text": "$$ブライト$$\n「Còn phải xét đến an ninh nội bộ đơn vị.\n　Cho đến khi làm rõ mọi chuyện,\n　tôi sẽ phải hạn chế hoạt động của các cậu.」",
      "status": "reviewed"
    },
    "stage0075_03:r_d80a9688790ed583": {
      "text": "$$ギュネイ$$\n「Quản thúc sao?」",
      "status": "reviewed"
    },
    "stage0075_03:r_708bea61e3c43ada": {
      "text": "$$アムロ$$\n「Tôi không muốn đến mức đó.\n　Trước hiểm họa của thế giới, các cậu đã cùng\n　chúng tôi chiến đấu trong $c.」",
      "status": "reviewed"
    },
    "stage0075_03:r_7b6f159eeaf4de0f": {
      "text": "$$ブライト$$\n「Tôi sẽ hỏi $$シャア$$ về chuyện này.\n　Tùy tình hình, các cậu có thể phải trở về $$アクシズ$$.」",
      "status": "reviewed"
    },
    "stage0075_03:r_0827963cfd706e8d": {
      "text": "$$ギュネイ$$\n「Nghĩa là thỏa thuận đình chiến chấm dứt sao...」",
      "status": "reviewed"
    },
    "stage0075_03:r_ff6f8bdca2dd2bc9": {
      "text": "$$アムロ$$\n「Tôi mong chuyện sẽ không đến mức đó.」",
      "status": "reviewed"
    },
    "stage0075_03:r_3f4035fd9db81258": {
      "text": "$$クェス$$\n「$$アムロ$$...」",
      "status": "reviewed"
    },
    "stage0075_03:r_567b361a454c4b73": {
      "text": "$$ネェル・アーガマ$$, khoang chứa máy",
      "status": "reviewed"
    },
    "stage0075_03:r_d22851aaafbbf8fc": {
      "text": "$$ネェル・アーガマ$$, khoang chứa máy",
      "status": "reviewed"
    },
    "stage0075_03:r_352534f64413d954": {
      "text": "$$ネェル・アーガマ$$, khoang chứa máy",
      "status": "reviewed"
    },
    "stage0075_03:r_79f2664edb1af798": {
      "text": "　\n　\n　～ $$ネェル・アーガマ$$, khoang chứa máy ～",
      "status": "reviewed"
    },
    "stage0075_03:r_a62c4e7f3c09f7ed": {
      "text": "$$カツ$$\n「Sao Chổi Đỏ cũng sa đọa đến thế rồi sao...!」",
      "status": "reviewed"
    },
    "stage0075_03:r_1c5aa0d15ae24846": {
      "text": "$$ハサウェイ$$\n「Đúng vậy!\n　Dám đưa sát thủ vào $c...!」",
      "status": "reviewed"
    },
    "stage0075_03:r_53bb64ee17750ee2": {
      "text": "$$リディ$$\n「Đúng là đại úy $$アムロ$$ là trụ cột của $c,\n　nhưng lại nhắm vào một phi công đơn lẻ như vậy...」",
      "status": "reviewed"
    },
    "stage0075_03:r_7a7add80fde475ba": {
      "text": "$$カツ$$\n「$$シャア$$ tiến hành cuộc chiến này chỉ để\n　phân thắng bại với riêng anh $$アムロ$$ thôi...!」",
      "status": "reviewed"
    },
    "stage0075_03:r_b2befefdbed1393d": {
      "text": "$$カツ$$\n「Trước đây tôi đã có cảm giác ấy,\n　nhưng chuyện lần này đã làm rõ tất cả!」",
      "status": "reviewed"
    },
    "stage0075_03:r_2103f6df2ea2e447": {
      "text": "$$カミーユ$$\n「.........」",
      "status": "reviewed"
    },
    "stage0075_03:r_a12e3e130d896ff7": {
      "text": "$$五飛$$\n「$$カミーユ$$... Cậu nghĩ sao?」",
      "status": "reviewed"
    },
    "stage0075_03:r_b6f7b219eb4bd64b": {
      "text": "$$カミーユ$$\n「Tôi nghĩ $$シャア$$ muốn phân thắng bại\n　với đại úy $$アムロ$$ là thật.」",
      "status": "reviewed"
    },
    "stage0075_03:r_91bf33c27ad39f0a": {
      "text": "$$カミーユ$$\n「Nhưng tôi không nghĩ ông ấy phát động chiến tranh\n　chỉ vì điều đó.」",
      "status": "reviewed"
    },
    "stage0075_03:r_ee220318b96ab538": {
      "text": "$$カツ$$\n「Cậu bênh vực ông ta sao, $$カミーユ$$?」",
      "status": "reviewed"
    },
    "stage0075_03:r_ce1b55e526b6277a": {
      "text": "$$デュオ$$\n「Bình tĩnh đi. Cứ để cảm xúc chi phối như vậy\n　thì cậu cũng chẳng khác gì kẻ gây chiến vì tư tình đâu.」",
      "status": "reviewed"
    },
    "stage0075_03:r_c304df6888eb78f7": {
      "text": "$$カツ$$\n「Ư...」",
      "status": "reviewed"
    },
    "stage0075_03:r_c26958634526e597": {
      "text": "$$カミーユ$$\n「Tôi nghĩ con người mang tên $$シャア・アズナブル$$\n　chính là đại úy $$クワトロ$$ mà chúng ta biết,\n　sau khi đã hạ quyết tâm.」",
      "status": "reviewed"
    },
    "stage0075_03:r_cdb750c9d380881a": {
      "text": "$$ゼクス$$\n「Nghĩa là bản chất ông ấy vẫn không thay đổi sao?」",
      "status": "reviewed"
    },
    "stage0075_03:r_95fda74613c97b39": {
      "text": "$$カミーユ$$\n「Vâng... Vì thế, có lẽ cuộc chiến này cũng xuất phát\n　từ việc ông ấy thật sự nghĩ đến tương lai thế giới.」",
      "status": "reviewed"
    },
    "stage0075_03:r_1956994937f8171e": {
      "text": "$$カミーユ$$\n「Dù tôi không có ý tán thành cách làm của ông ấy.」",
      "status": "reviewed"
    },
    "stage0075_03:r_48f49f6728c15612": {
      "text": "$$ゼクス$$\n「Còn vụ ám sát lần này thì sao?」",
      "status": "reviewed"
    },
    "stage0075_03:r_0ebc5a6f1e0f81bf": {
      "text": "$$カミーユ$$\n「Nếu ông ấy xem việc phân thắng bại với đại úy $$アムロ$$\n　thuần túy là chiến lược, chứ không phải\n　lòng tự tôn hay sự cố chấp cá nhân...」",
      "status": "reviewed"
    },
    "stage0075_03:r_f02c37d91387d0ad": {
      "text": "$$カミーユ$$\n「Thì trên cương vị tổng soái Neo Zeon,\n　ông ấy sẽ phái sát thủ đến.」",
      "status": "reviewed"
    },
    "stage0075_03:r_6bbd5a3c5afb87e0": {
      "text": "$$カミーユ$$\n「Nếu vậy, dù lần này thất bại,\n　đại úy $$アムロ$$ cũng không có cơ hội thắng.」",
      "status": "reviewed"
    },
    "stage0075_03:r_9796b3efa401a303": {
      "text": "$$ヒイロ$$\n「Nhưng chắc ông ta sẽ không dùng thủ đoạn như thế đâu.」",
      "status": "reviewed"
    },
    "stage0075_03:r_643b6eebfc0186b3": {
      "text": "$$カミーユ$$\n「Đúng vậy. Đó vừa là điểm yếu,\n　vừa là phần con người của ông ấy.」",
      "status": "reviewed"
    },
    "stage0075_03:r_291280e5f7eb9d70": {
      "text": "$$ハサウェイ$$\n「Nhưng thực tế là chú $$アムロ$$\n　đã suýt bị giết mà!」",
      "status": "reviewed"
    },
    "stage0075_03:r_32eb462c1b4999cb": {
      "text": "$$カツ$$\n「$$シャア$$ đã thay đổi rồi!\n　Chắc chắn cả thỏa thuận đình chiến\n　cũng chỉ là mưu kế khiến chúng ta mất cảnh giác!」",
      "status": "reviewed"
    },
    "stage0075_03:r_1f4337d6d393fc37": {
      "text": "$$オードリー$$\n「Xin hãy dừng lại.」",
      "status": "reviewed"
    },
    "stage0075_03:r_4740e748fae085ee": {
      "text": "$$カツ$$\n「$$オードリー$$...」",
      "status": "reviewed"
    },
    "stage0075_03:r_b76524cd840e1d37": {
      "text": "$$オードリー$$\n「Chỉ vì không tin tưởng đối phương\n　mà bản thân cũng hạ mình xuống ngang hàng với họ,\n　thì mọi chuyện sẽ chỉ càng tệ hơn.」",
      "status": "reviewed"
    },
    "stage0075_03:r_730ffe18400abfc2": {
      "text": "$$オードリー$$\n「Điều chúng ta cần làm lúc này là nắm rõ tình hình\n　và xác định việc bản thân phải làm.」",
      "status": "reviewed"
    },
    "stage0075_03:r_ffe0fca26da5cd38": {
      "text": "$$ハサウェイ$$\n「Nhưng...」",
      "status": "reviewed"
    },
    "stage0075_03:r_bfb27f9eb2f7073e": {
      "text": "$$オードリー$$\n「$$ハサウェイ$$... Tôi hiểu rằng vì chuyện của $$クェス$$,\n　cậu thấy ác cảm với $$シャア・アズナブル$$.」",
      "status": "reviewed"
    },
    "stage0075_03:r_859dfa27bcaafe30": {
      "text": "$$ハサウェイ$$\n「.........」",
      "status": "reviewed"
    },
    "stage0075_03:r_71ebf05996a4b0fd": {
      "text": "$$オードリー$$\n「Nhưng cậu không được biến điều đó thành thù hận\n　rồi dùng nó làm sức mạnh để chiến đấu.」",
      "status": "reviewed"
    },
    "stage0075_03:r_6214c11b1bca811e": {
      "text": "$$オードリー$$\n「Nếu vậy thì chiến tranh...\n　những cuộc chiến sẽ không bao giờ kết thúc.」",
      "status": "reviewed"
    },
    "stage0075_03:r_8eaf6f3098ffed12": {
      "text": "$$バナージ$$\n「$$オードリー$$...」",
      "status": "reviewed"
    },
    "stage0075_03:r_cf507214fe955d75": {
      "text": "$$ハサウェイ$$\n「...Xin lỗi cô, $$オードリー$$...\n　Có lẽ tôi... đã hơi mất bình tĩnh...」",
      "status": "reviewed"
    },
    "stage0075_03:r_2113dcbabdfc758a": {
      "text": "$$リディ$$\n「Còn cậu thì sao, $$カツ$$?」",
      "status": "reviewed"
    },
    "stage0075_03:r_4b0e43ba6a5f2f5b": {
      "text": "$$カツ$$\n「...Tôi thừa nhận đã để cảm xúc lấn át...\n　Nhưng chuyện đó cũng khó tránh mà...」",
      "status": "reviewed"
    },
    "stage0075_03:r_6a74519e1fc29c4b": {
      "text": "$$オードリー$$\n「Không sao đâu, $$カツ$$.\n　Chẳng ai là hoàn hảo cả.」",
      "status": "reviewed"
    },
    "stage0075_03:r_5b992878fee054b5": {
      "text": "$$オードリー$$\n「Nếu biết lắng nghe những người xung quanh\n　giúp mình sửa sai, thì con người có thể thay đổi.」",
      "status": "reviewed"
    },
